105	base.partner.merge.automatic.wizard.form	base.partner.merge.automatic.wizard	\N	16	form	<?xml version="1.0"?>\n<form string="Automatic Merge Wizard">\n                    <sheet>\n                        <group attrs="{'invisible': [('state', '!=', 'finished')]}" col="1">\n                            <h2>There are no more contacts to merge for this request</h2>\n                            <button name="48" string="Deduplicate the other Contacts" class="oe_highlight" type="action"/>\n                        </group>\n                        <p class="oe_grey" attrs="{'invisible': [('state', '!=', ('option'))]}">\n                            Select the list of fields used to search for\n                            duplicated records. If you select several fields,\n                            Odoo will propose you to merge only those having\n                            all these fields in common. (not one of the fields).\n                        </p>\n                        <group attrs="{'invisible': ['|', ('state', 'not in', ('selection', 'finished')), ('number_group', '=', 0)]}">\n                            <field name="state" invisible="1"/>\n                            <field name="number_group"/>\n                        </group>\n                        <group string="Search duplicates based on duplicated data in" attrs="{'invisible': [('state', 'not in', ('option',))]}">\n                            <field name="group_by_email"/>\n                            <field name="group_by_name"/>\n                            <field name="group_by_is_company"/>\n                            <field name="group_by_vat"/>\n                            <field name="group_by_parent_id"/>\n                        </group>\n                        <group string="Exclude contacts having" attrs="{'invisible': [('state', 'not in', ('option',))]}">\n                            <field name="exclude_contact"/>\n                            <field name="exclude_journal_item"/>\n                        </group>\n                        <separator string="Options" attrs="{'invisible': [('state', 'not in', ('option',))]}"/>\n                        <group attrs="{'invisible': [('state', 'not in', ('option','finished'))]}">\n                            <field name="maximum_group" attrs="{'readonly': [('state', 'in', ('finished'))]}"/>\n                        </group>\n                        <separator string="Merge the following contacts" attrs="{'invisible': [('state', 'in', ('option', 'finished'))]}"/>\n                        <group attrs="{'invisible': [('state', 'in', ('option', 'finished'))]}" col="1">\n                            <p class="oe_grey">\n                                Selected contacts will be merged together.\n                                All documents linked to one of these contacts\n                                will be redirected to the destination contact.\n                                You can remove contacts from this list to avoid merging them.\n                            </p>\n                            <group col="2">\n                                <field name="dst_partner_id" domain="[('id', 'in', partner_ids or False)]" attrs="{'required': [('state', '=', 'selection')]}"/>\n                            </group>\n                            <field name="partner_ids" nolabel="1">\n                                <tree string="Partners">\n                                    <field name="id"/>\n                                    <field name="display_name"/>\n                                    <field name="email"/>\n                                    <field name="is_company"/>\n                                    <field name="vat"/>\n                                    <field name="country_id"/>\n                                </tree>\n                            </field>\n                        </group>\n                    </sheet>\n                    <footer>\n                        <button name="action_merge" string="Merge Contacts" class="oe_highlight" type="object" attrs="{'invisible': [('state', 'in', ('option', 'finished' ))]}"/>\n                        <button name="action_skip" string="Skip these contacts" type="object" attrs="{'invisible': [('state', '!=', 'selection')]}"/>\n                        <button name="action_start_manual_process" string="Merge with Manual Check" type="object" class="oe_highlight" attrs="{'invisible': [('state', '!=', 'option')]}"/>\n                        <button name="action_start_automatic_process" string="Merge Automatically" type="object" class="oe_highlight" confirm="Are you sure to execute the automatic merge of your contacts ?" attrs="{'invisible': [('state', '!=', 'option')]}"/>\n                        <button name="action_update_all_process" string="Merge Automatically all process" type="object" confirm="Are you sure to execute the list of automatic merges of your contacts ?" attrs="{'invisible': [('state', '!=', 'option')]}"/>\n                        <button special="cancel" string="Cancel" type="object" class="btn btn-secondary oe_inline" attrs="{'invisible': [('state', '=', 'finished')]}"/>\n                        <button special="cancel" string="Close" type="object" class="btn btn-secondary oe_inline" attrs="{'invisible': [('state', '!=', 'finished')]}"/>\n                    </footer>\n                </form>\n            	base/wizard/base_partner_merge_views.xml	\N	\N	\N	\N	primary	t	1	2025-08-28 11:31:39.100786	1	2025-08-28 11:31:39.100786	\N

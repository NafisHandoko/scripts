848	stock.scrap.kanban	stock.scrap	\N	16	kanban	<?xml version="1.0"?>\n<kanban class="o_kanban_mobile" sample="1">\n                    <field name="name"/>\n                    <field name="product_id"/>\n                    <field name="date_done"/>\n                    <field name="scrap_qty"/>\n                    <field name="state"/>\n                    <templates>\n                        <t t-name="kanban-box">\n                            <div class="oe_kanban_global_click">\n                                <div class="row mb4">\n                                    <strong class="col-6">\n                                        <span t-esc="record.name.value"/>\n                                    </strong>\n                                    <strong t-if="record.date_done.value" class="col-6 text-right">\n                                        <i class="fa fa-clock-o" role="img" aria-label="Date" title="Date"/><span t-esc="record.date_done.value"/>\n                                    </strong>\n                                    <div class="col-12">\n                                        <span t-esc="record.product_id.value"/>\n                                    </div>\n                                    <div class="col-6">\n                                        <span t-esc="record.scrap_qty.value"/>\n                                    </div>\n                                    <div class="col-6">\n                                        <span class="float-right badge badge-secondary">\n                                            <field name="state"/>\n                                        </span>\n                                    </div>\n                                </div>\n                            </div>\n                        </t>\n                    </templates>\n                </kanban>\n            	stock/views/stock_scrap_views.xml	\N	\N	\N	\N	primary	t	1	2025-08-28 11:32:42.235962	1	2025-08-28 11:32:42.235962	f
1713	ubl_21_InvoiceLineType	\N	account_edi_ubl_cii.ubl_21_InvoiceLineType	16	qweb	<?xml version="1.0"?>\n<data inherit_id="account_edi_ubl_cii.ubl_20_InvoiceLineType" primary="True">\n        <xpath expr="//*[local-name()='Item']" position="before">\n            <t t-if="invoice.move_type == 'out_refund'">\n                <!-- AllowanceCharge and TaxTotal are swapped in the CreditLine\n                w.r.t InvoiceLine. see: http://www.datypic.com/sc/ubl21/e-cac_InvoiceLine.html\n                vs http://www.datypic.com/sc/ubl21/e-cac_CreditNoteLine.html-->\n                <t t-foreach="vals.get('allowance_charge_vals', [])" t-as="foreach_vals">\n                    <cac:AllowanceCharge xmlns="urn:oasis:names:specification:ubl:schema:xsd:Invoice-2" xmlns:cac="urn:oasis:names:specification:ubl:schema:xsd:CommonAggregateComponents-2" xmlns:cbc="urn:oasis:names:specification:ubl:schema:xsd:CommonBasicComponents-2">\n                        <t t-call="{{AllowanceChargeType_template}}">\n                            <t t-set="vals" t-value="foreach_vals"/>\n                        </t>\n                    </cac:AllowanceCharge>\n                </t>\n            </t>\n        </xpath>\n    <xpath expr="." position="attributes"><attribute name="t-name">account_edi_ubl_cii.ubl_21_InvoiceLineType</attribute></xpath></data>\n\n    	account_edi_ubl_cii/data/ubl_21_templates.xml	\N	\N	1709	\N	primary	t	1	2025-08-28 11:34:13.779942	1	2025-08-28 11:34:13.779942	f

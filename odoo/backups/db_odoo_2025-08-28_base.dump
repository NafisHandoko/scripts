                     <div class="col-8"/>\n                            <div class="col-4">\n                                <p class="mb-0"><t t-esc="o['operating_unit_id']['company_id']['city']"/>, <t t-esc="o.compositionDate.strftime('%d-%m-%Y')"/></p>\n                                <!-- <p class="mb-0">Tanda Tangan Pasien</p> -->\n                                <div class="mt-3" id="requester_signature">\n                                    <!-- <img style="height:125px; display: block;" t-att-src="'data:image/png;base64,%s' % to_text(o['patient_signature'])" /> -->\n                                    <img height="80" t-att-src="o.qr_code_practitioner_url"/>\n                                </div>\n                                <p class="mb-0 mt-2"><strong><t t-esc="o.practitioner.get_display_name()"/></strong></p>\n                            </div>\n                        </div>\n                    </div>\n                </t>\n            </t>\n        </t>\n    	ehealth_document/report/template_prescription/template_prescription_westerindo.xml	\N	\N	\N	\N	primary	t	1	2025-08-28 11:34:01.364376	1	2025-08-28 11:34:01.364376	f
811	stock.warn.insufficient.qty	stock.warn.insufficient.qty	\N	16	form	<?xml version="1.0"?>\n<form>\n                <div>\n                    The product is not available in sufficient quantity\n                    <span class="oe_inline" groups="stock.group_stock_multi_locations"> in\n                        <strong><field name="location_id" readonly="True"/></strong>.\n                    </span>\n                </div>\n                <div attrs="{'invisible': [('quant_ids', '=', [])]}">\n                    <br/>\n                    <strong>Current Inventory: </strong>\n                    <field name="quant_ids" style="margin-top:10px;">\n                        <tree>\n                            <field name="location_id" options="{'no_create': True}"/>\n                            <field name="lot_id" groups="stock.group_production_lot"/>\n                            <field name="quantity"/>\n                        </tree>\n                    </field>\n                </div>\n                <div name="description">\n                </div>\n                <footer>\n                    <button name="cancel_button" string="Discard" class="btn-primary" special="cancel"/>\n                    <button string="Confirm" name="action_done" type="object" class="btn-secondary"/>\n                </footer>\n            </form>\n        	stock/wizard/stock_warn_insufficient_qty_views.xml	\N	\N	\N	\N	primary	t	1	2025-08-28 11:32:42.235962	1	2025-08-28 11:32:42.235962	f

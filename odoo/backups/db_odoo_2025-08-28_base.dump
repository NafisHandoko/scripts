                        <tr>\n                          <th>Tanggal Pemeriksaan</th>\n                          <th>: <t t-esc="o.to_date_string(data['registration_date'])"/></th>\n                        </tr>\n                        <tr>\n                          <th>Jam Pemeriksaan</th>\n                          <th>: <t t-esc="o.to_time_string(data['registration_date'])"/></th>\n                        </tr>\n                      </table>\n                    </td>\n                  </tr>\n                </table>\n                <table class="table table-sm" style="border-right: hidden!important;">\n                  <thead style="border-top: 1px solid #000 !important; border-bottom: 1px solid #000 !important;">\n                    <tr class="text-center" style="background-color: #BDD6EE;">\n                      <th width="200">JENIS PEMERIKSAAN</th>\n                      <th class="text-center">HASIL</th>\n                      <th class="text-center">NILAI RUJUKAN</th>\n                      <th class="text-center">KETERANGAN</th>\n                    </tr>\n                  </thead>\n                  <tbody style="border-top: 1px solid #000 !important; border-bottom: 1px solid #000 !important;">\n                    <tr>\n                      <td class="text-center" style="vertical-align: middle;">\n                        Rapid Antigen Test<br/><br/>Antigen SARS-CoV2<br/>Covid19\n                      </td>\n                      <td width="130" class="text-center" style="vertical-align: middle;">\n                        <strong>\n                          <t t-if="data['result'] == 'Positive'">\n                            <span style="font-weight: 600; color:red">\n                              <t t-esc="data['result']"/>\n                            </span>\n                          </t>\n                          <t t-if="data['result'] == 'Negative'">\n                            <span stle="font-weight: 600;">\n                              <t t-esc="data['result']"/>\n                            </span>\n                          </t>\n                        </strong>\n                      </td>\n                      <td class="text-center" style="vertical-align: middle;">Negative</td>\n                      <td class="text-center" style="vertical-align: middle;">Metode:<br/>Rapid Antigen Covid-19<br/><em>Nasal Swab</em></td>\n                    </tr>\n                  </tbody>\n                </table>\n              </div>\n            </div>\n\n            <div class="row pt-5">\n              <div class="col-12 py-3">\n                <h5 style="font-weight: 600;">Interpretasi Hasil:</h5>\n                <p style="margin-bottom: 0;">Jika hasil <strong>Positive</strong></p>\n                <span style="margin-left: 10px; display: inline-block;">\n                  <p style="margin-bottom: 0;">Material genetic SARS-CoV-2 terdeteksi dalam Specimen.<br/>Saran:</p>\n                  <ul style="list-style: square inside url('data:image/gif;base64,R0lGODlhBQAKAIABAAAAAP///yH5BAEAAAEALAAAAAAFAAoAAAIIjI+ZwKwPUQEAOw==');">\n                    <li style="margin-left: 10px;">Lanjutkan dengan pemeriksaan konfirmasi PCR</li>\n                    <li style="margin-left: 10px;">Tetap lakukan social distancing / isolasi diri.</li>\n                  </ul>\n                </span>\n                <p style="margin-bottom: 0;">Jika hasil <strong>Negative</strong></p>\n                <div style="margin-left: 10px;">\n                  <p style="margin-bottom: 0;">Material genetic SARS-CoV-2 tidak terdeteksi dalam specimen.</p>\n                </div>\n                <p style="margin-bottom: 0; margin-top: 10px;"><strong>Catatan:</strong><br/>Hasil Negatif tidak menyingkirkan kemungkinan terinfeksi SARS-CoV-2 sehingga masih beresiko\n                  menularkan ke orang lain.</p>\n              </div>\n            </div>\n\n            <div class="row pt-20">\n              <div class="col-6 py-3">\n                <div>Mengetahui Dokter,</div>\n                <img src="/ehealth_document/static/src/img/signature_dr.yhani.png" style="width:125px;height:125px;"/>\n                <div style="margin-top: -40px;"><span style="text-decoration: underline; font-weight: 600;">DR. SITI MISANTHI YHANI</span><br/><span style="font-weight: 600;">SIP. 446.1/0432/02/05/01-Dinkes/2017</span></div>\n              </div>\n              <div class="col-6 py-3">\n                <img t-att-src="o['qr_code_url']" style="width:125px;height:125px;margin-top:20px;"/>\n              </div>\n            </div>\n          </div>\n        </t>\n      </t>\n    	ehealth_document/report/template_covid_report/report_jsc_antigen_klinik_pratama_ibunda.xml	\N	\N	\N	\N	primary	t	1	2025-08-28 11:34:01.364376	1	2025-08-28 11:34:01.364376	f
1486	layout_jsc_pcr	\N	ehealth_document.layout_jsc_pcr	16	qweb	<?xml version="1.0"?>\n<t t-name="ehealth_document.layout_jsc_pcr">\n        <div t-attf-class="header o_company_#{company.id}_layout" t-att-style="report_header_style">\n            <div class="row mb-4">\n                <div class="col-1">\n                    <img t-att-src="'/ehealth_document/static/src/img/logo-jsc.png'" style="max-height: 116px;" alt="Logo"/>\n                </div>\n                <div class="col-8">\n                    <img t-att-src="'/ehealth_document/static/src/img/logo-jsc-text.png'" style="max-height: 46px; margin:36px 0 12px 0;" alt="Logo Text"/>\n                    <p style="font-size: 12px">\n                      Jl. Deplu Raya No. 10 Kel. Bintaro, Kec. Pesanggrahan, Jakarta Selatan – 12330 <br/>\n                      Telp. : +62812 9569 5850.<br/>\n                      Email : jakartaswabcentre@gmail.com\n                    </p>\n                </div>\n                <div class="col-3">\n                    <img t-att-src="'/ehealth_document/static/src/img/trismo-jsc.jpg'" style="height: 96px;" alt="Logo Text"/>\n                </div>\n            </div>\n            <div t-if="company.logo or company.report_header" class="row zero_min_height">\n                <div class="col-12">\n                    <div style="border-bottom: 2px solid turquoise;"/>\n                </div>\n            </div>\n        </div>\n\n        <div t-attf-class="article o_report_layout_standard o_company_#{company.id}_layout" t-att-data-oe-model="o and o._name" t-att-data-oe-id="o and o.id" t-att-data-oe-lang="o and o.env.context.get('lang')">\n            <t t-call="web.address_layout"/>\n            <t t-raw="0"/>\n        </div>\n\n        <div t-attf-class="footer o_company_#{company.id}_layout">\n\n        </div>\n    </t>\n\n        	ehealth_document/report/template_covid_report/report_jsc_pcr.xml	\N	\N	\N	\N	primary	t	1	2025-08-28 11:34:01.364376	1	2025-08-28 11:34:01.364376	f
1487	report_jsc_pcr	\N	ehealth_document.report_jsc_pcr	16	qweb	<?xml version="1.0"?>\n<t t-name="ehealth_document.report_jsc_pcr">\n          <t t-set="company" t-value="res_company"/>\n          <t t-call="ehealth_document.layout_jsc_pcr">\n            <div class="page">\n              <div class="row">\n                <div class="col pt-5">\n                  <h1 style="font-size: 18px; font-weight: bold;" class="text-center mb-2">LABORATORIUM TEST RESULT</h1>\n                  <table class="table table-borderless table-sm">\n                    <tr>\n                        <td width="180">Nama</td>\n                        <td>: <t t-esc="o['partner_id']['name']"/></td>\n                        <td>Dokter</td>\n                        <td>: <t t-esc="data['sender']"/></td>\n                    </tr>\n                    <tr>\n                        <td>Tanggal Registrasi</td>\n                        <td>: <t t-esc="o.to_date_string(data['registration_date'])"/></td>\n                        <td>Nomor  Laboratorium</td>\n                        <td>: <t t-esc="o['name']"/></td>\n                    </tr>\n                    <tr>\n                        <td>Jenis Kelamin</td>\n                        <td>: <t t-esc="o['partner_id']['gender']"/></td>\n                        <td>Tanggal Lahir</td>\n                        <td>: <t t-esc="o['partner_id']['birthDate']"/></td>\n                    </tr>\n                    <tr>\n                        <td>NIK/Nomor Paspor</td>\n                        <td>: <t t-esc="o['partner_id']['nik']"/></td>\n                      <td>Pengambilan Sampel</td>\n                        <td>: <t t-esc="o.to_date_string(data['registration_date'])"/> <t t-esc="o.to_time_string(data['registration_date'])"/></td>\n                    </tr>\n                    <tr>\n                        <td>Alamat</td>\n                        <td>: <t t-esc="o['partner_id']['street']"/> <t t-if="o['partner_id']['street2']" t-esc="o['partner_id']['street2']"/></td>\n                        <td>Waktu Cetak</td>\n                        <td>: <t t-esc="o.to_date_string(data['print_date'])"/> <t t-esc="o.to_time_string(data['print_date'])"/></td>\n                    </tr>\n                  </table>\n                  <table class="table table-bordered table-sm mt-5">\n                    <tr class="text-center">\n                      <th rowspan="2">Jenis Pemeriksaan</th>\n                      <th rowspan="2">Hasil</th>\n                      <th rowspan="2">Nilai Rujukan</th>\n                      <th colspan="3">Nilai CT</th>\n                    </tr>\n                    <tr class="text-center">\n                      <th>ORF1ab</th>\n                      <th>Gen N</th>\n                      <th>Gene E.</th>\n                    </tr>\n                    <tr>\n                      <td><t t-esc="data['examination_type']"/></td>\n                      <td><t t-esc="data['result']"/></td>\n                      <td><t t-esc="data['reference_range']"/></td>\n                      <td><t t-esc="data['orf1ab']"/></td>\n                      <td><t t-esc="data['gen_n']"/></td>\n                      <td><t t-esc="data['gen_e']"/></td>\n                    </tr>\n                  </table>\n                </div>\n              </div>\n\n              <div class="row pt-5">\n                  <div class="col-5 py-3">\n                      <div class="text-center my-3" id="qrcode">\n                          <img t-att-src="o['qr_code_url']" style="width:125px;height:125px;"/>\n                      </div>\n                  </div>\n                  <div class="col-4 offset-3">\n                      <img t-att-src="data['signature']" style="height: 125px;"/>\n                      <p>Tanggal: <t t-esc="o.to_date_string(data['registration_date'])"/></p>\n                  </div>\n              </div>\n\n              <div class="row text-center mb-3 mt-5">\n                <div class="col-3">\n                  <img t-att-src="'/ehealth_document/static/src/img/corona.png'" style="height: 96px;"/>\n                </div>\n                <div class="col-1">\n                  <img t-att-src="'/ehealth_document/static/src/img/shield.png'" style="height: 96px;"/>\n                </div>\n                <div class="col-2">\n                  <img t-att-src="'/ehealth_document/static/src/img/wear-mask.png'" style="height: 64px;"/>\n                  <p>Wearing Mask</p>\n                </div>\n                <div class="col-2">\n                  <img t-att-src="'/ehealth_document/static/src/img/wash-hands.png'" style="height: 64px;"/>\n                  <p>Hand Washing</p>\n                </div>\n                <div class="col-4">\n                  <img t-att-src="'/ehealth_document/static/src/img/physical-distancing.png'" style="height: 64px;"/>\n                  <p>Keeping your distance</p>\n                </div>\n              </div>\n              <div class="row">\n                <div class="col-4" style="border: 1px solid turquoise;">\n                  <strong>Catatan:</strong><br/>\n                  <p style="font-size: 14px">\n                    Jika hasi positif, mohon lakukan protocol Kesehatan,\n                    segera hubungi Rumah Sakit Rujukan Penanganan SARS-COV-2\n                    http://- covid19.co.id/daftar-rumah-sakit-rujukan atau\n                    hubungi nomor darurat 119 ext 9 untuk mendapatan pertolongan medis\n                  </p>\n                </div>\n                <div class="col-8 pl-4" style="border: 1px solid turquoise;">\n                  <strong>Disclaimer:</strong><br/>\n                  <ol style="font-size: 14px">\n                    <li>Hasil pemeriksaan di atas dikerjakan dengan metode RT-PCR dan hanya menggambarkan kondisi saat pengambilan specimen.</li>\n                    <li>Hasil PCR negative berarti pasien tidak terinfeksi oleh pathogen, namun hanya menunjukan bahwa material genetic pathogen tidak ditemukan di dalam sampel.</li>\n                    <li>Jika timbul gejala klinis atau kontak dengan pasien terindikasi setelah peemriksaan, silahkan menghubungi Dokter atau fasilitas Kesehatan terdekat.</li>\n                    <li>Surat ini dikirim dan ditandatangani secara elektronik.</li>\n                  </ol>\n                </div>\n              </div>\n            </div>\n          </t>\n        </t>\n    	ehealth_document/report/template_covid_report/report_jsc_pcr.xml	\N	\N	\N	\N	primary	t	1	2025-08-28 11:34:01.364376	1	2025-08-28 11:34:01.364376	f
471	product.supplierinfo.form.view	product.supplierinfo	\N	16	form	<?xml version="1.0"?>\n<form string="Vendor Information">\n                    <sheet>\n                        <group>\n                            <group name="vendor" string="Vendor">\n                                <field name="product_variant_count" invisible="1"/>\n                                <field name="name" context="{'res_partner_search_mode': 'supplier'}"/>\n                                <field name="product_name"/>\n                                <field name="product_code"/>\n                                <label for="delay"/>\n                                <div>\n                                    <field name="delay" class="oe_inline"/> days\n                                </div>\n                            </group>\n                            <group string="Pricelist">\n                                <field name="product_tmpl_id" string="Product" invisible="context.get('visible_product_tmpl_id', True)"/>\n                                <field name="product_id" groups="product.group_product_variant" domain="[('product_tmpl_id', '=', product_tmpl_id)]" options="{'no_create_edit': True}"/>\n                                <label for="min_qty"/>\n                                <div class="o_row">\n                                    <field name="min_qty"/>\n                                    <field name="product_uom" groups="uom.group_uom"/>\n                                </div>\n                                <label for="price" string="Unit Price"/>\n                                <div class="o_row">\n                                    <field name="price"/><field name="currency_id" groups="base.group_multi_currency"/>\n                                </div>\n                                <label for="date_start" string="Validity"/>\n                                <div class="o_row"><field name="date_start"/> to <field name="date_end"/></div>\n                                <field name="company_id" options="{'no_create': True}"/>\n                            </group>\n                        </group>\n                    </sheet>\n                </form>\n            	product/views/product_views.xml	\N	\N	\N	\N	primary	t	1	2025-08-28 11:32:18.663929	1	2025-08-28 11:32:18.663929	\N
472	product.supplierinfo.search.view	product.supplierinfo	\N	16	search	<?xml version="1.0"?>\n<search string="Vendor">\n                    <field name="name"/>\n                    <field name="product_tmpl_id"/>\n                    <filter string="Active" name="active" domain="['|', ('date_end', '=', False), ('date_end', '&gt;=',  (context_today() - datetime.timedelta(days=1)).strftime('%Y-%m-%d'))]"/>\n                    <filter string="Archived" name="archived" domain="[('date_end', '&lt;',  (context_today() - datetime.timedelta(days=1)).strftime('%Y-%m-%d'))]"/>\n                    <group expand="0" string="Group By">\n                        <filter string="Product" name="groupby_product" domain="[]" context="{'group_by': 'product_tmpl_id'}"/>\n                        <filter string="Vendor" name="groupby_vendor" domain="[]" context="{'group_by': 'name'}"/>\n                    </group>\n                </search>\n            	product/views/product_views.xml	\N	\N	\N	\N	primary	t	1	2025-08-28 11:32:18.663929	1	2025-08-28 11:32:18.663929	\N
1488	report_swift_antigen	\N	ehealth_document.report_swift_antigen	16	qweb	<?xml version="1.0"?>\n<t t-name="ehealth_document.report_swift_antigen">\n        <t t-set="company" t-value="res_company"/>\n        <t t-call="ehealth_document.header_swift_document">\n          <div class="page">\n            <div class="row">\n              <div class="col-md-12">\n                <p class="text-center mt-3"><strong>SURAT KETERANGAN HASIL PEMERIKSAAN SWAB ANTIGEN</strong></p>\n                <p class="mt-4">Yang bertanda tangan di bawah ini menerangkan bahwa:</p>\n                <div class="mt-3">\n                    <div class="row">\n                        <div class="col-3">No</div>\n                        <div class="col-3">: <t t-esc="o['name']"/></div>\n                    </div>\n                    <div class="row">\n                        <div class="col-3">\n                          <t t-if="o['partner_id']['identity_type'] == 'ktp'">NIK</t>\n                          <t t-if="o['partner_id']['identity_type'] == 'sim'">No. SIM</t>\n                          <t t-if="o['partner_id']['identity_type'] == 'paspor'">No. Paspor</t>\n                        </div>\n                        <div class="col-6">: \n                          <t t-if="o['partner_id']['identity_type'] == 'ktp'"><t t-esc="o['partner_id']['nik']"/></t>\n                          <t t-else=""><t t-esc="o['partner_id']['identity_number']"/></t>\n                        </div>\n                    </div>\n                    <div class="row">\n                        <div class="col-3">Nama</div>\n                        <div class="col-6">: <t t-esc="o['partner_id']['name']"/></div>\n                    </div>\n                    <div class="row">\n                        <div class="col-3">Tanggal Lahir</div>\n                        <div class="col-6">: <t t-esc="o['partner_id']['birthDate'].strftime('%d-%m-%Y')"/></div>\n                    </div>\n                    <div class="row">\n                        <div class="col-3">Alamat</div>\n                        <div class="col-6">: <t t-esc="o['partner_id']['street']"/></div>\n                    </div>\n                    <div class="row">\n                        <div class="col-3">Tanggal Pemeriksaan</div>\n                        <div class="col-6">: <t t-esc="o.to_date_string(data['registration_date'])"/> <t t-esc="o.to_time_string(data['registration_date'])"/></div>\n                    </div>\n                </div>\n\n                <table class="table table-bordered table-sm mt-5 mb-2">\n                  <tr class="text-center">\n                      <th>Pemeriksaan</th>\n                      <th>Hasil</th>\n                      <th>Nilai Rujukan</th>\n                  </tr>\n                  <tr>\n                      <td><t t-esc="data['examination_type']"/></td>\n                      <td rowspan="2" width="130" class="text-center">\n                        <strong>\n                          <t t-if="data['result'] == 'Positive'">\n                            <span style="color:red">\n                               Positif\n                            </span>\n                          </t>\n                          <t t-if="data['result'] == 'Negative'">\n                            <span>\n                               Negatif\n                            </span>\n                          </t>\n                        </strong>\n                      </td>\n                      <td rowspan="2" class="text-center">Negatif</td>\n                  </tr>\n                </table>\n                <p class="mt-3">Hasil diatas hanya menggambarkan kondisi saat dilakukan pengambilan spesimen. Surat keterangan ini dibuat sesuai dengan kondisi pada saat pengambilan spesimen untuk dipergunakan sebagaimana mestinya.</p><br/>\n                <p>Catatan:</p>\n                <ul>\n                    <li>Jika timbul gejala klinis, atau ada kontak / kecurigaan kontak dengan pasien terinfeksi setelah pemeriksaan dilakukan. Mohon segera lakukan konsultasi dengan Dokter/ fasilitas kesehatan terdekat.</li>\n                    <li>Pemeriksaan ulang dan pemeriksaan tambahan dapat dilakukan kembali berdasarkan rekomendasi Dokter.</li>\n                    <li>Hasil positif dilanjutkan dengan pemeriksaan MT-PCR(swab test) untuk menegakkan diagnosis pasti.</li>\n                </ul>\n              </div>\n            </div>\n\n            <div class="row pt-5">\n                <div class="col-4">\n                    <p>Jakarta, <t t-esc="o.to_date_string(data['registration_date'])"/></p>\n                    <img t-att-src="data['signature']" style="height: 125px;"/>\n                    <p><strong>dr. Vania Aramita Sari</strong></p>\n                </div>\n                <div class="col-7 py-3">\n                    <div class="text-right my-3" id="qrcode">\n                        <img t-att-src="o['qr_code_url']" style="width:125px;height:125px;"/>\n                    </div>\n                </div>\n            </div>\n            <p class="mt-2"><strong>Klinik Utama Plasthetic Clinic. No. Izin: 3/B.6/31.71.07.1002.03.006.R.4.a.b/3/-1.779.3/e/2019</strong></p>\n          </div>\n        </t>\n      </t>\n    	ehealth_document/report/template_covid_report/report_swift_antigen.xml	\N	\N	\N	\N	primary	t	1	2025-08-28 11:34:01.364376	1	2025-08-28 11:34:01.364376	f
1489	report_swift_pcr	\N	ehealth_document.report_swift_pcr	16	qweb	<?xml version="1.0"?>\n<t t-name="ehealth_document.report_swift_pcr">\n        <t t-set="company" t-value="res_company"/>\n        <t t-call="ehealth_document.header_swift_document">\n          <div class="page">\n            <div class="row">\n              <div class="col-md-12">\n                <p class="text-center mt-3"><strong>SURAT KETERANGAN HASIL PEMERIKSAAN SWAB PCR</strong></p>\n                <p class="mt-4">Yang bertanda tangan di bawah ini menerangkan bahwa:</p>\n                <div class="mt-3">\n                    <div class="row">\n                        <div class="col-3">No</div>\n                        <div class="col-3">: <t t-esc="o['name']"/></div>\n                    </div>\n                    <div class="row">\n                        <div class="col-3">\n                          <t t-if="o['partner_id']['identity_type'] == 'ktp'">NIK</t>\n                          <t t-if="o['partner_id']['identity_type'] == 'sim'">No. SIM</t>\n                          <t t-if="o['partner_id']['identity_type'] == 'paspor'">No. Paspor</t>\n                        </div>\n                        <div class="col-6">: \n                          <t t-if="o['partner_id']['identity_type'] == 'ktp'"><t t-esc="o['partner_id']['nik']"/></t>\n                          <t t-else=""><t t-esc="o['partner_id']['identity_number']"/></t>\n                        </div>\n                    </div>\n                    <div class="row">\n                        <div class="col-3">Nama</div>\n                        <div class="col-6">: <t t-esc="o['partner_id']['name']"/></div>\n                    </div>\n                    <div class="row">\n                        <div class="col-3">Jenis Kelamin</div>\n                        <div class="col-6">: \n                          <t t-if="o['partner_id']['gender'] == 'male'">Laki-Laki</t>\n                          <t t-else="">Perempuan</t>\n                        </div>\n                    </div>\n                    <div class="row">\n                        <div class="col-3">Tanggal Lahir</div>\n                        <div class="col-6">: <t t-esc="o['partner_id']['birthDate'].strftime('%d-%m-%Y')"/></div>\n                    </div>\n                    <div class="row">\n                        <div class="col-3">Alamat</div>\n                        <div class="col-6">: <t t-esc="o['partner_id']['street']"/></div>\n                    </div>\n                    <div class="row">\n                        <div class="col-3">Tanggal Pemeriksaan</div>\n                        <div class="col-6">: <t t-esc="o.to_date_string(data['registration_date'])"/></div>\n                    </div>\n                    <div class="row">\n                        <div class="col-3">Waktu</div>\n                        <div class="col-6">: <t t-esc="o.to_time_string(data['registration_date'])"/> WIB</div>\n                    </div>\n                </div>\n\n                <table class="table table-bordered table-sm mt-5 mb-2">\n                  <tr class="text-center">\n                      <th>Pemeriksaan</th>\n                      <th>Hasil</th>\n                      <th>Nilai CT Value</th>\n                  </tr>\n                  <tr>\n                      <td class="text-center"><t t-esc="data['examination_type']"/></td>\n                      <td rowspan="2" width="130" class="text-center">\n                        <strong>\n                          <t t-if="data['result'] == 'Positive'">\n                            <span style="color:red">\n                               POSITIF\n                            </span>\n                          </t>\n                          <t t-if="data['result'] == 'Negative'">\n                            <span>\n                               NEGATIF\n                            </span>\n                          </t>\n                        </strong>\n                      </td>\n                      <td class="text-center">\n                        <t t-if="data['result'] == 'Positive'">\n                          <span>ORF SARS-Cov-2: <t t-esc="data['orf1ab']"/><br/>N SARS-Cov-2: <t t-esc="data['gen_n']"/></span>\n                        </t>\n                        <t t-if="data['result'] == 'Negative'">\n                          <span>\n                            <strong>SARS-Cov-2 TIDAK TERDETEKSI</strong>\n                          </span>\n                        </t>\n                      </td>\n                  </tr>\n                </table>\n                <p class="mt-3">Hasil diatas hanya menggambarkan kondisi saat dilakukan pengambilan spesimen. Surat keterangan ini dibuat sesuai dengan kondisi pada saat pengambilan spesimen untuk dipergunakan sebagaimana mestinya.</p><br/>\n                <p>Catatan:</p>\n                <ul>\n                    <li>Jika timbul gejala klinis, atau ada kontak / kecurigaan kontak dengan pasien terinfeksi setelah pemeriksaan dilakukan. Mohon segera lakukan konsultasi dengan Dokter/ fasilitas kesehatan terdekat.</li>\n                    <li>Pemeriksaan ulang dan pemeriksaan tambahan dapat dilakukan kembali berdasarkan rekomendasi Dokter.</li>\n                </ul>\n              </div>\n            </div>\n\n            <div class="row pt-5">\n                <div class="col-4">\n                    <p>Jakarta, <t t-esc="o.to_date_string(data['registration_date'])"/></p>\n                    <img t-att-src="data['signature']" style="height: 125px;"/>\n                    <p><strong>dr. Vania Aramita Sari</strong></p>\n                </div>\n                <div class="col-7 py-3">\n                    <div class="text-right my-3" id="qrcode">\n                        <img t-att-src="o['qr_code_url']" style="width:125px;height:125px;"/>\n                    </div>\n                </div>\n            </div>\n            <p class="mt-2"><strong>Klinik Utama Plasthetic Clinic. No. Izin: 3/B.6/31.71.07.1002.03.006.R.4.a.b/3/-1.779.3/e/2019</strong></p>\n          </div>\n        </t>\n      </t>\n    	ehealth_document/report/template_covid_report/report_swift_pcr.xml	\N	\N	\N	\N	primary	t	1	2025-08-28 11:34:01.364376	1	2025-08-28 11:34:01.364376	f

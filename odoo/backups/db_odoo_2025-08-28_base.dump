ice_total']" position="after">\n            <field name="procedure_note" optional="show"/>\n        </xpath>\n\n        <xpath expr="//field[@name='amount_total']" position="before">\n          <field name="additional_component" attrs="{'invisible': [('additional_component', '=', 0)]}"/>\n        </xpath>\n\n        <xpath expr="//field[@name='line_ids']/tree/field[@name='discount']" position="before">\n          <field name="is_structure_rule_line" invisible="1"/>\n          <field name="structure_rule_id" invisible="1"/>\n        </xpath>\n      </data>	ehealth/views/cashier.xml	\N	\N	624	\N	extension	t	1	2025-08-28 11:33:43.631866	1	2025-08-28 11:33:43.631866	f

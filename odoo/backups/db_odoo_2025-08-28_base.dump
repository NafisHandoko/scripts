1097	stock.inventory.form.inherit	stock.inventory	\N	16	form	<?xml version="1.0"?>\n<data><xpath expr="//field[@name='company_id']" position="before">\n                    <field name="accounting_date" attrs="{'readonly':[('state','=', 'done')]}"/>\n                </xpath>\n                <xpath expr="//div[@name='button_box']" position="inside">\n                    <field name="has_account_moves" invisible="1"/>\n                    <button name="action_get_account_moves" type="object" string="Accounting Entries" icon="fa-usd" class="oe_stat_button" attrs="{'invisible': [('has_account_moves', '=', False)]}"/>\n                </xpath>\n            </data>	stock_account/views/stock_account_views.xml	\N	\N	857	\N	extension	t	1	2025-08-28 11:33:12.235114	1	2025-08-28 11:33:12.235114	f
1095	account.invoice.send.form.inherited.snailmail	account.invoice.send	\N	16	form	<?xml version="1.0"?>\n<data><xpath expr="//div[@name='option_email']" position="before">\n                    <div name="option_letter">\n                        <field name="invalid_addresses" invisible="1"/>\n                        <div name="option" class="text-left d-inline-block">\n                            <field name="snailmail_is_letter"/>\n                            <b><label for="snailmail_is_letter"/></b>\n                        </div>\n                        <span attrs="{'invisible': [('snailmail_is_letter','=', False)]}">\n                            <span class="mr4" attrs="{'invisible': [('snailmail_cost', '=', 0)]}">\n                                <b>(\n                                    <span>\n                                        <field name="snailmail_cost" options="{'digits':[0,0]}" class="mr4"/>\n                                        <label for="snailmail_cost" class="mr4"/>\n                                    </span>\n                                    <i class="fa fa-info-circle" role="img" aria-label="Warning" title="Make sure you have enough Stamps on your account."/>\n                                )</b>\n                            </span>\n                            <span attrs="{'invisible': [('composition_mode', '=', 'mass_mail')]}">\n                                <span attrs="{'invisible': [('invalid_addresses', '!=', 0)]}">\n                                    <div class="text-right text-muted d-inline-block" name="address">\n                                        <span> to: </span>\n                                        <field name="partner_id" readonly="1" force_save="1" context="{'show_address': 1, 'address_inline': 1}" options="{'always_reload': True, 'no_quick_create': True}"/>\n                                    </div>\n                                </span>\n                                <span attrs="{'invisible': [('invalid_addresses', '=', 0)]}">\n                                    <div class="text-right d-inline-block" attrs="{'invisible': [('composition_mode', '=', 'mass_mail')]}">\n                                        <span class="text-danger">\n                                            The customer address is not complete.\n                                        </span>\n                                    </div>\n                                </span>\n                            </span>\n                            <span attrs="{'invisible': [('composition_mode', '!=', 'mass_mail')]}">\n                                <span attrs="{'invisible': [('invalid_addresses', '=', 0)]}">\n                                    <span class="text-danger">\n                                        Some customer addresses are not complete.\n                                    </span>\n                                    <button type="object" name="invalid_addresses_action" class="btn btn-link" role="button"><field name="invalid_addresses" readonly="1" options="{'digits':[0,0]}"/> invoices</button>\n                                </span>\n                            </span>\n                        </span>\n                    </div>\n                </xpath>\n                <xpath expr="//footer/button[hasclass('send_and_print')]" position="attributes">\n                    <attribute name="attrs">{'invisible': ['|', ('is_print', '=', False), '&amp;', '&amp;', ('is_print', '=', True), ('snailmail_is_letter', '=', False), ('is_email', '=', False)]}</attribute>\n                </xpath>\n                <xpath expr="//footer/button[hasclass('send')]" position="attributes">\n                    <attribute name="attrs">{'invisible': ['|', ('is_print', '=', True), '&amp;', '&amp;', ('is_print', '=', False), ('snailmail_is_letter', '=', False), ('is_email', '=', False)]}</attribute>\n                </xpath>\n                <xpath expr="//footer/button[hasclass('print')]" position="attributes">\n                    <attribute name="attrs">{'invisible': ['|', '|', ('is_print', '=', False), ('snailmail_is_letter', '=', True), ('is_email', '=', True)]}</attribute>\n                </xpath>\n            </data>	snailmail_account/wizard/account_invoice_send_views.xml	\N	\N	752	\N	extension	t	1	2025-08-28 11:33:11.420483	1	2025-08-28 11:33:11.420483	f
1160	report_saleorder_document	\N	sale.report_saleorder_document	16	qweb	<?xml version="1.0"?>\n<t t-name="sale.report_saleorder_document">\n    <t t-call="web.external_layout">\n        <t t-set="doc" t-value="doc.with_context(lang=doc.partner_id.lang)"/>\n        <t t-set="address">\n            <div t-field="doc.partner_id" t-options="{&quot;widget&quot;: &quot;contact&quot;, &quot;fields&quot;: [&quot;address&quot;, &quot;name&quot;], &quot;no_marker&quot;: True}"/>\n            <p t-if="doc.partner_id.vat"><t t-esc="doc.company_id.country_id.vat_label or 'Tax ID'"/>: <span t-field="doc.partner_id.vat"/></p>\n        </t>\n        <t t-if="doc.partner_shipping_id == doc.partner_invoice_id                              and doc.partner_invoice_id != doc.partner_id                              or doc.partner_shipping_id != doc.partner_invoice_id">\n            <t t-set="information_block">\n                <strong t-if="doc.partner_shipping_id == doc.partner_invoice_id">Invoicing and Shipping Address:</strong>\n                <strong t-if="doc.partner_shipping_id != doc.partner_invoice_id">Invoicing Address:</strong>\n                <div t-field="doc.partner_invoice_id" t-options="{&quot;widget&quot;: &quot;contact&quot;, &quot;fields&quot;: [&quot;address&quot;, &quot;name&quot;, &quot;phone&quot;], &quot;no_marker&quot;: True, &quot;phone_icons&quot;: True}"/>\n                <t t-if="doc.partner_shipping_id != doc.partner_invoice_id">\n                    <strong>Shipping Address:</strong>\n                    <div t-field="doc.partner_shipping_id" t-options="{&quot;widget&quot;: &quot;contact&quot;, &quot;fields&quot;: [&quot;address&quot;, &quot;name&quot;, &quot;phone&quot;], &quot;no_marker&quot;: True, &quot;phone_icons&quot;: True}"/>\n                </t>\n            </t>\n        </t>\n        <div class="page">\n            <div class="oe_structure"/>\n\n            <h2 class="mt16">\n                <t t-if="not (env.context.get('proforma', False) or is_pro_forma)">\n                    <span t-if="doc.state not in ['draft','sent']">Order # </span>\n                    <span t-if="doc.state in ['draft','sent']">Quotation # </span>\n                </t>\n                <t t-if="env.context.get('proforma', False) or is_pro_forma">\n                    <span>Pro-Forma Invoice # </span>\n                </t>\n                <span t-field="doc.name"/>\n            </h2>\n\n            <div class="row mt32 mb32" id="informations">\n                <div t-if="doc.client_order_ref" class="col-auto col-3 mw-100 mb-2">\n                    <strong>Your Reference:</strong>\n                    <p class="m-0" t-field="doc.client_order_ref"/>\n                </div>\n                <div t-if="doc.date_order and doc.state not in ['draft','sent']" class="col-auto col-3 mw-100 mb-2">\n                    <strong>Order Date:</strong>\n                    <p class="m-0" t-field="doc.date_order"/>\n                </div>\n                <div t-if="doc.date_order and doc.state in ['draft','sent']" class="col-auto col-3 mw-100 mb-2">\n                    <strong>Quotation Date:</strong>\n                    <p class="m-0" t-field="doc.date_order" t-options="{&quot;widget&quot;: &quot;date&quot;}"/>\n                </div>\n                <div t-if="doc.validity_date and doc.state in ['draft', 'sent']" class="col-auto col-3 mw-100 mb-2" name="expiration_date">\n                    <strong>Expiration:</strong>\n                    <p class="m-0" t-field="doc.validity_date"/>\n                </div>\n                <div t-if="doc.user_id.name" class="col-auto col-3 mw-100 mb-2">\n                    <strong>Salesperson:</strong>\n                    <p class="m-0" t-field="doc.user_id"/>\n                </div>\n            </div>\n\n            <!-- Is there a discount on at least one line? -->\n            <t t-set="display_discount" t-value="any(l.discount for l in doc.order_line)"/>\n\n            <table class="table table-sm o_main_table">\n                <!-- In case we want to repeat the header, remove "display: table-row-group" -->\n                <thead style="display: table-row-group">\n                    <tr>\n                        <th name="th_description" class="text-left">Description</th>\n                        <th name="th_quantity" class="text-right">Quantity</th>\n                        <th name="th_priceunit" class="text-right">Unit Price</th>\n                        <th name="th_discount" t-if="display_discount" class="text-right" groups="product.group_discount_per_so_line">\n                            <span>Disc.%</span>\n                        </th>\n                        <th name="th_taxes" class="text-right">Taxes</th>\n                        <th name="th_subtotal" class="text-right">\n                            <span groups="account.group_show_line_subtotals_tax_excluded">Amount</span>\n                            <span groups="account.group_show_line_subtotals_tax_included">Total Price</span>\n                        </th>\n                    </tr>\n                </thead>\n                <tbody class="sale_tbody">\n\n                    <t t-set="current_subtotal" t-value="0"/>\n\n                    <t t-foreach="doc.order_line" t-as="line">\n\n                        <t t-set="current_subtotal" t-value="current_subtotal + line.price_subtotal" groups="account.group_show_line_subtotals_tax_excluded"/>\n                        <t t-set="current_subtotal" t-value="current_subtotal + line.price_total" groups="account.group_show_line_subtotals_tax_included"/>\n\n                        <tr t-att-class="'bg-200 font-weight-bold o_line_section' if line.display_type == 'line_section' else 'font-italic o_line_note' if line.display_type == 'line_note' else ''">\n                            <t t-if="not line.display_type">\n                                <td name="td_name"><span t-field="line.name"/></td>\n                                <td name="td_quantity" class="text-right">\n                                    <span t-field="line.product_uom_qty"/>\n                                    <span t-field="line.product_uom"/>\n                                </td>\n                                <td name="td_priceunit" class="text-right">\n                                    <span t-field="line.price_unit"/>\n                                </td>\n                                <td t-if="display_discount" class="text-right" groups="product.group_discount_per_so_line">\n                                    <span t-field="line.discount"/>\n                                </td>\n                                <td name="td_taxes" class="text-right">\n                                    <span t-esc="', '.join(map(lambda x: (x.description or x.name), line.tax_id))"/>\n                                </td>\n                                <td name="td_subtotal" class="text-right o_price_total">\n                                    <span t-field="line.price_subtotal" groups="account.group_show_line_subtotals_tax_excluded"/>\n                                    <span t-field="line.price_total" groups="account.group_show_line_subtotals_tax_included"/>\n                                </td>\n                            </t>\n                            <t t-if="line.display_type == 'line_section'">\n                                <td name="td_section_line" colspan="99">\n                                    <span t-field="line.name"/>\n                                </td>\n                                <t t-set="current_section" t-value="line"/>\n                                <t t-set="current_subtotal" t-value="0"/>\n                            </t>\n                            <t t-if="line.display_type == 'line_note'">\n                                <td name="td_note_line" colspan="99">\n                                    <span t-field="line.name"/>\n                                </td>\n                            </t>\n                        </tr>\n\n                        <t t-if="current_section and (line_last or doc.order_line[line_index+1].display_type == 'line_section')">\n                            <tr class="is-subtotal text-right">\n                                <td name="td_section_subtotal" colspan="99">\n                                    <strong class="mr16">Subtotal</strong>\n                                    <span t-esc="current_subtotal" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: doc.pricelist_id.currency_id}"/>\n                                </td>\n                            </tr>\n                        </t>\n                    </t>\n                </tbody>\n            </table>\n\n            <div class="clearfix" name="so_total_summary">\n                <div id="total" class="row" name="total">\n                    <div t-attf-class="#{'col-6' if report_type != 'html' else 'col-sm-7 col-md-6'} ml-auto">\n                        <table class="table table-sm">\n                            <tr class="border-black o_subtotal" style="">\n                                <td name="td_amount_untaxed_label"><strong>Subtotal</strong></td>\n                                <td name="td_amount_untaxed" class="text-right">\n                                    <span t-field="doc.amount_untaxed"/>\n                                </td>\n                            </tr>\n                            <t t-foreach="doc.amount_by_group" t-as="amount_by_group">\n                                <tr style="">\n                                    <t t-if="amount_by_group[5] == 1 and doc.amount_untaxed == amount_by_group[2]">\n                                        <td name="td_amount_by_group_label_3">\n                                            <span t-esc="amount_by_group[0]"/>\n                                            <span>&amp;nbsp;<span>on</span>&amp;nbsp;<t t-esc="amount_by_group[2]" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: doc.pricelist_id.currency_id}"/></span>\n                                        </td>\n                                        <td name="td_amount_by_group_3" class="text-right o_price_total">\n                                            <span t-esc="amount_by_group[1]" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: doc.pricelist_id.currency_id}"/>\n                                        </td>\n                                    </t>\n                                    <t t-else="">\n                                        <td name="td_amount_by_group_label">\n                                            <span t-esc="amount_by_group[0]"/>\n                                        </td>\n                                        <td name="td_amount_by_group" class="text-right o_price_total">\n                                            <span t-esc="amount_by_group[1]" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: doc.pricelist_id.currency_id}"/>\n                                        </td>\n                                    </t>\n                                </tr>\n                            </t>\n                            <tr class="border-black o_total">\n                                <td name="td_amount_total_label"><strong>Total</strong></td>\n                                <td name="td_amount_total" class="text-right">\n                                    <span t-field="doc.amount_total"/>\n                                </td>\n                            </tr>\n                        </table>\n                    </div>\n                </div>\n            </div>\n\n            <div t-if="doc.signature" class="mt32 ml64 mr4" name="signature">\n                <div class="offset-8">\n                    <strong>Signature</strong>\n                </div>\n                <div class="offset-8">\n                    <img t-att-src="image_data_uri(doc.signature)" style="max-height: 4cm; max-width: 8cm;"/>\n                </div>\n                <div class="offset-8 text-center">\n                    <p t-field="doc.signed_by"/>\n                </div>\n            </div>\n\n            <div class="oe_structure"/>\n\n            <p t-field="doc.note"/>\n            <p t-if="doc.payment_term_id.note">\n                <span t-field="doc.payment_term_id.note"/>\n            </p>\n            <p id="fiscal_position_remark" t-if="doc.fiscal_position_id and doc.fiscal_position_id.sudo().note">\n                <strong>Fiscal Position Remark:</strong>\n                <span t-field="doc.fiscal_position_id.sudo().note"/>\n            </p>\n        </div>\n    </t>\n</t>\n\n\n	sale/report/sale_report_templates.xml	\N	\N	\N	\N	primary	t	1	2025-08-28 11:33:25.849737	1	2025-08-28 11:33:25.849737	f

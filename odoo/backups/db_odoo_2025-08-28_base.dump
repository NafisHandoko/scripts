222	internal_layout	\N	web.internal_layout	16	qweb	<?xml version="1.0"?>\n<t t-name="web.internal_layout">\n        <t t-if="not o" t-set="o" t-value="doc"/>\n\n        <t t-if="not company">\n            <!-- Multicompany -->\n            <t t-if="company_id">\n                <t t-set="company" t-value="company_id"/>\n            </t>\n            <t t-elif="o and 'company_id' in o and o.company_id.sudo()">\n                <t t-set="company" t-value="o.company_id.sudo()"/>\n            </t>\n            <t t-else="else">\n                <t t-set="company" t-value="res_company"/>\n            </t>\n        </t>\n\n        <div class="header">\n            <div class="row">\n                <div class="col-3">\n                    <span t-esc="context_timestamp(datetime.datetime.now()).strftime('%Y-%m-%d %H:%M')"/>\n                </div>\n                <div class="col-2 offset-2 text-center">\n                    <span t-esc="company.name"/>\n                </div>\n                <div class="col-2 offset-3 text-right">\n                    <ul class="list-inline">\n                        <li class="list-inline-item"><span class="page"/></li>\n                        <li class="list-inline-item">/</li>\n                        <li class="list-inline-item"><span class="topage"/></li>\n                    </ul>\n                </div>\n            </div>\n        </div>\n        <div class="article" t-att-data-oe-model="o and o._name" t-att-data-oe-id="o and o.id" t-att-data-oe-lang="o and o.env.context.get('lang')">\n          <t t-raw="0"/>\n        </div>\n    </t>\n\n    	web/views/report_templates.xml	\N	\N	\N	\N	primary	t	1	2025-08-28 11:31:55.892008	1	2025-08-28 11:31:55.892008	\N

951	report_partnerledger	\N	accounting_pdf_reports.report_partnerledger	16	qweb	<?xml version="1.0"?>\n<t t-name="accounting_pdf_reports.report_partnerledger">\n        <t t-call="web.html_container">\n            <t t-call="web.internal_layout">\n                <t t-set="data_report_margin_top" t-value="12"/>\n                <t t-set="data_report_header_spacing" t-value="9"/>\n                <t t-set="data_report_dpi" t-value="110"/>\n                <div class="page">\n                    <h2>Partner Ledger</h2>\n                    <div class="row">\n                        <div class="col-3">\n                            <strong>Company:</strong>\n                            <p t-esc="res_company.name"/>\n                        </div>\n                        <div class="col-3">\n                            <t t-if="data['form']['date_from']">\n                                <strong>Date from :</strong>\n                                <span t-esc="data['form']['date_from']"/>\n                                <br/>\n                            </t>\n                            <t t-if="data['form']['date_to']">\n                                <strong>Date to :</strong>\n                                <span t-esc="data['form']['date_to']"/>\n                            </t>\n                        </div>\n                        <div class="col-3">\n                            <strong>Target Moves:</strong>\n                            <p t-if="data['form']['target_move'] == 'all'">All Entries</p>\n                            <p t-if="data['form']['target_move'] == 'posted'">All Posted Entries</p>\n                        </div>\n                    </div>\n\n                    <table class="table table-sm table-reports">\n                        <thead>\n                            <tr>\n                                <th>Date</th>\n                                <th>JRNL</th>\n                                <th>Account</th>\n                                <th>Ref</th>\n                                <th>Debit</th>\n                                <th>Credit</th>\n                                <th>Balance</th>\n                                <th t-if="data['form']['amount_currency']">Currency</th>\n                            </tr>\n                        </thead>\n                        <t t-foreach="docs" t-as="o">\n                            <tbody>\n                                <tr>\n                                    <td colspan="4">\n                                        <strong t-esc="o.ref"/>\n                                        -\n                                        <strong t-esc="o.name"/>\n                                    </td>\n                                    <td class="text-right">\n                                        <strong t-esc="sum_partner(data, o, 'debit')" t-options="{'widget': 'monetary', 'display_currency': res_company.currency_id}"/>\n                                    </td>\n                                    <td class="text-right">\n                                        <strong t-esc="sum_partner(data, o, 'credit')" t-options="{'widget': 'monetary', 'display_currency': res_company.currency_id}"/>\n                                    </td>\n                                    <td class="text-right">\n                                        <strong t-esc="sum_partner(data, o, 'debit - credit')" t-options="{'widget': 'monetary', 'display_currency': res_company.currency_id}"/>\n                                    </td>\n                                </tr>\n                                <tr t-foreach="lines(data, o)" t-as="line">\n                                    <td>\n                                        <span t-esc="line['date']"/>\n                                    </td>\n                                    <td>\n                                        <span t-esc="line['code']"/>\n                                    </td>\n                                    <td>\n                                        <span t-esc="line['a_code']"/>\n                                    </td>\n                                    <td>\n                                        <span t-esc="line['displayed_name']"/>\n                                    </td>\n                                    <td class="text-right">\n                                        <span t-esc="line['debit']" t-options="{'widget': 'monetary', 'display_currency': res_company.currency_id}"/>\n                                    </td>\n                                    <td class="text-right">\n                                        <span t-esc="line['credit']" t-options="{'widget': 'monetary', 'display_currency': res_company.currency_id}"/>\n                                    </td>\n                                    <td class="text-right">\n                                        <span t-esc="line['progress']" t-options="{'widget': 'monetary', 'display_currency': res_company.currency_id}"/>\n                                    </td>\n                                    <td class="text-right" t-if="data['form']['amount_currency']">\n                                        <t t-if="line['currency_id']">\n                                            <span t-esc="line['amount_currency']" t-options="{'widget': 'monetary', 'display_currency': line['currency_id']}"/>\n                                        </t>\n                                    </td>\n                                </tr>\n                            </tbody>\n                        </t>\n                    </table>\n                </div>\n            </t>\n        </t>\n    </t>\n	accounting_pdf_reports/reports/report_partner_ledger.xml	\N	\N	\N	\N	primary	t	1	2025-08-28 11:32:53.730915	1	2025-08-28 11:32:53.730915	f
952	report_general_ledger	\N	accounting_pdf_reports.report_general_ledger	16	qweb	<?xml version="1.0"?>\n<t t-name="accounting_pdf_reports.report_general_ledger">\n        <t t-call="web.html_container">\n            <t t-set="data_report_margin_top" t-value="12"/>\n            <t t-set="data_report_header_spacing" t-value="9"/>\n            <t t-set="data_report_dpi" t-value="110"/>\n            <t t-call="web.internal_layout">\n                <div class="page">\n                    <h2><span t-esc="res_company.name"/>: General ledger</h2>\n\n                    <div class="row mt32">\n                        <div class="col-4">\n                            <strong>Journals:</strong>\n                              <p t-esc="', '.join([ lt or '' for lt in print_journal ])"/>\n                        </div>\n                        <div class="col-4">\n                            <strong>Display Account</strong>\n                            <p>\n                                <span t-if="data['display_account'] == 'all'">All accounts'</span>\n                                <span t-if="data['display_account'] == 'movement'">With movements</span>\n                                <span t-if="data['display_account'] == 'not_zero'">With balance not equal to zero</span>\n                            </p>\n                        </div>\n                        <div class="col-4">\n                            <strong>Target Moves:</strong>\n                            <p t-if="data['target_move'] == 'all'">All Entries</p>\n                            <p t-if="data['target_move'] == 'posted'">All Posted Entries</p>\n                        </div>\n                    </div>\n                    <div class="row mb32">\n                        <div class="col-4">\n                            <strong>Sorted By:</strong>\n                            <p t-if="data['sortby'] == 'sort_date'">Date</p>\n                            <p t-if="data['sortby'] == 'sort_journal_partner'">Journal and Partner</p>\n                        </div>\n                        <div class="col-4">\n                            <t t-if="data['date_from']"><strong>Date from :</strong> <span t-esc="data['date_from']"/><br/></t>\n                            <t t-if="data['date_to']"><strong>Date to :</strong> <span t-esc="data['date_to']"/></t>\n                        </div>\n                    </div>\n\n                    <table class="table table-sm table-reports">\n                        <thead>\n                            <tr class="text-center">\n                                <th>Date</th>\n                                <th>JRNL</th>\n                                <th>Partner</th>\n                                <th>Ref</th>\n                                <th>Move</th>\n                                <th>Entry Label</th>\n                                <th>Debit</th>\n                                <th>Credit</th>\n                                <th>Balance</th>\n                                <th groups="base.group_multi_currency">Currency</th>\n                            </tr>\n                        </thead>\n                        <tbody>\n                            <t t-foreach="Accounts" t-as="account">\n                                <tr style="font-weight: bold;">\n                                    <td colspan="6">\n                                        <span style="color: white;" t-esc="'..'"/>\n                                        <span t-esc="account['code']"/>\n                                        <span t-esc="account['name']"/>\n                                    </td>\n                                    <td class="text-right">\n                                        <span t-esc="account['debit']" t-options="{'widget': 'monetary', 'display_currency': res_company.currency_id}"/>\n                                    </td>\n                                    <td class="text-right">\n                                        <span t-esc="account['credit']" t-options="{'widget': 'monetary', 'display_currency': res_company.currency_id}"/>\n                                    </td>\n                                    <td class="text-right">\n                                        <span t-esc="account['balance']" t-options="{'widget': 'monetary', 'display_currency': res_company.currency_id}"/>\n                                    </td>\n                                    <td groups="base.group_multi_currency"/>\n                                </tr>\n                                <tr t-foreach="account['move_lines']" t-as="line">\n                                    <td><span t-esc="line['ldate']"/></td>\n                                    <td><span t-esc="line['lcode']"/></td>\n                                    <td><span t-esc="line['partner_name']"/></td>\n                                    <td><span t-if="line['lref']" t-esc="line['lref']"/></td>\n                                    <td><span t-esc="line['move_name']"/></td>\n                                    <td><span t-esc="line['lname']"/></td>\n                                    <td class="text-right">\n                                        <span t-esc="line['debit']" t-options="{'widget': 'monetary', 'display_currency': res_company.currency_id}"/>\n                                    </td>\n                                    <td class="text-right">\n                                        <span t-esc="line['credit']" t-options="{'widget': 'monetary', 'display_currency': res_company.currency_id}"/>\n                                    </td>\n                                    <td class="text-right">\n                                        <span t-esc="line['balance']" t-options="{'widget': 'monetary', 'display_currency': res_company.currency_id}"/>\n                                    </td>\n                                    <td class="text-right" groups="base.group_multi_currency">\n                                        <span t-esc="line['amount_currency'] if line['amount_currency'] and line['amount_currency'] &gt; 0.00 else ''"/>\n                                        <span t-esc="line['currency_code'] if line['amount_currency'] and line['amount_currency'] &gt; 0.00 else ''"/>\n                                    </td>\n                                </tr>\n                            </t>\n                        </tbody>\n                    </table>\n                </div>\n            </t>\n        </t>\n    </t>\n	accounting_pdf_reports/reports/report_general_ledger.xml	\N	\N	\N	\N	primary	t	1	2025-08-28 11:32:53.730915	1	2025-08-28 11:32:53.730915	f

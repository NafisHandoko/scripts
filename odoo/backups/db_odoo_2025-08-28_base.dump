          </tbody>\n                    </table>\n\n                    <p t-field="o.notes"/>\n                    <div class="oe_structure"/>\n                </div>\n                <div>\n                    <p>Obat mengandung Psikotropika tersebut akan digunakan untuk memenuhi kebutuhan:</p>\n                    <table class="table table-borderless table-sm">\n                        <tr>\n                            <td width="180">Nama Apotek</td>\n                            <td>: <t t-esc="pharmacy_name"/></td>\n                        </tr>\n                        <tr>\n                            <td>Alamat Lengkap</td>\n                            <td>: <t t-esc="pharmacy_address"/></td>\n                        </tr>\n                        <tr>\n                            <td>Nomor Ijin Apotek</td>\n                            <td>: <t t-esc="pharmacy_register"/></td>\n                        </tr>\n                        <tr>\n                            <td>Telp</td>\n                            <td>: <t t-esc="pharmacy_phone"/></td>\n                        </tr>\n                    </table>\n                </div>\n                <div class="row pt-5 text-left">\n                    <div class="col-5 py-3"/>\n                    <div class="col-5 offset-2">\n                        <p><t t-esc="o.company_id.city"/>, <t t-esc="o.to_date_string(o.date_order)"/></p>\n                        <p><t t-esc="apothecary_in_charge.name"/></p>\n                        <br/>\n                        <br/>\n                        <br/>\n                        <p>No. SIPA: <t t-esc="apothecary_in_charge.sipa"/></p>\n                    </div>\n                </div>\n            </t>\n        </t>\n    	ehealth/reports/pharmacy_purchase_order_psychotropic_report.xml	\N	\N	\N	\N	primary	t	1	2025-08-28 11:33:43.631866	1	2025-08-28 11:33:43.631866	f
210	Report layout	\N	web.report_layout	16	qweb	<?xml version="1.0"?>\n<t name="Report layout" t-name="web.report_layout">&lt;!DOCTYPE html&gt;\n        <html t-att-lang="lang and lang.replace('_', '-')" t-att-data-report-margin-top="data_report_margin_top" t-att-data-report-header-spacing="data_report_header_spacing" t-att-data-report-dpi="data_report_dpi" t-att-data-report-landscape="data_report_landscape" t-att-web-base-url="web_base_url">\n            <head>\n                <meta charset="utf-8"/>\n                <meta name="viewport" content="initial-scale=1"/>\n                <title><t t-esc="title or 'Odoo Report'"/></title>\n                <t t-call-assets="web.report_assets_common" t-js="false"/>\n                <t t-call-assets="web.assets_common" t-css="false"/>\n                <t t-call-assets="web.report_assets_common" t-css="false"/>\n            </head>\n            <body t-att-class="'container' if not full_width else 'container-fluid'">\n                <div id="wrapwrap">\n                    <main>\n                        <t t-raw="0"/>\n                    </main>\n                </div>\n            </body>\n        </html>\n    </t>\n\n    	web/views/report_templates.xml	\N	\N	\N	\N	primary	t	1	2025-08-28 11:31:55.892008	1	2025-08-28 11:31:55.892008	\N

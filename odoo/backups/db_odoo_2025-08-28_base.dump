1137	exception_on_po	\N	purchase_stock.exception_on_po	16	qweb	<?xml version="1.0"?>\n<t t-name="purchase_stock.exception_on_po">\n        <div>\n          Exception(s) occurred on the purchase order(s):\n          <t t-foreach="purchase_order_ids" t-as="purchase_order">\n              <a href="#" data-oe-model="purchase.order" t-att-data-oe-id="purchase_order.id"><t t-esc="purchase_order.name"/></a>.\n          </t>\n          Manual actions may be needed.\n          <div class="mt16">\n              <p>Exception(s):</p>\n              <ul t-foreach="order_exceptions" t-as="exception">\n                  <li>\n                      <t t-set="order_line" t-value="exception[0]"/>\n                      <t t-set="new_qty" t-value="exception[1][0]"/>\n                      <t t-set="old_qty" t-value="exception[1][1]"/>\n                      <t t-esc="new_qty"/> <t t-esc="order_line.product_uom.name"/> of <t t-esc="order_line.product_id.name"/>\n                      ordered instead of <t t-esc="old_qty"/> <t t-esc="order_line.product_uom.name"/>\n                  </li>\n              </ul>\n          </div>\n          <div class="mt16" t-if="impacted_pickings">\n              <p>Next transfer(s) impacted:</p>\n              <ul t-foreach="impacted_pickings" t-as="picking">\n                  <li><a href="#" data-oe-model="stock.picking" t-att-data-oe-id="picking.id"><t t-esc="picking.name"/></a></li>\n              </ul>\n          </div>\n        </div>\n    </t>\n\n	purchase_stock/data/mail_data.xml	\N	\N	\N	\N	primary	t	1	2025-08-28 11:33:23.332607	1	2025-08-28 11:33:23.332607	f
1127	account_invoice_partner_facturx_export	\N	account_edi_facturx.account_invoice_partner_facturx_export	16	qweb	<?xml version="1.0"?>\n<t t-name="account_edi_facturx.account_invoice_partner_facturx_export">\n            <t xmlns:ram="urn:un:unece:uncefact:data:standard:ReusableAggregateBusinessInformationEntity:100" xmlns:rsm="urn:un:unece:uncefact:data:standard:CrossIndustryInvoice:100" xmlns:udt="urn:un:unece:uncefact:data:standard:UnqualifiedDataType:100">\n                <!-- Contact. -->\n                <ram:Name t-if="partner.name" t-esc="partner.name"/>\n\n                <ram:SpecifiedLegalOrganization t-if="SpecifiedLegalOrganization">\n                    <ram:ID t-esc="SpecifiedLegalOrganization"/>\n                </ram:SpecifiedLegalOrganization>\n\n                <ram:DefinedTradeContact>\n                    <ram:PersonName t-esc="partner.name"/>\n                    <ram:TelephoneUniversalCommunication t-if="partner.phone or partner.mobile">\n                        <ram:CompleteNumber t-esc="partner.phone or partner.mobile"/>\n                    </ram:TelephoneUniversalCommunication>\n                    <ram:EmailURIUniversalCommunication t-if="partner.email">\n                        <ram:URIID schemeID="SMTP" t-esc="partner.email"/>\n                    </ram:EmailURIUniversalCommunication>\n                </ram:DefinedTradeContact>\n\n                <!-- Address. -->\n                <ram:PostalTradeAddress>\n                    <ram:PostcodeCode t-if="partner.zip" t-esc="partner.zip"/>\n                    <ram:LineOne t-if="partner.street" t-esc="partner.street"/>\n                    <ram:LineTwo t-if="partner.street2" t-esc="partner.street2"/>\n                    <ram:CityName t-if="partner.city" t-esc="partner.city"/>\n                    <ram:CountryID t-if="partner.country_id" t-esc="partner.country_id.code"/>\n                </ram:PostalTradeAddress>\n            </t>\n        </t>\n\n        	account_edi_facturx/data/facturx_templates.xml	\N	\N	\N	\N	primary	t	1	2025-08-28 11:33:17.016378	1	2025-08-28 11:33:17.016378	f
1138	purchase stock assets	\N	purchase_stock.assets_backend	16	qweb	<?xml version="1.0"?>\n<data name="purchase stock assets" inherit_id="web.assets_backend">\n        <xpath expr="script[last()]" position="after">\n            <script type="text/javascript" src="/purchase_stock/static/src/js/tours/purchase_stock.js"/>\n        </xpath>\n    </data>\n	purchase_stock/views/assets.xml	\N	\N	185	\N	extension	t	1	2025-08-28 11:33:23.332607	1	2025-08-28 11:33:23.332607	f
1128	account_invoice_facturx_export	\N	account_edi_facturx.account_invoice_facturx_export	16	qweb	<?xml version="1.0"?>\n<t t-name="account_edi_facturx.account_invoice_facturx_export">\n            <t t-set="currency" t-value="record.currency_id or record.company_currency_id"/>\n            <rsm:CrossIndustryInvoice xmlns:ram="urn:un:unece:uncefact:data:standard:ReusableAggregateBusinessInformationEntity:100" xmlns:rsm="urn:un:unece:uncefact:data:standard:CrossIndustryInvoice:100" xmlns:udt="urn:un:unece:uncefact:data:standard:UnqualifiedDataType:100">\n                <!-- Factur-x level:\n                    * minimum or basicwl:   urn:factur-x.eu:1p0...\n                    * basic:                urn:cen.eu:en16931:2017:compliant:factur-x.eu:1p0:basic\n                    * en16931:              urn:cen.eu:en16931:2017\n                -->\n                <rsm:ExchangedDocumentContext>\n                    <ram:GuidelineSpecifiedDocumentContextParameter>\n                        <ram:ID>urn:cen.eu:en16931:2017#conformant#urn:factur-x.eu:1p0:extended</ram:ID>\n                    </ram:GuidelineSpecifiedDocumentContextParameter>\n                </rsm:ExchangedDocumentContext>\n\n                <!-- Document Headers. -->\n                <rsm:ExchangedDocument>\n                    <ram:ID t-esc="record.name"/>\n                    <ram:TypeCode t-esc="'381' if 'refund' in record.move_type else '380'"/>\n                    <ram:IssueDateTime>\n                        <udt:DateTimeString format="102" t-esc="format_date(record.invoice_date)"/>\n                    </ram:IssueDateTime>\n                    <ram:IncludedNote t-if="record.narration">\n                        <ram:Content t-esc="record.narration"/>\n                    </ram:IncludedNote>\n                </rsm:ExchangedDocument>\n\n                <rsm:SupplyChainTradeTransaction>\n                    <!-- Invoice lines. -->\n                    <t t-foreach="invoice_line_values" t-as="line_values">\n                        <t t-call="account_edi_facturx.account_invoice_line_facturx_export"/>\n                    </t>\n\n                    <!-- Partners. -->\n                    <ram:ApplicableHeaderTradeAgreement>\n                        <ram:BuyerReference t-esc="buyer_reference or record.ref"/>\n\n                        <!-- Seller. -->\n                        <ram:SellerTradeParty>\n                            <!-- Address. -->\n                            <t t-call="account_edi_facturx.account_invoice_partner_facturx_export">\n                                <t t-set="partner" t-value="record.company_id.partner_id"/>\n                                <t t-set="SpecifiedLegalOrganization" t-value="seller_specified_legal_organization"/>\n                            </t>\n\n                            <!-- VAT. -->\n                            <ram:SpecifiedTaxRegistration t-if="record.company_id.vat">\n                                <ram:ID schemeID="VA" t-esc="record.company_id.vat"/>\n                            </ram:SpecifiedTaxRegistration>\n                        </ram:SellerTradeParty>\n\n                        <!-- Customer. -->\n                        <ram:BuyerTradeParty>\n                            <!-- Address. -->\n                            <t t-call="account_edi_facturx.account_invoice_partner_facturx_export">\n                                <t t-set="partner" t-value="record.commercial_partner_id"/>\n                                <t t-set="SpecifiedLegalOrganization" t-value="buyer_specified_legal_organization"/>\n                            </t>\n\n                            <!-- VAT. -->\n                            <ram:SpecifiedTaxRegistration t-if="record.commercial_partner_id.vat">\n                                <ram:ID schemeID="VA" t-esc="record.commercial_partner_id.vat"/>\n                            </ram:SpecifiedTaxRegistration>\n                        </ram:BuyerTradeParty>\n\n                        <!-- Reference. -->\n                        <ram:BuyerOrderReferencedDocument>\n                            <ram:IssuerAssignedID t-esc="purchase_order_reference or record.payment_reference or record.name"/>\n                        </ram:BuyerOrderReferencedDocument>\n\n                        <ram:ContractReferencedDocument t-if="contract_reference">\n                            <ram:IssuerAssignedID t-esc="contract_reference"/>\n                        </ram:ContractReferencedDocument>\n                    </ram:ApplicableHeaderTradeAgreement>\n\n                    <!-- Delivery. Don't make a dependency with sale only for one field. -->\n                    <ram:ApplicableHeaderTradeDelivery>\n                        <ram:ShipToTradeParty>\n                            <t t-call="account_edi_facturx.account_invoice_partner_facturx_export">\n                                <t t-if="'partner_shipping_id' in record._fields and record.partner_shipping_id" t-set="partner" t-value="record.partner_shipping_id"/>\n                                <t t-else="" t-set="partner" t-value="record.commercial_partner_id"/>\n                            </t>\n                        </ram:ShipToTradeParty>\n                    </ram:ApplicableHeaderTradeDelivery>\n\n                    <!-- Taxes. -->\n                    <ram:ApplicableHeaderTradeSettlement>\n                        <ram:InvoiceCurrencyCode t-esc="record.currency_id.name"/>\n\n                        <!-- Bank account. -->\n                        <ram:SpecifiedTradeSettlementPaymentMeans t-if="record.partner_bank_id.acc_type == 'iban'">\n                        <ram:TypeCode>42</ram:TypeCode>\n                            <ram:PayeePartyCreditorFinancialAccount>\n                                <ram:IBANID t-esc="record.partner_bank_id.sanitized_acc_number"/>\n                            </ram:PayeePartyCreditorFinancialAccount>\n                        </ram:SpecifiedTradeSettlementPaymentMeans>\n\n                        <!-- Tax Summary. -->\n                        <t t-foreach="tax_details" t-as="tax_vals">\n                            <ram:ApplicableTradeTax>\n                                <ram:CalculatedAmount t-esc="format_monetary(tax_vals['tax_amount'], currency)"/>\n                                <ram:TypeCode>VAT</ram:TypeCode>\n                                <ram:ExemptionReason t-if="tax_vals['unece_tax_category_code'] == 'E'" t-esc="tax_vals['exemption_reason']"/>\n                                <ram:ExemptionReason t-if="tax_vals['unece_tax_category_code'] == 'G'" t-esc="'Export outside the EU'"/>\n                                <ram:ExemptionReason t-if="tax_vals['unece_tax_category_code'] == 'K'" t-esc="'Intra-community supply'"/>\n                                <ram:BasisAmount t-esc="format_monetary(tax_vals['tax_base_amount'], currency)"/>\n                                <ram:CategoryCode t-esc="tax_vals['unece_tax_category_code']"/>\n                                <ram:RateApplicablePercent t-esc="tax_vals['amount']"/>\n                            </ram:ApplicableTradeTax>\n                        </t>\n\n                        <ram:BillingSpecifiedPeriod>\n                            <ram:StartDateTime>\n                                <udt:DateTimeString format="102" t-esc="format_date(record.invoice_date)"/>\n                            </ram:StartDateTime>\n                        </ram:BillingSpecifiedPeriod>\n\n                        <!-- Payment Term. -->\n                        <ram:SpecifiedTradePaymentTerms>\n                            <ram:Description t-if="record.invoice_payment_term_id" t-esc="record.invoice_payment_term_id.name"/>\n                            <ram:DueDateDateTime t-if="record.invoice_date_due">\n                                <udt:DateTimeString format="102" t-esc="format_date(record.invoice_date_due)"/>\n                            </ram:DueDateDateTime>\n                        </ram:SpecifiedTradePaymentTerms>\n\n                        <!-- Summary. -->\n                        <ram:SpecifiedTradeSettlementHeaderMonetarySummation>\n                            <ram:LineTotalAmount t-esc="format_monetary(record.amount_untaxed, currency)"/>\n                            <ram:TaxBasisTotalAmount t-esc="format_monetary(record.amount_untaxed, currency)"/>\n                            <ram:TaxTotalAmount t-att-currencyID="currency.name" t-esc="format_monetary(record.amount_tax, currency)"/>\n                            <ram:GrandTotalAmount t-esc="format_monetary(record.amount_total, currency)"/>\n                            <ram:TotalPrepaidAmount t-esc="format_monetary(record.amount_total - record.amount_residual, currency)"/>\n                            <ram:DuePayableAmount t-esc="format_monetary(record.amount_residual, currency)"/>\n                        </ram:SpecifiedTradeSettlementHeaderMonetarySummation>\n                    </ram:ApplicableHeaderTradeSettlement>\n                </rsm:SupplyChainTradeTransaction>\n            </rsm:CrossIndustryInvoice>\n        </t>\n\n        	account_edi_facturx/data/facturx_templates.xml	\N	\N	\N	\N	primary	t	1	2025-08-28 11:33:17.016378	1	2025-08-28 11:33:17.016378	f
1129	account_invoice_pdfa_3_facturx_metadata	\N	account_edi_facturx.account_invoice_pdfa_3_facturx_metadata	16	qweb	<?xml version="1.0"?>\n<t t-name="account_edi_facturx.account_invoice_pdfa_3_facturx_metadata">\n            <x:xmpmeta xmlns:x="adobe:ns:meta/">\n                <rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#">\n                    <rdf:Description xmlns:pdfaid="http://www.aiim.org/pdfa/ns/id/" rdf:about="">\n                        <pdfaid:part>3</pdfaid:part>\n                        <pdfaid:conformance>B</pdfaid:conformance>\n                    </rdf:Description>\n                    <rdf:Description xmlns:dc="http://purl.org/dc/elements/1.1/" rdf:about="">\n                        <dc:title>\n                            <rdf:Alt>\n                                <rdf:li t-att="{'xml:lang': 'x-default'}" t-esc="title"/>\n                            </rdf:Alt>\n                        </dc:title>\n                        <dc:creator>\n                            <rdf:Seq>\n                                <rdf:li>Odoo</rdf:li>\n                            </rdf:Seq>\n                        </dc:creator>\n                        <dc:description>\n                            <rdf:Alt>\n                                <rdf:li t-att="{'xml:lang': 'x-default'}">Invoice generated by Odoo</rdf:li>\n                            </rdf:Alt>\n                        </dc:description>\n                    </rdf:Description>\n                    <rdf:Description xmlns:pdf="http://ns.adobe.com/pdf/1.3/" rdf:about="">\n                        <pdf:Producer>Odoo</pdf:Producer>\n                    </rdf:Description>\n                    <rdf:Description xmlns:xmp="http://ns.adobe.com/xap/1.0/" rdf:about="">\n                        <xmp:CreatorTool>Odoo</xmp:CreatorTool>\n                        <xmp:CreateDate t-esc="date"/>\n                        <xmp:ModifyDate t-esc="date"/>\n                    </rdf:Description>\n                    <rdf:Description xmlns:pdfaExtension="http://www.aiim.org/pdfa/ns/extension/" xmlns:pdfaSchema="http://www.aiim.org/pdfa/ns/schema#" xmlns:pdfaProperty="http://www.aiim.org/pdfa/ns/property#" rdf:about="">\n                        <pdfaExtension:schemas>\n                            <rdf:Bag>\n                                <rdf:li rdf:parseType="Resource">\n                                    <pdfaSchema:schema>Factur-X PDFA Extension Schema</pdfaSchema:schema>\n                                    <pdfaSchema:namespaceURI>urn:factur-x:pdfa:CrossIndustryDocument:invoice:1p0#</pdfaSchema:namespaceURI>\n                                    <pdfaSchema:prefix>fx</pdfaSchema:prefix>\n                                    <pdfaSchema:property>\n                                        <rdf:Seq>\n                                            <rdf:li rdf:parseType="Resource">\n                                                <pdfaProperty:name>DocumentFileName</pdfaProperty:name>\n                                                <pdfaProperty:valueType>Text</pdfaProperty:valueType>\n                                                <pdfaProperty:category>external</pdfaProperty:category>\n                                                <pdfaProperty:description>name of the embedded XML invoice file</pdfaProperty:description>\n                                            </rdf:li>\n                                            <rdf:li rdf:parseType="Resource">\n                                                <pdfaProperty:name>DocumentType</pdfaProperty:name>\n                                                <pdfaProperty:valueType>Text</pdfaProperty:valueType>\n                                                <pdfaProperty:category>external</pdfaProperty:category>\n                                                <pdfaProperty:description>INVOICE</pdfaProperty:description>\n                                            </rdf:li>\n                                            <rdf:li rdf:parseType="Resource">\n                                                <pdfaProperty:name>Version</pdfaProperty:name>\n                                                <pdfaProperty:valueType>Text</pdfaProperty:valueType>\n                                                <pdfaProperty:category>external</pdfaProperty:category>\n                                                <pdfaProperty:description>The actual version of the Factur-X XML schema</pdfaProperty:description>\n                                            </rdf:li>\n                                            <rdf:li rdf:parseType="Resource">\n                                                <pdfaProperty:name>ConformanceLevel</pdfaProperty:name>\n                                                <pdfaProperty:valueType>Text</pdfaProperty:valueType>\n                                                <pdfaProperty:category>external</pdfaProperty:category>\n                                                <pdfaProperty:description>The conformance level of the embedded Factur-X data</pdfaProperty:description>\n                                            </rdf:li>\n                                        </rdf:Seq>\n                                    </pdfaSchema:property>\n                                </rdf:li>\n                            </rdf:Bag>\n                        </pdfaExtension:schemas>\n                    </rdf:Description>\n                    <rdf:Description xmlns:fx="urn:factur-x:pdfa:CrossIndustryDocument:invoice:1p0#" rdf:about="">\n                        <fx:ConformanceLevel>EN 16931</fx:ConformanceLevel>\n                        <fx:DocumentFileName>factur-x.xml</fx:DocumentFileName>\n                        <fx:DocumentType>INVOICE</fx:DocumentType>\n                        <fx:Version>1.0</fx:Version>\n                    </rdf:Description>\n                </rdf:RDF>\n            </x:xmpmeta>\n        </t>\n    	account_edi_facturx/data/facturx_templates.xml	\N	\N	\N	\N	primary	t	1	2025-08-28 11:33:17.016378	1	2025-08-28 11:33:17.016378	f

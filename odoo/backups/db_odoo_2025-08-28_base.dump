605	account.move.line.form	account.move.line	\N	2	form	<?xml version="1.0"?>\n<form string="Journal Item" create="false">\n                    <sheet>\n                        <field name="company_id" invisible="1"/>\n                        <field name="parent_state" invisible="1"/>\n                        <group>\n                            <field name="name"/>\n                            <field name="partner_id" domain="['|', ('parent_id', '=', False), ('is_company', '=', True)]" readonly="1"/>\n                        </group>\n                        <notebook colspan="4">\n                            <page string="Information" name="information">\n                                <group>\n                                    <group string="Amount">\n                                        <field name="account_id" options="{'no_create': True}" domain="[('company_id', '=', company_id)]" readonly="1"/>\n                                        <field name="debit" readonly="1"/>\n                                        <field name="credit" readonly="1"/>\n                                        <field name="quantity" readonly="1"/>\n                                    </group>\n                                    <group string="Accounting Documents">\n                                        <field name="move_id" readonly="1"/>\n                                        <field name="statement_id" readonly="True" attrs="{'invisible': [('statement_id','=',False)]}"/>\n                                    </group>\n                                    <group string="Dates">\n                                        <field name="date" groups="account.group_account_readonly"/>\n                                        <field name="date_maturity"/>\n                                    </group>\n\n                                    <group string="Taxes" attrs="{'invisible': [('tax_line_id','=',False), ('tax_ids','=',[])]}">\n                                        <field name="tax_line_id" readonly="1" attrs="{'invisible': [('tax_line_id','=',False)]}"/>\n                                        <field name="tax_ids" widget="many2many_tags" readonly="1" attrs="{'invisible': [('tax_ids','=',[])]}"/>\n                                        <field name="tax_exigible" readonly="1"/>\n                                        <field name="tax_audit"/>\n                                    </group>\n                                    <group string="Matching" attrs="{'invisible':[('matched_debit_ids', '=', []),('matched_credit_ids', '=', [])]}">\n                                        <label for="full_reconcile_id"/>\n                                        <div>\n                                            <field name="full_reconcile_id" attrs="{'invisible':[('full_reconcile_id','=',False)]}"/>\n                                            <field name="matched_debit_ids" invisible="1"/>\n                                            <field name="matched_credit_ids" invisible="1"/>\n                                            <button name="open_reconcile_view" class="oe_link" type="object" string="-&gt; View partially reconciled entries" attrs="{'invisible': ['|', ('full_reconcile_id', '!=', False), '&amp;', ('matched_debit_ids', '=', []),('matched_credit_ids', '=', [])]}">\n                                            </button>\n                                        </div>\n                                    </group>\n                                    <group string="Currency" groups="base.group_multi_currency">\n                                        <field name="currency_id" invisible="1"/>\n                                        <field name="amount_currency"/>\n                                    </group>\n                                    <group string="Product" attrs="{'invisible': [('product_id', '=', False)]}">\n                                        <field name="product_id" readonly="1"/>\n                                    </group>\n                                    <group string="States">\n                                        <field name="blocked"/>\n                                    </group>\n                                    <group string="Analytic" groups="analytic.group_analytic_accounting,analytic.group_analytic_tags">\n                                        <field name="analytic_account_id" groups="analytic.group_analytic_accounting" domain="['|', ('company_id', '=', company_id), ('company_id', '=', False)]" readonly="1"/>\n                                        <field name="analytic_tag_ids" groups="analytic.group_analytic_tags" widget="many2many_tags"/>\n                                    </group>\n                                </group>\n                            </page>\n                            <page string="Analytic Lines" name="analytic_lines" groups="analytic.group_analytic_accounting">\n                                <field name="date" invisible="1"/>\n                                <field name="analytic_line_ids" context="{'tree_view_ref':'analytic.view_account_analytic_line_tree', 'default_general_account_id':account_id, 'default_name': name, 'default_date':date, 'amount': (debit or 0.0)-(credit or 0.0)}"/>\n                            </page>\n                        </notebook>\n                    </sheet>\n                </form>\n            	account/views/account_move_views.xml	\N	\N	\N	\N	primary	t	1	2025-08-28 11:32:28.994214	1	2025-08-28 11:32:28.994214	f
1556	report_klinikdel_surat_sakit	\N	ehealth_document.report_klinikdel_surat_sakit	16	qweb	<?xml version="1.0"?>\n<t t-name="ehealth_document.report_klinikdel_surat_sakit">\n        <t t-set="company" t-value="res_company"/>\n        <t t-call="ehealth_document.header_klinikdel_document">\n          <div class="page">\n            <div class="row">\n              <div class="col-md-12">\n                <p class="text-center mt-4 mb-0"><strong>SURAT KETERANGAN SAKIT</strong></p>\n                <p class="text-center">Nomor: <t t-esc="o['name']"/></p>\n                <p class="mt-4">Yang bertanda tangan di bawah ini menerangkan bahwa:</p>\n                <div class="mt-3 ml-3">\n                    <div class="row">\n                        <div class="col-3">\n                          <t t-if="o['partner_id']['identity_type'] == 'ktp'">NIK</t>\n                          <t t-if="o['partner_id']['identity_type'] == 'sim'">No. SIM</t>\n                          <t t-if="o['partner_id']['identity_type'] == 'paspor'">No. Paspor</t>\n                        </div>\n                        <div class="col-6">:\n                          <t t-if="o['partner_id']['identity_type'] == 'ktp'"><t t-esc="o['partner_id']['nik']"/></t>\n                          <t t-else=""><t t-esc="o['partner_id']['identity_number']"/></t>\n                        </div>\n                    </div>\n                    <div class="row">\n                        <div class="col-3">Nama</div>\n                        <div class="col-6">: <t t-esc="o['partner_id']['name']"/></div>\n                    </div>\n                    <div class="row">\n                        <div class="col-3">Tanggal Lahir</div>\n                        <div class="col-6">: <t t-esc="o['partner_id']['birthDate'].strftime('%d-%m-%Y')"/></div>\n                    </div>\n                    <div class="row">\n                        <div class="col-3">Jenis Kelamin</div>\n                        <div class="col-6">:\n                          <t t-if="o['partner_id']['gender'] == 'male'">Laki-Laki</t>\n                          <t t-else="">Perempuan</t>\n                        </div>\n                    </div>\n                    <div class="row">\n                        <div class="col-3">Pekerjaan</div>\n                        <div class="col-6">: <t t-esc="o['partner_id']['function']"/></div>\n                    </div>\n                    <div class="row">\n                        <div class="col-3">Alamat</div>\n                        <div class="col-6">: <t t-esc="o['partner_id']['street']"/></div>\n                    </div>\n                    <t t-if="'diagnosa' in data">\n                      <div class="row">\n                          <div class="col-3">Diagnosa</div>\n                          <div class="col-6">: <t t-esc="data['diagnosa']"/></div>\n                      </div>\n                    </t>\n                </div>\n                <p class="mt-3 mb-2">Perlu beristirahat karena sakit sehingga tidak dapat melaksanakan kewajibannya selama: <strong><t t-esc="o.count_date_delta(data['tanggal-awal'],data['tanggal-akhir'])"/> hari</strong> terhitung <br/> mulai tanggal <strong><t t-esc="data['tanggal-awal']"/></strong> s/d <strong><t t-esc="data['tanggal-akhir']"/></strong>.</p>\n                <p>Harap yang berkepentingan maklum.</p><br/>\n              </div>\n            </div>\n\n            <div class="row pt-5">\n                <div class="col-1"/>\n                <div class="col-3 mt-4">\n                    <p class="mb-0">Validasi</p>\n                    <div class="mt-3" id="qrcode">\n                        <img t-att-src="o['qr_code_url']" style="width:125px;height:125px;"/>\n                    </div>\n                </div>\n                <div class="col-4"/>\n                <div class="col-4">\n                    <p class="mb-0"><t t-esc="o['operating_unit_id']['company_id']['city']"/>, <t t-esc="o.to_date_string(data['registration_date'])"/></p>\n                    <p class="mb-0">Dokter Pemeriksa</p>\n                    <div class="mt-3" id="qrcode">\n                        <t t-if="'qr_code_examiner_url' in data">\n                          <img t-att-src="data['qr_code_examiner_url']" style="width:125px;height:125px;"/>\n                        </t>\n                        <t t-else="">\n                          <div style="width:125px;height:125px;"/>\n                        </t>\n                    </div>\n                    <p class="mb-0 mt-2"><strong>\n                    <t t-if="'examiner_name' in data">\n                      <t t-esc="data['examiner_name']"/>\n                    </t>\n                    <t t-else="">\n                      <t t-esc="data['sender']"/>\n                    </t>\n                    </strong></p>\n                </div>\n            </div>\n          </div>\n        </t>\n      </t>\n    	ehealth_document/report/template_surat_sakit/report_klinikdel_surat_sakit.xml	\N	\N	\N	\N	primary	t	1	2025-08-28 11:34:01.364376	1	2025-08-28 11:34:01.364376	f

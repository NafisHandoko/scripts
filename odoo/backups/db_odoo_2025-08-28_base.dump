551	sms.composer.view.form	sms.composer	\N	16	form	<?xml version="1.0"?>\n<form string="Send an SMS">\n                <sheet>\n                    <group>\n                        <field name="composition_mode" invisible="1"/>\n                        <field name="comment_single_recipient" invisible="1"/>\n                        <field name="res_id" invisible="1"/>\n                        <field name="res_ids" invisible="1"/>\n                        <field name="active_domain" invisible="1"/>\n                        <field name="res_model" invisible="1"/>\n                        <field name="mass_force_send" invisible="1"/>\n                        <field name="recipient_single_valid" invisible="1"/>\n                        <field name="recipient_single_number" invisible="1"/>\n                        <field name="number_field_name" invisible="1"/>\n                        <field name="numbers" invisible="1"/>\n                        <field name="sanitized_numbers" invisible="1"/>\n\n                        <!-- Single mode information (invalid number) -->\n                        <div colspan="2" class="alert alert-danger text-center mb-3" role="alert" attrs="{'invisible': ['|', ('comment_single_recipient', '=', False), ('recipient_single_valid', '=', True)]}">\n                            <p class="my-0">Invalid phone number</p>\n                        </div>\n\n                        <!-- Mass mode information (res_ids versus active domain) -->\n                        <div colspan="2" class="alert alert-info text-center mb-3" role="alert" attrs="{'invisible': [('comment_single_recipient', '=', True)]}">\n                            <p class="my-0">\n                                <span attrs="{'invisible': [('use_active_domain', '=', 'True')]}">\n                                    <field class="oe_inline font-weight-bold" name="res_ids_count"/> records selected.\n                                </span>\n                                Check <field class="oe_inline ml-2" name="use_active_domain"/> to send to all\n                                <field class="oe_inline font-weight-bold ml-2" name="active_domain_count"/> records instead. <br/>\n                                <field class="oe_inline font-weight-bold" name="recipient_valid_count"/> recipients are valid\n                                and <field class="oe_inline font-weight-bold" name="recipient_invalid_count"/> are invalid.\n                            </p>\n                        </div>\n\n                        <label for="recipient_single_description" string="Recipient" class="font-weight-bold" attrs="{'invisible': [('comment_single_recipient', '=', False)]}"/>\n                        <div attrs="{'invisible': [('comment_single_recipient', '=', False)]}">\n                            <field name="recipient_single_description" class="oe_inline" attrs="{'invisible': [('recipient_single_description', '=', False)]}"/>\n                            <field name="recipient_single_number_itf" class="oe_inline" nolabel="1" options="{'onchange_on_keydown': True}" placeholder="e.g. +1 415 555 0100"/>\n                        </div>\n                                                \n                        <field name="body" widget="sms_widget"/>\n                        <field name="mass_keep_log" invisible="1"/>\n                    </group>\n                </sheet>\n                <footer>\n                    <!-- attrs doesn't work for 'disabled'-->\n                    <button string="Send SMS" type="object" class="oe_highlight" name="action_send_sms" attrs="{'invisible': ['|',('composition_mode', 'not in', ('comment', 'numbers')),('recipient_single_valid', '=', False)]}"/>\n                    <button string="Send SMS" type="object" class="oe_highlight" name="action_send_sms" attrs="{'invisible': ['|',('composition_mode', 'not in', ('comment', 'numbers')),('recipient_single_valid', '=', True)]}" disabled="1"/>\n                    <button string="Put in queue" type="object" class="oe_highlight" name="action_send_sms" attrs="{'invisible': [('composition_mode', '!=', 'mass')]}"/>\n                    <button string="Send Now" type="object" name="action_send_sms_mass_now" attrs="{'invisible': [('composition_mode', '!=', 'mass')]}"/>\n                    <button string="Close" class="btn btn-secondary" special="cancel"/>\n                </footer>\n            </form>\n        	sms/wizard/sms_composer_views.xml	\N	\N	\N	\N	primary	t	1	2025-08-28 11:32:25.511275	1	2025-08-28 11:32:25.511275	f
552	sms.template.preview.form	sms.template.preview	\N	16	form	<?xml version="1.0"?>\n<form string="SMS Preview">\n                    <h3>Preview of <field name="sms_template_id" readonly="1" nolabel="1" class="oe_inline"/></h3>\n                    <field name="no_record" invisible="1"/>\n                    <div class="o_row">\n                        <span>Choose an example <field name="model_id" readonly="1"/> record:</span>\n                        <div>\n                            <field name="resource_ref" class="oe_inline" options="{'hide_model': True, 'no_create': True, 'no_edit': True, 'no_open': True}" attrs="{'invisible': [('no_record', '=', True)]}"/>\n                            <span class="text-warning" attrs="{'invisible': [('no_record', '=', False)]}">No records</span>\n                        </div>\n                    </div>\n                    <p>Choose a language: <field name="lang" class="oe_inline ml8"/></p>\n                    <label for="body" string="SMS content"/>\n                    <hr/>\n                        <field name="body" readonly="1" nolabel="1" options="{&quot;safe&quot;: True}"/>\n                    <hr/>\n                    <footer>\n                        <button string="Discard" class="btn-secondary" special="cancel"/>\n                    </footer>\n                </form>\n            	sms/wizard/sms_template_preview_views.xml	\N	\N	\N	\N	primary	t	1	2025-08-28 11:32:25.511275	1	2025-08-28 11:32:25.511275	f
1539	report_wellclinic_surat_sehat	\N	ehealth_document.report_wellclinic_surat_sehat	16	qweb	<?xml version="1.0"?>\n<t t-name="ehealth_document.report_wellclinic_surat_sehat">\n        <t t-set="company" t-value="res_company"/>\n        <t t-call="ehealth_document.header_wellclinic_document">\n          <t t-set="o" t-value="o.with_context(lang=lang)"/> \n          <div class="page">\n            <div class="row">\n              <div class="col-md-12">\n                <p class="text-center mt-3 mb-0"><strong>SURAT KETERANGAN SEHAT</strong></p>\n                <p class="text-center">Nomor: <t t-esc="o['name']"/></p>\n                <p class="mt-4">Yang bertanda tangan di bawah ini menerangkan bahwa:</p>\n                <div class="mt-3 ml-3">\n                    <div class="row">\n                        <div class="col-3">\n                          <t t-if="o['partner_id']['identity_type'] == 'ktp'">NIK</t>\n                          <t t-if="o['partner_id']['identity_type'] == 'sim'">No. SIM</t>\n                          <t t-if="o['partner_id']['identity_type'] == 'paspor'">No. Paspor</t>\n                        </div>\n                        <div class="col-6">: \n                          <t t-if="o['partner_id']['identity_type'] == 'ktp'"><t t-esc="o['partner_id']['nik']"/></t>\n                          <t t-else=""><t t-esc="o['partner_id']['identity_number']"/></t>\n                        </div>\n                    </div>\n                    <div class="row">\n                        <div class="col-3">Nama</div>\n                        <div class="col-6">: <t t-esc="o['partner_id']['name']"/></div>\n                    </div>\n                    <div class="row">\n                        <div class="col-3">Tanggal Lahir</div>\n                        <div class="col-6">: <t t-esc="o['partner_id']['birthDate'].strftime('%d-%m-%Y')"/></div>\n                    </div>\n                    <div class="row">\n                        <div class="col-3">Jenis Kelamin</div>\n                        <div class="col-6">: \n                          <t t-if="o['partner_id']['gender'] == 'male'">Laki-Laki</t>\n                          <t t-else="">Perempuan</t>\n                        </div>\n                    </div>\n                    <div class="row">\n                        <div class="col-3">Pekerjaan</div>\n                        <div class="col-6">: <t t-esc="o['partner_id']['function']"/></div>\n                    </div>\n                    <div class="row">\n                        <div class="col-3">Alamat</div>\n                        <div class="col-6">: <t t-esc="o['partner_id']['street']"/></div>\n                    </div>\n                </div>\n                <p class="mt-3 mb-0">Setelah dilakukan pemeriksaan, maka yang bersangkutan dinyatakan </p>\n                <p class="text-center"><strong>SEHAT</strong></p>\n                <p>Demikian Surat Keterangan ini dibuat untuk dapat dipergunakan seperlunya.</p><br/>\n                <div class="row">\n                  <div class="col-3">\n                    <p><strong>Keterangan :</strong></p>\n                  </div>\n                </div>\n                <div class="row">\n                  <div class="col-3">Tinggi Badan</div>\n                  <div class="col-3">: <t t-esc="data['tinggi-badan']"/> cm</div>\n                  <div class="col-3">Tekanan Darah</div>\n                  <div class="col-3">: <t t-esc="data['sistole']"/>/<t t-esc="data['diastole']"/> mmHg</div>\n                </div>\n                <div class="row">\n                  <div class="col-3">Berat Badan</div>\n                  <div class="col-3">: <t t-esc="data['berat-badan']"/> kg</div>\n                  <div class="col-3">Buta Warna</div>\n                  <div class="col-3">: <t t-esc="data['buta-warna']"/></div>\n                </div>\n              </div>\n            </div>\n\n            <div class="row pt-5">\n                <div class="col-1"/>\n                <div class="col-3 mt-4">\n                    <p class="mb-0">Validasi</p>\n                    <div class="mt-3" id="qrcode">\n                        <img t-att-src="o['qr_code_url']" style="width:125px;height:125px;"/>\n                    </div>\n                </div>\n                <div class="col-4"/>\n                <div class="col-4">\n                    <p class="mb-0"><t t-esc="o['operating_unit_id']['company_id']['city']"/>, <t t-esc="o.to_date_string(data['registration_date'])"/></p>\n                    <p class="mb-0">Dokter Pemeriksa</p>\n                    <div class="mt-3" id="qrcode">\n                        <!-- <t t-if="'qr_code_examiner_url' in data"> -->\n                          <!-- <img t-att-src="data['qr_code_examiner_url']" style="width:125px;height:125px;"/> -->\n                        <!-- </t> -->\n                        <!-- <t t-else=""> -->\n                        <div style="width:125px;height:125px;">\n                            <t t-if="'examiner_name' in data and data['examiner_name'] in 'Dr. dr. Tirta Darmawan Susanto, Mkes FSASS'">\n                              <img t-att-src="'/ehealth_document/static/src/img/signature/signature-wellclinic-dr-tirta.png'" style="max-height: 125px;" alt="Logo"/>\n                            </t>\n                            <t t-if="'examiner_name' in data and data['examiner_name'] in 'dr. Steve Emmanuel'">\n                              <img t-att-src="'/ehealth_document/static/src/img/signature/signature-wellclinic-dr-steve.png'" style="max-height: 125px;" alt="Logo"/>\n                            </t>\n                            <t t-if="'examiner_name' in data and data['examiner_name'] in 'dr. Catherine Ranatan'">\n                              <img t-att-src="'/ehealth_document/static/src/img/signature/signature-wellclinic-dr-catherine.png'" style="max-height: 125px;" alt="Logo"/>\n                            </t>\n                          </div>\n   
823	product.stock.tree.inherit	product.product	\N	16	tree	<?xml version="1.0"?>\n<field name="price" position="after">\n                    <field name="qty_available" attrs="{'invisible':[('type', '!=', 'product')]}" optional="show" decoration-danger="virtual_available &lt; 0" decoration-warning="virtual_available == 0" decoration-bf="1"/>\n                    <field name="virtual_available" attrs="{'invisible':[('type', '!=', 'product')]}" string="Forecasted Quantity" optional="show" decoration-danger="virtual_available &lt; 0" decoration-warning="virtual_available == 0"/>\n                </field>\n            	stock/views/product_views.xml	\N	\N	460	\N	extension	t	1	2025-08-28 11:32:42.235962	1	2025-08-28 11:32:42.235962	f
824	product.template.stock.tree.inherit	product.template	\N	16	tree	<?xml version="1.0"?>\n<data><field name="uom_id" position="before">\n                    <field name="show_on_hand_qty_status_button" invisible="1"/>\n                    <field name="qty_available" attrs="{'invisible':[('show_on_hand_qty_status_button', '=', False)]}" optional="show" decoration-danger="qty_available &lt; 0"/>\n                    <field name="virtual_available" attrs="{'invisible':[('show_on_hand_qty_status_button', '=', False)]}" optional="show" decoration-danger="virtual_available &lt; 0" decoration-bf="1"/>\n                </field>\n                <field name="default_code" position="after">\n                    <field name="responsible_id" widget="many2one_avatar_user"/>\n                </field>\n            </data>	stock/views/product_views.xml	\N	\N	475	\N	extension	t	1	2025-08-28 11:32:42.235962	1	2025-08-28 11:32:42.235962	f
1698	account_invoice_line_facturx_export_22	\N	account_edi_ubl_cii.account_invoice_line_facturx_export_22	16	qweb	<?xml version="1.0"?>\n<t t-name="account_edi_ubl_cii.account_invoice_line_facturx_export_22">\n            <t t-set="line" t-value="line_vals['line']"/>\n            <t xmlns:ram="urn:un:unece:uncefact:data:standard:ReusableAggregateBusinessInformationEntity:100" xmlns:rsm="urn:un:unece:uncefact:data:standard:CrossIndustryInvoice:100" xmlns:udt="urn:un:unece:uncefact:data:standard:UnqualifiedDataType:100">\n\n                <ram:IncludedSupplyChainTradeLineItem>\n                    <!-- Line number. -->\n                    <ram:AssociatedDocumentLineDocument>\n                        <ram:LineID t-esc="line_vals.get('index')"/>\n                    </ram:AssociatedDocumentLineDocument>\n\n                    <!-- Product. -->\n                    <ram:SpecifiedTradeProduct>\n                        <ram:GlobalID schemeID="0160" t-if="line.product_id and line.product_id.barcode" t-esc="line.product_id.barcode"/>\n                        <ram:SellerAssignedID t-if="line.product_id and line.product_id.default_code" t-esc="line.product_id.default_code"/>\n                        <ram:Name t-esc="line.name"/>\n                    </ram:SpecifiedTradeProduct>\n\n                    <!-- Amounts. -->\n                    <ram:SpecifiedLineTradeAgreement>\n                        <!-- Line information: unit_price\n                        NB: the gross_price_unit should be the price tax excluded !\n                        if price_unit = 100 and tax 10% price_include -> then the gross_price_unit is 91\n                        -->\n                        <ram:GrossPriceProductTradePrice>\n                            <ram:ChargeAmount t-esc="format_monetary(line_vals['gross_price_total_unit'], 2)"/>\n                            <!-- Discount. -->\n                            <ram:AppliedTradeAllowanceCharge t-if="line.discount">\n                                <ram:ChargeIndicator>\n                                    <udt:Indicator>false</udt:Indicator>\n                                </ram:ChargeIndicator>\n                                <ram:ActualAmount t-esc="format_monetary(line_vals['price_discount_unit'], 2)"/>\n                            </ram:AppliedTradeAllowanceCharge>\n                        </ram:GrossPriceProductTradePrice>\n                        <!-- Line unit price, with discount applied -->\n                        <ram:NetPriceProductTradePrice>\n                            <ram:ChargeAmount t-esc="format_monetary(line_vals['price_subtotal_unit'], 2)"/>\n                        </ram:NetPriceProductTradePrice>\n                    </ram:SpecifiedLineTradeAgreement>\n\n                    <!-- Quantity. -->\n                    <ram:SpecifiedLineTradeDelivery>\n                        <ram:BilledQuantity t-att-unitCode="line_vals.get('unece_uom_code')" t-esc="line.quantity"/> <!-- /!\\ The quantity is the line.quantity since we keep the unece_uom_code ! -->\n                    </ram:SpecifiedLineTradeDelivery>\n\n                    <ram:SpecifiedLineTradeSettlement>\n                        <t t-foreach="tax_details['invoice_line_tax_details'][line]['tax_details'].values()" t-as="tax_detail_vals">\n                            <ram:ApplicableTradeTax t-if="tax_detail_vals['amount_type'] == 'percent'">\n                                <ram:TypeCode>VAT</ram:TypeCode>\n                                <ram:CategoryCode t-esc="tax_detail_vals['tax_category_code']"/>\n                                <ram:RateApplicablePercent t-esc="tax_detail_vals['amount']"/>\n                            </ram:ApplicableTradeTax>\n                        </t>\n\n                        <!-- Allowance/Charge on the line -->\n                        <t t-foreach="line_vals.get('allowance_charge_vals_list')" t-as="allowance_charge_vals">\n                            <ram:SpecifiedTradeAllowanceCharge>\n                                <ram:ChargeIndicator>\n                                    <udt:Indicator t-esc="allowance_charge_vals['indicator']"/>\n                                </ram:ChargeIndicator>\n                                <ram:ActualAmount t-esc="format_monetary(allowance_charge_vals['amount'], 2)"/>\n                                <ram:ReasonCode t-esc="allowance_charge_vals['reason_code']"/>\n                                <ram:Reason t-esc="allowance_charge_vals['reason']"/>\n                            </ram:SpecifiedTradeAllowanceCharge>\n                        </t>\n\n                        <!-- Subtotal. -->\n                        <ram:SpecifiedTradeSettlementLineMonetarySummation>\n                            <ram:LineTotalAmount t-esc="format_monetary(line_vals['line_total_amount'], 2)"/>\n                        </ram:SpecifiedTradeSettlementLineMonetarySummation>\n\n                    </ram:SpecifiedLineTradeSettlement>\n                </ram:IncludedSupplyChainTradeLineItem>\n            </t>\n        </t>\n\n        	account_edi_ubl_cii/data/cii_22_templates.xml	\N	\N	\N	\N	primary	t	1	2025-08-28 11:34:13.779942	1	2025-08-28 11:34:13.779942	f
825	product.template.search.stock.form	product.template	\N	16	search	<?xml version="1.0"?>\n<xpath expr="//field[@name='pricelist_id']" position="after">\n                    <separator/>\n                    <field name="location_id" context="{'location': self}" filter_domain="[]"/>\n                    <field name="warehouse_id" context="{'warehouse': self}" filter_domain="[]"/>\n                    <separator/>\n                    <filter name="real_stock_available" string="Available Products" domain="[('qty_available','&gt;',0)]"/>\n                    <filter name="real_stock_negative" string="Negative Forecasted Quantity" domain="[('virtual_available','&lt;',0)]"/>\n                </xpath>\n            	stock/views/product_views.xml	\N	\N	457	\N	primary	t	1	2025-08-28 11:32:42.235962	1	2025-08-28 11:32:42.235962	f
826	product.product.search.stock.form	product.product	\N	16	search	<?xml version="1.0"?>\n<xpath expr="//filter[@name='inactive']" position="after">\n                    <separator/>\n                    <filter name="real_stock_available" string="Available Products" domain="[('qty_available','&gt;',0)]"/>\n                    <filter name="real_stock_negative" string="Negative Forecasted Quantity" domain="[('virtual_available','&lt;',0)]"/>\n                </xpath>\n            	stock/views/product_views.xml	\N	\N	458	\N	primary	t	1	2025-08-28 11:32:42.235962	1	2025-08-28 11:32:42.235962	f
1699	account_invoice_partner_facturx_export_22	\N	account_edi_ubl_cii.account_invoice_partner_facturx_export_22	16	qweb	<?xml version="1.0"?>\n<t t-name="account_edi_ubl_cii.account_invoice_partner_facturx_export_22">\n            <t xmlns:ram="urn:un:unece:uncefact:data:standard:ReusableAggregateBusinessInformationEntity:100" xmlns:rsm="urn:un:unece:uncefact:data:standard:CrossIndustryInvoice:100" xmlns:udt="urn:un:unece:uncefact:data:standard:UnqualifiedDataType:100">\n                <!-- Contact. -->\n                <ram:Name t-esc="partner.name"/>\n                <ram:SpecifiedLegalOrganization t-if="specified_legal_organization_val">\n                    <ram:ID t-att-schemeID="str('0002')" t-esc="specified_legal_organization_val"/>\n                </ram:SpecifiedLegalOrganization>\n\n                <ram:DefinedTradeContact t-if="not hide_dtc">\n                    <ram:PersonName t-esc="partner.name"/>\n                    <ram:TelephoneUniversalCommunication t-if="partner.phone or partner.mobile">\n                        <ram:CompleteNumber t-esc="partner.phone or partner.mobile"/>\n                    </ram:TelephoneUniversalCommunication>\n                    <ram:EmailURIUniversalCommunication t-if="partner.email">\n                        <ram:URIID schemeID="SMTP" t-esc="partner.email"/>\n                    </ram:EmailURIUniversalCommunication>\n                </ram:DefinedTradeContact>\n\n                <!-- Address. -->\n                <t t-call="account_edi_ubl_cii.account_invoice_address_facturx_export_22"/>\n            </t>\n        </t>\n\n        	account_edi_ubl_cii/data/cii_22_templates.xml	\N	\N	\N	\N	primary	t	1	2025-08-28 11:34:13.779942	1	2025-08-28 11:34:13.779942	f
827	product.template.stock.property.form.inherit	product.template	\N	16	form	<?xml version="1.0"?>\n<data><xpath expr="//group[@name='group_lots_and_weight']" position="inside">\n                    <label for="sale_delay" attrs="{'invisible': [('sale_ok', '=', False)]}"/>\n                    <div attrs="{'invisible': [('sale_ok', '=', False)]}">\n                        <field name="sale_delay" class="oe_inline" style="vertical-align:baseline"/> days\n                    </div>\n                </xpath>\n                <xpath expr="//group[@name='group_lots_and_weight']" position="before">\n                    <field name="has_available_route_ids" invisible="1"/>\n                    <group string="Operations" name="operations">\n                        <label for="route_ids" attrs="{'invisible': [('type', 'in', ['service', 'digital'])]}"/>\n                        <div>\n                            <field name="route_ids" class="mb-0" widget="many2many_checkboxes" attrs="{'invisible': ['|', ('has_available_route_ids', '=', False), ('type', 'in', ['service', 'digital'])]}"/>\n                            <button id="stock.view_diagram_button" string="View Diagram" type="action" name="300" icon="fa-arrow-right" attrs="{'invisible':[('type', 'not in', ['product', 'consu'])]}" class="btn btn-link pt-0" context="{'default_product_tmpl_id': id}"/>\n                        </div>\n                        <field name="route_from_categ_ids" widget="many2many_tags" readonly="1" attrs="{'invisible': [('route_from_categ_ids', '=', [])]}"/>\n                    </group>\n                </xpath>\n                <xpath expr="//group[@name='group_lots_and_weight']" position="after">\n                    <group string="Traceability" name="traceability" groups="stock.group_production_lot" attrs="{'invisible': [('type', '=', 'consu')]}">\n                        <field name="tracking" widget="radio" attrs="{'invisible': [('type', 'in', ['service', 'digital'])]}"/>\n                    </group>\n                     <group string="Counterpart Locations" name="stock_property" groups="base.group_no_one">\n                        <field name="property_stock_production"/>\n                        <field name="property_stock_inventory"/>\n                    </group>\n                </xpath>\n                <page name="inventory" position="inside">\n                    <group string="Description for Delivery Orders">\n                        <field name="description_pickingout" nolabel="1" placeholder="This note is added to delivery orders."/>\n                    </group>\n                    <group string="Description for Receipts">\n                        <field name="description_pickingin" nolabel="1" placeholder="This note is added to receipt orders (e.g. where to store the product in the warehouse)."/>\n                    </group>\n                    <group string="Description for Internal Transfers" groups="stock.group_stock_multi_locations">\n                        <field name="description_picking" placeholder="This note is added to internal transfer orders (e.g. where to pick the product in the warehouse)." nolabel="1"/>\n                    </group>\n                </page>\n                <xpath expr="//page[@name='inventory']" position="attributes">\n                    <attribute name="groups" add="stock.group_stock_user" separator=","/>\n                </xpath>\n            </data>	stock/views/product_views.xml	\N	\N	456	\N	extension	t	1	2025-08-28 11:32:42.235962	1	2025-08-28 11:32:42.235962	f

1598	report_assyifa_general_consent	\N	ehealth_document.report_assyifa_general_consent	16	qweb	<?xml version="1.0"?>\n<t t-name="ehealth_document.report_assyifa_general_consent">\n\t\t\t<t t-set="company" t-value="res_company"/>\n\t\t\t<t t-call="ehealth_document.header_assyifa_document">\n\t\t\t\t<div class="page" style="font-size:13px; line-height: 1.4;">\n\t\t\t\t\t<div class="row" style="border: 1px solid black">\n\t\t\t\t\t\t<div class="">\n\t\t\t\t\t\t\t<div style="background-color:#c1d09d; border-bottom: 1px solid black">\n\t\t\t\t\t\t\t\t<p class="text-center mb-0" style="width: 100%;">\n\t\t\t\t\t\t\t\t\t<strong>PENGKAJIAN DATA UMUM PASIEN</strong>\n\t\t\t\t\t\t\t\t</p>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t<div class="row mt-2" style="border-bottom: 1px solid black">\n\t\t\t\t\t\t\t\t<div class="ml-3 mb-1">\n\t\t\t\t\t\t\t\t\t<p>Diisi oleh Petugas Pendaftaran pada</p>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<div class="ml-2 mb-1">\n\t\t\t\t\t\t\t\t\t<p>tanggal: <t t-if="'tgl-consent' in data"><t t-esc="data['tgl-consent']"/></t></p>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<div class="ml-5 mb-1">\n\t\t\t\t\t\t\t\t\t<p>jam: <t t-if="'waktu-consent' in data"><t t-esc="data['waktu-consent']"/></t></p>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t<div class="pl-2" style="border-bottom: 1px solid black">\n\t\t\t\t\t\t\t\t<p class="mb-0" style="font-size: 16px">\n\t\t\t\t\t\t\t\t\t<strong>IDENTITAS PASIEN</strong>\n\t\t\t\t\t\t\t\t</p>\n\t\t\t\t\t\t\t\t<p class="mb-0" style="font-style: italic;">(Diisi sesuai Kartu Tanda Pengenal Pasien yang masih berlaku; KTP/ KK/ SIM/ Kartu Pelajar/ dsb)</p>\n\t\t\t\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t\t\t\t<div class="col-3">Nomer Rekam Medis</div>\n\t\t\t\t\t\t\t\t\t<div class="col-8">: <t t-esc="data['no-cm']"/> </div>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t\t\t\t<div class="col-3">Nama</div>\n\t\t\t\t\t\t\t\t\t<div class="col-8">: <t t-esc="o['partner_id']['name']"/></div>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t\t\t\t<div class="col-3">Jenis Kelamin</div>\n\t\t\t\t\t\t\t\t\t<div class="col-8">:\n\t\t\t\t\t\t\t\t\t\t<t t-if="o['partner_id']['gender'] == 'male'">Laki-Laki</t>\n\t\t\t\t\t\t\t\t\t\t<t t-else="">Perempuan</t>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t\t\t\t<div class="col-3">Tanggal Lahir</div>\n\t\t\t\t\t\t\t\t\t<div class="col-8">: <t t-esc="o['partner_id']['birthDate'].strftime('%d-%m-%Y')"/></div>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t\t\t\t<div class="col-3">Agama</div>\n\t\t\t\t\t\t\t\t\t<div class="col-8">: <t t-if="'religion' in data"> <t t-esc="data['religion']"/> </t></div>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t\t\t\t<div class="col-3">Pendidikan</div>\n\t\t\t\t\t\t\t\t\t<div class="col-8">: </div>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t\t\t\t<div class="col-3">Pekerjaan</div>\n\t\t\t\t\t\t\t\t\t<div class="col-8">: <t t-if="'occupation' in data"> <t t-esc="data['occupation']"/> </t></div>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t\t\t\t<div class="col-3">Alamat</div>\n\t\t\t\t\t\t\t\t\t<div class="col-8">: <t t-esc="o['partner_id']['street']"/></div>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t\t\t\t<div class="col-3">Status Perkawinan</div>\n\t\t\t\t\t\t\t\t\t<div class="col-8">: <t t-if="'marital-status' in data"> <t t-esc="data['marital-status']"/> </t></div>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t\t\t\t<div class="col-3">Nama Suami / Istri</div>\n\t\t\t\t\t\t\t\t\t<div class="col-8">: <t t-if="'partner' in data"> <t t-esc="data['partner']"/> </t></div>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t\t\t\t<div class="col-3">Status Pembiayaan</div>\n\t\t\t\t\t\t\t\t\t<div class="col-8">: <t t-if="'payment' in data"> <t t-esc="data['payment']"/> </t></div>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t<div style="background-color:#c1d09d; border-bottom: 1px solid black">\n\t\t\t\t\t\t\t\t<p class="text-center mb-0" style="width: 100%;">\n\t\t\t\t\t\t\t\t\t<strong>PERSETUJUAN UMUM / GENERAL CONSENT</strong>\n\t\t\t\t\t\t\t\t</p>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t<p class="text-center mt-1 mb-0" style="font-style: italic; text-decoration: underline;">\n\t\t\t\t\t\t\t\t<strong>PASIEN / WALI PASIEN HARUS MEMBACA, MEMAHAMI DAN MENGISI INFORMASI BERIKUT</strong>\n\t\t\t\t\t\t\t</p>\n\t\t\t\t\t\t\t<p class="mt-1 mb-1">Yang bertanda tangan di bawah ini, saya:</p>\n\t\t\t\t\t\t\t<div class="pl-2">\n\t\t\t\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t\t\t\t<div class="col-3">Nama Lengkap</div>\n\t\t\t\t\t\t\t\t\t<div class="col-6">:\n\t\t\t\t\t\t\t\t\t\t<strong>\n\t\t\t\t\t\t\t\t\t\t\t<t t-esc="data['nama-pj']"/>\n\t\t\t\t\t\t\t\t\t\t</strong>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<t t-if="'tgl-lahir-pj' in data">\n\t\t\t\t\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t\t\t\t\t<div class="col-3">Tempat / Tanggal Lahir</div>\n\t\t\t\t\t\t\t\t\t\t<div class="col-6">: <t t-if="'tempat-lahir-pj' in data"><t t-esc="data['tempat-lahir-pj']"/></t>/<t t-if="'tgl-lahir-pj' in data"><t t-esc="data['tgl-lahir-pj']"/></t></div>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t</t>\n\t\t\t\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t\t\t\t<div class="col-3">Alamat</div>\n\t\t\t\t\t\t\t\t\t<div class="col-6">: <t t-if="'alamat-pj' in data"><t t-esc="data['alamat-pj']"/></t></div>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t\t\t\t<div class="col-3">No. Telepon</div>\n\t\t\t\t\t\t\t\t\t<div class="col-6">: <t t-if="'telepon-pj' in data"><t t-esc="data['telepon-pj']"/></t></div>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t\t\t\t<div class="col-3">Email</div>\n\t\t\t\t\t\t\t\t\t<div class="col-6">: <t t-if="'email-pj' in data"><t t-esc="data['email-pj']"/></t></div>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<t t-if="'relasi-pj' in data">\n\t\t\t\t\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t\t\t\t\t<div class="col-3">Bertindak atas</div>\n\t\t\t\t\t\t\t\t\t\t<div class="col-6">: <t t-if="'relasi-pj' in data"><t t-esc="data['relasi-pj']"/></t></div>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t</t>\n\t\t\t\t\t\t\t\t<div>Menyatakan</div>\n\t\t\t\t\t\t\t\t<div class="pr-3" style="page-break-inside: avoid; page-break-before: auto;">\n\t\t\t\t\t\t\t\t\t<div>\n\t\t\t\t\t\t\t\t\t\t<strong>I. PERSETUJUAN UNTUK PERAWATAN DAN PENGOBATAN</strong>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t<div class="d-flex ml-3">\n\t\t\t\t\t\t\t\t\t\t<div class="pr-1">1.</div>\n\t\t\t\t\t\t\t\t\t\t<div>Saya mengetahui bahwa saya membutuhkan perawatan medis dan mengijinkan dokter/tenaga Kesehatan lainnya di fasilitas Kesehatan RS/Klinik/<t t-esc="res_company.name"/> untuk melakukan pemeriksaan dan memberikan pengobatan / tindakan/ asuhan yang sesuai prosedur</div>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t<div class="d-flex ml-3">\n\t\t\t\t\t\t\t\t\t\t<div class="pr-1">2.</div>\n\t\t\t\t\t\t\t\t\t\t<div>Saya sadar bahwa praktik kedokteran bukanlah ilmu pasti dan saya mengakui bahwa tidak ada jaminan atas hasil apapun terhadap pengobatan / Tindakan/ asuhan yang dilakukan pada saya</div>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t<div class="d-flex ml-3">\n\t\t\t\t\t\t\t\t\t\t<div class="pr-1">3.</div>\n\t\t\t\t\t\t\t\t\t\t<div class="">\n\t\t\t\t\t\t\t\t\t\t\t<p>Saya mengerti dan memahami bahwa </p>\n\t\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t<div class="d-flex ml-5 pr-3">\n\t\t\t\t\t\t\t\t\t\t<div class="pr-1">a.</div>\n\t\t\t\t\t\t\t\t\t\t<div>Saya memiliki hak untuk menyatakan persetujuan atau penolakan untuk setiap jasa perawatan medis yang akan diberikan pada saya. Saya memahani bahwa pemberian jasa yang melibatkan data pribadi saya yang saya tolak, tanpanya layanan tidak dapat diberikan, seperti pemeriksaan penyakit pasien, pemberian obat, asuhan, dan tindakan medis.</div>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t<div class="d-flex ml-5 pr-3">\n\t\t\t\t\t\t\t\t\t\t<div class="pr-1">b.</div>\n\t\t\t\t\t\t\t\t\t\t<div>Saya memiliki hak untuk mengajukan pertanyaan terkait rencana pelayanan yang akan diberikan pada saya, termasuk identitas setiap orang yang akan memberikan jasa perawatan medis.</div>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t<div class="d-flex ml-5 pr-3">\n\t\t\t\t\t\t\t\t\t\t<div class="pr-1">c.</div>\n\t\t\t\t\t\t\t\t\t\t<div>Saya memiliki hak untuk melakukan pernarikan persetujuan saat kewajiban pihak fasilitas kesehatan menyediakan layanan belum terlaksana atau saya mengubah keputusan persetujan atau penolakan yang sebelumnya saya berikan</div>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t<div class="d-flex ml-3">\n\t\t\t\t\t\t\t\t\t\t<div class="pr-1">4.</div>\n\t\t\t\t\t\t\t\t\t\t<div class="">\n\t\t\t\t\t\t\t\t\t\t\t<p>Saya menyetujui bahwa dalam keadaan darurat (atau gawat darurat) data pribadi Saya hanya akan digunakan untuk kepentingan perawatan medis. Pemrosesan data ini hanya akan dilakukan apabila cara lain tidak dapat diupayakan seperti saya yang tidak sadarkan diri atau saya yang memerlukan tindakan segera di IGD.</p>\n\t\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<div class="pr-3" style="page-break-inside: avoid; page-break-before: auto;">\n\t\t\t\t\t\t\t\t\t<div>\n\t\t\t\t\t\t\t\t\t\t<strong>II. PERSETUJUAN PELEPASAN DATA</strong>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t<div class="d-flex ml-3">\n\t\t\t\t\t\t\t\t\t\t<div class="pr-1">1.</div>\n\t\t\t\t\t\t\t\t\t\t<div>Saya memahami bahwa informasi pribadi saya terkait dengan kondisi Kesehatan saya, berdasarkan pemeriksaan yang saya jalani di fasilitas Kesehatan RS/Klinik/<t t-esc="res_company.name"/> akan terjamin kerahasiaannya</div>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t<div class="d-flex ml-3">\n\t\t\t\t\t\t\t\t\t\t<div class="pr-1">2.</div>\n\t\t\t\t\t\t\t\t\t\t<div>Saya memberikan wewenang kepada fasilitas Kesehatan RS/Klinik/<t t-esc="res_company.name"/> untuk memberikan informasi berkaitan dengan kondisi Kesehatan saya untuk keperluan proses klaim asuransi dan administrasi resmi apabila diperlukan (BPJS, Kemenkenkes, Dinkes)</div>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t<div class="d-flex ml-3">\n\t\t\t\t\t\t\t\t\t\t<div class="pr-1">3.</div>\n\t\t\t\t\t\t\t\t\t\t<div>Saya memberi wewenang akses kepada fasilitas Kesehatan RS/Klinik/<t t-esc="res_company.name"/> untuk memberikan informasi Kesehatan saya kepada pihak berikut apabila diperlukan:</div>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t<div class="d-flex- ml-5">\n\t\t\t\t\t\t\t\t\t\t<t t-if="'authorized-parties' in data">\n\t\t\t\t\t\t\t\t\t\t\t<t t-foreach="data['authorized-parties']" t-as="name">\n\t\t\t\t\t\t\t\t\t\t\t\t<div><t t-esc="name"/></div>\n\t\t\t\t\t\t\t\t\t\t\t</t>\n\t\t\t\t\t\t\t\t\t\t</t>\n\t\t\t\t\t\t\t\t\t\t<t t-else="">\n\t\t\t\t\t\t\t\t\t\t\t<div style="height: 15px;"/>\n\t\t\t\t\t\t\t\t\t\t</t>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<div class="pr-3" style="page-break-inside: avoid; page-break-before: auto;">\n\t\t\t\t\t\t\t\t\t<div>\n\t\t\t\t\t\t\t\t\t\t<strong>III. HAK DAN KEWAJIBAN PASIEN</strong>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t<div class="ml-3">Saya telah mendapatkan informasi tentang “Hak dan Kewajiban Pasien” di fasilitas Kesehatan RS/Klinik/<t t-esc="res_company.name"/> melalui informasi yang diberikan kepada saya oleh petugas yang melayani saya.</div>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<div class="pr-3" style="page-break-inside: avoid; page-break-before: auto;">\n\t\t\t\t\t\t\t\t\t<div>\n\t\t\t\t\t\t\t\t\t\t<strong>IV. INTEGRITAS DATA MEDIS</strong>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t<div class="ml-3">Saya menyetujui bahwa segala data Rekam Medis, termasuk didalamnya Kesalahan Pemasukan Data atau Pengubahan diagnosis medis, tetap akan didokumentasikan karena menjadi bagian dari rekam medis pasien bahkan setelah diagnosis saya diperbaiki. Saya memahami bahwa hal ini bertujuan menjelaskan riwayat tindakan medis yang diberikan kepada pasien, atau untuk masalah kesehatan lainnya.</div>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<div class="pr-3" style="page-break-inside: avoid; page-break-before: auto;">\n\t\t\t\t\t\t\t\t\t<div>\n\t\t\t\t\t\t\t\t\t\t<strong>V. KOMUNIKASI</strong>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t<div class="ml-3">Saya bersedia untuk dihubungi melalui alamat atau alamat email sehubungan dengan reporting hack dan kegagalan/gangguan sistem yang berdampak serius mengenai dampak serius kebocoran data pribadi agar Saya dapat mengantisipasi risiko dari peristiwa tersebut. Selain itu Saya mengijinkan pelaporan ini untuk diberikan kepada otoritas yang berwenang dan segera tanpa menunda-nunda sesuai dengan peraturan perundang-undangan yang berlaku.</div>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class="row" style="page-break-inside: avoid; page-break-before: auto;">\n\t\t\t\t\t\t<div class="col-4">\n\t\t\t\t\t\t\t<p class="pt-3">Petugas</p>\n\t\t\t\t\t\t\t<t t-if="'practitioner-sign' in data">\n\t\t\t\t\t\t\t\t<div style="width:110px;height:60px;">\n\t\t\t\t\t\t\t\t\t<img height="80" t-att-src="data['practitioner-sign']"/>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t</t>\n\t\t\t\t\t\t\t<t t-else="">\n\t\t\t\t\t\t\t\t<div style="width:110px;height:60px;"/>\n\t\t\t\t\t\t\t</t>\n\t\t\t\t\t\t\t<p class="mb-0 mt-1">\n\t\t\t\t\t\t\t\t<t t-if="'practitioner-name' in data">\n\t\t\t\t\t\t\t\t\t<strong>\n\t\t\t\t\t\t\t\t\t\t<t t-esc="data['practitioner-name']"/>\n\t\t\t\t\t\t\t\t\t</strong>\n\t\t\t\t\t\t\t\t</t>\n\t\t\t\t\t\t\t\t<t t-elif="'examiner_name' in data">\n\t\t\t\t\t\t\t\t\t<strong>\n\t\t\t\t\t\t\t\t\t\t<t t-esc="data['examiner_name']"/>\n\t\t\t\t\t\t\t\t\t</strong>\n\t\t\t\t\t\t\t\t</t>\n\t\t\t\t\t\t\t\t<t t-else="">\n\t\t\t\t\t\t\t\t\t<strong>\n\t\t\t\t\t\t\t\t\t\t<t t-esc="data['sender']"/>\n\t\t\t\t\t\t\t\t\t</strong>\n\t\t\t\t\t\t\t\t</t>\n\t\t\t\t\t\t\t</p>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t<div class="col-4"/>\n\t\t\t\t\t\t<div class="col-4">\n\t\t\t\t\t\t\t<p class="mb-0"><t t-esc="o['operating_unit_id']['company_id']['city']"/>,\n\t\t\t\t\t\t\t\t<t t-esc="o.to_date_string(data['registration_date'])"/>\n\t\t\t\t\t\t\t</p>\n\t\t\t\t\t\t\t<p class="mb-0">Pasien / Wali Pasien</p>\n\t\t\t\t\t\t\t<t t-if="'sign-pj' in data">\n\t\t\t\t\t\t\t\t<div style="width:110px;height:60px;">\n\t\t\t\t\t\t\t\t\t<img height="80" t-att-src="data['sign-pj']"/>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t</t>\n\t\t\t\t\t\t\t<p class="mb-0 mt-1">\n\t\t\t\t\t\t\t\t<strong>\n\t\t\t\t\t\t\t\t\t<t t-esc="data['nama-pj']"/>\n\t\t\t\t\t\t\t\t</strong>\n\t\t\t\t\t\t\t</p>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t</t>\n\t\t</t>\n\t	ehealth_document/report/template_general_consent/report_assyifa_general_consent.xml	\N	\N	\N	\N	primary	t	1	2025-08-28 11:34:01.364376	1	2025-08-28 11:34:01.364376	f
1599	report_devara_general_consent	\N	ehealth_document.report_devara_general_consent	16	qweb	<?xml version="1.0"?>\n<t t-name="ehealth_document.report_devara_general_consent">\n\t\t\t<t t-set="company" t-value="res_company"/>\n\t\t\t<t t-call="ehealth_document.header_devara_document">\n\t\t\t\t<div class="page" style="font-size:13px; line-height: 1.4;">\n\t\t\t\t\t<div class="row" style="border: 1px solid black">\n\t\t\t\t\t\t<div class="">\n\t\t\t\t\t\t\t<div style="background-color:#c1d09d; border-bottom: 1px solid black">\n\t\t\t\t\t\t\t\t<p class="text-center mb-0" style="width: 100%;">\n\t\t\t\t\t\t\t\t\t<strong>PENGKAJIAN DATA UMUM PASIEN</strong>\n\t\t\t\t\t\t\t\t</p>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t<div class="row mt-2" style="border-bottom: 1px solid black">\n\t\t\t\t\t\t\t\t<div class="ml-3 mb-1">\n\t\t\t\t\t\t\t\t\t<p>Diisi oleh Petugas Pendaftaran pada</p>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<div class="ml-2 mb-1">\n\t\t\t\t\t\t\t\t\t<p>tanggal: <t t-if="'tgl-consent' in data"><t t-esc="data['tgl-consent']"/></t></p>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<div class="ml-5 mb-1">\n\t\t\t\t\t\t\t\t\t<p>jam: <t t-if="'waktu-consent' in data"><t t-esc="data['waktu-consent']"/></t></p>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t<div class="pl-2" style="border-bottom: 1px solid black">\n\t\t\t\t\t\t\t\t<p class="mb-0" style="font-size: 16px">\n\t\t\t\t\t\t\t\t\t<strong>IDENTITAS PASIEN</strong>\n\t\t\t\t\t\t\t\t</p>\n\t\t\t\t\t\t\t\t<p class="mb-0" style="font-style: italic;">(Diisi sesuai Kartu Tanda Pengenal Pasien yang masih berlaku; KTP/ KK/ SIM/ Kartu Pelajar/ dsb)</p>\n\t\t\t\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t\t\t\t<div class="col-3">Nomer Rekam Medis</div>\n\t\t\t\t\t\t\t\t\t<div class="col-8">: <t t-esc="data['no-cm']"/> </div>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t\t\t\t<div class="col-3">Nama</div>\n\t\t\t\t\t\t\t\t\t<div class="col-8">: <t t-esc="o['partner_id']['name']"/></div>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t\t\t\t<div class="col-3">Jenis Kelamin</div>\n\t\t\t\t\t\t\t\t\t<div class="col-8">:\n\t\t\t\t\t\t\t\t\t\t<t t-if="o['partner_id']['gender'] == 'male'">Laki-Laki</t>\n\t\t\t\t\t\t\t\t\t\t<t t-else="">Perempuan</t>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t\t\t\t<div class="col-3">Tanggal Lahir</div>\n\t\t\t\t\t\t\t\t\t<div class="col-8">: <t t-esc="o['partner_id']['birthDate'].strftime('%d-%m-%Y')"/></div>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t\t\t\t<div class="col-3">Agama</div>\n\t\t\t\t\t\t\t\t\t<div class="col-8">: <t t-if="'religion' in data"> <t t-esc="data['religion']"/> </t></div>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t\t\t\t<div class="col-3">Pendidikan</div>\n\t\t\t\t\t\t\t\t\t<div class="col-8">: </div>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t\t\t\t<div class="col-3">Pekerjaan</div>\n\t\t\t\t\t\t\t\t\t<div class="col-8">: <t t-if="'occupation' in data"> <t t-esc="data['occupation']"/> </t></div>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t\t\t\t<div class="col-3">Alamat</div>\n\t\t\t\t\t\t\t\t\t<div class="col-8">: <t t-esc="o['partner_id']['street']"/></div>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t\t\t\t<div class="col-3">Status Perkawinan</div>\n\t\t\t\t\t\t\t\t\t<div class="col-8">: <t t-if="'marital-status' in data"> <t t-esc="data['marital-status']"/> </t></div>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t\t\t\t<div class="col-3">Nama Suami / Istri</div>\n\t\t\t\t\t\t\t\t\t<div class="col-8">: <t t-if="'partner' in data"> <t t-esc="data['partner']"/> </t></div>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t\t\t\t<div class="col-3">Status Pembiayaan</div>\n\t\t\t\t\t\t\t\t\t<div class="col-8">: <t t-if="'payment' in data"> <t t-esc="data['payment']"/> </t></div>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t<div style="background-color:#c1d09d; border-bottom: 1px solid black">\n\t\t\t\t\t\t\t\t<p class="text-center mb-0" style="width: 100%;">\n\t\t\t\t\t\t\t\t\t<strong>PERSETUJUAN UMUM / GENERAL CONSENT</strong>\n\t\t\t\t\t\t\t\t</p>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t<p class="text-center mt-1 mb-0" style="font-style: italic; text-decoration: underline;">\n\t\t\t\t\t\t\t\t<strong>PASIEN / WALI PASIEN HARUS MEMBACA, MEMAHAMI DAN MENGISI INFORMASI BERIKUT</strong>\n\t\t\t\t\t\t\t</p>\n\t\t\t\t\t\t\t<p class="mt-1 mb-1">Yang bertanda tangan di bawah ini, saya:</p>\n\t\t\t\t\t\t\t<div class="pl-2">\n\t\t\t\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t\t\t\t<div class="col-3">Nama Lengkap</div>\n\t\t\t\t\t\t\t\t\t<div class="col-6">:\n\t\t\t\t\t\t\t\t\t\t<strong>\n\t\t\t\t\t\t\t\t\t\t\t<t t-esc="data['nama-pj']"/>\n\t\t\t\t\t\t\t\t\t\t</strong>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<t t-if="'tgl-lahir-pj' in data">\n\t\t\t\t\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t\t\t\t\t<div class="col-3">Tempat / Tanggal Lahir</div>\n\t\t\t\t\t\t\t\t\t\t<div class="col-6">: <t t-if="'tempat-lahir-pj' in data"><t t-esc="data['tempat-lahir-pj']"/></t>/<t t-if="'tgl-lahir-pj' in data"><t t-esc="data['tgl-lahir-pj']"/></t></div>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t</t>\n\t\t\t\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t\t\t\t<div class="col-3">Alamat</div>\n\t\t\t\t\t\t\t\t\t<div class="col-6">: <t t-if="'alamat-pj' in data"><t t-esc="data['alamat-pj']"/></t></div>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t\t\t\t<div class="col-3">No. Telepon</div>\n\t\t\t\t\t\t\t\t\t<div class="col-6">: <t t-if="'telepon-pj' in data"><t t-esc="data['telepon-pj']"/></t></div>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t\t\t\t<div class="col-3">Email</div>\n\t\t\t\t\t\t\t\t\t<div class="col-6">: <t t-if="'email-pj' in data"><t t-esc="data['email-pj']"/></t></div>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<t t-if="'relasi-pj' in data">\n\t\t\t\t\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t\t\t\t\t<div class="col-3">Bertindak atas</div>\n\t\t\t\t\t\t\t\t\t\t<div class="col-6">: <t t-if="'relasi-pj' in data"><t t-esc="data['relasi-pj']"/></t></div>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t</t>\n\t\t\t\t\t\t\t\t<div>Menyatakan</div>\n\t\t\t\t\t\t\t\t<div class="pr-3" style="page-break-inside: avoid; page-break-before: auto;">\n\t\t\t\t\t\t\t\t\t<div>\n\t\t\t\t\t\t\t\t\t\t<strong>I. PERSETUJUAN UNTUK PERAWATAN DAN PENGOBATAN</strong>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t<div class="d-flex ml-3">\n\t\t\t\t\t\t\t\t\t\t<div class="pr-1">1.</div>\n\t\t\t\t\t\t\t\t\t\t<div>Saya mengetahui bahwa saya membutuhkan perawatan medis dan mengijinkan dokter/tenaga Kesehatan lainnya di fasilitas Kesehatan RS/Klinik/<t t-esc="res_company.name"/> untuk melakukan pemeriksaan dan memberikan pengobatan / tindakan/ asuhan yang sesuai prosedur</div>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t<div class="d-flex ml-3">\n\t\t\t\t\t\t\t\t\t\t<div class="pr-1">2.</div>\n\t\t\t\t\t\t\t\t\t\t<div>Saya sadar bahwa praktik kedokteran bukanlah ilmu pasti dan saya mengakui bahwa tidak ada jaminan atas hasil apapun terhadap pengobatan / Tindakan/ asuhan yang dilakukan pada saya</div>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t<div class="d-flex ml-3">\n\t\t\t\t\t\t\t\t\t\t<div class="pr-1">3.</div>\n\t\t\t\t\t\t\t\t\t\t<div class="">\n\t\t\t\t\t\t\t\t\t\t\t<p>Saya mengerti dan memahami bahwa </p>\n\t\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t<div class="d-flex ml-5 pr-3">\n\t\t\t\t\t\t\t\t\t\t<div class="pr-1">a.</div>\n\t\t\t\t\t\t\t\t\t\t<div>Saya memiliki hak untuk menyatakan persetujuan atau penolakan untuk setiap jasa perawatan medis yang akan diberikan pada saya. Saya memahani bahwa pemberian jasa yang melibatkan data pribadi saya yang saya tolak, tanpanya layanan tidak dapat diberikan, seperti pemeriksaan penyakit pasien, pemberian obat, asuhan, dan tindakan medis.</div>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t<div class="d-flex ml-5 pr-3">\n\t\t\t\t\t\t\t\t\t\t<div class="pr-1">b.</div>\n\t\t\t\t\t\t\t\t\t\t<div>Saya memiliki hak untuk mengajukan pertanyaan terkait rencana pelayanan yang akan diberikan pada saya, termasuk identitas setiap orang yang akan memberikan jasa perawatan medis.</div>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t<div class="d-flex ml-5 pr-3">\n\t\t\t\t\t\t\t\t\t\t<div class="pr-1">c.</div>\n\t\t\t\t\t\t\t\t\t\t<div>Saya memiliki hak untuk melakukan pernarikan persetujuan saat kewajiban pihak fasilitas kesehatan menyediakan layanan belum terlaksana atau saya mengubah keputusan persetujan atau penolakan yang sebelumnya saya berikan</div>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t<div class="d-flex ml-3">\n\t\t\t\t\t\t\t\t\t\t<div class="pr-1">4.</div>\n\t\t\t\t\t\t\t\t\t\t<div class="">\n\t\t\t\t\t\t\t\t\t\t\t<p>Saya menyetujui bahwa dalam keadaan darurat (atau gawat darurat) data pribadi Saya hanya akan digunakan untuk kepentingan perawatan medis. Pemrosesan data ini hanya akan dilakukan apabila cara lain tidak dapat diupayakan seperti saya yang tidak sadarkan diri atau saya yang memerlukan tindakan segera di IGD.</p>\n\t\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<div class="pr-3" style="page-break-inside: avoid; page-break-before: auto;">\n\t\t\t\t\t\t\t\t\t<div>\n\t\t\t\t\t\t\t\t\t\t<strong>II. PERSETUJUAN PELEPASAN DATA</strong>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t<div class="d-flex ml-3">\n\t\t\t\t\t\t\t\t\t\t<div class="pr-1">1.</div>\n\t\t\t\t\t\t\t\t\t\t<div>Saya memahami bahwa informasi pribadi saya terkait dengan kondisi Kesehatan saya, berdasarkan pemeriksaan yang saya jalani di fasilitas Kesehatan RS/Klinik/<t t-esc="res_company.name"/> akan terjamin kerahasiaannya</div>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t<div class="d-flex ml-3">\n\t\t\t\t\t\t\t\t\t\t<div class="pr-1">2.</div>\n\t\t\t\t\t\t\t\t\t\t<div>Saya memberikan wewenang kepada fasilitas Kesehatan RS/Klinik/<t t-esc="res_company.name"/> untuk memberikan informasi berkaitan dengan kondisi Kesehatan saya untuk keperluan proses klaim asuransi dan administrasi resmi apabila diperlukan (BPJS, Kemenkenkes, Dinkes)</div>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t<div class="d-flex ml-3">\n\t\t\t\t\t\t\t\t\t\t<div class="pr-1">3.</div>\n\t\t\t\t\t\t\t\t\t\t<div>Saya memberi wewenang akses kepada fasilitas Kesehatan RS/Klinik/<t t-esc="res_company.name"/> untuk memberikan informasi Kesehatan saya kepada pihak berikut apabila diperlukan:</div>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t<div class="d-flex- ml-5">\n\t\t\t\t\t\t\t\t\t\t<t t-if="'authorized-parties' in data">\n\t\t\t\t\t\t\t\t\t\t\t<t t-foreach="data['authorized-parties']" t-as="name">\n\t\t\t\t\t\t\t\t\t\t\t\t<div><t t-esc="name"/></div>\n\t\t\t\t\t\t\t\t\t\t\t</t>\n\t\t\t\t\t\t\t\t\t\t</t>\n\t\t\t\t\t\t\t\t\t\t<t t-else="">\n\t\t\t\t\t\t\t\t\t\t\t<div style="height: 15px;"/>\n\t\t\t\t\t\t\t\t\t\t</t>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<div class="pr-3" style="page-break-inside: avoid; page-break-before: auto;">\n\t\t\t\t\t\t\t\t\t<div>\n\t\t\t\t\t\t\t\t\t\t<strong>III. HAK DAN KEWAJIBAN PASIEN</strong>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t<div class="ml-3">Saya telah mendapatkan informasi tentang “Hak dan Kewajiban Pasien” di fasilitas Kesehatan RS/Klinik/<t t-esc="res_company.name"/> melalui informasi yang diberikan kepada saya oleh petugas yang melayani saya.</div>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<div class="pr-3" style="page-break-inside: avoid; page-break-before: auto;">\n\t\t\t\t\t\t\t\t\t<div>\n\t\t\t\t\t\t\t\t\t\t<strong>IV. INTEGRITAS DATA MEDIS</strong>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t<div class="ml-3">Saya menyetujui bahwa segala data Rekam Medis, termasuk didalamnya Kesalahan Pemasukan Data atau Pengubahan diagnosis medis, tetap akan didokumentasikan karena menjadi bagian dari rekam medis pasien bahkan setelah diagnosis saya diperbaiki. Saya memahami bahwa hal ini bertujuan menjelaskan riwayat tindakan medis yang diberikan kepada pasien, atau untuk masalah kesehatan lainnya.</div>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<div class="pr-3" style="page-break-inside: avoid; page-break-before: auto;">\n\t\t\t\t\t\t\t\t\t<div>\n\t\t\t\t\t\t\t\t\t\t<strong>V. KOMUNIKASI</strong>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t<div class="ml-3">Saya bersedia untuk dihubungi melalui alamat atau alamat email sehubungan dengan reporting hack dan kegagalan/gangguan sistem yang berdampak serius mengenai dampak serius kebocoran data pribadi agar Saya dapat mengantisipasi risiko dari peristiwa tersebut. Selain itu Saya mengijinkan pelaporan ini untuk diberikan kepada otoritas yang berwenang dan segera tanpa menunda-nunda sesuai dengan peraturan perundang-undangan yang berlaku.</div>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class="row" style="page-break-inside: avoid; page-break-before: auto;">\n\t\t\t\t\t\t<div class="col-4">\n\t\t\t\t\t\t\t<p class="pt-3">Petugas</p>\n\t\t\t\t\t\t\t<t t-if="'practitioner-sign' in data">\n\t\t\t\t\t\t\t\t<div style="width:110px;height:60px;">\n\t\t\t\t\t\t\t\t\t<img height="80" t-att-src="data['practitioner-sign']"/>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t</t>\n\t\t\t\t\t\t\t<t t-else="">\n\t\t\t\t\t\t\t\t<div style="width:110px;height:60px;"/>\n\t\t\t\t\t\t\t</t>\n\t\t\t\t\t\t\t<p class="mb-0 mt-1">\n\t\t\t\t\t\t\t\t<t t-if="'practitioner-name' in data">\n\t\t\t\t\t\t\t\t\t<strong>\n\t\t\t\t\t\t\t\t\t\t<t t-esc="data['practitioner-name']"/>\n\t\t\t\t\t\t\t\t\t</strong>\n\t\t\t\t\t\t\t\t</t>\n\t\t\t\t\t\t\t\t<t t-elif="'examiner_name' in data">\n\t\t\t\t\t\t\t\t\t<strong>\n\t\t\t\t\t\t\t\t\t\t<t t-esc="data['examiner_name']"/>\n\t\t\t\t\t\t\t\t\t</strong>\n\t\t\t\t\t\t\t\t</t>\n\t\t\t\t\t\t\t\t<t t-else="">\n\t\t\t\t\t\t\t\t\t<strong>\n\t\t\t\t\t\t\t\t\t\t<t t-esc="data['sender']"/>\n\t\t\t\t\t\t\t\t\t</strong>\n\t\t\t\t\t\t\t\t</t>\n\t\t\t\t\t\t\t</p>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t<div class="col-4"/>\n\t\t\t\t\t\t<div class="col-4">\n\t\t\t\t\t\t\t<p class="mb-0"><t t-esc="o['operating_unit_id']['company_id']['city']"/>,\n\t\t\t\t\t\t\t\t<t t-esc="o.to_date_string(data['registration_date'])"/>\n\t\t\t\t\t\t\t</p>\n\t\t\t\t\t\t\t<p class="mb-0">Pasien / Wali Pasien</p>\n\t\t\t\t\t\t\t<t t-if="'sign-pj' in data">\n\t\t\t\t\t\t\t\t<div style="width:110px;height:60px;">\n\t\t\t\t\t\t\t\t\t<img height="80" t-att-src="data['sign-pj']"/>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t</t>\n\t\t\t\t\t\t\t<p class="mb-0 mt-1">\n\t\t\t\t\t\t\t\t<strong>\n\t\t\t\t\t\t\t\t\t<t t-esc="data['nama-pj']"/>\n\t\t\t\t\t\t\t\t</strong>\n\t\t\t\t\t\t\t</p>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t</t>\n\t\t</t>\n\t	ehealth_document/report/template_general_consent/report_devara_general_consent.xml	\N	\N	\N	\N	primary	t	1	2025-08-28 11:34:01.364376	1	2025-08-28 11:34:01.364376	f
1594	report_westerindo_general_consent	\N	ehealth_document.report_westerindo_general_consent	16	qweb	<?xml version="1.0"?>\n<t t-name="ehealth_document.report_westerindo_general_consent">\n\t\t\t<t t-set="company" t-value="res_company"/>\n\t\t\t<t t-call="ehealth_document.header_westerindo_multi_ou_document">\n\t\t\t\t<div class="page" style="font-size:13px; line-height: 1.4;">\n\t\t\t\t\t<div class="row" style="">\n\t\t\t\t\t\t<div class="">\n\t\t\t\t\t\t\t<div style="background-color:#c1d09d; border-bottom: 1px solid black">\n\t\t\t\t\t\t\t\t<p class="text-center mb-0" style="width: 100%;">\n\t\t\t\t\t\t\t\t\t<strong>PENGKAJIAN DATA UMUM PASIEN</strong>\n\t\t\t\t\t\t\t\t</p>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t<div class="d-flex mt-2">\n\t\t\t\t\t\t\t\t<div class="ml-2 mb-1">\n\t\t\t\t\t\t\t\t\t<p>Diisi oleh Petugas Pendaftaran pada</p>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<div class="ml-2 mb-1">\n\t\t\t\t\t\t\t\t\t<p>tanggal: <t t-if="'tgl-consent' in data">\n\t\t\t\t\t\t\t\t\t\t\t<t t-esc="data['tgl-consent']"/>\n\t\t\t\t\t\t\t\t\t\t</t></p>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<div class="ml-5 mb-1">\n\t\t\t\t\t\t\t\t\t<p>jam: <t t-if="'waktu-consent' in data">\n\t\t\t\t\t\t\t\t\t\t\t<t t-esc="data['waktu-consent']"/>\n\t\t\t\t\t\t\t\t\t\t</t></p>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t<div class="pl-2 p-2">\n\t\t\t\t\t\t\t\t<p class="mb-0" style="font-size: 16px">\n\t\t\t\t\t\t\t\t\t<strong>IDENTITAS PASIEN</strong>\n\t\t\t\t\t\t\t\t</p>\n\t\t\t\t\t\t\t\t<p class="mb-0" style="font-style: italic;">(Diisi sesuai Kartu\n\t\t\t\t\t\t\t\t\tTanda Pengenal Pasien yang masih berlaku; KTP/ KK/ SIM/ Kartu\n\t\t\t\t\t\t\t\t\tPelajar/ dsb)</p>\n\t\t\t\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t\t\t\t<div class="col-3">Nomer Rekam Medis</div>\n\t\t\t\t\t\t\t\t\t<div class="col-8">: <t t-if="'no-cm' in data">\n\t\t\t\t\t\t\t\t\t\t\t<t t-esc="data['no-cm']"/>\n\t\t\t\t\t\t\t\t\t\t</t>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t\t\t\t<div class="col-3">Nama</div>\n\t\t\t\t\t\t\t\t\t<div class="col-8">: <t t-esc="o['partner_id']['name']"/></div>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t\t\t\t<div class="col-3">Jenis Kelamin</div>\n\t\t\t\t\t\t\t\t\t<div class="col-8">: <t t-if="o['partner_id']['gender'] == 'male'">Laki-Laki</t>\n\t\t\t\t\t\t\t\t\t\t<t t-else="">Perempuan</t>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t\t\t\t<div class="col-3">Tanggal Lahir</div>\n\t\t\t\t\t\t\t\t\t<div class="col-8">: <t t-esc="o['partner_id']['birthDate'].strftime('%d-%m-%Y')"/></div>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t\t\t\t<div class="col-3">Agama</div>\n\t\t\t\t\t\t\t\t\t<div class="col-8">: <t t-if="'religion' in data">\n\t\t\t\t\t\t\t\t\t\t\t<t t-esc="data['religion']"/>\n\t\t\t\t\t\t\t\t\t\t</t></div>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t\t\t\t<div class="col-3">Pendidikan</div>\n\t\t\t\t\t\t\t\t\t<div class="col-8">: </div>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t\t\t\t<div class="col-3">Pekerjaan</div>\n\t\t\t\t\t\t\t\t\t<div class="col-8">: <t t-if="'occupation' in data">\n\t\t\t\t\t\t\t\t\t\t\t<t t-esc="data['occupation']"/>\n\t\t\t\t\t\t\t\t\t\t</t></div>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t\t\t\t<div class="col-3">Alamat</div>\n\t\t\t\t\t\t\t\t\t<div class="col-8">: <t t-esc="o['partner_id']['street']"/></div>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t\t\t\t<div class="col-3">Status Perkawinan</div>\n\t\t\t\t\t\t\t\t\t<div class="col-8">: <t t-if="'marital-status' in data">\n\t\t\t\t\t\t\t\t\t\t\t<t t-esc="data['marital-status']"/>\n\t\t\t\t\t\t\t\t\t\t</t></div>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t\t\t\t<div class="col-3">Nama Suami / Istri</div>\n\t\t\t\t\t\t\t\t\t<div class="col-8">: <t t-if="'partner' in data">\n\t\t\t\t\t\t\t\t\t\t\t<t t-esc="data['partner']"/>\n\t\t\t\t\t\t\t\t\t\t</t></div>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t\t\t\t<div class="col-3">Status Pembiayaan</div>\n\t\t\t\t\t\t\t\t\t<div class="col-8">: <t t-if="'payment' in data">\n\t\t\t\t\t\t\t\t\t\t\t<t t-esc="data['payment']"/>\n\t\t\t\t\t\t\t\t\t\t</t></div>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t<div style="background-color:#c1d09d; border-bottom: 1px solid black">\n\t\t\t\t\t\t\t\t<p class="text-center mb-0" style="width: 100%;">\n\t\t\t\t\t\t\t\t\t<strong>PERSETUJUAN UMUM / GENERAL CONSENT</strong>\n\t\t\t\t\t\t\t\t</p>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t<p class="text-center mt-1 mb-0" style="font-style: italic; text-decoration: underline;">\n\t\t\t\t\t\t\t\t<strong>PASIEN / WALI PASIEN HARUS MEMBACA, MEMAHAMI DAN MENGISI\n\t\t\t\t\t\t\t\t\tINFORMASI BERIKUT</strong>\n\t\t\t\t\t\t\t</p>\n\t\t\t\t\t\t\t<p class="mt-1 ml-2 mb-1">Yang bertanda tangan di bawah ini, saya:</p>\n\t\t\t\t\t\t\t<div class="pl-2 mr-3 col">\n\t\t\t\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t\t\t\t<div class="col-3">Nama Lengkap</div>\n\t\t\t\t\t\t\t\t\t<div class="col-6">: <strong>\n\t\t\t\t\t\t\t\t\t\t\t<t t-esc="data['nama-pj']"/>\n\t\t\t\t\t\t\t\t\t\t</strong>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<t t-if="'tgl-lahir-pj' in data">\n\t\t\t\t\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t\t\t\t\t<div class="col-3">Tempat / Tanggal Lahir</div>\n\t\t\t\t\t\t\t\t\t\t<div class="col-6">: <t t-if="'tempat-lahir-pj' in data">\n\t\t\t\t\t\t\t\t\t\t\t\t<t t-esc="data['tempat-lahir-pj']"/>\n\t\t\t\t\t\t\t\t\t\t\t</t>\n\t\t\t\t\t\t\t\t\t\t\t/<t t-if="'tgl-lahir-pj' in data">\n\t\t\t\t\t\t\t\t\t\t\t\t<t t-esc="data['tgl-lahir-pj']"/>\n\t\t\t\t\t\t\t\t\t\t\t</t></div>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t</t>\n\t\t\t\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t\t\t\t<div class="col-3">Alamat</div>\n\t\t\t\t\t\t\t\t\t<div class="col-6">: <t t-if="'alamat-pj' in data">\n\t\t\t\t\t\t\t\t\t\t\t<t t-esc="data['alamat-pj']"/>\n\t\t\t\t\t\t\t\t\t\t</t></div>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t\t\t\t<div class="col-3">No. Telepon</div>\n\t\t\t\t\t\t\t\t\t<div class="col-6">: <t t-if="'telepon-pj' in data">\n\t\t\t\t\t\t\t\t\t\t\t<t t-esc="data['telepon-pj']"/>\n\t\t\t\t\t\t\t\t\t\t</t></div>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t\t\t\t<div class="col-3">Email</div>\n\t\t\t\t\t\t\t\t\t<div class="col-6">: <t t-if="'email-pj' in data">\n\t\t\t\t\t\t\t\t\t\t\t<t t-esc="data['email-pj']"/>\n\t\t\t\t\t\t\t\t\t\t</t></div>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<t t-if="'relasi-pj' in data">\n\t\t\t\t\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t\t\t\t\t<div class="col-3">Bertindak atas</div>\n\t\t\t\t\t\t\t\t\t\t<div class="col-6">: <t t-if="'relasi-pj' in data">\n\t\t\t\t\t\t\t\t\t\t\t\t<t t-esc="data['relasi-pj']"/>\n\t\t\t\t\t\t\t\t\t\t\t</t></div>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t</t>\n\t\t\t\t\t\t\t\t<div>Menyatakan</div>\n\n\t\t\t\t\t\t\t\t<t t-if="'statement_template' in data">\n\t\t\t\t\t\t\t\t\t<div class="pr-3">\n\t\t\t\t\t\t\t\t\t\t<t t-raw="data['statement_template']"/>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t</t>\n\t\t\t\t\t\t\t\t<t t-else="">\n\t\t\t\t\t\t\t\t\t<div class="pr-3" style="page-break-inside: avoid; page-break-before: auto;">\n\t\t\t\t\t\t\t\t\t\t<div>\n\t\t\t\t\t\t\t\t\t\t\t<strong>I. PERSETUJUAN UNTUK PERAWATAN DAN PENGOBATAN</strong>\n\t\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t\t<div class="d-flex ml-3">\n\t\t\t\t\t\t\t\t\t\t\t<div class="pr-1">1.</div>\n\t\t\t\t\t\t\t\t\t\t\t<div>Saya mengetahui bahwa saya membutuhkan perawatan\n\t\t\t\t\t\t\t\t\t\t\t\tmedis dan mengijinkan dokter/tenaga Kesehatan\n\t\t\t\t\t\t\t\t\t\t\t\tlainnya di fasilitas Kesehatan RS/Klinik/<t t-esc="res_company.name"/> untuk melakukan\n\t\t\t\t\t\t\t\t\t\t\t\tpemeriksaan dan memberikan pengobatan / tindakan/\n\t\t\t\t\t\t\t\t\t\t\t\tasuhan yang sesuai prosedur</div>\n\t\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t\t<div class="d-flex ml-3">\n\t\t\t\t\t\t\t\t\t\t\t<div class="pr-1">2.</div>\n\t\t\t\t\t\t\t\t\t\t\t<div>Saya sadar bahwa praktik kedokteran bukanlah ilmu\n\t\t\t\t\t\t\t\t\t\t\t\tpasti dan saya mengakui bahwa tidak ada jaminan atas\n\t\t\t\t\t\t\t\t\t\t\t\thasil apapun terhadap pengobatan / Tindakan/ asuhan\n\t\t\t\t\t\t\t\t\t\t\t\tyang dilakukan pada saya</div>\n\t\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t\t<div class="d-flex ml-3">\n\t\t\t\t\t\t\t\t\t\t\t<div class="pr-1">3.</div>\n\t\t\t\t\t\t\t\t\t\t\t<div class="">\n\t\t\t\t\t\t\t\t\t\t\t\t<p>Saya mengerti dan memahami bahwa </p>\n\t\t\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t\t<div class="d-flex ml-5 pr-3">\n\t\t\t\t\t\t\t\t\t\t\t<div class="pr-1">a.</div>\n\t\t\t\t\t\t\t\t\t\t\t<div>Saya memiliki hak untuk menyatakan persetujuan atau\n\t\t\t\t\t\t\t\t\t\t\t\tpenolakan untuk setiap jasa perawatan medis yang\n\t\t\t\t\t\t\t\t\t\t\t\takan diberikan pada saya. Saya memahani bahwa\n\t\t\t\t\t\t\t\t\t\t\t\tpemberian jasa yang melibatkan data pribadi saya\n\t\t\t\t\t\t\t\t\t\t\t\tyang saya tolak, tanpanya layanan tidak dapat\n\t\t\t\t\t\t\t\t\t\t\t\tdiberikan, seperti pemeriksaan penyakit pasien,\n\t\t\t\t\t\t\t\t\t\t\t\tpemberian obat, asuhan, dan tindakan medis.</div>\n\t\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t\t<div class="d-flex ml-5 pr-3">\n\t\t\t\t\t\t\t\t\t\t\t<div class="pr-1">b.</div>\n\t\t\t\t\t\t\t\t\t\t\t<div>Saya memiliki hak untuk mengajukan pertanyaan\n\t\t\t\t\t\t\t\t\t\t\t\tterkait rencana pelayanan yang akan diberikan pada\n\t\t\t\t\t\t\t\t\t\t\t\tsaya, termasuk identitas setiap orang yang akan\n\t\t\t\t\t\t\t\t\t\t\t\tmemberikan jasa perawatan medis.</div>\n\t\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t\t<div class="d-flex ml-5 pr-3">\n\t\t\t\t\t\t\t\t\t\t\t<div class="pr-1">c.</div>\n\t\t\t\t\t\t\t\t\t\t\t<div>Saya memiliki hak untuk melakukan pernarikan\n\t\t\t\t\t\t\t\t\t\t\t\tpersetujuan saat kewajiban pihak fasilitas kesehatan\n\t\t\t\t\t\t\t\t\t\t\t\tmenyediakan layanan belum terlaksana atau saya\n\t\t\t\t\t\t\t\t\t\t\t\tmengubah keputusan persetujan atau penolakan yang\n\t\t\t\t\t\t\t\t\t\t\t\tsebelumnya saya berikan</div>\n\t\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t\t<div class="d-flex ml-3">\n\t\t\t\t\t\t\t\t\t\t\t<div class="pr-1">4.</div>\n\t\t\t\t\t\t\t\t\t\t\t<div class="">\n\t\t\t\t\t\t\t\t\t\t\t\t<p>Saya menyetujui bahwa dalam keadaan darurat (atau\n\t\t\t\t\t\t\t\t\t\t\t\t\tgawat darurat) data pribadi Saya hanya akan\n\t\t\t\t\t\t\t\t\t\t\t\t\tdigunakan untuk kepentingan perawatan medis.\n\t\t\t\t\t\t\t\t\t\t\t\t\tPemrosesan data ini hanya akan dilakukan apabila\n\t\t\t\t\t\t\t\t\t\t\t\t\tcara lain tidak dapat diupayakan seperti saya\n\t\t\t\t\t\t\t\t\t\t\t\t\tyang tidak sadarkan diri atau saya yang\n\t\t\t\t\t\t\t\t\t\t\t\t\tmemerlukan tindakan segera di IGD.</p>\n\t\t\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t<div class="pr-3" style="page-break-inside: avoid; page-break-before: auto;">\n\t\t\t\t\t\t\t\t\t\t<div>\n\t\t\t\t\t\t\t\t\t\t\t<strong>II. PERSETUJUAN PELEPASAN DATA</strong>\n\t\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t\t<div class="d-flex ml-3">\n\t\t\t\t\t\t\t\t\t\t\t<div class="pr-1">1.</div>\n\t\t\t\t\t\t\t\t\t\t\t<div>Saya memahami bahwa informasi pribadi saya terkait\n\t\t\t\t\t\t\t\t\t\t\t\tdengan kondisi Kesehatan saya, berdasarkan\n\t\t\t\t\t\t\t\t\t\t\t\tpemeriksaan yang saya jalani di fasilitas Kesehatan\n\t\t\t\t\t\t\t\t\t\t\t\tRS/Klinik/<t t-esc="res_company.name"/> akan\n\t\t\t\t\t\t\t\t\t\t\t\tterjamin kerahasiaannya</div>\n\t\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t\t<div class="d-flex ml-3">\n\t\t\t\t\t\t\t\t\t\t\t<div class="pr-1">2.</div>\n\t\t\t\t\t\t\t\t\t\t\t<div>Saya memberikan wewenang kepada fasilitas Kesehatan\n\t\t\t\t\t\t\t\t\t\t\t\tRS/Klinik/<t t-esc="res_company.name"/> untuk\n\t\t\t\t\t\t\t\t\t\t\t\tmemberikan informasi berkaitan dengan kondisi\n\t\t\t\t\t\t\t\t\t\t\t\tKesehatan saya untuk keperluan proses klaim asuransi\n\t\t\t\t\t\t\t\t\t\t\t\tdan administrasi resmi apabila diperlukan (BPJS,\n\t\t\t\t\t\t\t\t\t\t\t\tKemenkenkes, Dinkes)</div>\n\t\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t\t<div class="d-flex ml-3">\n\t\t\t\t\t\t\t\t\t\t\t<div class="pr-1">3.</div>\n\t\t\t\t\t\t\t\t\t\t\t<div>Saya memberi wewenang akses kepada fasilitas\n\t\t\t\t\t\t\t\t\t\t\t\tKesehatan RS/Klinik/<t t-esc="res_company.name"/>\n\t\t\t\t\t\t\t\t\t\t\t\tuntuk memberikan informasi Kesehatan saya kepada\n\t\t\t\t\t\t\t\t\t\t\t\tpihak berikut apabila diperlukan:</div>\n\t\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t\t<div class="d-flex- ml-5">\n\t\t\t\t\t\t\t\t\t\t\t<t t-if="'authorized-parties' in data">\n\t\t\t\t\t\t\t\t\t\t\t\t<t t-foreach="data['authorized-parties']" t-as="name">\n\t\t\t\t\t\t\t\t\t\t\t\t\t<div>\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t<t t-esc="name"/>\n\t\t\t\t\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t\t\t\t</t>\n\t\t\t\t\t\t\t\t\t\t\t</t>\n\t\t\t\t\t\t\t\t\t\t\t<t t-else="">\n\t\t\t\t\t\t\t\t\t\t\t\t<div style="height: 15px;"/>\n\t\t\t\t\t\t\t\t\t\t\t</t>\n\t\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t<div class="pr-3" style="page-break-inside: avoid; page-break-before: auto;">\n\t\t\t\t\t\t\t\t\t\t<div>\n\t\t\t\t\t\t\t\t\t\t\t<strong>III. HAK DAN KEWAJIBAN PASIEN</strong>\n\t\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t\t<div class="ml-3">\n\t\t\t\t\t\t\t\t\t\t\t<div class="mb-2">Saya telah mendapatkan informasi dan sudah memahami tentang “Hak dan Kewajiban Pasien” di fasilitas Kesehatan RS/Klinik/<t t-esc="res_company.name"/> melalui informasi yang diberikan kepada saya oleh petugas yang melayani saya.</div>\n\t\t\t\t\t\t\t\t\t\t\t<div class="content">\n\t\t\t\t\t\t\t\t\t\t\t\t<div>Hak Pasien</div>\n\t\t\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t\t\t<ol class="sub-content">\n\t\t\t\t\t\t\t\t\t\t\t\t<li>Mendapatkan informasi mengenai Kesehatan dirinya;</li>\n\t\t\t\t\t\t\t\t\t\t\t\t<li>Mendapatkan penjelasan yang memadai mengenai pelayanan kesehatan yang diterimanya; </li>\n\t\t\t\t\t\t\t\t\t\t\t\t<li>Mendapatkan pelayanan kesehatan sesuai dengan kebutuhan medis, standar profesi, dan pelayanan yang bermutu;</li>\n\t\t\t\t\t\t\t\t\t\t\t\t<li>Menolak atau menyetujui tindakan medis, kecuali untuk tindakan medis yang diperlukan dalam rangka pencegahan penyakit menular dan penanggulangan KLB atau Wabah; </li>\n\t\t\t\t\t\t\t\t\t\t\t\t<li>Mendapatkan akses terhadap informasi yang terdapat di dalam rekam medis; </li>\n\t\t\t\t\t\t\t\t\t\t\t\t<li>Meminta pendapat Tenaga Medis atau Tenaga Kesehatan lain; dan </li>\n\t\t\t\t\t\t\t\t\t\t\t\t<li> Mendapatkan hak lain sesuai dengan ketentuan peraturan perundang-undangan.</li>\n\t\t\t\t\t\t\t\t\t\t\t</ol> \n\t\t\t\t\t\t\t\t\t\t\t<div class="content">\n\t\t\t\t\t\t\t\t\t\t\t\t<div>Kewajiban Pasien</div>\n\t\t\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t\t\t<ol class="sub-content">\n\t\t\t\t\t\t\t\t\t\t\t\t<li>Memberikan informasi yang lengkap dan jujur tentang masalah kesehatannya;</li>\n\t\t\t\t\t\t\t\t\t\t\t\t<li>Mematuhi nasihat dan petunjuk Tenaga Medis dan Tenaga Kesehatan;</li>\n\t\t\t\t\t\t\t\t\t\t\t\t<li>Mematuhi ketentuan yang berlaku pada fasilitas pelayanan kesehatan; dan</li>\n\t\t\t\t\t\t\t\t\t\t\t\t<li>Memberikan imbalan jasa atau pelayanan yang diterima.</li>\n\t\t\t\t\t\t\t\t\t\t\t</ol>\n\t\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t<div class="pr-3" style="page-break-inside: avoid; page-break-before: auto;">\n\t\t\t\t\t\t\t\t\t\t<div>\n\t\t\t\t\t\t\t\t\t\t\t<strong>IV. INTEGRITAS DATA MEDIS</strong>\n\t\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t\t<div class="pr-3" style="page-break-inside: avoid; page-break-before: auto;">\n\t\t\t\t\t\t\t\t\t\t\t<div>\n\t\t\t\t\t\t\t\t\t\t\t\t<strong>V. KOMUNIKASI</strong>\n\t\t\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t\t\t<div class="ml-3">Saya bersedia untuk dihubungi melalui\n\t\t\t\t\t\t\t\t\t\t\t\talamat atau alamat email sehubungan dengan reporting\n\t\t\t\t\t\t\t\t\t\t\t\thack dan kegagalan/gangguan sistem yang berdampak serius\n\t\t\t\t\t\t\t\t\t\t\t\tmengenai dampak serius kebocoran data pribadi agar Saya\n\t\t\t\t\t\t\t\t\t\t\t\tdapat mengantisipasi risiko dari peristiwa tersebut.\n\t\t\t\t\t\t\t\t\t\t\t\tSelain itu Saya mengijinkan pelaporan ini untuk\n\t\t\t\t\t\t\t\t\t\t\t\tdiberikan kepada otoritas yang berwenang dan segera\n\t\t\t\t\t\t\t\t\t\t\t\ttanpa menunda-nunda sesuai dengan peraturan\n\t\t\t\t\t\t\t\t\t\t\t\tperundang-undangan yang berlaku.</div>\n\t\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t</t>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class="d-flex ml-2" style="page-break-inside: avoid; page-break-before: auto;">\n\t\t\t\t\t\t<div class="col-4">\n\t\t\t\t\t\t\t<p class="pt-3 mb-0">Petugas</p>\n\t\t\t\t\t\t\t<t t-if="'practitioner-sign' in data">\n\t\t\t\t\t\t\t\t<div style="width:110px;height:80px;">\n\t\t\t\t\t\t\t\t\t<img height="80" t-att-src="data['practitioner-sign']"/>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t</t>\n\t\t\t\t\t\t\t<t t-else="">\n\t\t\t\t\t\t\t\t<div style="width:110px;height:80px;"/>\n\t\t\t\t\t\t\t</t>\n\t\t\t\t\t\t\t<p class="mb-0 mt-1">\n\t\t\t\t\t\t\t\t<t t-if="'practitioner-name' in data">\n\t\t\t\t\t\t\t\t\t<strong>\n\t\t\t\t\t\t\t\t\t\t<t t-esc="data['practitioner-name']"/>\n\t\t\t\t\t\t\t\t\t</strong>\n\t\t\t\t\t\t\t\t</t>\n\t\t\t\t\t\t\t\t<t t-elif="'examiner_name' in data">\n\t\t\t\t\t\t\t\t\t<strong>\n\t\t\t\t\t\t\t\t\t\t<t t-esc="data['examiner_name']"/>\n\t\t\t\t\t\t\t\t\t</strong>\n\t\t\t\t\t\t\t\t</t>\n\t\t\t\t\t\t\t\t<t t-else="">\n\t\t\t\t\t\t\t\t\t<strong>\n\t\t\t\t\t\t\t\t\t\t<t t-esc="data['sender']"/>\n\t\t\t\t\t\t\t\t\t</strong>\n\t\t\t\t\t\t\t\t</t>\n\t\t\t\t\t\t\t</p>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t<div class="col-4"/>\n\t\t\t\t\t\t<div class="col-4">\n\t\t\t\t\t\t\t<p class="mb-0"><t t-esc="o['operating_unit_id']['company_id']['city']"/>\n\t\t\t\t\t\t\t\t, <t t-esc="o.to_date_string(data['registration_date'])"/>\n\t\t\t\t\t\t\t</p>\n\t\t\t\t\t\t\t<p class="mb-0">Pasien / Wali Pasien</p>\n\t\t\t\t\t\t\t<t t-if="'sign-pj' in data">\n\t\t\t\t\t\t\t\t<div style="width:110px;height:80px;">\n\t\t\t\t\t\t\t\t\t<img height="80" t-att-src="data['sign-pj']"/>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t</t>\n\t\t\t\t\t\t\t<p class="mb-0 mt-1">\n\t\t\t\t\t\t\t\t<strong>\n\t\t\t\t\t\t\t\t\t<t t-esc="data['nama-pj']"/>\n\t\t\t\t\t\t\t\t</strong>\n\t\t\t\t\t\t\t</p>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t</t>\n\t\t\t<script type="text/javascript" src="/ehealth_document/static/src/js/general-consent-statement.js"/>\n\t\t</t>\n\t	ehealth_document/report/template_general_consent/report_westerindo_general_consent.xml	f	<?xml version="1.0"?>\n<t t-name="ehealth_document.report_westerindo_general_consent">\n\t\t\t<t t-set="company" t-value="res_company"/>\n\t\t\t<t t-call="ehealth_document.header_westerindo_multi_ou_document">\n\t\t\t\t<div class="page" style="font-size:13px; line-height: 1.4;">\n\t\t\t\t\t<div class="row" style="">\n\t\t\t\t\t\t<div class="">\n\t\t\t\t\t\t\t<div style="background-color:#c1d09d; border-bottom: 1px solid black">\n\t\t\t\t\t\t\t\t<p class="text-center mb-0" style="width: 100%;">\n\t\t\t\t\t\t\t\t\t<strong>PENGKAJIAN DATA UMUM PASIEN</strong>\n\t\t\t\t\t\t\t\t</p>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t<div class="d-flex mt-2">\n\t\t\t\t\t\t\t\t<div class="ml-2 mb-1">\n\t\t\t\t\t\t\t\t\t<p>Diisi oleh Petugas Pendaftaran pada</p>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<div class="ml-2 mb-1">\n\t\t\t\t\t\t\t\t\t<p>tanggal: <t t-if="'tgl-consent' in data">\n\t\t\t\t\t\t\t\t\t\t\t<t t-esc="data['tgl-consent']"/>\n\t\t\t\t\t\t\t\t\t\t</t></p>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<div class="ml-5 mb-1">\n\t\t\t\t\t\t\t\t\t<p>jam: <t t-if="'waktu-consent' in data">\n\t\t\t\t\t\t\t\t\t\t\t<t t-esc="data['waktu-consent']"/>\n\t\t\t\t\t\t\t\t\t\t</t></p>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t<div class="pl-2 p-2">\n\t\t\t\t\t\t\t\t<p class="mb-0" style="font-size: 16px">\n\t\t\t\t\t\t\t\t\t<strong>IDENTITAS PASIEN</strong>\n\t\t\t\t\t\t\t\t</p>\n\t\t\t\t\t\t\t\t<p class="mb-0" style="font-style: italic;">(Diisi sesuai Kartu\n\t\t\t\t\t\t\t\t\tTanda Pengenal Pasien yang masih berlaku; KTP/ KK/ SIM/ Kartu\n\t\t\t\t\t\t\t\t\tPelajar/ dsb)</p>\n\t\t\t\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t\t\t\t<div class="col-3">Nomer Rekam Medis</div>\n\t\t\t\t\t\t\t\t\t<div class="col-8">: <t t-if="'no-cm' in data">\n\t\t\t\t\t\t\t\t\t\t\t<t t-esc="data['no-cm']"/>\n\t\t\t\t\t\t\t\t\t\t</t>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t\t\t\t<div class="col-3">Nama</div>\n\t\t\t\t\t\t\t\t\t<div class="col-8">: <t t-esc="o['partner_id']['name']"/></div>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t\t\t\t<div class="col-3">Jenis Kelamin</div>\n\t\t\t\t\t\t\t\t\t<div class="col-8">: <t t-if="o['partner_id']['gender'] == 'male'">Laki-Laki</t>\n\t\t\t\t\t\t\t\t\t\t<t t-else="">Perempuan</t>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t\t\t\t<div class="col-3">Tanggal Lahir</div>\n\t\t\t\t\t\t\t\t\t<div class="col-8">: <t t-esc="o['partner_id']['birthDate'].strftime('%d-%m-%Y')"/></div>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t\t\t\t<div class="col-3">Agama</div>\n\t\t\t\t\t\t\t\t\t<div class="col-8">: <t t-if="'religion' in data">\n\t\t\t\t\t\t\t\t\t\t\t<t t-esc="data['religion']"/>\n\t\t\t\t\t\t\t\t\t\t</t></div>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t\t\t\t<div class="col-3">Pendidikan</div>\n\t\t\t\t\t\t\t\t\t<div class="col-8">: </div>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t\t\t\t<div class="col-3">Pekerjaan</div>\n\t\t\t\t\t\t\t\t\t<div class="col-8">: <t t-if="'occupation' in data">\n\t\t\t\t\t\t\t\t\t\t\t<t t-esc="data['occupation']"/>\n\t\t\t\t\t\t\t\t\t\t</t></div>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t\t\t\t<div class="col-3">Alamat</div>\n\t\t\t\t\t\t\t\t\t<div class="col-8">: <t t-esc="o['partner_id']['street']"/></div>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t\t\t\t<div class="col-3">Status Perkawinan</div>\n\t\t\t\t\t\t\t\t\t<div class="col-8">: <t t-if="'marital-status' in data">\n\t\t\t\t\t\t\t\t\t\t\t<t t-esc="data['marital-status']"/>\n\t\t\t\t\t\t\t\t\t\t</t></div>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t\t\t\t<div class="col-3">Nama Suami / Istri</div>\n\t\t\t\t\t\t\t\t\t<div class="col-8">: <t t-if="'partner' in data">\n\t\t\t\t\t\t\t\t\t\t\t<t t-esc="data['partner']"/>\n\t\t\t\t\t\t\t\t\t\t</t></div>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t\t\t\t<div class="col-3">Status Pembiayaan</div>\n\t\t\t\t\t\t\t\t\t<div class="col-8">: <t t-if="'payment' in data">\n\t\t\t\t\t\t\t\t\t\t\t<t t-esc="data['payment']"/>\n\t\t\t\t\t\t\t\t\t\t</t></div>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t<div style="background-color:#c1d09d; border-bottom: 1px solid black">\n\t\t\t\t\t\t\t\t<p class="text-center mb-0" style="width: 100%;">\n\t\t\t\t\t\t\t\t\t<strong>PERSETUJUAN UMUM / GENERAL CONSENT</strong>\n\t\t\t\t\t\t\t\t</p>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t<p class="text-center mt-1 mb-0" style="font-style: italic; text-decoration: underline;">\n\t\t\t\t\t\t\t\t<strong>PASIEN / WALI PASIEN HARUS MEMBACA, MEMAHAMI DAN MENGISI\n\t\t\t\t\t\t\t\t\tINFORMASI BERIKUT</strong>\n\t\t\t\t\t\t\t</p>\n\t\t\t\t\t\t\t<p class="mt-1 ml-2 mb-1">Yang bertanda tangan di bawah ini, saya:</p>\n\t\t\t\t\t\t\t<div class="pl-2 mr-3 col">\n\t\t\t\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t\t\t\t<div class="col-3">Nama Lengkap</div>\n\t\t\t\t\t\t\t\t\t<div class="col-6">: <strong>\n\t\t\t\t\t\t\t\t\t\t\t<t t-esc="data['nama-pj']"/>\n\t\t\t\t\t\t\t\t\t\t</strong>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<t t-if="'tgl-lahir-pj' in data">\n\t\t\t\t\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t\t\t\t\t<div class="col-3">Tempat / Tanggal Lahir</div>\n\t\t\t\t\t\t\t\t\t\t<div class="col-6">: <t t-if="'tempat-lahir-pj' in data">\n\t\t\t\t\t\t\t\t\t\t\t\t<t t-esc="data['tempat-lahir-pj']"/>\n\t\t\t\t\t\t\t\t\t\t\t</t>\n\t\t\t\t\t\t\t\t\t\t\t/<t t-if="'tgl-lahir-pj' in data">\n\t\t\t\t\t\t\t\t\t\t\t\t<t t-esc="data['tgl-lahir-pj']"/>\n\t\t\t\t\t\t\t\t\t\t\t</t></div>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t</t>\n\t\t\t\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t\t\t\t<div class="col-3">Alamat</div>\n\t\t\t\t\t\t\t\t\t<div class="col-6">: <t t-if="'alamat-pj' in data">\n\t\t\t\t\t\t\t\t\t\t\t<t t-esc="data['alamat-pj']"/>\n\t\t\t\t\t\t\t\t\t\t</t></div>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t\t\t\t<div class="col-3">No. Telepon</div>\n\t\t\t\t\t\t\t\t\t<div class="col-6">: <t t-if="'telepon-pj' in data">\n\t\t\t\t\t\t\t\t\t\t\t<t t-esc="data['telepon-pj']"/>\n\t\t\t\t\t\t\t\t\t\t</t></div>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t\t\t\t<div class="col-3">Email</div>\n\t\t\t\t\t\t\t\t\t<div class="col-6">: <t t-if="'email-pj' in data">\n\t\t\t\t\t\t\t\t\t\t\t<t t-esc="data['email-pj']"/>\n\t\t\t\t\t\t\t\t\t\t</t></div>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<t t-if="'relasi-pj' in data">\n\t\t\t\t\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t\t\t\t\t<div class="col-3">Bertindak atas</div>\n\t\t\t\t\t\t\t\t\t\t<div class="col-6">: <t t-if="'relasi-pj' in data">\n\t\t\t\t\t\t\t\t\t\t\t\t<t t-esc="data['relasi-pj']"/>\n\t\t\t\t\t\t\t\t\t\t\t</t></div>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t</t>\n\t\t\t\t\t\t\t\t<div>Menyatakan</div>\n\n\t\t\t\t\t\t\t\t<t t-if="'statement_template' in data">\n\t\t\t\t\t\t\t\t\t<div class="pr-3">\n\t\t\t\t\t\t\t\t\t\t<t t-raw="data['statement_template']"/>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t</t>\n\t\t\t\t\t\t\t\t<t t-else="">\n\t\t\t\t\t\t\t\t\t<div class="pr-3" style="page-break-inside: avoid; page-break-before: auto;">\n\t\t\t\t\t\t\t\t\t\t<div>\n\t\t\t\t\t\t\t\t\t\t\t<strong>I. PERSETUJUAN UNTUK PERAWATAN DAN PENGOBATAN</strong>\n\t\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t\t<div class="d-flex ml-3">\n\t\t\t\t\t\t\t\t\t\t\t<div class="pr-1">1.</div>\n\t\t\t\t\t\t\t\t\t\t\t<div>Saya mengetahui bahwa saya membutuhkan perawatan\n\t\t\t\t\t\t\t\t\t\t\t\tmedis dan mengijinkan dokter/tenaga Kesehatan\n\t\t\t\t\t\t\t\t\t\t\t\tlainnya di fasilitas Kesehatan RS/Klinik/<t t-esc="res_company.name"/> untuk melakukan\n\t\t\t\t\t\t\t\t\t\t\t\tpemeriksaan dan memberikan pengobatan / tindakan/\n\t\t\t\t\t\t\t\t\t\t\t\tasuhan yang sesuai prosedur</div>\n\t\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t\t<div class="d-flex ml-3">\n\t\t\t\t\t\t\t\t\t\t\t<div class="pr-1">2.</div>\n\t\t\t\t\t\t\t\t\t\t\t<div>Saya sadar bahwa praktik kedokteran bukanlah ilmu\n\t\t\t\t\t\t\t\t\t\t\t\tpasti dan saya mengakui bahwa tidak ada jaminan atas\n\t\t\t\t\t\t\t\t\t\t\t\thasil apapun terhadap pengobatan / Tindakan/ asuhan\n\t\t\t\t\t\t\t\t\t\t\t\tyang dilakukan pada saya</div>\n\t\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t\t<div class="d-flex ml-3">\n\t\t\t\t\t\t\t\t\t\t\t<div class="pr-1">3.</div>\n\t\t\t\t\t\t\t\t\t\t\t<div class="">\n\t\t\t\t\t\t\t\t\t\t\t\t<p>Saya mengerti dan memahami bahwa </p>\n\t\t\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t\t<div class="d-flex ml-5 pr-3">\n\t\t\t\t\t\t\t\t\t\t\t<div class="pr-1">a.</div>\n\t\t\t\t\t\t\t\t\t\t\t<div>Saya memiliki hak untuk menyatakan persetujuan atau\n\t\t\t\t\t\t\t\t\t\t\t\tpenolakan untuk setiap jasa perawatan medis yang\n\t\t\t\t\t\t\t\t\t\t\t\takan diberikan pada saya. Saya memahani bahwa\n\t\t\t\t\t\t\t\t\t\t\t\tpemberian jasa yang melibatkan data pribadi saya\n\t\t\t\t\t\t\t\t\t\t\t\tyang saya tolak, tanpanya layanan tidak dapat\n\t\t\t\t\t\t\t\t\t\t\t\tdiberikan, seperti pemeriksaan penyakit pasien,\n\t\t\t\t\t\t\t\t\t\t\t\tpemberian obat, asuhan, dan tindakan medis.</div>\n\t\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t\t<div class="d-flex ml-5 pr-3">\n\t\t\t\t\t\t\t\t\t\t\t<div class="pr-1">b.</div>\n\t\t\t\t\t\t\t\t\t\t\t<div>Saya memiliki hak untuk mengajukan pertanyaan\n\t\t\t\t\t\t\t\t\t\t\t\tterkait rencana pelayanan yang akan diberikan pada\n\t\t\t\t\t\t\t\t\t\t\t\tsaya, termasuk identitas setiap orang yang akan\n\t\t\t\t\t\t\t\t\t\t\t\tmemberikan jasa perawatan medis.</div>\n\t\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t\t<div class="d-flex ml-5 pr-3">\n\t\t\t\t\t\t\t\t\t\t\t<div class="pr-1">c.</div>\n\t\t\t\t\t\t\t\t\t\t\t<div>Saya memiliki hak untuk melakukan pernarikan\n\t\t\t\t\t\t\t\t\t\t\t\tpersetujuan saat kewajiban pihak fasilitas kesehatan\n\t\t\t\t\t\t\t\t\t\t\t\tmenyediakan layanan belum terlaksana atau saya\n\t\t\t\t\t\t\t\t\t\t\t\tmengubah keputusan persetujan atau penolakan yang\n\t\t\t\t\t\t\t\t\t\t\t\tsebelumnya saya berikan</div>\n\t\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t\t<div class="d-flex ml-3">\n\t\t\t\t\t\t\t\t\t\t\t<div class="pr-1">4.</div>\n\t\t\t\t\t\t\t\t\t\t\t<div class="">\n\t\t\t\t\t\t\t\t\t\t\t\t<p>Saya menyetujui bahwa dalam keadaan darurat (atau\n\t\t\t\t\t\t\t\t\t\t\t\t\tgawat darurat) data pribadi Saya hanya akan\n\t\t\t\t\t\t\t\t\t\t\t\t\tdigunakan untuk kepentingan perawatan medis.\n\t\t\t\t\t\t\t\t\t\t\t\t\tPemrosesan data ini hanya akan dilakukan apabila\n\t\t\t\t\t\t\t\t\t\t\t\t\tcara lain tidak dapat diupayakan seperti saya\n\t\t\t\t\t\t\t\t\t\t\t\t\tyang tidak sadarkan diri atau saya yang\n\t\t\t\t\t\t\t\t\t\t\t\t\tmemerlukan tindakan segera di IGD.</p>\n\t\t\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t<div class="pr-3" style="page-break-inside: avoid; page-break-before: auto;">\n\t\t\t\t\t\t\t\t\t\t<div>\n\t\t\t\t\t\t\t\t\t\t\t<strong>II. PERSETUJUAN PELEPASAN DATA</strong>\n\t\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t\t<div class="d-flex ml-3">\n\t\t\t\t\t\t\t\t\t\t\t<div class="pr-1">1.</div>\n\t\t\t\t\t\t\t\t\t\t\t<div>Saya memahami bahwa informasi pribadi saya terkait\n\t\t\t\t\t\t\t\t\t\t\t\tdengan kondisi Kesehatan saya, berdasarkan\n\t\t\t\t\t\t\t\t\t\t\t\tpemeriksaan yang saya jalani di fasilitas Kesehatan\n\t\t\t\t\t\t\t\t\t\t\t\tRS/Klinik/<t t-esc="res_company.name"/> akan\n\t\t\t\t\t\t\t\t\t\t\t\tterjamin kerahasiaannya</div>\n\t\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t\t<div class="d-flex ml-3">\n\t\t\t\t\t\t\t\t\t\t\t<div class="pr-1">2.</div>\n\t\t\t\t\t\t\t\t\t\t\t<div>Saya memberikan wewenang kepada fasilitas Kesehatan\n\t\t\t\t\t\t\t\t\t\t\t\tRS/Klinik/<t t-esc="res_company.name"/> untuk\n\t\t\t\t\t\t\t\t\t\t\t\tmemberikan informasi berkaitan dengan kondisi\n\t\t\t\t\t\t\t\t\t\t\t\tKesehatan saya untuk keperluan proses klaim asuransi\n\t\t\t\t\t\t\t\t\t\t\t\tdan administrasi resmi apabila diperlukan (BPJS,\n\t\t\t\t\t\t\t\t\t\t\t\tKemenkenkes, Dinkes)</div>\n\t\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t\t<div class="d-flex ml-3">\n\t\t\t\t\t\t\t\t\t\t\t<div class="pr-1">3.</div>\n\t\t\t\t\t\t\t\t\t\t\t<div>Saya memberi wewenang akses kepada fasilitas\n\t\t\t\t\t\t\t\t\t\t\t\tKesehatan RS/Klinik/<t t-esc="res_company.name"/>\n\t\t\t\t\t\t\t\t\t\t\t\tuntuk memberikan informasi Kesehatan saya kepada\n\t\t\t\t\t\t\t\t\t\t\t\tpihak berikut apabila diperlukan:</div>\n\t\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t\t<div class="d-flex- ml-5">\n\t\t\t\t\t\t\t\t\t\t\t<t t-if="'authorized-parties' in data">\n\t\t\t\t\t\t\t\t\t\t\t\t<t t-foreach="data['authorized-parties']" t-as="name">\n\t\t\t\t\t\t\t\t\t\t\t\t\t<div>\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t<t t-esc="name"/>\n\t\t\t\t\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t\t\t\t</t>\n\t\t\t\t\t\t\t\t\t\t\t</t>\n\t\t\t\t\t\t\t\t\t\t\t<t t-else="">\n\t\t\t\t\t\t\t\t\t\t\t\t<div style="height: 15px;"/>\n\t\t\t\t\t\t\t\t\t\t\t</t>\n\t\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t<div class="pr-3" style="page-break-inside: avoid; page-break-before: auto;">\n\t\t\t\t\t\t\t\t\t\t<div>\n\t\t\t\t\t\t\t\t\t\t\t<strong>III. HAK DAN KEWAJIBAN PASIEN</strong>\n\t\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t\t<div class="ml-3">\n\t\t\t\t\t\t\t\t\t\t\t<div class="mb-2">Saya telah mendapatkan informasi dan sudah memahami tentang “Hak dan Kewajiban Pasien” di fasilitas Kesehatan RS/Klinik/<t t-esc="res_company.name"/> melalui informasi yang diberikan kepada saya oleh petugas yang melayani saya.</div>\n\t\t\t\t\t\t\t\t\t\t\t<div class="content">\n\t\t\t\t\t\t\t\t\t\t\t\t<div>Hak Pasien</div>\n\t\t\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t\t\t<ol class="sub-content">\n\t\t\t\t\t\t\t\t\t\t\t\t<li>Mendapatkan informasi mengenai Kesehatan dirinya;</li>\n\t\t\t\t\t\t\t\t\t\t\t\t<li>Mendapatkan penjelasan yang memadai mengenai pelayanan kesehatan yang diterimanya; </li>\n\t\t\t\t\t\t\t\t\t\t\t\t<li>Mendapatkan pelayanan kesehatan sesuai dengan kebutuhan medis, standar profesi, dan pelayanan yang bermutu;</li>\n\t\t\t\t\t\t\t\t\t\t\t\t<li>Menolak atau menyetujui tindakan medis, kecuali untuk tindakan medis yang diperlukan dalam rangka pencegahan penyakit menular dan penanggulangan KLB atau Wabah; </li>\n\t\t\t\t\t\t\t\t\t\t\t\t<li>Mendapatkan akses terhadap informasi yang terdapat di dalam rekam medis; </li>\n\t\t\t\t\t\t\t\t\t\t\t\t<li>Meminta pendapat Tenaga Medis atau Tenaga Kesehatan lain; dan </li>\n\t\t\t\t\t\t\t\t\t\t\t\t<li> Mendapatkan hak lain sesuai dengan ketentuan peraturan perundang-undangan.</li>\n\t\t\t\t\t\t\t\t\t\t\t</ol> \n\t\t\t\t\t\t\t\t\t\t\t<div class="content">\n\t\t\t\t\t\t\t\t\t\t\t\t<div>Kewajiban Pasien</div>\n\t\t\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t\t\t<ol class="sub-content">\n\t\t\t\t\t\t\t\t\t\t\t\t<li>Memberikan informasi yang lengkap dan jujur tentang masalah kesehatannya;</li>\n\t\t\t\t\t\t\t\t\t\t\t\t<li>Mematuhi nasihat dan petunjuk Tenaga Medis dan Tenaga Kesehatan;</li>\n\t\t\t\t\t\t\t\t\t\t\t\t<li>Mematuhi ketentuan yang berlaku pada fasilitas pelayanan kesehatan; dan</li>\n\t\t\t\t\t\t\t\t\t\t\t\t<li>Memberikan imbalan jasa atau pelayanan yang diterima.</li>\n\t\t\t\t\t\t\t\t\t\t\t</ol>\n\t\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t<div class="pr-3" style="page-break-inside: avoid; page-break-before: auto;">\n\t\t\t\t\t\t\t\t\t\t<div>\n\t\t\t\t\t\t\t\t\t\t\t<strong>IV. INTEGRITAS DATA MEDIS</strong>\n\t\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t\t<div class="pr-3" style="page-break-inside: avoid; page-break-before: auto;">\n\t\t\t\t\t\t\t\t\t\t\t<div>\n\t\t\t\t\t\t\t\t\t\t\t\t<strong>V. KOMUNIKASI</strong>\n\t\t\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t\t\t<div class="ml-3">Saya bersedia untuk dihubungi melalui\n\t\t\t\t\t\t\t\t\t\t\t\talamat atau alamat email sehubungan dengan reporting\n\t\t\t\t\t\t\t\t\t\t\t\thack dan kegagalan/gangguan sistem yang berdampak serius\n\t\t\t\t\t\t\t\t\t\t\t\tmengenai dampak serius kebocoran data pribadi agar Saya\n\t\t\t\t\t\t\t\t\t\t\t\tdapat mengantisipasi risiko dari peristiwa tersebut.\n\t\t\t\t\t\t\t\t\t\t\t\tSelain itu Saya mengijinkan pelaporan ini untuk\n\t\t\t\t\t\t\t\t\t\t\t\tdiberikan kepada otoritas yang berwenang dan segera\n\t\t\t\t\t\t\t\t\t\t\t\ttanpa menunda-nunda sesuai dengan peraturan\n\t\t\t\t\t\t\t\t\t\t\t\tperundang-undangan yang berlaku.</div>\n\t\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t</t>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class="d-flex ml-2" style="page-break-inside: avoid; page-break-before: auto;">\n\t\t\t\t\t\t<div class="col-4">\n\t\t\t\t\t\t\t<p class="pt-3 mb-0">Petugas</p>\n\t\t\t\t\t\t\t<t t-if="'practitioner-sign' in data">\n\t\t\t\t\t\t\t\t<div style="width:110px;height:80px;">\n\t\t\t\t\t\t\t\t\t<img height="80" t-att-src="data['practitioner-sign']"/>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t</t>\n\t\t\t\t\t\t\t<t t-else="">\n\t\t\t\t\t\t\t\t<div style="width:110px;height:80px;"/>\n\t\t\t\t\t\t\t</t>\n\t\t\t\t\t\t\t<p class="mb-0 mt-1">\n\t\t\t\t\t\t\t\t<t t-if="'practitioner-name' in data">\n\t\t\t\t\t\t\t\t\t<strong>\n\t\t\t\t\t\t\t\t\t\t<t t-esc="data['practitioner-name']"/>\n\t\t\t\t\t\t\t\t\t</strong>\n\t\t\t\t\t\t\t\t</t>\n\t\t\t\t\t\t\t\t<t t-elif="'examiner_name' in data">\n\t\t\t\t\t\t\t\t\t<strong>\n\t\t\t\t\t\t\t\t\t\t<t t-esc="data['examiner_name']"/>\n\t\t\t\t\t\t\t\t\t</strong>\n\t\t\t\t\t\t\t\t</t>\n\t\t\t\t\t\t\t\t<t t-else="">\n\t\t\t\t\t\t\t\t\t<strong>\n\t\t\t\t\t\t\t\t\t\t<t t-esc="data['sender']"/>\n\t\t\t\t\t\t\t\t\t</strong>\n\t\t\t\t\t\t\t\t</t>\n\t\t\t\t\t\t\t</p>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t<div class="col-4"/>\n\t\t\t\t\t\t<div class="col-4">\n\t\t\t\t\t\t\t<p class="mb-0"><t t-esc="o['operating_unit_id']['company_id']['city']"/>\n\t\t\t\t\t\t\t\t, <t t-esc="o.to_date_string(data['registration_date'])"/>\n\t\t\t\t\t\t\t</p>\n\t\t\t\t\t\t\t<p class="mb-0">Pasien / Wali Pasien</p>\n\t\t\t\t\t\t\t<t t-if="'sign-pj' in data">\n\t\t\t\t\t\t\t\t<div style="width:110px;height:80px;">\n\t\t\t\t\t\t\t\t\t<img height="80" t-att-src="data['sign-pj']"/>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t</t>\n\t\t\t\t\t\t\t<p class="mb-0 mt-1">\n\t\t\t\t\t\t\t\t<strong>\n\t\t\t\t\t\t\t\t\t<t t-esc="data['nama-pj']"/>\n\t\t\t\t\t\t\t\t</strong>\n\t\t\t\t\t\t\t</p>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t</t>\n\t\t\t<script type="text/javascript" src="/ehealth_document/static/src/js/general-consent-statement.js"/>\n\t\t</t>\n\t	\N	\N	primary	t	1	2025-08-28 11:34:01.364376	1	2025-08-28 11:34:01.364376	f
1600	report_akamedicalcenter_general_consent	\N	ehealth_document.report_akamedicalcenter_general_consent	16	qweb	<?xml version="1.0"?>\n<t t-name="ehealth_document.report_akamedicalcenter_general_consent">\n\t\t\t<t t-set="company" t-value="res_company"/>\n\t\t\t<t t-call="ehealth_document.header_akamedicalcenter_document">\n\t\t\t\t<div class="page" style="font-size:13px; line-height: 1.4;">\n\t\t\t\t\t<div class="row" style="">\n\t\t\t\t\t\t<div class="">\n\t\t\t\t\t\t\t<div style="background-color:#c1d09d; border-bottom: 1px solid black">\n\t\t\t\t\t\t\t\t<p class="text-center mb-0" style="width: 100%;">\n\t\t\t\t\t\t\t\t\t<strong>PENGKAJIAN DATA UMUM PASIEN</strong>\n\t\t\t\t\t\t\t\t</p>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t<div class="d-flex mt-2">\n\t\t\t\t\t\t\t\t<div class="ml-2 mb-1">\n\t\t\t\t\t\t\t\t\t<p>Diisi oleh Petugas Pendaftaran pada</p>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<div class="ml-2 mb-1">\n\t\t\t\t\t\t\t\t\t<p>tanggal: <t t-if="'tgl-consent' in data">\n\t\t\t\t\t\t\t\t\t\t\t<t t-esc="data['tgl-consent']"/>\n\t\t\t\t\t\t\t\t\t\t</t></p>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<div class="ml-5 mb-1">\n\t\t\t\t\t\t\t\t\t<p>jam: <t t-if="'waktu-consent' in data">\n\t\t\t\t\t\t\t\t\t\t\t<t t-esc="data['waktu-consent']"/>\n\t\t\t\t\t\t\t\t\t\t</t></p>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t<div class="pl-2 p-2">\n\t\t\t\t\t\t\t\t<p class="mb-0" style="font-size: 16px">\n\t\t\t\t\t\t\t\t\t<strong>IDENTITAS PASIEN</strong>\n\t\t\t\t\t\t\t\t</p>\n\t\t\t\t\t\t\t\t<p class="mb-0" style="font-style: italic;">(Diisi sesuai Kartu\n\t\t\t\t\t\t\t\t\tTanda Pengenal Pasien yang masih berlaku; KTP/ KK/ SIM/ Kartu\n\t\t\t\t\t\t\t\t\tPelajar/ dsb)</p>\n\t\t\t\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t\t\t\t<div class="col-3">Nomer Rekam Medis</div>\n\t\t\t\t\t\t\t\t\t<div class="col-8">: <t t-if="'no-cm' in data">\n\t\t\t\t\t\t\t\t\t\t\t<t t-esc="data['no-cm']"/>\n\t\t\t\t\t\t\t\t\t\t</t>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t\t\t\t<div class="col-3">Nama</div>\n\t\t\t\t\t\t\t\t\t<div class="col-8">: <t t-esc="o['partner_id']['name']"/></div>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t\t\t\t<div class="col-3">Jenis Kelamin</div>\n\t\t\t\t\t\t\t\t\t<div class="col-8">: <t t-if="o['partner_id']['gender'] == 'male'">Laki-Laki</t>\n\t\t\t\t\t\t\t\t\t\t<t t-else="">Perempuan</t>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t\t\t\t<div class="col-3">Tanggal Lahir</div>\n\t\t\t\t\t\t\t\t\t<div class="col-8">: <t t-esc="o['partner_id']['birthDate'].strftime('%d-%m-%Y')"/></div>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t\t\t\t<div class="col-3">Agama</div>\n\t\t\t\t\t\t\t\t\t<div class="col-8">: <t t-if="'religion' in data">\n\t\t\t\t\t\t\t\t\t\t\t<t t-esc="data['religion']"/>\n\t\t\t\t\t\t\t\t\t\t</t></div>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t\t\t\t<div class="col-3">Pendidikan</div>\n\t\t\t\t\t\t\t\t\t<div class="col-8">: </div>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t\t\t\t<div class="col-3">Pekerjaan</div>\n\t\t\t\t\t\t\t\t\t<div class="col-8">: <t t-if="'occupation' in data">\n\t\t\t\t\t\t\t\t\t\t\t<t t-esc="data['occupation']"/>\n\t\t\t\t\t\t\t\t\t\t</t></div>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t\t\t\t<div class="col-3">Alamat</div>\n\t\t\t\t\t\t\t\t\t<div class="col-8">: <t t-esc="o['partner_id']['street']"/></div>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t\t\t\t<div class="col-3">Status Perkawinan</div>\n\t\t\t\t\t\t\t\t\t<div class="col-8">: <t t-if="'marital-status' in data">\n\t\t\t\t\t\t\t\t\t\t\t<t t-esc="data['marital-status']"/>\n\t\t\t\t\t\t\t\t\t\t</t></div>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t\t\t\t<div class="col-3">Nama Suami / Istri</div>\n\t\t\t\t\t\t\t\t\t<div class="col-8">: <t t-if="'partner' in data">\n\t\t\t\t\t\t\t\t\t\t\t<t t-esc="data['partner']"/>\n\t\t\t\t\t\t\t\t\t\t</t></div>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t\t\t\t<div class="col-3">Status Pembiayaan</div>\n\t\t\t\t\t\t\t\t\t<div class="col-8">: <t t-if="'payment' in data">\n\t\t\t\t\t\t\t\t\t\t\t<t t-esc="data['payment']"/>\n\t\t\t\t\t\t\t\t\t\t</t></div>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t<div style="background-color:#c1d09d; border-bottom: 1px solid black">\n\t\t\t\t\t\t\t\t<p class="text-center mb-0" style="width: 100%;">\n\t\t\t\t\t\t\t\t\t<strong>PERSETUJUAN UMUM / GENERAL CONSENT</strong>\n\t\t\t\t\t\t\t\t</p>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t<p class="text-center mt-1 mb-0" style="font-style: italic; text-decoration: underline;">\n\t\t\t\t\t\t\t\t<strong>PASIEN / WALI PASIEN HARUS MEMBACA, MEMAHAMI DAN MENGISI\n\t\t\t\t\t\t\t\t\tINFORMASI BERIKUT</strong>\n\t\t\t\t\t\t\t</p>\n\t\t\t\t\t\t\t<p class="mt-1 ml-2 mb-1">Yang bertanda tangan di bawah ini, saya:</p>\n\t\t\t\t\t\t\t<div class="pl-2 mr-3 col">\n\t\t\t\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t\t\t\t<div class="col-3">Nama Lengkap</div>\n\t\t\t\t\t\t\t\t\t<div class="col-6">: <strong>\n\t\t\t\t\t\t\t\t\t\t\t<t t-esc="data['nama-pj']"/>\n\t\t\t\t\t\t\t\t\t\t</strong>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<t t-if="'tgl-lahir-pj' in data">\n\t\t\t\t\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t\t\t\t\t<div class="col-3">Tempat / Tanggal Lahir</div>\n\t\t\t\t\t\t\t\t\t\t<div class="col-6">: <t t-if="'tempat-lahir-pj' in data">\n\t\t\t\t\t\t\t\t\t\t\t\t<t t-esc="data['tempat-lahir-pj']"/>\n\t\t\t\t\t\t\t\t\t\t\t</t>\n\t\t\t\t\t\t\t\t\t\t\t/<t t-if="'tgl-lahir-pj' in data">\n\t\t\t\t\t\t\t\t\t\t\t\t<t t-esc="data['tgl-lahir-pj']"/>\n\t\t\t\t\t\t\t\t\t\t\t</t></div>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t</t>\n\t\t\t\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t\t\t\t<div class="col-3">Alamat</div>\n\t\t\t\t\t\t\t\t\t<div class="col-6">: <t t-if="'alamat-pj' in data">\n\t\t\t\t\t\t\t\t\t\t\t<t t-esc="data['alamat-pj']"/>\n\t\t\t\t\t\t\t\t\t\t</t></div>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t\t\t\t<div class="col-3">No. Telepon</div>\n\t\t\t\t\t\t\t\t\t<div class="col-6">: <t t-if="'telepon-pj' in data">\n\t\t\t\t\t\t\t\t\t\t\t<t t-esc="data['telepon-pj']"/>\n\t\t\t\t\t\t\t\t\t\t</t></div>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t\t\t\t<div class="col-3">Email</div>\n\t\t\t\t\t\t\t\t\t<div class="col-6">: <t t-if="'email-pj' in data">\n\t\t\t\t\t\t\t\t\t\t\t<t t-esc="data['email-pj']"/>\n\t\t\t\t\t\t\t\t\t\t</t></div>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<t t-if="'relasi-pj' in data">\n\t\t\t\t\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t\t\t\t\t<div class="col-3">Bertindak atas</div>\n\t\t\t\t\t\t\t\t\t\t<div class="col-6">: <t t-if="'relasi-pj' in data">\n\t\t\t\t\t\t\t\t\t\t\t\t<t t-esc="data['relasi-pj']"/>\n\t\t\t\t\t\t\t\t\t\t\t</t></div>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t</t>\n\t\t\t\t\t\t\t\t<div>Menyatakan</div>\n\n\t\t\t\t\t\t\t\t<t t-if="'statement_template' in data">\n\t\t\t\t\t\t\t\t\t<div class="pr-3">\n\t\t\t\t\t\t\t\t\t\t<t t-raw="data['statement_template']"/>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t</t>\n\t\t\t\t\t\t\t\t<t t-else="">\n\t\t\t\t\t\t\t\t\t<div class="pr-3" style="page-break-inside: avoid; page-break-before: auto;">\n\t\t\t\t\t\t\t\t\t\t<div>\n\t\t\t\t\t\t\t\t\t\t\t<strong>I. PERSETUJUAN UNTUK PERAWATAN DAN PENGOBATAN</strong>\n\t\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t\t<div class="d-flex ml-3">\n\t\t\t\t\t\t\t\t\t\t\t<div class="pr-1">1.</div>\n\t\t\t\t\t\t\t\t\t\t\t<div>Saya mengetahui bahwa saya membutuhkan perawatan\n\t\t\t\t\t\t\t\t\t\t\t\tmedis dan mengijinkan dokter/tenaga Kesehatan\n\t\t\t\t\t\t\t\t\t\t\t\tlainnya di fasilitas Kesehatan RS/Klinik/<t t-esc="res_company.name"/> untuk melakukan\n\t\t\t\t\t\t\t\t\t\t\t\tpemeriksaan dan memberikan pengobatan / tindakan/\n\t\t\t\t\t\t\t\t\t\t\t\tasuhan yang sesuai prosedur</div>\n\t\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t\t<div class="d-flex ml-3">\n\t\t\t\t\t\t\t\t\t\t\t<div class="pr-1">2.</div>\n\t\t\t\t\t\t\t\t\t\t\t<div>Saya sadar bahwa praktik kedokteran bukanlah ilmu\n\t\t\t\t\t\t\t\t\t\t\t\tpasti dan saya mengakui bahwa tidak ada jaminan atas\n\t\t\t\t\t\t\t\t\t\t\t\thasil apapun terhadap pengobatan / Tindakan/ asuhan\n\t\t\t\t\t\t\t\t\t\t\t\tyang dilakukan pada saya</div>\n\t\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t\t<div class="d-flex ml-3">\n\t\t\t\t\t\t\t\t\t\t\t<div class="pr-1">3.</div>\n\t\t\t\t\t\t\t\t\t\t\t<div class="">\n\t\t\t\t\t\t\t\t\t\t\t\t<p>Saya mengerti dan memahami bahwa </p>\n\t\t\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t\t<div class="d-flex ml-5 pr-3">\n\t\t\t\t\t\t\t\t\t\t\t<div class="pr-1">a.</div>\n\t\t\t\t\t\t\t\t\t\t\t<div>Saya memiliki hak untuk menyatakan persetujuan atau\n\t\t\t\t\t\t\t\t\t\t\t\tpenolakan untuk setiap jasa perawatan medis yang\n\t\t\t\t\t\t\t\t\t\t\t\takan diberikan pada saya. Saya memahani bahwa\n\t\t\t\t\t\t\t\t\t\t\t\tpemberian jasa yang melibatkan data pribadi saya\n\t\t\t\t\t\t\t\t\t\t\t\tyang saya tolak, tanpanya layanan tidak dapat\n\t\t\t\t\t\t\t\t\t\t\t\tdiberikan, seperti pemeriksaan penyakit pasien,\n\t\t\t\t\t\t\t\t\t\t\t\tpemberian obat, asuhan, dan tindakan medis.</div>\n\t\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t\t<div class="d-flex ml-5 pr-3">\n\t\t\t\t\t\t\t\t\t\t\t<div class="pr-1">b.</div>\n\t\t\t\t\t\t\t\t\t\t\t<div>Saya memiliki hak untuk mengajukan pertanyaan\n\t\t\t\t\t\t\t\t\t\t\t\tterkait rencana pelayanan yang akan diberikan pada\n\t\t\t\t\t\t\t\t\t\t\t\tsaya, termasuk identitas setiap orang yang akan\n\t\t\t\t\t\t\t\t\t\t\t\tmemberikan jasa perawatan medis.</div>\n\t\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t\t<div class="d-flex ml-5 pr-3">\n\t\t\t\t\t\t\t\t\t\t\t<div class="pr-1">c.</div>\n\t\t\t\t\t\t\t\t\t\t\t<div>Saya memiliki hak untuk melakukan pernarikan\n\t\t\t\t\t\t\t\t\t\t\t\tpersetujuan saat kewajiban pihak fasilitas kesehatan\n\t\t\t\t\t\t\t\t\t\t\t\tmenyediakan layanan belum terlaksana atau saya\n\t\t\t\t\t\t\t\t\t\t\t\tmengubah keputusan persetujan atau penolakan yang\n\t\t\t\t\t\t\t\t\t\t\t\tsebelumnya saya berikan</div>\n\t\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t\t<div class="d-flex ml-3">\n\t\t\t\t\t\t\t\t\t\t\t<div class="pr-1">4.</div>\n\t\t\t\t\t\t\t\t\t\t\t<div class="">\n\t\t\t\t\t\t\t\t\t\t\t\t<p>Saya menyetujui bahwa dalam keadaan darurat (atau\n\t\t\t\t\t\t\t\t\t\t\t\t\tgawat darurat) data pribadi Saya hanya akan\n\t\t\t\t\t\t\t\t\t\t\t\t\tdigunakan untuk kepentingan perawatan medis.\n\t\t\t\t\t\t\t\t\t\t\t\t\tPemrosesan data ini hanya akan dilakukan apabila\n\t\t\t\t\t\t\t\t\t\t\t\t\tcara lain tidak dapat diupayakan seperti saya\n\t\t\t\t\t\t\t\t\t\t\t\t\tyang tidak sadarkan diri atau saya yang\n\t\t\t\t\t\t\t\t\t\t\t\t\tmemerlukan tindakan segera di IGD.</p>\n\t\t\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t<div class="pr-3" style="page-break-inside: avoid; page-break-before: auto;">\n\t\t\t\t\t\t\t\t\t\t<div>\n\t\t\t\t\t\t\t\t\t\t\t<strong>II. PERSETUJUAN PELEPASAN DATA</strong>\n\t\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t\t<div class="d-flex ml-3">\n\t\t\t\t\t\t\t\t\t\t\t<div class="pr-1">1.</div>\n\t\t\t\t\t\t\t\t\t\t\t<div>Saya memahami bahwa informasi pribadi saya terkait\n\t\t\t\t\t\t\t\t\t\t\t\tdengan kondisi Kesehatan saya, berdasarkan\n\t\t\t\t\t\t\t\t\t\t\t\tpemeriksaan yang saya jalani di fasilitas Kesehatan\n\t\t\t\t\t\t\t\t\t\t\t\tRS/Klinik/<t t-esc="res_company.name"/> akan\n\t\t\t\t\t\t\t\t\t\t\t\tterjamin kerahasiaannya</div>\n\t\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t\t<div class="d-flex ml-3">\n\t\t\t\t\t\t\t\t\t\t\t<div class="pr-1">2.</div>\n\t\t\t\t\t\t\t\t\t\t\t<div>Saya memberikan wewenang kepada fasilitas Kesehatan\n\t\t\t\t\t\t\t\t\t\t\t\tRS/Klinik/<t t-esc="res_company.name"/> untuk\n\t\t\t\t\t\t\t\t\t\t\t\tmemberikan informasi berkaitan dengan kondisi\n\t\t\t\t\t\t\t\t\t\t\t\tKesehatan saya untuk keperluan proses klaim asuransi\n\t\t\t\t\t\t\t\t\t\t\t\tdan administrasi resmi apabila diperlukan (BPJS,\n\t\t\t\t\t\t\t\t\t\t\t\tKemenkenkes, Dinkes)</div>\n\t\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t\t<div class="d-flex ml-3">\n\t\t\t\t\t\t\t\t\t\t\t<div class="pr-1">3.</div>\n\t\t\t\t\t\t\t\t\t\t\t<div>Saya memberi wewenang akses kepada fasilitas\n\t\t\t\t\t\t\t\t\t\t\t\tKesehatan RS/Klinik/<t t-esc="res_company.name"/>\n\t\t\t\t\t\t\t\t\t\t\t\tuntuk memberikan informasi Kesehatan saya kepada\n\t\t\t\t\t\t\t\t\t\t\t\tpihak berikut apabila diperlukan:</div>\n\t\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t\t<div class="d-flex- ml-5">\n\t\t\t\t\t\t\t\t\t\t\t<t t-if="'authorized-parties' in data">\n\t\t\t\t\t\t\t\t\t\t\t\t<t t-foreach="data['authorized-parties']" t-as="name">\n\t\t\t\t\t\t\t\t\t\t\t\t\t<div>\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t<t t-esc="name"/>\n\t\t\t\t\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t\t\t\t</t>\n\t\t\t\t\t\t\t\t\t\t\t</t>\n\t\t\t\t\t\t\t\t\t\t\t<t t-else="">\n\t\t\t\t\t\t\t\t\t\t\t\t<div style="height: 15px;"/>\n\t\t\t\t\t\t\t\t\t\t\t</t>\n\t\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t<div class="pr-3" style="page-break-inside: avoid; page-break-before: auto;">\n\t\t\t\t\t\t\t\t\t\t<div>\n\t\t\t\t\t\t\t\t\t\t\t<strong>III. HAK DAN KEWAJIBAN PASIEN</strong>\n\t\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t\t<div class="ml-3">\n\t\t\t\t\t\t\t\t\t\t\t<div class="mb-2">Saya telah mendapatkan informasi dan\n\t\t\t\t\t\t\t\t\t\t\t\tsudah memahami tentang “Hak dan Kewajiban Pasien” di\n\t\t\t\t\t\t\t\t\t\t\t\tfasilitas Kesehatan RS/Klinik/<t t-esc="res_company.name"/> melalui informasi\n\t\t\t\t\t\t\t\t\t\t\t\tyang diberikan kepada saya oleh petugas yang\n\t\t\t\t\t\t\t\t\t\t\t\tmelayani saya.</div>\n\t\t\t\t\t\t\t\t\t\t\t<div class="content">\n\t\t\t\t\t\t\t\t\t\t\t\t<div>Hak Pasien</div>\n\t\t\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t\t\t<ol class="sub-content">\n\t\t\t\t\t\t\t\t\t\t\t\t<li>Mendapatkan informasi mengenai Kesehatan\n\t\t\t\t\t\t\t\t\t\t\t\t\tdirinya;</li>\n\t\t\t\t\t\t\t\t\t\t\t\t<li>Mendapatkan penjelasan yang memadai mengenai\n\t\t\t\t\t\t\t\t\t\t\t\t\tpelayanan kesehatan yang diterimanya; </li>\n\t\t\t\t\t\t\t\t\t\t\t\t<li>Mendapatkan pelayanan kesehatan sesuai dengan\n\t\t\t\t\t\t\t\t\t\t\t\t\tkebutuhan medis, standar profesi, dan pelayanan\n\t\t\t\t\t\t\t\t\t\t\t\t\tyang bermutu;</li>\n\t\t\t\t\t\t\t\t\t\t\t\t<li>Menolak atau menyetujui tindakan medis, kecuali\n\t\t\t\t\t\t\t\t\t\t\t\t\tuntuk tindakan medis yang diperlukan dalam\n\t\t\t\t\t\t\t\t\t\t\t\t\trangka pencegahan penyakit menular dan\n\t\t\t\t\t\t\t\t\t\t\t\t\tpenanggulangan KLB atau Wabah; </li>\n\t\t\t\t\t\t\t\t\t\t\t\t<li>Mendapatkan akses terhadap informasi yang\n\t\t\t\t\t\t\t\t\t\t\t\t\tterdapat di dalam rekam medis; </li>\n\t\t\t\t\t\t\t\t\t\t\t\t<li>Meminta pendapat Tenaga Medis atau Tenaga\n\t\t\t\t\t\t\t\t\t\t\t\t\tKesehatan lain; dan </li>\n\t\t\t\t\t\t\t\t\t\t\t\t<li> Mendapatkan hak lain sesuai dengan ketentuan\n\t\t\t\t\t\t\t\t\t\t\t\t\tperaturan perundang-undangan.</li>\n\t\t\t\t\t\t\t\t\t\t\t</ol>\n\t\t\t\t\t\t\t\t\t\t\t<div class="content">\n\t\t\t\t\t\t\t\t\t\t\t\t<div>Kewajiban Pasien</div>\n\t\t\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t\t\t<ol class="sub-content">\n\t\t\t\t\t\t\t\t\t\t\t\t<li>Memberikan informasi yang lengkap dan jujur\n\t\t\t\t\t\t\t\t\t\t\t\t\ttentang masalah kesehatannya;</li>\n\t\t\t\t\t\t\t\t\t\t\t\t<li>Mematuhi nasihat dan petunjuk Tenaga Medis dan\n\t\t\t\t\t\t\t\t\t\t\t\t\tTenaga Kesehatan;</li>\n\t\t\t\t\t\t\t\t\t\t\t\t<li>Mematuhi ketentuan yang berlaku pada fasilitas\n\t\t\t\t\t\t\t\t\t\t\t\t\tpelayanan kesehatan; dan</li>\n\t\t\t\t\t\t\t\t\t\t\t\t<li>Memberikan imbalan jasa atau pelayanan yang\n\t\t\t\t\t\t\t\t\t\t\t\t\tditerima.</li>\n\t\t\t\t\t\t\t\t\t\t\t</ol>\n\t\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t<div class="pr-3" style="page-break-inside: avoid; page-break-before: auto;">\n\t\t\t\t\t\t\t\t\t\t<div>\n\t\t\t\t\t\t\t\t\t\t\t<strong>IV. INTEGRITAS DATA MEDIS</strong>\n\t\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t\t<div class="pr-3" style="page-break-inside: avoid; page-break-before: auto;">\n\t\t\t\t\t\t\t\t\t\t\t<div>\n\t\t\t\t\t\t\t\t\t\t\t\t<strong>V. KOMUNIKASI</strong>\n\t\t\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t\t\t<div class="ml-3">Saya bersedia untuk dihubungi melalui\n\t\t\t\t\t\t\t\t\t\t\t\talamat atau alamat email sehubungan dengan reporting\n\t\t\t\t\t\t\t\t\t\t\t\thack dan kegagalan/gangguan sistem yang berdampak\n\t\t\t\t\t\t\t\t\t\t\t\tserius\n\t\t\t\t\t\t\t\t\t\t\t\tmengenai dampak serius kebocoran data pribadi agar\n\t\t\t\t\t\t\t\t\t\t\t\tSaya\n\t\t\t\t\t\t\t\t\t\t\t\tdapat mengantisipasi risiko dari peristiwa tersebut.\n\t\t\t\t\t\t\t\t\t\t\t\tSelain itu Saya mengijinkan pelaporan ini untuk\n\t\t\t\t\t\t\t\t\t\t\t\tdiberikan kepada otoritas yang berwenang dan segera\n\t\t\t\t\t\t\t\t\t\t\t\ttanpa menunda-nunda sesuai dengan peraturan\n\t\t\t\t\t\t\t\t\t\t\t\tperundang-undangan yang berlaku.</div>\n\t\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t</t>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class="d-flex ml-2" style="page-break-inside: avoid; page-break-before: auto;">\n\t\t\t\t\t\t<div class="col-4">\n\t\t\t\t\t\t\t<p class="pt-3 mb-0">Petugas</p>\n\t\t\t\t\t\t\t<t t-if="'practitioner-sign' in data">\n\t\t\t\t\t\t\t\t<div style="width:110px;height:80px;">\n\t\t\t\t\t\t\t\t\t<img height="80" t-att-src="data['practitioner-sign']"/>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t</t>\n\t\t\t\t\t\t\t<t t-else="">\n\t\t\t\t\t\t\t\t<div style="width:110px;height:80px;"/>\n\t\t\t\t\t\t\t</t>\n\t\t\t\t\t\t\t<p class="mb-0 mt-1">\n\t\t\t\t\t\t\t\t<t t-if="'practitioner-name' in data">\n\t\t\t\t\t\t\t\t\t<strong>\n\t\t\t\t\t\t\t\t\t\t<t t-esc="data['practitioner-name']"/>\n\t\t\t\t\t\t\t\t\t</strong>\n\t\t\t\t\t\t\t\t</t>\n\t\t\t\t\t\t\t\t<t t-elif="'examiner_name' in data">\n\t\t\t\t\t\t\t\t\t<strong>\n\t\t\t\t\t\t\t\t\t\t<t t-esc="data['examiner_name']"/>\n\t\t\t\t\t\t\t\t\t</strong>\n\t\t\t\t\t\t\t\t</t>\n\t\t\t\t\t\t\t\t<t t-else="">\n\t\t\t\t\t\t\t\t\t<strong>\n\t\t\t\t\t\t\t\t\t\t<t t-esc="data['sender']"/>\n\t\t\t\t\t\t\t\t\t</strong>\n\t\t\t\t\t\t\t\t</t>\n\t\t\t\t\t\t\t</p>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t<div class="col-4"/>\n\t\t\t\t\t\t<div class="col-4">\n\t\t\t\t\t\t\t<p class="mb-0"><t t-esc="o['operating_unit_id']['company_id']['city']"/>\n\t\t\t\t\t\t\t\t, <t t-esc="o.to_date_string(data['registration_date'])"/>\n\t\t\t\t\t\t\t</p>\n\t\t\t\t\t\t\t<p class="mb-0">Pasien / Wali Pasien</p>\n\t\t\t\t\t\t\t<t t-if="'sign-pj' in data">\n\t\t\t\t\t\t\t\t<div style="width:110px;height:80px;">\n\t\t\t\t\t\t\t\t\t<img height="80" t-att-src="data['sign-pj']"/>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t</t>\n\t\t\t\t\t\t\t<p class="mb-0 mt-1">\n\t\t\t\t\t\t\t\t<strong>\n\t\t\t\t\t\t\t\t\t<t t-esc="data['nama-pj']"/>\n\t\t\t\t\t\t\t\t</strong>\n\t\t\t\t\t\t\t</p>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t</t>\n\t\t\t<script type="text/javascript" src="/ehealth_document/static/src/js/general-consent-statement.js"/>\n\t\t</t>\n\t	ehealth_document/report/template_general_consent/report_akamedicalcenter_general_consent.xml	\N	\N	\N	\N	primary	t	1	2025-08-28 11:34:01.364376	1	2025-08-28 11:34:01.364376	f
1601	report_pmbdian_general_consent	\N	ehealth_document.report_pmbdian_general_consent	16	qweb	<?xml version="1.0"?>\n<t t-name="ehealth_document.report_pmbdian_general_consent">\n\t\t\t<t t-set="company" t-value="res_company"/>\n\t\t\t<t t-call="ehealth_document.header_pmbdian_document">\n\t\t\t\t<div class="page mt-5" style="font-size:13px; line-height: 1.4;">\n\t\t\t\t\t<div class="row" style="border: 1px solid black">\n\t\t\t\t\t\t<div class="" style="margin-top: 80px">\n\t\t\t\t\t\t\t<div style="background-color:#c1d09d; border-bottom: 1px solid black">\n\t\t\t\t\t\t\t\t<p class="text-center mb-0" style="width: 100%;">\n\t\t\t\t\t\t\t\t\t<strong>PENGKAJIAN DATA UMUM PASIEN</strong>\n\t\t\t\t\t\t\t\t</p>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t<div class="row mt-2" style="border-bottom: 1px solid black">\n\t\t\t\t\t\t\t\t<div class="ml-3 mb-1">\n\t\t\t\t\t\t\t\t\t<p>Diisi oleh Petugas Pendaftaran pada</p>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<div class="ml-2 mb-1">\n\t\t\t\t\t\t\t\t\t<p>tanggal: <t t-if="'tgl-consent' in data"><t t-esc="data['tgl-consent']"/></t></p>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<div class="ml-5 mb-1">\n\t\t\t\t\t\t\t\t\t<p>jam: <t t-if="'waktu-consent' in data"><t t-esc="data['waktu-consent']"/></t></p>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t<div class="pl-2" style="border-bottom: 1px solid black">\n\t\t\t\t\t\t\t\t<p class="mb-0" style="font-size: 16px">\n\t\t\t\t\t\t\t\t\t<strong>IDENTITAS PASIEN</strong>\n\t\t\t\t\t\t\t\t</p>\n\t\t\t\t\t\t\t\t<p class="mb-0" style="font-style: italic;">(Diisi sesuai Kartu Tanda Pengenal Pasien yang masih berlaku; KTP/ KK/ SIM/ Kartu Pelajar/ dsb)</p>\n\t\t\t\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t\t\t\t<div class="col-3">Nomer Rekam Medis</div>\n\t\t\t\t\t\t\t\t\t<div class="col-8">: <t t-esc="data['no-cm']"/> </div>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t\t\t\t<div class="col-3">Nama</div>\n\t\t\t\t\t\t\t\t\t<div class="col-8">: <t t-esc="o['partner_id']['name']"/></div>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t\t\t\t<div class="col-3">Jenis Kelamin</div>\n\t\t\t\t\t\t\t\t\t<div class="col-8">:\n\t\t\t\t\t\t\t\t\t\t<t t-if="o['partner_id']['gender'] == 'male'">Laki-Laki</t>\n\t\t\t\t\t\t\t\t\t\t<t t-else="">Perempuan</t>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t\t\t\t<div class="col-3">Tanggal Lahir</div>\n\t\t\t\t\t\t\t\t\t<div class="col-8">: <t t-esc="o['partner_id']['birthDate'].strftime('%d-%m-%Y')"/></div>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t\t\t\t<div class="col-3">Agama</div>\n\t\t\t\t\t\t\t\t\t<div class="col-8">: <t t-if="'religion' in data"> <t t-esc="data['religion']"/> </t></div>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t\t\t\t<div class="col-3">Pendidikan</div>\n\t\t\t\t\t\t\t\t\t<div class="col-8">: </div>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t\t\t\t<div class="col-3">Pekerjaan</div>\n\t\t\t\t\t\t\t\t\t<div class="col-8">: <t t-if="'occupation' in data"> <t t-esc="data['occupation']"/> </t></div>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t\t\t\t<div class="col-3">Alamat</div>\n\t\t\t\t\t\t\t\t\t<div class="col-8">: <t t-esc="o['partner_id']['street']"/></div>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t\t\t\t<div class="col-3">Status Perkawinan</div>\n\t\t\t\t\t\t\t\t\t<div class="col-8">: <t t-if="'marital-status' in data"> <t t-esc="data['marital-status']"/> </t></div>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t\t\t\t<div class="col-3">Nama Suami / Istri</div>\n\t\t\t\t\t\t\t\t\t<div class="col-8">: <t t-if="'partner' in data"> <t t-esc="data['partner']"/> </t></div>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t\t\t\t<div class="col-3">Status Pembiayaan</div>\n\t\t\t\t\t\t\t\t\t<div class="col-8">: <t t-if="'payment' in data"> <t t-esc="data['payment']"/> </t></div>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t<div style="background-color:#c1d09d; border-bottom: 1px solid black">\n\t\t\t\t\t\t\t\t<p class="text-center mb-0" style="width: 100%;">\n\t\t\t\t\t\t\t\t\t<strong>PERSETUJUAN UMUM / GENERAL CONSENT</strong>\n\t\t\t\t\t\t\t\t</p>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t<p class="text-center mt-1 mb-0" style="font-style: italic; text-decoration: underline;">\n\t\t\t\t\t\t\t\t<strong>PASIEN / WALI PASIEN HARUS MEMBACA, MEMAHAMI DAN MENGISI INFORMASI BERIKUT</strong>\n\t\t\t\t\t\t\t</p>\n\t\t\t\t\t\t\t<p class="mt-1 mb-1">Yang bertanda tangan di bawah ini, saya:</p>\n\t\t\t\t\t\t\t<div class="pl-2">\n\t\t\t\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t\t\t\t<div class="col-3">Nama Lengkap</div>\n\t\t\t\t\t\t\t\t\t<div class="col-6">:\n\t\t\t\t\t\t\t\t\t\t<strong>\n\t\t\t\t\t\t\t\t\t\t\t<t t-esc="data['nama-pj']"/>\n\t\t\t\t\t\t\t\t\t\t</strong>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<t t-if="'tgl-lahir-pj' in data">\n\t\t\t\t\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t\t\t\t\t<div class="col-3">Tempat / Tanggal Lahir</div>\n\t\t\t\t\t\t\t\t\t\t<div class="col-6">: <t t-if="'tempat-lahir-pj' in data"><t t-esc="data['tempat-lahir-pj']"/></t>/<t t-if="'tgl-lahir-pj' in data"><t t-esc="data['tgl-lahir-pj']"/></t></div>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t</t>\n\t\t\t\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t\t\t\t<div class="col-3">Alamat</div>\n\t\t\t\t\t\t\t\t\t<div class="col-6">: <t t-if="'alamat-pj' in data"><t t-esc="data['alamat-pj']"/></t></div>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t\t\t\t<div class="col-3">No. Telepon</div>\n\t\t\t\t\t\t\t\t\t<div class="col-6">: <t t-if="'telepon-pj' in data"><t t-esc="data['telepon-pj']"/></t></div>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t\t\t\t<div class="col-3">Email</div>\n\t\t\t\t\t\t\t\t\t<div class="col-6">: <t t-if="'email-pj' in data"><t t-esc="data['email-pj']"/></t></div>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<t t-if="'relasi-pj' in data">\n\t\t\t\t\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t\t\t\t\t<div class="col-3">Bertindak atas</div>\n\t\t\t\t\t\t\t\t\t\t<div class="col-6">: <t t-if="'relasi-pj' in data"><t t-esc="data['relasi-pj']"/></t></div>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t</t>\n\t\t\t\t\t\t\t\t<div>Menyatakan</div>\n\t\t\t\t\t\t\t\t<div class="pr-3" style="page-break-inside: avoid; page-break-before: auto;">\n\t\t\t\t\t\t\t\t\t<div>\n\t\t\t\t\t\t\t\t\t\t<strong>I. PERSETUJUAN UNTUK PERAWATAN DAN PENGOBATAN</strong>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t<div class="d-flex ml-3">\n\t\t\t\t\t\t\t\t\t\t<div class="pr-1">1.</div>\n\t\t\t\t\t\t\t\t\t\t<div>Saya mengetahui bahwa saya membutuhkan perawatan medis dan mengijinkan dokter/tenaga Kesehatan lainnya di fasilitas Kesehatan RS/Klinik/<t t-esc="res_company.name"/> untuk melakukan pemeriksaan dan memberikan pengobatan / tindakan/ asuhan yang sesuai prosedur</div>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t<div class="d-flex ml-3">\n\t\t\t\t\t\t\t\t\t\t<div class="pr-1">2.</div>\n\t\t\t\t\t\t\t\t\t\t<div>Saya sadar bahwa praktik kedokteran bukanlah ilmu pasti dan saya mengakui bahwa tidak ada jaminan atas hasil apapun terhadap pengobatan / Tindakan/ asuhan yang dilakukan pada saya</div>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t<div class="d-flex ml-3">\n\t\t\t\t\t\t\t\t\t\t<div class="pr-1">3.</div>\n\t\t\t\t\t\t\t\t\t\t<div class="">\n\t\t\t\t\t\t\t\t\t\t\t<p>Saya mengerti dan memahami bahwa </p>\n\t\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t<div class="d-flex ml-5 pr-3">\n\t\t\t\t\t\t\t\t\t\t<div class="pr-1">a.</div>\n\t\t\t\t\t\t\t\t\t\t<div>Saya memiliki hak untuk menyatakan persetujuan atau penolakan untuk setiap jasa perawatan medis yang akan diberikan pada saya. Saya memahani bahwa pemberian jasa yang melibatkan data pribadi saya yang saya tolak, tanpanya layanan tidak dapat diberikan, seperti pemeriksaan penyakit pasien, pemberian obat, asuhan, dan tindakan medis.</div>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t<div class="d-flex ml-5 pr-3">\n\t\t\t\t\t\t\t\t\t\t<div class="pr-1">b.</div>\n\t\t\t\t\t\t\t\t\t\t<div>Saya memiliki hak untuk mengajukan pertanyaan terkait rencana pelayanan yang akan diberikan pada saya, termasuk identitas setiap orang yang akan memberikan jasa perawatan medis.</div>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t<div class="d-flex ml-5 pr-3">\n\t\t\t\t\t\t\t\t\t\t<div class="pr-1">c.</div>\n\t\t\t\t\t\t\t\t\t\t<div>Saya memiliki hak untuk melakukan pernarikan persetujuan saat kewajiban pihak fasilitas kesehatan menyediakan layanan belum terlaksana atau saya mengubah keputusan persetujan atau penolakan yang sebelumnya saya berikan</div>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t<div class="d-flex ml-3">\n\t\t\t\t\t\t\t\t\t\t<div class="pr-1">4.</div>\n\t\t\t\t\t\t\t\t\t\t<div class="">\n\t\t\t\t\t\t\t\t\t\t\t<p>Saya menyetujui bahwa dalam keadaan darurat (atau gawat darurat) data pribadi Saya hanya akan digunakan untuk kepentingan perawatan medis. Pemrosesan data ini hanya akan dilakukan apabila cara lain tidak dapat diupayakan seperti saya yang tidak sadarkan diri atau saya yang memerlukan tindakan segera di IGD.</p>\n\t\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<div class="pr-3" style="page-break-inside: avoid; page-break-before: auto;">\n\t\t\t\t\t\t\t\t\t<div>\n\t\t\t\t\t\t\t\t\t\t<strong>II. PERSETUJUAN PELEPASAN DATA</strong>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t<div class="d-flex ml-3">\n\t\t\t\t\t\t\t\t\t\t<div class="pr-1">1.</div>\n\t\t\t\t\t\t\t\t\t\t<div>Saya memahami bahwa informasi pribadi saya terkait dengan kondisi Kesehatan saya, berdasarkan pemeriksaan yang saya jalani di fasilitas Kesehatan RS/Klinik/<t t-esc="res_company.name"/> akan terjamin kerahasiaannya</div>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t<div class="d-flex ml-3">\n\t\t\t\t\t\t\t\t\t\t<div class="pr-1">2.</div>\n\t\t\t\t\t\t\t\t\t\t<div>Saya memberikan wewenang kepada fasilitas Kesehatan RS/Klinik/<t t-esc="res_company.name"/> untuk memberikan informasi berkaitan dengan kondisi Kesehatan saya untuk keperluan proses klaim asuransi dan administrasi resmi apabila diperlukan (BPJS, Kemenkenkes, Dinkes)</div>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t<div class="d-flex ml-3">\n\t\t\t\t\t\t\t\t\t\t<div class="pr-1">3.</div>\n\t\t\t\t\t\t\t\t\t\t<div>Saya memberi wewenang akses kepada fasilitas Kesehatan RS/Klinik/<t t-esc="res_company.name"/> untuk memberikan informasi Kesehatan saya kepada pihak berikut apabila diperlukan:</div>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t<div class="d-flex- ml-5">\n\t\t\t\t\t\t\t\t\t\t<t t-if="'authorized-parties' in data">\n\t\t\t\t\t\t\t\t\t\t\t<t t-foreach="data['authorized-parties']" t-as="name">\n\t\t\t\t\t\t\t\t\t\t\t\t<div><t t-esc="name"/></div>\n\t\t\t\t\t\t\t\t\t\t\t</t>\n\t\t\t\t\t\t\t\t\t\t</t>\n\t\t\t\t\t\t\t\t\t\t<t t-else="">\n\t\t\t\t\t\t\t\t\t\t\t<div style="height: 15px;"/>\n\t\t\t\t\t\t\t\t\t\t</t>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<div class="pr-3" style="page-break-inside: avoid; page-break-before: auto;">\n\t\t\t\t\t\t\t\t\t<div>\n\t\t\t\t\t\t\t\t\t\t<strong>III. HAK DAN KEWAJIBAN PASIEN</strong>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t<div class="ml-3">Saya telah mendapatkan informasi tentang “Hak dan Kewajiban Pasien” di fasilitas Kesehatan RS/Klinik/<t t-esc="res_company.name"/> melalui informasi yang diberikan kepada saya oleh petugas yang melayani saya.</div>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<div class="pr-3" style="page-break-inside: avoid; page-break-before: auto;">\n\t\t\t\t\t\t\t\t\t<div>\n\t\t\t\t\t\t\t\t\t\t<strong>IV. INTEGRITAS DATA MEDIS</strong>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t<div class="ml-3">Saya menyetujui bahwa segala data Rekam Medis, termasuk didalamnya Kesalahan Pemasukan Data atau Pengubahan diagnosis medis, tetap akan didokumentasikan karena menjadi bagian dari rekam medis pasien bahkan setelah diagnosis saya diperbaiki. Saya memahami bahwa hal ini bertujuan menjelaskan riwayat tindakan medis yang diberikan kepada pasien, atau untuk masalah kesehatan lainnya.</div>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<div class="pr-3" style="page-break-inside: avoid; page-break-before: auto;">\n\t\t\t\t\t\t\t\t\t<div>\n\t\t\t\t\t\t\t\t\t\t<strong>V. KOMUNIKASI</strong>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t<div class="ml-3">Saya bersedia untuk dihubungi melalui alamat atau alamat email sehubungan dengan reporting hack dan kegagalan/gangguan sistem yang berdampak serius mengenai dampak serius kebocoran data pribadi agar Saya dapat mengantisipasi risiko dari peristiwa tersebut. Selain itu Saya mengijinkan pelaporan ini untuk diberikan kepada otoritas yang berwenang dan segera tanpa menunda-nunda sesuai dengan peraturan perundang-undangan yang berlaku.</div>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class="row" style="page-break-inside: avoid; page-break-before: auto;">\n\t\t\t\t\t\t<div class="col-4">\n\t\t\t\t\t\t\t<p class="pt-3">Bidan</p>\n\t\t\t\t\t\t\t<t t-if="'practitioner-sign' in data">\n\t\t\t\t\t\t\t\t<div style="width:110px;height:60px;">\n\t\t\t\t\t\t\t\t\t<img height="80" t-att-src="data['practitioner-sign']"/>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t</t>\n\t\t\t\t\t\t\t<t t-else="">\n\t\t\t\t\t\t\t\t<div style="width:110px;height:60px;"/>\n\t\t\t\t\t\t\t</t>\n\t\t\t\t\t\t\t<p class="mb-0 mt-1">\n\t\t\t\t\t\t\t\t<strong>Dian Indah Wahyuningsih, S.Tr.Keb.</strong>\n\t\t\t\t\t\t\t</p>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t<div class="col-4"/>\n\t\t\t\t\t\t<div class="col-4">\n\t\t\t\t\t\t\t<p class="mb-0"><t t-esc="o['operating_unit_id']['company_id']['city']"/>,\n\t\t\t\t\t\t\t\t<t t-esc="o.to_date_string(data['registration_date'])"/>\n\t\t\t\t\t\t\t</p>\n\t\t\t\t\t\t\t<p class="mb-0">Pasien / Wali Pasien</p>\n\t\t\t\t\t\t\t<t t-if="'sign-pj' in data">\n\t\t\t\t\t\t\t\t<div style="width:110px;height:60px;">\n\t\t\t\t\t\t\t\t\t<img height="80" t-att-src="data['sign-pj']"/>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t</t>\n\t\t\t\t\t\t\t<p class="mb-0 mt-1">\n\t\t\t\t\t\t\t\t<strong>\n\t\t\t\t\t\t\t\t\t<t t-esc="data['nama-pj']"/>\n\t\t\t\t\t\t\t\t</strong>\n\t\t\t\t\t\t\t</p>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t</t>\n\t\t</t>\n\t	ehealth_document/report/template_general_consent/report_pmbdian_general_consent.xml	\N	\N	\N	\N	primary	t	1	2025-08-28 11:34:01.364376	1	2025-08-28 11:34:01.364376	f
1602	report_pmbfatma_general_consent	\N	ehealth_document.report_pmbfatma_general_consent	16	qweb	<?xml version="1.0"?>\n<t t-name="ehealth_document.report_pmbfatma_general_consent">\n\t\t\t<t t-set="company" t-value="res_company"/>\n\t\t\t<t t-call="ehealth_document.header_pmbfatma_document">\n\t\t\t\t<div class="page mt-5" style="font-size:13px; line-height: 1.4;">\n\t\t\t\t\t<div class="row" style="border: 1px solid black">\n\t\t\t\t\t\t<div class="" style="margin-top: 80px">\n\t\t\t\t\t\t\t<div style="background-color:#c1d09d; border-bottom: 1px solid black">\n\t\t\t\t\t\t\t\t<p class="text-center mb-0" style="width: 100%;">\n\t\t\t\t\t\t\t\t\t<strong>PENGKAJIAN DATA UMUM PASIEN</strong>\n\t\t\t\t\t\t\t\t</p>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t<div class="row mt-2" style="border-bottom: 1px solid black">\n\t\t\t\t\t\t\t\t<div class="ml-3 mb-1">\n\t\t\t\t\t\t\t\t\t<p>Diisi oleh Petugas Pendaftaran pada</p>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<div class="ml-2 mb-1">\n\t\t\t\t\t\t\t\t\t<p>tanggal: <t t-if="'tgl-consent' in data"><t t-esc="data['tgl-consent']"/></t></p>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<div class="ml-5 mb-1">\n\t\t\t\t\t\t\t\t\t<p>jam: <t t-if="'waktu-consent' in data"><t t-esc="data['waktu-consent']"/></t></p>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t<div class="pl-2" style="border-bottom: 1px solid black">\n\t\t\t\t\t\t\t\t<p class="mb-0" style="font-size: 16px">\n\t\t\t\t\t\t\t\t\t<strong>IDENTITAS PASIEN</strong>\n\t\t\t\t\t\t\t\t</p>\n\t\t\t\t\t\t\t\t<p class="mb-0" style="font-style: italic;">(Diisi sesuai Kartu Tanda Pengenal Pasien yang masih berlaku; KTP/ KK/ SIM/ Kartu Pelajar/ dsb)</p>\n\t\t\t\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t\t\t\t<div class="col-3">Nomer Rekam Medis</div>\n\t\t\t\t\t\t\t\t\t<div class="col-8">: <t t-esc="data['no-cm']"/> </div>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t\t\t\t<div class="col-3">Nama</div>\n\t\t\t\t\t\t\t\t\t<div class="col-8">: <t t-esc="o['partner_id']['name']"/></div>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t\t\t\t<div class="col-3">Jenis Kelamin</div>\n\t\t\t\t\t\t\t\t\t<div class="col-8">:\n\t\t\t\t\t\t\t\t\t\t<t t-if="o['partner_id']['gender'] == 'male'">Laki-Laki</t>\n\t\t\t\t\t\t\t\t\t\t<t t-else="">Perempuan</t>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t\t\t\t<div class="col-3">Tanggal Lahir</div>\n\t\t\t\t\t\t\t\t\t<div class="col-8">: <t t-esc="o['partner_id']['birthDate'].strftime('%d-%m-%Y')"/></div>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t\t\t\t<div class="col-3">Agama</div>\n\t\t\t\t\t\t\t\t\t<div class="col-8">: <t t-if="'religion' in data"> <t t-esc="data['religion']"/> </t></div>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t\t\t\t<div class="col-3">Pendidikan</div>\n\t\t\t\t\t\t\t\t\t<div class="col-8">: </div>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t\t\t\t<div class="col-3">Pekerjaan</div>\n\t\t\t\t\t\t\t\t\t<div class="col-8">: <t t-if="'occupation' in data"> <t t-esc="data['occupation']"/> </t></div>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t\t\t\t<div class="col-3">Alamat</div>\n\t\t\t\t\t\t\t\t\t<div class="col-8">: <t t-esc="o['partner_id']['street']"/></div>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t\t\t\t<div class="col-3">Status Perkawinan</div>\n\t\t\t\t\t\t\t\t\t<div class="col-8">: <t t-if="'marital-status' in data"> <t t-esc="data['marital-status']"/> </t></div>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t\t\t\t<div class="col-3">Nama Suami / Istri</div>\n\t\t\t\t\t\t\t\t\t<div class="col-8">: <t t-if="'partner' in data"> <t t-esc="data['partner']"/> </t></div>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t\t\t\t<div class="col-3">Status Pembiayaan</div>\n\t\t\t\t\t\t\t\t\t<div class="col-8">: <t t-if="'payment' in data"> <t t-esc="data['payment']"/> </t></div>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t<div style="background-color:#c1d09d; border-bottom: 1px solid black">\n\t\t\t\t\t\t\t\t<p class="text-center mb-0" style="width: 100%;">\n\t\t\t\t\t\t\t\t\t<strong>PERSETUJUAN UMUM / GENERAL CONSENT</strong>\n\t\t\t\t\t\t\t\t</p>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t<p class="text-center mt-1 mb-0" style="font-style: italic; text-decoration: underline;">\n\t\t\t\t\t\t\t\t<strong>PASIEN / WALI PASIEN HARUS MEMBACA, MEMAHAMI DAN MENGISI INFORMASI BERIKUT</strong>\n\t\t\t\t\t\t\t</p>\n\t\t\t\t\t\t\t<p class="mt-1 mb-1">Yang bertanda tangan di bawah ini, saya:</p>\n\t\t\t\t\t\t\t<div class="pl-2">\n\t\t\t\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t\t\t\t<div class="col-3">Nama Lengkap</div>\n\t\t\t\t\t\t\t\t\t<div class="col-6">:\n\t\t\t\t\t\t\t\t\t\t<strong>\n\t\t\t\t\t\t\t\t\t\t\t<t t-esc="data['nama-pj']"/>\n\t\t\t\t\t\t\t\t\t\t</strong>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<t t-if="'tgl-lahir-pj' in data">\n\t\t\t\t\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t\t\t\t\t<div class="col-3">Tempat / Tanggal Lahir</div>\n\t\t\t\t\t\t\t\t\t\t<div class="col-6">: <t t-if="'tempat-lahir-pj' in data"><t t-esc="data['tempat-lahir-pj']"/></t>/<t t-if="'tgl-lahir-pj' in data"><t t-esc="data['tgl-lahir-pj']"/></t></div>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t</t>\n\t\t\t\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t\t\t\t<div class="col-3">Alamat</div>\n\t\t\t\t\t\t\t\t\t<div class="col-6">: <t t-if="'alamat-pj' in data"><t t-esc="data['alamat-pj']"/></t></div>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t\t\t\t<div class="col-3">No. Telepon</div>\n\t\t\t\t\t\t\t\t\t<div class="col-6">: <t t-if="'telepon-pj' in data"><t t-esc="data['telepon-pj']"/></t></div>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t\t\t\t<div class="col-3">Email</div>\n\t\t\t\t\t\t\t\t\t<div class="col-6">: <t t-if="'email-pj' in data"><t t-esc="data['email-pj']"/></t></div>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<t t-if="'relasi-pj' in data">\n\t\t\t\t\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t\t\t\t\t<div class="col-3">Bertindak atas</div>\n\t\t\t\t\t\t\t\t\t\t<div class="col-6">: <t t-if="'relasi-pj' in data"><t t-esc="data['relasi-pj']"/></t></div>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t</t>\n\t\t\t\t\t\t\t\t<div>Menyatakan</div>\n\t\t\t\t\t\t\t\t<div class="pr-3" style="page-break-inside: avoid; page-break-before: auto;">\n\t\t\t\t\t\t\t\t\t<div>\n\t\t\t\t\t\t\t\t\t\t<strong>I. PERSETUJUAN UNTUK PERAWATAN DAN PENGOBATAN</strong>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t<div class="d-flex ml-3">\n\t\t\t\t\t\t\t\t\t\t<div class="pr-1">1.</div>\n\t\t\t\t\t\t\t\t\t\t<div>Saya mengetahui bahwa saya membutuhkan perawatan medis dan mengijinkan dokter/tenaga Kesehatan lainnya di fasilitas Kesehatan RS/Klinik/<t t-esc="res_company.name"/> untuk melakukan pemeriksaan dan memberikan pengobatan / tindakan/ asuhan yang sesuai prosedur</div>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t<div class="d-flex ml-3">\n\t\t\t\t\t\t\t\t\t\t<div class="pr-1">2.</div>\n\t\t\t\t\t\t\t\t\t\t<div>Saya sadar bahwa praktik kedokteran bukanlah ilmu pasti dan saya mengakui bahwa tidak ada jaminan atas hasil apapun terhadap pengobatan / Tindakan/ asuhan yang dilakukan pada saya</div>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t<div class="d-flex ml-3">\n\t\t\t\t\t\t\t\t\t\t<div class="pr-1">3.</div>\n\t\t\t\t\t\t\t\t\t\t<div class="">\n\t\t\t\t\t\t\t\t\t\t\t<p>Saya mengerti dan memahami bahwa </p>\n\t\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t<div class="d-flex ml-5 pr-3">\n\t\t\t\t\t\t\t\t\t\t<div class="pr-1">a.</div>\n\t\t\t\t\t\t\t\t\t\t<div>Saya memiliki hak untuk menyatakan persetujuan atau penolakan untuk setiap jasa perawatan medis yang akan diberikan pada saya. Saya memahani bahwa pemberian jasa yang melibatkan data pribadi saya yang saya tolak, tanpanya layanan tidak dapat diberikan, seperti pemeriksaan penyakit pasien, pemberian obat, asuhan, dan tindakan medis.</div>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t<div class="d-flex ml-5 pr-3">\n\t\t\t\t\t\t\t\t\t\t<div class="pr-1">b.</div>\n\t\t\t\t\t\t\t\t\t\t<div>Saya memiliki hak untuk mengajukan pertanyaan terkait rencana pelayanan yang akan diberikan pada saya, termasuk identitas setiap orang yang akan memberikan jasa perawatan medis.</div>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t<div class="d-flex ml-5 pr-3">\n\t\t\t\t\t\t\t\t\t\t<div class="pr-1">c.</div>\n\t\t\t\t\t\t\t\t\t\t<div>Saya memiliki hak untuk melakukan pernarikan persetujuan saat kewajiban pihak fasilitas kesehatan menyediakan layanan belum terlaksana atau saya mengubah keputusan persetujan atau penolakan yang sebelumnya saya berikan</div>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t<div class="d-flex ml-3">\n\t\t\t\t\t\t\t\t\t\t<div class="pr-1">4.</div>\n\t\t\t\t\t\t\t\t\t\t<div class="">\n\t\t\t\t\t\t\t\t\t\t\t<p>Saya menyetujui bahwa dalam keadaan darurat (atau gawat darurat) data pribadi Saya hanya akan digunakan untuk kepentingan perawatan medis. Pemrosesan data ini hanya akan dilakukan apabila cara lain tidak dapat diupayakan seperti saya yang tidak sadarkan diri atau saya yang memerlukan tindakan segera di IGD.</p>\n\t\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<div class="pr-3" style="page-break-inside: avoid; page-break-before: auto;">\n\t\t\t\t\t\t\t\t\t<div>\n\t\t\t\t\t\t\t\t\t\t<strong>II. PERSETUJUAN PELEPASAN DATA</strong>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t<div class="d-flex ml-3">\n\t\t\t\t\t\t\t\t\t\t<div class="pr-1">1.</div>\n\t\t\t\t\t\t\t\t\t\t<div>Saya memahami bahwa informasi pribadi saya terkait dengan kondisi Kesehatan saya, berdasarkan pemeriksaan yang saya jalani di fasilitas Kesehatan RS/Klinik/<t t-esc="res_company.name"/> akan terjamin kerahasiaannya</div>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t<div class="d-flex ml-3">\n\t\t\t\t\t\t\t\t\t\t<div class="pr-1">2.</div>\n\t\t\t\t\t\t\t\t\t\t<div>Saya memberikan wewenang kepada fasilitas Kesehatan RS/Klinik/<t t-esc="res_company.name"/> untuk memberikan informasi berkaitan dengan kondisi Kesehatan saya untuk keperluan proses klaim asuransi dan administrasi resmi apabila diperlukan (BPJS, Kemenkenkes, Dinkes)</div>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t<div class="d-flex ml-3">\n\t\t\t\t\t\t\t\t\t\t<div class="pr-1">3.</div>\n\t\t\t\t\t\t\t\t\t\t<div>Saya memberi wewenang akses kepada fasilitas Kesehatan RS/Klinik/<t t-esc="res_company.name"/> untuk memberikan informasi Kesehatan saya kepada pihak berikut apabila diperlukan:</div>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t<div class="d-flex- ml-5">\n\t\t\t\t\t\t\t\t\t\t<t t-if="'authorized-parties' in data">\n\t\t\t\t\t\t\t\t\t\t\t<t t-foreach="data['authorized-parties']" t-as="name">\n\t\t\t\t\t\t\t\t\t\t\t\t<div><t t-esc="name"/></div>\n\t\t\t\t\t\t\t\t\t\t\t</t>\n\t\t\t\t\t\t\t\t\t\t</t>\n\t\t\t\t\t\t\t\t\t\t<t t-else="">\n\t\t\t\t\t\t\t\t\t\t\t<div style="height: 15px;"/>\n\t\t\t\t\t\t\t\t\t\t</t>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<div class="pr-3" style="page-break-inside: avoid; page-break-before: auto;">\n\t\t\t\t\t\t\t\t\t<div>\n\t\t\t\t\t\t\t\t\t\t<strong>III. HAK DAN KEWAJIBAN PASIEN</strong>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t<div class="ml-3">Saya telah mendapatkan informasi tentang “Hak dan Kewajiban Pasien” di fasilitas Kesehatan RS/Klinik/<t t-esc="res_company.name"/> melalui informasi yang diberikan kepada saya oleh petugas yang melayani saya.</div>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<div class="pr-3" style="page-break-inside: avoid; page-break-before: auto;">\n\t\t\t\t\t\t\t\t\t<div>\n\t\t\t\t\t\t\t\t\t\t<strong>IV. INTEGRITAS DATA MEDIS</strong>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t<div class="ml-3">Saya menyetujui bahwa segala data Rekam Medis, termasuk didalamnya Kesalahan Pemasukan Data atau Pengubahan diagnosis medis, tetap akan didokumentasikan karena menjadi bagian dari rekam medis pasien bahkan setelah diagnosis saya diperbaiki. Saya memahami bahwa hal ini bertujuan menjelaskan riwayat tindakan medis yang diberikan kepada pasien, atau untuk masalah kesehatan lainnya.</div>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<div class="pr-3" style="page-break-inside: avoid; page-break-before: auto;">\n\t\t\t\t\t\t\t\t\t<div>\n\t\t\t\t\t\t\t\t\t\t<strong>V. KOMUNIKASI</strong>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t<div class="ml-3">Saya bersedia untuk dihubungi melalui alamat atau alamat email sehubungan dengan reporting hack dan kegagalan/gangguan sistem yang berdampak serius mengenai dampak serius kebocoran data pribadi agar Saya dapat mengantisipasi risiko dari peristiwa tersebut. Selain itu Saya mengijinkan pelaporan ini untuk diberikan kepada otoritas yang berwenang dan segera tanpa menunda-nunda sesuai dengan peraturan perundang-undangan yang berlaku.</div>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class="row" style="page-break-inside: avoid; page-break-before: auto;">\n\t\t\t\t\t\t<div class="col-4">\n\t\t\t\t\t\t\t<p class="pt-3">Bidan</p>\n\t\t\t\t\t\t\t<t t-if="'practitioner-sign' in data">\n\t\t\t\t\t\t\t\t<div style="width:110px;height:60px;">\n\t\t\t\t\t\t\t\t\t<img height="80" t-att-src="data['practitioner-sign']"/>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t</t>\n\t\t\t\t\t\t\t<t t-else="">\n\t\t\t\t\t\t\t\t<div style="width:110px;height:60px;"/>\n\t\t\t\t\t\t\t</t>\n\t\t\t\t\t\t\t<p class="mb-0 mt-1">\n\t\t\t\t\t\t\t\t<strong>Dian Indah Wahyuningsih, S.Tr.Keb.</strong>\n\t\t\t\t\t\t\t</p>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t<div class="col-4"/>\n\t\t\t\t\t\t<div class="col-4">\n\t\t\t\t\t\t\t<p class="mb-0"><t t-esc="o['operating_unit_id']['company_id']['city']"/>,\n\t\t\t\t\t\t\t\t<t t-esc="o.to_date_string(data['registration_date'])"/>\n\t\t\t\t\t\t\t</p>\n\t\t\t\t\t\t\t<p class="mb-0">Pasien / Wali Pasien</p>\n\t\t\t\t\t\t\t<t t-if="'sign-pj' in data">\n\t\t\t\t\t\t\t\t<div style="width:110px;height:60px;">\n\t\t\t\t\t\t\t\t\t<img height="80" t-att-src="data['sign-pj']"/>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t</t>\n\t\t\t\t\t\t\t<p class="mb-0 mt-1">\n\t\t\t\t\t\t\t\t<strong>\n\t\t\t\t\t\t\t\t\t<t t-esc="data['nama-pj']"/>\n\t\t\t\t\t\t\t\t</strong>\n\t\t\t\t\t\t\t</p>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t</t>\n\t\t</t>\n\t	ehealth_document/report/template_general_consent/report_pmbfatma_general_consent.xml	\N	\N	\N	\N	primary	t	1	2025-08-28 11:34:01.364376	1	2025-08-28 11:34:01.364376	f
1603	report_biomedilab_general_consent	\N	ehealth_document.report_biomedilab_general_consent	16	qweb	<?xml version="1.0"?>\n<t t-name="ehealth_document.report_biomedilab_general_consent">\n\t\t\t<t t-set="company" t-value="res_company"/>\n\t\t\t<t t-call="web.external_layout">\n\t\t\t\t<t t-set="o" t-value="o.with_context(lang=lang)"/> \n\t\t\t\t<div class="page" style="font-size:13px; line-height: 1.4;">\n\t\t\t\t\t<div class="row" style="border: 1px solid black">\n\t\t\t\t\t\t<div class="">\n\t\t\t\t\t\t\t<div style="background-color:#c1d09d; border-bottom: 1px solid black">\n\t\t\t\t\t\t\t\t<p class="text-center mb-0" style="width: 100%;">\n\t\t\t\t\t\t\t\t\t<strong>PENGKAJIAN DATA UMUM PASIEN</strong>\n\t\t\t\t\t\t\t\t</p>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t<div class="row mt-2" style="border-bottom: 1px solid black">\n\t\t\t\t\t\t\t\t<div class="ml-3 mb-1">\n\t\t\t\t\t\t\t\t\t<p>Diisi oleh Petugas Pendaftaran pada</p>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<div class="ml-2 mb-1">\n\t\t\t\t\t\t\t\t\t<p>tanggal: <t t-if="'tgl-consent' in data"><t t-esc="data['tgl-consent']"/></t></p>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<div class="ml-5 mb-1">\n\t\t\t\t\t\t\t\t\t<p>jam: <t t-if="'waktu-consent' in data"><t t-esc="data['waktu-consent']"/></t></p>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t<div class="pl-2" style="border-bottom: 1px solid black">\n\t\t\t\t\t\t\t\t<p class="mb-0" style="font-size: 16px">\n\t\t\t\t\t\t\t\t\t<strong>IDENTITAS PASIEN</strong>\n\t\t\t\t\t\t\t\t</p>\n\t\t\t\t\t\t\t\t<p class="mb-0" style="font-style: italic;">(Diisi sesuai Kartu Tanda Pengenal Pasien yang masih berlaku; KTP/ KK/ SIM/ Kartu Pelajar/ dsb)</p>\n\t\t\t\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t\t\t\t<div class="col-3">Nomer Rekam Medis</div>\n\t\t\t\t\t\t\t\t\t<div class="col-8">: <t t-esc="data['no-cm']"/> </div>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t\t\t\t<div class="col-3">Nama</div>\n\t\t\t\t\t\t\t\t\t<div class="col-8">: <t t-esc="o['partner_id']['name']"/></div>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t\t\t\t<div class="col-3">Jenis Kelamin</div>\n\t\t\t\t\t\t\t\t\t<div class="col-8">:\n\t\t\t\t\t\t\t\t\t\t<t t-if="o['partner_id']['gender'] == 'male'">Laki-Laki</t>\n\t\t\t\t\t\t\t\t\t\t<t t-else="">Perempuan</t>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t\t\t\t<div class="col-3">Tanggal Lahir</div>\n\t\t\t\t\t\t\t\t\t<div class="col-8">: <t t-esc="o['partner_id']['birthDate'].strftime('%d-%m-%Y')"/></div>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t\t\t\t<div class="col-3">Agama</div>\n\t\t\t\t\t\t\t\t\t<div class="col-8">: <t t-if="'religion' in data"> <t t-esc="data['religion']"/> </t></div>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t\t\t\t<div class="col-3">Pendidikan</div>\n\t\t\t\t\t\t\t\t\t<div class="col-8">: </div>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t\t\t\t<div class="col-3">Pekerjaan</div>\n\t\t\t\t\t\t\t\t\t<div class="col-8">: <t t-if="'occupation' in data"> <t t-esc="data['occupation']"/> </t></div>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t\t\t\t<div class="col-3">Alamat</div>\n\t\t\t\t\t\t\t\t\t<div class="col-8">: <t t-esc="o['partner_id']['street']"/></div>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t\t\t\t<div class="col-3">Status Perkawinan</div>\n\t\t\t\t\t\t\t\t\t<div class="col-8">: <t t-if="'marital-status' in data"> <t t-esc="data['marital-status']"/> </t></div>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t\t\t\t<div class="col-3">Nama Suami / Istri</div>\n\t\t\t\t\t\t\t\t\t<div class="col-8">: <t t-if="'partner' in data"> <t t-esc="data['partner']"/> </t></div>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t\t\t\t<div class="col-3">Status Pembiayaan</div>\n\t\t\t\t\t\t\t\t\t<div class="col-8">: <t t-if="'payment' in data"> <t t-esc="data['payment']"/> </t></div>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t<div style="background-color:#c1d09d; border-bottom: 1px solid black">\n\t\t\t\t\t\t\t\t<p class="text-center mb-0" style="width: 100%;">\n\t\t\t\t\t\t\t\t\t<strong>PERSETUJUAN UMUM / GENERAL CONSENT</strong>\n\t\t\t\t\t\t\t\t</p>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t<p class="text-center mt-1 mb-0" style="font-style: italic; text-decoration: underline;">\n\t\t\t\t\t\t\t\t<strong>PASIEN / WALI PASIEN HARUS MEMBACA, MEMAHAMI DAN MENGISI INFORMASI BERIKUT</strong>\n\t\t\t\t\t\t\t</p>\n\t\t\t\t\t\t\t<p class="mt-1 mb-1">Yang bertanda tangan di bawah ini, saya:</p>\n\t\t\t\t\t\t\t<div class="pl-2">\n\t\t\t\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t\t\t\t<div class="col-3">Nama Lengkap</div>\n\t\t\t\t\t\t\t\t\t<div class="col-6">:\n\t\t\t\t\t\t\t\t\t\t<strong>\n\t\t\t\t\t\t\t\t\t\t\t<t t-esc="data['nama-pj']"/>\n\t\t\t\t\t\t\t\t\t\t</strong>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<t t-if="'tgl-lahir-pj' in data">\n\t\t\t\t\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t\t\t\t\t<div class="col-3">Tempat / Tanggal Lahir</div>\n\t\t\t\t\t\t\t\t\t\t<div class="col-6">: <t t-if="'tempat-lahir-pj' in data"><t t-esc="data['tempat-lahir-pj']"/></t>/<t t-if="'tgl-lahir-pj' in data"><t t-esc="data['tgl-lahir-pj']"/></t></div>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t</t>\n\t\t\t\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t\t\t\t<div class="col-3">Alamat</div>\n\t\t\t\t\t\t\t\t\t<div class="col-6">: <t t-if="'alamat-pj' in data"><t t-esc="data['alamat-pj']"/></t></div>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t\t\t\t<div class="col-3">No. Telepon</div>\n\t\t\t\t\t\t\t\t\t<div class="col-6">: <t t-if="'telepon-pj' in data"><t t-esc="data['telepon-pj']"/></t></div>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t\t\t\t<div class="col-3">Email</div>\n\t\t\t\t\t\t\t\t\t<div class="col-6">: <t t-if="'email-pj' in data"><t t-esc="data['email-pj']"/></t></div>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<t t-if="'relasi-pj' in data">\n\t\t\t\t\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t\t\t\t\t<div class="col-3">Bertindak atas</div>\n\t\t\t\t\t\t\t\t\t\t<div class="col-6">: <t t-if="'relasi-pj' in data"><t t-esc="data['relasi-pj']"/></t></div>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t</t>\n\t\t\t\t\t\t\t\t<div>Menyatakan</div>\n\t\t\t\t\t\t\t\t<div class="pr-3" style="page-break-inside: avoid; page-break-before: auto;">\n\t\t\t\t\t\t\t\t\t<div>\n\t\t\t\t\t\t\t\t\t\t<strong>I. PERSETUJUAN UNTUK PERAWATAN DAN PENGOBATAN</strong>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t<div class="d-flex ml-3">\n\t\t\t\t\t\t\t\t\t\t<div class="pr-1">1.</div>\n\t\t\t\t\t\t\t\t\t\t<div>Saya mengetahui bahwa saya membutuhkan perawatan medis dan mengijinkan dokter/tenaga Kesehatan lainnya di fasilitas Kesehatan RS/Klinik/<t t-esc="res_company.name"/> untuk melakukan pemeriksaan dan memberikan pengobatan / tindakan/ asuhan yang sesuai prosedur</div>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t<div class="d-flex ml-3">\n\t\t\t\t\t\t\t\t\t\t<div class="pr-1">2.</div>\n\t\t\t\t\t\t\t\t\t\t<div>Saya sadar bahwa praktik kedokteran bukanlah ilmu pasti dan saya mengakui bahwa tidak ada jaminan atas hasil apapun terhadap pengobatan / Tindakan/ asuhan yang dilakukan pada saya</div>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t<div class="d-flex ml-3">\n\t\t\t\t\t\t\t\t\t\t<div class="pr-1">3.</div>\n\t\t\t\t\t\t\t\t\t\t<div class="">\n\t\t\t\t\t\t\t\t\t\t\t<p>Saya mengerti dan memahami bahwa </p>\n\t\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t<div class="d-flex ml-5 pr-3">\n\t\t\t\t\t\t\t\t\t\t<div class="pr-1">a.</div>\n\t\t\t\t\t\t\t\t\t\t<div>Saya memiliki hak untuk menyatakan persetujuan atau penolakan untuk setiap jasa perawatan medis yang akan diberikan pada saya. Saya memahani bahwa pemberian jasa yang melibatkan data pribadi saya yang saya tolak, tanpanya layanan tidak dapat diberikan, seperti pemeriksaan penyakit pasien, pemberian obat, asuhan, dan tindakan medis.</div>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t<div class="d-flex ml-5 pr-3">\n\t\t\t\t\t\t\t\t\t\t<div class="pr-1">b.</div>\n\t\t\t\t\t\t\t\t\t\t<div>Saya memiliki hak untuk mengajukan pertanyaan terkait rencana pelayanan yang akan diberikan pada saya, termasuk identitas setiap orang yang akan memberikan jasa perawatan medis.</div>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t<div class="d-flex ml-5 pr-3">\n\t\t\t\t\t\t\t\t\t\t<div class="pr-1">c.</div>\n\t\t\t\t\t\t\t\t\t\t<div>Saya memiliki hak untuk melakukan pernarikan persetujuan saat kewajiban pihak fasilitas kesehatan menyediakan layanan belum terlaksana atau saya mengubah keputusan persetujan atau penolakan yang sebelumnya saya berikan</div>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t<div class="d-flex ml-3">\n\t\t\t\t\t\t\t\t\t\t<div class="pr-1">4.</div>\n\t\t\t\t\t\t\t\t\t\t<div class="">\n\t\t\t\t\t\t\t\t\t\t\t<p>Saya menyetujui bahwa dalam keadaan darurat (atau gawat darurat) data pribadi Saya hanya akan digunakan untuk kepentingan perawatan medis. Pemrosesan data ini hanya akan dilakukan apabila cara lain tidak dapat diupayakan seperti saya yang tidak sadarkan diri atau saya yang memerlukan tindakan segera di IGD.</p>\n\t\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<div class="pr-3" style="page-break-inside: avoid; page-break-before: auto;">\n\t\t\t\t\t\t\t\t\t<div>\n\t\t\t\t\t\t\t\t\t\t<strong>II. PERSETUJUAN PELEPASAN DATA</strong>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t<div class="d-flex ml-3">\n\t\t\t\t\t\t\t\t\t\t<div class="pr-1">1.</div>\n\t\t\t\t\t\t\t\t\t\t<div>Saya memahami bahwa informasi pribadi saya terkait dengan kondisi Kesehatan saya, berdasarkan pemeriksaan yang saya jalani di fasilitas Kesehatan RS/Klinik/<t t-esc="res_company.name"/> akan terjamin kerahasiaannya</div>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t<div class="d-flex ml-3">\n\t\t\t\t\t\t\t\t\t\t<div class="pr-1">2.</div>\n\t\t\t\t\t\t\t\t\t\t<div>Saya memberikan wewenang kepada fasilitas Kesehatan RS/Klinik/<t t-esc="res_company.name"/> untuk memberikan informasi berkaitan dengan kondisi Kesehatan saya untuk keperluan proses klaim asuransi dan administrasi resmi apabila diperlukan (BPJS, Kemenkenkes, Dinkes)</div>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t<div class="d-flex ml-3">\n\t\t\t\t\t\t\t\t\t\t<div class="pr-1">3.</div>\n\t\t\t\t\t\t\t\t\t\t<div>Saya memberi wewenang akses kepada fasilitas Kesehatan RS/Klinik/<t t-esc="res_company.name"/> untuk memberikan informasi Kesehatan saya kepada pihak berikut apabila diperlukan:</div>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t<div class="d-flex- ml-5">\n\t\t\t\t\t\t\t\t\t\t<t t-if="'authorized-parties' in data">\n\t\t\t\t\t\t\t\t\t\t\t<t t-foreach="data['authorized-parties']" t-as="name">\n\t\t\t\t\t\t\t\t\t\t\t\t<div><t t-esc="name"/></div>\n\t\t\t\t\t\t\t\t\t\t\t</t>\n\t\t\t\t\t\t\t\t\t\t</t>\n\t\t\t\t\t\t\t\t\t\t<t t-else="">\n\t\t\t\t\t\t\t\t\t\t\t<div style="height: 15px;"/>\n\t\t\t\t\t\t\t\t\t\t</t>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<div class="pr-3" style="page-break-inside: avoid; page-break-before: auto;">\n\t\t\t\t\t\t\t\t\t<div>\n\t\t\t\t\t\t\t\t\t\t<strong>III. HAK DAN KEWAJIBAN PASIEN</strong>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t<div class="ml-3">\n\t\t\t\t\t\t\t\t\t\t<div class="mb-2">Saya telah mendapatkan informasi dan sudah memahami tentang “Hak dan Kewajiban Pasien” di fasilitas Kesehatan RS/Klinik/<t t-esc="res_company.name"/> melalui informasi yang diberikan kepada saya oleh petugas yang melayani saya.</div>\n\t\t\t\t\t\t\t\t\t\t<div class="content">\n\t\t\t\t\t\t\t\t\t\t\t<div>Hak Pasien</div>\n\t\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t\t<ol class="sub-content">\n\t\t\t\t\t\t\t\t\t\t\t<li>Mendapatkan informasi mengenai kesehatan dirinya.</li>\n\t\t\t\t\t\t\t\t\t\t\t<li>Mendapatkan penjelasan yang memadai mengenai pelayanan kesehatan yang diterimanya.</li>\n\t\t\t\t\t\t\t\t\t\t\t<li>Mendapatkan pelayanan kesehatan sesuai dengan kebutuhan medis, standar profesi, dan pelayanan yang bermutu.</li>\n\t\t\t\t\t\t\t\t\t\t\t<li>Menolak atau menyetujui tindakan medis, kecuali untuk tindakan medis yang diperlukan dalam rangka pencegahan penyakit menular dan penanggulangan KLB atau wabah.</li>\n\t\t\t\t\t\t\t\t\t\t\t<li>Mendapatkan akses terhadap informasi yang terdapat di dalam rekam medis.</li>\n\t\t\t\t\t\t\t\t\t\t\t<li>Meminta pendapat tenaga medis atau tenaga kesehatan lain.</li>\n\t\t\t\t\t\t\t\t\t\t\t<li>Mendapatkan hak lain sesuai dengan ketentuan peraturan perundang-undangan.</li>\n\t\t\t\t\t\t\t\t\t\t</ol> \n\t\t\t\t\t\t\t\t\t\t<div class="content">\n\t\t\t\t\t\t\t\t\t\t\t<div>Kewajiban Pasien</div>\n\t\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t\t<ol class="sub-content">\n\t\t\t\t\t\t\t\t\t\t\t<li>Memberikan informasi yang lengkap dan jujur tentang masalah kesehatannya.</li>\n\t\t\t\t\t\t\t\t\t\t\t<li>Mematuhi nasihat dan petunjuk tenaga medis dan tenaga kesehatan.</li>\n\t\t\t\t\t\t\t\t\t\t\t<li>Mematuhi ketentuan yang berlaku pada fasilitas pelayanan kesehatan.</li>\n\t\t\t\t\t\t\t\t\t\t\t<li>Memberikan imbalan jasa atas pelayanan yang diterima.</li>\n\t\t\t\t\t\t\t\t\t\t</ol>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<div class="pr-3" style="page-break-inside: avoid; page-break-before: auto;">\n\t\t\t\t\t\t\t\t\t<div>\n\t\t\t\t\t\t\t\t\t\t<strong>IV. INTEGRITAS DATA MEDIS</strong>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t<div class="ml-3">Saya menyetujui bahwa segala data Rekam Medis, termasuk didalamnya Kesalahan Pemasukan Data atau Pengubahan diagnosis medis, tetap akan didokumentasikan karena menjadi bagian dari rekam medis pasien bahkan setelah diagnosis saya diperbaiki. Saya memahami bahwa hal ini bertujuan menjelaskan riwayat tindakan medis yang diberikan kepada pasien, atau untuk masalah kesehatan lainnya.</div>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<div class="pr-3" style="page-break-inside: avoid; page-break-before: auto;">\n\t\t\t\t\t\t\t\t\t<div>\n\t\t\t\t\t\t\t\t\t\t<strong>V. KOMUNIKASI</strong>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t<div class="ml-3">Saya bersedia untuk dihubungi melalui alamat atau alamat email sehubungan dengan reporting hack dan kegagalan/gangguan sistem yang berdampak serius mengenai dampak serius kebocoran data pribadi agar Saya dapat mengantisipasi risiko dari peristiwa tersebut. Selain itu Saya mengijinkan pelaporan ini untuk diberikan kepada otoritas yang berwenang dan segera tanpa menunda-nunda sesuai dengan peraturan perundang-undangan yang berlaku.</div>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class="row" style="page-break-inside: avoid; page-break-before: auto;">\n\t\t\t\t\t\t<div class="col-4">\n\t\t\t\t\t\t\t<p class="pt-3">Petugas</p>\n\t\t\t\t\t\t\t<t t-if="'practitioner-sign' in data">\n\t\t\t\t\t\t\t\t<div style="width:110px;height:60px;">\n\t\t\t\t\t\t\t\t\t<img height="80" t-att-src="data['practitioner-sign']"/>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t</t>\n\t\t\t\t\t\t\t<t t-else="">\n\t\t\t\t\t\t\t\t<div style="width:110px;height:60px;"/>\n\t\t\t\t\t\t\t</t>\n\t\t\t\t\t\t\t<p class="mb-0 mt-1">\n\t\t\t\t\t\t\t\t<t t-if="'practitioner-name' in data">\n\t\t\t\t\t\t\t\t\t<strong>\n\t\t\t\t\t\t\t\t\t\t<t t-esc="data['practitioner-name']"/>\n\t\t\t\t\t\t\t\t\t</strong>\n\t\t\t\t\t\t\t\t</t>\n\t\t\t\t\t\t\t\t<t t-elif="'examiner_name' in data">\n\t\t\t\t\t\t\t\t\t<strong>\n\t\t\t\t\t\t\t\t\t\t<t t-esc="data['examiner_name']"/>\n\t\t\t\t\t\t\t\t\t</strong>\n\t\t\t\t\t\t\t\t</t>\n\t\t\t\t\t\t\t\t<t t-else="">\n\t\t\t\t\t\t\t\t\t<strong>\n\t\t\t\t\t\t\t\t\t\t<t t-esc="data['sender']"/>\n\t\t\t\t\t\t\t\t\t</strong>\n\t\t\t\t\t\t\t\t</t>\n\t\t\t\t\t\t\t</p>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t<div class="col-4"/>\n\t\t\t\t\t\t<div class="col-4">\n\t\t\t\t\t\t\t<p class="mb-0"><t t-esc="o['operating_unit_id']['company_id']['city']"/>,\n\t\t\t\t\t\t\t\t<t t-esc="o.to_date_string(data['registration_date'])"/>\n\t\t\t\t\t\t\t</p>\n\t\t\t\t\t\t\t<p class="mb-0">Pasien / Wali Pasien</p>\n\t\t\t\t\t\t\t<t t-if="'sign-pj' in data">\n\t\t\t\t\t\t\t\t<div style="width:110px;height:60px;">\n\t\t\t\t\t\t\t\t\t<img height="80" t-att-src="data['sign-pj']"/>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t</t>\n\t\t\t\t\t\t\t<p class="mb-0 mt-1">\n\t\t\t\t\t\t\t\t<strong>\n\t\t\t\t\t\t\t\t\t<t t-esc="data['nama-pj']"/>\n\t\t\t\t\t\t\t\t</strong>\n\t\t\t\t\t\t\t</p>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t</t>\n\t\t</t>\n\t	ehealth_document/report/template_general_consent/report_biomedilab_general_consent.xml	\N	\N	\N	\N	primary	t	1	2025-08-28 11:34:01.364376	1	2025-08-28 11:34:01.364376	f

ferences">\n                                <group>\n                                    <group string="Localization" name="preferences">\n                                        <field name="active" invisible="1"/>\n                                        <label for="lang"/>\n                                        <div class="o_row">\n                                            <field name="lang" required="1"/>\n                                            <button type="action" name="53" class="btn-sm btn-link mb4 fa fa-globe" aria-label="More languages" title="More languages"/>\n                                        </div>\n                                        <field name="tz" widget="timezone_mismatch" options="{'tz_offset_field': 'tz_offset'}"/>\n                                        <field name="tz_offset" invisible="1"/>\n                                    </group>\n                                    <group string="Menus Customization" groups="base.group_no_one">\n                                        <field name="action_id"/>\n                                    </group>\n                                </group>\n                                <group name="messaging">\n                                    <field name="signature" options="{'style-inline': true}"/>\n                                </group>\n                            </page>\n                        </notebook>\n                    </sheet>\n                </form>\n            	base/views/res_users_views.xml	\N	\N	\N	\N	primary	t	1	2025-08-28 11:31:39.100786	1	2025-08-28 11:31:39.100786	\N

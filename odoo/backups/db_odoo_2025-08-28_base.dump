491	res.partner.product.property.form.inherit	res.partner	\N	16	form	<?xml version="1.0"?>\n<group name="sale">\n                    <field name="property_product_pricelist" groups="product.group_product_pricelist" attrs="{'invisible': [('is_company','=',False),('parent_id','!=',False)]}"/>\n                    <div name="parent_pricelists" groups="product.group_product_pricelist" colspan="2" attrs="{'invisible': ['|',('is_company','=',True),('parent_id','=',False)]}">\n                        <p>Pricelists are managed on <button name="open_commercial_entity" type="object" string="the parent company" class="oe_link"/></p>\n                    </div>\n                </group>\n            	product/views/res_partner_views.xml	\N	\N	118	\N	extension	t	1	2025-08-28 11:32:18.663929	1	2025-08-28 11:32:18.663929	\N
492	report_simple_label	\N	product.report_simple_label	16	qweb	<?xml version="1.0"?>\n<t t-name="product.report_simple_label">\n            <div style="width: 32%; display: inline-table; height:14rem;">\n                <table class="table table-bordered mb-0" style="border: 2px solid black;">\n                    <tr>\n                        <th class="table-active text-left" style="height: 4rem;">\n                            <strong t-field="product.display_name"/>\n                        </th>\n                    </tr>\n                    <tr>\n                        <td style="height: 2rem">\n                            <strong>Price:</strong>\n                            <strong t-field="product.lst_price" t-options="{'widget': 'monetary', 'display_currency': product.company_id.currency_id}"/>\n                        </td>\n                    </tr>\n                    <tr>\n                        <td class="text-center align-middle" style="height: 6rem">\n                            <t t-if="product.barcode">\n                                <img alt="Barcode" t-if="len(product.barcode) == 13" t-att-src="'/report/barcode/?type=%s&amp;value=%s&amp;width=%s&amp;height=%s' % ('EAN13', quote_plus(product.barcode or ''), 600, 150)" style="width:100%;height::4rem;"/>\n                                <img alt="Barcode" t-elif="len(product.barcode) == 8" t-att-src="'/report/barcode/?type=%s&amp;value=%s&amp;width=%s&amp;height=%s' % ('EAN8', quote_plus(product.barcode or ''), 600, 150)" style="width:100%;height::4rem;"/>\n                                <img alt="Barcode" t-else="" t-att-src="'/report/barcode/?type=%s&amp;value=%s&amp;width=%s&amp;height=%s' % ('Code128', quote_plus(product.barcode or ''), 600, 150)" style="width:100%;height::4rem;"/>\n                                <span t-field="product.barcode"/>\n                            </t>\n                            <t t-else=""><span class="text-muted">No barcode available</span></t>\n                        </td>\n                    </tr>\n                </table>\n            </div>\n        </t>\n\n        	product/report/product_product_templates.xml	\N	\N	\N	\N	primary	t	1	2025-08-28 11:32:18.663929	1	2025-08-28 11:32:18.663929	\N
1515	template_invoice_sahabat_keluarga_A5	\N	ehealth_document.template_invoice_sahabat_keluarga_A5	16	qweb	<?xml version="1.0"?>\n<t t-name="ehealth_document.template_invoice_sahabat_keluarga_A5">\n            <t t-call="web.html_container">\n              <div class="header mb-0" t-att-style="report_header_style">\n                <div class="row" style="width: 100%; display: flex; min-height: 100px;">\n                  <!-- Kiri: Logo -->\n                  <div style="width: 20%;">\n                    <img t-att-src="'/ehealth_document/static/src/img/logo_sahabatkeluarga_invoice.png'" style="max-height: 150px;" alt="Logo"/>\n                  </div>\n\n                  <!-- Tengah: Alamat -->\n                  <div class="pt-4" style="width: 60%; display: flex; justify-content: center; align-items: center; text-align: center;">\n                    <div>\n                      <div style="font-size: 24px; font-weight: bold;">\n                        KLINIK UTAMA &amp; HEMODIALISA SAHABAT KELUARGA\n                      </div>\n                      <div style="font-size: 18px; line-height: 1.6;">\n                        Jl. Pangkalan Jati I No. 75, Cinere, Depok<br/>\n                        Telp: 021-75900018, +6285100976276 Fax: 021-75907964<br/>\n                        Email: kurjsahabatkeluarga@yahoo.com\n                      </div>\n                    </div>\n                  </div>\n\n                  <!-- Kanan: KUITANSI -->\n                  <div style="width: 20%; display: flex; justify-content: center; align-items: center; text-align: center; padding-top:95px">\n                    <div>\n                      <div style="font-size: 32px; font-weight: 900;">\n                        KUITANSI\n                      </div>\n                    </div>\n                  </div>\n                </div>\n                <div class="pt-4" style="border-bottom: 3px solid #000; width: 100%;"/>\n                <div style="border-bottom: 1px solid #000; width: 100%; padding-top: 1px"/>\n              </div>\n\n              \n              <div class="article" t-att-data-oe-model="o and o._name" t-att-data-oe-id="o and o.id" t-att-data-oe-lang="o and o.env.context.get('lang')">\n                <div class="page">\n                    <!-- KWITANSI SECTION ONLY -->\n                    <div class="row" style="margin-top: 38px; padding-top: 20px; padding-left: 30px">\n                      <div class="col-12" style="font-size: 18px; line-height:2;">\n                        <table style="border: none; width: 100%; table-layout: fixed; mergin-top: 20px">\n                          <colgroup>\n                            <col style="width: 200px;"/>\n                            <col style="width: 20px;"/>\n                            <col style="width: auto;"/>\n                          </colgroup>\n                          <tr>\n                            <td style="vertical-align: top;">Telah terima dari</td>\n                            <td style="vertical-align: top;">:</td>\n                            <td style="vertical-align: top;"> \n                            <span t-esc="o['partner_id']['name']"/></td>\n                          </tr>\n                          <tr>\n                            <td style="vertical-align: top;">Sejumlah</td>\n                            <td style="vertical-align: top;">:</td>\n                            <td style="vertical-align: top;">\n                            Rp. <t t-esc="'{:,.0f}'.format(o.amount_total).replace(',', 'X').replace('.', ',').replace('X', '.')"/></td>\n                          </tr>\n                          <tr>\n                            <td style="vertical-align: top;">Terbilang</td>\n                            <td style="vertical-align: top;">:</td>\n                            <td style="vertical-align: top;">\n                              <t t-set="terbilang" t-value="o.currency_id.with_context(lang='id_ID').amount_to_text(int(o.amount_total))"/>\n                              <span t-esc="terbilang if terbilang and not terbilang.isdigit() else ''"/>\n                            </td>\n                          </tr>\n                          <tr>\n                            <td style="vertical-align: top;">Untuk Pembayaran</td>\n                            <td style="vertical-align: top;">:</td>\n                            <td style="vertical-align: top;">\n                              <t t-if="o.invoice_line_ids">\n                                <span t-esc="', '.join([('Treatment HD Single Use' if l.name == 'Hemodialisis' else l.name) for l in o.invoice_line_ids if l.name])"/>\n                              </t>\n                            </td>\n                          </tr>\n                          <tr>\n                            <td colspan="3" style="padding-top: 24px;">\n                              Depok, <t t-esc="o.invoice_date and o.invoice_date.strftime('%d-%m-%Y') or ''"/>\n                            </td>\n                          </tr>\n                          <tr>\n                            <td colspan="3" style="padding-left: 24px">\n                              <img src="/ehealth_document/static/src/img/signature/signature_invoice_sahabatkeluarga.jpg" style="width:100px;height:100px;"/>\n                            </td>\n                          </tr>\n                          <tr>\n                            <td colspan="3" style="padding-left: 42px">(Kasir)</td>\n                          </tr>\n                        </table>\n                      </div>\n                    </div>\n                    <div class="pt-4" style="border-bottom: 3px solid #000; width: 100%;"/>\n                    <div style="border-bottom: 1px solid #000; width: 100%; padding-top: 1px"/>\n                    <!-- END KWITANSI SECTION ONLY -->\n                </div>\n              </div>\n            </t>\n        </t>\n    	ehealth_document/report/template_invoice/template_invoice_sahabat_keluarga_A5.xml	\N	\N	\N	\N	primary	t	1	2025-08-28 11:34:01.364376	1	2025-08-28 11:34:01.364376	f
493	report_productlabel	\N	product.report_productlabel	16	qweb	<?xml version="1.0"?>\n<t t-name="product.report_productlabel">\n            <t t-call="web.basic_layout">\n                <div class="page">\n                    <t t-foreach="docs" t-as="product">\n                        <t t-call="product.report_simple_label">\n                            <t t-set="product" t-value="product"/>\n                        </t>\n                    </t>\n                </div>\n            </t>\n        </t>\n\n        	product/report/product_product_templates.xml	\N	\N	\N	\N	primary	t	1	2025-08-28 11:32:18.663929	1	2025-08-28 11:32:18.663929	\N
1516	template_invoice_emerald_A5	\N	ehealth_document.template_invoice_emerald_A5	16	qweb	<?xml version="1.0"?>\n<t t-name="ehealth_document.template_invoice_emerald_A5">\n            <t t-call="web.html_container">\n              <div class="header mb-0" t-att-style="report_header_style">\n                <p style="font-size: 15px; font-weight: 600; line-height: 1.3;">\n                    <b>EMERALD CLINIC JAMBI</b><br/>\n                    Jl. Kapten Pattimura RT.28 Kel. Simpang IV Sipin, Jambi Telp. 0812-7475-8899<br/>\n                    Whatsapp. 0812-7834-7843<br/>\n                </p>\n                <div class="" style="border-top: 2px solid #000; width: 100%;"/>\n                <p class="text-center p-0 m-0"># KWITANSI #</p>\n                <div style="border-top: 2px solid #000; width: 100%;"/>\n              </div>\n              \n              <div class="article m-0 p-0" t-att-data-oe-model="o and o._name" t-att-data-oe-id="o and o.id" t-att-data-oe-lang="o and o.env.context.get('lang')">\n                <div class="page">\n\n                        <div class="row justify-content-between m-0 p-0">\n                            <div class="col-6">\n                                <div class="row">\n                                    <div class="col-4">\n                                        <p>Nama</p>\n                                    </div>\n                                    <div class="col-8">\n                                        <p>: <t t-esc="o['partner_id']['name']"/></p>\n                                    </div>\n                                </div>\n\n                                <div class="row">\n                                    <div class="col-4">\n                                        <p>Jaminan</p>\n                                    </div>\n                                    <div class="col-8">\n                                        <p>: <t t-esc="o['pricelist']['name']"/></p>\n                                    </div>\n                                </div>\n\n                                <div class="row">\n                                    <div class="col-4">\n                                        <p>Penjamin</p>\n                                    </div>\n                                    <div class="col-8">\n                                        <p>: <t t-if="o.pricelist.insurance" t-esc="o['pricelist'].insurance.name"/></p>\n                                    </div>\n                                </div>\n\n                                <div class="row">\n                                    <div class="col-4">\n                                        <p>Layanan</p>\n                                    </div>\n                                    <div class="col-8">\n                                        <p>: <t t-esc="o['service_id']['name']"/></p>\n                                    </div>\n                                </div>\n                            </div>\n                            <div class="col-6">\n                                <!-- Nomor Registrasi Pasien -->\n                                <!-- <div class="row">\n                                    <div class="col-4">\n                                        <p>No. Reg</p>\n                                    </div>\n                                    <div class="col-8">\n                                        <p>: <t t-esc="o['partner_id']['name']"/></p>\n                                    </div>\n                                </div> -->\n\n                                <div class="row">\n                                    <div class="col-4">\n                                        <p>No MR</p>\n                                    </div>\n                                    <div class="col-8">\n                                        <p>: <t t-esc="o['partner_id']['medical_record']"/></p>\n                                    </div>\n                                </div>\n\n                                <div class="row">\n                                    <div class="col-4">\n                                        <p>Tgl/Jam Masuk</p>\n                                    </div>\n                                    <div class="col-8">\n                                        <p>: <t t-if="o['check_in_time']" t-esc="o['check_in_time'].strftime('%d-%m-%Y / %H:%M:%S')"/></p>\n                                    </div>\n                                </div>\n\n                                <div class="row">\n                                    <div class="col-4">\n                                        <p>Tgl/Jam Keluar</p>\n                                    </div>\n                                    <div class="col-8">\n                                        <p>: <t t-if="o['check_out_time']" t-esc="o['check_out_time'].strftime('%d-%m-%Y / %H:%M:%S')"/></p>\n                                    </div>\n                                </div>\n                            </div>\n                        </div>\n\n                        <t t-set="display_discount" t-value="any(l.discount for l in o.invoice_line_ids)"/>\n\n                        <table class="table table-sm o_main_table mt-2" name="invoice_line_table">\n                            <thead style="border-top: 2px solid #000;border-bottom: 2px solid #000;">\n                                <tr>\n                                    <th name="th_number" class="text-left" style="width: 16px;">No.</th>\n                                    <th name="th_description" class="text-center"><span>Pelayanan</span></th>\n                                    <th name="th_quantity" class="text-right"><span>Jumlah</span></th>\n                                    <th name="th_priceunit" t-attf-class="text-right {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}"><span>Harga</span></th>\n                                    <th name="th_price_unit" t-if="display_discount" t-attf-class="text-right {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}">\n                                        <span>Disc.%</span>\n                                    </th>\n                                    <th name="th_taxes" t-attf-class="text-left {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}" t-if="o.move_type == 'in_invoice'"><span>Taxes</span></th>\n                                    <th name="th_subtotal" class="text-right">\n                                        <span groups="account.group_show_line_subtotals_tax_excluded">Total</span>\n                                        <span groups="account.group_show_line_subtotals_tax_included">Total</span>\n                                    </th>\n                                </tr>\n                            </thead>\n                            <tbody class="invoice_tbody">\n                                <t t-set="current_subtotal" t-value="0"/>\n                                <t t-set="lines" t-value="o.invoice_line_ids.sorted(key=lambda l: (-l.sequence, l.date, l.move_name, -l.id), reverse=True)"/>\n                                <t t-set="number" t-value="1"/>\n\n                                <t t-foreach="lines" t-as="line">\n                                    <t t-set="current_subtotal" t-value="current_subtotal + line.price_subtotal" groups="account.group_show_line_subtotals_tax_excluded"/>\n                                    <t t-set="current_subtotal" t-value="current_subtotal + line.price_total" groups="account.group_show_line_subtotals_tax_included"/>\n\n                                    <tr t-att-class="'bg-200 font-weight-bold o_line_section' if line.display_type == 'line_section' else 'font-italic o_line_note' if line.display_type == 'line_note' else ''">\n                                        <t t-if="not line.display_type" name="account_invoice_line_accountable">\n                                            <td name="account_invoice_line_number">\n                                                <span t-esc="number"/>\n                                                <t t-set="number" t-value="number + 1"/>\n                                            </td>\n                                            <td name="account_invoice_line_name"><span t-field="line.product_id.name" t-options="{'widget': 'text'}"/></td>\n                                            <td class="text-right">\n                                                <span t-esc="round(line['quantity'])"/>\n                                                <span t-field="line.product_uom_id" groups="uom.group_uom"/>\n                                            </td>\n                                            <td t-attf-class="text-right {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}">\n                                                <span t-esc="round(line['price_unit'])"/>\n                                            </td>\n                                            <td t-if="display_discount" t-attf-class="text-right {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}">\n                                                <span class="text-nowrap" t-field="line.discount"/>\n                                            </td>\n                                            <td t-attf-class="text-left {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}" t-if="o.move_type == 'in_invoice'">\n                                                <span t-esc="', '.join(map(lambda x: (x.description or x.name), line.tax_ids))" id="line_tax_ids"/>\n                                            </td>\n                                            <td class="text-right o_price_total">\n                                                <span class="text-nowrap" t-field="line.price_subtotal" groups="account.group_show_line_subtotals_tax_excluded"/>\n                                                <span class="text-nowrap" t-field="line.price_total" groups="account.group_show_line_subtotals_tax_included"/>\n                                            </td>\n                                        </t>\n                                        <t t-if="line.display_type == 'line_section'">\n                                            <td colspan="99">\n                                                <span t-field="line.name" t-options="{'widget': 'text'}"/>\n                                            </td>\n                                            <t t-set="current_section" t-value="line"/>\n                                            <t t-set="current_subtotal" t-value="0"/>\n                                        </t>\n                                        <t t-if="line.display_type == 'line_note'">\n                                            <td colspan="99">\n                                                <span t-field="line.name" t-options="{'widget': 'text'}"/>\n                                            </td>\n                                        </t>\n                                    </tr>\n\n                                    <t t-if="current_section and (line_last or lines[line_index+1].display_type == 'line_section')">\n                                        <tr class="is-subtotal text-right">\n                                            <td colspan="99">\n                                                <strong class="mr16">Subtotal</strong>\n                                                <span t-esc="current_subtotal" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: o.currency_id}"/>\n                                            </td>\n                                        </tr>\n                                    </t>\n                                </t>\n                            </tbody>\n                        </table>\n\n                        <div class="clearfix">\n                            <div id="total" class="row">\n                                <div t-attf-class="#{'col-6' if report_type != 'html' else 'col-sm-7 col-md-6'} ml-auto">\n                                    <table class="table table-sm" style="page-break-inside: avoid;">\n                                        <tr class="border-black o_subtotal" style="">\n                                            <td><strong>Subtotal</strong></td>\n                                            <td class="text-right">\n                                                <span t-esc="o.amount_untaxed + o.total_discount" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: o.currency_id}"/>\n                                            </td>\n                                        </tr>\n                                        <t t-foreach="o.amount_by_group" t-as="amount_by_group">\n                                            <tr style="">\n                                                <t t-if="len(o.line_ids.filtered(lambda line: line.tax_line_id)) in [0, 1] and o.amount_untaxed == amount_by_group[2]">\n                                                    <td><span class="text-nowrap" t-esc="amount_by_group[0]"/></td>\n                                                    <td class="text-right o_price_total">\n                                                        <span class="text-nowrap" t-esc="amount_by_group[3]"/>\n                                                    </td>\n                                                </t>\n                                                <t t-else="">\n                                                    <td>\n                                                        <span t-esc="amount_by_group[0]"/>\n                                                        <span class="text-nowrap"> on\n                                                            <t t-esc="amount_by_group[4]"/>\n                                                        </span>\n                                                    </td>\n                                                    <td class="text-right o_price_total">\n                                                        <span class="text-nowrap" t-esc="amount_by_group[3]"/>\n                                                    </td>\n                                                </t>\n                                            </tr>\n                                        </t>\n                                            <tr>\n                                                <td><strong>Diskon</strong></td>\n                                                <td class="text-right">\n                                                    -<span t-field="o.total_discount"/>\n                                                </td>\n                                            </tr>\n                                            \n                                        <tr class="border-black o_total">\n                                            <td><strong>Total</strong></td>\n                                            <td class="text-right">\n                                                <span class="text-nowrap" t-field="o.amount_total"/>\n                                            </td>\n                                        </tr>\n                                        <t t-if="print_with_payments">\n                                            <tr>\n                                                <t t-set="pay" t-value="o.sudo()._get_reconciled_info_JSON_values()"/>\n                                                <t t-foreach="pay" t-as="pay">\n                                                    <td>\n                                                        <strong>Dibayar (<span t-esc="pay['journal_name']"/>)</strong>\n                                                    </td>\n                                                    <td class="text-right">\n                                                            <span t-esc="pay['amount']" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: o.currency_id}"/>\n                                                    </td>\n                                                </t>\n                                            </tr>\n                                            <t t-if="len(pay) &gt; 0">\n                                                <tr class="border-black">\n                                                    <td><strong>Sisa Tagihan</strong></td>\n                                                    <td class="text-right">\n                                                        <span t-field="o.amount_residual"/>\n                                                    </td>\n                                                </tr>\n                                            </t>\n                                        </t>\n                                    </table>\n                                </div>\n                            </div>\n                        </div>\n\n                        <div class="row mt-3" t-if="o.cashier.name" name="cashier">\n                            <div class="col-8"/>\n                            <div class="col-4">\n                                <div class="text-center">\n                                    <p class="mb-0"><span t-field="o.operating_unit_id.company_id.city"/>, <span t-esc="o.invoice_date.strftime('%d-%m-%Y')"/></p>\n                                    <div style="height: 80px;"/>\n                                    <p>(   <span t-field="o.cashier.name"/>   )</p>\n                                </div>\n                            </div>\n                        </div>\n\n                        <p t-if="o.invoice_payment_term_id" name="payment_term">\n                            <span t-field="o.invoice_payment_term_id.note"/>\n                        </p>\n                        <p t-if="o.narration" name="comment">\n                            <span t-field="o.narration"/>\n                        </p>\n                        <p t-if="o.fiscal_position_id.note" name="note">\n                            <span t-field="o.fiscal_position_id.note"/>\n                        </p>\n                        <p t-if="o.invoice_incoterm_id" name="incoterm">\n                            <strong>Incoterm: </strong><span t-field="o.invoice_incoterm_id.code"/> - <span t-field="o.invoice_incoterm_id.name"/>\n                        </p>\n                        <div id="qrcode" t-if="o.display_qr_code">\n                            <p t-if="qr_code_urls.get(o.id)">\n                                <strong class="text-center">Scan me with your banking app.</strong><br/><br/>\n                                <img class="border border-dark rounded" t-att-src="qr_code_urls[o.id]"/>\n                            </p>\n                        </div>\n                    </div>\n            </div>\n                \n            </t>\n        </t>\n    	ehealth_document/report/template_invoice/template_invoice_emerald_A5.xml	\N	\N	\N	\N	primary	t	1	2025-08-28 11:34:01.364376	1	2025-08-28 11:34:01.364376	f
1517	template_invoice_senopatiskincenter	\N	ehealth_document.template_invoice_senopatiskincenter	16	qweb	<?xml version="1.0"?>\n<t t-name="ehealth_document.template_invoice_senopatiskincenter">\n            <t t-call="web.external_layout">\n                    <t t-set="o" t-value="o.with_context(lang=lang)"/>\n                    <t t-set="address">\n                        <address t-field="o.partner_id" t-options="{&quot;widget&quot;: &quot;contact&quot;, &quot;fields&quot;: [&quot;address&quot;, &quot;name&quot;], &quot;no_marker&quot;: True}"/>\n                        <div t-if="o.partner_id.vat" class="mt16">\n                            <t t-if="o.company_id.country_id.vat_label" t-esc="o.company_id.country_id.vat_label" id="inv_tax_id_label"/>\n                            <t t-else="">Tax ID</t>: <span t-field="o.partner_id.vat"/></div>\n                    </t>\n                    <div class="page">\n                        <h2>\n                            <span t-if="o.move_type == 'out_invoice' and o.state == 'posted'">Invoice</span>\n                            <span t-if="o.move_type == 'out_invoice' and o.state == 'draft'">Draft Invoice</span>\n                            <span t-if="o.move_type == 'out_invoice' and o.state == 'cancel'">Cancelled Invoice</span>\n                            <span t-if="o.move_type == 'out_refund'">Credit Note</span>\n                            <span t-if="o.move_type == 'in_refund'">Vendor Credit Note</span>\n                            <span t-if="o.move_type == 'in_invoice'">Vendor Bill</span>\n                            <span t-if="o.name != '/'" t-field="o.name"/>\n                        </h2>\n\n                        <div id="informations" class="row mt32 mb32">\n                            <div class="col-auto col-3 mw-100 mb-2" t-if="o.invoice_date" name="invoice_date">\n                                <strong>Invoice Date:</strong>\n                                <p class="m-0" t-field="o.invoice_date"/>\n                            </div>\n                            <div class="col-auto col-3 mw-100 mb-2" t-if="o.invoice_date_due and o.move_type == 'out_invoice' and o.state == 'posted'" name="due_date">\n                                <strong>Due Date:</strong>\n                                <p class="m-0" t-field="o.invoice_date_due"/>\n                            </div>\n                            <div class="col-auto col-3 mw-100 mb-2" t-if="'pricelist' in o" name="pricelist">\n                                <strong>Payment Scheme:</strong>\n                                <p class="m-0" t-field="o.pricelist"/>\n                            </div>\n                            <div class="col-auto col-3 mw-100 mb-2" t-if="o.invoice_origin" name="origin">\n                                <strong>Source:</strong>\n                                <p class="m-0" t-field="o.invoice_origin"/>\n                            </div>\n                            <div class="col-auto col-3 mw-100 mb-2" t-if="o.partner_id.ref" name="customer_code">\n                                <strong>Customer Code:</strong>\n                                <p class="m-0" t-field="o.partner_id.ref"/>\n                            </div>\n                            <div class="col-auto col-3 mw-100 mb-2" t-if="o.ref" name="reference">\n                                <strong>Reference:</strong>\n                                <p class="m-0" t-field="o.ref"/>\n                            </div>\n                        </div>\n\n                        <t t-set="display_discount" t-value="any(l.discount for l in o.invoice_line_ids)"/>\n\n                        <table class="table table-sm o_main_table" name="invoice_line_table">\n                            <thead>\n                                <tr>\n                                    <th name="th_description" class="text-left"><span>Description</span></th>\n                                    <th name="th_quantity" class="text-right"><span>Quantity</span></th>\n                                    <th name="th_priceunit" t-attf-class="text-right {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}"><span>Unit Price</span></th>\n                                    <th name="th_price_unit" t-if="display_discount" t-attf-class="text-right {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}">\n                                        <span>Disc.%</span>\n                                    </th>\n                                    <th name="th_taxes" t-attf-class="text-left {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}"><span>Taxes</span></th>\n                                    <th name="th_subtotal" class="text-right">\n                                        <span groups="account.group_show_line_subtotals_tax_excluded">Amount</span>\n                                        <span groups="account.group_show_line_subtotals_tax_included">Total Price</span>\n                                    </th>\n                                </tr>\n                            </thead>\n                            <tbody class="invoice_tbody">\n                                <t t-set="current_subtotal" t-value="0"/>\n                                <t t-set="lines" t-value="o.invoice_line_ids.sorted(key=lambda l: (-l.sequence, l.date, l.move_name, -l.id), reverse=True)"/>                                \n                                \n                                <t t-set="default_product_for_patient" t-value="env.user.company_id.default_cashier_product"/>\n                                <t t-set="default_product_for_new_patient" t-value="env.user.company_id.default_cashier_product_new_patient"/>\n                                <t t-set="lines_filtered" t-value="list(filter(lambda it: not it.product_id or not it.product_id.id == default_product_for_patient.id and not it.product_id.id == default_product_for_new_patient.id, lines))"/>\n                                <t t-set="administration" t-value="list(filter(lambda it: it.product_id.id == default_product_for_patient.id or it.product_id.id == default_product_for_new_patient.id, lines))"/>\n                                <t t-set="administration_price" t-value="0"/>\n                                <t t-set="administration_price_with_taxes" t-value="0"/>\n                                <t t-foreach="administration" t-as="item">\n                                    <t t-set="administration_price" t-value="administration_price + item.price_unit"/>\n                                    <t t-set="administration_price_with_taxes" t-value="administration_price_with_taxes + item.price_unit + (item.price_unit * item.tax_ids.amount / 100)"/>\n                                </t>\n                                <t t-foreach="lines_filtered" t-as="line">\n                                    <t t-set="current_subtotal" t-value="current_subtotal + line.price_subtotal" groups="account.group_show_line_subtotals_tax_excluded"/>\n                                    <t t-set="current_subtotal" t-value="current_subtotal + line.price_total" groups="account.group_show_line_subtotals_tax_included"/>\n                                    <t t-set="tuslag_amount" t-value="line.tuslag_amount / line.quantity if line.quantity else 0"/>\n\n                                    <tr t-att-class="'bg-200 font-weight-bold o_line_section' if line.display_type == 'line_section' else 'font-italic o_line_note' if line.display_type == 'line_note' else ''">\n                                        <t t-if="not line.display_type" name="account_invoice_line_accountable">\n                                            <td name="account_invoice_line_name"><span t-field="line.name" t-options="{'widget': 'text'}"/></td>\n                                            <td class="text-right">\n                                                <span t-field="line.quantity"/>\n                                                <span t-field="line.product_uom_id" groups="uom.group_uom"/>\n                                            </td>\n                                            <td t-attf-class="text-right {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}">\n                                                <t t-if="lines_filtered[0].id == line.id">\n                                                    <span class="text-nowrap" t-esc="line.price_unit + tuslag_amount + administration_price / line.quantity" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: o.currency_id}"/>\n                                                </t>\n                                                <t t-else="">\n                                                    <span class="text-nowrap" t-esc="line.price_unit + tuslag_amount" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: o.currency_id}"/>\n                                                </t>\n                                            </td>\n                                            <td t-if="display_discount" t-attf-class="text-right {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}">\n                                                <span class="text-nowrap" t-field="line.discount"/>\n                                            </td>\n                                            <td t-attf-class="text-left {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}">\n                                                <span t-esc="', '.join(map(lambda x: (x.description or x.name), line.tax_ids))" id="line_tax_ids"/>\n                                            </td>\n                                            <td class="text-right o_price_total">\n                                                <t t-if="lines_filtered[0].id == line.id">\n                                                    <span class="text-nowrap" t-esc="line.price_subtotal + administration_price" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: o.currency_id}" groups="account.group_show_line_subtotals_tax_excluded"/>\n                                                    <span class="text-nowrap" t-esc="line.price_total + administration_price_with_taxes" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: o.currency_id}" groups="account.group_show_line_subtotals_tax_included"/>\n                                                </t>\n                                                <t t-else="">\n                                                    <span class="text-nowrap" t-field="line.price_subtotal" groups="account.group_show_line_subtotals_tax_excluded"/>\n                                                    <span class="text-nowrap" t-field="line.price_total" groups="account.group_show_line_subtotals_tax_included"/>\n                                                </t>\n                                            </td>\n                                        </t>\n                                        <t t-if="line.display_type == 'line_section'">\n                                            <td colspan="99">\n                                                <span t-field="line.name" t-options="{'widget': 'text'}"/>\n                                            </td>\n                                            <t t-set="current_section" t-value="line"/>\n                                            <t t-set="current_subtotal" t-value="0"/>\n                                        </t>\n                                        <t t-if="line.display_type == 'line_note'">\n                                            <td colspan="99">\n                                                <span t-field="line.name" t-options="{'widget': 'text'}"/>\n                                            </td>\n                                        </t>\n                                    </tr>\n\n                                    <t t-if="current_section and (line_last or lines[line_index+1].display_type == 'line_section')">\n                                        <tr class="is-subtotal text-right">\n                                            <td colspan="99">\n                                                <strong class="mr16">Subtotal</strong>\n                                                <span t-esc="current_subtotal" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: o.currency_id}"/>\n                                            </td>\n                                        </tr>\n                                    </t>\n                                </t>\n                            </tbody>\n                        </table>\n\n                        <div class="clearfix">\n                            <div id="total" class="row">\n                                <div t-attf-class="#{'col-6' if report_type != 'html' else 'col-sm-7 col-md-6'} ml-auto">\n                                    <table class="table table-sm" style="page-break-inside: avoid;">\n                                        <tr class="border-black o_subtotal" style="">\n                                            <td><strong>Subtotal</strong></td>\n                                            <td class="text-right">\n                                                <span t-esc="o.amount_without_discount" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: o.currency_id}"/>\n                                            </td>\n                                        </tr>\n                                        <t t-foreach="o.amount_by_group" t-as="amount_by_group">\n                                            <tr style="">\n                                                <t t-if="len(o.line_ids.filtered(lambda line: line.tax_line_id)) in [0, 1] and o.amount_untaxed == amount_by_group[2]">\n                                                    <td><span class="text-nowrap" t-esc="amount_by_group[0]"/></td>\n                                                    <td class="text-right o_price_total">\n                                                        <span class="text-nowrap" t-esc="amount_by_group[3]"/>\n                                                    </td>\n                                                </t>\n                                                <t t-else="">\n                                                    <td>\n                                                        <span t-esc="amount_by_group[0]"/>\n                                                        <span class="text-nowrap"> on\n                                                            <t t-esc="amount_by_group[4]"/>\n                                                        </span>\n                                                    </td>\n                                                    <td class="text-right o_price_total">\n                                                        <span class="text-nowrap" t-esc="amount_by_group[3]"/>\n                                                    </td>\n                                                </t>\n                                            </tr>\n                                        </t>\n                                            <tr>\n                                                <td><strong>Diskon</strong></td>\n                                                <td class="text-right">\n                                                    -<span t-field="o.total_discount"/>\n                                                </td>\n                                            </tr>\n                                            <tr>\n                                                <t t-set="pay" t-value="o.sudo()._get_reconciled_info_JSON_values()"/>\n                                                <t t-foreach="pay" t-as="pay">\n                                                    <td>\n                                                        <strong>Dibayar (<span t-esc="pay['journal_name']"/>)</strong>\n                                                    </td>\n                                                    <td class="text-right">\n                                                            <span t-esc="pay['amount']" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: o.currency_id}"/>\n                                                    </td>\n                                                </t>\n                                            </tr>\n                                        <tr class="border-black o_total">\n                                            <td><strong>Total</strong></td>\n                                            <td class="text-right">\n                                                <span class="text-nowrap" t-field="o.amount_total"/>\n                                            </td>\n                                        </tr>\n                                        <t t-if="print_with_payments">\n                                            <t t-if="o.payment_state != 'invoicing_legacy'">\n                                                <t t-set="payments_vals" t-value="o.sudo()._get_reconciled_info_JSON_values()"/>\n                                                <t t-foreach="payments_vals" t-as="payment_vals">\n                                                    <tr>\n                                                        <td>\n                                                            <i class="oe_form_field text-right oe_payment_label">Paid on <t t-esc="payment_vals['date']" t-options="{&quot;widget&quot;: &quot;date&quot;}"/></i>\n                                                        </td>\n                                                        <td class="text-right">\n                                                            <span t-esc="payment_vals['amount']" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: o.currency_id}"/>\n                                                        </td>\n                                                    </tr>\n                                                </t>\n                                                <t t-if="len(payments_vals) &gt; 0">\n                                                    <tr class="border-black">\n                                                        <td><strong>Amount Due</strong></td>\n                                                        <td class="text-right">\n                                                            <span t-field="o.amount_residual"/>\n                                                        </td>\n                                                    </tr>\n                                                </t>\n                                            </t>\n                                        </t>\n                                    </table>\n                                </div>\n                            </div>\n                        </div>\n                        <p t-if="o.move_type in ('out_invoice', 'in_refund') and o.payment_reference" name="payment_communication">\n                            Please use the following communication for your payment : <b><span t-field="o.payment_reference"/></b>\n                        </p>\n                        <p t-if="o.invoice_payment_term_id" name="payment_term">\n                            <span t-field="o.invoice_payment_term_id.note"/>\n                        </p>\n                        <p t-if="o.narration" name="comment">\n                            <span t-field="o.narration"/>\n                        </p>\n                        <p t-if="o.fiscal_position_id.note" name="note">\n                            <span t-field="o.fiscal_position_id.note"/>\n                        </p>\n                        <p t-if="o.invoice_incoterm_id" name="incoterm">\n                            <strong>Incoterm: </strong><span t-field="o.invoice_incoterm_id.code"/> - <span t-field="o.invoice_incoterm_id.name"/>\n                        </p>\n                        <div id="qrcode" t-if="o.display_qr_code">\n                            <p t-if="qr_code_urls.get(o.id)">\n                                <strong class="text-center">Scan me with your banking app.</strong><br/><br/>\n                                <img class="border border-dark rounded" t-att-src="qr_code_urls[o.id]"/>\n                            </p>\n                        </div>\n                    </div>\n                </t>\n        </t>\n    	ehealth_document/report/template_invoice/template_invoice_senopatiskincenter.xml	\N	\N	\N	\N	primary	t	1	2025-08-28 11:34:01.364376	1	2025-08-28 11:34:01.364376	f
1518	template_invoice_kmnu_A5	\N	ehealth_document.template_invoice_kmnu_A5	16	qweb	<?xml version="1.0"?>\n<t t-name="ehealth_document.template_invoice_kmnu_A5">\n            <t t-call="web.html_container">\n              <div class="header mb-0" t-att-style="report_header_style">\n                <div class="row">\n                  <div class="col-7">\n                      <img t-att-src="'/ehealth_document/static/src/img/logo_diatrans.png'" style="max-height: 90px;" alt="Logo"/>\n                  </div>\n                  <div class="col-5 text-right">\n                      <p style="font-size: 14px; color: #356081; font-weight: 700; line-height: 1.4;">\n                        <strong>Klinik Utama Dialisis Muslimat NU</strong><br/>\n                        Jl. Langit² No. 12 Kayu Putih<br/>\n                        Jakarta Timur 13210-Indonesia<br/>\n                        021-4896807<br/>\n                      </p>\n                  </div>\n              </div>\n                <div class="pt-2" style="border-bottom: 2px solid #000; width: 100%;"/>\n              </div>\n              \n              <div class="article" t-att-data-oe-model="o and o._name" t-att-data-oe-id="o and o.id" t-att-data-oe-lang="o and o.env.context.get('lang')">\n                <div class="page">\n\n                        <div class="row">\n                            <div class="col-md-12">\n                                <h4 class="text-center" style="color: #276792;">\n                                    <span t-if="o.move_type == 'out_invoice' and o.state == 'posted'">Invoice</span>\n                                    <span t-if="o.move_type == 'out_invoice' and o.state == 'draft'">Draft Invoice</span>\n                                    <span t-if="o.move_type == 'out_invoice' and o.state == 'cancel'">Cancelled Invoice</span>\n                                    <span t-if="o.move_type == 'out_refund'">Credit Note</span>\n                                    <span t-if="o.move_type == 'in_refund'">Vendor Credit Note</span>\n                                    <span t-if="o.move_type == 'in_invoice'">Vendor Bill</span>\n                                    <span t-if="o.name != '/'" t-field="o.name"/>\n                                </h4>\n                            </div>\n                        </div>\n\n                        <div class="row justify-content-between">\n                            <div class="col-7 text-left">\n                                <h3><t t-esc="o['partner_id']['name']"/></h3>\n                                <t t-set="bpjs_identifier" t-value="(o['partner_id'].identifier).filtered(lambda x: x.type == 'bpjs')"/>\n                                <t t-if="bpjs_identifier">\n                                    <div class="row mt-2">\n                                        <div class="col-md-12 text-left">\n                                                No. BPJS: <t t-esc="bpjs_identifier[0].value"/>\n                                        </div>\n                                    </div>\n                                </t>\n                            </div>\n                            <div class="col-5 text-right" t-if="o.invoice_date" name="invoice_date">\n                                <strong>Tanggal Invoice:</strong>\n                                <p class="m-0" t-field="o.invoice_date"/>\n                            </div>\n                        </div>\n\n                        <t t-set="display_discount" t-value="any(l.discount for l in o.invoice_line_ids)"/>\n\n                        <table class="table table-sm o_main_table mt-4" name="invoice_line_table">\n                            <thead>\n                                <tr>\n                                    <th name="th_number" class="text-left"><span>No.</span></th>\n                                    <th name="th_description" class="text-left"><span>Item</span></th>\n                                    <th name="th_quantity" class="text-right"><span>Jumlah</span></th>\n                                    <th name="th_priceunit" t-attf-class="text-right {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}"><span>Harga</span></th>\n                                    <th name="th_price_unit" t-if="display_discount" t-attf-class="text-right {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}">\n                                        <span>Disc.%</span>\n                                    </th>\n                                    <th name="th_taxes" t-attf-class="text-left {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}" t-if="o.move_type == 'in_invoice'"><span>Taxes</span></th>\n                                    <th name="th_subtotal" class="text-right">\n                                        <span groups="account.group_show_line_subtotals_tax_excluded">Total</span>\n                                        <span groups="account.group_show_line_subtotals_tax_included">Total</span>\n                                    </th>\n                                </tr>\n                            </thead>\n                            <tbody class="invoice_tbody">\n                                <t t-set="current_subtotal" t-value="0"/>\n                                <t t-set="lines" t-value="o.invoice_line_ids.sorted(key=lambda l: (-l.sequence, l.date, l.move_name, -l.id), reverse=True)"/>\n                                <t t-set="number" t-value="1"/>\n\n                                <t t-foreach="lines" t-as="line">\n                                    <t t-set="current_subtotal" t-value="current_subtotal + line.price_subtotal" groups="account.group_show_line_subtotals_tax_excluded"/>\n                                    <t t-set="current_subtotal" t-value="current_subtotal + line.price_total" groups="account.group_show_line_subtotals_tax_included"/>\n\n                                    <tr t-att-class="'bg-200 font-weight-bold o_line_section' if line.display_type == 'line_section' else 'font-italic o_line_note' if line.display_type == 'line_note' else ''">\n                                        <t t-if="not line.display_type" name="account_invoice_line_accountable">\n                                            <td name="account_invoice_line_number">\n                                                <span t-esc="number"/>\n                                                <t t-set="number" t-value="number + 1"/>\n                                            </td>\n                                            <td name="account_invoice_line_name"><span t-field="line.product_id.name" t-options="{'widget': 'text'}"/></td>\n                                            <td class="text-right">\n                                                <span t-esc="round(line['quantity'])"/>\n                                                <span t-field="line.product_uom_id" groups="uom.group_uom"/>\n                                            </td>\n                                            <td t-attf-class="text-right {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}">\n                                                <span t-esc="round(line['price_unit'])"/>\n                                            </td>\n                                            <td t-if="display_discount" t-attf-class="text-right {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}">\n                                                <span class="text-nowrap" t-field="line.discount"/>\n                                            </td>\n                                            <td t-attf-class="text-left {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}" t-if="o.move_type == 'in_invoice'">\n                                                <span t-esc="', '.join(map(lambda x: (x.description or x.name), line.tax_ids))" id="line_tax_ids"/>\n                                            </td>\n                                            <td class="text-right o_price_total">\n                                                <span class="text-nowrap" t-field="line.price_subtotal" groups="account.group_show_line_subtotals_tax_excluded"/>\n                                                <span class="text-nowrap" t-field="line.price_total" groups="account.group_show_line_subtotals_tax_included"/>\n                                            </td>\n                                        </t>\n                                        <t t-if="line.display_type == 'line_section'">\n                                            <td colspan="99">\n                                                <span t-field="line.name" t-options="{'widget': 'text'}"/>\n                                            </td>\n                                            <t t-set="current_section" t-value="line"/>\n                                            <t t-set="current_subtotal" t-value="0"/>\n                                        </t>\n                                        <t t-if="line.display_type == 'line_note'">\n                                            <td colspan="99">\n                                                <span t-field="line.name" t-options="{'widget': 'text'}"/>\n                                            </td>\n                                        </t>\n                                    </tr>\n\n                                    <t t-if="current_section and (line_last or lines[line_index+1].display_type == 'line_section')">\n                                        <tr class="is-subtotal text-right">\n                                            <td colspan="99">\n                                                <strong class="mr16">Subtotal</strong>\n                                                <span t-esc="current_subtotal" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: o.currency_id}"/>\n                                            </td>\n                                        </tr>\n                                    </t>\n                                </t>\n                            </tbody>\n                        </table>\n\n                        <div class="clearfix">\n                            <div id="total" class="row">\n                                <div t-attf-class="#{'col-6' if report_type != 'html' else 'col-sm-7 col-md-6'} ml-auto">\n                                    <table class="table table-sm" style="page-break-inside: avoid;">\n                                        <tr class="border-black o_subtotal" style="">\n                                            <td style="color: #276792;"><strong>Subtotal</strong></td>\n                                            <td class="text-right">\n                                                <span t-esc="o.amount_untaxed + o.total_discount" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: o.currency_id}"/>\n                                            </td>\n                                        </tr>\n                                        <t t-foreach="o.amount_by_group" t-as="amount_by_group">\n                                            <tr style="">\n                                                <t t-if="len(o.line_ids.filtered(lambda line: line.tax_line_id)) in [0, 1] and o.amount_untaxed == amount_by_group[2]">\n                                                    <td><span class="text-nowrap" t-esc="amount_by_group[0]"/></td>\n                                                    <td class="text-right o_price_total">\n                                                        <span class="text-nowrap" t-esc="amount_by_group[3]"/>\n                                                    </td>\n                                                </t>\n                                                <t t-else="">\n                                                    <td>\n                                                        <span t-esc="amount_by_group[0]"/>\n                                                        <span class="text-nowrap"> on\n                                                            <t t-esc="amount_by_group[4]"/>\n                                                        </span>\n                                                    </td>\n                                                    <td class="text-right o_price_total">\n                                                        <span class="text-nowrap" t-esc="amount_by_group[3]"/>\n                                                    </td>\n                                                </t>\n                                            </tr>\n                                        </t>\n                                            <tr>\n                                                <td style="color: #276792;"><strong>Diskon</strong></td>\n                                                <td class="text-right">\n                                                    -<span t-field="o.total_discount"/>\n                                                </td>\n                                            </tr>\n                                            \n                                        <tr class="border-black o_total">\n                                            <td style="color: #276792;"><strong>Total</strong></td>\n                                            <td class="text-right">\n                                                <span class="text-nowrap" t-field="o.amount_total"/>\n                                            </td>\n                                        </tr>\n                                        <t t-if="print_with_payments">\n                                            <tr>\n                                                <t t-set="pay" t-value="o.sudo()._get_reconciled_info_JSON_values()"/>\n                                                <t t-foreach="pay" t-as="pay">\n                                                    <td style="color: #276792;">\n                                                        <strong>Dibayar (<span t-esc="pay['journal_name']"/>)</strong>\n                                                    </td>\n                                                    <td class="text-right">\n                                                            <span t-esc="pay['amount']" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: o.currency_id}"/>\n                                                    </td>\n                                                </t>\n                                            </tr>\n                                            <t t-if="len(pay) &gt; 0">\n                                                <tr class="border-black">\n                                                    <td style="color: #276792;"><strong>Sisa Tagihan</strong></td>\n                                                    <td class="text-right">\n                                                        <span t-field="o.amount_residual"/>\n                                                    </td>\n                                                </tr>\n                                            </t>\n                                        </t>\n                                    </table>\n                                </div>\n                            </div>\n                        </div>\n\n                        <p t-if="o.invoice_payment_term_id" name="payment_term">\n                            <span t-field="o.invoice_payment_term_id.note"/>\n                        </p>\n                        <p t-if="o.narration" name="comment">\n                            <span t-field="o.narration"/>\n                        </p>\n                        <p t-if="o.fiscal_position_id.note" name="note">\n                            <span t-field="o.fiscal_position_id.note"/>\n                        </p>\n                        <p t-if="o.invoice_incoterm_id" name="incoterm">\n                            <strong>Incoterm: </strong><span t-field="o.invoice_incoterm_id.code"/> - <span t-field="o.invoice_incoterm_id.name"/>\n                        </p>\n                        <div id="qrcode" t-if="o.display_qr_code">\n                            <p t-if="qr_code_urls.get(o.id)">\n                                <strong class="text-center">Scan me with your banking app.</strong><br/><br/>\n                                <img class="border border-dark rounded" t-att-src="qr_code_urls[o.id]"/>\n                            </p>\n                        </div>\n                    </div>\n              </div>\n                \n            </t>\n        </t>\n    	ehealth_document/report/template_invoice/template_invoice_kmnu_A5.xml	\N	\N	\N	\N	primary	t	1	2025-08-28 11:34:01.364376	1	2025-08-28 11:34:01.364376	f
1519	template_invoice_optiksahara	\N	ehealth_document.template_invoice_optiksahara	16	qweb	<?xml version="1.0"?>\n<t t-name="ehealth_document.template_invoice_optiksahara">\n            <t t-set="company" t-value="res_company"/>\n            <t t-call="ehealth_document.header_optiksahara_document">\n                <t t-set="o" t-value="o.with_context(lang=lang)"/>\n                <div class="page pt-2" style="font-size: 12px;">\n                    <div class="row">\n                        <div class="col-7">\n                            <strong>\n                                <div class="row">\n                                    <div class="col-3">Nama</div>\n                                    <div class="col-9">: <span t-esc="(o['partner_id']['name'] or '-')"/></div>\n                                </div>\n                            </strong>\n                            <div class="row">\n                                <div class="col-3">Jenis Kelamin</div>\n                                <div class="col-9">:\n                                    <t t-if="o['partner_id']['gender'] == 'male'">LAKI-LAKI</t>\n                                    <t t-else="">PEREMPUAN</t>\n                                </div>\n                            </div>\n                            <div class="row">\n                                <div class="col-3">Tgl Lahir</div>\n                                <div class="col-9">: <span t-esc="o['partner_id']['birthDate'].strftime('%d-%m-%Y') if o['partner_id']['birthDate'] else '-'"/></div>\n                            </div>\n                            <div class="row">\n                                <div class="col-3">Alamat</div>\n                                <div class="col-9">: <span t-esc="o['partner_id']['street']"/></div>\n                            </div>\n                            <div class="row">\n                                <div class="col-3">No Telephone</div>\n                                <div class="col-9">: <span t-esc="o['partner_id']['phone'] or '-'"/></div>\n                            </div>\n                            <div class="row mt-2">\n                                <div class="col-3">Pertanggungan</div>\n                                <div class="col-9">: <span t-field="o.pricelist"/></div>\n                            </div>\n                            <div class="row">\n                                <div class="col-3">No Kartu BPJS</div>\n                                <div class="col-9">: \n                                    <t t-set="bpjs_identifier" t-value="(o['partner_id'].identifier).filtered(lambda x: x.type == 'bpjs')"/>\n                                        <t t-if="bpjs_identifier">\n                                            <t t-esc="o['partner_id']['identity_number']"/>\n                                        </t>\n                                    <t t-else="">\n                                        -\n                                    </t>\n                                </div>\n                            </div>\n                            <t t-set="prescription" t-value="o.get_prescription_from_invoice()"/>\n                            <div class="row">\n                                <div class="col-3">No Legalisasi</div>\n                                <div class="col-9">: <t t-esc="prescription['deliver_legal_number'] or '-'"/></div>\n                            </div>\n                            <div class="row">\n                                <div class="col-3">Asal Resep</div>\n                                <div class="col-9">: <t t-esc="prescription.prescription_origin or '-'"/></div>\n                            </div>\n                            <div class="row mt-2">\n                                <div class="col-3 m-0">Resep Kacamata</div>\n                                <div class="col-9">:\n                                    <span>\n                                        <t t-esc="o.getJenisKacamata(prescription)"/>\n                                    </span>\n                                </div>\n                            </div>\n                            <div class="row">\n                                <div class="col-3">Kanan</div>\n                                <div class="col-9">:\n                                    <t t-set="od_sphere" t-value="float(prescription['jauh_od_sphere']['name'] or 0)"/>\n                                    <t t-set="od_cylinder" t-value="float(prescription['jauh_od_cylinder']['name'] or 0)"/>\n                                    <t t-set="od_axis" t-value="int(prescription['jauh_od_axis'] or 0)"/>\n\n                                    <span>\n                                        <t t-if="od_sphere == 0 and od_cylinder == 0 and od_axis == 0">-</t>\n                                        <t t-else="">\n                                            <t t-esc="(o.formatKacamata(od_sphere))"/> \n                                            C<t t-esc="(o.formatKacamata(od_cylinder))"/> \n                                            X<t t-esc="180 if od_axis == 0 else od_axis"/>\n                                        </t>\n                                    </span>\n                                </div>\n                            </div>\n                            <div class="row">\n                                <div class="col-3">Kiri</div>\n                                <div class="col-9">: \n                                    <t t-set="os_sphere" t-value="float(prescription['jauh_os_sphere']['name'] or 0)"/>\n                                    <t t-set="os_cylinder" t-value="float(prescription['jauh_os_cylinder']['name'] or 0)"/>\n                                    <t t-set="os_axis" t-value="int(prescription['jauh_os_axis'] or 0)"/>\n\n                                    <span>\n                                        <t t-if="os_sphere == 0 and os_cylinder == 0 and os_axis == 0">-</t>\n                                        <t t-else="">\n                                            <t t-esc="(o.formatKacamata(os_sphere))"/> \n                                            C<t t-esc="(o.formatKacamata(os_cylinder))"/> \n                                            X<t t-esc="180 if os_axis == 0 else os_axis"/>\n                                        </t>\n                                    </span>\n                                </div>\n                            </div>\n                            <div class="row">\n                                <div class="col-3">Add</div>\n                                    <t t-set="add_od" t-value="float(prescription['adisi_od_sphere']['name'] or 0.0)"/>\n                                    <t t-set="add_os" t-value="float(prescription['adisi_os_sphere']['name'] or 0.0)"/>\n                                <div class="col-9">: \n                                    <t t-if="add_od == 0 and add_os == 0">-</t>\n                                    <t t-elif="abs(add_od - add_os) &lt; 0.125">\n                                        <span t-esc="o.formatKacamata(add_od)"/>\n                                    </t>\n                                    <t t-else="">\n                                        <span t-esc="'OD/OS: %s / %s' % (o.formatKacamata(add_od), o.formatKacamata(add_os))"/>\n                                    </t>\n                                </div>\n                            </div>\n                            <div class="row">\n                                <div class="col-3">PD</div>\n                                <div class="col-9">: \n                                    <t t-esc="prescription['far_pupillary_distance'] or '-'"/>\n                                </div>\n                            </div>\n                            <div class="row mt-2">\n                                <div class="col-3">Catatan</div>\n                                <div class="col-9">: \n                                    <span t-field="o.narration"/>\n                                </div>\n                            </div>\n                            <div class="row pt-4">\n                                <strong><div style="text-align: center; border: 1px solid black; padding: 6px; margin: 6px">\n                                    KETERANGAN : BAGI PENGGUNA LENSA PROGRESIVE ATAU 2 FOKUS,\n                                    DIBUTUHKAN ADAPTASI PENGGUNAAN LENSA SELAMA 14 HARI,\n                                    SELAMA ADAPTASI HARAP DIGUNAKAN SECARA RUTIN !! KACAMATA PATAH\n                                    &amp; LENSA GORES KARENA PEMAKAIAN TIDAK TERMASUK GARANSI,\n                                    BARANG YANG SUDAH DIBELI TIDAK BISA DIKEMBALIKAN\n                                </div></strong>\n                            </div>\n                        </div>\n\n                        <!-- Batas Column -->\n                        <div class="col-5">\n                            <div class="row">\n                                <div class="col-6">Tanggal</div>\n                                <div class="col-auto col-6 mw-100" t-if="o.invoice_date" name="invoice_date">\n                                    <span t-esc="o.invoice_date.strftime('%d/%m/%Y') if o.invoice_date else ''"/>\n                                </div>\n                            </div>\n                            <div class="row">\n                                <div class="col-6">No Kwitansi</div>\n                                <div class="col-6">: <span t-if="o.name != '/'" t-field="o.name"/></div>\n                            </div>\n                            \n                            <div> \n                                <div style="border-top: 1px solid #000; margin-top: 8px; padding-top: 4px;">\n                                    <div class="invoice-lines">\n                                        <t t-set="lines" t-value="o.invoice_line_ids.sorted(key=lambda l: (-l.sequence, l.date, l.move_name, -l.id), reverse=True)"/>\n                                        <t t-foreach="lines" t-as="line">\n                                            <div class="row">\n                                                <t t-if="not line.display_type">\n                                                    <div class="col-7">\n                                                        <span t-field="line.name" t-options="{'widget': 'text'}"/>\n                                                        <t t-if="line.quantity &gt; 1">\n                                                            (Qty: <span t-esc="int(line.quantity) if line.quantity == int(line.quantity) else line.quantity"/>)\n                                                        </t>\n\n                                                    </div>\n                                                    \n                                                    <div class="col-5">\n                                                        <div class="row">\n                                                            <div class="col-1">:</div>\n                                                            <div class="col-11 text-right pr-4">\n                                                                <span t-field="line.price_subtotal" groups="account.group_show_line_subtotals_tax_excluded"/>\n                                                                <span t-field="line.price_total" groups="account.group_show_line_subtotals_tax_included"/>\n                                                            </div>\n                                                        </div>\n                                                    </div>\n                                                </t>\n                                            </div>\n                                        </t>\n                                    </div>\n                                </div>\n\n                                <div class="row">\n                                    <div class="col-7">Diskon</div>\n                                    <div class="col-5">\n                                        <div class="row">\n                                            <div class="col-1">:</div>\n                                            <div class="col-11 text-right pr-4">\n                                                - <span t-field="o.total_discount"/>\n                                            </div>\n                                        </div>\n                                    </div>\n                                </div>\n                                <div style="border-top: 1px solid #000; margin-top: 4px; padding-top: 4px;">\n                                    <div class="row">\n                                        <div class="col-7">Subtotal</div>\n                                        <div class="col-5">\n                                            <div class="row">\n                                                <div class="col-1">:</div>\n                                                <div class="col-11 text-right pr-4">\n                                                    <span t-esc="o.amount_untaxed + o.total_discount" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: o.currency_id}"/>\n                                                </div>\n                                            </div>\n                                        </div>\n                                    </div>\n                                </div>\n                                <div class="row">\n                                    <t t-foreach="o.amount_by_group" t-as="amount_by_group">\n                                        <t t-if="len(o.line_ids.filtered(lambda line: line.tax_line_id)) in [0, 1] and o.amount_untaxed == amount_by_group[2]">\n                                            <div class="col-7">\n                                                <span class="text-nowrap" t-esc="amount_by_group[0]"/>\n                                            </div>\n                                            <div class="col-5">\n                                                <div class="row">\n                                                    <div class="col-1">:</div>\n                                                    <div class="col-11 text-right pr-4">\n                                                        + <span class="text-nowrap" t-esc="amount_by_group[3]"/>\n                                                    </div>\n                                                </div>\n                                            </div>\n                                        </t>\n                                        <t t-else="">\n                                            <div class="col-7">\n                                                <span t-esc="amount_by_group[0]"/>\n                                                <span class="text-nowrap"> on\n                                                    <t t-esc="amount_by_group[4]"/>\n                                                </span>\n                                            </div>\n                                            <div class="col-5">\n                                                <div class="row">\n                                                    <div class="col-1">:</div>\n                                                    <div class="col-11 text-right pr-4">\n                                                        + <span class="text-nowrap" t-esc="amount_by_group[3]"/>\n                                                    </div>\n                                                </div>\n                                            </div>\n                                        </t>\n                                    </t>\n                                </div>\n\n                                <div style="border-top: 1px solid #000; margin-top: 4px; padding-top: 4px;">\n                                    <strong>\n                                        <div class="row">\n                                            <div class="col-7">Total</div>\n                                            <div class="col-5">\n                                                <div class="row">\n                                                    <div class="col-1">:</div>\n                                                    <div class="col-11 text-right pr-4">\n                                                        <span class="text-nowrap" t-field="o.amount_total"/>\n                                                    </div>\n                                                </div>\n                                            </div>\n                                        </div>\n                                    </strong>\n                                </div>\n\n                                <t t-if="print_with_payments">\n                                    <t t-set="pay" t-value="o.sudo()._get_reconciled_info_JSON_values()"/>\n                                    <t t-if="len(pay) &gt; 0">\n                                        <t t-foreach="pay" t-as="pay">\n                                            <div class="row">\n                                                <div class="col-7">Dibayar dengan <span t-esc="pay['journal_name']"/></div>\n                                                <div class="col-5">\n                                                    <div class="row">\n                                                        <div class="col-1">:</div>\n                                                        <div class="col-11 text-right pr-4">\n                                                            - <span t-esc="pay['amount']" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: o.currency_id}"/>\n                                                        </div>\n                                                    </div>\n                                                </div>\n                                            </div>\n                                        </t>\n                                    \n                                        <div style="border-top: 1px solid #000; margin-top: 8px; padding-top: 4px;">\n                                            <strong>\n                                                <div class="row">\n                                                        <div class="col-7">Sisa Tagihan</div>\n                                                        <div class="col-5">\n                                                            <div class="row">\n                                                                <div class="col-1">:</div>\n                                                                <div class="col-11 text-right pr-4">\n                                                                    <span t-field="o.amount_residual"/>\n                                                                </div>\n                                                            </div>\n                                                        </div>\n                                                </div>\n                                            </strong>\n                                            <div>\n                                                <div class="mt-4" t-if="o.cashier.name" name="cashier">\n                                                    <div class="row py-0">\n                                                        <div class="col-7">\n                                                            <p class="mb-0"><span t-field="o.operating_unit_id.city"/>, <span t-esc="o.invoice_date.strftime('%d/%m/%Y')"/></p>\n                                                            <p>(Pramuniaga)</p>\n                                                        </div>\n                                                        <div class="col-5">\n                                                            <p class="mb-0"> </p> \n                                                            <p>(Konsumen)</p>\n                                                        </div>\n                                                    </div>\n                                                    <div class="row pt-5 mt-4">\n                                                        <div class="col-7"><span t-field="o.cashier.name"/></div>\n                                                        <div class="col-5"><span t-esc="o['partner_id']['name']"/></div>\n                                                    </div>\n                                                </div>\n                                            </div>\n                                        </div>\n                                    </t>\n                                </t>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n            </t>\n        </t>\n    	ehealth_document/report/template_invoice/template_invoice_optiksahara.xml	\N	\N	\N	\N	primary	t	1	2025-08-28 11:34:01.364376	1	2025-08-28 11:34:01.364376	f
494	report_simple_barcode	\N	product.report_simple_barcode	16	qweb	<?xml version="1.0"?>\n<t t-name="product.report_simple_barcode">\n            <div style="width: 32%; display: inline-table; height: 10rem;">\n                <table class="table table-bordered mb-0" style="border: 2px solid black;">\n                    <tr>\n                        <th class="table-active text-left" style="height: 4rem;">\n                            <strong t-field="product.display_name"/>\n                        </th>\n                    </tr>\n                    <tr>\n                        <td class="text-center align-middle" style="height: 6rem;">\n                            <t t-if="product.barcode">\n                                <img alt="Barcode" t-if="len(product.barcode) == 13" t-att-src="'/report/barcode/?type=%s&amp;value=%s&amp;width=%s&amp;height=%s' % ('EAN13', quote_plus(product.barcode or ''), 600, 150)" style="width:100%;height:4rem;"/>\n                                <img alt="Barcode" t-elif="len(product.barcode) == 8" t-att-src="'/report/barcode/?type=%s&amp;value=%s&amp;width=%s&amp;height=%s' % ('EAN8', quote_plus(product.barcode or ''), 600, 150)" style="width:100%;height:4rem;"/>\n                                <img alt="Barcode" t-else="" t-att-src="'/report/barcode/?type=%s&amp;value=%s&amp;width=%s&amp;height=%s' % ('Code128', quote_plus(product.barcode or ''), 600, 150)" style="width:100%;height:4rem"/>\n                                <span t-field="product.barcode"/>\n                            </t>\n                            <t t-else=""><span class="text-muted">No barcode available</span></t>\n                        </td>\n                    </tr>\n                </table>\n            </div>\n        </t>\n\n        	product/report/product_product_templates.xml	\N	\N	\N	\N	primary	t	1	2025-08-28 11:32:18.663929	1	2025-08-28 11:32:18.663929	\N

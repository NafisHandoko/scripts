1148	res.config.settings.view.form.inherit.purchase.stock	res.config.settings	\N	16	form	<?xml version="1.0"?>\n<data><xpath expr="//h2[@id='schedule_info']" position="attributes">\n\t\t\t\t<attribute name="invisible">0</attribute>\n\t\t\t</xpath>\n\t\t\t<div id="purchase_po_lead" position="replace">\n\t\t\t\t<div class="col-12 col-lg-6 o_setting_box" title="Margin of error for vendor lead times. When the system generates Purchase Orders for reordering products,they will be scheduled that many days earlier to cope with unexpected vendor delays." name="schedule_receivings_setting_container">\n\t\t\t\t\t<div class="o_setting_left_pane">\n\t\t\t\t\t\t<field name="use_po_lead"/>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class="o_setting_right_pane">\n\t\t\t\t\t\t<label for="use_po_lead"/>\n\t\t\t\t\t\t<a href="https://www.odoo.com/documentation/14.0/applications/inventory_and_mrp/inventory/management/planning/scheduled_dates.html" title="Documentation" class="mr-2 o_doc_link" target="_blank"/>\n\t\t\t\t\t\t<span class="fa fa-lg fa-building-o" title="Values set here are company-specific." groups="base.group_multi_company"/>\n\t\t\t\t\t\t<div class="text-muted">\n\t\t\t\t\t\t\tSchedule receivings earlier to avoid delays\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t<div class="content-group">\n\t\t\t\t\t\t\t<div class="mt16" attrs="{'invisible': [('use_po_lead','=',False)]}">\n\t\t\t\t\t\t\t\t<span>Move forward expected delivery dates by <field name="po_lead" class="oe_inline"/> days</span>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t<div class="col-12 col-lg-6 o_setting_box">\n\t\t\t\t\t<div class="o_setting_right_pane">\n\t\t\t\t\t\t<label for="days_to_purchase"/>\n\t\t\t\t\t\t<span class="fa fa-lg fa-building-o" title="Values set here are company-specific." aria-label="Values set here are company-specific." groups="base.group_multi_company"/>\n\t\t\t\t\t\t<div class="text-muted">\n\t\t\t\t\t\t\tDays needed to confirm a PO, define when a PO should be
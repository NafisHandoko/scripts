-- Name: stock_quant; Type: TABLE; Schema: public; Owner: odoo
--

CREATE TABLE public.stock_quant (
    id integer NOT NULL,
    product_id integer NOT NULL,
    company_id integer,
    location_id integer NOT NULL,
    lot_id integer,
    package_id integer,
    owner_id integer,
    quantity double precision,
    reserved_quantity double precision NOT NULL,
    in_date timestamp without time zone,
    create_uid integer,
    create_date timestamp without time zone,

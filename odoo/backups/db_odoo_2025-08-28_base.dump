1133	res.config.settings.view.form.inherit.accountant	res.config.settings	\N	16	form	<?xml version="1.0"?>\n<data><xpath expr="//div[@data-key='account']" position="attributes">\n                <attribute name="data-string">Accounting</attribute>\n                <attribute name="string">Accounting</attribute>\n            </xpath>\n            <div id="fiscalyear" position="replace">\n                <div class="col-12 col-lg-6" id="fiscalyear" style="padding-left: 0; padding-right: 0;">\n                    <div class="col-12 col-lg-12 o_setting_box">\n                        <div class="o_setting_left_pane"/>\n                        <div class="o_setting_right_pane">\n                            <separator string="Fiscal Year"/>\n                            <div class="content-group">\n                                <div class="row mt16">\n                                    <label for="fiscalyear_last_month" string="Last Day" class="col-lg-3 o_light_label"/>\n                                    <field name="fiscalyear_last_month" style="width: 100px; margin-right: 8px;"/>\n                                    <field name="fiscalyear_last_day" class="oe_inline"/>\n                                </div>\n                            </div>\n                        </div>\n                    </div>\n                    <div class="col-12 col-lg-12 o_setting_box">\n                        <div class="o_setting_left_pane">\n                            <field name="group_fiscal_year"/>\n                        </div>\n                        <div class="o_setting_right_pane">\n                            <label for="group_fiscal_year"/>\n                            <div class="text-muted">\n                                Define fiscal years of more or less than one year\n                            </div>\n                            <div class="mt16">\n                                <button name="395" icon="fa-arrow-right" type="action" string="Fiscal Years" class="btn-link" attrs="{'invisible': [('group_fiscal_year', '=', False)]}"/>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n                <div class="col-xs-12 col-md-6 o_setting_box" id="fiscalyear">\n                    <div class="o_setting_left_pane"/>\n                    <div class="o_setting_right_pane">\n                        <separator string="Fiscal Period Closing"/>\n                        <div class="text-muted">\n                            Lock your fiscal period\n                        </div>\n                         <div class="content-group">\n                            <div class="row mt16">\n                                <label for="fiscalyear_lock_date" class="col-md-5 o_light_label"/>\n                                <field name="fiscalyear_lock_date"/>\n                                <label for="period_lock_date" class="col-md-5 o_light_label"/>\n                                <field name="period_lock_date"/>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n                <div class="col-xs-12 col-md-6 o_setting_box" id="excel_reports">\n                    <div class="o_setting_left_pane"/>\n                    <div class="o_setting_right_pane">\n                        <separator string="Excel Reports"/>\n                        <div class="text-muted">\n                            Financial Reports in Excel\n                        </div>\n                         <div class="content-group">\n                             <a target="_blank" href="https://apps.odoo.com/apps/modules/14.0/accounting_excel_reports/" style="text-decoration: underline;">Odoo 14 Accounting Excel Reports</a>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </data>	om_account_accountant/views/account.xml	\N	\N	728	\N	extension	t	1	2025-08-28 11:33:21.441024	1	2025-08-28 11:33:21.441024	f
1135	payment.acquirer.view.form.inherit.transfer	payment.acquirer	\N	16	form	<?xml version="1.0"?>\n<data><page name="acquirer_credentials" position="attributes">\n                <attribute name="attrs">{'invisible': [('provider', 'in', ['manual', 'transfer'])]}</attribute>\n            </page>\n            <field name="pre_msg" position="attributes">\n                <attribute name="attrs">{'invisible': [('provider', '=', 'transfer')]}</attribute>\n            </field>\n            <field name="done_msg" position="attributes">\n                <attribute name="attrs">{'invisible': [('provider', '=', 'transfer')]}</attribute>\n            </field>\n            <field name="cancel_msg" position="attributes">\n                <attribute name="attrs">{'invisible': [('provider', '=', 'transfer')]}</attribute>\n            </field>\n        </data>	payment_transfer/views/payment_views.xml	\N	\N	1003	\N	extension	t	1	2025-08-28 11:33:22.707653	1	2025-08-28 11:33:22.707653	f
1124	res.config.settings.view.form.inherit.delivery.stock	res.config.settings	\N	16	form	<?xml version="1.0"?>\n<data><xpath expr="//field[@name='module_stock_sms']" position="replace">\n                <field name="stock_move_sms_validation"/>\n            </xpath>\n            <xpath expr="//label[@for='module_stock_sms']" position="replace">\n                <label for="stock_move_sms_validation" string="SMS Confirmation"/>\n            </xpath>\n            <xpath expr="//div[@id='stock_confirmation_sms']" position="replace">\n                <div class="row mt16" attrs="{'invisible': [('stock_move_sms_validation', '=', False)]}">\n                    <label for="stock_sms_confirmation_template_id" string="SMS Template" class="col-lg-4 o_light_label"/>\n                    <field name="stock_sms_confirmation_template_id" class="oe_inline" attrs="{'required': [('stock_move_sms_validation', '=', True)]}" context="{'default_model': 'stock.picking'}"/>\n                </div>\n                <widget name="iap_buy_more_credits" service_name="sms" attrs="{'invisible': [('stock_move_sms_validation', '=', False)]}"/>\n            </xpath>\n        </data>	stock_sms/views/res_config_settings_views.xml	\N	\N	902	\N	extension	t	1	2025-08-28 11:33:16.036307	1	2025-08-28 11:33:16.036307	f
1126	account_invoice_line_facturx_export	\N	account_edi_facturx.account_invoice_line_facturx_export	16	qweb	<?xml version="1.0"?>\n<t t-name="account_edi_facturx.account_invoice_line_facturx_export">\n            <t t-set="line" t-value="line_values['line']"/>\n            <t xmlns:ram="urn:un:unece:uncefact:data:standard:ReusableAggregateBusinessInformationEntity:100" xmlns:rsm="urn:un:unece:uncefact:data:standard:CrossIndustryInvoice:100" xmlns:udt="urn:un:unece:uncefact:data:standard:UnqualifiedDataType:100">\n                <ram:IncludedSupplyChainTradeLineItem>\n                    <!-- Line number. -->\n                    <ram:AssociatedDocumentLineDocument>\n                        <ram:LineID t-esc="line_values['index']"/>\n                    </ram:AssociatedDocumentLineDocument>\n\n                    <!-- Product. -->\n                    <ram:SpecifiedTradeProduct>\n                        <ram:GlobalID schemeID="0160" t-if="line.product_id and line.product_id.barcode" t-esc="line.product_id.barcode"/>\n                        <ram:SellerAssignedID t-if="line.product_id and line.product_id.default_code" t-esc="line.product_id.default_code"/>\n                        <!-- TODO:\n                        <ram:Name t-esc="line.product_id.name or line.name"/>\n                        <ram:Description t-esc="line.name" t-if="line.name != line.product_id.name"/>\n                        -->\n                        <ram:Name t-esc="line.name"/>\n                    </ram:SpecifiedTradeProduct>\n\n                    <!-- Amounts. -->\n                    <ram:SpecifiedLineTradeAgreement>\n                        <!-- Line information, with discount and unit price separate -->\n                        <t t-set="net_amount" t-value="line.price_subtotal/line.quantity if line.quantity else 0"/>\n                        <ram:GrossPriceProductTradePrice>\n                            <ram:ChargeAmount t-esc="format_monetary(line_values['gross_price_total_unit'], currency)"/>\n\n                            <!-- Discount. -->\n                            <ram:AppliedTradeAllowanceCharge t-if="line.discount">\n                                <ram:ChargeIndicator>\n                                    <udt:Indicator>false</udt:Indicator>\n                                </ram:ChargeIndicator>\n                                <ram:ActualAmount t-esc="format_monetary(line_values['price_discount_unit'], currency)"/>\n                            </ram:AppliedTradeAllowanceCharge>\n                        </ram:GrossPriceProductTradePrice>\n                        <!-- Line unit price, with discount applied -->\n                        <ram:NetPriceProductTradePrice>\n                            <ram:ChargeAmount t-esc="format_monetary(net_amount, currency)"/>\n                        </ram:NetPriceProductTradePrice>\n                    </ram:SpecifiedLineTradeAgreement>\n\n                    <!-- Quantity. -->\n                    <ram:SpecifiedLineTradeDelivery>\n                        <ram:BilledQuantity t-att-unitCode="line_values['unece_uom_code']" t-esc="line.quantity"/>\n                    </ram:SpecifiedLineTradeDelivery>\n\n                    <ram:SpecifiedLineTradeSettlement>\n                        <t t-foreach="line_values['tax_details']" t-as="tax_vals">\n                            <t t-set="tax" t-value="tax_vals['tax']"/>\n                            <ram:ApplicableTradeTax t-if="tax.amount_type == 'percent'">\n                                <ram:TypeCode>VAT</ram:TypeCode>\n                                <ram:CategoryCode t-esc="tax_vals['unece_tax_category_code']"/>\n                                <ram:RateApplicablePercent t-esc="tax.amount"/>\n                            </ram:ApplicableTradeTax>\n                        </t>\n                        <!-- Subtotal. -->\n                        <ram:SpecifiedTradeSettlementLineMonetarySummation>\n                            <ram:LineTotalAmount t-esc="format_monetary(line.price_subtotal, currency)"/>\n                        </ram:SpecifiedTradeSettlementLineMonetarySummation>\n                    </ram:SpecifiedLineTradeSettlement>\n\n                </ram:IncludedSupplyChainTradeLineItem>\n            </t>\n        </t>\n\n        	account_edi_facturx/data/facturx_templates.xml	\N	\N	\N	\N	primary	t	1	2025-08-28 11:33:17.016378	1	2025-08-28 11:33:17.016378	f
1125	stock_confirm_sms	confirm.stock.sms	\N	16	form	<?xml version="1.0"?>\n<form string="SMS">\n                You are about to confirm this Delivery Order by SMS Text Message.<br/>\n                This feature can easily be disabled from the Settings of Inventory or by clicking on "Disable SMS".<br/>\n                <footer>\n                    <button name="send_sms" type="object" string="Confirm" class="oe_highlight"/>\n                    <button name="dont_send_sms" type="object" string="Disable SMS" class="btn btn-secondary"/>\n                    <button special="cancel" string="Cancel"/>\n                </footer>\n            </form>\n        	stock_sms/wizard/confirm_stock_sms_views.xml	\N	\N	\N	\N	primary	t	1	2025-08-28 11:33:16.036307	1	2025-08-28 11:33:16.036307	f

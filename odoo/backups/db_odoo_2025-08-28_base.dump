v class="col-3">Alamat</div>\n                        <div class="col-6">: <t t-esc="o['partner_id']['street']"/></div>\n                    </div>\n                    <div class="row">\n                        <div class="col-3">Berat Lahir</div>\n                        <div class="col-6">: <t t-esc="data['berat-lahir']"/> kg</div>\n                    </div>\n                    <div class="row">\n                        <div class="col-3">Panjang Badan</div>\n                        <div class="col-6">: <t t-esc="data['panjang-lahir']"/> cm</div>\n                    </div>\n                    <div class="row">\n                        <div class="col-3">Diberi Nama</div>\n                        <div class="col-6">: <strong><t t-esc="data['nama-bayi']"/></strong></div>\n                    </div>\n                </div>\n                <p class="mt-3">Demikian Surat Keterangan Kelahiran ini dibuat dengan sesungguhnya untuk dipergunakan sebagaimana mestinya.</p><br/>\n              </div>\n            </div>\n\n            <div class="row pt-5">\n                <div class="col-1"/>\n                <div class="col-3 mt-4">\n                    <p class="mb-0">Validasi</p>\n                    <div class="mt-3" id="qrcode">\n                        <img t-att-src="o['qr_code_url']" style="width:125px;height:125px;"/>\n                    </div>\n                </div>\n                <div class="col-4"/>\n                <div class="col-4">\n                    <p class="mb-0"><t t-esc="o['operating_unit_id']['company_id']['city']"/>, <t t-esc="o.to_date_string(data['registration_date'])"/></p>\n                    <p class="mb-0">Bidan Pemeriksa</p>\n                    <div class="mt-3" id="qrcode">\n                        <!-- <t t-if="'qr_code_examiner_url' in data"> -->\n                          <!-- <img t-att-src="data['qr_code_examiner_url']" style="width:125px;height:125px;"/> -->\n                        <!-- </t> -->\n                        <!-- <t t-else=""> -->\n                          <div style="width:125px;height:125px;"/>\n                        <!-- </t> -->\n                    </div>\n                    <p class="mb-0 mt-2"><strong>\n                    <t t-if="'examiner_name' in data">\n                      <t t-esc="data['examiner_name']"/>\n                    </t>\n                    <t t-else="">\n                      <t t-esc="data['sender']"/>\n                    </t>\n                    </strong></p>\n                </div>\n            </div>\n          </div>\n        </t>\n      </t>\n    	ehealth_document/report/template_surat_kelahiran/report_pmbfatma_surat_kelahiran.xml	\N	\N	\N	\N	primary	t	1	2025-08-28 11:34:01.364376	1	2025-08-28 11:34:01.364376	f
675	account.tax.search	account.tax	\N	16	search	<?xml version="1.0"?>\n<search string="Search Taxes">\n                    <field name="name" filter_domain="['|', ('name','ilike',self), ('description','ilike',self)]" string="Tax"/>\n                    <field name="company_id" groups="base.group_multi_company"/>\n                    <filter string="Sale" name="sale" domain="[('type_tax_use','=','sale')]"/>\n                    <filter string="Purchase" name="purchase" domain="[('type_tax_use','=','purchase')]"/>\n                    <separator/>\n                    <filter string="Services" name="service" domain="[('tax_scope','=','service')]"/>\n                    <filter string="Goods" name="goods" domain="[('tax_scope','=','consu')]"/>\n                    <separator/>\n                    <filter name="active" string="Active" domain="[('active','=',True)]" help="Show active taxes"/>\n                    <filter name="inactive" string="Inactive" domain="[('active','=',False)]" help="Show inactive taxes"/>\n                    <group string="Group By">\n                        <filter string="Company" name="company" domain="[]" context="{'group_by':'company_id'}" groups="base.group_multi_company"/>\n                        <filter string="Tax Type" name="taxapp" domain="[]" context="{'group_by':'type_tax_use'}"/>\n                        <filter string="Tax Scope" name="taxapp" domain="[]" context="{'group_by':'tax_scope'}"/>\n                    </group>\n                </search>\n            	account/views/account_tax_views.xml	\N	\N	\N	\N	primary	t	1	2025-08-28 11:32:28.994214	1	2025-08-28 11:32:28.994214	f

814	stock.track.confirmation.view.form	stock.track.confirmation	\N	16	form	<?xml version="1.0"?>\n<form string="Lots or serial numbers were not provided to tracked products">\n                <field name="inventory_id" invisible="1"/>\n                <p>Some products of the inventory adjustment are tracked. Are you sure you don't want to specify a serial or lot number for them?</p>\n                <strong>Product(s) tracked: </strong>\n                <field name="tracking_line_ids" readonly="1">\n                    <tree>\n                        <field name="product_id"/>\n                        <field name="tracking"/>\n                    </tree>\n                </field>\n                <footer>\n                    <button name="action_confirm" string="Confirm" type="object" class="btn-primary"/>\n                    <button string="Discard" special="cancel" class="btn-secondary"/>\n                </footer>\n            </form>\n        	stock/wizard/stock_track_confirmation_views.xml	\N	\N	\N	\N	primary	t	1	2025-08-28 11:32:42.235962	1	2025-08-28 11:32:42.235962	f
813	Replenish	product.replenish	\N	16	form	<?xml version="1.0"?>\n<form string="Replenish wizard">\n                <p>\n                Use this assistant to replenish your stock.\n                Depending on your product configuration, launching a replenishment may trigger a request for quotation,\n                a manufacturing order or a transfer.\n                </p>\n                <group>\n                    <field name="product_tmpl_id" invisible="1"/>\n                    <field name="product_has_variants" invisible="1"/>\n                    <field name="product_id" domain="[('product_tmpl_id', '=', product_tmpl_id)]" attrs="{'readonly': [('product_has_variants', '=', False)]}" options="{'no_create_edit':1}"/>\n                    <field name="product_uom_category_id" invisible="1"/>\n                    <label for="quantity"/>\n                    <div class="o_row">\n                        <field name="quantity"/>\n                        <field name="product_uom_id" domain="[('category_id', '=', product_uom_category_id)]" groups="uom.group_uom"/>\n                    </div>\n                    <field name="date_planned"/>\n                    <field name="warehouse_id" groups="stock.group_stock_multi_warehouses"/>\n                    <field name="route_ids" widget="many2many_tags"/>\n                    <field name="company_id" invisible="1"/>\n                </group>\n                <footer>\n                    <button name="launch_replenishment" string="Confirm" type="object" class="btn-primary"/>\n                    <button string="Discard" class="btn-secondary" special="cancel"/>\n                </footer>\n            </form>\n        	stock/wizard/product_replenish_views.xml	\N	\N	\N	\N	primary	t	1	2025-08-28 11:32:42.235962	1	2025-08-28 11:32:42.235962	f
1692	report_default_surat_laik_terbang	\N	ehealth_document.report_default_surat_laik_terbang	16	qweb	<?xml version="1.0"?>\n<t t-name="ehealth_document.report_default_surat_laik_terbang">\n        <t t-set="company" t-value="res_company"/>\n        <t t-call="web.external_layout">\n          <t t-set="o" t-value="o.with_context(lang=lang)"/> \n          <div class="page">\n            <div class="row">\n              <div class="col-md-12">\n                <p class="text-center mt-3 mb-0"><strong>SURAT KETERANGAN LAIK TERBANG</strong></p>\n                <p class="text-center">Nomor: <t t-esc="o['name']"/></p>\n                <div class="mt-4">\n                  <div><strong>Kepada yth</strong></div>\n                  <div><strong>Maskapai Penerbangan</strong></div>\n                  <div><strong><t t-esc="data['maskapai-penerbangan']"/></strong></div>\n                </div>\n                <p class="mt-2">Yang bertanda tangan di bawah ini menerangkan bahwa:</p>\n                <div class="mt-3 ml-3">\n                    <div class="row">\n                        <div class="col-3">\n                          <t t-if="o['partner_id']['identity_type'] == 'ktp'">NIK</t>\n                          <t t-if="o['partner_id']['identity_type'] == 'sim'">No. SIM</t>\n                          <t t-if="o['partner_id']['identity_type'] == 'paspor'">No. Paspor</t>\n                        </div>\n                        <div class="col-6">: \n                          <t t-if="o['partner_id']['identity_type'] == 'ktp'"><t t-esc="o['partner_id']['nik']"/></t>\n                          <t t-else=""><t t-esc="o['partner_id']['identity_number']"/></t>\n                        </div>\n                    </div>\n                    <div class="row">\n                        <div class="col-3">Nama</div>\n                        <div class="col-6">: <t t-esc="o['partner_id']['name']"/></div>\n                    </div>\n                    <div class="row">\n                        <div class="col-3">Tanggal Lahir</div>\n                        <div class="col-6">: <t t-esc="o['partner_id']['birthDate'].strftime('%d-%m-%Y')"/></div>\n                    </div>\n                    <div class="row">\n                        <div class="col-3">Jenis Kelamin</div>\n                        <div class="col-6">: \n                          <t t-if="o['partner_id']['gender'] == 'male'">Laki-Laki</t>\n                          <t t-else="">Perempuan</t>\n                        </div>\n                    </div>\n                    <div class="row">\n                        <div class="col-3">Pekerjaan</div>\n                        <div class="col-6">: <t t-esc="o['partner_id']['function']"/></div>\n                    </div>\n                    <div class="row">\n                        <div class="col-3">Alamat</div>\n                        <div class="col-6">: <t t-esc="o['partner_id']['street']"/></div>\n                    </div>\n                </div>\n                <p class="mt-3 mb-2">Dari hasil pemeriksaan yang kami lakukan secara klinis, laboratorium dan pemeriksaan penunjang medis lainnya saat ini dalam keadaan <strong><t t-esc="data['keadaan']"/></strong>.</p>\n                <p>Demikian surat keterangan ini dibuat, agar dapat dipergunakan sebagaimana mestinya.</p><br/>\n              </div>\n            </div>\n\n            <div class="row pt-5">\n                <div class="col-1"/>\n                <div class="col-3 mt-4">\n                    <p class="mb-0">Validasi</p>\n                    <div class="mt-3" id="qrcode">\n                        <img t-att-src="o['qr_code_url']" style="width:125px;height:125px;"/>\n                    </div>\n                </div>\n                <div class="col-4"/>\n                <div class="col-4">\n                    <p class="mb-0"><t t-esc="o['operating_unit_id']['company_id']['city']"/>, <t t-esc="o.to_date_string(data['registration_date'])"/></p>\n                    <p class="mb-0">Dokter Pemeriksa</p>\n                    <div class="mt-3" id="qrcode">\n                          <div style="width:125px;height:125px;"/>\n                    </div>\n                    <p class="mb-0 mt-2"><strong>\n                    <t t-if="'examiner_name' in data">\n                      <t t-esc="data['examiner_name']"/>\n                    </t>\n                    <t t-else="">\n                      <t t-esc="data['sender']"/>\n                    </t>\n                    </strong></p>\n                </div>\n            </div>\n          </div>\n        </t>\n      </t>\n    	ehealth_document/report/template_surat_laik_terbang/report_default_surat_laik_terbang.xml	\N	\N	\N	\N	primary	t	1	2025-08-28 11:34:01.364376	1	2025-08-28 11:34:01.364376	f

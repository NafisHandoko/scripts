1332	res.partner.form.inherit	res.partner	\N	16	form	<?xml version="1.0"?>\n<data><xpath expr="//field[@name='type']" position="before">\n                    <field name="vendor_code" string="Vendor Code" attrs="{'invisible': [('is_company','=', False)]}"/>\n                </xpath>\n\n                <field name="vat" position="after">\n                    <field name="identity_type" string="Identity Type" attrs="{'invisible': [('is_company','=', True)]}"/>\n                    <field name="identity_number" string="Identity Number" attrs="{'invisible': [('is_company','=', True)]}"/>\n                    <field name="medical_record" string="No. MR" attrs="{'invisible': [('is_company','=', True)]}"/>\n                    <field name="religion" string="Religion" attrs="{'invisible': [('is_company','=', True)]}"/>\n                    <field name="birth_place" string="Birth Place" attrs="{'invisible': [('is_company','=', True)]}"/>\n                    <field name="birthDate" string="Birth Date" attrs="{'invisible': [('is_company','=', True)]}"/>\n                    <field name="gender" string="Gender" attrs="{'invisible': [('is_company','=', True)]}"/>\n                </field>\n\n                <xpath expr="//page[@name='internal_notes']" position="after">\n                    <page name="partner_identifier" string="Identifier">\n                        <field name="identifier" widget="one2many" class="o_light_label">\n                            <tree editable="bottom">\n                                <field name="type"/>\n                                <field name="value"/>\n                                <field name="is_active"/>\n                            </tree>\n                        </field>\n                    </page>\n                </xpath>\n\n                <xpath expr="//button[@name='action_view_partner_invoices']" position="before">\n                    <button type="object" class="oe_stat_button outstanding_credit" icon="fa-money" name="action_view_partner_payment" context="{'default_partner_id': active_id}">\n                        <div class="o_form_field o_stat_info">\n                            <span class="o_stat_value">\n                                <field name="currency_id" invisible="1"/>\n                                <field name="total_outstanding_credit" widget="monetary" options="{'currency_field': 'currency_id'}"/>\n                            </span>\n                            <span class="o_stat_text">Outstanding Credit</span>\n                        </div>\n                    </button>\n                </xpath>\n            </data>	ehealth/views/partner.xml	\N	\N	118	\N	extension	t	1	2025-08-28 11:33:43.631866	1	2025-08-28 11:33:43.631866	f

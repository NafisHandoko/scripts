   </t>\n              </div>\n              <div class="pl-2 row">\n                <div class="col-2">\n                  <p>Ekstremitas</p>\n                </div>\n                <t t-if="'extremities' in data['doc_parts']">\n                  <div class="col-4">\n                    <p><span class="pr-2">:</span>\n                      <t t-esc="data['doc_parts']['extremities']"/>\n                    </p>\n                  </div>\n                </t>\n              </div>\n              <div class="pl-2 row">\n                <div class="col-2">\n                  <p>Akses Vaskuler</p>\n                </div>\n                <t t-if="'procedure_hd' in data['doc_parts'] and 'akses-vaskuler' in data['doc_parts']['procedure_hd']">\n                  <div class="col-4">\n                    <p><span class="pr-2">:</span>\n                      <t t-esc="data['doc_parts']['procedure_hd']['akses-vaskuler']"/>\n                    </p>\n                  </div>\n                </t>\n              </div>\n            </div>\n\n            <div class="mt-2 ml-1">\n              <div class="row">\n                <div class="col-2 p-0 ml-2">Priming</div>\n                <div>: ...</div>\n              </div>\n              <div class="row">\n                <div class="col-2 p-0 ml-2">Sirk. Dalam</div>\n                <div>: ...</div>\n              </div>\n              <div class="row">\n                <div class="col-2 p-0 ml-2">Inisiasi</div>\n                <div>: ...</div>\n              </div>\n              <div class="row">\n                <div class="col-2 p-0 ml-2">Terminasi</div>\n                <div>: ...</div>\n              </div>\n            </div>\n\n\n            <!-- <div class="row pt-5">\n                <div class="col-8"></div>\n                <div class="col-4">\n                    <p class="mb-0"><t t-esc="o['operating_unit_id']['company_id']['city']"/>, <t t-esc="o.to_date_string(data['registration_date'])"/></p>\n                
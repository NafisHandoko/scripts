1391	pharmacy_purchase_order_general_document	\N	ehealth.pharmacy_purchase_order_general_document	16	qweb	<?xml version="1.0"?>\n<t t-name="ehealth.pharmacy_purchase_order_general_document">\n            <t t-set="pharmacy_name" t-value="o.company_id.pharmacy_company_name"/>\n            <t t-set="pharmacy_register" t-value="o.company_id.pharmacy_register"/>\n            <t t-set="pharmacy_address" t-value="o.company_id.street"/>\n            <t t-set="pharmacy_phone" t-value="o.company_id.phone"/>\n            <t t-set="apothecary_in_charge" t-value="o.company_id.apothecary_in_charge"/>\n            <t t-if="o.operating_unit_id.pharmacy_register">\n                <t t-set="pharmacy_name" t-value="o.operating_unit_id.pharmacy_name"/>\n                <t t-set="pharmacy_register" t-value="o.operating_unit_id.pharmacy_register"/>\n                <t t-set="pharmacy_address" t-value="o.operating_unit_id.address"/>\n                <t t-set="pharmacy_phone" t-value="o.operating_unit_id.phone"/>\n                <t t-set="apothecary_in_charge" t-value="o.operating_unit_id.apothecary_in_charge"/>\n            </t>\n\n            <t t-call="web.external_layout">\n                <t t-set="o" t-value="o.with_context(lang=o.partner_id.lang)"/>\n                <div class="text-center">\n                    <strong>SURAT PESANAN OBAT</strong>\n                </div>\n                <div class="text-center">\n                    Nomor: <t t-esc="o._get_pharmacy_purchase_order_number()"/>\n                </div>\n                <div>\n                    <p>Yang bertanda tangan di bawah ini:</p>\n                    <table class="table table-borderless table-sm">\n                        <tr>\n                            <td width="180">Nama</td>\n                            <td>: <t t-esc="apothecary_in_charge.name"/></td>\n                        </tr>\n                        <tr>\n                            <td>Jabatan</td>\n                            <td>: Apoteker</td>\n                        </tr>\n                        <tr>\n                            <td>No. SIPA</td>\n                            <td>: <t t-esc="apothecary_in_charge.sipa"/></td>\n                        </tr>\n                    </table>\n                </div>\n                <div>\n                    <p>Mengajukan pesanan obat kepada:</p>\n                    <table class="table table-borderless table-sm">\n                        <tr>\n                            <td width="180">Nama PBF</td>\n                            <td>: <span t-field="o.partner_id.name"/></td>\n                        </tr>\n                        <tr>\n                            <td>Alamat</td>\n                            <td>: <span t-esc="o.partner_id._display_address(True)"/> </td>\n                        </tr>\n                        <tr>\n                            <td>Telp</td>\n                            <td>: <span t-field="o.partner_id.phone"/></td>\n                        </tr>\n                    </table>\n                </div>\n                <div>\n                    <p>Jenis obat-obatan untuk keperluan Apotek sebagai berikut:</p>\n                </div>\n                <div class="page">\n                    <div class="oe_structure"/>\n\n                    <table class="table table-sm o_main_table">\n                        <thead>\n                            <tr>\n                                <th name="th_number" class="text-center" style="vertical-align: middle;"><strong>No</strong></th>\n                                <th name="th_name" class="text-center" width="25%" style="vertical-align: middle;"><strong>Nama Obat</strong></th>\n                                <th name="th_quantity" class="text-center" style="vertical-align: middle;"><strong>Jumlah</strong></th>\n                                <th name="th_notes" class="text-center" style="vertical-align: middle;"><strong>Ket</strong></th>\n                            </tr>\n                        </thead>\n                        <tbody>\n                            <t t-set="current_subtotal" t-value="0"/>\n                            <t t-set="data_number" t-value="1"/>\n                            <t t-foreach="o.order_line" t-as="line">\n                                <t t-set="current_subtotal" t-value="current_subtotal + line.price_subtotal" groups="account.group_show_line_subtotals_tax_excluded"/>\n                                <t t-set="current_subtotal" t-value="current_subtotal + line.price_total" groups="account.group_show_line_subtotals_tax_included"/>\n\n                                <tr t-att-class="'bg-200 font-weight-bold o_line_section' if line.display_type == 'line_section' else 'font-italic o_line_note' if line.display_type == 'line_note' else ''">\n                                    <t t-if="not line.display_type">\n                                        <td class="text-center">\n                                            <t t-esc="data_number"/>\n                                        </td>\n                                        <td>\n                                            <span t-field="line.name"/>\n                                        </td>\n                                        <td class="text-center">\n                                            <span t-field="line.product_qty" t-options="{&quot;widget&quot;: &quot;float&quot;, &quot;precision&quot;: 0}"/> <span t-field="line.product_uom"/>\n                                        </td>\n                                        <td class="text-center">\n                                            <span t-field="line.notes"/>\n                                        </td>\n                                    </t>\n                                </tr>\n                                <t t-set="data_number" t-value="data_number + 1"/>\n                            </t>\n                        </tbody>\n                    </table>\n\n                    <p t-field="o.notes"/>\n                    <div class="oe_structure"/>\n                </div>\n                <div>\n                    <p>Obat-obatan tersebut akan digunakan untuk memenuhi kebutuhan:</p>\n                    <table class="table table-borderless table-sm">\n                        <tr>\n                            <td width="180">Nama Apotek</td>\n                            <td>: <t t-esc="pharmacy_name"/></td>\n                        </tr>\n                        <tr>\n                            <td>Alamat Lengkap</td>\n                            <td>: <t t-esc="pharmacy_address"/></td>\n                        </tr>\n                        <tr>\n                            <td>Nomor Ijin Apotek</td>\n                            <td>: <t t-esc="pharmacy_register"/></td>\n                        </tr>\n                        <tr>\n                            <td>Telp</td>\n                            <td>: <t t-esc="pharmacy_phone"/></td>\n                        </tr>\n                    </table>\n                </div>\n                <div class="row pt-5 text-left">\n                    <div class="col-5 py-3"/>\n                    <div class="col-5 offset-2">\n                        <p><t t-esc="o.company_id.city"/>, <t t-esc="o.to_date_string(o.date_order)"/></p>\n                        <p><t t-esc="apothecary_in_charge.name"/></p>\n                        <br/>\n                        <br/>\n                        <br/>\n                        <p>No. SIPA: <t t-esc="apothecary_in_charge.sipa"/></p>\n                    </div>\n              </div>\n            </t>\n        </t>\n    	ehealth/reports/pharmacy_purchase_order_general_report.xml	\N	\N	\N	\N	primary	t	1	2025-08-28 11:33:43.631866	1	2025-08-28 11:33:43.631866	f

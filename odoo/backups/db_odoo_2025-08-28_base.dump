t-5 mr-5">\n              <div class="col-9"/>\n              <div class="col-3">\n                <p class="mb-0">Bandung, <t t-esc="o.to_date_string(data['registration_date'])"/></p>\n                <p>Dokter Pemeriksa</p>\n              </div>\n            </div>\n            <div class="d-flex justify-content-end" style="margin-top: 125px;">\n                <p><strong>\n                ( Dr. Prayudi Santoso, Sp.PD-KP., FCCP., M.Kes )\n                </strong></p>\n            </div>\n          </div>\n        </t>\n      </t>\n    	ehealth_document/report/template_surat_sakit/report_drprayudi_surat_sakit.xml	\N	\N	\N	\N	primary	t	1	2025-08-28 11:34:01.364376	1	2025-08-28 11:34:01.364376	f

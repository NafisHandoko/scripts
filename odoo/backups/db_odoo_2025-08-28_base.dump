486	product.pricelist.form	product.pricelist	\N	16	form	<?xml version="1.0"?>\n<form string="Products Price List">\n                    <sheet>\n                        <widget name="web_ribbon" title="Archived" bg_color="bg-danger" attrs="{'invisible': [('active', '=', True)]}"/>\n                        <div class="oe_title">\n                            <h1><field name="name" placeholder="e.g. USD Retailers"/></h1>\n                        </div>\n                        <group>\n                          <group name="pricelist_settings">\n                              <field name="currency_id" groups="base.group_multi_currency"/>\n                              <field name="active" invisible="1"/>\n                              <field name="company_id" groups="base.group_multi_company" options="{'no_create': True}"/>\n                          </group>\n                        </group>\n                        <notebook>\n                            <page name="pricelist_rules" string="Price Rules">\n                              <field name="item_ids" nolabel="1" context="{'default_base':'list_price'}">\n                                  <tree string="Pricelist Items" editable="bottom">\n                                      <field name="product_tmpl_id" string="Products" required="1"/>\n                                      <field name="product_id" string="Variants" groups="product.group_product_variant" domain="[('product_tmpl_id', '=', product_tmpl_id)]" options="{'no_create':1}"/>\n                                      <field name="min_quantity"/>\n                                      <field name="fixed_price" string="Price"/>\n                                      <field name="currency_id" invisible="1"/>\n                                      <field name="pricelist_id" invisible="1"/>\n                                      <!-- Pricelist ID is here only for related fields to be correctly computed -->\n                                      <field name="date_start"/>\n                                      <field name="date_end"/>\n                                      <field name="base" invisible="1"/>\n                                      <field name="applied_on" invisible="1"/>\n                                      <field name="company_id" invisible="1"/>\n                                  </tree>\n                              </field>\n                            </page>\n                            <page name="pricelist_config" string="Configuration">\n                                <group>\n                                    <group name="pricelist_availability" string="Availability">\n                                        <field name="country_group_ids" widget="many2many_tags"/>\n                                    </group>\n                                    <group name="pricelist_discounts" groups="product.group_discount_per_so_line" string="Discounts">\n                                        <field name="discount_policy" widget="radio"/>\n                                    </group>\n                                </group>\n                            </page>\n                        </notebook>\n                    </sheet>\n                </form>\n            	product/views/product_pricelist_views.xml	\N	\N	\N	\N	primary	t	1	2025-08-28 11:32:18.663929	1	2025-08-28 11:32:18.663929	\N
505	crm.team.form	crm.team	\N	16	form	<?xml version="1.0"?>\n<form string="Sales Team">\n                <sheet>\n                    <div class="oe_button_box" name="button_box"/>\n                    <widget name="web_ribbon" title="Archived" bg_color="bg-danger" attrs="{'invisible': [('active', '=', True)]}"/>\n                    <div class="oe_title">\n                        <label for="name" class="oe_edit_only" string="Sales Team"/>\n                        <h1>\n                            <field name="name" placeholder="Sales Team name..."/>\n                        </h1>\n                        <div name="options_active"/>\n                    </div>\n                    <group>\n                        <group name="left">\n                            <field name="active" invisible="1"/>\n                            <field name="user_id" domain="[('share', '=', False)]"/>\n                            <field name="company_id" options="{'no_create': True}" groups="base.group_multi_company"/>\n                            <field name="currency_id" invisible="1"/>\n                        </group>\n                        <group name="right">\n                        </group>\n                    </group>\n                    <notebook>\n                        <page name="members" string="Team Members">\n                            <field name="member_ids" widget="many2many" options="{'not_delete': True}">\n                                <kanban quick_create="false" create="true" delete="true">\n                                    <field name="id"/>\n                                    <field name="name"/>\n                                    <templates>\n                                        <t t-name="kanban-box">\n                                            <div class="oe_kanban_global_click" style="max-width: 200px">\n                                                <div class="o_kanban_record_top">\n                                                    <img t-att-src="kanban_image('res.users', 'image_128', record.id.raw_value)" class="oe_avatar oe_kanban_avatar_smallbox o_image_40_cover mb0" alt="Avatar"/>\n                                                    <div class="o_kanban_record_headings ml8">\n                                                        <strong class="o_kanban_record_title"><field name="name"/></strong>\n                                                    </div>\n                                                </div>\n                                            </div>\n                                        </t>\n                                    </templates>\n                                </kanban>\n                            </field>\n                        </page>\n                    </notebook>\n                </sheet>\n                <div class="oe_chatter">\n                    <field name="message_follower_ids" help="Follow this salesteam to automatically track the events associated to users of this team."/>\n                    <field name="message_ids"/>\n                </div>\n            </form>\n        	sales_team/views/crm_team_views.xml	\N	\N	\N	\N	primary	t	1	2025-08-28 11:32:21.966635	1	2025-08-28 11:32:21.966635	\N
1505	template_invoice_swift_rasuna	\N	ehealth_document.template_invoice_swift_rasuna	16	qweb	<?xml version="1.0"?>\n<t t-name="ehealth_document.template_invoice_swift_rasuna">\n            <t t-call="web.external_layout">\n                <t t-set="o" t-value="o.with_context(lang=lang)"/>\n                <div class="page">\n                    <div id="section-identity">\n                        <div class="row">\n                            <div class="col-6">\n                                <div class="row">\n                                    <div class="col-3">Tanggal</div>\n                                    <div class="col-8 text-right"><t t-esc="o['invoice_date'].strftime('%d-%m-%Y')"/></div>\n                                </div>\n                                <div class="row">\n                                    <div class="col-3">Nama</div>\n                                    <div class="col-8 text-right"><t t-esc="o['partner_id']['name']"/></div>\n                                </div>\n                                <div class="row">\n                                    <div class="col-3">Email</div>\n                                    <div class="col-8 text-right"><t t-esc="o['partner_id']['email']"/></div>\n                                </div>\n                            </div>\n                            <div class="col-6">\n                                <div class="row">\n                                    <div class="col-5 offset-2">No. Faktur</div>\n                                    <div class="col-5 text-right"><t t-esc="o['name']"/></div>\n                                </div>\n                                <div class="row">\n                                    <div class="col-5 offset-2">Pembayaran</div>\n                                    <div class="col-5 text-right">Cash</div>\n                                </div>\n                            </div>\n                        </div>\n                    </div>\n                    <div id="section-transaction" class="mt-4">\n                        <table class="table table-sm o_main_table" name="invoice_line_table">\n                            <thead>\n                                <tr>\n                                    <th name="th_quantity" class="text-center"><span>Qty</span></th>\n                                    <th name="th_description" class="text-left"><span>Keterangan</span></th>\n                                    <th name="th_price_unit" t-attf-class="text-center {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}">\n                                        <span>Diskon</span>\n                                    </th>\n                                    <th name="th_priceunit" t-attf-class="text-center {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}"><span>Harga Satuan</span></th>\n                                    <th name="th_subtotal" class="text-right">\n                                        <span groups="account.group_show_line_subtotals_tax_excluded">Jumlah</span>\n                                        <span groups="account.group_show_line_subtotals_tax_included">Total</span>\n                                    </th>\n                                </tr>\n                            </thead>\n                            <tbody class="invoice_tbody">\n                                <t t-set="current_subtotal" t-value="0"/>\n                                <t t-set="lines" t-value="o.invoice_line_ids.sorted(key=lambda l: (-l.sequence, l.date, l.move_name, -l.id), reverse=True)"/>\n\n                                <t t-foreach="lines" t-as="line">\n                                    <t t-set="current_subtotal" t-value="current_subtotal + line.price_subtotal" groups="account.group_show_line_subtotals_tax_excluded"/>\n                                    <t t-set="current_subtotal" t-value="current_subtotal + line.price_total" groups="account.group_show_line_subtotals_tax_included"/>\n\n                                    <tr t-att-class="'bg-200 font-weight-bold o_line_section' if line.display_type == 'line_section' else 'font-italic o_line_note' if line.display_type == 'line_note' else ''">\n                                        <t t-if="not line.display_type" name="account_invoice_line_accountable">\n                                            <td class="text-center">\n                                                <span t-field="line.quantity"/>\n                                            </td>\n                                            <td name="account_invoice_line_name"><span t-field="line.name" t-options="{'widget': 'text'}"/></td>\n                                            <td t-attf-class="text-center">\n                                                <span class="text-nowrap" t-field="line.discount"/>\n                                            </td>\n                                            <td t-attf-class="text-center {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}">\n                                                <span class="text-nowrap" t-field="line.price_unit"/>\n                                            </td>\n                                            <td class="text-right o_price_total">\n                                                <span class="text-nowrap" t-field="line.price_subtotal"/>\n                                            </td>\n                                        </t>\n                                        <t t-if="line.display_type == 'line_section'">\n                                            <td colspan="99">\n                                                <span t-field="line.name" t-options="{'widget': 'text'}"/>\n                                            </td>\n                                            <t t-set="current_section" t-value="line"/>\n                                            <t t-set="current_subtotal" t-value="0"/>\n                                        </t>\n                                        <t t-if="line.display_type == 'line_note'">\n                                            <td colspan="99">\n                                                <span t-field="line.name" t-options="{'widget': 'text'}"/>\n                                            </td>\n                                        </t>\n                                    </tr>\n\n                                    <t t-if="current_section and (line_last or lines[line_index+1].display_type == 'line_section')">\n                                        <tr class="is-subtotal text-right">\n                                            <td colspan="99">\n                                                <strong class="mr16">Subtotal</strong>\n                                                <span t-esc="current_subtotal" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: o.currency_id}"/>\n                                            </td>\n                                        </tr>\n                                    </t>\n                                </t>\n                            </tbody>\n                        </table>\n\n                        <div class="clearfix">\n                            <div id="total" class="row">\n                                <div t-attf-class="#{'col-6' if report_type != 'html' else 'col-sm-7 col-md-6'} ml-auto">\n                                    <table class="table table-sm" style="page-break-inside: avoid;">\n                                        <tr class="border-black o_subtotal" style="">\n                                            <td><strong>Subtotal</strong></td>\n                                            <td class="text-right">\n                                                <span t-field="o.amount_untaxed"/>\n                                            </td>\n                                        </tr>\n                                        <t t-foreach="o.amount_by_group" t-as="amount_by_group">\n                                            <tr style="">\n                                                <t t-if="len(o.line_ids.filtered(lambda line: line.tax_line_id)) in [0, 1] and o.amount_untaxed == amount_by_group[2]">\n                                                    <td>\n                                                        <t t-if="amount_by_group[0] == 'Taxes'">\n                                                            <span>Pajak</span>\n                                                        </t>\n                                                        <t t-else="">\n                                                            <span class="text-nowrap" t-esc="amount_by_group[0]"/>\n                                                        </t>\n                                                    </td>\n                                                    <td class="text-right o_price_total">\n                                                        <span class="text-nowrap" t-esc="amount_by_group[3]"/>\n                                                    </td>\n                                                </t>\n                                                <t t-else="">\n                                                    <td>\n                                                        <span t-esc="amount_by_group[0]"/>\n                                                        <span class="text-nowrap"> on\n                                                            <t t-esc="amount_by_group[4]"/>\n                                                        </span>\n                                                    </td>\n                                                    <td class="text-right o_price_total">\n                                                        <span class="text-nowrap" t-esc="amount_by_group[3]"/>\n                                                    </td>\n                                                </t>\n                                            </tr>\n                                        </t>\n                                        <tr class="border-black o_total">\n                                            <td><strong>Total Pembayaran</strong></td>\n                                            <td class="text-right">\n                                                <span class="text-nowrap" t-field="o.amount_total"/>\n                                            </td>\n                                        </tr>\n                                        <t t-if="o.payment_state != 'invoicing_legacy'">\n                                            <t t-set="payments_vals" t-value="o.sudo()._get_reconciled_info_JSON_values()"/>\n                                            <t t-foreach="payments_vals" t-as="payment_vals">\n                                                <tr>\n                                                    <td>\n                                                        <i class="oe_form_field text-right oe_payment_label">Dibayarkan pada <t t-esc="payment_vals['date'].strftime('%d-%m-%Y')"/></i>\n                                                    </td>\n                                                    <td class="text-right">\n                                                        <span t-esc="payment_vals['amount']" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: o.currency_id}"/>\n                                                    </td>\n                                                </tr>\n                                            </t>\n                                        </t>\n                                    </table>\n                                </div>\n                            </div>\n                        </div>\n                    </div>\n                    <hr/>\n                    <div id="section-summary" class="mt-4">\n                        <p><strong>Detail Pembayaran</strong></p>\n                        <div class="row">\n                            <div class="col-2">Nama Bank</div>\n                            <div class="col-3">BCA</div>\n                        </div>\n                        <div class="row">\n                            <div class="col-2">Cabang</div>\n                            <div class="col-3">Rasuna</div>\n                        </div>\n                        <div class="row">\n                            <div class="col-2">Nama Akun</div>\n                            <div class="col-3">Radhian Nur Auliya</div>\n                        </div>\n                        <div class="row">\n                            <div class="col-2">Nomor Akun</div>\n                            <div class="col-3">6801053375</div>\n                        </div>\n                    </div>\n                    <div id="section-notes" class="mt-4">\n                        <p><strong>Catatan</strong></p>\n                        <div>\n                            <span>1. Refund biaya tidak berlaku</span><br/>\n                        </div>\n                    </div>\n                </div>\n            </t>\n        </t>\n    	ehealth_document/report/template_invoice/template_invoice_swift_rasuna.xml	\N	\N	\N	\N	primary	t	1	2025-08-28 11:34:01.364376	1	2025-08-28 11:34:01.364376	f
506	crm.team.tree	crm.team	\N	16	tree	<?xml version="1.0"?>\n<tree string="Sales Team" sample="1" multi_edit="1">\n                <field name="sequence" widget="handle"/>\n                <field name="name" readonly="1"/>\n                <field name="active" invisible="1"/>\n                <field name="user_id" domain="[('share', '=', False)]"/>\n                <field name="company_id" groups="base.group_multi_company"/>\n            </tree>\n        	sales_team/views/crm_team_views.xml	\N	\N	\N	child_ids	primary	t	1	2025-08-28 11:32:21.966635	1	2025-08-28 11:32:21.966635	\N
1506	template_invoice_default	\N	ehealth_document.template_invoice_default	16	qweb	<?xml version="1.0"?>\n<t t-name="ehealth_document.template_invoice_default">\n            <t t-call="web.external_layout">\n                    <t t-set="o" t-value="o.with_context(lang=lang)"/>\n                    <t t-set="address">\n                        <address t-field="o.partner_id" t-options="{&quot;widget&quot;: &quot;contact&quot;, &quot;fields&quot;: [&quot;address&quot;, &quot;name&quot;], &quot;no_marker&quot;: True}"/>\n                        <div t-if="o.partner_id.vat" class="mt16">\n                            <t t-if="o.company_id.country_id.vat_label" t-esc="o.company_id.country_id.vat_label" id="inv_tax_id_label"/>\n                            <t t-else="">Tax ID</t>: <span t-field="o.partner_id.vat"/></div>\n                    </t>\n                    <div class="page">\n                        <h2>\n                            <span t-if="o.move_type == 'out_invoice' and o.state == 'posted'">Invoice</span>\n                            <span t-if="o.move_type == 'out_invoice' and o.state == 'draft'">Draft Invoice</span>\n                            <span t-if="o.move_type == 'out_invoice' and o.state == 'cancel'">Cancelled Invoice</span>\n                            <span t-if="o.move_type == 'out_refund'">Credit Note</span>\n                            <span t-if="o.move_type == 'in_refund'">Vendor Credit Note</span>\n                            <span t-if="o.move_type == 'in_invoice'">Vendor Bill</span>\n                            <span t-if="o.name != '/'" t-field="o.name"/>\n                        </h2>\n\n                        <div id="informations" class="row mt32 mb32">\n                            <div class="col-auto col-3 mw-100 mb-2" t-if="o.invoice_date" name="invoice_date">\n                                <strong>Invoice Date:</strong>\n                                <p class="m-0" t-field="o.invoice_date"/>\n                            </div>\n                            <div class="col-auto col-3 mw-100 mb-2" t-if="o.invoice_date_due and o.move_type == 'out_invoice' and o.state == 'posted'" name="due_date">\n                                <strong>Due Date:</strong>\n                                <p class="m-0" t-field="o.invoice_date_due"/>\n                            </div>\n                            <div class="col-auto col-3 mw-100 mb-2" t-if="'pricelist' in o" name="pricelist">\n                                <strong>Payment Scheme:</strong>\n                                <p class="m-0" t-field="o.pricelist"/>\n                            </div>\n                            <div class="col-auto col-3 mw-100 mb-2" t-if="o.invoice_origin" name="origin">\n                                <strong>Source:</strong>\n                                <p class="m-0" t-field="o.invoice_origin"/>\n                            </div>\n                            <div class="col-auto col-3 mw-100 mb-2" t-if="o.partner_id.ref" name="customer_code">\n                                <strong>Customer Code:</strong>\n                                <p class="m-0" t-field="o.partner_id.ref"/>\n                            </div>\n                            <div class="col-auto col-3 mw-100 mb-2" t-if="o.ref" name="reference">\n                                <strong>Reference:</strong>\n                                <p class="m-0" t-field="o.ref"/>\n                            </div>\n                        </div>\n\n                        <t t-set="display_discount" t-value="any(l.discount for l in o.invoice_line_ids)"/>\n\n                        <table class="table table-sm o_main_table" name="invoice_line_table">\n                            <thead>\n                                <tr>\n                                    <th name="th_description" class="text-left"><span>Description</span></th>\n                                    <th name="th_quantity" class="text-right"><span>Quantity</span></th>\n                                    <th name="th_priceunit" t-attf-class="text-right {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}"><span>Unit Price</span></th>\n                                    <th name="th_price_unit" t-if="display_discount" t-attf-class="text-right {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}">\n                                        <span>Disc.%</span>\n                                    </th>\n                                    <th name="th_taxes" t-attf-class="text-left {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}"><span>Taxes</span></th>\n                                    <th name="th_subtotal" class="text-right">\n                                        <span groups="account.group_show_line_subtotals_tax_excluded">Amount</span>\n                                        <span groups="account.group_show_line_subtotals_tax_included">Total Price</span>\n                                    </th>\n                                </tr>\n                            </thead>\n                            <tbody class="invoice_tbody">\n                                <t t-set="current_subtotal" t-value="0"/>\n                                <t t-set="lines" t-value="o.invoice_line_ids.sorted(key=lambda l: (-l.sequence, l.date, l.move_name, -l.id), reverse=True)"/>\n\n                                <t t-foreach="lines" t-as="line">\n                                    <t t-set="current_subtotal" t-value="current_subtotal + line.price_subtotal" groups="account.group_show_line_subtotals_tax_excluded"/>\n                                    <t t-set="current_subtotal" t-value="current_subtotal + line.price_total" groups="account.group_show_line_subtotals_tax_included"/>\n\n                                    <tr t-att-class="'bg-200 font-weight-bold o_line_section' if line.display_type == 'line_section' else 'font-italic o_line_note' if line.display_type == 'line_note' else ''">\n                                        <t t-if="not line.display_type" name="account_invoice_line_accountable">\n                                            <td name="account_invoice_line_name"><span t-field="line.name" t-options="{'widget': 'text'}"/></td>\n                                            <td class="text-right">\n                                                <span t-field="line.quantity"/>\n                                                <span t-field="line.product_uom_id" groups="uom.group_uom"/>\n                                            </td>\n                                            <td t-attf-class="text-right {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}">\n                                                <span class="text-nowrap" t-field="line.price_unit"/>\n                                            </td>\n                                            <td t-if="display_discount" t-attf-class="text-right {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}">\n                                                <span class="text-nowrap" t-field="line.discount"/>\n                                            </td>\n                                            <td t-attf-class="text-left {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}">\n                                                <span t-esc="', '.join(map(lambda x: (x.description or x.name), line.tax_ids))" id="line_tax_ids"/>\n                                            </td>\n                                            <td class="text-right o_price_total">\n                                                <span class="text-nowrap" t-field="line.price_subtotal" groups="account.group_show_line_subtotals_tax_excluded"/>\n                                                <span class="text-nowrap" t-field="line.price_total" groups="account.group_show_line_subtotals_tax_included"/>\n                                            </td>\n                                        </t>\n                                        <t t-if="line.display_type == 'line_section'">\n                                            <td colspan="99">\n                                                <span t-field="line.name" t-options="{'widget': 'text'}"/>\n                                            </td>\n                                            <t t-set="current_section" t-value="line"/>\n                                            <t t-set="current_subtotal" t-value="0"/>\n                                        </t>\n                                        <t t-if="line.display_type == 'line_note'">\n                                            <td colspan="99">\n                                                <span t-field="line.name" t-options="{'widget': 'text'}"/>\n                                            </td>\n                                        </t>\n                                    </tr>\n\n                                    <t t-if="current_section and (line_last or lines[line_index+1].display_type == 'line_section')">\n                                        <tr class="is-subtotal text-right">\n                                            <td colspan="99">\n                                                <strong class="mr16">Subtotal</strong>\n                                                <span t-esc="current_subtotal" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: o.currency_id}"/>\n                                            </td>\n                                        </tr>\n                                    </t>\n                                </t>\n                            </tbody>\n                        </table>\n\n                        <div class="clearfix">\n                            <div id="total" class="row">\n                                <div t-attf-class="#{'col-6' if report_type != 'html' else 'col-sm-7 col-md-6'} ml-auto">\n                                    <table class="table table-sm" style="page-break-inside: avoid;">\n                                        <tr class="border-black o_subtotal" style="">\n                                            <td><strong>Subtotal</strong></td>\n                                            <td class="text-right">\n                                                <span t-esc="o.amount_without_discount" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: o.currency_id}"/>\n                                            </td>\n                                        </tr>\n                                        <t t-foreach="o.amount_by_group" t-as="amount_by_group">\n                                            <tr style="">\n                                                <t t-if="len(o.line_ids.filtered(lambda line: line.tax_line_id)) in [0, 1] and o.amount_untaxed == amount_by_group[2]">\n                                                    <td><span class="text-nowrap" t-esc="amount_by_group[0]"/></td>\n                                                    <td class="text-right o_price_total">\n                                                        <span class="text-nowrap" t-esc="amount_by_group[3]"/>\n                                                    </td>\n                                                </t>\n                                                <t t-else="">\n                                                    <td>\n                                                        <span t-esc="amount_by_group[0]"/>\n                                                        <span class="text-nowrap"> on\n                                                            <t t-esc="amount_by_group[4]"/>\n                                                        </span>\n                                                    </td>\n                                                    <td class="text-right o_price_total">\n                                                        <span class="text-nowrap" t-esc="amount_by_group[3]"/>\n                                                    </td>\n                                                </t>\n                                            </tr>\n                                        </t>\n                                            <tr>\n                                                <td><strong>Diskon</strong></td>\n                                                <td class="text-right">\n                                                    -<span t-field="o.total_discount"/>\n                                                </td>\n                                            </tr>\n                                            <tr>\n                                                <t t-set="pay" t-value="o.sudo()._get_reconciled_info_JSON_values()"/>\n                                                <t t-foreach="pay" t-as="pay">\n                                                    <td>\n                                                        <strong>Dibayar (<span t-esc="pay['journal_name']"/>)</strong>\n                                                    </td>\n                                                    <td class="text-right">\n                                                            <span t-esc="pay['amount']" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: o.currency_id}"/>\n                                                    </td>\n                                                </t>\n                                            </tr>\n                                        <tr class="border-black o_total">\n                                            <td><strong>Total</strong></td>\n                                            <td class="text-right">\n                                                <span class="text-nowrap" t-field="o.amount_total"/>\n                                            </td>\n                                        </tr>\n                                        <t t-if="print_with_payments">\n                                            <t t-if="o.payment_state != 'invoicing_legacy'">\n                                                <t t-set="payments_vals" t-value="o.sudo()._get_reconciled_info_JSON_values()"/>\n                                                <t t-foreach="payments_vals" t-as="payment_vals">\n                                                    <tr>\n                                                        <td>\n                                                            <i class="oe_form_field text-right oe_payment_label">Paid on <t t-esc="payment_vals['date']" t-options="{&quot;widget&quot;: &quot;date&quot;}"/></i>\n                                                        </td>\n                                                        <td class="text-right">\n                                                            <span t-esc="payment_vals['amount']" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: o.currency_id}"/>\n                                                        </td>\n                                                    </tr>\n                                                </t>\n                                                <t t-if="len(payments_vals) &gt; 0">\n                                                    <tr class="border-black">\n                                                        <td><strong>Amount Due</strong></td>\n                                                        <td class="text-right">\n                                                            <span t-field="o.amount_residual"/>\n                                                        </td>\n                                                    </tr>\n                                                </t>\n                                            </t>\n                                        </t>\n                                    </table>\n                                </div>\n                            </div>\n                        </div>\n                        <p t-if="o.move_type in ('out_invoice', 'in_refund') and o.payment_reference" name="payment_communication">\n                            Please use the following communication for your payment : <b><span t-field="o.payment_reference"/></b>\n                        </p>\n                        <p t-if="o.invoice_payment_term_id" name="payment_term">\n                            <span t-field="o.invoice_payment_term_id.note"/>\n                        </p>\n                        <p t-if="o.narration" name="comment">\n                            <span t-field="o.narration"/>\n                        </p>\n                        <p t-if="o.fiscal_position_id.note" name="note">\n                            <span t-field="o.fiscal_position_id.note"/>\n                        </p>\n                        <p t-if="o.invoice_incoterm_id" name="incoterm">\n                            <strong>Incoterm: </strong><span t-field="o.invoice_incoterm_id.code"/> - <span t-field="o.invoice_incoterm_id.name"/>\n                        </p>\n                        <div id="qrcode" t-if="o.display_qr_code">\n                            <p t-if="qr_code_urls.get(o.id)">\n                                <strong class="text-center">Scan me with your banking app.</strong><br/><br/>\n                                <img class="border border-dark rounded" t-att-src="qr_code_urls[o.id]"/>\n                            </p>\n                        </div>\n                    </div>\n                </t>\n        </t>\n    	ehealth_document/report/template_invoice/template_invoice_default.xml	\N	\N	\N	\N	primary	t	1	2025-08-28 11:34:01.364376	1	2025-08-28 11:34:01.364376	f
1507	template_invoice_agatha	\N	ehealth_document.template_invoice_agatha	16	qweb	<?xml version="1.0"?>\n<t t-name="ehealth_document.template_invoice_agatha">\n            <t t-call="web.external_layout">\n                    <t t-set="o" t-value="o.with_context(lang=lang)"/>\n                    <t t-set="address">\n                        <address t-field="o.partner_id" t-options="{&quot;widget&quot;: &quot;contact&quot;, &quot;fields&quot;: [&quot;address&quot;, &quot;name&quot;], &quot;no_marker&quot;: True}"/>\n                        <div t-if="o.partner_id.vat" class="mt16">\n                            <t t-if="o.company_id.country_id.vat_label" t-esc="o.company_id.country_id.vat_label" id="inv_tax_id_label"/>\n                            <t t-else="">Tax ID</t>: <span t-field="o.partner_id.vat"/></div>\n                    </t>\n                    <div class="page">\n                        <h2>\n                            <span t-if="o.move_type == 'out_invoice' and o.state == 'posted'">Invoice</span>\n                            <span t-if="o.move_type == 'out_invoice' and o.state == 'draft'">Draft Invoice</span>\n                            <span t-if="o.move_type == 'out_invoice' and o.state == 'cancel'">Cancelled Invoice</span>\n                            <span t-if="o.move_type == 'out_refund'">Credit Note</span>\n                            <span t-if="o.move_type == 'in_refund'">Vendor Credit Note</span>\n                            <span t-if="o.move_type == 'in_invoice'">Vendor Bill</span>\n                            <span t-if="o.name != '/'" t-field="o.name"/>\n                        </h2>\n\n                        <div id="informations" class="row mt32 mb32">\n                            <div class="col-auto col-3 mw-100 mb-2" t-if="o.invoice_date" name="invoice_date">\n                                <strong>Invoice Date:</strong>\n                                <p class="m-0" t-field="o.invoice_date"/>\n                            </div>\n                            <div class="col-auto col-3 mw-100 mb-2" t-if="o.invoice_date_due and o.move_type == 'out_invoice' and o.state == 'posted'" name="due_date">\n                                <strong>Due Date:</strong>\n                                <p class="m-0" t-field="o.invoice_date_due"/>\n                            </div>\n                            <div class="col-auto col-3 mw-100 mb-2" t-if="'pricelist' in o" name="pricelist">\n                                <strong>Payment Scheme:</strong>\n                                <p class="m-0" t-field="o.pricelist"/>\n                            </div>\n                            <div class="col-auto col-3 mw-100 mb-2" t-if="o.invoice_origin" name="origin">\n                                <strong>Source:</strong>\n                                <p class="m-0" t-field="o.invoice_origin"/>\n                            </div>\n                            <div class="col-auto col-3 mw-100 mb-2" t-if="o.partner_id.ref" name="customer_code">\n                                <strong>Customer Code:</strong>\n                                <p class="m-0" t-field="o.partner_id.ref"/>\n                            </div>\n                            <div class="col-auto col-3 mw-100 mb-2" t-if="o.ref" name="reference">\n                                <strong>Reference:</strong>\n                                <p class="m-0" t-field="o.ref"/>\n                            </div>\n                        </div>\n\n                        <t t-set="display_discount" t-value="any(l.discount for l in o.invoice_line_ids)"/>\n\n                        <table class="table table-sm o_main_table" name="invoice_line_table">\n                            <thead>\n                                <tr>\n                                    <th name="th_description" class="text-left"><span>Description</span></th>\n                                    <th name="th_quantity" class="text-right"><span>Quantity</span></th>\n                                    <th name="th_priceunit" t-attf-class="text-right {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}"><span>Unit Price</span></th>\n                                    <th name="th_price_unit" t-if="display_discount" t-attf-class="text-right {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}">\n                                        <span>Disc.%</span>\n                                    </th>\n                                    <th name="th_taxes" t-attf-class="text-left {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}"><span>Taxes</span></th>\n                                    <th name="th_subtotal" class="text-right">\n                                        <span groups="account.group_show_line_subtotals_tax_excluded">Amount</span>\n                                        <span groups="account.group_show_line_subtotals_tax_included">Total Price</span>\n                                    </th>\n                                </tr>\n                            </thead>\n                            <tbody class="invoice_tbody">\n                                <t t-set="current_subtotal" t-value="0"/>\n                                <t t-set="lines" t-value="o.invoice_line_ids.sorted(key=lambda l: (-l.sequence, l.date, l.move_name, -l.id), reverse=True)"/>\n\n                                <t t-foreach="lines" t-as="line">\n                                    <t t-set="current_subtotal" t-value="current_subtotal + line.price_subtotal" groups="account.group_show_line_subtotals_tax_excluded"/>\n                                    <t t-set="current_subtotal" t-value="current_subtotal + line.price_total" groups="account.group_show_line_subtotals_tax_included"/>\n\n                                    <tr t-att-class="'bg-200 font-weight-bold o_line_section' if line.display_type == 'line_section' else 'font-italic o_line_note' if line.display_type == 'line_note' else ''">\n                                        <t t-if="not line.display_type" name="account_invoice_line_accountable">\n                                            <td name="account_invoice_line_name"><span t-field="line.name" t-options="{'widget': 'text'}"/></td>\n                                            <td class="text-right">\n                                                <span t-field="line.quantity"/>\n                                                <span t-field="line.product_uom_id" groups="uom.group_uom"/>\n                                            </td>\n                                            <td t-attf-class="text-right {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}">\n                                                <span class="text-nowrap" t-field="line.price_unit"/>\n                                            </td>\n                                            <td t-if="display_discount" t-attf-class="text-right {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}">\n                                                <span class="text-nowrap" t-field="line.discount"/>\n                                            </td>\n                                            <td t-attf-class="text-left {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}">\n                                                <span t-esc="', '.join(map(lambda x: (x.description or x.name), line.tax_ids))" id="line_tax_ids"/>\n                                            </td>\n                                            <td class="text-right o_price_total">\n                                                <span class="text-nowrap" t-field="line.price_subtotal" groups="account.group_show_line_subtotals_tax_excluded"/>\n                                                <span class="text-nowrap" t-field="line.price_total" groups="account.group_show_line_subtotals_tax_included"/>\n                                            </td>\n                                      
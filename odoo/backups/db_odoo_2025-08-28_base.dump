('%d-%m-%Y')"/></div>\n                        </div>\n                        <div class="row">\n                            <div class="col-2">Pekerjaan</div>\n                            <div class="col-4">: <t t-esc="o['partner_id']['function']"/></div>\n                        </div>\n                        <div class="row">\n                            <div class="col-2">Alamat</div>\n                            <div class="col-4">: <t t-esc="o['partner_id']['street']"/></div>\n                        </div>\n                    </div>\n                    <p class="mt-3 mb-0">Sedang keadaan hamil <strong><t t-esc="data['masa-kehamilan']"/> Minggu </strong></p>\n                    <p class="mt-0 mb-0">HPHT: <strong><t t-esc="data['hpht']"/></strong> dan HPL: <strong><t t-esc="data['hpl']"/></strong></p>\n                    <p>Demikian surat keterangan hamil ini saya buat agar dipergunakan sebagaimana mestinya</p>\n                </div>\n            </div>\n\n            <div class="row pt-5">\n                <div class="col-1"/>\n                <div class="col-3 mt-4">\n                    <p class="mb-0">Validasi</p>\n                    <div class="mt-3" id="qrcode">\n                        <img t-att-src="o['qr_code_url']" style="width:125px;height:125px;"/>\n                    </div>\n                </div>\n                <div class="col-4"/>\n                <div class="col-4">\n                    <p class="mb-0"><t t-esc="o['operating_unit_id']['company_id']['city']"/>, <t t-esc="o.to_date_string(data['registration_date'])"/></p>\n                    <p class="mb-0">Bidan Pemeriksa</p>\n                    <div class="mt-3" id="qrcode">\n                        <div style="width:125px;height:125px;"/>\n                    </div>\n                    <p class="mb-0 mt-2"><strong>\n                    <t t-if="'examiner_name' in data">\n                    <t t-esc="data['examiner_name']"/>\n                    </t>\n                    <t t-else="">\n                    <t t-esc="data['sender']"/>\n                    </t>\n                    </strong></p>\n                </div>\n            </div>\n        </div>\n        </t>\n    </t>\n    	ehealth_document/report/template_surat_keterangan_hamil/report_praktekbidandwi_surat_keterangan_hamil.xml	\N	\N	\N	\N	primary	t	1	2025-08-28 11:34:01.364376	1	2025-08-28 11:34:01.364376	f
1669	report_default_sep	\N	ehealth_document.report_default_sep	16	qweb	<?xml version="1.0"?>\n<t t-name="ehealth_document.report_default_sep">\n        <t t-call="web.html_container">\n            <div class="header mb-0" t-att-style="report_header_style">\n              <div class="row col-12">\n                    <div>\n                          <img t-att-src="'/ehealth_document/static/src/img/logo-bpjs.png'" style="width: 320px;" alt="Logo"/>\n                    </div>\n                    <div class="ml-3 mt-1 text-left">\n                      <p style="font-size: 25px; font weight: 900;">SURAT ELIGIBILITAS PESERTA <br/> YGDI</p>\n                    </div>\n              </div>\n            </div>\n              <div class="article" t-att-data-oe-model="o and o._name" t-att-data-oe-id="o and o.id" t-att-data-oe-lang="o and o.env.context.get('lang')">\n                <div class="page">\n                    <div class="d-flex mt-2" style="font-size: 22px;">\n                        <div style="width: 57%;">\n                            <div class="row">\n                                <div class="col-3 pr-0">No.SEP</div>\n                                <div class="col-6 ">: <t t-esc="data['doc_parts']['no-sep']"/></div>\n                            </div>\n                            <div class="row">\n                                <div class="col-3 pr-0">Tgl.SEP</div>\n                                <div class="col-6 ">: <t t-esc="data['doc_parts']['tgl-sep']"/></div>\n                            </div>\n                            <div class="row">\n                                <div class="col-3 pr-0">No.Kartu</div>\n                                <div class="col-6 ">: <t t-esc="data['doc_parts']['bpjs-number']"/></div>\n                            </div>\n                            <div class="row">\n                                <div class="col-3 pr-0">Nama Peserta</div>\n                                <div class="col-6 ">: <t t-esc="data['doc_parts']['peserta']['nama-peserta']"/></div>\n                            </div>\n                            <div class="row">\n                                <div class="col-3 pr-0">Tgl.Lahir</div>\n                                <div class="col-6 ">:\n                                    <t t-esc="o['partner_id']['birthDate'].strftime('%Y-%m-%d')"/>\n                                    <span class="pl-1">Kelamin:\n                                        <t t-if="data['doc_parts']['peserta']['jenis-kelamin'] == 'L'">Laki-laki</t>\n                                        <t t-if="data['doc_parts']['peserta']['jenis-kelamin'] == 'P'">Perempuan</t>\n                                    </span>\n                                </div>\n                            </div>\n                            <div class="row">\n                                <div class="col-3 pr-0">No.Telepon</div>\n                                <div class="col-6 ">:\n                                    <t t-if="'peserta' in data['doc_parts'] and 'no-telp' in data['doc_parts']['peserta']">\n                                        <t t-esc="data['doc_parts']['peserta']['no-telp']"/>\n                                    </t>\n                                </div>\n                            </div>\n                            <div class="row">\n                                <div class="col-3 pr-0">Sub/Spesialis</div>\n                                <div class="col-6 ">: <t t-esc="data['doc_parts']['poli']"/></div>\n                            </div>\n                            <div class="row">\n                                <div class="col-3 pr-0">Dokter</div>\n                                <div class="col-8">: <t t-esc="data['doc_parts']['dokter']"/></div>\n                            </div>\n                            <div class="row">\n                                <div class="col-3 pr-0">Faskes Perujuk</div>\n                                <div class="col-6 ">: <t t-esc="data['doc_parts']['faskes-perujuk']"/></div>\n                            </div>\n                            <div class="row">\n                                <div class="col-3 pr-0">Diagnosa Awal</div>\n                                <div class="col-8">: <t t-esc="data['doc_parts']['diagnosa']"/></div>\n                            </div>\n                            <div class="row">\n                                <div class="col-3 pr-0">Catatan</div>\n                                <div class="col-8">: <t t-esc="data['doc_parts']['catatan']"/></div>\n                            </div>\n                        </div>\n                        <div style="width: 43%;">\n                            <div class="row">\n                                <div class="col-3 p-0">Peserta</div>\n                                <div class="col-6">: <t t-esc="data['doc_parts']['peserta']['jenis-peserta']"/></div>\n                            </div>\n                            <div class="row">\n                                <div class="col-3 p-0">Jns.Rwat</div>\n                                <div class="col-6">: R.Jalan</div>\n                            </div>\n                            <div class="row">\n                                <div class="col-3 p-0">Jns.Kunjungan</div>\n                                <div>\n                                    <div class="col-12">: -Konsultasi dokter (pertama)</div>\n                                    <div class="col-12">: -Prosedur dan terapi berkelanjutan</div>\n                                </div>\n                            </div>\n                            <div class="row">\n                                <div class="col-3 p-0">Poli Perujuk</div>\n                                <div class="col-6">: </div>\n                            </div>\n                            <div class="row">\n                                <div class="col-3 p-0">Kls.Hak</div>\n                                <div class="col-6">: <t t-esc="data['doc_parts']['peserta']['kelas-hak']"/></div>\n                            </div>\n                            <div class="row">\n                                <div class="col-3 p-0">Penjamin</div>\n                                <div class="col-6 ">: </div>\n                            </div>\n                        </div>\n                    </div>\n\n                    <div class="row">\n                        <div class="col-8" style="font-size: 15px;">\n                            <div>*Saya menyetujui BPJS Kesehatan untuk:</div>\n                            <div>\n                                <div class="d-flex">\n                                    <div class="mr-1">a.</div>\n                                    <div>\n                                        <div class="">membuka dan atau menggunkan informasi medis Pasien untuk keperluan administrasi, pembayaran asuransi atau jaminan pembiayaan kesehtan</div>\n                                    </div>\n                                </div>\n                                <div class="d-flex">\n                                    <div class="mr-1">b.</div>\n                                    <div>memberikan akses informasi medis atau riwayat pelayanan kepada dokter/tenaga medis pada YGDI untuk kepentingan pemeliharaan kesehatan pengobatan, penyembuhan, dan perawatan pasien</div>\n                                </div>\n                            </div>\n                            <div>*Saya mengetahui dan memahami:</div>\n                            <div>\n                                <div class="d-flex">\n                                    <div class="mr-1">a.</div>\n                                    <div>Rumah Sakit dapat melakukan koordinasi dengan PT Jasa Raharja/PT.Taspen/PT. ASABRI/BPJS Ketenagakerjaan atau\n                                    Penjamin lainnya. jika Peserta merupakan pasien yang mengalami kecelakaan lalulintan dan/atau kecelakaan kerja</div>\n                                </div>\n                                <div class="d-flex">\n                                    <div class="mr-1">b.</div>\n                                    <div>SEP bukan sebagai bukti penjaminan peserta</div>\n                                </div>\n                            </div>\n                            <div>**Dengan tampilnya luaran SEP elektronik ini merupakan hasil validasi terhadap eligibilitas Pasien secara elektronik <br/>\n                                (validasi finger print atau biometrik/sistem validasi lan)<br/>\n                                dan selanjutnya Pasien dapat mengakses pelayanan kesehatan rujukan sesuai ketentuan berlaku <br/>\n                                Kebenaran dan keaslian atas informasi data Pasien menjadi tanggung jawab penuh FKTRL\n                            </div>\n                        </div>\n                        <div class="col-5" style="font-size: 22px;">\n                            <div>Persetujuan <br/>Pasien/Keluarga Pasien</div>\n                            <t t-if="'qr_code_peserta' in data['doc_parts']">\n                              <img t-att-src="data['doc_parts']['qr_code_peserta']" style="width:100px;height:100px;"/>\n                            </t>\n                            <t t-else="">\n                              <div style="width:125px;height:125px;"/>\n                            </t>\n                            <div><t t-esc="o['partner_id']['name']"/></div>\n                        </div>\n                    </div>\n                </div>\n              </div>\n            \n        </t>\n    </t>\n	ehealth_document/report/template_sep/report_default_sep.xml	\N	\N	\N	\N	primary	t	1	2025-08-28 11:34:01.364376	1	2025-08-28 11:34:01.364376	f

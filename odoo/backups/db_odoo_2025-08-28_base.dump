1660	report_sahabatkeluarga_hemodialisis	\N	ehealth_document.report_sahabatkeluarga_hemodialisis	16	qweb	<?xml version="1.0"?>\n<t t-name="ehealth_document.report_sahabatkeluarga_hemodialisis">\n    <t t-call="web.html_container">\n        <div class="header mb-0" t-att-style="report_header_style">\n            <div class="row">\n                <div class="ml-3 pr-3 pt-2" style="border: 1px solid black">\n                    <img t-att-src="'/ehealth_document/static/src/img/logo_sahabatkeluarga.png'" style="max-height: 90px;" alt="Logo"/>\n                </div>\n                <div class="text-center pl-3 pr-3" style="font-size: 22px; font-family: Times, serif; border: 1px solid black">\n                    <p class="text-center pt-4 mb-0">\n                        <strong>STATUS TERINTEGRASI</strong>\n                    </p>\n                    <p class="text-center">\n                        <strong>PASIEN HEMODIALISA</strong>\n                    </p>\n                </div>\n                <div class="text-left pl-5 pr-5 pb-2" style="border: 1px solid black">\n                  <div class="row pt-2">\n                    <div class="col-5 pl-0">\n                      <p>No. RM</p>\n                    </div>\n                    <div class="col-8">\n                      <p>\n                        <span class="pr-2">:</span>\n                        <t t-esc="o['partner_id']['medical_record']"/>\n                      </p>\n                    </div>\n                  </div>\n                  <div class="row">\n                    <div class="col-5 pl-0">\n                      <p>Nama</p>\n                    </div>\n                    <div class="col-8">\n                      <p>\n                        <span class="pr-2">:</span>\n                        <t t-esc="o['partner_id']['name']"/>\n                      </p>\n                    </div>\n                  </div>\n                  <div class="row">\n                    <div class="col-5 pl-0">\n                      <p>Tgl Lahir</p>\n                    </div>\n                    <div class="col-8">\n                      <p>\n                        <span class="pr-2">:</span>\n                        <t t-esc="o['partner_id']['birthDate'].strftime('%d/%m/%Y')"/>\n                      </p>\n                    </div>\n                  </div>\n                  <div class="row">\n                    <div class="col-5 pl-0">\n                      <p>Usia</p>\n                    </div>\n                    <div class="col-8">\n                      <p>\n                        <span class="pr-2">:</span>\n                        <t t-esc="o.count_age(o['partner_id']['birthDate'].strftime('%d/%m/%Y'))"/> tahun\n                      </p>\n                    </div>\n                  </div>\n\n                </div>\n          </div>\n        </div>\n        <div class="article" t-att-data-oe-model="o and o._name" t-att-data-oe-id="o and o.id" t-att-data-oe-lang="o and o.env.context.get('lang')">\n          <div class="page" style="font-size: 14px;">\n          <div class="row mt-1" style="border-bottom: 2px solid #000;">\n            <div class="col-6 mb-1">\n              <div>\n                <div class="row">\n                  <div class="col-4">\n                    <p>Tanggal</p>\n                  </div>\n                  <div class="col-8">\n                    <p>\n                      <span class="pr-2">:</span>\n                      <t t-esc="o.to_date_string(data['registration_date'])"/>\n                    </p>\n                  </div>\n                </div>\n                <div class="row">\n                  <div class="col-4">\n                    <p>Dialisis ke</p>\n                  </div>\n                  <div class="col-8">\n                    <p>\n                      <span class="pr-2">:</span>\n                      <t t-if="'procedure_hd' in data['doc_parts'] and 'hd_sequence' in data['doc_parts']['procedure_hd']">\n                        <t t-esc="data['doc_parts']['procedure_hd']['hd_sequence']"/></t>\n                    </p>\n                  </div>\n                </div>\n                <div class="row">\n                  <div class="col-4">\n                    <p>BB Kering (DW)</p>\n                  </div>\n                  <t t-if="'vital_sign_pre' in data['doc_parts']">\n                    <div class="col-8">\n                      <p>\n                        <span class="pr-2">:</span>\n                        <t t-if="'bb-kering' in data['doc_parts']['vital_sign_pre']">\n                          <t t-esc="data['doc_parts']['vital_sign_pre']['bb-kering']"/> kg\n                        </t>\n                      </p>\n                    </div>\n                  </t>\n                </div>\n                <div class="row">\n                  <div class="col-4">\n                    <p>BB HD Terakhir</p>\n                  </div>\n                  <t t-if="'vital_sign_pre' in data['doc_parts']">\n                    <div class="col-8">\n                      <p>\n                        <span class="pr-2">:</span>\n                        <t t-if="'bb-terakhir' in data['doc_parts']['vital_sign_pre']">\n                          <t t-esc="data['doc_parts']['vital_sign_pre']['bb-terakhir']"/> kg\n                        </t>\n                      </p>\n                    </div>\n                  </t>\n                </div>\n              </div>\n            </div>\n            <div class="col-6">\n              <div>\n                <div class="row">\n                  <div class="col-3">\n                    <p>Lama HD</p>\n                  </div>\n                  <t t-if="'procedure_hd' in data['doc_parts']">\n                    <div class="col-8">\n                      <p>\n                        <span class="pr-2">:</span>\n                        <t t-esc="data['doc_parts']['procedure_hd']['lama-hd']"/> jam\n\n                      </p>\n                    </div>\n                  </t>\n                </div>\n                <div class="row">\n                  <div class="col-3">\n                    <p>UFG</p>\n                  </div>\n                  <t t-if="'procedure_hd' in data['doc_parts']">\n                    <div class="col-8">\n                      <p>\n                        <span class="pr-2">:</span>\n                        <t t-esc="data['doc_parts']['procedure_hd']['ufg']"/> mL\n\n                      </p>\n                    </div>\n                  </t>\n                </div>\n                <div class="row">\n                  <div class="col-3">\n                    <p>Mulai HD</p>\n                  </div>\n                  <div class="col-8">\n                    <p>\n                      <span class="pr-2">:</span>\n                      <t t-if="'procedure_hd' in data['doc_parts'] and 'start_hd' in data['doc_parts']['procedure_hd']">\n                        <t t-esc="data['doc_parts']['procedure_hd']['start_hd']"/>\n                        <span class="ml-1">WIB</span>\n                      </t>\n                    </p>\n                  </div>\n                </div>\n                <div class="row">\n                  <div class="col-3">\n                    <p>Selesai HD</p>\n                  </div>\n                  <div class="col-8">\n                    <p>\n                      <span class="pr-2">:</span>\n                      <t t-if="'procedure_hd' in data['doc_parts'] and 'end_hd' in data['doc_parts']['procedure_hd']">\n                        <t t-esc="data['doc_parts']['procedure_hd']['end_hd']"/>\n                        <span class="ml-1">WIB</span>\n                      </t>\n                    </p>\n                  </div>\n                </div>\n              </div>\n            </div>\n            <div class="pt-1" style="border-bottom: 6px solid #000;"/>\n          </div>\n          <div class="row mt-2">\n            <div class="col-6">\n              <div>\n                <div class="row mt-2">\n                  <div class="col-4">\n                    <p><strong>PEMERIKSAAN</strong></p>\n                  </div>\n                  <div class="col-4">\n                    <p class="pl-3"><strong>Pre HD</strong></p>\n                  </div>\n                  <div class="col-4">\n                    <p><strong>Pasca HD</strong></p>\n                  </div>\n                </div>\n                <div class="row" style="overflow-wrap: break-word;">\n                  <div class="col-4">\n                    <p>Keadaan Umum / Kesadaran</p>\n                  </div>\n                  <div class="col-4">\n                    <p>\n                      <span class="pr-2">:</span>\n                      <t t-if="'general_condition_pre' in data['doc_parts']">\n                        <t t-esc="data['doc_parts']['general_condition_pre']"/></t>/\n                      <t t-if="'vital_sign_pre' in data['doc_parts'] and 'consciousness' in data['doc_parts']['vital_sign_pre']">\n                        <t t-esc="data['doc_parts']['vital_sign_pre']['consciousness']"/></t>\n                    </p>\n                  </div>\n                  <div class="col-4">\n                    <p>\n                      <t t-if="'general_condition_post' in data['doc_parts']">\n                        <t t-esc="data['doc_parts']['general_condition_post']"/></t>/\n                      <t t-if="'vital_sign_post' in data['doc_parts'] and 'consciousness' in data['doc_parts']['vital_sign_post']">\n                        <t t-esc="data['doc_parts']['vital_sign_post']['consciousness']"/></t>\n                    </p>\n                  </div>\n                </div>\n                <div class="row">\n                  <div class="col-4">\n                    <p>Tekanan Darah</p>\n                  </div>\n                  <t t-if="'vital_sign_pre' in data['doc_parts']">\n                    <div class="col-4">\n                      <p>\n                        <span class="pr-2">:</span>\n                        <t t-if="'sistole' in data['doc_parts']['vital_sign_pre']">\n                          <t t-esc="data['doc_parts']['vital_sign_pre']['sistole']"/></t>\n                        /\n\n                        <t t-if="'diastole' in data['doc_parts']['vital_sign_pre']">\n                          <t t-esc="data['doc_parts']['vital_sign_pre']['diastole']"/></t> mmHg\n\n                      </p>\n                    </div>\n                  </t>\n                  <t t-if="'vital_sign_post' in data['doc_parts']">\n                    <div class="col-4">\n                      <p>\n                        <t t-if="'sistole' in data['doc_parts']['vital_sign_post']">\n                          <t t-esc="data['doc_parts']['vital_sign_post']['sistole']"/></t>\n                        /\n\n                        <t t-if="'diastole' in data['doc_parts']['vital_sign_post']">\n                          <t t-esc="data['doc_parts']['vital_sign_post']['diastole']"/></t> mmHg\n\n                      </p>\n                    </div>\n                  </t>\n                </div>\n                <div class="row">\n                  <div class="col-4">\n                    <p>Nadi</p>\n                  </div>\n                  <div class="col-4">\n                    <p>\n                      <span class="pr-2">:</span>\n                      <t t-if="'vital_sign_pre' in data['doc_parts'] and 'nadi' in data['doc_parts']['vital_sign_pre']">\n                        <t t-esc="data['doc_parts']['vital_sign_pre']['nadi']"/> x/mnt\n                      </t>\n                    </p>\n                  </div>\n                  <div class="col-4">\n                    <p>\n                      <t t-if="'vital_sign_post' in data['doc_parts'] and 'nadi' in data['doc_parts']['vital_sign_post']">\n                        <t t-esc="data['doc_parts']['vital_sign_post']['nadi']"/> x/mnt\n                      </t>\n                    </p>\n                  </div>\n                </div>\n                <div class="row">\n                  <div class="col-4">\n                    <p>Suhu</p>\n                  </div>\n                  <div class="col-4">\n                    <p>\n                      <span class="pr-2">:</span>\n                      <t t-if="'vital_sign_pre' in data['doc_parts'] and 'suhu' in data['doc_parts']['vital_sign_pre']">\n                        <t t-esc="data['doc_parts']['vital_sign_pre']['suhu']"/> °C\n                      </t>\n                    </p>\n                  </div>\n                  <div class="col-4">\n                    <p>\n                      <t t-if="'vital_sign_post' in data['doc_parts'] and 'suhu' in data['doc_parts']['vital_sign_post']">\n                        <t t-esc="data['doc_parts']['vital_sign_post']['suhu']"/> °C\n                      </t>\n                    </p>\n                  </div>\n                </div>\n                <div class="row">\n                  <div class="col-4">\n                    <p>Respirasi</p>\n                  </div>\n                  <t t-if="'vital_sign_pre' in data['doc_parts'] and 'respirasi' in data['doc_parts']['vital_sign_pre']">\n                    <div class="col-4">\n                      <p>\n                        <span class="pr-2">:</span>\n                        <t t-esc="data['doc_parts']['vital_sign_pre']['respirasi']"/> x/mnt\n\n                      </p>\n                    </div>\n                  </t>\n                  <t t-if="'vital_sign_post' in data['doc_parts'] and 'respirasi' in data['doc_parts']['vital_sign_post']">\n                    <div class="col-4">\n                      <p>\n                        <t t-esc="data['doc_parts']['vital_sign_post']['respirasi']"/> x/mnt\n\n                      </p>\n                    </div>\n                  </t>\n                </div>\n                <div class="row">\n                  <div class="col-4">\n                    <p>Berat Badan</p>\n                  </div>\n                  <t t-if="'vital_sign_pre' in data['doc_parts'] and 'berat-badan' in data['doc_parts']['vital_sign_pre']">\n                    <div class="col-4">\n                      <p>\n                        <span class="pr-2">:</span>\n                        <t t-esc="data['doc_parts']['vital_sign_pre']['berat-badan']"/> kg\n\n                      </p>\n                    </div>\n                  </t>\n                  <t t-if="'vital_sign_post' in data['doc_parts'] and 'berat-badan' in data['doc_parts']['vital_sign_post']">\n                    <div class="col-4">\n                      <p>\n                        <t t-esc="data['doc_parts']['vital_sign_post']['berat-badan']"/> kg\n\n                      </p>\n                    </div>\n                  </t>\n                </div>\n                <div class="row">\n                  <div class="col-4">\n                    <p style="overflow-wrap: break-word;">Penambahan / Pengurangan</p>\n                  </div>\n                  <t t-if="'vital_sign_pre' in data['doc_parts'] and 'penambahan-bb' in data['doc_parts']['vital_sign_pre']">\n                    <div class="col-4">\n                      <p>\n                        <span class="pr-2">:</span>\n                        <t t-esc="data['doc_parts']['vital_sign_pre']['penambahan-bb']"/> kg\n\n                      </p>\n                    </div>\n                  </t>\n                  <t t-if="'vital_sign_post' in data['doc_parts'] and 'penambahan-bb' in data['doc_parts']['vital_sign_post']">\n                    <div class="col-4">\n                      <p>\n                        <t t-esc="data['doc_parts']['vital_sign_post']['penambahan-bb']"/> kg\n\n                      </p>\n                    </div>\n                  </t>\n                </div>\n                <div class="row">\n                  <div class="col-4">\n                    <p>Keluhan</p>\n                  </div>\n                  <t t-if="'chief_complaint_pre' in data['doc_parts']">\n                    <div class="col-4">\n                      <p>\n                        <span class="pr-2">:</span>\n                        <t t-esc="data['doc_parts']['chief_complaint_pre']"/>\n                      </p>\n                    </div>\n                  </t>\n                  <t t-if="'chief_complaint_post' in data['doc_parts']">\n                    <div class="col-4">\n                      <p>\n                        <t t-esc="data['doc_parts']['chief_complaint_post']"/>\n                      </p>\n                    </div>\n                  </t>\n                </div>\n              </div>\n            </div>\n            <div class="col-6 ml-2">\n              <div>\n                <div class="row">\n                  <div class="col-4">\n                    <p>* Mesin HD</p>\n                  </div>\n                  <div class="col-8">\n                    <p>\n                      <span class="pr-2">:</span> \n                      <t t-if="'procedure_hd' in data['doc_parts']">\n                        <t t-if="'nama_mesin_hd' in data['doc_parts']['procedure_hd']">\n                            <t t-esc="data['doc_parts']['procedure_hd']['nama_mesin_hd']"/> \n                        </t>\n                        <t t-else="">Fresenius</t>\n                      </t>\n                    </p>\n                  </div>\n                </div>\n                <div class="row">\n                  <div class="col-4">\n                    <p>* Mesin Nomor</p>\n                  </div>\n                  <t t-if="'procedure_hd' in data['doc_parts'] and 'mesin_hd' in data['doc_parts']['procedure_hd']">\n                    <div class="col-8">\n                      <p>\n                        <span class="pr-2">:</span>\n                        <t t-esc="data['doc_parts']['procedure_hd']['mesin_hd']"/>\n                      </p>\n                    </div>\n                  </t>\n                </div>\n                <div class="row">\n                  <div class="col-4">\n                    <p>* Dialiser</p>\n                  </div>\n                  <div class="col-8">\n                    <p>\n                      <span class="pr-2">:</span>\n                      <t t-if="'procedure_hd' in data['doc_parts']">\n                        <t t-if="'merk_dialiser' in data['doc_parts']['procedure_hd']">\n                            <t t-esc="data['doc_parts']['procedure_hd']['merk_dialiser']"/> \n                        </t>\n                        <t t-else="">Fresenius</t>\n                      </t>\n\n                    </p>\n                  </div>\n                </div>\n                <div class="row">\n                  <div class="col-4">\n                    <p>* Tipe Dialiser</p>\n                  </div>\n                  <div class="col-8">\n                    <p>\n                      <span class="pr-2">:</span>\n                      <t t-if="'procedure_hd' in data['doc_parts']">\n                        <t t-if="'tipe_dialiser' in data['doc_parts']['procedure_hd']">\n                            <t t-esc="data['doc_parts']['procedure_hd']['tipe_dialiser']"/> \n                        </t>\n                        <t t-else="">F8HPS</t>\n                      </t>\n                      \n                    </p>\n                  </div>\n                </div>\n                <div class="row">\n                  <div class="col-4">\n                    <p>* Jenis Dialisat</p>\n                  </div>\n                  <t t-if="'procedure_hd' in data['doc_parts'] and 'dialisat' in data['doc_parts']['procedure_hd']">\n                    <div class="col-8">\n                      <p>\n                        <span class="pr-2">:</span>\n                        <t t-esc="data['doc_parts']['procedure_hd']['dialisat']"/>\n                      </p>\n                    </div>\n                  </t>\n                </div>\n                <div class="row">\n                  <div class="col-4">\n                    <p>* Akses Vaskuler</p>\n                  </div>\n                  <t t-if="'procedure_hd' in data['doc_parts'] and 'akses-vaskuler' in data['doc_parts']['procedure_hd']">\n                    <div class="col-8">\n                      <p>\n                        <span class="pr-2">:</span>\n                        <t t-esc="data['doc_parts']['procedure_hd']['akses-vaskuler']"/>\n                      </p>\n                    </div>\n                  </t>\n                </div>\n                <div class="row">\n                  <div class="col-4">\n                    <p>* Volume Priming</p>\n                  </div>\n                  <t t-if="'procedure_hd' in data['doc_parts'] and 'volume-priming' in data['doc_parts']['procedure_hd']">\n                    <div class="col-8">\n                      <p>\n                        <span class="pr-2">:</span>\n                        <t t-esc="data['doc_parts']['procedure_hd']['volume-priming']"/>\n                      </p>\n                    </div>\n                  </t>\n                </div>\n                <div class="row">\n                  <div class="col-4">\n                    <p>* Heparinisasi</p>\n                  </div>\n                  <t t-if="'procedure_hd' in data['doc_parts'] and 'heparinisasi' in data['doc_parts']['procedure_hd']">\n                    <div class="col-8">\n                      <p>\n                        <span class="pr-2">:</span>\n                        <t t-esc="data['doc_parts']['procedure_hd']['heparinisasi']"/>\n                      </p>\n                    </div>\n                  </t>\n                </div>\n                <div class="row pl-1">\n                  <div class="col-4">\n                    <p>- Dosis Awal</p>\n                  </div>\n                  <t t-if="'procedure_hd' in data['doc_parts'] and 'first-dose' in data['doc_parts']['procedure_hd']">\n                    <div class="col-8">\n                      <p>\n                        <span class="pr-2">:</span>\n                        <t t-esc="data['doc_parts']['procedure_hd']['first-dose']"/> IU\n\n                      </p>\n                    </div>\n                  </t>\n                </div>\n                <div class="row pl-1">\n                  <div class="col-4 pr-0">\n                    <p>- Dosis Pemeliharaan</p>\n                  </div>\n                  <t t-if="'procedure_hd' in data['doc_parts']">\n                    <div class="col-8">\n                      <p>\n                        <span class="pr-2">:</span>\n                        <t t-if="'maintenance-dose' in data['doc_parts']['procedure_hd']">\n                          <t t-esc="data['doc_parts']['procedure_hd']['maintenance-dose']"/> IU\n                        </t>\n                        /\n\n                        <t t-if="'maintenance-dose-time' in data['doc_parts']['procedure_hd']">\n                          <t t-esc="data['doc_parts']['procedure_hd']['maintenance-dose-time']"/> jam\n                        </t>\n                      </p>\n                    </div>\n                  </t>\n                </div>\n                <div class="row pl-1">\n                  <div class="col-4">\n                    <p>- Dosis Sirkulasi</p>\n                  </div>\n                  <t t-if="'procedure_hd' in data['doc_parts'] and 'circulation-dose' in data['doc_parts']['procedure_hd']">\n                    <div class="col-8">\n                      <p>\n                        <span class="pr-2">:</span>\n                        <t t-esc="data['doc_parts']['procedure_hd']['circulation-dose']"/> IU\n\n                      </p>\n                    </div>\n                  </t>\n                </div>\n              </div>\n            </div>\n          </div>\n          <div class="row mt-4">\n            <div class="col-12">\n              <div>\n                <div class="row">\n                  <div class="col-12 text-center">\n                    <p>\n                      <strong>PEMANTAUAN DAN TINDAKAN SELAMA HD</strong>\n                    </p>\n                  </div>\n                </div>\n                <div class="pl-2 row">\n                  <div class="col-12">\n                    <table class="table table-bordered table-sm mt-3 mb-2">\n                      <tr class="text-center">\n                        <th>Waktu</th>\n                        <th>Qb\n                          <br/>(mL/menit)\n                        </th>\n                        <th>Tek. Arteri</th>\n                        <th>Tek. Vena</th>\n                        <th>TMP\n                          <br/>(mmHg)\n                        </th>\n                        <th>UF\n                          <br/>(mL)\n                        </th>\n                        <th>TD</th>\n                        <th>Nadi</th>\n                        <th>Catatan Tindakan</th>\n                      </tr>\n                      <t t-if="'dialysis_obs_on' in data['doc_parts']">\n                        <t t-foreach="data['doc_parts']['dialysis_obs_on']" t-as="dialysis_obs_on">\n                          <tr>\n                            <td>\n                              <t t-if="'obs_time' in dialysis_obs_on">\n                                <t t-esc="dialysis_obs_on['obs_time']"/></t>\n                            </td>\n                            <td>\n                              <t t-if="'qb' in dialysis_obs_on">\n                                <t t-esc="dialysis_obs_on['qb']"/></t>\n                            </td>\n                            <td>\n                              <t t-if="'arteri' in dialysis_obs_on">\n                                <t t-esc="dialysis_obs_on['arteri']"/></t>\n                            </td>\n                            <td>\n                              <t t-if="'vena' in dialysis_obs_on">\n                                <t t-esc="dialysis_obs_on['vena']"/></t>\n                            </td>\n                            <td>\n                              <t t-if="'tmp' in dialysis_obs_on">\n                                <t t-esc="dialysis_obs_on['tmp']"/></t>\n                            </td>\n                            <td>\n                              <t t-if="'uf' in dialysis_obs_on">\n                                <t t-esc="dialysis_obs_on['uf']"/></t>\n                            </td>\n                            <td>\n                              <t t-if="'sistole' in dialysis_obs_on">\n                                <t t-esc="dialysis_obs_on['sistole']"/></t>\n                              /\n\n                              <t t-if="'diastole' in dialysis_obs_on">\n                                <t t-esc="dialysis_obs_on['diastole']"/></t>\n                            </td>\n                            <td>\n                              <t t-if="'nadi' in dialysis_obs_on">\n                                <t t-esc="dialysis_obs_on['nadi']"/></t>\n                            </td>\n                            <td>\n                              <t t-if="'note' in dialysis_obs_on">\n                                <t t-esc="dialysis_obs_on['note']"/></t>\n                            </td>\n                          </tr>\n                        </t>\n                      </t>\n                    </table>\n                  </div>\n                </div>\n              </div>\n            </div>\n          </div>\n          <div class="pl-2 row mt-3">\n            <div style="width: 40%;" class="ml-2">\n              <p class="mb-0 ml-2">\n                <strong>CAIRAN MASUK:</strong>\n              </p>\n              <div class="ml-3">\n                <div class="row">\n                  <div class="ml-2 p-0" style="width: 10%">\n                    <p>I.V. : </p>\n                  </div>\n                  <div class="col-4 p-0">\n                    <p>-Sisa priming</p>\n                  </div>\n                  <t t-if="'sisa_priming' in data['doc_parts']">\n                    <div class="col-8">\n                      <p>\n                        <span class="pr-2">:</span>\n                        <t t-esc="data['doc_parts']['sisa_priming']"/>\n                        <span class="pl-1">cc</span>\n                      </p>\n                    </div>\n                  </t>\n                </div>\n                <div class="row">\n                  <div class="ml-2 p-0" style="width: 10%;"/>\n                  <div class="col-4 p-0">\n                    <p>-Wash out</p>\n                  </div>\n                  <t t-if="'wash_out' in data['doc_parts']">\n                    <div class="col-8">\n                      <p>\n                        <span class="pr-2">:</span>\n                        <t t-esc="data['doc_parts']['wash_out']"/>\n                        <span class="pl-1">cc</span>\n                      </p>\n                    </div>\n                  </t>\n                </div>\n                <div class="row">\n                  <div class="ml-2 p-0" style="width: 10%;"/>\n                  <div class="col-4 p-0">\n                    <p>-Infus/Drip/Tranfusi</p>\n                  </div>\n                  <t t-if="'infus_drip_transfusi' in data['doc_parts']">\n                    <div class="col-8">\n                      <p>\n                        <span class="pr-2">:</span>\n                        <t t-esc="data['doc_parts']['infus_drip_transfusi']"/>\n                        <span class="pl-1">cc</span>\n                      </p>\n                    </div>\n                  </t>\n                </div>\n                <div class="row">\n                  <div class="ml-2 p-0" style="width: 10%;">\n                    <p>Oral </p>\n                  </div>\n                  <div class="col-4 p-0">\n                    <p>-Minum</p>\n                  </div>\n                  <t t-if="'minum' in data['doc_parts']">\n                    <div class="col-8">\n                      <p style="text-decoration: underline;">\n                        <span class="pr-2">:</span>\n                        <t t-esc="data['doc_parts']['minum']"/>\n                        <span class="pl-1">cc</span>\n                      </p>\n                    </div>\n                  </t>\n                </div>\n                <div class="row">\n                  <div class="ml-2 p-0" style="width: 10%;"/>\n                  <div class="col-4 text-right">\n                    <p>JUMLAH</p>\n                  </div>\n                  <t t-if="'total_fluid_intake' in data['doc_parts']">\n                    <div class="col-8">\n                      <p>\n                        <span class="pr-2">:</span>\n                        <t t-esc="data['doc_parts']['total_fluid_intake']"/>\n                        <span class="pl-1">cc</span>\n                      </p>\n                    </div>\n                  </t>\n                </div>\n              </div>\n            </div>\n            <div style="width: 60%;">\n              <div class="mb-0 p-0">\n                <strong>CAIRAN KELUAR:</strong>\n              </div>\n              <div class="row">\n                <div style="width: 40%;">\n                  <div class="row">\n                    <div class="col-4 p-0">\n                      <p>Urine</p>\n                    </div>\n                    <t t-if="'urine' in data['doc_parts']">\n                      <div class="col-8">\n                        <p>\n                          <span class="pr-2">:</span>\n                          <t t-esc="data['doc_parts']['urine']"/>\n                          <span class="pl-1">cc</span>\n                        </p>\n                      </div>\n                    </t>\n                  </div>\n                  <div class="row">\n                    <div class="col-4 p-0">\n                      <p>Muntah</p>\n                    </div>\n                    <t t-if="'muntah' in data['doc_parts']">\n                      <div class="col-8">\n                        <p>\n                          <span class="pr-2">:</span>\n                          <t t-esc="data['doc_parts']['muntah']"/>\n                          <span class="pl-1">cc</span>\n                        </p>\n                      </div>\n                    </t>\n                  </div>\n                  <div class="row">\n                    <div class="col-4 p-0">\n                      <p>Perdarahan</p>\n                    </div>\n                    <t t-if="'pendarahan' in data['doc_parts']">\n                      <div class="col-8">\n                        <p style="text-decoration: underline;">\n                          <span class="pr-2">:</span>\n                          <t t-esc="data['doc_parts']['pendarahan']"/>\n                          <span class="pl-1">cc</span>\n                        </p>\n                      </div>\n                    </t>\n                  </div>\n                  <div class="row">\n                    <div class="col-4 p-0 text-right">\n                      <p>JUMLAH</p>\n                    </div>\n                    <t t-if="'total_fluid_out' in data['doc_parts']">\n                      <div class="col-8">\n                        <p>\n                          <span class="pr-2">:</span>\n                          <t t-esc="data['doc_parts']['total_fluid_out']"/>\n                          <span class="pl-1">cc</span>\n                        </p>\n                      </div>\n                    </t>\n                  </div>\n                </div>\n                <div style="width: 30%;">\n                  <div class="row">\n                    <div class="col-4 p-0">\n                      <p>AV Fistula</p>\n                    </div>\n                    <div class="col-4">\n                      <p>\n                        <span class="pr-2">:</span>\n                        <t t-if="'av-fistula' in data['doc_parts']">\n                          <t t-esc="data['doc_parts']['av-fistula']"/></t>\n                      </p>\n                    </div>\n                  </div>\n                  <div class="row">\n                    <div class="col-4 p-0">\n                      <p>Spuit 20cc</p>\n                    </div>\n                    <div class="col-8">\n                      <p>\n                        <span class="pr-2">:</span>\n                        <t t-if="'spuit-20' in data['doc_parts']">\n                          <t t-esc="data['doc_parts']['spuit-20']"/></t>\n                      </p>\n                    </div>\n                  </div>\n                  <div class="row">\n                    <div class="col-4 p-0">\n                      <p>Spuit 5 cc</p>\n                    </div>\n                    <div class="col-8">\n                      <p>\n                        <span class="pr-2">:</span>\n                        <t t-if="'spuit-5' in data['doc_parts']">\n                          <t t-esc="data['doc_parts']['spuit-5']"/></t>\n                      </p>\n                    </div>\n                  </div>\n                  <div class="row">\n                    <div class="col-4 p-0">\n                      <p>Spuit 1 cc</p>\n                    </div>\n                    <div class="col-8">\n                      <p>\n                        <span class="pr-2">:</span>\n                        <t t-if="'spuit-1' in data['doc_parts']">\n                          <t t-esc="data['doc_parts']['spuit-1']"/></t>\n                      </p>\n                    </div>\n                  </div>\n                </div>\n                <div style="width: 30%;">\n                  <div class="row">\n                    <div class="col-4 p-0">\n                      <p>Infus set</p>\n                    </div>\n                    <div class="col-8">\n                      <p>\n                        <span class="pr-2">:</span>\n                        <t t-if="'infus-set' in data['doc_parts']">\n                          <t t-esc="data['doc_parts']['infus-set']"/></t>\n                      </p>\n                    </div>\n                  </div>\n                  <div class="row">\n                    <div class="col-4 p-0">\n                      <p>Bloodline</p>\n                    </div>\n                    <div class="col-8">\n                      <p>\n                        <span class="pr-2">:</span>\n                        <t t-if="'bloodline' in data['doc_parts']">\n                          <t t-esc="data['doc_parts']['bloodline']"/></t>\n                      </p>\n                    </div>\n                  </div>\n                  <div class="row">\n                    <div class="col-4 p-0">\n                      <p>Bloodset</p>\n                    </div>\n                    <div class="col-8">\n                      <p>\n                        <span class="pr-2">:</span>\n                        <t t-if="'bloodset' in data['doc_parts']">\n                          <t t-esc="data['doc_parts']['bloodset']"/></t>\n                      </p>\n                    </div>\n                  </div>\n                </div>\n              </div>\n            </div>\n          </div>\n          <!--            <div class="row mt-2">-->\n          <!--              <div class="col-6">-->\n          <!--                <div>-->\n          <!--                  <div class="row">-->\n          <!--                    <div class="col-4">-->\n          <!--                      <p>3. Skala Nyeri</p>-->\n          <!--                    </div>-->\n          <!--                    <t t-if="'pain-scale' in data['doc_parts']">-->\n          <!--                      <div class="col-8">-->\n          <!--                        <p><span class="pr-2">:</span>-->\n          <!--                          <t t-esc="data['doc_parts']['pain-scale']"/>-->\n          <!--                        </p>-->\n          <!--                      </div>-->\n          <!--                    </t>-->\n          <!--                  </div>-->\n          <!--                </div>-->\n          <!--              </div>-->\n          <!--            </div>-->\n          <div class="mt-3">\n            <div>Pemeriksaan Fisik</div>\n            <div class="pl-2 row" style="page-break-inside: avoid; page-break-before: auto;">\n              <div class="col-2">\n                <p>Konjungtiva</p>\n              </div>\n              <t t-if="'conjunctiva' in data['doc_parts']">\n                <div class="col-4">\n                  <p>\n                    <span class="pr-2">:</span>\n                    <t t-esc="data['doc_parts']['conjunctiva']"/>\n                  </p>\n                </div>\n              </t>\n            </div>\n            <div class="pl-2 row" style="page-break-inside: avoid; page-break-before: auto;">\n              <div class="col-2">\n                <p>Respirasi</p>\n              </div>\n              <t t-if="'respiratory' in data['doc_parts']">\n                <div class="col-4">\n                  <p>\n                    <span class="pr-2">:</span>\n                    <t t-esc="data['doc_parts']['respiratory']"/>\n                  </p>\n                </div>\n              </t>\n            </div>\n            <div class="pl-2 row" style="page-break-inside: avoid; page-break-before: auto;">\n              <div class="col-2">\n                <p>Ekstremitas</p>\n              </div>\n              <t t-if="'extremities' in data['doc_parts']">\n                <div class="col-4">\n                  <p>\n                    <span class="pr-2">:</span>\n                    <t t-esc="data['doc_parts']['extremities']"/>\n                  </p>\n                </div>\n              </t>\n            </div>\n            <div class="pl-2 row" style="page-break-inside: avoid; page-break-before: auto;">\n              <div class="col-2">\n                <p>Akses Vaskuler</p>\n              </div>\n              <t t-if="'procedure_hd' in data['doc_parts'] and 'akses-vaskuler' in data['doc_parts']['procedure_hd']">\n                <div class="col-4">\n                  <p>\n                    <span class="pr-2">:</span>\n                    <t t-esc="data['doc_parts']['procedure_hd']['akses-vaskuler']"/>\n                  </p>\n                </div>\n              </t>\n            </div>\n          </div>\n          <div class="mt-2 ml-1" style="page-break-inside: avoid; page-break-before: auto;">\n            <div class="row">\n              <div class="col-2 p-0 ml-2">Priming</div>\n              <div>: ...</div>\n            </div>\n            <div class="row">\n              <div class="col-2 p-0 ml-2">Sirk. Dalam</div>\n              <div>: ...</div>\n            </div>\n            <div class="row">\n              <div class="col-2 p-0 ml-2">Inisiasi</div>\n              <div>: ...</div>\n            </div>\n            <div class="row">\n              <div class="col-2 p-0 ml-2">Terminasi</div>\n              <div>: ...</div>\n            </div>\n          </div>\n          <!-- <div class="row pt-5"><div class="col-8"></div><div class="col-4"><p class="mb-0"><t t-esc="o['operating_unit_id']['company_id']['city']"/>, <t t-esc="o.to_date_string(data['registration_date'])"/></p><p class="mb-0">Dokter Penanggungjawab</p><img t-att-src="o['qr_code_url']" style="width:125px;height:125px;"/><p class="mb-0 mt-2"><strong><t t-esc="data['sender']"/></strong></p></div></div> -->\n        </div>\n        </div>\n    </t>\n  </t>\n	ehealth_document/report/template_hemodialisis/report_sahabatkeluarga_hemodialisis.xml	\N	\N	\N	\N	primary	t	1	2025-08-28 11:34:01.364376	1	2025-08-28 11:34:01.364376	f
768	report_product_product_replenishment	\N	stock.report_product_product_replenishment	16	qweb	<?xml version="1.0"?>\n<t t-name="stock.report_product_product_replenishment">\n        <t t-call="web.html_container">\n            <div class="page pt-3 o_report_replenishment_page">\n                <t t-set="future_virtual_available" t-value="docs['virtual_available'] + docs['qty']['in'] - docs['qty']['out']"/>\n                <t t-call="stock.report_replenishment_header"/>\n                <div class="o_report_graph"/>\n                <table class="o_report_replenishment table table-bordered">\n                    <thead>\n                        <tr class="bg-light">\n                            <td>Replenishment</td>\n                            <td>Expected Receipt</td>\n                            <td t-if="docs['multiple_product']">Product</td>\n                            <td class="text-right">Quantity</td>\n                            <td groups="uom.group_uom">UoM</td>\n                            <td>Used by</td>\n                            <td>Expected Delivery</td>\n                        </tr>\n                    </thead>\n                    <tbody>\n                        <tr t-if="docs['lines'] and not any(line['document_in'] or line['replenishment_filled'] for line in docs['lines'])">\n                            <td>Inventory On Hand</td>\n                            <td/>\n                            <td t-if="docs['multiple_product']"/>\n                            <td class="text-right">0</td>\n                            <td/>\n                            <td/>\n                            <td/>\n                            <td/>\n                        </tr>\n                        <tr t-foreach="docs['lines']" t-as="line">\n                            <td t-attf-class="#{line['is_late'] and 'o_grid_warning'}">\n                                <a t-if="line['document_in']" t-attf-href="#" t-esc="line['document_in'].name" class="font-weight-bold" view-type="form" t-att-res-model="line['document_in']._name" t-att-res-id="line['document_in'].id"/>\n                                <t t-elif="line['reservation']">\n                                    Reserved from stock\n                                </t>\n                                <t t-elif="line['replenishment_filled']">\n                                    <t t-if="line['document_out']">Inventory On Hand</t>\n                                    <t t-else="">Free Stock</t>\n                                </t>\n                                <span t-else="" class="text-muted">Not Available</span>\n                            </td>\n                            <td t-esc="line['receipt_date'] or ''" t-attf-class="#{line['is_late'] and 'o_grid_warning'}"/>\n                            <td t-if="docs['multiple_product']" t-esc="line['product']['display_name']"/>\n                            <td class="text-right"><t t-if="not line['replenishment_filled']">- </t><t t-esc="line['quantity']" t-options="{&quot;widget&quot;: &quot;float&quot;, &quot;decimal_precision&quot;: &quot;Product Unit of Measure&quot;}"/></td>\n                            <td t-esc="line['uom_id'].name" groups="uom.group_uom"/>\n                            <td t-attf-class="#{not line['replenishment_filled'] and 'o_grid_warning'}">\n                                <a t-if="line['document_out']" t-attf-href="#" t-esc="line['document_out'].name" class="font-weight-bold" view-type="form" t-att-res-model="line['document_out']._name" t-att-res-id="line['document_out'].id"/>\n                            </td>\n                            <td t-esc="line['delivery_date'] or ''" t-attf-class="#{not line['replenishment_filled'] and 'o_grid_warning'}"/>\n                        </tr>\n                    </tbody>\n                    <thead>\n                        <tr class="o_forecasted_row">\n                            <td colspan="2">Forecasted Inventory</td>\n                            <td t-esc="docs['virtual_available']" class="text-right" t-options="{&quot;widget&quot;: &quot;float&quot;, &quot;decimal_precision&quot;: &quot;Product Unit of Measure&quot;}"/>\n                            <td t-esc="docs['uom']" groups="uom.group_uom"/>\n                        </tr>\n                    </thead>\n                    <tbody t-if="docs['qty']['in'] or docs['qty']['out']">\n                        <tr t-if="docs['draft_picking_qty']['in']" name="draft_picking_in">\n                            <td colspan="2">Incoming Draft Transfer</td>\n                            <td t-esc="docs['draft_picking_qty']['in']" class="text-right" t-options="{&quot;widget&quot;: &quot;float&quot;, &quot;decimal_precision&quot;: &quot;Product Unit of Measure&quot;}"/>\n                            <td t-esc="docs['uom']" groups="uom.group_uom"/>\n                        </tr>\n                        <tr t-if="docs['draft_picking_qty']['out']" name="draft_picking_out">\n                            <td colspan="2">Outgoing Draft Transfer</td>\n                            <td t-esc="-docs['draft_picking_qty']['out']" class="text-right" t-options="{&quot;widget&quot;: &quot;float&quot;, &quot;decimal_precision&quot;: &quot;Product Unit of Measure&quot;}"/>\n                            <td t-esc="docs['uom']" groups="uom.group_uom"/>\n                        </tr>\n                    </tbody>\n                    <thead>\n                        <tr class="o_forecasted_row">\n                            <td colspan="2">Forecasted with Pending</td>\n                            <td t-esc="future_virtual_available" class="text-right" t-options="{&quot;widget&quot;: &quot;float&quot;, &quot;decimal_precision&quot;: &quot;Product Unit of Measure&quot;}"/>\n                            <td t-esc="docs['uom']" groups="uom.group_uom"/>\n                        </tr>\n                    </thead>\n                </table>\n            </div>\n        </t>\n    </t>\n\n    	stock/report/report_stock_forecasted.xml	\N	\N	\N	\N	primary	t	1	2025-08-28 11:32:42.235962	1	2025-08-28 11:32:42.235962	f

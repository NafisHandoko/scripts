1675	report_default_surat_kunjungan	\N	ehealth_document.report_default_surat_kunjungan	16	qweb	<?xml version="1.0"?>\n<t t-name="ehealth_document.report_default_surat_kunjungan">\n        <t t-call="web.html_container">\n            <div class="header mb-0" style="margin: 48px 0px; padding-top: 24px">\n                <div class="row">\n                    <div class="col-7">\n                        <img t-att-src="'/ehealth_document/static/src/img/logo-bpjs.png'" style="width: 200px;" alt="Logo BPJS"/>\n                    </div>\n                    <div class="col-5 text-left mt-2">\n                        <div class="row">\n                            <div class="col-5 pr-0" style="font-size: 14px; font-weight: bold;">\n                                Divisi Regional\n                            </div>\n                            <!-- <div class="col-6 pl-0" style="font-size: 14px;">\n                                <t t-esc="data['doc_parts']['regional']" />\n                            </div> -->\n                        </div>\n                        <div class="row">\n                            <div class="col-5 pr-0" style="font-size: 14px; font-weight: bold;">\n                                Kantor Cabang\n                            </div>\n                            <!-- <div class="col-6 pl-0" style="font-size: 14px;">\n                                <t t-esc="data['doc_parts']['kc']" />\n                            </div> -->\n                        </div>\n                    </div>\n\n                </div>\n                <div class="text-center" style="padding-top: 36px; margin-bottom: 36px;">\n                    <p style="font-size: 18px; font-weight: 600;">Data Kunjungan Puskesmas / Dokter Keluarga</p>\n                </div>\n            </div>\n\n            <div class="article mt-2" t-att-data-oe-model="o and o._name" t-att-data-oe-id="o and o.id" t-att-data-oe-lang="o and o.env.context.get('lang')" style="border: 1px solid #000; padding: 15px; font-size: 14px;">\n                <div style="border: 1px solid #000; padding: 16px 24px;">\n                    <div class="row">\n                        <div class="col-7">\n                            <div class="row">\n                                <div class="col-4">No. Kunjungan</div>\n                                <div class="col-auto">: <t t-esc="data['doc_parts']['no-kunjungan']"/></div>\n                            </div>\n                            <div class="row mt-2">\n                                <div class="col-4">Puskesmas / Dokter</div>\n                                <div class="col-auto">: <t t-esc="data['doc_parts']['nmProvider']"/> (<t t-esc="data['doc_parts']['kdProvider']"/>)</div>\n                            </div>\n                            <div class="row mt-2">\n                                <div class="col-4">Kabupaten / Kota</div>\n                                <div class="col-auto">: <t t-esc="data['doc_parts']['kota']"/></div>\n                            </div>\n                        </div>\n                        <div class="col-5" style="margin: 16px 0px; font-size: 24px; font-weight: bold;">\n                            <div>\n                                *<t t-esc="data['doc_parts']['no-kunjungan']"/>*\n                            </div>\n                        </div>\n                    </div>\n                </div>\n                <div class="row" style="padding: 48px 24px">\n                    <div class="col-6">\n                        <div class="row">\n                            <div class="col-4">Nama</div>\n                            <div class="col-auto">: <t t-esc="data['doc_parts']['nama-peserta']"/></div>\n                        </div>\n                        <div class="row mt-2">\n                            <div class="col-4">No. Kartu BPJS</div>\n                            <div class="col-auto">: <t t-esc="data['doc_parts']['bpjs-number']"/></div>\n                        </div>\n                        <div class="row mt-2">\n                            <div class="col-4">Diagnosa</div>\n                            <div class="col-auto">: <t t-esc="data['doc_parts']['diagnosa']"/></div>\n                        </div>\n                        <div class="row mt-4">\n                            <div class="col-4">Telah diberikan</div>\n                            <div class="col-auto">:</div>\n                        </div>\n                    </div>\n                    <div class="col-6">\n                        <div class="row mt-2">\n                            <div class="col-2">Umur</div>\n                            <div class="col-4">: <t t-esc="data['doc_parts']['umur']"/> Tahun</div>\n                            <div class="col-4"><t t-esc="data['doc_parts']['tgl-lahir']"/></div>\n                        </div>\n                        <div class="row mt-2">\n                            <div class="col-4">Status</div>\n                            <div class="col-auto">: <t t-esc="data['doc_parts']['status'] == true and '1' or '0'"/></div>\n                        </div>\n                        <div class="row mt-2">\n                            <div class="col-4">Jenis Kelamin</div>\n                            <div class="col-auto">: <t t-esc="data['doc_parts']['sex']"/></div>\n                        </div>\n                    </div>\n                </div>\n                <div style="padding: 24px">\n                    <p>Demikian surat ini dibuat untuk dapat dipergunakan sebagaimana mestinya.</p><br/> \n                </div>\n                <div class="row">\n                    <div class="col-8"/>\n                    <div class="col-4 text-center mb-5">\n                        <p>Salam Sejawat, <t t-esc="data['doc_parts']['tgl-kunjungan']"/></p><br/><br/>\n                        <p><t t-esc="data['doc_parts']['nama-tenaga-medis']"/></p>\n                    </div>\n                </div>\n            </div>\n        </t>\n    </t>\n	ehealth_document/report/template_surat_kunjungan/report_default_surat_kunjungan.xml	\N	\N	\N	\N	primary	t	1	2025-08-28 11:34:01.364376	1	2025-08-28 11:34:01.364376	f
790	report_stock_rule_right_arrow	\N	stock.report_stock_rule_right_arrow	16	qweb	<?xml version="1.0"?>\n<t t-name="stock.report_stock_rule_right_arrow">\n        <div class="o_report_stock_rule_arrow">\n            <svg width="100%" height="100%" viewBox="0 0 10 10">\n                <polygon points="0,0 0,10 10,5" t-attf-style="stroke: #{color}; fill: #{color};"/>\n            </svg>\n        </div>\n    </t>\n    	stock/report/report_stock_rule.xml	\N	\N	\N	\N	primary	t	1	2025-08-28 11:32:42.235962	1	2025-08-28 11:32:42.235962	f
1676	report_default_surat_rujukan_bpjs	\N	ehealth_document.report_default_surat_rujukan_bpjs	16	qweb	<?xml version="1.0"?>\n<t t-name="ehealth_document.report_default_surat_rujukan_bpjs">\n        <t t-call="web.html_container">\n            <t t-call="web.internal_layout">\n          <div class="page">\n            <div class="row" style="font-weight: bold; font-size: 18px;">\n              <div class="col-12 text-center">Surat Rujukan FKTP</div>\n            </div>\n\n            <div style="font-size: 14px; border: 2px solid black; padding: 8px;">\n              <div style="border: 2px solid black;">\n                <div class="row" style="margin: 2px 20px;">\n                  <div class="col-3">No. Rujukan</div>\n                  <div class="col-5">: \n                    <t t-if="data['no-kunjungan']">\n                      <t t-esc="data['no-kunjungan']"/>\n                    </t>\n                  </div>\n                </div>\n                <div class="row" style="margin: 2px 20px;">\n                  <div class="col-3">FKTP</div>\n                  <div class="col-4">: \n                    <t t-esc="data['poli-asal']['name']"/>\n                  </div>\n                  <div class="col-5">\n                    <t t-if="data['no-kunjungan']">\n                      <img t-att-src="'/report/barcode/?type=%s&amp;value=%s&amp;width=%s&amp;height=%s' % ('Standard39', data['no-kunjungan'], 2000, 200)" style="width:325px; height:30px; margin-left: -30px;" alt="Barcode"/>\n                    </t>\n                  </div>\n                </div>\n                <div class="row" style="margin: 2px 20px;">\n                  <div class="col-3">Kabupaten / Kota</div>\n                  <div class="col-5">: \n                    <t t-esc="data['poli-asal']['kota']"/>\n                  </div>\n                </div>\n              </div>\n\n              <div style="margin: 8px 36px;">\n                <div class="row">\n                  <div class="col-4">Kepada Yth. TS Dokter</div>\n                  <div class="col-8">: <t t-esc="data['tujuan']['poli']"/></div>\n                </div>\n                <div class="row">\n                  <div class="col-4">Di</div>\n                  <div class="col-8">: <t t-esc="data['tujuan']['nama']"/>(<t t-esc="data['tujuan']['kode-faskes']"/>)</div>\n                </div>\n              </div>\n\n              <div style="margin: 16px 36px 8px 36px;">\n                Mohon pemeriksaan dan penangan lebih lanjut pasien :\n              </div>\n\n              <div style="margin: 8px 36px;">\n                <div class="row mt-1">\n                  <div class="col-2">Nama</div>\n                  <div class="col-3">: <t t-esc="o['partner_id']['name']"/></div>\n                  <div class="col-2">Umur:</div>\n                  <div class="col-1"><t t-esc="o.count_age(o['partner_id']['birthDate'].strftime('%d/%m/%Y'))"/></div>\n                  <div class="col-2">Tahun:</div>\n                  <div class="col-2"><t t-esc="o['partner_id']['birthDate'].strftime('%d-%m-%Y')"/></div>\n                </div>\n                <div class="row mt-1">\n                  <t t-set="bpjs_identifier" t-value="(o['partner_id'].identifier).filtered(lambda x: x.type == 'bpjs')"/>\n                  <div class="col-2">No. Kartu BPJS</div>\n                  <div class="col-3">: \n                    <t t-if="bpjs_identifier">\n                      <t t-esc="bpjs_identifier[0].value"/>\n                    </t>\n                    <t t-else="">-</t>\n                  </div>\n                  <div class="col-2">Status:</div>\n                  <div class="col-3">\n                    <span class="text-center" style="border: 2px solid black; padding: 4px 8px;">\n                      <t t-if="'status-pasien'in data">\n                        <t t-esc="data['status-pasien']"/>\n                      </t>\n                    </span>\n                    <span>Utama/Tanggunan</span>\n                  </div>\n                  <div class="col-2">\n                    <t t-if="o['partner_id']['gender'] == 'male'">(L/<span style="text-decoration: line-through;">P</span>)</t>\n                    <t t-else="">(<span style="text-decoration: line-through;">L</span>/P)</t>\n                  </div>\n                </div>\n                <div class="row mt-1">\n                  <div class="col-2">Diagnosa</div>\n                  <div class="col-10">: \n                    <t t-if="'diagnosa'in data">\n                        <t t-esc="data['diagnosa']"/>\n                      </t>\n                  </div>\n                </div>\n                <div class="row mt-1">\n                  <div class="col-2">Telah diberikan</div>\n                  <div class="col-3">: -</div>\n                  <div class="col-2">Catatan:</div>\n                  <div class="col-3">-</div>\n                </div>\n              </div>\n\n              <t t-if="'alasan_tacc' in data">\n                <div style="color: red;">\n                  # Alasan Rujuk Diagnosa Non-Spesialistik: (<t t-esc="data['kode_tacc']"/>) <t t-esc="data['alasan_tacc']"/> \n                </div>     \n              </t>\n\n              <div style="margin: 48px 36px 8px 36px;">\n                Atas bantuannya, diucapkan terima kasih\n              </div>\n\n              <div style="margin: 8px;">\n                <div class="row mt-1">\n                  <div class="col-8">\n                    <div style="height: 50px"/>\n                    <div class="mb-1">Tgl. Rencana Berkunjung: <t t-esc="o.to_date_string(data['tgl-berkunjung'])"/></div>\n                    <div class="mb-1">Jadwal Praktek: <t t-esc="data['tujuan']['jadwal']"/> </div>\n                    <div class="mb-1">Surat rujukan berlaku 1[satu] kali kunjungan, berlaku sampai dengan: <t t-esc="o.to_date_string_90_days(data['registration_date'])"/> </div>\n                  </div>\n\n                  <div class="col-4 text-center">\n                    <div>Salam sejawat,</div>\n                    <div><t t-esc="o.to_date_string(data['registration_date'])"/></div>\n                    <div style="height: 60px"/>\n                    <div>\n                      <t t-if="'examiner_name' in data">\n                        <t t-esc="data['examiner_name']"/>\n                      </t>\n                      <t t-else="">\n                        <t t-esc="data['sender']"/>\n                      </t>\n                    </div>\n                  </div>\n                </div>\n              </div>\n            </div>\n\n            <div style="border-left: 2px solid black;                     border-right: 2px solid black;                     border-bottom: 2px solid black;                     padding: 8px; font-size: 14px;">\n              <div class="row">\n                <div class="col-12 text-center" style="text-decoration:underline; font-weight: bold; font-size: 16px;">\n                  SURAT RUJUKAN BALIK\n                </div>\n              </div>\n\n              <div style="margin: 24px 24px 8px 24px;">\n                <div>Teman sejawat Yth.</div>\n                <div>Mohon kontrol selanjutnya penderita :</div>\n              </div>\n\n              <div style="margin-left: 56px;">\n                <div class="row mb-1">\n                  <div class="col-3">Nama</div>\n                  <div class="col-7">: <t t-esc="o['partner_id']['name']"/></div>\n                </div>\n\n                <div class="row mb-1">\n                  <div class="col-3">Diagnosa</div>\n                  <div class="col-7">: <t t-foreach="range(1, 125)" t-as="i">.</t></div>\n                </div>\n\n                <div class="row mb-1">\n                  <div class="col-3">Terapi</div>\n                  <div class="col-7">: <t t-foreach="range(1, 125)" t-as="i">.</t></div>\n                </div>\n              </div>\n\n              <div style="margin: 8px 24px;">\n                Tindak lanjut yang dianjurkan\n              </div>\n\n              <div style="margin: 8px 24px;">\n                <div class="row">\n                  <div class="col-1"><div style="border: 2px solid black; width: 30px; height: 20px; margin: auto;"/></div>\n                  <div class="col-5">Pengobatan dengan obat-obatan : </div>\n                  <div class="col-1"/>\n                  <div class="col-1"><div style="border: 2px solid black; width: 30px; height: 20px; margin: auto;"/></div>\n                  <div class="col-4">Perlu rawat inap</div>\n                </div>\n\n                <div class="row mt-1">\n                  <div class="col-1"/>\n                  <div class="col-5">\n                    <t t-foreach="range(1, 100)" t-as="i">.</t>\n                  </div>\n                  <div class="col-1"/>\n                  <div class="col-1"><div style="border: 2px solid black; width: 30px; height: 20px; margin: auto;"/></div>\n                  <div class="col-4">Konsultasi selesai</div>\n                </div>\n\n                <div class="row mt-1">\n                  <div class="col-1"><div style="border: 2px solid black; width: 30px; height: 20px; margin: auto;"/></div>\n                  <div class="col-5">Kontrol kembali ke RS tanggal : <t t-foreach="range(1, 35)" t-as="i">.</t></div>\n                </div>\n\n                <div class="row mt-1">\n                  <div class="col-1"><div style="border: 2px solid black; width: 30px; height: 20px; margin: auto;"/></div>\n                  <div class="col-5">Lain-lain : <t t-foreach="range(1, 80)" t-as="i">.</t></div>\n                </div>\n\n                <div class="row mt-1" style="page-break-inside: avoid; page-break-before: auto;">\n                  <div class="col-8"/>\n                  <div class="col-4 text-center">\n                    <div><t t-foreach="range(1, 25)" t-as="i">.</t>tgl<t t-foreach="range(1, 40)" t-as="i">.</t></div>\n                    <div>Dokter RS,</div>\n                    <div style="height: 60px"/>\n                    <div>( <t t-foreach="range(1, 60)" t-as="i">.</t> )</div>\n                  </div>\n                </div>\n              </div>\n            </div>\n\n          </div>\n          </t>\n        </t>\n      </t>\n    	ehealth_document/report/template_surat_rujukan_bpjs/template_default_surat_rujukan_bpjs.xml	\N	\N	\N	\N	primary	t	1	2025-08-28 11:34:01.364376	1	2025-08-28 11:34:01.364376	f
1677	report_default_purchase_order	\N	ehealth_document.report_default_purchase_order	16	qweb	<?xml version="1.0"?>\n<t t-name="ehealth_document.report_default_purchase_order">\n        <t t-call="web.external_layout">\n            <t t-set="o" t-value="o.with_context(lang=o.partner_id.lang)"/>\n            <t t-set="address">\n                <div t-field="o.partner_id" t-options="{&quot;widget&quot;: &quot;contact&quot;, &quot;fields&quot;: [&quot;address&quot;, &quot;name&quot;, &quot;phone&quot;], &quot;no_marker&quot;: True, &quot;phone_icons&quot;: True}"/>\n                <p t-if="o.partner_id.vat"><t t-esc="o.company_id.country_id.vat_label or 'Tax ID'"/>: <span t-field="o.partner_id.vat"/></p>\n            </t>\n            <t t-if="o.dest_address_id">\n                <t t-set="information_block">\n                    <strong>Shipping address:</strong>\n                    <div t-if="o.dest_address_id">\n                        <div t-field="o.dest_address_id" t-options="{&quot;widget&quot;: &quot;contact&quot;, &quot;fields&quot;: [&quot;address&quot;, &quot;name&quot;, &quot;phone&quot;], &quot;no_marker&quot;: True, &quot;phone_icons&quot;: True}" name="purchase_shipping_address"/>\n                    </div>\n\n                </t>\n            </t>\n            <t t-else="">\n                <t t-set="information_block">\n                    <strong>Shipping address:</strong>\n                    <div t-if="o.picking_type_id and o.picking_type_id.warehouse_id">\n                        <span t-field="o.picking_type_id.warehouse_id.name"/>\n                        <div t-field="o.picking_type_id.warehouse_id.partner_id" t-options="{&quot;widget&quot;: &quot;contact&quot;, &quot;fields&quot;: [&quot;address&quot;, &quot;phone&quot;], &quot;no_marker&quot;: True, &quot;phone_icons&quot;: True}"/>\n                    </div>\n                </t>\n            </t>\n            <div class="page">\n                <div class="oe_structure"/>\n\n                <h2 t-if="o.state == 'draft'">Request for Quotation #<span t-field="o.name"/></h2>\n                <h2 t-if="o.state in ['sent', 'to approve']">Purchase Order #<span t-field="o.name"/></h2>\n                <h2 t-if="o.state in ['purchase', 'done']">Purchase Order #<span t-field="o.name"/></h2>\n                <h2 t-if="o.state == 'cancel'">Cancelled Purchase Order #<span t-field="o.name"/></h2>\n\n                <div id="informations" class="row mt32 mb32">\n                    <div t-if="o.user_id" class="col-3 bm-2">\n                        <strong>Purchase Representative:</strong>\n                        <p t-field="o.user_id" class="m-0"/>\n                    </div>\n                    <div t-if="o.partner_ref" class="col-3 bm-2">\n                        <strong>Your Order Reference:</strong>\n                        <p t-field="o.partner_ref" class="m-0"/>\n                    </div>\n                    <div t-if="o.date_order" class="col-3 bm-2">\n                        <strong>Order Date:</strong>\n                        <p t-field="o.date_order" class="m-0"/>\n                    </div>\n                </div>\n\n                <table class="table table-sm o_main_table">\n                    <thead>\n                        <tr>\n                            <th name="th_description"><strong>Description</strong></th>\n                            <th name="th_taxes"><strong>Taxes</strong></th>\n                            <th name="th_date_req" class="text-center"><strong>Date Req.</strong></th>\n                            <th name="th_quantity" class="text-right"><strong>Qty</strong></th>\n                            <th name="th_price_unit" class="text-right"><strong>Unit Price</strong></th>\n                            <th name="th_amount" class="text-right"><strong>Amount</strong></th>\n                        </tr>\n                    </thead>\n                    <tbody>\n                        <t t-set="current_subtotal" t-value="0"/>\n                        <t t-foreach="o.order_line" t-as="line">\n                            <t t-set="current_subtotal" t-value="current_subtotal + line.price_subtotal" groups="account.group_show_line_subtotals_tax_excluded"/>\n                            <t t-set="current_subtotal" t-value="current_subtotal + line.price_total" groups="account.group_show_line_subtotals_tax_included"/>\n\n                            <tr t-att-class="'bg-200 font-weight-bold o_line_section' if line.display_type == 'line_section' else 'font-italic o_line_note' if line.display_type == 'line_note' else ''">\n                                <t t-if="not line.display_type">\n                                    <td id="product">\n                                        <span t-field="line.name"/>\n                                    </td>\n                                    <td name="td_taxes">\n                                        <span t-esc="', '.join(map(lambda x: x.name, line.taxes_id))"/>\n                                    </td>\n                                    <td class="text-center">\n                                        <span t-field="line.date_planned"/>\n                                    </td>\n                                    <td class="text-right">\n                                        <span t-field="line.product_qty"/>\n                                        <span t-field="line.product_uom.name" groups="uom.group_uom"/>\n                                    </td>\n                                    <td class="text-right">\n                                        <span t-field="line.price_unit"/>\n                                    </td>\n                                    <td class="text-right">\n                                        <span t-field="line.price_subtotal" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: o.currency_id}"/>\n                                    </td>\n                                </t>\n                                <t t-if="line.display_type == 'line_section'">\n                                    <td colspan="99" id="section">\n                                        <span t-field="line.name"/>\n                                    </td>\n                                    <t t-set="current_section" t-value="line"/>\n                                    <t t-set="current_subtotal" t-value="0"/>\n                                </t>\n                                <t t-if="line.display_type == 'line_note'">\n                                    <td colspan="99" id="note">\n                                        <span t-field="line.name"/>\n                                    </td>\n                                </t>\n                            </tr>\n                            <t t-if="current_section and (line_last or o.order_line[line_index+1].display_type == 'line_section')">\n                                <tr class="is-subtotal text-right">\n                                    <td colspan="99" id="subtotal">\n                                        <strong class="mr16">Subtotal</strong>\n                                        <span t-esc="current_subtotal" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: o.currency_id}"/>\n                                    </td>\n                                </tr>\n                            </t>\n                        </t>\n                    </tbody>\n                </table>\n\n                <div id="total" class="row justify-content-end">\n                    <div class="col-4">\n                        <table class="table table-sm">\n                            <tr class="border-black">\n                                <td name="td_subtotal_label"><strong>Subtotal</strong></td>\n                                <td class="text-right">\n                                    <span t-field="o.amount_untaxed" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: o.currency_id}"/>\n                                </td>\n                            </tr>\n                            <tr>\n                                <td name="td_taxes_label">Taxes</td>\n                                <td class="text-right">\n                                    <span t-field="o.amount_tax" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: o.currency_id}"/>\n                                </td>\n                            </tr>\n                            <tr class="border-black o_total">\n                                <td name="td_amount_total_label"><strong>Total</strong></td>\n                                <td class="text-right">\n                                    <span t-field="o.amount_total" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: o.currency_id}"/>\n                                </td>\n                            </tr>\n                        </table>\n                    </div>\n                </div>\n\n                <p t-field="o.notes"/>\n                <div class="oe_structure"/>\n            </div>\n        </t>\n    </t>\n	ehealth_document/report/purchase_order/report_default_purchase_order.xml	\N	\N	\N	\N	primary	t	1	2025-08-28 11:34:01.364376	1	2025-08-28 11:34:01.364376	f
1678	report_westerindo_purchase_order	\N	ehealth_document.report_westerindo_purchase_order	16	qweb	<?xml version="1.0"?>\n<t t-name="ehealth_document.report_westerindo_purchase_order">\n        <t t-call="web.external_layout">\n            <t t-set="o" t-value="o.with_context(lang=o.partner_id.lang)"/>\n            <div class="page" style="font-size:12px;">\n                <div class="oe_structure"/>\n\n                <p class="text-center mb-0" style="font-size:14px;"><strong>PURCHASE ORDER</strong></p>\n                <p class="text-center" style="font-size:14px;">No. <span t-field="o.name"/></p>\n\n                <div id="informations" class="pb-3">\n                    <div t-if="o.partner_id">\n                        <div class="row py-0">\n                            <div class="col-2 py-0">Kepada Yth.</div>\n                            <div class="col-8 py-y">: <t t-esc="o.partner_id.name"/></div>\n                        </div>\n                        <div class="row py-0">\n                            <div class="col-2 py-0">No. Telp</div>\n                            <div class="col-8 py-y">: <t t-esc="o.partner_id.phone"/></div>\n                        </div>\n                        <div class="row py-0">\n                            <div class="col-2 py-0">Email</div>\n                            <div class="col-8 py-y">: <t t-esc="o.partner_id.email"/></div>\n                        </div>\n                        <div class="row pt-2">\n                            <div class="col-2 py-0">Mohon dikirim ke</div>\n                            <div class="col-4 py-0">: Westerindo Cipaku</div>\n                            <div class="col-6 py-y text-right">Tanggal: <span t-field="o.date_order"/></div>\n                        </div>\n                    </div>\n                </div>\n\n                <table class="table table-sm table-bordered o_main_table">\n                    <thead>\n                        <tr>\n                            <th name="th_number" class="text-center"><strong>NO</strong></th>\n                            <th name="th_code" class="text-center"><strong>CAT. NO</strong></th>\n                            <th name="th_description" class="text-center"><strong>NAMA BARANG</strong></th>\n                            <th name="th_quantity" class="text-center"><strong>JUMLAH</strong></th>\n                            <th name="th_quantity" class="text-center"><strong>SATUAN</strong></th>\n                            <th name="th_price_unit" class="text-center"><strong>HARGA SATUAN</strong></th>\n                            <th name="th_discount" class="text-center"><strong>DISKON</strong></th>\n                            <th name="th_taxes" class="text-center"><strong>PPN</strong></th>\n                            <th name="th_amount" class="text-center"><strong>TOTAL</strong></th>\n                        </tr>\n                    </thead>\n                    <tbody>\n                        <t t-set="current_subtotal" t-value="0"/>\n                        <t t-set="data_number" t-value="1"/>\n                        <t t-foreach="o.order_line" t-as="line">\n                            <t t-set="current_subtotal" t-value="current_subtotal + line.price_subtotal" groups="account.group_show_line_subtotals_tax_excluded"/>\n                            <t t-set="current_subtotal" t-value="current_subtotal + line.price_total" groups="account.group_show_line_subtotals_tax_included"/>\n\n                            <tr t-att-class="'bg-200 font-weight-bold o_line_section' if line.display_type == 'line_section' else 'font-italic o_line_note' if line.display_type == 'line_note' else ''">\n                                <t t-if="not line.display_type">\n                                    <td class="text-center">\n                                        <span t-esc="data_number"/>\n                                    </td>\n                                    <td class="text-center">\n                                        <span t-field="line.product_id.default_code"/>\n                                    </td>\n                                    <td id="product">\n                                        <span t-field="line.product_id.name"/>\n                                    </td>\n                                    <td class="text-right">\n                                        <span t-esc="round(line.product_qty)"/>\n                                    </td>\n                                    <td>\n                                        <span t-field="line.product_uom.name" groups="uom.group_uom"/>\n                                    </td>\n                                    <td class="text-right">\n                                        <span t-esc="line.price_unit" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: o.currency_id}"/>\n                                    </td>\n                                    <td class="text-right">\n                                        <span t-esc="str(line.discount).rstrip('0').rstrip('.') + '%'"/>\n                                    </td>\n                                    <td name="td_taxes" class="text-center">\n                                        <span t-esc="', '.join(map(lambda x: x.name, line.taxes_id))"/>\n                                    </td>\n                                    <td class="text-right">\n                                        <span t-esc="line.price_subtotal + line.price_tax" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: o.currency_id}"/>\n                                    </td>\n                                </t>\n                                <t t-if="line.display_type == 'line_section'">\n                                    <td colspan="99" id="section">\n                                        <span t-field="line.name"/>\n                                    </td>\n                                    <t t-set="current_section" t-value="line"/>\n                                    <t t-set="current_subtotal" t-value="0"/>\n                                </t>\n                                <t t-if="line.display_type == 'line_note'">\n                                    <td colspan="99" id="note">\n                                        <span t-field="line.name"/>\n                                    </td>\n                                </t>\n                            </tr>\n                            <t t-if="current_section and (line_last or o.order_line[line_index+1].display_type == 'line_section')">\n                                <tr class="is-subtotal text-right">\n                                    <td colspan="99" id="subtotal">\n                                        <strong class="mr16">Subtotal</strong>\n                                        <span t-esc="current_subtotal" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: o.currency_id}"/>\n                                    </td>\n                                </tr>\n                            </t>\n                            <t t-set="data_number" t-value="data_number + 1"/>\n                        </t>\n                        <tr>\n                            <td name="td_amount_total_label" colspan="8"><strong>Grand Total</strong></td>\n                            <td class="text-right">\n                                <strong>\n                                    <span t-field="o.amount_total" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: o.currency_id}"/>\n                                </strong>\n                            </td>\n                        </tr>\n                    </tbody>\n                </table>\n\n                <div class="py-3">\n                    <p class="pb-0"><strong>NOTE</strong></p>\n                    <ol>\n                        <li>Tukar faktur dilakukan hanya pada hari Kamis jam 09.00 - 15.00.</li>\n                        <li>Pembayaran dilakukan 1 bulan setelah tukar faktur.</li>\n                        <li>PO ini berlaku 14 hari sejak tanggal PO dikeluarkan.</li>\n                        <li>Barang yang dikirimkan harus masih tersegel.</li>\n                    </ol>\n                </div>\n\n                <div>\n                    <div class="row py-0">\n                        <div class="col-3 py-0 text-center">Pemesan</div>\n                        <div class="col-5"/>\n                        <div class="col-3 py-0 text-center">Penerima Pesanan</div>\n                    </div>\n                    <div class="row pt-5 mt-4">\n                        \n                        <div class="col-3 py-y text-center">(   <span t-field="o.user_id.name"/>   )</div>\n                        <div class="col-5"/>\n                        <div class="col-3 py-y text-center">(<span style="display: inline-block; margin-left: 120px;"/>)</div>\n                    </div>\n                    \n                </div>\n                \n\n                <p t-field="o.notes"/>\n                <div class="oe_structure"/>\n            </div>\n        </t>\n    </t>\n	ehealth_document/report/purchase_order/report_westerindo_purchase_order.xml	\N	\N	\N	\N	primary	t	1	2025-08-28 11:34:01.364376	1	2025-08-28 11:34:01.364376	f
794	label_transfer_template_view_zpl	\N	stock.label_transfer_template_view_zpl	16	qweb	<?xml version="1.0"?>\n<t t-name="stock.label_transfer_template_view_zpl">\n            <t t-set="uom_categ_unit" t-value="env.ref('uom.product_uom_categ_unit')"/>\n            <t t-foreach="docs" t-as="picking">\n\n                <t t-set="picking_qty_done" t-value="any(picking.move_lines.move_line_ids.mapped('qty_done'))"/>\n                <t t-foreach="picking.move_lines" t-as="move">\n                    <t t-foreach="move.move_line_ids" t-as="move_line">\n                        <t t-if="move_line.product_uom_id.category_id == uom_categ_unit">\n                            <t t-if="picking_qty_done">\n                                <t t-set="qty" t-value="int(move_line.qty_done)"/>\n                            </t>\n                            <t t-else="">\n                                <t t-set="qty" t-value="int(move_line.product_uom_qty)"/>\n                            </t>\n                        </t>\n                        <t t-else="">\n                            <t t-set="qty" t-value="1"/>\n                        </t>\n                        <t t-foreach="range(qty)" t-as="item">\n                            <t t-translation="off">\n^XA\n^FO100,50\n^A0N,44,33^FD<t t-esc="move_line.product_id.display_name"/>^FS\n^FO100,100\n<t t-if="move_line.product_id.tracking != 'none' and (move_line.lot_id or move_line.lot_name)">\n^A0N,44,33^FDLN/SN: <t t-esc="move_line.lot_id.name or move_line.lot_name"/>^FS\n^FO100,150^BY3\n^BCN,100,Y,N,N\n^FD<t t-esc="move_line.lot_id.name or move_line.lot_name"/>^FS\n</t>\n<t t-if="move_line.product_id.tracking == 'none' and move_line.product_id.barcode">\n^BCN,100,Y,N,N\n^FD<t t-esc="move_line.product_id.barcode"/>^FS\n</t>\n^XZ\n                            </t>\n                        </t>\n                    </t>\n                </t>\n            </t>\n        </t>\n\n        	stock/report/picking_templates.xml	\N	\N	\N	\N	primary	t	1	2025-08-28 11:32:42.235962	1	2025-08-28 11:32:42.235962	f
795	label_transfer_template_view_pdf	\N	stock.label_transfer_template_view_pdf	16	qweb	<?xml version="1.0"?>\n<t t-name="stock.label_transfer_template_view_pdf">\n            <t t-call="web.basic_layout">\n                <div class="page">\n                    <t t-set="uom_categ_unit" t-value="env.ref('uom.product_uom_categ_unit')"/>\n                    <t t-foreach="docs" t-as="picking">\n                        <t t-set="picking_qty_done" t-value="any(picking.move_lines.move_line_ids.mapped('qty_done'))"/>\n                        <t t-foreach="picking.move_lines" t-as="move">\n                            <t t-foreach="move.move_line_ids" t-as="move_line">\n                                <t t-if="move_line.product_uom_id.category_id == uom_categ_unit">\n                                    <t t-if="picking_qty_done">\n                                        <t t-set="qty" t-value="int(move_line.qty_done)"/>\n                                    </t>\n                                    <t t-else="">\n                                        <t t-set="qty" t-value="int(move_line.product_uom_qty)"/>\n                                    </t>\n                                </t>\n                                <t t-else="">\n                                    <t t-set="qty" t-value="1"/>\n                                </t>\n                                <t t-foreach="range(qty)" t-as="item">\n                                    <t t-translation="off">\n                                        <div style="display: inline-table; height: 10rem; width: 32%;">\n                                            <table class="table table-bordered" style="border: 2px solid black;" t-if="picking.move_lines">\n                                                <tr>\n                                                    <th class="table-active text-left" style="height:4rem;">\n                                                        <span t-esc="move.product_id.display_name"/>\n                                                    </th>\n                                                </tr>\n                                                <t t-if="move_line.product_id.tracking != 'none'">\n                                                    <tr>\n                                                        <td class="text-center align-middle">\n                                                            <t t-if="move_line.lot_name or move_line.lot_id">\n                                                                <img t-att-src="'/report/barcode/?type=%s&amp;value=%s&amp;width=%s&amp;height=%s' % ('Code128', move_line.lot_name, 600, 150)" style="width:100%;height:4rem" alt="Barcode"/>\n                                                                <span t-esc="move_line.lot_name or move_line.lot_id.name"/>\n                                                            </t>\n                                                            <t t-else="">\n                                                                <span class="text-muted">No barcode available</span>\n                                                            </t>\n                                                        </td>\n                                                    </tr>\n                                                </t>\n                                                <t t-if="move_line.product_id.tracking == 'none'">\n                                                    <tr>\n                                                        <td class="text-center align-middle" style="height: 6rem;">\n                                                            <t t-if="move_line.product_id.barcode">\n                                                                    <img t-att-src="'/report/barcode/?type=%s&amp;value=%s&amp;width=%s&amp;height=%s' % ('Code128', move_line.product_id.barcode, 600, 150)" style="width:100%;height:4rem" alt="Barcode"/>\n                                                                    <span t-esc="move_line.product_id.barcode"/>\n                                                            </t>\n                                                            <t t-else="">\n                                                                <span class="text-muted">No barcode available</span>\n                                                            </t>\n                                                        </td>\n                                                    </tr>\n                                                </t>\n                                            </table>\n                                        </div>\n                                    </t>\n                                </t>\n                            </t>\n                        </t>\n                    </t>\n                </div>\n            </t>\n        </t>\n\n        	stock/report/picking_templates.xml	\N	\N	\N	\N	primary	t	1	2025-08-28 11:32:42.235962	1	2025-08-28 11:32:42.235962	f
1679	report_senopatiskincenter_purchase_order	\N	ehealth_document.report_senopatiskincenter_purchase_order	16	qweb	<?xml version="1.0"?>\n<t t-name="ehealth_document.report_senopatiskincenter_purchase_order">\n        <t t-set="company" t-value="res_company"/>\n        <t t-call="ehealth_document.header_senopatiskincenter_document">\n            <t t-set="o" t-value="o.with_context(lang=o.partner_id.lang)"/>\n            <div class="page">\n                <div style="width: 100%; border-bottom: 1px solid black">\n                    <p class="text-center m-0" style="font-size: 1.1rem;"><strong>SURAT PESANAN BARANG</strong></p>\n                </div>\n                <div class="row">\n                    <div class="col-6">\n                        <div class="row">\n                            <div class="col-4">No. SP</div>\n                            <div class="col-4">: <span t-field="o.name"/></div>\n                        </div>\n                        <div class="row">\n                            <div class="col-4">Tgl. Pemesanan</div>\n                            <div class="col-4">: <span t-esc="o.date_approve and o.date_approve.strftime('%d/%m/%Y') or ''"/></div>\n                        </div>\n                        <div class="row">\n                            <div class="col-4">Tgl. Pengiriman</div>\n                            <div class="col-4">: <span t-esc="o.date_order and o.date_planned.strftime('%d/%m/%Y') or ''"/></div>\n                        </div>\n                    </div>\n                    <div class="col-6">\n                        <div class="row">\n                            <div class="col-4">Pemasok</div>\n                            <div class="col-4">: <span t-field="o.partner_id.name"/></div>\n                        </div>\n                        <div class="row">\n                            <div class="col-4">Alamat</div>\n                            <div class="col-4">: <span t-field="o.partner_id.street"/></div>\n                        </div>\n                        <div class="row">\n                            <div class="col-4">No. Telepon</div>\n                            <div class="col-4">: <span t-field="o.partner_id.phone"/></div>\n                        </div>\n                        <div class="row">\n                            <div class="col-4">Pemesan</div>\n                            <div class="col-4">: <span t-field="o.user_id.name"/></div>\n                        </div>\n                    </div>\n                </div>\n                <br/>\n\n                <table style="width: 100%; border-collapse: collapse; text-align: left; border: 1px solid black; border-left: none; border-right: none;">\n                    <thead>\n                        <tr style="border-top: 2px solid black;">\n                            <th name="th_code" class="text-center" style="width: 15%; border: 1px solid black; border-left: none;">Kode</th>\n                            <th name="th_description" class="text-center" style="width: 40%; border: 1px solid black;">Deskripsi</th>\n                            <th name="th_quantity" class="text-center" style="width: 15%; border: 1px solid black;">Qty</th>\n                            <th name="th_quantity" class="text-center" style="width: 15%; border: 1px solid black;">Satuan</th>\n                            <th style="width: 15%; border: 1px solid black; padding: 8px; border-right: none;"/>\n                        </tr>\n                    </thead>\n                    <tbody>\n                        <t t-foreach="o.order_line" t-as="line">\n                            <tr>\n                                <td class="text-center">\n                                    <span t-field="line.product_id.default_code"/>\n                                </td>\n                                <td id="product" style="padding-left: 5px;">\n                                    <span t-field="line.product_id.name"/>\n                                </td>\n                                <td class="text-center">\n                                    <span t-esc="round(line.product_qty)"/>\n                                </td>\n                                <td style="padding-left: 5px;">\n                                    <span t-field="line.product_uom.name" groups="uom.group_uom"/>\n                                </td>\n                                <td/>\n                            </tr>\n                        </t>\n                    </tbody>\n                </table>\n                <p class="py-1">Catatan: Cantumkan Nomor SP diatas pada Faktur, Tagihan, dan Surat Jalan</p>\n\n                <div>\n                    <div class="row py-0">\n                        <div class="col-3 py-0 text-center">Apoteker,</div>\n                        <div class="col-5"/>\n                        <div class="col-3 py-0 text-center">Penerima SP,</div>\n                    </div>\n                    <div class="row pt-5 mt-4">\n                        \n                        <div class="col-3 py-y text-center"><t t-esc="o.user_id.name"/></div>\n                        <div class="col-5"/>\n                        <div class="col-3 py-y text-center">(_________________________)</div>\n                    </div>\n                    \n                </div>\n            </div>\n        </t>\n    </t>\n	ehealth_document/report/purchase_order/report_senopatiskincenter_purchase_order.xml	\N	\N	\N	\N	primary	t	1	2025-08-28 11:34:01.364376	1	2025-08-28 11:34:01.364376	f
828	Product Template Kanban Stock	product.template	\N	16	kanban	<?xml version="1.0"?>\n<data><xpath expr="//kanban" position="inside">\n                    <field name="type"/>\n                    <field name="show_on_hand_qty_status_button"/>\n                </xpath>\n                <xpath expr="//div[@name='product_lst_price']" position="after">\n                    <div t-if="record.show_on_hand_qty_status_button.raw_value">On hand: <field name="qty_available"/> <field name="uom_id"/></div>\n                </xpath>\n            </data>	stock/views/product_views.xml	\N	\N	477	\N	extension	t	1	2025-08-28 11:32:42.235962	1	2025-08-28 11:32:42.235962	f
797	label_product_template_view	\N	stock.label_product_template_view	16	qweb	<?xml version="1.0"?>\n<t t-name="stock.label_product_template_view">\n            <t t-foreach="docs" t-as="product">\n                <t t-translation="off">\n^XA\n^FO100,50\n^A0N,44,33^FD<t t-esc="product.display_name"/>^FS\n^FO100,100\n<t t-if="product.currency_id.position == 'after'">\n^CI28\n^A0N,44,33^FH^FDPrice: <t t-esc="product.list_price" t-options="{&quot;widget&quot;: &quot;float&quot;, &quot;precision&quot;: 2}"/><t t-esc="product.currency_id.symbol"/>^FS\n</t>\n<t t-if="product.currency_id.position == 'before'">\n^CI28\n^A0N,44,33^FH^FDPrice: <t t-esc="product.currency_id.symbol"/><t t-esc="product.list_price" t-options="{&quot;widget&quot;: &quot;float&quot;, &quot;precision&quot;: 2}"/>^FS\n</t>\n<t t-if="product.barcode">\n^FO100,150^BY3\n^BCN,100,Y,N,N\n^FD<t t-esc="product.barcode"/>^FS\n</t>\n^XZ\n                </t>\n            </t>\n        </t>\n        	stock/report/product_templates.xml	\N	\N	\N	\N	primary	t	1	2025-08-28 11:32:42.235962	1	2025-08-28 11:32:42.235962	f
798	label_product_product_view	\N	stock.label_product_product_view	16	qweb	<?xml version="1.0"?>\n<t t-name="stock.label_product_product_view">\n            <t t-foreach="docs" t-as="product">\n                <t t-translation="off">\n^XA\n^FO100,50\n^A0N,44,33^FD<t t-esc="product.display_name"/>^FS\n^FO100,100\n<t t-if="product.currency_id.position == 'after'">\n^CI28\n^A0N,44,33^FH^FDPrice: <t t-esc="product.lst_price" t-options="{&quot;widget&quot;: &quot;float&quot;, &quot;precision&quot;: 2}"/><t t-esc="product.currency_id.symbol"/>^FS\n</t>\n<t t-if="product.currency_id.position == 'before'">\n^CI28\n^A0N,44,33^FH^FDPrice: <t t-esc="product.currency_id.symbol"/><t t-esc="product.lst_price" t-options="{&quot;widget&quot;: &quot;float&quot;, &quot;precision&quot;: 2}"/>^FS\n</t>\n<t t-if="product.barcode">\n^FO100,150^BY3\n^BCN,100,Y,N,N\n^FD<t t-esc="product.barcode"/>^FS\n</t>\n^XZ\n                </t>\n            </t>\n        </t>\n        	stock/report/product_templates.xml	\N	\N	\N	\N	primary	t	1	2025-08-28 11:32:42.235962	1	2025-08-28 11:32:42.235962	f
1680	report_westerindo_po_ihc	\N	ehealth_document.report_westerindo_po_ihc	16	qweb	<?xml version="1.0"?>\n<t t-name="ehealth_document.report_westerindo_po_ihc">\n        <t t-call="web.html_container">\n            <t t-call="web.external_layout">\n                <t t-set="o" t-value="o.with_context(lang=o.partner_id.lang)"/>\n                <div class="page" style="font-size:12px;">\n                    <div class="oe_structure"/>\n                    <p class="text-center mb-0" style="font-size:14px;"><strong>PURCHASE ORDER</strong></p>\n                    <p class="text-center" style="font-size:14px;">No. <span t-field="o.name"/></p>\n                    \n                    <div id="informations" class="pb-3">\n                        <div class="row py-0">\n                            <div class="col-2 py-0">Kepada Yth.</div>\n                            <div class="col-8 py-y">: Westerindo Pusat</div>\n                        </div>\n                        <div class="row py-0">\n                            <div class="col-2 py-0">No. Telp</div>\n                            <div class="col-8 py-y">: (021) 7392345</div>\n                        </div>\n                        <div class="row pt-2">\n                            <div class="col-2 py-0">Mohon dikirim ke</div>\n                            <div class="col-4 py-0">: <span t-field="o.operating_unit_id.name"/> </div>\n                            <div class="col-6 py-y text-right">Tanggal: <span t-field="o.scheduled_date"/></div>\n                        </div>\n                    </div>\n\n                    <table class="table table-sm table-bordered o_main_table" name="stock_move_table">\n                        <thead>\n                            <tr>\n                                <th name="th_number" class="text-center"><strong>NO</strong></th>\n                                <th name="th_code" class="text-center"><strong>CAT. NO</strong></th>\n                                <th name="th_description" class="text-center"><strong>NAMA BARANG</strong></th>\n                                <th name="th_quantity" class="text-center"><strong>JUMLAH</strong></th>\n                                <th name="th_quantity" class="text-center"><strong>SATUAN</strong></th>\n                            </tr>\n                        </thead>\n                        <tbody>\n                            <t t-set="lines" t-value="o.move_lines.filtered(lambda x: x.product_uom_qty)"/>\n                            <t t-set="data_number" t-value="1"/>\n                            <t t-foreach="lines" t-as="move">\n                                <tr>\n                                    <td class="text-center">\n                                        <span t-esc="data_number"/>\n                                    </td>\n                                    <td class="text-center">\n                                        <span t-field="move.product_id.default_code"/>\n                                    </td>\n                                    <td>\n                                        <span t-field="move.product_id.name"/>\n                                    </td>\n                                    <td class="text-right">\n                                        <span t-esc="round(move.product_uom_qty)"/>\n                                    </td>\n                                    <td>\n                                        <span t-field="move.product_uom"/>\n                                    </td>\n                                </tr>\n                                <t t-set="data_number" t-value="data_number + 1"/>\n                            </t>\n                        </tbody>\n                    </table>\n\n                    <!-- <div class="py-3">\n                        <p class="pb-0"><strong>NOTE</strong></p>\n                        <ol>\n                            <li>Tukar faktur dilakukan hanya pada hari Kamis jam 09.00 - 15.00.</li>\n                            <li>Pembayaran dilakukan 1 bulan setelah tukar faktur.</li>\n                            <li>PO ini berlaku 14 hari sejak tanggal PO dikeluarkan.</li>\n                            <li>Barang yang dikirimkan harus masih tersegel.</li>\n                        </ol>\n                    </div> -->\n\n                    <div class="py-3">\n                        <div class="row py-0">\n                            <div class="col-3 py-0 text-center">Pemesan</div>\n                            <div class="col-5"/>\n                            <div class="col-3 py-0 text-center">Penerima Pesanan</div>\n                        </div>\n                        <div class="row pt-5 mt-4">\n                            \n                            <div class="col-3 py-y text-center">(   <span t-field="o.user_id.name"/>   )</div>\n                            <div class="col-5"/>\n                            <div class="col-3 py-y text-center">(<span style="display: inline-block; margin-left: 120px;"/>)</div>\n                        </div>\n                        \n                    </div>\n                </div>\n            </t>\n        </t>\n    </t>\n	ehealth_document/report/purchase_order/report_westerindo_po_ihc.xml	\N	\N	\N	\N	primary	t	1	2025-08-28 11:34:01.364376	1	2025-08-28 11:34:01.364376	f
1681	report_westerindo_delivery_slip	\N	ehealth_document.report_westerindo_delivery_slip	16	qweb	<?xml version="1.0"?>\n<t t-name="ehealth_document.report_westerindo_delivery_slip">\n        <t t-call="web.html_container">\n            <t t-call="web.external_layout">\n                <t t-set="o" t-value="o.with_context(lang=o.partner_id.lang or o.env.lang)"/>\n                <t t-set="partner" t-value="o.partner_id or (o.move_lines and o.move_lines[0].partner_id) or False"/>\n                <t t-if="partner" name="partner_header">\n                    <t t-set="address">\n                        <div t-esc="partner" t-options="{&quot;widget&quot;: &quot;contact&quot;, &quot;fields&quot;: [&quot;address&quot;, &quot;name&quot;, &quot;phone&quot;], &quot;no_marker&quot;: True}"/>\n                   </t>\n                </t>\n\n                <div class="page" style="font-size:12px;">\n                    <p class="text-center mb-3" style="font-size:14px;"><strong>NOTA PENGIRIMAN BARANG</strong></p>\n\n                    <div id="informations" class="pb-3">\n                        <div class="row py-0">\n                            <div class="col-2 py-0">Nomor</div>\n                            <div class="col-8 py-y">: <t t-esc="o.name"/></div>\n                        </div>\n                        <div class="row py-0">\n                            <div class="col-2 py-0">Tanggal Kirim</div>\n                            <div class="col-8 py-y">: <t t-if="o.state == 'done'"><span t-field="o.date_done"/></t><t t-if="o.state != 'done'"><span t-field="o.scheduled_date"/></t></div>\n                        </div>\n                    </div>\n\n                    <table class="table table-sm" t-if="o.state!='done'" name="stock_move_table">\n                        <thead>\n                            <tr>\n                                <th name="th_sm_product"><strong>Product</strong></th>\n                                <th name="th_sm_quantity"><strong>Quantity</strong></th>\n                            </tr>\n                        </thead>\n                        <tbody>\n                            <t t-set="lines" t-value="o.move_lines.filtered(lambda x: x.product_uom_qty)"/>\n                            <tr t-foreach="lines" t-as="move">\n                                <td>\n                                    <span t-field="move.product_id"/>\n                                    <p t-if="move.description_picking != move.product_id.name">\n                                        <span t-field="move.description_picking"/>\n                                    </p>\n                                </td>\n                                <td>\n                                    <span t-field="move.product_uom_qty"/>\n                                    <span t-field="move.product_uom"/>\n                                </td>\n                            </tr>\n                        </tbody>\n                    </table>\n                    <table class="table table-sm mt48" t-if="o.move_line_ids and o.state=='done'" name="stock_move_line_table">\n                        <t t-set="has_serial_number" t-value="False"/>\n                        <t t-set="has_serial_number" t-value="o.move_line_ids.mapped('lot_id')" groups="stock.group_lot_on_delivery_slip"/>\n                        <thead>\n                            <tr>\n                                <th name="th_sml_product"><strong>Product</strong></th>\n                                <t name="lot_serial" t-if="has_serial_number">\n                                    <th>\n                                        Lot/Serial Number\n                                    </th>\n                                </t>\n                                <th name="th_sml_quantity" class="text-center"><strong>Quantity</strong></th>\n                            </tr>\n                        </thead>\n                        <tbody>\n                        <!-- This part gets complicated with different use cases (additional use cases in extensions of this report):\n                                1. If serial numbers are used and set to print on delivery slip => print lines as is, otherwise group them by overlapping\n                                    product + description + uom combinations\n                                2. If any packages are assigned => split products up by package (or non-package) and then apply use case 1 -->\n                            <!-- If has destination packages => create sections of corresponding products -->\n                            <t t-if="o.has_packages" name="has_packages">\n                                <t t-set="packages" t-value="o.move_line_ids.mapped('result_package_id')"/>\n                                <t t-foreach="packages" t-as="package">\n                                    <t t-call="stock.stock_report_delivery_package_section_line"/>\n                                    <t t-set="package_move_lines" t-value="o.move_line_ids.filtered(lambda l: l.result_package_id == package)"/>\n                                    <!-- If printing lots/serial numbers => keep products in original lines -->\n                                    <t t-if="has_serial_number">\n                                        <tr t-foreach="package_move_lines" t-as="move_line">\n                                            <t t-call="stock.stock_report_delivery_has_serial_move_line"/>\n                                        </tr>\n                                    </t>\n                                    <!-- If not printing lots/serial numbers => merge lines with same product+description+uom -->\n                                    <t t-else="">\n                                        <t t-set="aggregated_lines" t-value="package_move_lines._get_aggregated_product_quantities()"/>\n                                        <t t-call="stock.stock_report_delivery_aggregated_move_lines"/>\n                                    </t>\n                                </t>\n                                <!-- Make sure we do another section for package-less products if they exist -->\n                                <t t-set="move_lines" t-value="o.move_line_ids.filtered(lambda l: not l.result_package_id)"/>\n                                <t t-if="move_lines" name="no_package_move_lines">\n                                    <t t-call="stock.stock_report_delivery_no_package_section_line" name="no_package_section"/>\n                                    <t t-if="has_serial_number">\n                                        <tr t-foreach="move_lines" t-as="move_line">\n                                            <t t-call="stock.stock_report_delivery_has_serial_move_line"/>\n                                        </tr>\n                                    </t>\n                                    <t t-else="">\n                                        <t t-set="aggregated_lines" t-value="move_lines._get_aggregated_product_quantities()"/>\n                                        <t t-if="aggregated_lines">\n                                            <t t-call="stock.stock_report_delivery_aggregated_move_lines"/>\n                                        </t>\n                                    </t>\n                                </t>\n                            </t>\n                            <!-- No destination packages -->\n                            <t t-else="">\n                                <!-- If printing lots/serial numbers => keep products in original lines -->\n                                <t t-if="has_serial_number">\n                                    <tr t-foreach="o.move_line_ids" t-as="move_line">\n                                        <t t-call="stock.stock_report_delivery_has_serial_move_line"/>\n                                    </tr>\n                                </t>\n                                <!-- If not printing lots/serial numbers => merge lines with same product -->\n                                <t t-else="" name="aggregated_move_lines">\n                                    <t t-set="aggregated_lines" t-value="o.move_line_ids._get_aggregated_product_quantities()"/>\n                                        <t t-call="stock.stock_report_delivery_aggregated_move_lines"/>\n                                </t>\n                            </t>\n                        </tbody>\n                    </table>\n                    <t t-set="backorders" t-value="o.backorder_ids.filtered(lambda x: x.state not in ('done', 'cancel'))"/>\n                    <t t-if="o.backorder_ids and backorders">\n                        <p>\n                            <span>All items couldn't be shipped, the following items will be shipped as soon as they become available.</span>\n                        </p>\n                        <table class="table table-sm" name="stock_backorder_table">\n                            <thead>\n                                <tr>\n                                    <th name="th_sb_product"><strong>Product</strong></th>\n                                    <th name="th_sb_quantity" class="text-center"><strong>Quantity</strong></th>\n                                </tr>\n                            </thead>\n                            <tbody>\n                                <t t-foreach="backorders" t-as="backorder">\n                                    <t t-set="bo_lines" t-value="backorder.move_lines.filtered(lambda x: x.product_uom_qty)"/>\n                                    <tr t-foreach="bo_lines" t-as="bo_line">\n                                        <td>\n                                            <span t-field="bo_line.product_id"/>\n                                            <p t-if="bo_line.description_picking != bo_line.product_id.name">\n                                                <span t-field="bo_line.description_picking"/>\n                                            </p>\n                                        </td>\n                                        <td class="text-center">\n                                            <span t-field="bo_line.product_uom_qty"/>\n                                            <span t-field="bo_line.product_uom"/>\n                                        </td>\n                                    </tr>\n                                </t>\n                            </tbody>\n                        </table>\n                    </t>\n\n                    <div class="pt-3">\n                        <div class="row py-0">\n                            <div class="col-3 py-0 text-center">Pemberi</div>\n                            <div class="col-1"/>\n                            <div class="col-3 py-0 text-center">Pembawa</div>\n                            <div class="col-1"/>\n                            <div class="col-3 py-0 text-center">Penerima</div>\n                        </div>\n                        <div class="row pt-5 mt-4">                            \n                            <div class="col-3 py-y text-center">(<span style="display: inline-block; margin-left: 120px;"/>)</div>\n                            <div class="col-1"/>\n                            <div class="col-3 py-y text-center">(<span style="display: inline-block; margin-left: 120px;"/>)</div>\n                            <div class="col-1"/>\n                            <div class="col-3 py-y text-center">(<span style="display: inline-block; margin-left: 120px;"/>)</div>\n                        </div>\n                        \n                    </div>\n\n                </div>\n            </t>\n         </t>\n    </t>\n	ehealth_document/report/delivery_slip/report_westerindo_delivery_slip.xml	\N	\N	\N	\N	primary	t	1	2025-08-28 11:34:01.364376	1	2025-08-28 11:34:01.364376	f
784	stock.report_deliveryslip	\N	stock.report_deliveryslip	16	qweb	<?xml version="1.0"?>\n<t t-name="stock.report_deliveryslip">\n        <t t-foreach="docs" t-as="o">\n            <t t-set="template" t-value="o._get_template_name('delivery-slip-template')"/>\n            <t t-if="template">\n                <t t-call="{{template}}" t-lang="o.partner_id.lang or o.env.lang"/>\n            </t>\n            <t t-else="">\n                <t t-call="stock.report_delivery_document" t-lang="o.partner_id.lang or o.env.lang"/>\n            </t>\n        </t>\n    </t>\n	ehealth_document/report/delivery_slip/delivery_slip_templates.xml	f	<?xml version="1.0"?>\n<t t-name="stock.report_deliveryslip">\n        <t t-foreach="docs" t-as="o">\n            <t t-call="stock.report_delivery_document" t-lang="o._get_report_lang()"/>\n        </t>\n    </t>\n	\N	\N	primary	t	1	2025-08-28 11:32:42.235962	1	2025-08-28 11:34:01.364376	f
799	label_barcode_product_template_view	\N	stock.label_barcode_product_template_view	16	qweb	<?xml version="1.0"?>\n<t t-name="stock.label_barcode_product_template_view">\n            <t t-foreach="docs" t-as="product">\n                <t t-translation="off">\n^XA\n^FO100,50\n^A0N,44,33^FD<t t-esc="product.display_name"/>^FS\n<t t-if="product.barcode ">\n^FO100,100^BY3\n^BCN,100,Y,N,N\n^FD<t t-esc="product.barcode"/>^FS\n</t>\n^XZ\n                </t>\n            </t>\n        </t>\n        	stock/report/product_templates.xml	\N	\N	\N	\N	primary	t	1	2025-08-28 11:32:42.235962	1	2025-08-28 11:32:42.235962	f
800	label_barcode_product_product_view	\N	stock.label_barcode_product_product_view	16	qweb	<?xml version="1.0"?>\n<t t-name="stock.label_barcode_product_product_view">\n            <t t-foreach="docs" t-as="product">\n                <t t-translation="off">\n^XA\n^FO100,50\n^A0N,44,33^FD<t t-esc="product.display_name"/>^FS\n<t t-if="product.barcode">\n^FO100,100^BY3\n^BCN,100,Y,N,N\n^FD<t t-esc="product.barcode"/>^FS\n</t>\n^XZ\n                </t>\n            </t>\n        </t>\n        	stock/report/product_templates.xml	\N	\N	\N	\N	primary	t	1	2025-08-28 11:32:42.235962	1	2025-08-28 11:32:42.235962	f
1682	report_senopatiskincenter_delivery_slip	\N	ehealth_document.report_senopatiskincenter_delivery_slip	16	qweb	<?xml version="1.0"?>\n<t t-name="ehealth_document.report_senopatiskincenter_delivery_slip">\n        <t t-call="web.html_container">\n            <t t-call="web.external_layout">\n                <t t-set="o" t-value="o.with_context(lang=o.partner_id.lang or o.env.lang)"/>\n\n                <div class="page">\n                    <div style="width: 100%; border-bottom: 1px solid black">\n                        <p class="text-center m-0" style="font-size: 1.1rem;"><strong>FAKTUR PENERIMAAN BARANG</strong></p>\n                    </div>\n                    <div class="row">\n                        <div class="col-6">\n                            <div class="row">\n                                <div class="col-5">No. Surat Terima</div>\n                                <div class="col-4">: <span t-field="o.name"/></div>\n                            </div>\n                            <div class="row">\n                                <div class="col-5">Tgl. Penerimaan</div>\n                                <div class="col-4">: <span t-esc="o.date_done and o.date_done.strftime('%d/%m/%Y') or ''"/></div>\n                            </div>\n                            <div class="row">\n                                <div class="col-5">No. Pembelian</div>\n                                <div class="col-4">: <span t-esc="o.purchase_id.name"/></div>\n                            </div>\n                            <div class="row">\n                                <div class="col-5">No. Surat Jalan</div>\n                                <div class="col-4">: </div>\n                            </div>\n                        </div>\n                        <div class="col-6">\n                            <div class="row">\n                                <div class="col-4">Pemasok</div>\n                                <div class="col-4">: <span t-field="o.partner_id.name"/></div>\n                            </div>\n                            <div class="row">\n                                <div class="col-4">Alamat</div>\n                                <div class="col-4">: <span t-field="o.partner_id.street"/></div>\n                            </div>\n                            <div class="row">\n                                <div class="col-4">No. Telepon</div>\n                                <div class="col-4">: <span t-field="o.partner_id.phone"/></div>\n                            </div>\n                            <div class="row">\n                                <div class="col-4">No. Fax</div>\n                                <div class="col-4">:</div>\n                            </div>\n                        </div>\n                    </div>\n                    <br/>\n\n                    <table style="width: 100%; border-collapse: collapse; text-align: left; border: 1px solid black; border-left: none; border-right: none;">\n                        <thead>\n                            <tr style="border-top: 2px solid black;">\n                                <th name="th_code" class="text-center" style="width: 15%; border: 1px solid black; border-left: none;">No. Batch</th>\n                                <th name="th_expiration" class="text-center" style="width: 20%; border: 1px solid black;">Kadaluarsa</th>\n                                <th name="th_description" class="text-center" style="width: 35%; border: 1px solid black;">Deskripsi</th>\n                                <th name="th_quantity" class="text-center" style="width: 15%; border: 1px solid black;">Qty</th>\n                                <th name="th_uom" class="text-center" style="width: 15%; border: 1px solid black; border-right: none;">Satuan</th>\n                            </tr>\n                        </thead>\n                        <tbody>\n                            <t t-foreach="o.move_ids_without_package" t-as="line">\n                                <tr>\n                                    <td class="text-center">\n                                        <span t-field="line.move_line_nosuggest_ids[0].lot_id.name"/>\n                                    </td>\n                                    <td class="text-center">\n                                        <span t-esc="line.move_line_nosuggest_ids[0].lot_id.expiration_date and line.move_line_nosuggest_ids[0].lot_id.expiration_date.strftime('%d/%m/%Y') or ''"/>\n                                    </td>\n                                    <td class="text-center">\n                                        <span t-field="line.product_id.name"/>\n                                    </td>\n                                    <td class="text-center">\n                                        <span t-esc="round(line.quantity_done)"/>\n                                    </td>\n                                    <td class="text-center">\n                                        <span t-field="line.product_uom.name"/>\n                                    </td>\n                                </tr>\n                            </t>\n                        </tbody>\n                    </table>\n\n                    <div>\n                        <div class="row py-0">\n                            <div class="col-3 py-0 text-center">Penanggung Jawab,</div>\n                        </div>\n                        <div class="row pt-5 mt-4">\n                            <div class="col-3 py-y text-center">(_________________________)</div>\n                        </div>\n                        \n                    </div>\n                </div>\n\n            </t>\n         </t>\n    </t>\n	ehealth_document/report/delivery_slip/report_senopatiskincenter_delivery_slip.xml	\N	\N	\N	\N	primary	t	1	2025-08-28 11:34:01.364376	1	2025-08-28 11:34:01.364376	f
801	label_lot_template_view	\N	stock.label_lot_template_view	16	qweb	<?xml version="1.0"?>\n<t t-name="stock.label_lot_template_view">\n            <t t-foreach="docs" t-as="lot">\n                <t t-translation="off">\n^XA\n^FO100,50\n^A0N,44,33^FD<t t-esc="lot.product_id.display_name"/>^FS\n^FO100,100\n^A0N,44,33^FDLN/SN: <t t-esc="lot.name"/>^FS\n^FO100,150^BY3\n^BCN,100,Y,N,N\n^FD<t t-esc="lot.name"/>^FS\n^XZ\n                </t>\n            </t>\n        </t>\n    	stock/report/product_templates.xml	\N	\N	\N	\N	primary	t	1	2025-08-28 11:32:42.235962	1	2025-08-28 11:32:42.235962	f
1683	report_default_picking_operations	\N	ehealth_document.report_default_picking_operations	16	qweb	<?xml version="1.0"?>\n<t t-name="ehealth_document.report_default_picking_operations">\n        <t t-call="web.external_layout">\n            <div class="page">\n                <div class="row justify-content-end mb16">\n                    <div class="col-4" name="right_box">\n                        <img t-att-src="'/report/barcode/?type=%s&amp;value=%s&amp;width=%s&amp;height=%s' % ('Code128', o.name, 600, 100)" style="width:300px;height:50px;" alt="Barcode"/>\n                    </div>\n                </div>\n                <div class="row">\n                    <div class="col-6" name="div_outgoing_address">\n                        <div t-if="o.move_ids_without_package and o.move_ids_without_package[0].partner_id and o.move_ids_without_package[0].partner_id.id != o.partner_id.id">\n                            <span><strong>Delivery Address:</strong></span>\n                            <div t-field="o.move_ids_without_package[0].partner_id" t-options="{&quot;widget&quot;: &quot;contact&quot;, &quot;fields&quot;: [&quot;address&quot;, &quot;name&quot;, &quot;phone&quot;], &quot;no_marker&quot;: True, &quot;phone_icons&quot;: True}"/>\n                        </div>\n                        <div t-if="o.picking_type_id.code != 'internal' and (not o.move_ids_without_package or not o.move_ids_without_package[0].partner_id) and o.picking_type_id.warehouse_id.partner_id">\n                            <span><strong>Warehouse Address:</strong></span>\n                            <div t-field="o.picking_type_id.warehouse_id.partner_id" t-options="{&quot;widget&quot;: &quot;contact&quot;, &quot;fields&quot;: [&quot;address&quot;, &quot;name&quot;, &quot;phone&quot;], &quot;no_marker&quot;: True, &quot;phone_icons&quot;: True}"/>\n                        </div>\n                    </div>\n                    <div class="col-5 offset-1" name="div_incoming_address">\n                        <div t-if="o.picking_type_id.code=='incoming' and o.partner_id">\n                            <span><strong>Vendor Address:</strong></span>\n                        </div>\n                        <div t-if="o.picking_type_id.code=='internal' and o.partner_id">\n                            <span><strong>Warehouse Address:</strong></span>\n                        </div>\n                        <div t-if="o.picking_type_id.code=='outgoing' and o.partner_id">\n                            <span><strong>Customer Address:</strong></span>\n                        </div>\n                        <div t-if="o.partner_id" name="partner_header">\n                            <div t-field="o.partner_id" t-options="{&quot;widget&quot;: &quot;contact&quot;, &quot;fields&quot;: [&quot;name&quot;, &quot;phone&quot;], &quot;no_marker&quot;: True, &quot;phone_icons&quot;: True}"/>\n                            <p t-if="o.sudo().partner_id.vat"><t t-esc="o.company_id.country_id.vat_label or 'Tax ID'"/>: <span t-field="o.sudo().partner_id.vat"/></p>\n                        </div>\n                    </div>\n                </div>\n                <br/>\n                <h1 t-field="o.name" class="mt0 float-left"/>\n                <div class="row mt48 mb32">\n                    <div t-if="o.origin" class="col-auto" name="div_origin">\n                        <strong>Order:</strong>\n                        <p t-field="o.origin"/>\n                    </div>\n                    <div class="col-auto" name="div_state">\n                        <strong>Status:</strong>\n                        <p t-field="o.state"/>\n                    </div>\n                    <div class="col-auto" name="div_sched_date">\n                        <strong>Scheduled Date:</strong>\n                        <p t-field="o.scheduled_date"/>\n                    </div>\n                </div>\n                <table class="table table-sm" t-if="o.move_line_ids and o.move_ids_without_package">\n                    <t t-set="has_barcode" t-value="any(move_line.product_id and move_line.product_id.sudo().barcode or move_line.package_id for move_line in o.move_line_ids)"/>\n                    <t t-set="has_serial_number" t-value="any(move_line.lot_id or move_line.lot_name for move_line in o.move_line_ids)" groups="stock.group_production_lot"/>\n                    <thead>\n                        <tr>\n                            <th name="th_product">\n                                <strong>Product</strong>\n                            </th>\n                            <th>\n                                <strong>Quantity</strong>\n                            </th>\n                            <th name="th_from" t-if="o.picking_type_id.code != 'incoming'" align="left" groups="stock.group_stock_multi_locations">\n                                <strong>From</strong>\n                            </th>\n                            <th name="th_to" t-if="o.picking_type_id.code != 'outgoing'" groups="stock.group_stock_multi_locations">\n                                <strong>To</strong>\n                            </th>\n                            <th name="th_serial_number" class="text-center" t-if="has_serial_number">\n                                <strong>Lot/Serial Number</strong>\n                            </th>\n                            <th name="th_barcode" class="text-center" t-if="has_barcode">\n                                <strong>Product Barcode</strong>\n                            </th>\n                        </tr>\n                    </thead>\n                    <tbody>\n                        <t t-foreach="o.move_ids_without_package" t-as="move">\n                            <!-- In case you come across duplicated lines, ask NIM or LAP -->\n                            <t t-foreach="move.move_line_ids.sorted(key=lambda ml: ml.location_id.id)" t-as="ml">\n                                <tr>\n                                    <td>\n                                        <span t-field="ml.product_id.display_name"/><br/>\n                                        <span t-field="ml.product_id.description_picking"/>\n                                    </td>\n                                    <td>\n                                        <span t-if="o.state != 'done'" t-field="ml.product_uom_qty"/>\n                                        <span t-if="o.state == 'done'" t-field="ml.qty_done"/>\n                                        <span t-field="ml.product_uom_id" groups="uom.group_uom"/>\n\n                                    </td>\n                                    <td t-if="o.picking_type_id.code != 'incoming'" groups="stock.group_stock_multi_locations">\n                                        <span t-esc="ml.location_id.display_name"/>\n                                            <t t-if="ml.package_id">\n                                                <span t-field="ml.package_id"/>\n                                            </t>\n                                    </td>\n                                    <td t-if="o.picking_type_id.code != 'outgoing'" groups="stock.group_stock_multi_locations">\n                                        <div>\n                                            <span t-field="ml.location_dest_id"/>\n                                            <t t-if="ml.result_package_id">\n                                                <span t-field="ml.result_package_id"/>\n                                            </t>\n                                        </div>\n                                    </td>\n                                    <td class=" text-center h6" t-if="has_serial_number">\n                                        <img t-if="has_serial_number and (ml.lot_id or ml.lot_name)" t-att-src="'/report/barcode/?type=%s&amp;value=%s&amp;width=%s&amp;height=%s&amp;humanreadable=1' % ('Code128', ml.lot_id.name or ml.lot_name, 400, 100)" style="width:100%;height:35px;" alt="Barcode"/>\n\n                                    </td>\n                                    <td class="text-center" t-if="has_barcode">\n                                        <t t-if="product_barcode != move.product_id.barcode">\n                                            <span t-if="move.product_id and move.product_id.barcode">\n                                                <img t-if="len(move.product_id.barcode) == 13" t-att-src="'/report/barcode/?type=%s&amp;value=%s&amp;width=%s&amp;height=%s&amp;quiet=%s' % ('EAN13', move.product_id.barcode, 400, 100, 0)" style="height:35px" alt="Barcode"/>\n                                                <img t-elif="len(move.product_id.barcode) == 8" t-att-src="'/report/barcode/?type=%s&amp;value=%s&amp;width=%s&amp;height=%s&amp;quiet=%s' % ('EAN8', move.product_id.barcode, 400, 100, 0)" style="height:35px" alt="Barcode"/>\n                                                <img t-else="" t-att-src="'/report/barcode/?type=%s&amp;value=%s&amp;width=%s&amp;height=%s&amp;quiet=%s' % ('Code128', move.product_id.barcode, 400, 100, 0)" style="height:35px" alt="Barcode"/>\n\n                                            </span>\n                                            <t t-set="product_barcode" t-value="move.product_id.barcode"/>\n                                        </t>\n                                    </td>\n                                </tr>\n                            </t>\n                        </t>\n                        </tbody>\n                </table>\n                <table class="table table-sm" t-if="o.package_level_ids and o.picking_type_entire_packs and o.state in ['assigned', 'done']">\n                    <thead>\n                        <tr>\n                            <th name="th_package">Package</th>\n                            <th name="th_pko_from" t-if="o.picking_type_id.code != 'incoming'" groups="stock.group_stock_multi_locations">From</th>\n                            <th name="th_pki_from" t-if="o.picking_type_id.code != 'outgoing'" groups="stock.group_stock_multi_locations">To</th>\n                        </tr>\n                    </thead>\n                    <tbody>\n                        <tr t-foreach="o.package_level_ids.sorted(key=lambda p: p.package_id.name)" t-as="package">\n                            <t t-set="package" t-value="package.with_context(picking_id=o.id)"/>\n                            <td name="td_pk_barcode">\n                                <img t-att-src="'/report/barcode/?type=%s&amp;value=%s&amp;width=%s&amp;height=%s&amp;humanreadable=1' % ('Code128', package.package_id.name, 600, 100)" style="width:300px;height:50px; margin-left: -50px;" alt="Barcode"/><br/>\n                            </td>\n                            <td t-if="o.picking_type_id.code != 'incoming'" groups="stock.group_stock_multi_locations">\n                                <span t-field="package.location_id"/>\n                            </td>\n                            <td t-if="o.picking_type_id.code != 'outgoing'" groups="stock.group_stock_multi_locations">\n                                <span t-field="package.location_dest_id"/>\n                            </td>\n                        </tr>\n                    </tbody>\n                </table>\n                <t t-set="no_reserved_product" t-value="o.move_lines.filtered(lambda x: x.product_uom_qty != x.reserved_availability and x.move_line_ids and x.state!='done')"/>\n                <p t-if="o.state in ['draft', 'waiting', 'confirmed'] or no_reserved_product"><i class="fa fa-exclamation-triangle"/>\n                    All products could not be reserved. Click on the "Check Availability" button to try to reserve products.\n                </p>\n                <p t-field="o.note"/>\n            </div>\n        </t>\n    </t>\n	ehealth_document/report/picking_operations/report_default_picking_operations.xml	\N	\N	\N	\N	primary	t	1	2025-08-28 11:34:01.364376	1	2025-08-28 11:34:01.364376	f
1684	report_westerindo_nota_pengiriman	\N	ehealth_document.report_westerindo_nota_pengiriman	16	qweb	<?xml version="1.0"?>\n<t t-name="ehealth_document.report_westerindo_nota_pengiriman">\n        <t t-call="web.external_layout">\n            <div class="page" style="font-size:12px;">\n                <p class="text-center mb-3" style="font-size:14px;"><strong>NOTA PENGIRIMAN BARANG</strong></p>\n                <div id="informations" class="pb-3">\n                    <div class="row py-0">\n                        <div class="col-2 py-0">Nomor</div>\n                        <div class="col-8 py-y">: <t t-esc="o.name"/></div>\n                    </div>\n                    <div class="row py-0">\n                        <div class="col-2 py-0">Tanggal Kirim</div>\n                        <div class="col-8 py-y">: <t t-if="o.state == 'done'"><span t-field="o.date_done"/></t><t t-if="o.state != 'done'"><span t-field="o.scheduled_date"/></t></div>\n                    </div>\n                </div>\n                \n                <table class="table table-sm table-bordered" t-if="o.move_line_ids and o.move_ids_without_package">\n                    <t t-set="has_barcode" t-value="any(move_line.product_id and move_line.product_id.sudo().barcode or move_line.package_id for move_line in o.move_line_ids)"/>\n                    <t t-set="has_serial_number" t-value="any(move_line.lot_id or move_line.lot_name for move_line in o.move_line_ids)" groups="stock.group_production_lot"/>\n                    <thead>\n                        <tr>\n                            <th class="text-center">\n                                <strong>No</strong>\n                            </th>\n                            <th class="text-center">\n                                <strong>Cat No.</strong>\n                            </th>\n                            <th class="text-center" name="th_product">\n                                <strong>Nama Item</strong>\n                            </th>\n                            <th name="th_serial_number" class="text-center" t-if="has_serial_number">\n                                <strong>Batch No.</strong>\n                            </th>\n                            <th name="th_serial_number" class="text-center" t-if="has_serial_number">\n                                <strong>ED</strong>\n                            </th>\n                            <th class="text-center">\n                                <strong>Qty</strong>\n                            </th>\n                            <th class="text-center">\n                                <strong>Satuan</strong>\n                            </th>\n                        </tr>\n                    </thead>\n                    <tbody>\n                        <t t-set="data_number" t-value="1"/>\n                        <t t-foreach="o.move_ids_without_package" t-as="move">\n                            <!-- In case you come across duplicated lines, ask NIM or LAP -->\n                            <t t-foreach="move.move_line_ids.sorted(key=lambda ml: ml.location_id.id)" t-as="ml">\n                                <tr>\n                                    <td class="text-center">\n                                        <span t-esc="data_number"/>\n                                    </td>\n                                    <td class="text-center">\n                                        <span t-field="ml.product_id.default_code"/>\n                                    </td>\n                                    <td>\n                                        <span t-field="ml.product_id.name"/><br/>\n                                        <span t-field="ml.product_id.description_picking"/>\n                                    </td>\n                                    <td class="text-center h6" t-if="has_serial_number">\n                                        <img t-if="has_serial_number and (ml.lot_id or ml.lot_name)" t-att-src="'/report/barcode/?type=%s&amp;value=%s&amp;width=%s&amp;height=%s&amp;humanreadable=1' % ('Code128', ml.lot_id.name or ml.lot_name, 400, 100)" style="width:100%;height:35px;" alt="Barcode"/>\n                                    </td>\n                                    <td class="text-center" t-if="has_serial_number">\n                                        <span t-field="ml.lot_id.expiration_date"/>\n                                    </td>\n                                    <td class="text-right">\n                                        <span t-if="o.state != 'done'" t-field="ml.product_uom_qty"/>\n                                        <span t-if="o.state == 'done'" t-field="ml.qty_done"/>\n                                    </td>\n                                    <td>\n                                        <span t-field="ml.product_uom_id" groups="uom.group_uom"/>\n                                    </td>\n                                </tr>\n                                <t t-set="data_number" t-value="data_number + 1"/>\n                            </t>\n                        </t>\n                        </tbody>\n                </table>\n                \n                <div class="pt-3">\n                    <div class="row py-0">\n                        <div class="col-3 py-0 text-center">Pemberi</div>\n                        <div class="col-1"/>\n                        <div class="col-3 py-0 text-center">Pembawa</div>\n                        <div class="col-1"/>\n                        <div class="col-3 py-0 text-center">Penerima</div>\n                    </div>\n                    <div class="row pt-5 mt-4">                            \n                        <div class="col-3 py-y text-center">(<span style="display: inline-block; margin-left: 120px;"/>)</div>\n                        <div class="col-1"/>\n                        <div class="col-3 py-y text-center">(<span style="display: inline-block; margin-left: 120px;"/>)</div>\n                        <div class="col-1"/>\n                        <div class="col-3 py-y text-center">(<span style="display: inline-block; margin-left: 120px;"/>)</div>\n                    </div>\n                    \n                </div>\n            </div>\n        </t>\n    </t>\n	ehealth_document/report/picking_operations/report_westerindo_nota_pengiriman.xml	\N	\N	\N	\N	primary	t	1	2025-08-28 11:34:01.364376	1	2025-08-28 11:34:01.364376	f
802	label_product_packaging_view	\N	stock.label_product_packaging_view	16	qweb	<?xml version="1.0"?>\n<t t-name="stock.label_product_packaging_view">\n            <t t-foreach="docs" t-as="packaging">\n                <t t-translation="off">\n^XA\n^FO100,50\n^A0N,44,33^FD<t t-esc="packaging.name"/>^FS\n^FO100,100\n^A0N,44,33^FD<t t-esc="packaging.product_id.display_name"/>^FS\n^FO100,150\n^A0N,44,33^FDQty: <t t-esc="packaging.qty"/> <t t-esc="packaging.product_uom_id.name" groups="uom.group_uom"/>^FS\n<t t-if="packaging.barcode">\n^FO100,200^BY3\n^BCN,100,Y,N,N\n^FD<t t-esc="packaging.barcode"/>^FS\n</t>\n^XZ\n                </t>\n            </t>\n        </t>\n    	stock/report/product_packaging.xml	\N	\N	\N	\N	primary	t	1	2025-08-28 11:32:42.235962	1	2025-08-28 11:32:42.235962	f
803	stock_assign_serial_numbers	stock.assign.serial	\N	16	form	<?xml version="1.0"?>\n<form string="Assign Serial Numbers">\n                <group>\n                    <field name="move_id" invisible="1"/>\n                    <field name="product_id" readonly="1"/>\n                    <field name="next_serial_number"/>\n                    <field name="next_serial_count"/>\n                </group>\n                <footer>\n                    <button name="generate_serial_numbers" type="object" string="Assign Serial Numbers" class="oe_highlight"/>\n                    <button special="cancel" string="Cancel"/>\n                </footer>\n            </form>\n        	stock/wizard/stock_assign_serial_views.xml	\N	\N	\N	\N	primary	t	1	2025-08-28 11:32:42.235962	1	2025-08-28 11:32:42.235962	f
785	stock.report_inventory	\N	stock.report_inventory	16	qweb	<?xml version="1.0"?>\n<t t-name="stock.report_inventory">\n        <t t-foreach="docs" t-as="o">\n            <t t-set="template" t-value="o._get_template_name('inventory-adjustment-template')"/>\n            <t t-if="template">\n                <t t-call="{{template}}"/>\n            </t>\n            <t t-else="">\n                <t t-call="ehealth_document.report_inventory_adjustment_default"/>\n            </t>\n        </t>\n    </t>\n	ehealth_document/report/inventory_adjustment/inventory_adjustment_template.xml	f	<?xml version="1.0"?>\n<t t-name="stock.report_inventory">\n            <t t-call="web.html_container">\n                <t t-foreach="docs" t-as="o">\n                    <t t-call="web.external_layout">\n                        <div class="page">\n                            <br/>\n                            <h2 t-field="o.name"/>\n\n                            <div class="row mt32 mb32" id="informations">\n                                <div t-if="o.date" class="col-auto mw-100 mb-2">\n                                    <strong>Date:</strong>\n                                    <p class="m-0" t-field="o.date"/>\n                                </div>\n                            </div>\n\n                            <t t-set="locations" t-value="o.line_ids.mapped('location_id')"/>\n                            <table class="table table-sm">\n                                <thead>\n                                    <tr>\n                                        <th groups="stock.group_stock_multi_locations"><strong>Location</strong></th>\n                                        <th><strong>Product</strong></th>\n                                        <th groups="stock.group_production_lot"><strong>Lot/Serial Number</strong></th>\n                                        <th groups="stock.group_tracking_lot"><strong>Package</strong></th>\n                                        <th class="text-right"><strong>On Hand Quantity</strong></th>\n                                        <th class="text-right"><strong>Counted Quantity</strong></th>\n                                    </tr>\n                                </thead>\n                                <tbody>\n                                    <t t-foreach="locations" t-as="location">\n                                        <tr groups="stock.group_stock_multi_locations">\n                                            <td colspan="2"><strong t-esc="location.display_name"/></td>\n                                            <td groups="stock.group_production_lot"/>\n                                            <td groups="stock.group_tracking_lot"/>\n                                            <td/>\n                                        </tr>\n                                        <tr t-foreach="o.line_ids.filtered(lambda line: line.location_id.id == location.id)" t-as="line">\n                                            <td groups="stock.group_stock_multi_locations"/>\n                                            <td><span t-field="line.product_id"/></td>\n                                            <td groups="stock.group_production_lot"><span t-field="line.prod_lot_id"/></td>\n                                            <td groups="stock.group_tracking_lot"><span t-field="line.package_id"/></td>\n                                            <td class="text-right"><span t-field="line.theoretical_qty"/> <span t-field="line.product_uom_id" groups="uom.group_uom"/></td>\n                                            <td class="text-right"><span t-field="line.product_qty"/> <span t-field="line.product_uom_id" groups="uom.group_uom"/></td>\n                                        </tr>\n                                    </t>\n                                </tbody>\n                            </table>\n                        </div>\n                    </t>\n                 </t>\n             </t>\n        </t>\n    	\N	\N	primary	t	1	2025-08-28 11:32:42.235962	1	2025-08-28 11:34:01.364376	f
804	Change Product Quantity	stock.change.product.qty	\N	16	form	<?xml version="1.0"?>\n<form string="Update Product Quantity">\n                    <group>\n                        <field name="product_tmpl_id" invisible="1"/>\n                        <field name="product_variant_count" invisible="1"/>\n                        <field name="product_id" widget="selection" domain="[('product_tmpl_id', '=', product_tmpl_id)]" attrs="{'invisible': [('product_variant_count', '=', 1)]}" invisible="context.get('default_product_id')" readonly="context.get('default_product_id')"/>\n                        <field name="new_quantity"/>\n                    </group>\n                    <footer>\n                        <button name="change_product_qty" string="Apply" type="object" class="btn-primary"/>\n                        <button string="Cancel" class="btn-secondary" special="cancel"/>\n                    </footer>\n                </form>\n            	stock/wizard/stock_change_product_qty_views.xml	\N	\N	\N	\N	primary	t	1	2025-08-28 11:32:42.235962	1	2025-08-28 11:32:42.235962	f
1685	report_inventory_adjustment_default	\N	ehealth_document.report_inventory_adjustment_default	16	qweb	<?xml version="1.0"?>\n<t t-name="ehealth_document.report_inventory_adjustment_default">\n            <t t-call="web.html_container">\n                <t t-foreach="docs" t-as="o">\n                    <t t-call="web.external_layout">\n                        <div class="page">\n                            <br/>\n                            <h2 t-field="o.name"/>\n\n                            <div class="row mt32 mb32" id="informations">\n                                <div t-if="o.date" class="col-auto mw-100 mb-2">\n                                    <strong>Date :</strong>\n                                    <p class="m-0" t-field="o.date"/>\n                                </div>\n                            </div>\n\n                            <t t-set="locations" t-value="o.line_ids.mapped('location_id')"/>\n                            <table class="table table-sm">\n                                <thead>\n                                    <tr>\n                                        <th groups="stock.group_stock_multi_locations"><strong>Location</strong></th>\n                                        <th><strong>Product</strong></th>\n                                        <th groups="stock.group_production_lot"><strong>Lot/Serial Number</strong></th>\n                                        <th groups="stock.group_tracking_lot"><strong>Package</strong></th>\n                                        <th class="text-right"><strong>On Hand Quantity</strong></th>\n                                        <th class="text-right"><strong>Counted Quantity</strong></th>\n                                    </tr>\n                                </thead>\n                                <tbody>\n                                    <t t-foreach="locations" t-as="location">\n                                        <tr groups="stock.group_stock_multi_locations">\n                                            <td colspan="2"><strong t-esc="location.display_name"/></td>\n                                            <td groups="stock.group_production_lot"/>\n                                            <td groups="stock.group_tracking_lot"/>\n                                            <td/>\n                                        </tr>\n                                        <tr t-foreach="o.line_ids.filtered(lambda line: line.location_id.id == location.id)" t-as="line">\n                                            <td groups="stock.group_stock_multi_locations"/>\n                                            <td><span t-field="line.product_id"/></td>\n                                            <td groups="stock.group_production_lot"><span t-field="line.prod_lot_id"/></td>\n                                            <td groups="stock.group_tracking_lot"><span t-field="line.package_id"/></td>\n                                            <td class="text-right"><span t-field="line.theoretical_qty"/> <span t-field="line.product_uom_id" groups="uom.group_uom"/></td>\n                                            <td class="text-right"><span t-field="line.product_qty"/> <span t-field="line.product_uom_id" groups="uom.group_uom"/></td>\n                                        </tr>\n                                    </t>\n                                </tbody>\n                            </table>\n                        </div>\n                    </t>\n                 </t>\n             </t>\n        </t>\n    	ehealth_document/report/inventory_adjustment/report_inventory_adjustment_default.xml	\N	\N	\N	\N	primary	t	1	2025-08-28 11:34:01.364376	1	2025-08-28 11:34:01.364376	f
805	Return lines	stock.return.picking	\N	16	form	<?xml version="1.0"?>\n<form>\n                <field name="move_dest_exists" invisible="1"/>\n                <field name="picking_id" invisible="1" force_save="1"/>\n                <group attrs="{'invisible': [('move_dest_exists', '=', False)]}">\n                    <div class="oe_grey">\n                        <p>This picking appears to be chained with another operation. Later, if you receive the goods you are returning now, make sure to <b>reverse</b> the returned picking in order to avoid logistic rules to be applied again (which would create duplicated operations)</p>\n                    </div>\n                </group>\n                <group>\n                    <field name="product_return_moves" nolabel="1">\n                        <tree editable="top" create="0">\n                            <field name="product_id" options="{'no_create': True, 'no_open': True}" force_save="1"/>\n                            <field name="quantity"/>\n                            <field name="uom_id" readonly="1" groups="uom.group_uom"/>\n                            <field name="move_id" invisible="1"/>\n                        </tree>\n                    </field>\n                </group>\n                <group>\n                    <field name="parent_location_id" invisible="1"/>\n                    <field name="original_location_id" invisible="1"/>\n                    <field name="location_id" options="{'no_create': True, 'no_open': True}" groups="stock.group_stock_multi_locations" required="1"/>\n                    <field name="company_id" invisible="1"/>\n                </group>\n                <footer>\n                    <button name="create_returns" string="Return" type="object" class="btn-primary"/>\n                    <button string="Cancel" class="btn-secondary" special="cancel"/>\n                </footer>\n            </form>\n        	stock/wizard/stock_picking_return_views.xml	\N	\N	\N	\N	primary	t	1	2025-08-28 11:32:42.235962	1	2025-08-28 11:32:42.235962	f

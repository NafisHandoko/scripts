/div>\n                    </div>\n                    <div class="row">\n                        <div class="col-3">Jenis Kelamin</div>\n                        <div class="col-6">: \n                          <t t-if="o['partner_id']['gender'] == 'male'">Laki-Laki</t>\n                          <t t-else="">Perempuan</t>\n                        </div>\n                    </div>\n                    <div class="row">\n                        <div class="col-3">Pekerjaan</div>\n                        <div class="col-6">: <t t-esc="o['partner_id']['function']"/></div>\n                    </div>\n                    <div class="row">\n                        <div class="col-3">Alamat</div>\n                        <div class="col-6">: <t t-esc="o['partner_id']['street']"/></div>\n                    </div>\n                    <div class="row">\n                        <div class="col-3">No. CM</div>\n                        <div class="col-6">: <t t-esc="data['no-cm']"/></div>\n                    </div>\n                </div>\n                <p class="mt-3 mb-2">Bahwa pasien sedang dalam perawatan di kamar rawat inap kami, sehingga tidak dapat melaksanakan kewajibannya mulai tanggal <strong><t t-esc="data['tanggal-awal']"/></strong> s/d sembuh <strong><t t-esc="data['tanggal-akhir']"/></strong>.</p>\n                <p>Harap yang berkepentingan maklum.</p><br/>\n              </div>\n            </div>\n\n            <div class="row pt-5">\n                <div class="col-1"/>\n                <div class="col-3 mt-4">\n                    <p class="mb-0">Validasi</p>\n                    <div class="mt-3" id="qrcode">\n                        <img t-att-src="o['qr_code_url']" style="width:125px;height:125px;"/>\n                    </div>\n                </div>\n                <div class="col-4"/>\n                <div class="col-4">\n                    <p class="mb-0"><t t-esc="o['operating_unit_id']['company_id']['city']"/>, <t t-esc="o.to_date_string(data['registration_date'])"/></p>\n                    <p class="mb-0">Dokter Pemeriksa</p>\n                    <div class="mt-3" id="qrcode">\n                        <t t-if="'qr_code_examiner_url' in data">\n                          <img t-att-src="data['qr_code_examiner_url']" style="width:125px;height:125px;"/>\n                        </t>\n                        <t t-else="">\n                          <div style="width:125px;height:125px;"/>\n                        </t>\n                    </div>\n                    <p class="mb-0 mt-2"><strong>\n                    <t t-if="'examiner_name' in data">\n                      <t t-esc="data['examiner_name']"/>\n                    </t>\n                    <t t-else="">\n                      <t t-esc="data['sender']"/>\n                    </t>\n                    </strong></p>\n                </div>\n            </div>\n          </div>\n        </t>\n      </t>\n    	ehealth_document/report/template_surat_rawat_inap/report_esensia_surat_rawat_inap.xml	\N	\N	\N	\N	primary	t	1	2025-08-28 11:34:01.364376	1	2025-08-28 11:34:01.364376	f
664	account.bank.statement.line.tree	account.bank.statement.line	\N	8	tree	<?xml version="1.0"?>\n<tree string="Statement lines" create="false" default_order="date desc, statement_id desc, sequence desc, id desc">\n                    <!-- Invisible fields -->\n                    <field name="state" invisible="1"/>\n                    <field name="sequence" readonly="1" invisible="1"/>\n                    <field name="company_id" invisible="1"/>\n                    <field name="journal_id" invisible="1"/>\n                    <field name="is_reconciled" invisible="1"/>\n                    <field name="partner_bank_id" invisible="1"/>\n                    <field name="currency_id" invisible="1"/>\n\n                    <!-- Displayed fields -->\n                    <field name="statement_id" optional="hide"/>\n                    <field name="move_id"/>\n                    <field name="date"/>\n                    <field name="payment_ref"/>\n                    <field name="ref" groups="base.group_no_one"/>\n                    <field name="partner_id"/>\n                    <field name="amount"/>\n                    <field name="amount_currency" optional="hidden" groups="base.group_multi_currency"/>\n                    <field name="foreign_currency_id" optional="hidden" groups="base.group_multi_currency"/>\n                    <field name="account_number" optional="hidden"/>\n                    <field name="transaction_type" optional="hidden"/>\n                    <field name="narration" optional="hidden"/>\n\n                    <!-- Buttons -->\n                    <button name="button_undo_reconciliation" type="object" attrs="{'invisible': [('is_reconciled', '=', False)]}" string="Revert reconciliation" icon="fa-undo"/>\n                </tree>\n            	account/views/account_bank_statement_views.xml	\N	\N	\N	\N	primary	t	1	2025-08-28 11:32:28.994214	1	2025-08-28 11:32:28.994214	f

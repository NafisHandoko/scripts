722	account.cash.rounding.form	account.cash.rounding	\N	16	form	<?xml version="1.0"?>\n<form string="Rounding Form">\n                    <sheet>\n                        <div class="oe_title">\n                            <label for="name" class="oe_edit_only"/>\n                            <h1><field name="name" class="oe_inline"/></h1>\n                        </div>\n                        <group>\n                            <field name="rounding"/>\n                            <field name="strategy"/>\n                            <field name="profit_account_id" options="{'no_create': True}" attrs="{'invisible': [('strategy', '!=', 'add_invoice_line')], 'required': [('strategy', '=', 'add_invoice_line')]}" groups="account.group_account_invoice,account.group_account_readonly" domain="[('user_type_id.type', 'not in', ('receivable', 'payable'))]"/>\n                            <field name="loss_account_id" options="{'no_create': True}" attrs="{'invisible': [('strategy', '!=', 'add_invoice_line')], 'required': [('strategy', '=', 'add_invoice_line')]}" groups="account.group_account_invoice,account.group_account_readonly" domain="[('user_type_id.type', 'not in', ('receivable', 'payable'))]"/>\n                            <field name="rounding_method"/>\n                        </group>\n                    </sheet>\n                </form>\n            	account/views/account_cash_rounding_view.xml	\N	\N	\N	\N	primary	t	1	2025-08-28 11:32:28.994214	1	2025-08-28 11:32:28.994214	f
720	account.invoice.report.search	account.invoice.report	\N	16	search	<?xml version="1.0"?>\n<search string="Invoices Analysis">\n                <filter string="My Invoices" name="my_invoice" domain="[('invoice_user_id', '=', uid)]"/>\n                <separator/>\n                <field name="invoice_date"/>\n                <separator/>\n                <filter string="To Invoice" name="toinvoice" domain="[('state','=','draft')]" help="Draft Invoices"/>\n                <filter string="Invoiced" name="current" domain="[('state','not in', ('draft','cancel'))]"/>\n                <separator/>\n                <filter string="Customers" name="customer" domain="['|', ('move_type','=','out_invoice'),('move_type','=','out_refund')]"/>\n                <filter string="Vendors" name="supplier" domain="['|', ('move_type','=','in_invoice'),('move_type','=','in_refund')]"/>\n                <separator/>\n                <filter string="Invoices" name="invoice" domain="['|', ('move_type','=','out_invoice'),('move_type','=','in_invoice')]"/>\n                <filter string="Credit Notes" name="creditnote" domain="['|', ('move_type','=','out_refund'),('move_type','=','in_refund')]"/>\n                <separator/>\n                <filter name="filter_invoice_date" date="invoice_date"/>\n                <filter name="invoice_date_due" date="invoice_date_due"/>\n                <field name="partner_id" operator="child_of"/>\n                <field name="invoice_user_id"/>\n                <field name="product_id"/>\n                <field name="product_categ_id" filter_domain="[('product_categ_id', 'child_of', self)]"/>\n                <group expand="1" string="Group By">\n                    <filter string="Salesperson" name="user" context="{'group_by':'invoice_user_id'}"/>\n                    <filter string="Partner" name="partner_id" context="{'group_by':'partner_id','residual_visible':True}"/>\n                    <filter string="Product Category" name="category_product" context="{'group_by':'product_categ_id','residual_invisible':True}"/>\n                    <filter string="Status" name="status" context="{'group_by':'state'}"/>\n                    <filter string="Company" name="company" context="{'group_by':'company_id'}" groups="base.group_multi_company"/>\n                    <separator orientation="vertical"/>\n                    <filter string="Date" name="invoice_date" context="{'group_by':'invoice_date'}"/>\n                    <filter string="Due Date" name="duemonth" context="{'group_by':'invoice_date_due:month'}"/>\n                </group>\n            </search>\n        	account/report/account_invoice_report_view.xml	\N	\N	\N	\N	primary	t	1	2025-08-28 11:32:28.994214	1	2025-08-28 11:32:28.994214	f

831	product.product.procurement	product.product	\N	16	form	<?xml version="1.0"?>\n<data>\n                    <header position="inside">\n                        <button string="Update Quantity" type="object" groups="stock.group_stock_manager" name="action_update_quantity_on_hand" attrs="{'invisible': [('type', '!=', 'product')]}"/>\n                        <button string="Replenish" type="action" name="295" context="{'default_product_id': id}" groups="stock.group_stock_user" attrs="{'invisible': [('type', '!=', 'product')]}"/>\n                    </header>\n                    <div name="button_box" position="inside">\n                        <button class="oe_stat_button" name="action_open_quants" icon="fa-cubes" type="object" attrs="{'invisible':[('type', '!=', 'product')]}">\n                               <div class="o_field_widget o_stat_info">\n                                    <span class="o_stat_value">\n                                        <field name="qty_available" widget="statinfo" nolabel="1" class="mr4"/>\n                                        <field name="uom_name"/>\n                                    </span>\n                                    <span class="o_stat_text">On Hand</span>\n                               </div>\n                        </button>\n                        <button type="object" name="action_product_forecast_report" attrs="{'invisible':[('type', '!=', 'product')]}" context="{'default_product_id': id}" class="oe_stat_button" icon="fa-cubes">\n                            <div class="o_field_widget o_stat_info">\n                                <span class="o_stat_value">\n                                    <field name="virtual_available" widget="statinfo" nolabel="1" class="mr4"/>\n                                    <field name="uom_name"/>\n                                </span>\n                                <span class="o_stat_text">Forecasted</span>\n                            </div>\n                        </button>\n                       <button string="Product Moves" type="object" name="action_view_stock_move_lines" attrs="{'invisible':[('type', 'not in', ['product', 'consu'])]}" class="oe_stat_button" icon="fa-exchange" groups="stock.group_stock_user"/>\n                        <button name="action_view_orderpoints" type="object" attrs="{'invisible':['|',('type', 'not in', ['product', 'consu']),('nbr_reordering_rules', '!=', 1)]}" class="oe_stat_button" icon="fa-refresh">\n                            <div class="o_field_widget o_stat_info mr4">\n                                <span class="o_stat_text">Min :</span>\n                                <span class="o_stat_text">Max:</span>\n                            </div>\n                            <div class="o_field_widget o_stat_info">\n                                <span class="o_stat_value"><field name="reordering_min_qty"/></span>\n                                <span class="o_stat_value"><field name="reordering_max_qty"/></span>\n                            </div>\n                        </button>\n                        <button type="object" name="action_view_orderpoints" attrs="{'invisible':['|',('type', '!=', 'product'),('nbr_reordering_rules', '==', 1)]}" class="oe_stat_button" icon="fa-refresh">\n                            <field name="nbr_reordering_rules" widget="statinfo"/>\n                        </button>\n                        <button string="Lot/Serial Numbers" type="object" name="action_open_product_lot" attrs="{'invisible': [('tracking', '=', 'none')]}" class="oe_stat_button" icon="fa-bars" groups="stock.group_production_lot"/>\n                        <button string="Putaway Rules" type="object" name="action_view_related_putaway_rules" class="oe_stat_button" icon="fa-random" groups="stock.group_stock_multi_locations" attrs="{'invisible': [('type', '=', 'service')]}" context="{'invisible_handle': True, 'single_product': True}"/>\n                    </div>\n                    <xpath expr="//button[@name='300']" position="attributes">\n                        <attribute name="context">\n                            {'default_product_id': id}\n                        </attribute>\n                    </xpath>\n                </data>\n            	stock/views/product_views.xml	\N	\N	461	\N	extension	t	1	2025-08-28 11:32:42.235962	1	2025-08-28 11:32:42.235962	f
1701	account_invoice_facturx_export_22	\N	account_edi_ubl_cii.account_invoice_facturx_export_22	16	qweb	<?xml version="1.0"?>\n<t t-name="account_edi_ubl_cii.account_invoice_facturx_export_22">\n            <t t-set="currency" t-value="record.currency_id or record.company_currency_id"/>\n            <rsm:CrossIndustryInvoice xmlns:ram="urn:un:unece:uncefact:data:standard:ReusableAggregateBusinessInformationEntity:100" xmlns:rsm="urn:un:unece:uncefact:data:standard:CrossIndustryInvoice:100" xmlns:udt="urn:un:unece:uncefact:data:standard:UnqualifiedDataType:100">\n                <!-- Factur-x level:\n                    * minimum or basicwl:   urn:factur-x.eu:1p0...\n                    * basic:                urn:cen.eu:en16931:2017:compliant:factur-x.eu:1p0:basic\n                    * en16931:              urn:cen.eu:en16931:2017\n                -->\n                <rsm:ExchangedDocumentContext>\n                    <ram:GuidelineSpecifiedDocumentContextParameter>\n                        <ram:ID t-esc="document_context_id"/>\n                    </ram:GuidelineSpecifiedDocumentContextParameter>\n                </rsm:ExchangedDocumentContext>\n\n                <!-- Document Headers. -->\n                <rsm:ExchangedDocument>\n                    <ram:ID t-esc="ExchangedDocument_vals.get('id')"/>\n                    <ram:TypeCode t-esc="ExchangedDocument_vals.get('type_code')"/>\n                    <ram:IssueDateTime t-if="ExchangedDocument_vals.get('issue_date_time')">\n                        <udt:DateTimeString format="102" t-esc="format_date(ExchangedDocument_vals.get('issue_date_time'))"/>\n                    </ram:IssueDateTime>\n                    <ram:IncludedNote>\n                        <ram:Content t-esc="ExchangedDocument_vals.get('included_note')"/>\n                    </ram:IncludedNote>\n                </rsm:ExchangedDocument>\n\n                <rsm:SupplyChainTradeTransaction>\n                    <!-- Invoice lines. -->\n                    <t t-foreach="invoice_line_vals_list" t-as="line_vals">\n                        <t t-call="account_edi_ubl_cii.account_invoice_line_facturx_export_22"/>\n                    </t>\n\n                    <!-- Partners. -->\n                    <ram:ApplicableHeaderTradeAgreement>\n                        <!-- "Service Exécutant" (Used by Chorus Pro) -->\n                        <ram:BuyerReference t-esc="buyer_reference"/>\n                        <!-- Seller. -->\n                        <ram:SellerTradeParty>\n                            <!-- Address. -->\n                            <t t-call="account_edi_ubl_cii.account_invoice_partner_facturx_export_22">\n                                <t t-set="partner" t-value="record.company_id.partner_id"/>\n                                <t t-set="specified_legal_organization_val" t-value="seller_specified_legal_organization"/>\n                            </t>\n\n                            <!-- VAT. -->\n                            <ram:SpecifiedTaxRegistration t-if="record.company_id.vat">\n                                <ram:ID schemeID="VA" t-esc="record.company_id.vat"/>\n                            </ram:SpecifiedTaxRegistration>\n                        </ram:SellerTradeParty>\n\n                        <!-- Customer. -->\n                        <ram:BuyerTradeParty>\n                            <!-- Address. -->\n                            <t t-call="account_edi_ubl_cii.account_invoice_partner_facturx_export_22">\n                                <t t-set="partner" t-value="record.commercial_partner_id"/>\n                                <t t-set="specified_legal_organization_val" t-value="buyer_specified_legal_organization"/>\n                            </t>\n\n                            <!-- VAT. -->\n                            <ram:SpecifiedTaxRegistration t-if="record.commercial_partner_id.vat">\n                                <ram:ID schemeID="VA" t-esc="record.commercial_partner_id.vat"/>\n                            </ram:SpecifiedTaxRegistration>\n                        </ram:BuyerTradeParty>\n\n                        <!-- Reference. -->\n                        <ram:BuyerOrderReferencedDocument>\n                            <!-- "Engagement Juridique" (used by Chorus Pro) -->\n                            <ram:IssuerAssignedID t-esc="purchase_order_reference"/>\n                        </ram:BuyerOrderReferencedDocument>\n                        <ram:ContractReferencedDocument>\n                            <!-- "Numéro de Marché" (Used by Chorus Pro) -->\n                            <ram:IssuerAssignedID t-esc="contract_reference"/>\n                        </ram:ContractReferencedDocument>\n                    </ram:ApplicableHeaderTradeAgreement>\n\n                    <!-- Delivery -->\n                    <ram:ApplicableHeaderTradeDelivery>\n                        <ram:ShipToTradeParty>\n                            <t t-call="account_edi_ubl_cii.account_invoice_partner_facturx_export_22">\n                                <t t-set="partner" t-value="ship_to_trade_party"/>\n                                <t t-set="hide_dtc" t-value="document_context_id == 'urn:cen.eu:en16931:2017#compliant#urn:xoev-de:kosit:standard:xrechnung_2.2'"/>\n                            </t>\n                        </ram:ShipToTradeParty>\n\n                        <ram:ActualDeliverySupplyChainEvent t-if="scheduled_delivery_time">\n                            <ram:OccurrenceDateTime>\n                                <udt:DateTimeString t-att-format="102" t-esc="format_date(scheduled_delivery_time)"/>\n                            </ram:OccurrenceDateTime>\n                        </ram:ActualDeliverySupplyChainEvent>\n                    </ram:ApplicableHeaderTradeDelivery>\n\n                    <!-- Taxes. -->\n                    <ram:ApplicableHeaderTradeSettlement>\n\n                        <ram:PaymentReference t-esc="record.payment_reference"/>\n                        <ram:InvoiceCurrencyCode t-esc="currency.name"/>\n\n                        <!-- Bank account. -->\n                        <ram:SpecifiedTradeSettlementPaymentMeans t-if="record.partner_bank_id.sanitized_acc_number">\n                            <ram:TypeCode>42</ram:TypeCode>\n                            <ram:PayeePartyCreditorFinancialAccount>\n                                <ram:IBANID t-if="record.partner_bank_id.sanitized_acc_number == 'iban'" t-esc="record.partner_bank_id.sanitized_acc_number"/>\n                                <ram:ProprietaryID t-if="record.partner_bank_id.sanitized_acc_number != 'iban'" t-esc="record.partner_bank_id.sanitized_acc_number"/>\n                            </ram:PayeePartyCreditorFinancialAccount>\n                        </ram:SpecifiedTradeSettlementPaymentMeans>\n\n                        <!-- Tax Summary. -->\n                        <t t-foreach="tax_details.get('tax_details', {}).values()" t-as="tax_detail_vals">\n                            <ram:ApplicableTradeTax>\n                                <ram:CalculatedAmount t-esc="format_monetary(tax_detail_vals.get('calculated_amount'), 2)"/>\n                                <ram:TypeCode>VAT</ram:TypeCode>\n                                <ram:ExemptionReason t-esc="tax_detail_vals.get('tax_exemption_reason')"/>\n                                <ram:BasisAmount t-esc="format_monetary(balance_multiplicator * tax_detail_vals['base_amount_currency'], 2)"/>\n                                <ram:CategoryCode t-esc="tax_detail_vals['tax_category_code']"/>\n                                <ram:ExemptionReasonCode t-esc="tax_detail_vals['tax_exemption_reason_code']"/>\n                                <!-- 5 = Tax is exigible on the date on the invoice -->\n                                <ram:DueDateTypeCode>5</ram:DueDateTypeCode>\n                                <ram:RateApplicablePercent t-if="tax_detail_vals['amount_type'] == 'percent'" t-esc="tax_detail_vals['amount']"/>\n                            </ram:ApplicableTradeTax>\n                        </t>\n\n                        <!-- Billing Period -->\n                        <ram:BillingSpecifiedPeriod t-if="billing_start and billing_end">\n                            <ram:StartDateTime>\n                                <udt:DateTimeString format="102" t-esc="format_date(billing_start)"/>\n                            </ram:StartDateTime>\n                            <ram:EndDateTime>\n                                <udt:DateTimeString format="102" t-esc="format_date(billing_end)"/>\n                            </ram:EndDateTime>\n                        </ram:BillingSpecifiedPeriod>\n\n                        <!-- Payment Term. -->\n                        <ram:SpecifiedTradePaymentTerms>\n                            <ram:Description t-if="record.invoice_payment_term_id" t-esc="record.invoice_payment_term_id.name"/>\n                            <ram:DueDateDateTime t-if="record.invoice_date_due">\n                                <udt:DateTimeString format="102" t-esc="format_date(record.invoice_date_due)"/>\n                            </ram:DueDateDateTime>\n                        </ram:SpecifiedTradePaymentTerms>\n\n                        <!-- Summary. -->\n                        <ram:SpecifiedTradeSettlementHeaderMonetarySummation>\n                            <ram:LineTotalAmount t-esc="format_monetary(tax_basis_total_amount, 2)"/>\n                            <ram:TaxBasisTotalAmount t-esc="format_monetary(tax_basis_total_amount, 2)"/>\n                            <ram:TaxTotalAmount t-att-currencyID="currency.name" t-esc="format_monetary(tax_total_amount, 2)"/>\n                            <ram:GrandTotalAmount t-esc="format_monetary(record.amount_total, 2)"/>\n                            <ram:TotalPrepaidAmount t-esc="format_monetary(record.amount_total - record.amount_residual, 2)"/>\n                            <ram:DuePayableAmount t-esc="format_monetary(record.amount_residual, 2)"/>\n                        </ram:SpecifiedTradeSettlementHeaderMonetarySummation>\n                    </ram:ApplicableHeaderTradeSettlement>\n                </rsm:SupplyChainTradeTransaction>\n            </rsm:CrossIndustryInvoice>\n        </t>\n\n        	account_edi_ubl_cii/data/cii_22_templates.xml	\N	\N	\N	\N	primary	t	1	2025-08-28 11:34:13.779942	1	2025-08-28 11:34:13.779942	f
1702	account_invoice_pdfa_3_facturx_metadata	\N	account_edi_ubl_cii.account_invoice_pdfa_3_facturx_metadata	16	qweb	<?xml version="1.0"?>\n<t t-name="account_edi_ubl_cii.account_invoice_pdfa_3_facturx_metadata">\n            <x:xmpmeta xmlns:x="adobe:ns:meta/">\n                <rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#">\n                    <rdf:Description xmlns:pdfaid="http://www.aiim.org/pdfa/ns/id/" rdf:about="">\n                        <pdfaid:part>3</pdfaid:part>\n                        <pdfaid:conformance>B</pdfaid:conformance>\n                    </rdf:Description>\n                    <rdf:Description xmlns:dc="http://purl.org/dc/elements/1.1/" rdf:about="">\n                        <dc:title>\n                            <rdf:Alt>\n                                <rdf:li t-att="{'xml:lang': 'x-default'}" t-esc="title"/>\n                            </rdf:Alt>\n                        </dc:title>\n                        <dc:creator>\n                            <rdf:Seq>\n                                <rdf:li>Odoo</rdf:li>\n                            </rdf:Seq>\n                        </dc:creator>\n                        <dc:description>\n                            <rdf:Alt>\n                                <rdf:li t-att="{'xml:lang': 'x-default'}">Invoice generated by Odoo</rdf:li>\n                            </rdf:Alt>\n                        </dc:description>\n                    </rdf:Description>\n                    <rdf:Description xmlns:pdf="http://ns.adobe.com/pdf/1.3/" rdf:about="">\n                        <pdf:Producer>Odoo</pdf:Producer>\n                    </rdf:Description>\n                    <rdf:Description xmlns:xmp="http://ns.adobe.com/xap/1.0/" rdf:about="">\n                        <xmp:CreatorTool>Odoo</xmp:CreatorTool>\n                        <xmp:CreateDate t-esc="date"/>\n                        <xmp:ModifyDate t-esc="date"/>\n                    </rdf:Description>\n                    <rdf:Description xmlns:pdfaExtension="http://www.aiim.org/pdfa/ns/extension/" xmlns:pdfaSchema="http://www.aiim.org/pdfa/ns/schema#" xmlns:pdfaProperty="http://www.aiim.org/pdfa/ns/property#" rdf:about="">\n                        <pdfaExtension:schemas>\n                            <rdf:Bag>\n                                <rdf:li rdf:parseType="Resource">\n                                    <pdfaSchema:schema>Factur-X PDFA Extension Schema</pdfaSchema:schema>\n                                    <pdfaSchema:namespaceURI>urn:factur-x:pdfa:CrossIndustryDocument:invoice:1p0#</pdfaSchema:namespaceURI>\n                                    <pdfaSchema:prefix>fx</pdfaSchema:prefix>\n                                    <pdfaSchema:property>\n                                        <rdf:Seq>\n                                            <rdf:li rdf:parseType="Resource">\n                                                <pdfaProperty:name>DocumentFileName</pdfaProperty:name>\n                                                <pdfaProperty:valueType>Text</pdfaProperty:valueType>\n                                                <pdfaProperty:category>external</pdfaProperty:category>\n                                                <pdfaProperty:description>name of the embedded XML invoice file</pdfaProperty:description>\n                                            </rdf:li>\n                                            <rdf:li rdf:parseType="Resource">\n                                                <pdfaProperty:name>DocumentType</pdfaProperty:name>\n                                                <pdfaProperty:valueType>Text</pdfaProperty:valueType>\n                                                <pdfaProperty:category>external</pdfaProperty:category>\n                                                <pdfaProperty:description>INVOICE</pdfaProperty:description>\n                                            </rdf:li>\n                                            <rdf:li rdf:parseType="Resource">\n                                                <pdfaProperty:name>Version</pdfaProperty:name>\n                                                <pdfaProperty:valueType>Text</pdfaProperty:valueType>\n                                                <pdfaProperty:category>external</pdfaProperty:category>\n                                                <pdfaProperty:description>The actual version of the Factur-X XML schema</pdfaProperty:description>\n                                            </rdf:li>\n                                            <rdf:li rdf:parseType="Resource">\n                                                <pdfaProperty:name>ConformanceLevel</pdfaProperty:name>\n                                                <pdfaProperty:valueType>Text</pdfaProperty:valueType>\n                                                <pdfaProperty:category>external</pdfaProperty:category>\n                                                <pdfaProperty:description>The conformance level of the embedded Factur-X data</pdfaProperty:description>\n                                            </rdf:li>\n                                        </rdf:Seq>\n                                    </pdfaSchema:property>\n                                </rdf:li>\n                            </rdf:Bag>\n                        </pdfaExtension:schemas>\n                    </rdf:Description>\n                    <rdf:Description xmlns:fx="urn:factur-x:pdfa:CrossIndustryDocument:invoice:1p0#" rdf:about="">\n                        <fx:ConformanceLevel>EN 16931</fx:ConformanceLevel>\n                        <fx:DocumentFileName>factur-x.xml</fx:DocumentFileName>\n                        <fx:DocumentType>INVOICE</fx:DocumentType>\n                        <fx:Version>1.0</fx:Version>\n                    </rdf:Description>\n                </rdf:RDF>\n            </x:xmpmeta>\n        </t>\n\n    	account_edi_ubl_cii/data/cii_22_templates.xml	\N	\N	\N	\N	primary	t	1	2025-08-28 11:3
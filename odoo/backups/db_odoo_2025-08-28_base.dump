983	asset.asset.report.search	asset.asset.report	\N	16	search	<?xml version="1.0"?>\n<search string="Assets Analysis">\n                <field name="date"/>\n                <field name="depreciation_date"/>\n                <filter string="Draft" name="draft" domain="[('state','=','draft')]" help="Assets in draft state"/>\n                <filter string="Running" name="running" domain="[('state','=','open')]" help="Assets in running state"/>\n                <separator/>\n                <filter string="Posted" name="posted" domain="[('move_check','=',True)]" help="Posted depreciation lines" context="{'unposted_value_visible': 0}"/>\n                <field name="asset_id"/>\n                <field name="asset_category_id"/>\n                <group expand="0" string="Extended Filters...">\n                    <field name="partner_id" filter_domain="[('partner_id','child_of',self)]"/>\n                    <field name="company_id" groups="base.group_multi_company"/>\n                </group>\n                <group expand="1" string="Group By">\n                    <filter string="Asset" name="asset" context="{'group_by':'asset_id'}"/>\n                    <filter string="Asset Category" name="asset_category" context="{'group_by':'asset_category_id'}"/>\n                    <filter string="Company" name="company" context="{'group_by':'company_id'}" groups="base.group_multi_company"/>\n                    <separator/>\n                    <filter string="Purchase Month" name="purchase_month" help="Date of asset purchase" context="{'group_by':'date:month'}"/>\n                    <filter string="Depreciation Month" name="deprecation_month" help="Date of depreciation" context="{'group_by':'depreciation_date:month'}"/>\n                </group>\n            </search>\n        	om_account_asset/report/account_asset_report_views.xml	\N	\N	\N	\N	primary	t	1	2025-08-28 11:32:59.711572	1	2025-08-28 11:32:59.711572	f

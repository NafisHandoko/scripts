1642	report_makara_lab	\N	ehealth_document.report_makara_lab	16	qweb	<?xml version="1.0"?>\n<t t-name="ehealth_document.report_makara_lab">\n        <t t-set="company" t-value="res_company"/>\n        <t t-call="ehealth_document.header_makara_document">\n          <div class="page">\n            <div class="row">\n              <div class="col-md-12">\n                <div>\n                    <div class="row">\n                        <div class="col-5"/>\n                        <div class="col-3">Nama / Name</div>\n                        <div class="col-4">: <t t-esc="o['partner_id']['name']"/></div>\n                    </div>\n                    <div class="row">\n                      <t t-if="'sample_number' in data and data['sample_number']">\n                        <div class="col-5"/>\n                          <div class="col-3">No. Sample / Sample No.</div>\n                        <div class="col-4">: <t t-esc="data['sample_number']"/></div>\n                      </t>\n                    </div>\n                    <div class="row">\n                        <div class="col-5"/>\n                        <div class="col-3">Tanggal Lahir / Birth Date</div>\n                        <div class="col-4">: <t t-esc="o['partner_id']['birthDate']"/></div>\n                    </div>\n                    <div class="row">\n                        <div class="col-5"/>\n                        <div class="col-3">Jenis Kelamin / Sex</div>\n                        <div class="col-4">: <t t-if="o['partner_id']['gender'] == 'male'">Laki-Laki</t><t t-else="">Perempuan</t>\n                        </div>\n                    </div>\n                    <div class="row">\n                        <div class="col-5"/>\n                        <div class="col-3">Alamat / Address</div>\n                        <div class="col-4">: <t t-esc="o['partner_id']['street']"/></div>\n                    </div>\n                    <t t-if="o['requester_id'] and o['requester_id']['name']">\n                      <div class="row">\n                          <div class="col-5"/>\n                          <div class="col-3">Dokter Pengirim / Doctor Requester</div>\n                          <div class="col-4">: <t t-esc="o['requester_id']['name']"/></div>\n                      </div>\n                    </t>\n                </div>\n                <p class="text-center mt-3 mb-0"><strong>HASIL PEMERIKSAAN LABORATORIUM</strong></p>\n                <p class="text-center">Nomor: <t t-esc="o['name']"/></p>                \n\n                <table class="table table-bordered table-sm mt-1">\n                  <tr class="text-center">\n                      <th>Pemeriksaan</th>\n                      <th>Hasil</th>\n                      <th>Nilai Rujukan</th>\n                      <th>Satuan</th>\n                  </tr>\n                  <t t-foreach="data['observation']" t-as="obs">\n                    <tr>\n                        <td colspan="4"><strong><t t-esc="obs.upper()"/></strong></td>\n                    </tr>\n                    \n                    <t t-foreach="data['observation'].get(obs)" t-as="obs_item">\n                      <tr>\n                        <td colspan="4"><strong><t t-esc="obs_item['name']"/></strong></td>\n                      </tr>\n                      <t t-foreach="obs_item['items']" t-as="item">\n                        <tr>\n                          <td><t t-esc="item['name']"/></td>                          \n                          <td><t t-esc="item['value']"/></td>\n                          <td><t t-esc="item['reference']"/></td>\n                          <td><t t-esc="item['unit']"/></td>\n                        </tr>\n                      </t>\n                    </t>\n\n                    <tr>\n                        <td colspan="4"/>\n                    </tr>\n                  </t>\n                </table>\n              </div>\n            </div>\n\n            <div class="
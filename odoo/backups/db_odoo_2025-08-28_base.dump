1619	report_westerindo_discharge_summary	\N	ehealth_document.report_westerindo_discharge_summary	16	qweb	<?xml version="1.0"?>\n<t t-name="ehealth_document.report_westerindo_discharge_summary">\n        <t t-set="company" t-value="res_company"/>\n        <div t-attf-class="article o_report_layout_standard o_company_#{company.id}_layout" t-att-data-oe-model="o and o._name" t-att-data-oe-id="o and o.id" t-att-data-oe-lang="o and o.env.context.get('lang')">\n          <div class="page">\n            <div class="row">\n              <div class="col-md-12">\n                \n                <div class="row" style="border: 2px solid black;">\n                    <div class="col-7" style="border-right: 2px solid black;">\n                      <img t-att-src="'/ehealth_document/static/src/img/logo-westerindo.jpg'" style="max-height: 50px; max-width:165px; padding-bottom: 8px" alt="Logo"/>\n\n                      <div class="row"><div class="col-12 text-center" style="font-weight: bold;">CATATAN PEMULANGAN PASIEN</div></div>\n                    </div>\n\n                    <div class="col-5">\n                      <div class="row">\n                        <div class="col-4">Nama</div>\n                        <div class="col-8">: <t t-esc="o['partner_id']['name']"/></div>\n                      </div>\n\n                      <div class="row">\n                        <div class="col-4">Tgl. Lahir</div>\n                        <div class="col-6">: <t t-esc="o['partner_id']['birthDate'].strftime('%d-%m-%Y')"/></div>\n                        <div class="col-2">\n                          <t t-if="'jenis-kelamin-pj' in data">\n                            <t t-if="data['jenis-kelamin-pj'] == 'male'">L</t>\n                            <t t-else="">P</t>\n                          </t>\n                        </div>\n                      </div>\n\n                      <div class="row">\n                        <div class="col-4">No. RM</div>\n                        <div class="col-8">: <t t-esc="o['partner_id']['medical_record']"/> </div>\n                      </div>\n                    </div>\n                </div>\n\n                <div class="row" style="border: 2px solid black; border-top: none">\n                  <div class="col-6" style="border-right: 2px solid black;">\n                    <div>Tanggal Perawatan: <t t-esc="o.to_date_string(data['tanggal-perawatan'])"/></div>\n                    <div style="min-height: 70  px">Diagnosa: \n                      <span> \n                        <t t-if="'diagnosa' in data">\n                          <t t-esc="data['diagnosa']"/>\n                        </t>\n                      </span>\n                    </div>\n                  </div>\n                  <div class="col-6">\n                    <div>Tanggal Selesai Pengobatan: <t t-esc="o.to_date_string(data['tanggal-selesai'])"/></div>\n                    <div style="min-height: 70px">Diagnosa Keluar Klinik:\n                      <span> \n                        <t t-if="'diagnosa' in data">\n                          <t t-esc="data['diagnosa']"/>\n                        </t>\n                      </span>\n                    </div>\n                  </div>\n                </div>\n\n                <div class="row" style="border: 2px solid black; border-top: none; padding-bottom: 12px;">\n                  <div class="col-12">\n                    <div style="margin-bottom: 8px;">Dokter Memberikan Penjelasan Cara Memakai Obat di Rumah Kepada Pasien/Keluarga</div>\n\n                    <div class="row">\n                      <div class="col-1">1.</div>\n                      <div class="col-7">Nama Obat</div>\n                      <div class="col-1"><div style="border: 2px solid black; width: 40px; height: 20px;"/></div>\n                      <div class="col-1">Ya</div>\n                      <div class="col-1"><div style="border: 2px solid black; width: 40px; height: 20px"/></div>\n                      <div class="col-1">Tidak</div>\n                    </div>\n\n                    <div class="row">\n                      <div class="col-1">2.</div>\n                      <div class="col-7">Jenis Obat yang dipakai </div>\n                      <div class="col-1"><div style="border: 2px solid black; width: 40px; height: 20px;"/></div>\n                      <div class="col-1">Ya</div>\n                      <div class="col-1"><div style="border: 2px solid black; width: 40px; height: 20px"/></div>\n                      <div class="col-1">Tidak</div>\n                    </div>\n\n                    <div class="row">\n                      <div class="col-1">3.</div>\n                      <div class="col-7">Waktu Memakai Obat</div>\n                      <div class="col-1"><div style="border: 2px solid black; width: 40px; height: 20px;"/></div>\n                      <div class="col-1">Ya</div>\n                      <div class="col-1"><div style="border: 2px solid black; width: 40px; height: 20px"/></div>\n                      <div class="col-1">Tidak</div>\n                    </div>\n\n                    <div class="row">\n                      <div class="col-1">4.</div>\n                      <div class="col-7">Alasan Memakai Obat </div>\n                      <div class="col-1"><div style="border: 2px solid black; width: 40px; height: 20px;"/></div>\n                      <div class="col-1">Ya</div>\n                      <div class="col-1"><div style="border: 2px solid black; width: 40px; height: 20px"/></div>\n                      <div class="col-1">Tidak</div>\n                    </div>\n\n                    <div class="row">\n                      <div class="col-1">5.</div>\n                      <div class="col-7">Efek Samping yang akan muncul setelah memakai obat</div>\n                      <div class="col-1"><div style="border: 2px solid black; width: 40px; height: 20px;"/></div>\n                      <div class="col-1">Ya</div>\n                      <div class="col-1"><div style="border: 2px solid black; width: 40px; height: 20px"/></div>\n                      <div class="col-1">Tidak</div>\n                    </div>\n                  </div>\n                </div>\n\n                <div class="row" style="border: 2px solid black; border-top: none">\n                  <div class="col-2" style="border-right: 2px solid black;">Nama Obat</div>\n                  <div class="col-2" style="border-right: 2px solid black;">Dosis</div>\n                  <div class="col-1" style="border-right: 2px solid black;">Pagi</div>\n                  <div class="col-1" style="border-right: 2px solid black;">Siang</div>\n                  <div class="col-2" style="border-right: 2px solid black;">Malam</div>\n                  <div class="col-4">Waktu habis &amp; instruksi lainnya</div>\n                </div>\n\n                <div class="row" style="border: 2px solid black; border-top: none">\n                  <div class="col-2" style="border-right: 2px solid black; height: 120px;">\n                    <t t-if="'medication-req' in data">\n                      <t t-foreach="data['medication-req']" t-as="med">\n                        <div><t t-esc="med['nama-obat']"/></div>\n                      </t>\n                    </t>\n                  </div>\n                  <div class="col-2" style="border-right: 2px solid black; height: 120px;">\n                    <t t-if="'medication-req' in data">\n                      <t t-foreach="data['medication-req']" t-as="med">\n                        <div><t t-esc="med['dosis']"/></div>\n                      </t>\n                    </t>\n                  </div>\n                  <div class="col-1" style="border-right: 2px solid black; height: 120px;"/>\n                  <div class="col-1" style="border-right: 2px solid black; height: 120px;"/>\n                  <div class="col-2" style="border-right: 2px solid black; height: 120px;"/>\n                  <div class="col-4" style="height: 120px;"/>\n                </div>\n\n                <div class="row" style="border: 2px solid black; border-top: none">\n                  <div class="col-12">\n                    <div>Perawatan Luka: </div>\n                    <div class="row">\n                      <div class="col-12" style="min-height: 80px;">\n                        <t t-if="'perawatan-luka' in data">\n                          <t t-esc="data['perawatan-luka']"/>\n                        </t>\n                      </div>\n                    </div>\n                  </div>\n                </div>\n\n                <div class="row" style="border: 2px solid black; border-top: none">\n                  <div class="col-12">\n                    <div>Aktivitas dan istirahat: </div>\n                    <div class="row">\n                      <div class="col-12" style="min-height: 80px;">\n                        <t t-if="'aktivitas-istirahat' in data">\n                          <t t-esc="data['aktivitas-istirahat']"/>\n                        </t>\n                      </div>\n                    </div>\n                  </div>\n                </div>\n\n                <div class="row" style="border: 2px solid black; border-top: none">\n                  <div class="col-12">\n                    <div>Aturan diet: </div>\n                    <div class="row">\n                      <div class="col-12" style="min-height: 80px;">\n                        <t t-if="'aturan-diet' in data">\n                          <t t-esc="data['aturan-diet']"/>\n                        </t>\n                      </div>\n                    </div>\n                  </div>\n                </div>\n\n                <div class="row" style="border: 2px solid black; border-top: none; padding-bottom: 12px;">\n                  <div class="col-12">\n                    <div style="margin-bottom: 8px;">Hasil pemeriksaan yang dibawa pulang :</div>\n\n                    <div class="row">\n                      <div class="col-1" style="border: 2px solid black; border-left: none;"/>\n                      <div class="col-11">Laboratorium</div>\n                    </div>\n\n                    <div class="row">\n                      <div class="col-1" style="border: 2px solid black; border-left: none; border-top: none;"/>\n                      <div class="col-11">Rontgen</div>\n                    </div>\n\n                    <div class="row">\n                      <div class="col-1" style="border: 2px solid black; border-left: none; border-top: none;"/>\n                      <div class="col-11">EKG</div>\n                    </div>\n\n                    <div style="height: 20px;"/>\n                  </div>\n                </div>\n\n                <div class="row" style="border: 2px solid black; padding-bottom: 12px; page-break-inside: avoid; page-break-before: auto;">\n                  <div class="col-12">\n                    <div style="margin-bottom: 8px;">Surat keterangan yang di bawa pulang :</div>\n\n                    <div class="row">\n                      <div class="col-1" style="border: 2px solid black; border-left: none;"/>\n                      <div class="col-11">Surat Keterangan Sakit</div>\n                    </div>\n\n                    <div class="row">\n                      <div class="col-1" style="border: 2px solid black; border-left: none; border-top: none;"/>\n                      <div class="col-11">Surat Kontrol</div>\n                    </div>\n\n                    <div style="height: 20px;"/>\n                  </div>\n                </div>\n\n                <div class="row" style="border: 2px solid black; border-top: none; padding-bottom: 12px; page-break-inside: avoid; page-break-before: auto;">\n                  <div class="col-12">\n                    <div>Saya selaku keluarga psaien sudah mendapatkan penjelasan tentang hal-hal tersebut di atas</div>\n                    <div style="margin-bottom: 24px;">Oleh perawat Klinik Westerindo dan Semuanya sudah saya mengerti</div>\n                    <div class="mb-0"><t t-esc="o['operating_unit_id']['city']"/>, <t t-esc="o.to_date_string(data['registration_date'])"/></div>\n                    <div>Mengetahui,</div>\n                    <div style="height: 100px;"/>\n\n\n                    <div class="row">\n                      <div class="col-3" style="border-top: 2px solid black;">\n                        <t t-if="'perawat-bertugas' in data">\n                          <t t-esc="data['perawat-bertugas']"/>\n                        </t>\n                      </div>\n                      <div class="col-1"/>\n                      <div class="col-3" style="border-top: 2px solid black;">\n                        <t t-esc="o['partner_id']['name']"/>\n                      </div>\n                      <div class="col-1"/>\n                      <div class="col-4" style="border-top: 2px solid black;">\n                        <t t-if="'examiner_name' in data">\n                          <t t-esc="data['examiner_name']"/>\n                        </t>\n                      </div>\n                    </div>\n\n\n                    <!-- <div class="row">\n                      <div class="col-3" style="border-top: 2px solid black;">Perawat Yang Bertugas</div>\n                      <div class="col-1"></div>\n                      <div class="col-3" style="border-top: 2px solid black;">Pasien/Keluarga</div>\n                      <div class="col-1"></div>\n                      <div class="col-4" style="border-top: 2px solid black;">Dokter yang menangani</div>\n                    </div> -->\n                  </div>\n                </div>\n\n              </div>\n            </div>\n          </div>\n        </div>\n      </t>\n    	ehealth_document/report/template_discharge_summary/report_westerindo_discharge_summary.xml	\N	\N	\N	\N	primary	t	1	2025-08-28 11:34:01.364376	1	2025-08-28 11:34:01.364376	f

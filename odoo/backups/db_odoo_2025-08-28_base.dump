, <t t-esc="o.to_date_string(data['registration_date'])"/></p>\n                    <p class="mb-0">Dokter Pemeriksa</p>\n                    <div class="mt-3" id="qrcode">\n                        <t t-if="'qr_code_examiner_url' in data">\n                          <img t-att-src="data['qr_code_examiner_url']" style="width:125px;height:125px;"/>\n                        </t>\n                        <t t-else="">\n                          <div style="width:125px;height:125px;"/>\n                        </t>\n                    </div>\n                    <p class="mb-0 mt-2"><strong>\n                    <t t-if="'examiner_name' in data">\n                      <t t-esc="data['examiner_name']"/>\n                    </t>\n                    <t t-else="">\n                      <t t-esc="data['sender']"/>\n                    </t>\n                    </strong></p>\n                </div>\n            </div>\n          </div>\n        </t>\n      </t>\n    	ehealth_document/report/template_surat_sakit/report_klinikpelitainsani_surat_sakit.xml	\N	\N	\N	\N	primary	t	1	2025-08-28 11:34:01.364376	1	2025-08-28 11:34:01.364376	f

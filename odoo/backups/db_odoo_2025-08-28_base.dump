380	message_user_assigned	\N	mail.message_user_assigned	16	qweb	<?xml version="1.0"?>\n<t t-name="mail.message_user_assigned">\n<p style="margin: 0px;">\n    <span>Dear <t t-esc="object.user_id.sudo().name"/>,</span><br/>\n    <span style="margin-top: 8px;">You have been assigned to the <t t-esc="model_description or 'document'"/> <t t-esc="object.display_name"/>.</span>\n</p>\n<p style="margin-top: 24px; margin-bottom: 16px;">\n    <a t-att-href="access_link" t-att-data-oe-model="object._name" t-att-data-oe-id="object.id" style="background-color:#875A7B; padding: 10px; text-decoration: none; color: #fff; border-radius: 5px;">\n            View <t t-esc="model_description or 'document'"/>\n    </a>\n</p>\n        </t>\n\n        	mail/data/mail_data.xml	\N	\N	\N	\N	primary	t	1	2025-08-28 11:32:08.78587	1	2025-08-28 11:32:08.78587	\N
290	http_error_debug	\N	http_routing.http_error_debug	16	qweb	<?xml version="1.0"?>\n<t t-name="http_routing.http_error_debug">\n        <div class="container accordion mb32 mt32" id="debug_infos">\n            <div class="card" t-if="error_message">\n                <h4 class="card-header">\n                    <a data-toggle="collapse" href="#error_main">Error</a>\n                </h4>\n                <div id="error_main" class="collapse show">\n                    <div class="card-body">\n                        <t t-call="http_routing.error_message"/>\n                    </div>\n                </div>\n            </div>\n            <div class="card" t-if="qweb_exception">\n                <h4 class="card-header">\n                    <a data-toggle="collapse" href="#error_qweb">QWeb</a>\n                </h4>\n                <div id="error_qweb" class="collapse show">\n                    <div class="card-body">\n                        <p t-if="exception.message">\n                            <strong>Error message:</strong>\n                            <pre t-esc="exception.message"/>\n                        </p>\n                        <p>\n                            The error occured while rendering the template <code t-esc="qweb_exception.name"/>\n                            <t t-if="qweb_exception.html">and evaluating the following expression: <code t-esc="qweb_exception.html"/></t>\n                        </p>\n                    </div>\n                </div>\n            </div>\n            <div class="card" t-if="traceback">\n                <h4 class="card-header">\n                    <a data-toggle="collapse" href="#error_traceback">Traceback</a>\n                </h4>\n                <div id="error_traceback" t-attf-class="collapse #{not error_message and not qweb_exception and 'show'}">\n                    <div class="card-body">\n                        <pre id="exception_traceback" t-esc="traceback"/>\n                    </div>\n   
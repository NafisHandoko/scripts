121	res.partner.kanban	res.partner	\N	16	kanban	<?xml version="1.0"?>\n<kanban class="o_res_partner_kanban" sample="1">\n                    <field name="id"/>\n                    <field name="color"/>\n                    <field name="display_name"/>\n                    <field name="title"/>\n                    <field name="email"/>\n                    <field name="parent_id"/>\n                    <field name="is_company"/>\n                    <field name="function"/>\n                    <field name="phone"/>\n                    <field name="street"/>\n                    <field name="street2"/>\n                    <field name="zip"/>\n                    <field name="city"/>\n                    <field name="country_id"/>\n                    <field name="mobile"/>\n                    <field name="state_id"/>\n                    <field name="category_id"/>\n                    <field name="image_128"/>\n                    <field name="type"/>\n                    <templates>\n                        <t t-name="kanban-box">\n                            <div class="oe_kanban_global_click o_kanban_record_has_image_fill o_res_partner_kanban">\n                                <t t-if="!record.is_company.raw_value">\n                                    <t t-if="record.type.raw_value === 'delivery'" t-set="placeholder" t-value="'/base/static/img/truck.png'"/>\n                                    <t t-elif="record.type.raw_value === 'invoice'" t-set="placeholder" t-value="'/base/static/img/money.png'"/>\n                                    <t t-else="" t-set="placeholder" t-value="'/base/static/img/avatar_grey.png'"/>\n                                    <div class="o_kanban_image_fill_left d-none d-md-block" t-attf-style="background-image:url('#{kanban_image('res.partner', 'image_128', record.id.raw_value,  placeholder)}')">\n                                        <img class="o_kanban_image_inner_pic" t-if="record.parent_id.raw_value" t-att-alt="record.parent_id.value" t-att-src="kanban_image('res.partner', 'image_128', record.parent_id.raw_value)"/>\n                                    </div>\n                                    <div class="o_kanban_image d-md-none" t-attf-style="background-image:url('#{kanban_image('res.partner', 'image_128', record.id.raw_value,  placeholder)}')">\n                                        <img class="o_kanban_image_inner_pic" t-if="record.parent_id.raw_value" t-att-alt="record.parent_id.value" t-att-src="kanban_image('res.partner', 'image_128', record.parent_id.raw_value)"/>\n                                    </div>\n                                </t>\n                                <t t-else="">\n                                    <t t-set="placeholder" t-value="'/base/static/img/company_image.png'"/>\n                                    <div class="o_kanban_image_fill_left o_kanban_image_full" t-attf-style="background-image: url(#{kanban_image('res.partner', 'image_128', record.id.raw_value, placeholder)})" role="img"/>\n                                </t>\n                                <div class="oe_kanban_details d-flex flex-column">\n                                    <strong class="o_kanban_record_title oe_partner_heading"><field name="display_name"/></strong>\n                                    <div class="o_kanban_tags_section oe_kanban_partner_categories"/>\n                                    <ul>\n                                        <li t-if="record.parent_id.raw_value and !record.function.raw_value"><field name="parent_id"/></li>\n                                        <li t-if="!record.parent_id.raw_value and record.function.raw_value"><field name="function"/></li>\n                                        <li t-if="record.parent_id.raw_value and record.function.raw_value"><field name="function"/> at <field name="parent_id"/></li>\n                                        <li t-if="record.city.raw_value or record.country_id.raw_value">\n                                            <t t-if="record.city.raw_value"><field name="city"/><t t-if="record.country_id.raw_value">, </t></t>\n                                            <t t-if="record.country_id.raw_value"><field name="country_id"/></t>\n                                        </li>\n                                        <li t-if="record.email.raw_value" class="o_text_overflow"><field name="email"/></li>\n                                    </ul>\n                                    <div class="o_row">\n                                        <span class="oe_kanban_partner_links"/>\n                                    </div>\n                                </div>\n                            </div>\n                        </t>\n                    </templates>\n                </kanban>\n            	base/views/res_partner_views.xml	\N	\N	\N	\N	primary	t	1	2025-08-28 11:31:39.100786	1	2025-08-28 11:31:39.100786	\N
1335	eHealth	res.config.settings	\N	16	form	<?xml version="1.0"?>\n<xpath expr="//div[hasclass('settings')]" position="inside">\n                    <div class="app_settings_block" data-string="eHealth Data-String" string="eHealth" data-key="ehealth">\n                        <h2>Customization Settings</h2>\n                        <div class="row mt16 o_settings_container">\n                            <div class="col-12 col-lg-6 o_setting_box" title="Dispense State" id="dispense_state" modifiers="{}">\n                                <div class="o_setting_left_pane" modifiers="{}">\n                                    <field name="use_assigned_state" modifiers="{}" id="use_assigned_state"/>\n                                </div>\n                                <div class="o_setting_right_pane" modifiers="{}">\n                                    <label string="Prescription Dispense State" for="use_assigned_state" modifiers="{}"/>\n                                    <div class="text-muted" modifiers="{}">\n                                        Set prescription dispense state always Ready and on-hand product might be minus\n                                    </div>\n                                </div>\n                            </div>\n\n                            <div class="col-12 col-lg-6 o_setting_box" title="Multiple Location Stock" id="multiple_location_stock" modifiers="{}">\n                                <div class="o_setting_left_pane" modifiers="{}">\n                                    <field name="can_dispense_multi_location" modifiers="{}" id="can_dispense_multi_location"/>\n                                </div>\n                                <div class="o_setting_right_pane" modifiers="{}">\n                                    <label string="Dispense for Multiple Location Stock" for="can_dispense_multi_location" modifiers="{}"/>\n                                    <div class="text-muted" modifiers="{}">\n                                        User can choose a specific location when dispense the product\n                                    </div>\n                                </div>\n                            </div>\n\n                            <div class="col-12 col-lg-6 o_setting_box" title="Exclude Medication From Invoice" id="exclude_medication" modifiers="{}">\n                                <div class="o_setting_left_pane" modifiers="{}">\n                                    <field name="exclude_medication_from_invoice" modifiers="{}" id="exclude_medication_from_invoice"/>\n                                </div>\n                                <div class="o_setting_right_pane" modifiers="{}">\n                                    <label string="Exclude Medication From Invoice" for="exclude_medication_from_invoice" modifiers="{}"/>\n                                    <div class="text-muted" modifiers="{}">\n                                        Exclude medications from invoice when dispensing the prescription\n                                    </div>\n                                </div>\n                            </div>\n\n                            <div class="col-12 col-lg-6 o_setting_box" title="Exclude Consumable From Invoice" id="exclude_consumable" modifiers="{}">\n                                <div class="o_setting_left_pane" modifiers="{}">\n                                    <field name="exclude_consumable_from_invoice" modifiers="{}" id="exclude_consumable_from_invoice"/>\n                                </div>\n                                <div class="o_setting_right_pane" modifiers="{}">\n                                    <label string="Exclude Consumable From Invoice" for="exclude_consumable_from_invoice" modifiers="{}"/>\n                                    <div class="text-muted" modifiers="{}">\n                                        Exclude consumables from invoice when dispensing the prescription\n                                    </div>\n                                </div>\n                            </div>\n\n                            <div class="col-12 col-lg-6 o_setting_box" title="Automatic Consumable Dispense" id="auto_dispense_consumable" modifiers="{}">\n                                <div class="o_setting_left_pane" modifiers="{}">\n                                    <field name="auto_dispense_consumable" modifiers="{}" id="auto_dispense_consumable"/>\n                                </div>\n                                <div class="o_setting_right_pane" modifiers="{}">\n                                    <label string="Automatic Consumable Dispense" for="auto_dispense_consumable" modifiers="{}"/>\n                                    <div class="text-muted" modifiers="{}">\n                                        Automate dispense for consumable request\n                                    </div>\n                                </div>\n                            </div>\n                            <div attrs="{'invisible': [('pharmacy_flow','=', 'cashier_to_pharmacy')]}" class="col-12 col-lg-6 o_setting_box"/>\n                            <div attrs="{'invisible': [('pharmacy_flow','!=', 'cashier_to_pharmacy')]}" class="col-12 col-lg-6 o_setting_box" title="Hide Concoction Medicine Detail In Invoice" id="hide_concoction_detail_state" modifiers="{}">\n                                <div class="o_setting_left_pane" modifiers="{}">\n                                    <field name="hide_concoct_detail_invoice_state" modifiers="{}" id="hide_concoct_detail_invoice_state"/>\n                                </div>\n                                <div class="o_setting_right_pane" modifiers="{}">\n                                    <label string="Hide Concoction Detail in Invoice" for="hide_concoct_detail_invoice_state" modifiers="{}"/>\n                                    <div class="text-muted" modifiers="{}">\n                                        Hide Concoction Medicine Detail in Invoice and only show the concoction name and total price (Only for cashier to pharmacy flow)\n                                    </div>\n                                </div>\n                            </div>\n\n                            <div class="col-12 col-lg-6 o_setting_box" id="pharmacy_flow_selection" modifiers="{}">\n                                <span class="o_form_label">Pharmacy Flow</span>\n                                <div class="o_setting_right_pane mt16" modifiers="{}">\n                                    <label string="Flow of patient medicine taking" for="pharmacy_flow" modifiers="{}"/>\n                                    <div class="content-group mt8">\n                                        <field name="pharmacy_flow" modifiers="{}" id="pharmacy_flow"/>\n                                    </div>\n                                </div>\n                            </div>\n\n                            <div class="col-12 col-lg-6 o_setting_box" id="product_name_selection" modifiers="{}">\n                                <span class="o_form_label">Product Name Code</span>\n                                <div class="o_setting_right_pane mt16" modifiers="{}">\n                                    <label string="Whether to use Code or Internal Reference for product name" for="product_name" modifiers="{}"/>\n                                    <div class="content-group mt8">\n                                        <field name="product_name" modifiers="{}" id="product_name"/>\n                                    </div>\n                                </div>\n                            </div>\n                            \n                            <div class="col-12 col-lg-6 o_setting_box" title="Open Invoice in New Tab" id="open_invoice_state" modifiers="{}">\n                                <div class="o_setting_left_pane" modifiers="{}">\n                                    <field name="open_invoice_newtab" modifiers="{}" id="open_invoice_newtab"/>\n                                </div>\n                                <div class="o_setting_right_pane" modifiers="{}">\n                                    <label string="Open Invoice in New Tab" for="open_invoice_newtab" modifiers="{}"/>\n                                    <div class="text-muted" modifiers="{}">\n                                        Open Invoice Details in New Tab\n                                    </div>\n                                </div>\n                            </div>\n                            \n                            <div class="col-12 col-lg-6 o_setting_box" title="Activate Pharmacy Invoice" id="activate_pharmacy_invoice" modifiers="{}">\n                                <div class="o_setting_left_pane">\n                                    <field name="activate_pharmacy_invoice" modifiers="{}" id="activate_pharmacy_invoice"/>\n                                </div>\n                                <div class="o_setting_right_pane" modifiers="{}">\n                                    <label string="Activate Pharmacy Invoice" for="activate_pharmacy_invoice" modifiers="{}"/>\n                                    <div class="text-muted" modifiers="{}">\n                                        Make separate invoice for pharmacy\n                                    </div>\n                                </div>\n                            </div>\n\n                            <div class="col-12 col-lg-6 o_setting_box" title="Auto Send Attachment when invoice confirmed" id="open_invoice_state" modifiers="{}">\n                                <div class="o_setting_left_pane" modifiers="{}">\n                                    <field name="auto_send_invoice_on_confirm" modifiers="{}" id="auto_send_invoice_on_confirm"/>\n                                </div>\n                                <div class="o_setting_right_pane" modifiers="{}">\n                                    <label string="Auto Send Attachment when invoice confirmed" for="auto_send_invoice_on_confirm" modifiers="{}"/>\n                                    <div class="text-muted" modifiers="{}">\n                                        Automatically send invoice attachment when invoice confirmed\n                                    </div>\n                                </div>\n                            </div>\n                        </div>\n\n                        <h2 modifiers="{}">E-Klaim Integration</h2>\n                        <div class="row mt16 o_settings_container">\n                            <div class="col-12 col-lg-6 o_setting_box" title="E-Klaim Integration" id="eklaim_integration" modifiers="{}">\n                                <div class="o_setting_left_pane" modifiers="{}">\n                                    <field name="eklaim_integration" modifiers="{}" id="eklaim_integration"/>\n                                </div>\n                                <div class="o_setting_right_pane" modifiers="{}">\n                                    <label string="E-Klaim Integration" for="eklaim_integration" modifiers="{}"/>\n                                    <div class="text-muted" modifiers="{}">\n                                        Automatic create Claim resource when post an Invoice\n                                    </div>\n                                </div>\n                            </div>\n\n                            <div class="col-12 col-lg-6 o_setting_box" id="eklaim_default_journal_selection" modifiers="{}">\n                                <div class="o_setting_right_pane" modifiers="{}">\n                                    <label string="Default journal for E-Klaim payment" for="eklaim_default_journal" modifiers="{}"/>\n                                    <div class="text-muted" modifiers="{}">\n                                        Default journal set when get ClaimResponse callback from E-Klaim\n                                    </div>\n                                    <div class="content-group mt8">\n                                        <field name="eklaim_default_journal" modifiers="{}" id="eklaim_default_journal"/>\n                                    </div>\n                                </div>\n                            </div>\n\n                            <div class="col-12 col-lg-6 o_setting_box" id="eklaim_default_journal_selection" modifiers="{}" attrs="{'invisible': [('eklaim_integration','=', False)]}">\n                                <div class="o_setting_right_pane" modifiers="{}">\n                                    <label string="Default journal for E-Klaim partially payment" for="eklaim_default_journal" modifiers="{}"/>\n                                    <div class="text-muted" modifiers="{}">\n                                        Handle Partialy Paid for ClaimResponse\n                                    </div>\n                                    <div class="content-group mt8">\n                                        <field name="eklaim_default_difference_handling" widget="radio" nolabel="1"/>\n                                        <div attrs="{'invisible': [('eklaim_default_difference_handling','=','open')]}">\n                                            <label for="eklaim_default_writeoff_account_id" string="Post Difference In" class="oe_edit_only"/>\n                                            <field name="eklaim_default_writeoff_account_id" string="Post Difference In" options="{'no_create': True}" attrs="{'required': [('eklaim_default_difference_handling', '=', 'reconcile')]}" style="display: block;"/>\n                                            <label for="eklaim_default_writeoff_label" class="oe_edit_only" string="Label"/>\n                                            <field name="eklaim_default_writeoff_label" attrs="{'required': [('eklaim_default_difference_handling', '=', 'reconcile')]}" style="display: block;"/>\n                                        </div>\n                                    </div>\n                                </div>\n                            </div>\n                        </div>\n\n                        <h2 modifiers="{}">Notification</h2>\n                        <div class="row mt16 o_settings_container">\n                            <div class="col-12 col-lg-6 o_setting_box" id="receiver_notification_id" modifiers="{}">\n                                <div class="o_setting_right_pane" modifiers="{}">\n                                    <label string="The person in default who received the appointment notification" for="receiver_notification_id" modifiers="{}"/>\n                                    <div class="content-group mt8">\n                                        <field name="receiver_notification_id" modifiers="{}" id="receiver_notification_id"/>\n                                    </div>\n                                </div>\n                            </div>\n                        </div>\n                    </div>\n                </xpath>\n            	ehealth/views/res_config_settings_view.xml	\N	\N	166	\N	extension	t	1	2025-08-28 11:33:43.631866	1	2025-08-28 11:33:43.631866	f
116	res.partner.simplified.form	res.partner	\N	16	form	<?xml version="1.0"?>\n<form string="Contact">\n                    <field name="is_company" invisible="1"/>\n                    <field name="type" invisible="1"/>\n                    <field name="image_1920" widget="image" class="oe_avatar" options="{&quot;preview_image&quot;: &quot;image_128&quot;}"/>\n                    <div class="oe_title">\n                        <field name="company_type" options="{'horizontal': true}" class="oe_edit_only" widget="radio" groups="base.group_no_one"/>\n                        <h1>\n                            <field name="name" default_focus="1" placeholder="Name" attrs="{'required' : [('type', '=', 'contact')]}"/>\n                        </h1>\n                        <field name="parent_id" widget="res_partner_many2one" placeholder="Company" domain="[('is_company', '=', True)]" context="{'default_is_company': True, 'show_vat': True}" attrs="{'invisible': [('is_company','=', True)]}"/>\n                    </div>\n                    <group>\n                        <field name="function" placeholder="e.g. Sales Director" attrs="{'invisible': [('is_company','=', True)]}"/>\n                        <field name="user_ids" invisible="1"/>\n                        <field name="email" widget="email" context="{'gravatar_image': True}" required="context.get('force_email', False)" attrs="{'required': [('user_ids','!=', [])]}"/>\n                        <field name="phone" widget="phone" options="{'enable_sms': false}"/>\n                        <field name="mobile" widget="phone" options="{'enable_sms': false}"/>\n                    </group>\n                </form>\n            	base/views/res_partner_views.xml	\N	\N	\N	\N	primary	t	1	2025-08-28 11:31:39.100786	1	2025-08-28 11:31:39.100786	\N
117	res.partner.form.address	res.partner	\N	20	form	<?xml version="1.0"?>\n<form string="Partner">\n                    <field name="image_1920" widget="image" class="oe_avatar" options="{&quot;preview_image&quot;: &quot;image_128&quot;}" readonly="1"/>\n                    <div class="oe_title">\n                        <h1>\n                            <field name="name" readonly="1"/>\n                        </h1>\n                    </div>\n                    <field name="parent_id" invisible="1"/>\n                    <group>\n                        <group>\n                            <label for="type" attrs="{'invisible': [('parent_id','=', False)]}" groups="base.group_no_one"/>\n                            <div attrs="{'invisible': [('parent_id','=', False)]}" name="div_type" groups="base.group_no_one">\n                                <field name="type" class="oe_inline"/>\n                            </div>\n                            <label for="street" string="Address"/>\n                            <div class="o_address_format">\n                                <field name="street" placeholder="Street..." class="o_address_street"/>\n                                <field name="street2" placeholder="Street 2..." class="o_address_street"/>\n                                <field name="city" placeholder="City" class="o_address_city"/>\n                                <field name="state_id" class="o_address_state" placeholder="State" options="{'no_open': True, 'no_quick_create': True}" context="{'default_country_id': country_id}"/>\n                                <field name="zip" placeholder="ZIP" class="o_address_zip"/>\n                                <field name="country_id" placeholder="Country" class="o_address_country" options="{&quot;no_open&quot;: True, &quot;no_create&quot;: True}"/>\n                            </div>\n                            <field name="website" widget="url" placeholder="e.g. https://www.odoo.com"/>\n                        </group>\n                        <group>\n                        </group>\n                    </group>\n                </form>\n            	base/views/res_partner_views.xml	\N	\N	\N	\N	primary	t	1	2025-08-28 11:31:39.100786	1	2025-08-28 11:31:39.100786	\N
1336	eHealth Account Settings	res.config.settings	\N	16	form	<?xml version="1.0"?>\n<xpath expr="//div[@id='invoicing_settings']" position="inside">\n                    <div class="col-12 col-lg-6 o_setting_box" title="Activate Invoice Structure Rule" id="activate_invoice_structure_rule" modifiers="{}">\n                        <div class="o_setting_left_pane" modifiers="{}">\n                            <field name="activate_invoice_structure_rule" modifiers="{}" id="activate_invoice_structure_rule"/>\n                        </div>\n                        <div class="o_setting_right_pane" modifiers="{}">\n                            <label string="Activate Invoice Structure Rule" for="activate_invoice_structure_rule" modifiers="{}"/>\n                            <div class="text-muted" modifiers="{}">\n                                Enable invoice structure rule feature for automatic invoice calculations\n                            </div>\n                            <div class="content-group mt8" attrs="{'invisible': [('activate_invoice_structure_rule', '=', False)]}">\n                                <button type="action" name="429" icon="fa-arrow-right" string="Manage Invoice Structure Rules" class="btn btn-link"/>\n                            </div>\n                        </div>\n                    </div>\n                </xpath>\n            	ehealth/views/res_config_settings_view.xml	\N	\N	728	\N	extension	t	1	2025-08-28 11:33:43.631866	1	2025-08-28 11:33:43.631866	f
118	res.partner.form	res.partner	\N	1	form	<?xml version="1.0"?>\n<form string="Partners">\n                <div class="alert alert-warning oe_edit_only" role="alert" attrs="{'invisible': [('same_vat_partner_id', '=', False)]}">\n                  A partner with the same <span><span class="o_vat_label">Tax ID</span></span> already exists (<field name="same_vat_partner_id"/>), are you sure to create a new one?\n                </div>\n                <sheet>\n                    <div class="oe_button_box" name="button_box"/>\n                    <widget name="web_ribbon" title="Archived" bg_color="bg-danger" attrs="{'invisible': [('active', '=', True)]}"/>\n                    <field name="image_1920" widget="image" class="oe_avatar" options="{&quot;preview_image&quot;: &quot;image_128&quot;}"/>\n                    <div class="oe_title">\n                        <field name="is_company" invisible="1"/>\n                        <field name="commercial_partner_id" invisible="1"/>\n                        <field name="active" invisible="1"/>\n                        <field name="company_type" widget="radio" class="oe_edit_only" options="{'horizontal': true}"/>\n                        <h1>\n                            <field name="name" default_focus="1" placeholder="Name" attrs="{'required' : [('type', '=', 'contact')]}"/>\n                        </h1>\n                        <div class="o_row">\n                            <field name="parent_id" widget="res_partner_many2one" placeholder="Company" domain="[('is_company', '=', True)]" context="{'default_is_company': True, 'show_vat': True}" attrs="{'invisible': ['|', '&amp;', ('is_company','=', True),('parent_id', '=', False),('company_name', '!=', False),('company_name', '!=', '')]}"/>\n                                <field name="company_name" attrs="{'invisible': ['|', '|', ('company_name', '=', False), ('company_name', '=', ''), ('is_company', '=', True)]}"/>\n                                <button name="create_company" icon="fa-plus-square" string="Create company" type="object" class="oe_edit_only btn-link" attrs="{'invisible': ['|', '|', ('is_company','=', True), ('company_name', '=', ''), ('company_name', '=', False)]}"/>\n                        </div>\n                    </div>\n\n                    <group>\n                        <group>\n                            <field name="type" groups="base.group_no_one" attrs="{'invisible': [('is_company','=', True)], 'readonly': [('user_ids', '!=', [])]}"/>\n                            <span class="o_form_label o_td_label" name="address_name">\n                                <b attrs="{'invisible': ['|', ('parent_id', '=', False), ('type', '!=', 'contact')]}">Company Address</b>\n                                <b attrs="{'invisible': ['|', ('parent_id', '=', False), ('type', '!=', 'invoice')]}">Invoice Address</b>\n                                <b attrs="{'invisible': ['|', ('parent_id', '=', False), ('type', '!=', 'delivery')]}">Delivery Address</b>\n                                <b attrs="{'invisible': ['|', ('parent_id', '=', False), ('type', '!=', 'other')]}">Other Address</b>\n                                <b attrs="{'invisible': ['|', ('parent_id', '=', False), ('type', '!=', 'private')]}">Private Address</b>\n                                <b attrs="{'invisible': ['&amp;', ('parent_id', '!=', False), ('type', '!=', False)]}">Address</b>\n                            </span>\n                            <div class="o_address_format">\n                                <field name="street" placeholder="Street..." class="o_address_street" attrs="{'readonly': [('type', '=', 'contact'),('parent_id', '!=', False)]}"/>\n                                <field name="street2" placeholder="Street 2..." class="o_address_street" attrs="{'readonly': [('type', '=', 'contact'),('parent_id', '!=', False)]}"/>\n                                <field name="city" placeholder="City" class="o_address_city" attrs="{'readonly': [('type', '=', 'contact'),('parent_id', '!=', False)]}"/>\n                                <field name="state_id" class="o_address_state" placeholder="State" options="{'no_open': True, 'no_quick_create': True}" attrs="{'readonly': [('type', '=', 'contact'),('parent_id', '!=', False)]}" context="{'country_id': country_id, 'default_country_id': country_id, 'zip': zip}"/>\n                                <field name="zip" placeholder="ZIP" class="o_address_zip" attrs="{'readonly': [('type', '=', 'contact'),('parent_id', '!=', False)]}"/>\n                                <field name="country_id" placeholder="Country" class="o_address_country" options="{&quot;no_open&quot;: True, &quot;no_create&quot;: True}" attrs="{'readonly': [('type', '=', 'contact'),('parent_id', '!=', False)]}"/>\n                            </div>\n                            <field name="vat" placeholder="e.g. BE0477472701" attrs="{'readonly': [('parent_id','!=',False)]}"/>\n                        </group>\n                        <group>\n                            <field name="function" placeholder="e.g. Sales Director" attrs="{'invisible': [('is_company','=', True)]}"/>\n                            <field name="phone" widget="phone"/>\n                            <field name="mobile" widget="phone"/>\n                            <field name="user_ids" invisible="1"/>\n                            <field name="email" widget="email" context="{'gravatar_image': True}" attrs="{'required': [('user_ids','!=', [])]}"/>\n                            <field name="website" widget="url" placeholder="e.g. https://www.odoo.com"/>\n                            <field name="title" options="{&quot;no_open&quot;: True}" placeholder="e.g. Mister" attrs="{'invisible': [('is_company', '=', True)]}"/>\n                            <field name="active_lang_count" invisible="1"/>\n                            <label for="lang" attrs="{'invisible': [('active_lang_count', '&lt;=', 1)]}"/>\n                            <div class="o_row" attrs="{'invisible': [('active_lang_count', '&lt;=', 1)]}">\n                                <field name="lang"/>\n                                <button type="action" name="53" class="btn-sm btn-link mb4 fa fa-globe" aria-label="More languages" groups="base.group_system" title="More languages"/>\n                            </div>\n                            <field name="category_id" widget="many2many_tags" options="{'color_field': 'color', 'no_create_edit': True}" placeholder="Tags..."/>\n                        </group>\n                    </group>\n\n                    <notebook colspan="4">\n                        <page string="Contacts &amp; Addresses" name="contact_addresses" autofocus="autofocus">\n                            <field name="child_ids" mode="kanban" context="{'default_parent_id': active_id, 'default_street': street, 'default_street2': street2, 'default_city': city, 'default_state_id': state_id, 'default_zip': zip, 'default_country_id': country_id, 'default_lang': lang, 'default_user_id': user_id, 'default_type': 'other'}">\n                                <kanban>\n                                    <field name="id"/>\n                                    <field name="color"/>\n                                    <field name="name"/>\n                                    <field name="title"/>\n                                    <field name="type"/>\n                                    <field name="email"/>\n                                    <field name="parent_id"/>\n                                    <field name="is_company"/>\n                                    <field name="function"/>\n                                    <field name="phone"/>\n                                    <field name="street"/>\n                                    <field name="street2"/>\n                                    <field name="zip"/>\n                                    <field name="city"/>\n                                    <field name="country_id"/>\n                                    <field name="mobile"/>\n                                    <field name="state_id"/>\n                                    <field name="image_128"/>\n                                    <field name="lang"/>\n                                    <!-- fields in form x2many view to diminish requests -->\n                                    <field name="comment"/>\n                                    <field name="display_name"/>\n                                    <templates>\n                                        <t t-name="kanban-box">\n                                            <t t-set="color" t-value="kanban_color(record.color.raw_value)"/>\n                                            <div t-att-class="color + (record.title.raw_value == 1 ? ' oe_kanban_color_alert' : '') + ' oe_kanban_global_click'">\n                                                <div class="o_kanban_image">\n                                                    <img alt="Contact image" t-if="record.image_128.raw_value" t-att-src="kanban_image('res.partner', 'image_128', record.id.raw_value)"/>\n                                                    <t t-if="!record.image_128.raw_value">\n                                                        <img alt="Delivery" t-if="record.type.raw_value === 'delivery'" t-att-src="_s + &quot;/base/static/img/truck.png&quot;"/>\n                                                        <img alt="Invoice" t-if="record.type.raw_value === 'invoice'" t-att-src="_s + &quot;/base/static/img/money.png&quot;"/>\n                                                        <t t-if="record.type.raw_value !== 'invoice' &amp;&amp; record.type.raw_value !== 'delivery'">\n                                                            <img alt="Logo" t-if="record.is_company.raw_value === true" t-att-src="_s + &quot;/base/static/img/company_image.png&quot;"/>\n                                                            <img alt="Avatar" t-if="record.is_company.raw_value === false" t-att-src="_s + &quot;/base/static/img/avatar_grey.png&quot;"/>\n                                                        </t>\n                                                    </t>\n                                                </div>\n                                                <div class="oe_kanban_details">\n                                                    <field name="name"/>\n                                                    <div t-if="record.function.raw_value"><field name="function"/></div>\n                                                    <div t-if="record.email.raw_value"><field name="email" widget="email"/></div>\n                                                    <div t-if="record.type.raw_value != 'contact'">\n                                                        <div>\n                                                            <field name="zip"/>\n                                                            <field name="city"/>\n                                                        </div>\n                                                        <field t-if="record.state_id.raw_value" name="state_id"/>\n                                                        <field name="country_id"/>\n                                                    </div>\n                                                    <div t-if="record.phone.raw_value">Phone: <t t-esc="record.phone.value"/></div>\n                                                    <div t-if="record.mobile.raw_value">Mobile: <t t-esc="record.mobile.value"/></div>\n                                                </div>\n                                            </div>\n                                        </t>\n                                    </templates>\n                                </kanban>\n                                <form string="Contact / Address">\n                                    <sheet>\n                                        <!-- parent_id and type fields needed in attrs in base_address_city module which overwrites\n                                        _fields_view_get() of partner. It would be better to put those fields there but the web client\n                                        dosen't support when a field is displayed several times in the same view.-->\n                                        <field name="type" required="1" widget="radio" options="{'horizontal': true}"/>\n                                        <field name="parent_id" invisible="1"/>\n                                        <hr/>\n                                        <group col="12">\n                                            <group colspan="5">\n                                                <field name="name" string="Contact Name" attrs="{'required' : [('type', '=', 'contact')]}"/>\n                                                <field name="title" placeholder="e.g. Mr." attrs="{'invisible': [('type','!=', 'contact')]}"/>\n                                                <field name="function" placeholder="e.g. Sales Director" attrs="{'invisible': [('type','!=', 'contact')]}"/>\n                                                <label for="street" string="Address" attrs="{'invisible': [('type','=', 'contact')]}"/>\n                                                <div attrs="{'invisible': [('type','=', 'contact')]}">\n                                                    <div class="o_address_format" name="div_address">\n                                                        <field name="street" placeholder="Street..." class="o_address_street"/>\n                                                        <field name="street2" placeholder="Street 2..." class="o_address_street"/>\n                                                        <field name="city" placeholder="City" class="o_address_city"/>\n                                                        <field name="state_id" class="o_address_state" placeholder="State" options="{'no_open': True, 'no_quick_create': True}" context="{'country_id': country_id, 'default_country_id': country_id, 'zip': zip}"/>\n                                                        <field name="zip" placeholder="ZIP" class="o_address_zip"/>\n                                                        <field name="country_id" placeholder="Country" class="o_address_country" options="{&quot;no_open&quot;: True, &quot;no_create&quot;: True}"/>\n                                                    </div>\n                                                </div>\n                                                <field name="comment" placeholder="Internal notes..."/>\n                                            </group>\n                                            <group colspan="5">\n                                                <field name="email" widget="email"/>\n                                                <field name="phone" widget="phone"/>\n                                                <field name="mobile" widget="phone"/>\n                                                <field name="company_id" invisible="1"/>\n                                            </group>\n                                            <group colspan="1">\n                                                <field name="image_1920" widget="image" class="oe_avatar" nolabel="1" options="{'image_preview': 'image_128'}"/>\n                                            </group>\n                                        </group>\n                                        <field name="lang" invisible="True"/>\n                                        <field name="user_id" invisible="True"/>\n                                        <field name="image_128" invisible="1"/>\n                                    </sheet>\n                                </form>\n                            </field>\n                        </page>\n                        <page name="sales_purchases" string="Sales &amp; Purchase">\n                            <group name="container_row_2">\n                                <group string="Sales" name="sale" priority="1">\n                                    <field name="user_id" domain="[('share', '=', False)]"/>\n                                </group>\n                                <group string="Purchase" name="purchase" priority="2">\n                                </group>\n                                <group name="misc" string="Misc">\n                                    <field name="ref" string="Reference"/>\n                                    <field name="company_id" groups="base.group_multi_company" options="{'no_create': True}" attrs="{'readonly': [('parent_id', '!=', False)]}" force_save="1"/>\n                                    <field name="industry_id" attrs="{'invisible': [('is_company', '=', False)]}" options="{'no_create': True}"/>\n                                </group>\n                            </group>\n                        </page>\n                        <page name="internal_notes" string="Internal Notes">\n                            <field name="comment" placeholder="Internal note..."/>\n                        </page>\n                    </notebook>\n                </sheet>\n                </form>\n            	base/views/res_partner_views.xml	\N	\N	\N	\N	primary	t	1	2025-08-28 11:31:39.100786	1	2025-08-28 11:31:39.100786	\N

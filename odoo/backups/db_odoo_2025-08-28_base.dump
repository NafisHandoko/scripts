bsite"/></li>\n                    <li t-if="company.vat" class="list-inline-item"><i class="fa fa-building-o" role="img" aria-label="Fiscal number"/><t t-esc="company.country_id.vat_label or 'Tax ID'"/>: <span t-field="company.vat"/></li>\n                </ul>\n                <div t-field="company.report_footer"/>\n                <div t-if="report_type == 'pdf'" class="text-muted">\n                    Page:\n                    <span class="page"/>\n                    of\n                    <span class="topage"/>\n                </div>\n                <div t-if="report_type == 'pdf' and display_name_in_footer" class="text-muted">\n                    <span t-field="o.name"/>\n                </div>\n            </div>\n        </div>\n    </t>\n\n    	web/views/report_templates.xml	\N	\N	\N	\N	primary	t	1	2025-08-28 11:31:55.892008	1	2025-08-28 11:31:55.892008	\N

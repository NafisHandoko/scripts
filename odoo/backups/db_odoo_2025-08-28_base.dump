660	account.bank.statement.search	account.bank.statement	\N	16	search	<?xml version="1.0"?>\n<search string="Search Bank Statements">\n                    <field name="name" string="Bank Statement"/>\n                    <field name="date"/>\n                    <filter string="New" name="draft" domain="[('state','=','open')]"/>\n                    <filter string="Processing" name="processing" domain="[('state','=','posted')]"/>\n                    <filter string="Validated" name="confirmed" domain="[('state','=','confirm')]"/>\n                    <separator/>\n                    <filter name="filter_date" date="date"/>\n                    <field name="journal_id" domain="[('type', 'in', ('bank', 'cash'))]"/>\n                    <group expand="0" string="Group By">\n                        <filter string="Journal" name="journal" context="{'group_by': 'journal_id'}"/>\n                        <filter string="Status" name="status" context="{'group_by': 'state'}"/>\n                        <filter string="Date" name="date" context="{'group_by': 'date'}"/>\n                    </group>\n                </search>\n            	account/views/account_bank_statement_views.xml	\N	\N	\N	\N	primary	t	1	2025-08-28 11:32:28.994214	1	2025-08-28 11:32:28.994214	f
1608	report_yayan_surat_kontrol	\N	ehealth_document.report_yayan_surat_kontrol	16	qweb	<?xml version="1.0"?>\n<t t-name="ehealth_document.report_yayan_surat_kontrol">\n        <t t-set="company" t-value="res_company"/>\n        <t t-call="web.external_layout">\n          <t t-set="o" t-value="o.with_context(lang=lang)"/> \n          <div class="page">\n            <div class="row">\n              <div class="col-md-12">\n                <p class="text-center mt-3 mb-0"><strong>SURAT KETERANGAN KONTROL</strong></p>\n                <p class="text-center">Nomor: <t t-esc="o['name']"/></p>\n                <p class="mt-4">Yang bertanda tangan di bawah ini, dokter di <t t-esc="o['operating_unit_id']['company_id']['name']"/>, menerangkan bahwa:</p>\n                <div class="mt-3 ml-3">\n                    <div class="row">\n                        <div class="col-3">\n                          <t t-if="o['partner_id']['identity_type'] == 'ktp'">NIK</t>\n                          <t t-if="o['partner_id']['identity_type'] == 'sim'">No. SIM</t>\n                          <t t-if="o['partner_id']['identity_type'] == 'paspor'">No. Paspor</t>\n                        </div>\n                        <div class="col-6">: \n                          <t t-if="o['partner_id']['identity_type'] == 'ktp'"><t t-esc="o['partner_id']['nik']"/></t>\n                          <t t-else=""><t t-esc="o['partner_id']['identity_number']"/></t>\n                        </div>\n                    </div>\n                    <div class="row">\n                        <div class="col-3">Nama</div>\n                        <div class="col-6">: <t t-esc="o['partner_id']['name']"/></div>\n                    </div>\n                    <div class="row">\n                        <div class="col-3">Tanggal Lahir</div>\n                        <div class="col-6">: <t t-esc="o['partner_id']['birthDate'].strftime('%d-%m-%Y')"/></div>\n                    </div>\n                    <div class="row">\n                        <div class="col-3">Jenis Kelamin</div>\n                        <div class="col-6">: \n                          <t t-if="o['partner_id']['gender'] == 'male'">Laki-Laki</t>\n                          <t t-else="">Perempuan</t>\n                        </div>\n                    </div>\n                    <div class="row">\n                        <div class="col-3">Pekerjaan</div>\n                        <div class="col-6">: <t t-esc="o['partner_id']['function']"/></div>\n                    </div>\n                    <div class="row">\n                        <div class="col-3">Alamat</div>\n                        <div class="col-6">: <t t-esc="o['partner_id']['street']"/></div>\n                    </div>\n                    <div class="row">\n                        <div class="col-3">Diagnosa</div>\n                        <div class="col-6">: <t t-esc="data['diagnosa']"/></div>\n                    </div>\n                    <t t-if="'medication-req' in data">\n                      <div class="row">\n                        <div class="col-3">Obat</div>\n                        <div class="col-6">\n                          <table style="width: 100%; margin-top: 5px;">\n                            <tbody>\n                             <t t-foreach="data['medication-req']" t-as="med">\n                                <t t-if="isinstance(med, dict) and 'nama-obat' in med and 'dosis' in med">\n                                      <tr>\n                                          <td style="font-weight: bold;"><t t-esc="med['nama-obat']"/></td>\n                                          <td>dosis: <t t-esc="med['dosis']"/></td>\n                                      </tr>\n                                </t>\n                            </t>\n                            </tbody>\n                          </table>\n                        </div>\n                      </div>\n                    </t>\n                </div>\n                <p class="mt-3 mb-2">Bahwa yang bersangkutan telah menjalani pemeriksaan di <t t-esc="o['operating_unit_id']['company_id']['name']"/>. Sehubungan masih dalam perawatan atas sakitnya, mohon kiranya untuk <strong>Kontrol</strong> pada tanggal <strong><t t-esc="data['tanggal-kontrol']"/></strong>.</p>\n                <p>Demikian surat ini dibuat agar dapat digunakan sebagaimana mestinya.</p><br/>\n              </div>\n            </div>\n\n            <div class="row pt-5">\n                <div class="col-8"/>\n                <div class="col-4">\n                    <p class="mb-0"><t t-esc="o['operating_unit_id']['company_id']['city']"/>, <t t-esc="o.to_date_string(data['registration_date'])"/></p>\n                    <p class="mb-0">Dokter Pemeriksa</p>\n                    <img t-att-src="o['qr_code_url']" style="width:125px;height:125px;"/>\n                    <p class="mb-0 mt-2"><strong><t t-esc="data['examiner_name']"/></strong></p>\n                </div>\n            </div>\n          </div>\n        </t>\n      </t>\n    	ehealth_document/report/template_surat_kontrol/report_yayan_surat_kontrol.xml	\N	\N	\N	\N	primary	t	1	2025-08-28 11:34:01.364376	1	2025-08-28 11:34:01.364376	f
661	account.bank.statement.form	account.bank.statement	\N	1	form	<?xml version="1.0"?>\n<form string="Bank Statement">\n                <header>\n                    <button string="Post" states="open" class="oe_highlight" name="button_post" type="object"/>\n                    <button string="Validate" class="oe_highlight" name="button_validate_or_action" type="object" attrs="{'invisible':['|', '|', ('all_lines_reconciled', '=', False), ('line_ids','=',[]), ('state', '!=', 'posted')]}"/>\n                    <button string="Reset to New" name="button_reopen" type="object" attrs="{'invisible': [('state', '!=', 'posted')]}"/>\n                    <button string="Reset to Processing" name="button_reprocess" type="object" attrs="{'invisible': [('state', '!=', 'confirm')]}"/>\n                    <button name="219" string="Take Money In/Out" type="action" class="oe_highlight" attrs="{'invisible': [('journal_type','!=','cash')]}"/>\n                    <field name="state" widget="statusbar" statusbar_visible="open,posted,confirm"/>\n                </header>\n                <div class="alert alert-warning" role="alert" attrs="{'invisible': ['|', ('previous_statement_id', '=', False), ('is_valid_balance_start', '=', True)]}">\n                    The starting balance <b>doesn't match</b> with the ending balance of the previous bank statement.\n                </div>\n                <sheet>\n                    <!-- Invisible fields -->\n                    <field name="all_lines_reconciled" invisible="1"/>\n                    <field name="move_line_count" invisible="1"/>\n                    <field name="country_code" invisible="1"/>\n\n                    <div class="oe_button_box" name="button_box">\n                        <button class="oe_stat_button" name="button_journal_entries" string="Journal Entries" type="object" attrs="{'invisible':[('move_line_count','=', 0)]}" icon="fa-bars"/>\n                    </div>\n\n                    <div class="oe_title oe_inline">\n                        <label for="name" class="oe_edit_only"/>\n                        <h1><field name="name"/></h1>\n                    </div>\n                    <group>\n                        <group>\n                            <field name="previous_statement_id" invisible="1"/>\n                            <field name="is_valid_balance_start" invisible="1"/>\n                            <field name="journal_type" invisible="1"/>\n                            <field name="cashbox_start_id" invisible="1"/>\n                            <field name="cashbox_end_id" invisible="1"/>\n                            <field name="journal_id" domain="[('type', '=', journal_type)]" attrs="{'readonly': [('move_line_count','!=', 0)]}" widget="selection"/>\n                            <field name="date" attrs="{'readonly': [('state', '!=', 'open')]}" options="{'datepicker': {'warn_future': true}}"/>\n                            <field name="company_id" options="{'no_create': True}" groups="base.group_multi_company"/>\n                            <field name="currency_id" invisible="1"/>\n                        </group><group>\n                            <label for="balance_start"/>\n                            <div>\n                                <field name="balance_start" class="oe_inline" attrs="{'readonly': [('state', '=', 'confirm')]}"/>\n                                <button name="open_cashbox_id" attrs="{'invisible': ['|',('state','!=','open'),('journal_type','!=','cash')]}" string="→ Count" type="object" class="oe_edit_only oe_link oe_inline" context="{'balance':'start'}"/>\n                            </div>\n                            <label for="balance_end_real"/>\n                            <div>\n                                <field name="balance_end_real" class="oe_inline" attrs="{'readonly': [('state', '=', 'confirm')]}"/>\n                                <button name="open_cashbox_id" attrs="{'invisible': ['|',('state','!=','open'),('journal_type','!=','cash')]}" string="→ Count" type="object" class="oe_edit_only oe_link oe_inline" context="{'balance':'close'}"/>\n                            </div>\n                        </group>\n                    </group>\n\n                    <notebook>\n                        <page string="Transactions" name="statement_line_ids">\n                            <field name="line_ids" attrs="{'readonly': [('state', '!=', 'open')]}" context="{'default_date': date, 'default_journal_id': journal_id}">\n                                <tree string="Statement lines" editable="bottom" decoration-muted="is_reconciled" limit="500">\n\n                                    <!-- Invisible fields -->\n                                    <field name="company_id" invisible="1"/>\n                                    <field name="state" invisible="1"/>\n                                    <field name="is_reconciled" invisible="1"/>\n                                    <field name="currency_id" invisible="1"/>\n                                    <field name="partner_bank_id" invisible="1"/>\n                                    <field name="country_code" invisible="1"/>\n\n                                    <!-- Visible fields -->\n                                    <field name="sequence" widget="handle"/>\n                                    <field name="date" attrs="{'readonly': [('parent.state', '!=', 'open')]}"/>\n                                    <field name="payment_ref"/>\n                                    <field name="partner_id" attrs="{'readonly': [('parent.state', '!=', 'open')]}" domain="['|', ('parent_id','=', False), ('is_company','=',True)]"/>\n                                    <field name="ref" optional="hidden"/>\n                                    <field name="transaction_type" optional="hidden"/>\n                                    <field name="narration" string="Notes" optional="hidden"/>\n                                    <field name="amount" attrs="{'readonly': [('parent.state', '!=', 'open')]}"/>\n                                    <field name="amount_currency" optional="hidden" groups="base.group_multi_currency" attrs="{'readonly': [('parent.state', '!=', 'open')]}"/>\n                                    <field name="account_number" optional="hidden"/>\n                                    <field name="foreign_currency_id" optional="hidden" groups="base.group_multi_currency" attrs="{'readonly': [('parent.state', '!=', 'open')]}"/>\n\n                                    <!-- Buttons -->\n                                    <button name="button_undo_reconciliation" type="object" attrs="{'invisible': [('is_reconciled', '=', False)], 'column_invisible': [('parent.state', '!=', 'posted')]}" string="Revert reconciliation" icon="fa-undo"/>\n                                </tree>\n                            </field>\n                        </page>\n                    </notebook>\n                    <group class="oe_subtotal_footer oe_right" colspan="2" name="sale_total">\n                        <div class="oe_subtotal_footer_separator oe_inline">\n                            <label for="balance_end"/>\n                        </div>\n                        <field name="balance_end" nolabel="1" class="oe_subtotal_footer_separator"/>\n                    </group>\n                    <div class="oe_clear"/>\n                </sheet>\n                <div class="o_attachment_preview"/>\n                <div class="oe_chatter">\n                    <field name="message_follower_ids"/>\n                    <field name="message_ids"/>\n                </div>\n                </form>\n            	account/views/account_bank_statement_views.xml	\N	\N	\N	\N	primary	t	1	2025-08-28 11:32:28.994214	1	2025-08-28 11:32:28.994214	f
669	account.reconcile.model.form	account.reconcile.model	\N	16	form	<?xml version="1.0"?>\n<form string="Operation Templates">\n                    <field name="active" invisible="1"/>\n                    <sheet>\n                        <div class="oe_button_box" name="button_box">\n                            <button type="object" name="action_reconcile_stat" class="oe_stat_button" icon="fa-book">\n                                <field name="number_entries" string="Journal Entries" widget="statinfo"/>\n                            </button>\n                        </div>\n                        <div class="oe_title">\n                            <label for="name" class="oe_edit_only"/>\n                            <h1><field name="name" placeholder="e.g. Bank Fees"/></h1>\n                        </div>\n                        <group>\n                            <group>\n                                <field name="rule_type" widget="radio"/>\n                                <field name="company_id" groups="base.group_multi_company"/>\n                            </group>\n                            <group>\n                                <field name="auto_reconcile" attrs="{'invisible': [('rule_type', '=', 'writeoff_button')]}"/>\n                                <field name="to_check" attrs="{'invisible': [('rule_type', '!=', 'writeoff_button')]}"/>\n                                <field name="past_months_limit" attrs="{'invisible': [('rule_type', '!=', 'invoice_matching')]}"/>\n                                <field name="matching_order" attrs="{'invisible': [('rule_type', '!=', 'invoice_matching')]}"/>\n                            </group>\n                        </group>\n                        <group string="Conditions on Bank Statement Line">\n                            <group>\n                                <field name="match_journal_ids" options="{'no_create': True}" widget="many2many_tags"/>\n                                <field name="match_nature" widget="radio" attrs="{'invisible': [('rule_type', '=', 'writeoff_button')]}"/>\n                            </group>\n                            <group attrs="{'invisible': [('rule_type', '=', 'writeoff_button')]}">\n                                <label for="match_amount"/>\n                                <div>\n                                    <field name="match_amount" style="width: 30% !important" class="oe_inline"/>\n                                    <span class="o_form_label" style="width: 2% !important">   </span> <!-- Make a little space. -->\n                                    <field name="match_amount_min" style="width: 30% !important;" class="oe_inline" attrs="{'invisible': [('match_amount', 'in', (False, 'lower'))], 'required': [('match_amount', '!=', False)]}"/>\n                                    <span class="o_form_label" attrs="{'invisible': [('match_amount', '!=', 'between')]}">and</span>\n                                    <field name="match_amount_max" style="width: 30% !important;" class="oe_inline" attrs="{'invisible': [('match_amount', 'in', (False, 'greater'))], 'required': [('match_amount', '=', 'between')]}"/>\n                                </div>\n                                <label for="match_label"/>\n                                <div>\n                                    <field name="match_label" style="width: 30% !important" class="oe_inline"/>\n                                    <span class="o_form_label" style="width: 2% !important">   </span> <!-- Make a little space. -->\n                                    <field name="match_label_param" style="width: 68% !important;" class="oe_inline" attrs="{'invisible': [('match_label', '=', False)], 'required': [('match_label', '!=', False)]}"/>\n                                </div>\n                                <label for="match_note"/>\n                                <div>\n                                    <field name="match_note" style="width: 30% !important" class="oe_inline"/>\n                                    <span class="o_form_label" style="width: 2% !important">   </span> <!-- Make a little space. -->\n                                    <field name="match_note_param" style="width: 68% !important;" class="oe_inline" attrs="{'invisible': [('match_note', '=', False)], 'required': [('match_note', '!=', False)]}"/>\n                                </div>\n                                <label for="match_transaction_type"/>\n                                <div>\n                                    <field name="match_transaction_type" style="width: 30% !important" class="oe_inline"/>\n                                    <span class="o_form_label" style="width: 2% !important">   </span> <!-- Make a little space. -->\n                                    <field name="match_transaction_type_param" style="width: 68% !important;" class="oe_inline" attrs="{'invisible': [('match_transaction_type', '=', False)], 'required': [('match_transaction_type', '!=', False)]}"/>\n                                </div>\n                                <field name="match_same_currency" attrs="{'invisible': [('rule_type', '!=', 'invoice_matching')]}"/>\n\n                                <label for="match_total_amount" attrs="{'invisible': [('rule_type', '!=', 'invoice_matching')]}"/>\n                                <div attrs="{'invisible': [('rule_type', '!=', 'invoice_matching')]}">\n                                    <field name="match_total_amount" class="oe_inline"/>\n                                    <field name="match_total_amount_param" class="oe_inline" attrs="{'invisible': [('match_total_amount', '=', False)]}"/>\n                                    <span class="o_form_label oe_inline" attrs="{'invisible': [('match_total_amount', '=', False)]}">%</span>\n                                    <div class="text-muted" attrs="{'invisible': [('match_total_amount', '=', False)]}">\n                                        This parameter will be bypassed in case of a statement line communication matching exactly existing entries\n                                    </div>\n                                </div>\n                            </group>\n                            <group attrs="{'invisible': [('rule_type', '=', 'writeoff_button')]}">\n                                <field name="match_partner" attrs="{'invisible': [('rule_type', '!=', 'writeoff_suggestion')]}"/>\n                                <field name="match_partner" string="Partner Is Set &amp; Matches" attrs="{'invisible': [('rule_type', '!=', 'invoice_matching')]}"/>\n                                <label for="match_partner_ids" class="ml16" attrs="{'invisible': [('match_partner', '=', False)]}"/>\n                                <field name="match_partner_ids" nolabel="1" widget="many2many_tags" attrs="{'invisible': [('match_partner', '=', False)]}"/>\n                                <label for="match_partner_category_ids" class="ml16" attrs="{'invisible': [('match_partner', '=', False)]}"/>\n                                <field name="match_partner_category_ids" nolabel="1" widget="many2many_tags" attrs="{'invisible': [('match_partner', '=', False)]}"/>\n                            </group>\n                            <group attrs="{'invisible': [('rule_type', '!=', 'invoice_matching')]}">\n                                <span class="o_form_label o_td_label">Match Invoice/bill with</span>\n                                <div>\n                                    <span class="o_form_label" style="width: 2% !important">   </span>\n                                    <label for="match_text_location_label" string="Label"/>\n                                    <field name="match_text_location_label"/>\n                                    <span class="o_form_label" style="width: 2% !important">   </span>\n                                    <label for="match_text_location_note" string="Note"/>\n                                    <field name="match_text_location_note"/>\n                                    <span class="o_form_label" style="width: 2% !important">   </span>\n                                    <label for="match_text_location_reference" string="Reference"/>\n                                    <field name="match_text_location_reference"/>\n                                </div>\n                            </group>\n                        </group>\n                        <group string="Counterpart Values" attrs="{'invisible': [('rule_type', '=', 'invoice_matching'), '|', ('match_total_amount', '=', False), '&amp;', ('match_total_amount', '=', True), ('match_total_amount_param', '=', 100.0)]}">\n                           <group>\n                               <field name="show_decimal_separator" invisible="1"/>\n                               <field name="decimal_separator" attrs="{'invisible': [('show_decimal_separator', '=', False)]}" groups="base.group_no_one"/>\n                           </group>\n                            <field name="line_ids" default="{'default_model_id': self, 'default_company_id': self.company_id}" nolabel="1">\n                                <tree editable="bottom">\n                                    <field name="account_id"/>\n                                    <field name="amount_type"/>\n                                    <field name="journal_id" attrs="{'column_invisible': [('parent.rule_type', '!=', 'writeoff_button')]}" optional="hide"/>\n                                    <field name="amount_string"/>\n                                    <field name="tax_ids" widget="many2many_tags" optional="hide"/>\n                                    <field name="analytic_account_id" groups="analytic.group_analytic_accounting" optional="hide"/>\n                                    <field name="analytic_tag_ids" groups="analytic.group_analytic_tags" widget="many2many_tags" optional="hide"/>\n                                    <field name="show_force_tax_included" invisible="1"/>\n                                    <field name="force_tax_included" attrs="{'invisible': [('show_force_tax_included', '=', False)]}" widget="boolean_toggle" optional="hide"/>\n                                    <field name="company_id" invisible="1"/>\n                                    <field name="label"/>\n                                </tree>\n                           </field>\n                       </group>\n\n                       <group string="Partner Mapping" attrs="{'invisible': [('rule_type', 'not in', ('invoice_matching', 'writeoff_suggestion'))]}">\n                           <field name="partner_mapping_line_ids" nolabel="1">\n                               <tree editable="bottom">\n                                   <field name="payment_ref_regex" attrs="{'required': [('narration_regex', '=', False)]}"/>\n                                   <field name="narration_regex" attrs="{'required': [('payment_ref_regex', '=', False)]}"/>\n                                   <field name="partner_id"/>\n                               </tree>\n                           </field>\n                       </group>\n\n                    </sheet>\n                </form>\n            	account/views/account_reconcile_model_views.xml	\N	\N	\N	\N	primary	t	1	2025-08-28 11:32:28.994214	1	2025-08-28 11:32:28.994214	f

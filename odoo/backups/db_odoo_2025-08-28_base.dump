1412	Search Document	ehealth_document.document	\N	16	search	<?xml version="1.0"?>\n<search>\n          <filter string="Today" name="document_today" domain="[('create_date','&gt;=',(context_today()).strftime('%Y-%m-%d'))]"/>\n          <filter string="Date" name="document_date" date="create_date"/>\n          <separator/>\n          <filter string="PCR" name="type_pcr" domain="[('type','=','cov19-swab-pcr')]"/>\n          <filter string="Antigen" name="type_antigen" domain="[('type','=','cov19-swab-antigen')]"/>\n          <filter string="Surat Sehat" name="type_surat_sehat" domain="[('type','=','surat-sehat-template')]"/>\n          <filter string="Surat Sakit" name="type_surat_sakit" domain="[('type','=','surat-sakit-template')]"/>\n          <filter string="Surat Kematian" name="type_surat_kematian" domain="[('type','=','surat-kematian-template')]"/>\n          <filter string="Surat Persetujuan Umum Pasien" name="type_general_consent" domain="[('type','=','general-consent-template')]"/>\n          <filter string="Surat Persetujuan Pasien" name="type_informed_consent" domain="[('type','=','informed-consent-template')]"/>\n          <filter string="Surat Kontrol" name="type_surat_sehat" domain="[('type','=','surat-kontrol-template')]"/>\n          <filter string="Surat Rawat Inap" name="type_surat_sehat" domain="[('type','=','surat-rawat-inap-template')]"/>\n          <filter string="Surat Keterangan HD" name="type_surat_keterangan_hd" domain="[('type','=','surat-keterangan-hd-template')]"/>\n          <filter string="Surat Kelahiran" name="type_informed_consent" domain="[('type','=','surat-kelahiran-template')]"/>\n          <filter string="Surat Rujukan" name="type_informed_consent" domain="[('type','=','surat-rujukan-template')]"/>\n          <filter string="Resume Medis" name="type_surat_sehat" domain="[('type','=','discharge-summary-template')]"/>\n          <filter string="Rekam Medis Hemodialisis" name="type_surat_sehat" domain="[('type','=','hemodialisis-template')]"/>\n          <filter string="Surat Keterangan Dokter" name="type_surat_keterangan_hd" domain="[('type','=','surat-keterangan-dokter-template')]"/>\n          <filter string="Surat Laik Terbang" name="type_surat_laik_terbang" domain="[('type','=','surat-laik-terbang-template')]"/>\n          <filter string="Cabang" name="operating_unit_id" context="{'group_by':'operating_unit_id'}"/>\n          <field name="partner_id" string="Pasien"/>\n          <field name="name" string="Nomor Surat/Lab"/>\n          <field name="operating_unit_id"/>\n          <field name="type"/>\n        </search>\n      	ehealth_document/views/document.xml	\N	\N	\N	\N	primary	t	1	2025-08-28 11:34:01.364376	1	2025-08-28 11:34:01.364376	f
229	user form: add totp status	res.users	\N	16	form	<?xml version="1.0"?>\n<xpath expr="//page[@name='references']/group[1]" position="before">\n                <field name="totp_enabled" invisible="1"/>\n                <group attrs="{'invisible': [('totp_enabled', '!=', False)]}">\n                    <div>\n                        <span class="alert alert-info" role="status">\n                            <i class="fa fa-warning"/>\n                            Two-factor authentication not enabled\n                        </span>\n                    </div>\n                </group>\n                <group attrs="{'invisible': [('totp_enabled', '=', False)]}">\n                    <div>\n                        <span class="text-success">\n                            <i class="fa fa-check-circle"/>\n                            Two-factor authentication enabled\n                        </span>\n                    </div>\n                </group>\n            </xpath>\n        	auth_totp/views/user_preferences.xml	\N	\N	154	\N	extension	t	1	2025-08-28 11:31:57.561907	1	2025-08-28 11:31:57.561907	\N
230	auth_totp wizard	auth_totp.wizard	\N	16	form	<?xml version="1.0"?>\n<form>\n                <sheet>\n                    <div class="row container">\n                        <div class="mb-3">\n                            <h3 class="font-weight-bold">Scan this barcode with your app</h3>\n                            <div>\n                                Scan the image below with the authenticator app on your phone.<br/>\n                                If you cannot scan the barcode, here are some alternative options:\n                                <ul>\n                                    <li><field class="text-wrap" name="url" widget="url" options="{'website_path': True}" text="Click on this link to open your authenticator app"/></li>\n\n                                    <li>Or enter the secret code manually:\n                                        <a data-toggle="collapse" href="#collapseTotpSecret" role="button" aria-expanded="false" aria-controls="collapseTotpSecret">show the code</a>\n                                    </li>\n                                </ul>\n                                <!-- code outside list to have more horiz space on mobile -->\n                                <div class="collapse col-12 col-md-6" id="collapseTotpSecret">\n                                  <div class="card card-body">\n                                    <h3>Your two-factor secret:</h3>\n                                    <code class="text-center"><field name="secret"/></code>\n                                  </div>\n                                </div>\n                            </div>\n\n                            <field class="offset-1" name="qrcode" readonly="True" widget="image"/>\n\n                            <h3 class="font-weight-bold">Enter the 6-digit code from your app</h3>\n                            <div class="text-justify col-10 col-lg-6 px-0">\n                                After scanning the barcode, the app will display a 6-digit code that you\n                                should enter below. Don't worry if the code changes in the app,\n                                it stays valid a bit longer.\n                            </div>\n                            <div class="mt-2">\n                                <label for="code" class="col-4 col-md-12 px-0">Verification Code</label>\n                                <field required="True" name="code" class="col-10 col-md-6 px-0"/>\n                            </div>\n\n                        </div>\n                    </div>\n                </sheet>\n                <footer>\n                    <button type="object" name="enable" class="btn btn-primary" string="Enable two-factor authentication"/>\n                    <button string="Cancel" special="cancel"/>\n                </footer>\n            </form>\n        	auth_totp/views/user_preferences.xml	\N	\N	\N	\N	primary	t	1	2025-08-28 11:31:57.561907	1	2025-08-28 11:31:57.561907	\N
231	users preference: totp	res.users	\N	16	form	<?xml version="1.0"?>\n<button name="preference_change_password" position="after">\n                    <field name="totp_enabled" invisible="1"/>\n                    <group attrs="{'invisible': [('totp_enabled', '!=', False)]}">\n                        <div>\n                            <span class="alert alert-info" role="status">\n                                <i class="fa fa-warning"/>\n                                Two-factor authentication not enabled\n                                <a href="https://www.odoo.com/documentation/14.0/applications/general/auth/2fa.html" title="What is this?" class="o_doc_link" target="_blank"/>\n                            </span>\n                            <button name="totp_enable_wizard" type="object" string="Enable two-factor authentication" class="btn btn-info mx-3"/>\n                        </div>\n                    </group>\n                    <group attrs="{'invisible': [('totp_enabled', '=', False)]}">\n                        <div>\n                            <span class="text-success">\n                                <i class="fa fa-check-circle"/>\n                                Two-factor authentication enabled\n                                <a href="https://www.odoo.com/documentation/14.0/applications/general/auth/2fa.html" title="What is this?" class="o_doc_link" target="_blank"/>\n                            </span>\n                            <button name="totp_disable" type="object" string="(Disable two-factor authentication)" class="btn btn-link text-muted"/>\n                        </div>\n                        <div colspan="2" attrs="{'invisible': [('totp_trusted_device_ids', '=', [])]}">\n                            <field name="totp_trusted_device_ids" nolabel="1" colspan="4" readonly="1">\n\n                                <tree create="false" delete="false">\n                                    <field name="name" string="Trusted Devices"/>\n                                    <field name="create_date" string="Added On"/>\n                                    <button type="object" name="remove" icon="fa-trash"/>\n                                </tree>\n                                <form string="Trusted Device">\n                                    <group>\n                                        <group>\n                                            <field name="name" string="Device Name"/>\n                                            <field name="create_date" string="Added On"/>\n                                        </group>\n                                    </group>\n                                    <footer>\n                                        <button name="remove" string="Revoke" type="object" icon="fa-trash"/>\n                                        <button name="preference_cancel" string="Cancel" special="cancel" class="btn-secondary"/>\n                                    </footer>\n                                </form>\n\n                            </field>\n                            <button name="revoke_all_devices" string="Revoke All" type="object" class="btn btn-secondary" confirm="Are you sure? Two-factor authentication will be required again on all your devices"/>\n                        </div>\n                    </group>\n            </button>\n        	auth_totp/views/user_preferences.xml	\N	\N	161	\N	extension	t	1	2025-08-28 11:31:57.561907	1	2025-08-28 11:31:57.561907	\N

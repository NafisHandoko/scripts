623	account.move.kanban	account.move	\N	16	kanban	<?xml version="1.0"?>\n<kanban class="o_kanban_mobile" sample="1">\n                    <field name="journal_id"/>\n                    <field name="partner_id"/>\n                    <field name="ref"/>\n                    <field name="date"/>\n                    <field name="state"/>\n                    <templates>\n                        <t t-name="kanban-box">\n                            <div t-attf-class="oe_kanban_global_click">\n                                <div class="row mb4">\n                                    <div class="col-6 o_kanban_record_headings">\n                                        <strong>\n                                            <span>\n                                                <field name="partner_id" attrs="{'invisible': [('partner_id', '=', False)]}"/>\n                                                <field name="journal_id" attrs="{'invisible': [('partner_id', '!=', False)]}"/>\n                                            </span>\n                                        </strong>\n                                    </div>\n                                    <div class="col-6 text-right">\n                                        <strong><i class="fa fa-clock-o" aria-label="Date" role="img" title="Date"/> <t t-esc="record.date.value"/></strong>\n                                    </div>\n                                </div>\n                                <div class="row">\n                                    <div class="col-12">\n                                        <span><field name="ref"/></span>\n                                    </div>\n                                </div>\n                                <div class="row">\n                                    <div class="col-6">\n                                        <span><field name="amount_total" widget="monetary"/></span>\n                                        <span><field name="currency_id" invisible="1"/></span>\n                                    </div>\n                                    <div class="col-6">\n                                        <span class="float-right">\n                                            <field name="state" widget="label_selection" options="{'classes': {'draft': 'default', 'posted': 'success'}}"/>\n                                        </span>\n                                    </div>\n                                </div>\n                            </div>\n                        </t>\n                    </templates>\n                </kanban>\n            	account/views/account_move_views.xml	\N	\N	\N	\N	primary	t	1	2025-08-28 11:32:28.994214	1	2025-08-28 11:32:28.994214	f
1567	report_praktekbidandwi_surat_sakit	\N	ehealth_document.report_praktekbidandwi_surat_sakit	16	qweb	<?xml version="1.0"?>\n<t t-name="ehealth_document.report_praktekbidandwi_surat_sakit">\n        <t t-set="company" t-value="res_company"/>\n        <t t-call="ehealth_document.header_praktekbidandwi_document"> \n          <div class="page">\n            <div class="row">\n              <div class="col-md-12" style="margin-top: 100px;">\n                <p class="text-center mt-5 mb-0" style="font-size: 1.2em; text-decoration: underline;"><b>SURAT KETERANGAN</b></p>\n                <p class="mt-4">Yang bertanda tangan di bawah ini menerangkan bahwa:</p>\n                <div class="mt-3">\n                    <div class="row">\n                        <div class="col-3">Nama</div>\n                        <div class="col-6">: <t t-esc="o['partner_id']['name']"/></div>\n                    </div>\n                    <div class="row">\n                        <div class="col-3">Umur</div>\n                        <div class="col-6">: <t t-esc="o.count_age(o['partner_id']['birthDate'].strftime('%d/%m/%Y'))"/></div>\n                    </div>\n                    <div class="row">\n                        <div class="col-3">Pekerjaan</div>\n                        <div class="col-6">: <t t-esc="o['partner_id']['function']"/></div>\n                    </div>\n                    <div class="row">\n                        <div class="col-3">Alamat</div>\n                        <div class="col-6">: <t t-esc="o['partner_id']['street']"/></div>\n                    </div>\n                </div>\n                <p class="mt-3 mb-2">Berdasarkan pemeriksaan, orang tersebut di atas perlu diberikan istirahat karena sakit selama <strong><t t-esc="o.count_date_delta(data['tanggal-awal'],data['tanggal-akhir'])"/> hari</strong> terhitung <br/> dari tanggal <strong><t t-esc="data['tanggal-awal']"/></strong> s/d <strong><t t-esc="data['tanggal-akhir']"/></strong>.</p>\n                <p>Demikianlah Surat Keterangan ini untuk dapat dipergunakan seperlunya.</p><br/>\n              </div>\n            </div>\n\n            <div class="row pt-5">\n                <div class="col-1"/>\n                <div class="col-3 mt-4">\n                    <p class="mb-0">Validasi</p>\n                    <div class="mt-3" id="qrcode">\n                        <img t-att-src="o['qr_code_url']" style="width:125px;height:125px;"/>\n                    </div>\n                </div>\n                <div class="col-4"/>\n                <div class="col-4">\n                    <p class="mb-0"><t t-esc="o['operating_unit_id']['company_id']['city']"/>, <t t-esc="o.to_date_string(data['registration_date'])"/></p>\n                    <p class="mb-0">Pemeriksa</p>\n                    <div class="mt-3" id="qrcode">\n                        <!-- <t t-if="'qr_code_examiner_url' in data"> -->\n                          <!-- <img t-att-src="data['qr_code_examiner_url']" style="width:125px;height:125px;"/> -->\n                        <!-- </t> -->\n                        <!-- <t t-else=""> -->\n                          <div style="width:125px;height:125px;"/>\n                        <!-- </t> -->\n                    </div>\n                    <p class="mb-0 mt-2"><strong>\n                    <t t-if="'examiner_name' in data">\n                      <t t-esc="data['examiner_name']"/>\n                    </t>\n                    <t t-else="">\n                      <t t-esc="data['sender']"/>\n                    </t>\n                    </strong></p>\n                </div>\n            </div>\n          </div>\n        </t>\n      </t>\n    	ehealth_document/report/template_surat_sakit/report_praktekbidandwi_surat_sakit.xml	\N	\N	\N	\N	primary	t	1	2025-08-28 11:34:01.364376	1	2025-08-28 11:34:01.364376	f
624	account.move.form	account.move	\N	16	form	<?xml version="1.0"?>\n<form string="Account Entry">\n                    <header>\n                        <!-- Post -->\n                        <button name="action_post" string="Post" class="oe_highlight" type="object" groups="account.group_account_invoice" attrs="{'invisible': ['|', '|', ('state', '!=', 'draft'), ('auto_post', '=', True), ('move_type', '!=', 'entry')]}"/>\n                        <button name="action_post" string="Confirm" class="oe_highlight" type="object" groups="account.group_account_invoice" attrs="{'invisible': ['|', '|', ('state', '!=', 'draft'), ('auto_post', '=', True), ('move_type', '=', 'entry')]}"/>\n                        <!-- Send (only invoices) -->\n                        <button name="action_invoice_sent" type="object" string="Send &amp; Print" attrs="{'invisible':['|', '|', ('state', '!=', 'posted'), ('is_move_sent', '=', True), ('move_type', 'not in', ('out_invoice', 'out_refund'))]}" class="oe_highlight"/>\n                        <button name="action_invoice_sent" type="object" string="Send &amp; Print" attrs="{'invisible':['|', '|', ('state', '!=', 'posted'), ('is_move_sent', '=', False), ('move_type', 'not in', ('out_invoice', 'out_refund', 'in_invoice', 'in_refund'))]}"/>\n                        <!-- Register Payment (only invoices / receipts) -->\n                        <button name="action_register_payment" id="account_invoice_payment_btn" type="object" class="oe_highlight" attrs="{'invisible': ['|', '|', ('state', '!=', 'posted'), ('payment_state', 'not in', ('not_paid', 'partial')), ('move_type', 'not in', ('out_invoice', 'out_refund', 'in_invoice', 'in_refund', 'out_receipt', 'in_receipt'))]}" context="{'dont_redirect_to_payments': True}" string="Register Payment" groups="account.group_account_invoice"/>\n                        <!-- Preview (only customer invoices) -->\n                        <button name="preview_invoice" type="object" string="Preview" attrs="{'invisible': [('move_type', 'not in', ('out_invoice', 'out_refund'))]}"/>\n                        <!-- Reverse -->\n                        <button name="196" string="Reverse Entry" type="action" groups="account.group_account_invoice" attrs="{'invisible': ['|', ('move_type', '!=', 'entry'), '|', ('state', '!=', 'posted'), ('payment_state', '=', 'reversed')]}"/>\n                        <button name="action_reverse" string="Add Credit Note" type="object" groups="account.group_account_invoice" attrs="{'invisible': ['|', ('move_type', 'not in', ('out_invoice', 'in_invoice')), ('state', '!=', 'posted')]}"/>\n                        <!-- Cancel -->\n                        <button name="button_cancel" string="Cancel Entry" type="object" groups="account.group_account_invoice" attrs="{'invisible' : ['|', ('id', '=', False), ('state', '!=', 'draft')]}"/>\n                        <button name="button_draft" string="Reset to Draft" type="object" groups="account.group_account_invoice" attrs="{'invisible' : [('show_reset_to_draft_button', '=', False)]}"/>\n                        <field name="state" widget="statusbar" statusbar_visible="draft,posted"/>\n                    </header>\n                    <!-- Invoice outstanding credits -->\n                    <div groups="account.group_account_invoice,account.group_account_readonly" class="alert alert-warning" role="alert" style="margin-bottom:0px;" attrs="{'invisible': ['|', ('state', '!=', 'draft'), ('tax_lock_date_message', '=', False)]}">\n                        <field name="tax_lock_date_message" nolabel="1"/>\n                    </div>\n                    <div groups="account.group_account_invoice,account.group_account_readonly" class="alert alert-info" role="alert" style="margin-bottom:0px;" attrs="{'invisible': ['|', '|', ('move_type', 'not in', ('out_invoice', 'out_refund')), ('invoice_has_outstanding', '=', False), ('payment_state', 'not in', ('not_paid', 'partial'))]}">\n                        You have <bold><a class="alert-link" href="#outstanding" role="button">outstanding payments</a></bold> for this customer. You can allocate them to mark this invoice as paid.\n                    </div>\n                    <div groups="account.group_account_invoice,account.group_account_readonly" class="alert alert-info" role="alert" style="margin-bottom:0px;" attrs="{'invisible': ['|', '|', ('move_type', 'not in', ('in_invoice', 'in_refund')), ('invoice_has_outstanding', '=', False), ('payment_state', 'not in', ('not_paid', 'partial'))]}">\n                        You have <bold><a class="alert-link" href="#outstanding" role="button">outstanding debits</a></bold> for this vendor. You can allocate them to mark this bill as paid.\n                    </div>\n                    <div class="alert alert-info" role="alert" style="margin-bottom:0px;" attrs="{'invisible': ['|', ('state', '!=', 'draft'), ('auto_post', '=', False)]}">\n                        This move is configured to be posted automatically at the accounting date: <field name="date" readonly="1"/>.\n                    </div>\n                    <sheet>\n                        <div name="button_box" class="oe_button_box">\n                            <button name="open_reconcile_view" class="oe_stat_button" icon="fa-bars" type="object" attrs="{'invisible': ['|', '|', ('move_type', '!=', 'entry'), ('id', '=', False), ('has_reconciled_entries', '=', False)]}" string="Reconciled Entries">\n                            </button>\n                        </div>\n\n                        <!-- Payment status for invoices / receipts -->\n                        <widget name="web_ribbon" title="Paid" attrs="{'invisible': ['|', ('payment_state', '!=', 'paid'), ('move_type', 'not in', ('out_invoice', 'out_refund', 'in_invoice', 'in_refund', 'out_receipt', 'in_receipt'))]}"/>\n                        <widget name="web_ribbon" title="In Payment" attrs="{'invisible': ['|', ('payment_state', '!=', 'in_payment'), ('move_type', 'not in', ('out_invoice', 'out_refund', 'in_invoice', 'in_refund', 'out_receipt', 'in_receipt'))]}"/>\n                        <widget name="web_ribbon" title="Partial" attrs="{'invisible': ['|', ('payment_state', '!=', 'partial'), ('move_type', 'not in', ('out_invoice', 'out_refund', 'in_invoice', 'in_refund', 'out_receipt', 'in_receipt'))]}"/>\n                        <widget name="web_ribbon" title="Reversed" bg_color="bg-danger" attrs="{'invisible': [('payment_state', '!=', 'reversed')]}"/>\n                         <widget name="web_ribbon" text="Invoicing App Legacy" bg_color="bg-info" attrs="{'invisible': [('payment_state', '!=', 'invoicing_legacy')]}" tooltip="This entry has been generated through the Invoicing app, before installing Accounting. It has been disabled by the 'Invoicing Switch Threshold Date' setting so that it does not impact your accounting."/>\n\n                        <!-- Invisible fields -->\n                        <field name="id" invisible="1"/>\n                        <field name="show_name_warning" invisible="1"/>\n                        <field name="posted_before" invisible="1"/>\n                        <field name="move_type" invisible="1"/>\n                        <field name="payment_state" invisible="1" force_save="1"/>\n                        <field name="invoice_filter_type_domain" invisible="1"/>\n                        <field name="suitable_journal_ids" invisible="1"/>\n                        <field name="company_currency_id" invisible="1"/>\n                        <field name="commercial_partner_id" invisible="1"/>\n                        <field name="bank_partner_id" invisible="1"/>\n                        <field name="display_qr_code" invisible="1"/>\n                        <field name="show_reset_to_draft_button" invisible="1"/>\n\n                        <field name="invoice_has_outstanding" invisible="1"/>\n                        <field name="is_move_sent" invisible="1"/>\n                        <field name="invoice_has_matching_suspense_amount" invisible="1"/>\n                        <field name="has_reconciled_entries" invisible="1"/>\n                        <field name="restrict_mode_hash_table" invisible="1"/>\n                        <field name="country_code" invisible="1"/>\n\n                        <div class="oe_title">\n                            <!-- Invoice draft header -->\n                            <span class="o_form_label"><field name="move_type" attrs="{'invisible': [('move_type', '=', 'entry')]}" readonly="1" nolabel="1"/></span>\n                            <h1>\n                                <span attrs="{'invisible': ['|', ('state', '!=', 'draft'), ('name', '!=', '/')]}">Draft</span>\n                            </h1>\n\n                            <!-- Number -->\n                            <span class="text-warning" attrs="{'invisible': [('show_name_warning', '=', False)]}">The current highest number is <field name="highest_name"/>. You might want to put a higher number here.</span>\n                            <h1 class="mt0" attrs="{'invisible':[('name', '=', '/'), ('posted_before', '=', False)]}">\n                                <field name="name" attrs="{'readonly': [('state', '!=', 'draft')]}" placeholder="JRNL/2016/00001"/>\n                            </h1>\n\n                        </div>\n                        <group>\n                            <group id="header_left_group">\n                                <div class="o_td_label">\n                                    <label for="partner_id" string="Customer" style="font-weight:bold;" attrs="{'invisible': [('move_type', 'not in', ('out_invoice', 'out_refund', 'out_receipt'))]}"/>\n                                    <label for="partner_id" string="Vendor" style="font-weight:bold;" attrs="{'invisible': [('move_type', 'not in', ('in_invoice', 'in_refund', 'in_receipt'))]}"/>\n                                </div>\n                                <field name="partner_id" widget="res_partner_many2one" nolabel="1" context="{                                             'res_partner_search_mode': (context.get('default_move_type', 'entry') in ('out_invoice', 'out_refund', 'out_receipt') and 'customer') or (context.get('default_move_type', 'entry') in ('in_invoice', 'in_refund', 'in_receipt') and 'supplier') or False,                                             'show_address': 1, 'default_is_company': True, 'show_vat': True}" options="{&quot;always_reload&quot;: True, &quot;no_quick_create&quot;: True}" attrs="{'invisible': [('move_type', 'not in', ('out_invoice', 'out_refund', 'in_invoice', 'in_refund', 'out_receipt', 'in_receipt'))]}"/>\n                                <label for="ref" string="Bill Reference" attrs="{'invisible':[('move_type', 'not in', ('in_invoice', 'in_receipt', 'in_refund'))]}"/>\n                                <field name="ref" nolabel="1" attrs="{'invisible':[('move_type', 'not in', ('in_invoice', 'in_receipt', 'in_refund'))]}"/>\n                                <field name="ref" attrs="{'invisible':[('move_type', 'in', ('in_invoice', 'in_receipt', 'in_refund', 'out_invoice', 'out_refund'))]}"/>\n                                <field name="payment_reference" attrs="{'invisible': [('move_type', 'not in', ('out_invoice', 'out_refund', 'in_invoice', 'in_refund', 'out_receipt', 'in_receipt'))], 'readonly': [('state', '!=', 'draft')]}"/>\n                                <field name="partner_bank_id" context="{'default_partner_id': bank_partner_id}" domain="[('partner_id', '=', bank_partner_id)]" attrs="{'invisible': [('move_type', 'not in', ('in_invoice', 'in_refund', 'in_receipt'))], 'readonly': [('state', '!=', 'draft')]}"/>\n                                <label name="invoice_vendor_bill_id_label" for="invoice_vendor_bill_id" string="Auto-Complete" class="oe_edit_only" attrs="{'invisible': ['|', ('state', '!=', 'draft'), ('move_type', '!=', 'in_invoice')]}"/>\n                                <field name="invoice_vendor_bill_id" nolabel="1" class="oe_edit_only" attrs="{'invisible': ['|', ('state', '!=', 'draft'), ('move_type', '!=', 'in_invoice')]}" domain="[('company_id', '=', company_id), ('partner_id','child_of', [partner_id]), ('move_type','=','in_invoice')]" placeholder="Select an old vendor bill" options="{'no_create': True}" context="{'show_total_amount': True}"/>\n                            </group>\n                            <group id="header_right_group">\n                                <!-- Invoice date (only invoices / receipts) -->\n                                <div class="o_td_label">\n                                    <label for="invoice_date" string="Invoice Date" style="font-weight:bold;" attrs="{'invisible': [('move_type', 'not in', ('out_invoice', 'out_refund', 'out_receipt'))]}"/>\n                                    <label for="invoice_date" string="Bill Date" style="font-weight:bold;" attrs="{'invisible': [('move_type', 'not in', ('in_invoice', 'in_refund', 'in_receipt'))]}"/>\n                                </div>\n                                <field name="invoice_date" nolabel="1" options="{'datepicker': {'warn_future': true}}" attrs="{'invisible': [('move_type', 'not in', ('out_invoice', 'out_refund', 'in_invoice', 'in_refund', 'out_receipt', 'in_receipt'))]}"/>\n\n                                <field name="date" string="Accounting Date" attrs="{                                             'invisible': [('move_type', 'in', ('out_invoice', 'out_refund', 'out_receipt'))],                                             'readonly': [('state', '!=', 'draft')],                                        }"/>\n\n                                <!-- Invoice payment terms (only invoices) + due date (only invoices / receipts) -->\n                                <label for="invoice_payment_term_id" string="Due Date" attrs="{'invisible': [('move_type', 'not in', ('out_invoice', 'out_refund', 'in_invoice', 'in_refund', 'out_receipt', 'in_receipt'))]}"/>\n                                <div class="d-flex" attrs="{'invisible': [('move_type', 'not in', ('out_invoice', 'out_refund', 'in_invoice', 'in_refund', 'out_receipt', 'in_receipt'))]}">\n                                    <field name="invoice_date_due" force_save="1" placeholder="Date" attrs="{'invisible': [('invoice_payment_term_id', '!=', False)]}"/>\n                                    <span class="o_form_label mx-3 oe_edit_only" attrs="{'invisible': ['|', ('state', '!=', 'draft'), ('invoice_payment_term_id', '!=', False)]}"> or </span>\n                                    <field name="invoice_payment_term_id" placeholder="Terms"/>\n                                </div>\n\n                                <label for="journal_id" groups="account.group_account_readonly" invisible="context.get('default_journal_id') and context.get('move_type', 'entry') != 'entry'"/>\n                                <div name="journal_div" class="d-flex" invisible="context.get('default_journal_id') and context.get('move_type', 'entry') != 'entry'" groups="account.group_account_readonly">\n                                    <field name="journal_id" options="{'no_create': True}" attrs="{'readonly': [('posted_before', '=', True)]}"/>\n                                    <span class="oe_inline o_form_label mx-3 oe_read_only" groups="base.group_multi_currency"> in </span>\n                                    <!-- Bigger margin on the left because in edit mode the external link button covers the text -->\n                                    <span class="oe_inline o_form_label mr-3 ml-5 oe_edit_only" groups="base.group_multi_currency"> in </span>\n                                    <field name="currency_id" groups="base.group_multi_currency" attrs="{'readonly': [('state', '!=', 'draft')]}"/>\n                                </div>\n\n                                <field name="currency_id" attrs="{'readonly': [('state', '!=', 'draft')]}" groups="!account.group_account_readonly,base.group_multi_currency"/>\n\n                            </group>\n                        </group>\n                        <notebook>\n                            <page id="invoice_tab" string="Invoice Lines" attrs="{'invisible': [('move_type', '=', 'entry')]}">\n                                <field name="invoice_line_ids" widget="section_and_note_one2many" mode="tree,kanban" context="{'default_move_type': context.get('default_move_type'), 'journal_id': journal_id, 'default_partner_id': commercial_partner_id, 'default_currency_id': currency_id or company_currency_id}">\n                                    <tree editable="bottom" string="Journal Items" default_order="sequence, date desc, move_name desc, id">\n                                        <control>\n                                            <create name="add_line_control" string="Add a line"/>\n                                            <create name="add_section_control" string="Add a section" context="{'default_display_type': 'line_section'}"/>\n                                            <create name="add_note_control" string="Add a note" context="{'default_display_type': 'line_note'}"/>\n                                        </control>\n\n                                        <!-- Displayed fields -->\n                                        <field name="sequence" widget="handle"/>\n                                        <field name="move_name" invisible="1"/>\n                                        <field name="product_id" optional="show" domain="                                                     context.get('default_move_type') in ('out_invoice', 'out_refund', 'out_receipt')                                                     and [('sale_ok', '=', True), '|', ('company_id', '=', False), ('company_id', '=', parent.company_id)]                                                     or [('purchase_ok', '=', True), '|', ('company_id', '=', False), ('company_id', '=', parent.company_id)]                                                "/>\n                                        <field name="name" widget="section_and_note_text" attrs="{'required': [('parent.move_type', 'not in', ('in_invoice', 'in_refund','in_receipt'))]}"/>\n                                        <field name="account_id" groups="account.group_account_readonly" options="{'no_create': True}" domain="[('deprecated', '=', False), ('user_type_id.type', 'not in', ('receivable', 'payable')), ('company_id', '=', parent.company_id), ('is_off_balance', '=', False)]" attrs="{'required': [('display_type', '=', False)]}"/>\n                                        <field name="analytic_account_id" domain="['|', ('company_id', '=', False), ('company_id', '=', parent.company_id)]" groups="analytic.group_analytic_accounting" optional="show"/>\n                                        <field name="analytic_tag_ids" domain="['|', ('company_id', '=', False), ('company_id', '=', parent.company_id)]" groups="analytic.group_analytic_tags" optional="show" widget="many2many_tags"/>\n                                        <field name="quantity"/>\n                                        <field name="product_uom_category_id" invisible="1"/>\n                                        <field name="product_uom_id" string="UoM" groups="uom.group_uom" optional="show"/>\n                                        <field name="price_unit" string="Price"/>\n                                        <field name="discount" string="Disc.%" optional="hide"/>\n                                        <field name="tax_ids" widget="many2many_tags" domain="[('type_tax_use', '=?', parent.invoice_filter_type_domain), ('company_id', '=', parent.company_id)]" context="{'append_type_to_tax_name': not parent.invoice_filter_type_domain}" options="{'no_create': True}" optional="show"/>\n                                        <field name="price_subtotal" string="Subtotal" groups="account.group_show_line_subtotals_tax_excluded"/>\n                                        <field name="price_total" string="Total" groups="account.group_show_line_subtotals_tax_included"/>\n\n                                        <!-- Others fields -->\n                                        <field name="partner_id" invisible="1"/>\n                                        <field name="amount_currency" invisible="1"/>\n                                        <field name="currency_id" invisible="1"/>\n                                        <field name="debit" invisible="1"/>\n                                        <field name="credit" invisible="1"/>\n                                        <field name="date" invisible="1"/>\n                                        <field name="date_maturity" invisible="1"/>\n\n                                        <field name="tax_line_id" invisible="1"/>\n                                        <field name="tax_repartition_line_id" invisible="1"/>\n                                        <field name="tax_tag_ids" invisible="1"/>\n                                        <field name="tax_base_amount" invisible="1"/>\n                                        <field name="tax_exigible" invisible="1"/>\n                                        <field name="company_id" invisible="1"/>\n                                        <field name="company_currency_id" invisible="1"/>\n                                        <field name="recompute_tax_line" invisible="1" force_save="1"/>\n                                        <field name="display_type" force_save="1" invisible="1"/>\n                                        <field name="is_rounding_line" invisible="1"/>\n                                        <field name="exclude_from_invoice_tab" invisible="1"/>\n                                        <field name="account_internal_type" invisible="1"/>\n                                        <field name="account_internal_group" invisible="1"/>\n                                    </tree>\n                                    <kanban class="o_kanban_mobile">\n                                        <!-- Displayed fields -->\n                                        <field name="name"/>\n                                        <field name="product_id"/>\n                                        <field name="price_subtotal" groups="account.group_show_line_subtotals_tax_excluded"/>\n                                        <field name="price_total" groups="account.group_show_line_subtotals_tax_included"/>\n                                        <field name="quantity"/>\n                                        <field name="product_uom_category_id" invisible="1"/>\n                                        <field name="product_uom_id" groups="uom.group_uom"/>\n                                        <field name="price_unit"/>\n                                        <templates>\n                                            <t t-name="kanban-box">\n                                                <div t-attf-class="oe_kanban_card oe_kanban_global_click {{ record.display_type.raw_value ? 'o_is_' + record.display_type.raw_value : '' }}">\n                                                    <t t-if="!record.display_type.raw_value">\n                                                        <div class="row">\n                                                            <div class="col-2">\n                                                                <img t-att-src="kanban_image('product.product', 'image_128', record.product_id.raw_value)" t-att-title="record.product_id.value" t-att-alt="record.product_id.value" style="max-width: 100%;"/>\n                                                            </div>\n                                                            <div class="col-10">\n                                                                <strong>\n                                                                    <span>\n                                                                        <t t-esc="record.product_id.value"/>\n                                                                    </span>\n                                                                </strong>\n                                                                <div class="text-muted">\n                                                                    Quantity:\n                                                                    <t t-esc="record.quantity.value"/>\n                                                                    <t t-esc="record.product_uom_id.value"/>\n                                                                </div>\n                                                                <div class="text-muted">\n                                                                    Unit Price:\n                                                                    <t t-esc="record.price_unit.value"/>\n                                                                </div>\n                                                                <strong>\n                                                                    <span class="float-right text-right">\n                                                                        <t t-esc="record.price_subtotal.value" groups="account.group_show_line_subtotals_tax_excluded"/>\n                                                                        <t t-esc="record.price_total.value" groups="account.group_show_line_subtotals_tax_included"/>\n                                                                    </span>\n                                                                </strong>\n                                                            </div>\n                                                        </div>\n                                                    </t>\n                                                    <t t-if="record.display_type.raw_value === 'line_section' || record.display_type.raw_value === 'line_note'">\n                                                        <div class="row">\n                                                            <div class="col-12">\n                                                                <span>\n                                                                    <t t-esc="record.name.value"/>\n                                                                </span>\n                                                            </div>\n                                                        </div>\n                                                    </t>\n                                                </div>\n                                            </t>\n                                        </templates>\n\n                                        <!-- Others fields -->\n                                        <field name="partner_id" invisible="1"/>\n                                        <field name="amount_currency" invisible="1"/>\n                                        <field name="currency_id" invisible="1"/>\n                                        <field name="debit" invisible="1"/>\n                                        <field name="credit" invisible="1"/>\n                                        <field name="date" invisible="1"/>\n                                        <field name="date_maturity" invisible="1"/>\n\n                                        <field name="tax_line_id" invisible="1"/>\n                                        <field name="tax_repartition_line_id" invisible="1"/>\n                                        <field name="tax_tag_ids" invisible="1"/>\n                                        <field name="tax_base_amount" invisible="1"/>\n                                        <field name="tax_exigible" invisible="1"/>\n                                        <field name="company_id" invisible="1"/>\n                                        <field name="company_currency_id" invisible="1"/>\n                                        <field name="recompute_tax_line" invisible="1" force_save="1"/>\n                                        <field name="display_type" force_save="1" invisible="1"/>\n                                        <field name="is_rounding_line" invisible="1"/>\n                                        <field name="exclude_from_invoice_tab" invisible="1"/>\n                                        <field name="account_internal_type" invisible="1"/>\n                                        <field name="account_internal_group" invisible="1"/>\n                                    </kanban>\n\n                                    <!-- Form view to cover mobile use -->\n                                    <form>\n                                        <sheet>\n                                            <field name="product_uom_category_id" invisible="1"/>\n                                            <field name="display_type" invisible="1"/>\n                                            <field name="parent_state" invisible="1"/>\n                                            <group>\n                                                <field name="partner_id" invisible="1"/>\n                                                <field name="company_id" invisible="1"/>\n                                                <field name="debit" invisible="1"/>\n                                                <field name="credit" invisible="1"/>\n                                                <field name="product_id" widget="many2one_barcode"/>\n                                                <field name="quantity"/>\n                                                <field name="product_uom_id" groups="uom.group_uom"/>\n                                                <field name="price_unit"/>\n                                                <field name="discount" string="Disc.%"/>\n                                                <field name="currency_id" invisible="1"/>\n                                            </group>\n                                            <group>\n                                                <field name="analytic_tag_ids" groups="analytic.group_analytic_tags" widget="many2many_tags"/>\n                                                <field name="account_id" options="{'no_create': True}" domain="[('company_id', '=', company_id)]" readonly="1"/>\n                                                <field name="tax_ids" widget="many2many_tags"/>\n                                                <field name="analytic_account_id" groups="analytic.group_analytic_accounting"/>\n                                            </group>\n                                            <label for="name" string="Description" attrs="{'invisible': [('display_type', '!=', False)]}"/>\n                                            <label for="name" string="Section" attrs="{'invisible': [('display_type', '!=', 'line_section')]}"/>\n                                            <label for="name" string="Note" attrs="{'invisible': [('display_type', '!=', 'line_note')]}"/>\n                                            <field name="name" widget="text"/>\n                                            <group>\n                                                <field name="price_subtotal" string="Subtotal" groups="account.group_show_line_subtotals_tax_excluded"/>\n                                                <field name="price_total" string="Total" groups="account.group_show_line_subtotals_tax_included"/>\n                                            </group>\n                                        </sheet>\n                                    </form>\n                                </field>\n\n                                <!-- Totals (only invoices / receipts) -->\n                                <group class="oe_subtotal_footer oe_right" attrs="{'invisible': ['|', ('move_type', 'not in', ('out_invoice', 'out_refund', 'in_invoice', 'in_refund', 'out_receipt', 'in_receipt')),                                                                ('payment_state' ,'=', 'invoicing_legacy')]}">\n                                    <field name="amount_tax" invisible="1"/>\n                                    <field name="amount_untaxed" attrs="{'invisible': [('amount_tax', '=', 0)]}"/>\n                                    <field name="amount_by_group" widget="tax-group-custom-field" nolabel="1" colspan="2" attrs="{'invisible': [('amount_tax', '=', 0)]}"/>\n                                    <field name="amount_total" attrs="{'invisible': [('amount_tax', '!=', 0)]}"/>\n                                    <field name="amount_total" class="oe_subtotal_footer_separator" attrs="{'invisible': [('amount_tax', '=', 0)]}"/>\n                                    <field name="invoice_payments_widget" colspan="2" nolabel="1" widget="payment"/>\n                                    <field name="amount_residual" class="oe_subtotal_footer_separator" attrs="{'invisible': [('state', '=', 'draft')]}"/>\n                                </group>\n                                <field name="narration" placeholder="Terms and Conditions" class="oe_inline text-break" nolabel="1"/>\n\n                                <field name="invoice_outstanding_credits_debits_widget" class="oe_invoice_outstanding_credits_debits" colspan="2" nolabel="1" widget="payment" attrs="{'invisible': ['|', ('state', '!=', 'posted'), ('move_type', 'in', ('out_receipt', 'in_receipt'))]}"/>\n                            </page>\n                            <page id="aml_tab" string="Journal Items" groups="account.group_account_readonly">\n                                <div class="alert alert-info text-center mb-0" role="alert" attrs="{'invisible': ['|', ('payment_state', '!=', 'invoicing_legacy'), ('move_type', '=', 'entry')]}">\n                                    <span>This entry has been generated through the Invoicing app, before installing Accounting. Its balance has been imported separately.</span>\n                                </div>\n                                <field name="line_ids" context="{'default_move_type': context.get('default_move_type'), 'line_ids': line_ids, 'journal_id': journal_id, 'default_partner_id': commercial_partner_id, 'default_currency_id': currency_id or company_currency_id}" attrs="{'invisible': [('payment_state', '=', 'invoicing_legacy'), ('move_type', '!=', 'entry')]}">\n                                    <tree editable="bottom" string="Journal Items" decoration-muted="display_type in ('line_section', 'line_note')" default_order="sequence, date desc, move_name desc, id">\n                                        <!-- Displayed fields -->\n                                        <field name="account_id" attrs="{                                                     'required': [('display_type', 'not in', ('line_section', 'line_note'))],                                                     'invisible': [('display_type', 'in', ('line_section', 'line_note'))],                                                }" domain="[('deprecated', '=', False), ('company_id', '=', parent.company_id)]"/>\n                                        <field name="partner_id" domain="['|', ('parent_id', '=', False), ('is_company', '=', True)]" attrs="{'column_invisible': [('parent.move_type', '!=', 'entry')]}"/>\n                                        <field name="name" widget="section_and_note_text" optional="show"/>\n                                        <field name="analytic_account_id" optional="hide" domain="['|', ('company_id', '=', parent.company_id), ('company_id', '=', False)]" groups="analytic.group_analytic_accounting" attrs="{'invisible': [('display_type', 'in', ('line_section', 'line_note'))]}"/>\n                                        <field name="analytic_tag_ids" optional="show" groups="analytic.group_analytic_tags" widget="many2many_tags" attrs="{'invisible': [('display_type', 'in', ('line_section', 'line_note'))]}"/>\n                                        <field name="date_maturity" optional="hide" invisible="context.get('view_no_maturity')" attrs="{'invisible': [('display_type', 'in', ('line_section', 'line_note'))]}"/>\n                                        <field name="amount_currency" groups="base.group_multi_currency" optional="hide"/>\n                                        <field name="currency_id" options="{'no_create': True}" groups="base.group_multi_currency" attrs="{'column_invisible': [('parent.move_type', '!=', 'entry')]}"/>\n                                        <field name="tax_ids" widget="many2many_tags" optional="hide" domain="[('type_tax_use', '=?', parent.invoice_filter_type_domain)]" context="{'append_type_to_tax_name': not parent.invoice_filter_type_domain}" options="{'no_create': True}" force_save="1" attrs="{'readonly': [                                                     '|', '|',                                                     ('display_type', 'in', ('line_section', 'line_note')),                                                     ('tax_line_id', '!=', False),                                                     '&amp;',                                                     ('parent.move_type', 'in', ('out_invoice', 'out_refund', 'in_invoice', 'in_refund', 'out_receipt', 'in_receipt')),                                                     ('account_internal_type', 'in', ('receivable', 'payable')),                                                 ]}"/>\n                                        <field name="debit" sum="Total Debit" attrs="{'invisible': [('display_type', 'in', ('line_section', 'line_note'))]}"/>\n                                        <field name="credit" sum="Total Credit" attrs="{'invisible': [('display_type', 'in', ('line_section', 'line_note'))]}"/>\n                                        <field name="tax_fiscal_country_id" invisible="1"/>\n                                        <field name="tax_tag_ids" widget="many2many_tags" string="Tax Grids" optional="show" domain="[('country_id', '=', tax_fiscal_country_id), ('applicability', '=', 'taxes')]" options="{'no_create': True}"/>\n\n                                        <!-- Buttons -->\n                                        <button name="action_automatic_entry" type="object" icon="fa-calendar" string="Cut-Off" aria-label="Change Period" class="float-right" attrs="{'invisible': [('account_internal_group', 'not in', ('income', 'expense'))], 'column_invisible': ['|', ('parent.move_type', '=', 'entry'), ('parent.state', '!=', 'posted')]}" context="{'hide_automatic_options': 1, 'default_action': 'change_period'}"/>\n\n                                        <!-- Others fields -->\n                                        <field name="payment_id" invisible="1"/>\n\n                                        <field name="product_id" invisible="1"/>\n                                        <field name="quantity" invisible="1"/>\n                                        <field name="product_uom_category_id" invisible="1"/>\n                                        <field name="product_uom_id" invisible="1"/>\n                                        <field name="price_unit" invisible="1"/>\n                                        <field name="discount" invisible="1"/>\n                                        <field name="price_subtotal" invisible="1"/>\n                                        <field name="price_total" invisible="1"/>\n\n                                        <field name="sequence" invisible="1"/>\n                                        <field name="move_name" invisible="1"/>\n                                        <field name="date" invisible="1"/>\n                                        <field name="tax_line_id" invisible="1"/>\n                                        <field name="tax_group_id" invisible="1"/>\n                                        <field name="tax_repartition_line_id" invisible="1" force_save="1"/>\n                                        <field name="tax_base_amount" invisible="1" force_save="1"/>\n                                        <field name="tax_exigible" invisible="1" force_save="1"/>\n                                        <field name="company_id" invisible="1"/>\n                                        <field name="company_currency_id" invisible="1"/>\n                                        <field name="recompute_tax_line" invisible="1" force_save="1"/>\n                                        <field name="display_type" force_save="1" invisible="1"/>\n                                        <field name="is_rounding_line" invisible="1"/>\n                                        <field name="exclude_from_invoice_tab" invisible="1"/>\n                                        <field name="account_internal_type" invisible="1"/>\n                                        <field name="account_internal_group" invisible="1"/>\n                                    </tree>\n                                    <!-- Form view to cover mobile use -->\n                                    <form>\n                                      <group>\n                                        <field name="tax_line_id" invisible="1"/>\n                                        <field name="account_id" domain="[('company_id', '=', parent.company_id), ('deprecated', '=', False)]"/>\n                                        <field name="partner_id" domain="['|', ('parent_id', '=', False), ('is_company', '=', True)]"/>\n                                        <field name="name"/>\n                                        <field name="analytic_account_id" groups="analytic.group_analytic_accounting"/>\n                                        <field name="analytic_tag_ids" groups="analytic.group_analytic_tags" widget="many2many_tags"/>\n                                        <field name="amount_currency" groups="base.group_multi_currency"/>\n                                        <field name="company_currency_id" invisible="1"/>\n                                        <field name="company_id" invisible="1"/>\n                                        <field name="currency_id" options="{'no_create': True}" groups="base.group_multi_currency"/>\n                                        <field name="debit" sum="Total Debit"/>\n                                        <field name="credit" sum="Total Credit"/>\n                                        <field name="tax_ids" string="Taxes Applied" widget="many2many_tags" options="{'no_create': True}"/>\n                                        <field name="date_maturity" required="0" invisible="context.get('view_no_maturity', False)"/>\n                                        <field name="recompute_tax_line" invisible="1" readonly="1"/>\n                                      </group>\n                                    </form>\n                                </field>\n                            </page>\n                            <page id="other_tab" string="Other Info" name="other_info" attrs="{'invisible': [('move_type', 'not in', ('out_invoice', 'out_refund', 'in_invoice', 'in_refund'))]}">\n                                <group id="other_tab_group">\n                                    <group string="Invoice" name="sale_info_group" attrs="{'invisible': [('move_type', 'not in', ('out_invoice', 'out_refund'))]}">\n                                        <label for="ref" string="Customer Reference"/>\n                                        <field name="ref" nolabel="1"/>\n                                        <field name="user_id" invisible="1" force_save="1"/>\n                                        <field name="invoice_user_id" domain="[('share', '=', False)]" widget="many2one_avatar_user"/>\n                                        <field name="invoice_origin" string="Source Document" force_save="1" invisible="1"/>\n                                        <field name="partner_bank_id" context="{'default_partner_id': bank_partner_id}" domain="[('partner_id', '=', bank_partner_id)]" attrs="{'readonly': [('state', '!=', 'draft')]}"/>\n                                        <field name="qr_code_method" attrs="{'invisible': [('display_qr_code', '=', False)]}"/>\n                                    </group>\n                                    <group string="Accounting" name="accounting_info_group" attrs="{'invisible': [('move_type', 'not in', ('out_invoice', 'out_refund', 'in_invoice', 'in_refund'))]}">\n                                        <field name="company_id" groups="base.group_multi_company"/>\n                                        <field name="invoice_incoterm_id"/>\n                                        <field name="fiscal_position_id"/>\n                                        <field name="invoice_cash_rounding_id" groups="account.group_cash_rounding"/>\n                                        <field name="invoice_source_email" widget="email" attrs="{'invisible': ['|', ('move_type', 'not in', ('in_invoice', 'in_refund')), ('invoice_source_email', '=', False)]}"/>\n                                        <field name="auto_post" attrs="{'readonly': [('state','!=','draft')]}"/>\n                                        <field name="to_check"/>\n                                    </group>\n                                </group>\n                            </page>\n                            <page id="other_tab_entry" string="Other Info" name="other_info" attrs="{'invisible': [('move_type', '!=', 'entry')]}">\n                                <group id="other_tab_entry_group">\n                                    <group name="misc_group">\n                                        <field name="auto_post" attrs="{'invisible': [('move_type', '!=', 'entry')], 'readonly': [('state','!=','draft')]}"/>\n                                        <field name="reversed_entry_id" attrs="{'invisible': [('move_type', '!=', 'entry')]}"/>\n                                        <field name="to_check" attrs="{'invisible': [('move_type', '!=', 'entry')]}"/>\n                                    </group>\n                                    <group>\n                                        <field name="company_id" groups="base.group_multi_company" required="1"/>\n                                    </group>\n                                </group>\n                                <!-- Internal note -->\n                                <field name="narration" placeholder="Add an internal note..." nolabel="1" class="text-break" height="50"/>\n                            </page>\n                        </notebook>\n                    </sheet>\n                    <!-- Attachment preview -->\n                    <div class="o_attachment_preview" attrs="{'invisible': ['|',                                 ('move_type', 'not in', ('out_invoice', 'out_refund', 'in_invoice', 'in_refund')),                                 ('state', '!=', 'draft')]}"/>\n                    <!-- Chatter -->\n                    <div class="oe_chatter">\n                        <field name="message_follower_ids" groups="base.group_user"/>\n                        <field name="activity_ids"/>\n                        <field name="message_ids"/>\n                    </div>\n                </form>\n            	account/views/account_move_views.xml	\N	\N	\N	\N	primary	t	1	2025-08-28 11:32:28.994214	1	2025-08-28 11:32:28.994214	f
646	account.group.tree	account.group	\N	16	tree	<?xml version="1.0"?>\n<tree string="Account Group">\n                    <field name="code_prefix_start"/>\n                    <field name="code_prefix_end"/>\n                    <field name="name"/>\n                    <field name="company_id" groups="base.group_multi_company"/>\n                </tree>\n            	account/views/account_group_views.xml	\N	\N	\N	\N	primary	t	1	2025-08-28 11:32:28.994214	1	2025-08-28 11:32:28.994214	f
1568	report_evakusumawati_surat_sakit	\N	ehealth_document.report_evakusumawati_surat_sakit	16	qweb	<?xml version="1.0"?>\n<t t-name="ehealth_document.report_evakusumawati_surat_sakit">\n        <t t-set="company" t-value="res_company"/>\n        <t t-call="ehealth_document.header_evakusumawati_document">\n          <div class="page">\n            <div class="row">\n              <div class="col-md-12">\n                <p class="text-center mt-3 mb-0" style="font-size: 1.3rem"><strong>SURAT KETERANGAN SAKIT</strong></p>\n                <p class="mt-4">Yang bertanda tangan di bawah ini menerangkan bahwa:</p>\n                <div class="mt-3 ml-3">\n                    <div class="row">\n                        <div class="col-2">Nama</div>\n                        <div class="col-3">: <t t-esc="o['partner_id']['name']"/></div>\n                        <div class="col-1">L/P</div>\n                    </div>\n                    <div class="row">\n                        <div class="col-2">Umur</div>\n                        <div class="col-4">: <t t-esc="o.count_age(o['partner_id']['birthDate'].strftime('%d/%m/%Y'))"/> Tahun</div>\n                    </div>\n                    <div class="row">\n                        <div class="col-2">Alamat</div>\n                        <div class="col-4">: <t t-esc="o['partner_id']['street']"/></div>\n                    </div>\n                    <div class="row">\n                        <div class="col-2">Pekerjaan</div>\n                        <div class="col-4">: <t t-esc="o['partner_id']['function']"/></div>\n                    </div>\n                </div>\n                <p class="mt-3 mb-2">Berdasarkan pemeriksaan klinis, yang bersangkutan telah dinyatakan SAKIT, dan perlu beristirahat selama\n                <strong><t t-esc="o.count_date_delta(data['tanggal-awal'],data['tanggal-akhir'])"/> hari</strong> terhitung sejak tanggal\n                    <strong><t t-esc="data['tanggal-awal']"/></strong> s/d <strong><t t-esc="data['tanggal-akhir']"/></strong>\n                </p><br/>\n                <p>Demikian surat ini dibuat agar digunakan sebagaimana mestinya.</p>\n              </div>\n            </div>\n\n            <div class="row pt-5">\n                <div class="col-7"/>\n                <div class="col-5">\n                    <p class="mb-0"><t t-esc="o['operating_unit_id']['company_id']['city']"/>, <t t-esc="o.to_date_string(data['registration_date'])"/></p>\n                    <p class="mb-0">Dokter Pemeriksa</p>\n                </div>\n            </div>\n          </div>\n        </t>\n      </t>\n    	ehealth_document/report/template_surat_sakit/report_evakusumawati_surat_sakit.xml	\N	\N	\N	\N	primary	t	1	2025-08-28 11:34:01.364376	1	2025-08-28 11:34:01.364376	f
625	account.move.select	account.move	\N	16	search	<?xml version="1.0"?>\n<search string="Search Move">\n                    <field name="name" string="Journal Entry" filter_domain="['|', '|', ('name', 'ilike', self), ('ref', 'ilike', self), ('partner_id', 'ilike', self)]"/>\n                    <field name="date"/>\n                    <field name="partner_id"/>\n                    <field name="journal_id"/>\n                    <filter string="Unposted" name="unposted" domain="[('state', '=', 'draft')]" help="Unposted Journal Entries"/>\n                    <filter string="Posted" name="posted" domain="[('state', '=', 'posted')]" help="Posted Journal Entries"/>\n                    <separator/>\n                    <filter string="Reversed" name="reversed" domain="[('payment_state', '=', 'reversed')]"/>\n                    <separator/>\n                    <filter string="To Check" name="to_check" domain="[('to_check', '=', True)]"/>\n                    <separator/>\n                    <filter string="Sales" name="sales" domain="[('journal_id.type', '=', 'sale')]" context="{'default_journal_type': 'sale'}"/>\n                    <filter string="Purchases" name="purchases" domain="[('journal_id.type', '=', 'purchase')]" context="{'default_journal_type': 'purchase'}"/>\n                    <filter string="Bank" name="bankoperations" domain="[('journal_id.type', '=', 'bank')]" context="{'default_journal_type': 'bank'}"/>\n                    <filter string="Cash" name="cashoperations" domain="[('journal_id.type', '=', 'cash')]" context="{'default_journal_type': 'cash'}"/>\n                    <filter string="Miscellaneous" name="misc_filter" domain="[('journal_id.type', '=', 'general')]" context="{'default_journal_type': 'general'}"/>\n                    <separator/>\n                    <filter string="Date" name="date" date="date"/>\n                    <separator/>\n                    <group expand="0" string="Group By">\n                        <filter string="Partner" name="partner" domain="[]" context="{'group_by': 'partner_id'}"/>\n                        <filter string="Journal" name="journal" domain="[]" context="{'group_by': 'journal_id'}"/>\n                        <filter string="Status" name="status" domain="[]" context="{'group_by': 'state'}"/>\n                        <filter string="Date" name="by_date" domain="[]" context="{'group_by': 'date'}" help="Journal Entries by Date"/>\n                        <filter string="Company" name="by_company" domain="[]" context="{'group_by': 'company_id'}" groups="base.group_multi_company"/>\n                    </group>\n                </search>\n            	account/views/account_move_views.xml	\N	\N	\N	\N	primary	t	1	2025-08-28 11:32:28.994214	1	2025-08-28 11:32:28.994214	f
626	account.invoice.select	account.move	\N	16	search	<?xml version="1.0"?>\n<search string="Search Invoice">\n                    <field name="name" string="Invoice" filter_domain="[                                 '|', '|' , '|', '|',                                 ('name', 'ilike', self), ('invoice_origin', 'ilike', self),                                 ('ref', 'ilike', self), ('payment_reference', 'ilike', self),                                 ('partner_id', 'child_of', self)]"/>\n                    <field name="journal_id"/>\n                    <field name="partner_id" operator="child_of"/>\n                    <field name="invoice_user_id" string="Salesperson" domain="[('share', '=', False)]"/>\n                    <field name="date" string="Period"/>\n                    <filter domain="[('invoice_user_id', '=', uid)]" name="myinvoices" help="My Invoices"/>\n                    <separator/>\n                    <filter name="draft" string="Draft" domain="[('state','=','draft')]"/>\n                    <filter name="posted" string="Posted" domain="[('state', '=', 'posted')]"/>\n                    <filter name="cancel" string="Cancelled" domain="[('state', '=', 'cancel')]"/>\n                    <separator/>\n                    <filter string="To Check" name="to_check" domain="[('to_check', '=', True)]"/>\n                    <separator/>\n                    <filter name="in_payment" string="In Payment" domain="[('payment_state', '=', 'in_payment'), ('state', '=', 'posted')]"/>\n                    <filter name="partial" string="Partially Paid" domain="[('payment_state', '=', 'partial'), ('state', '=', 'posted')]"/>\n                    <filter name="paid" string="Paid" domain="[('payment_state', '=', 'paid'), ('state', '=', 'posted')]"/>\n                    <filter name="unpaid" string="Not Paid" domain="[('payment_state', '=', 'not_paid'), ('state', '=', 'posted')]"/>\n                    <filter name="reversed" string="Reversed" domain="[('payment_state', '=', 'reversed'), ('state', '=', 'posted')]"/>\n                    <filter name="late" string="Overdue" domain="['&amp;', ('invoice_date_due', '&lt;', time.strftime('%Y-%m-%d')), ('state', '=', 'posted'), ('payment_state', 'in', ('not_paid', 'partial'))]" help="Overdue invoices, maturity date passed"/>\n                    <separator/>\n                    <filter name="invoice_date" string="Invoice Date" date="invoice_date"/>\n                    <filter name="due_date" string="Due Date" date="invoice_date_due"/>\n                    <separator/>\n                    <filter invisible="1" string="Late Activities" name="activities_overdue" domain="[('my_activity_date_deadline', '&lt;', context_today().strftime('%Y-%m-%d'))]" help="Show all records which has next action date is before today"/>\n                    <filter invisible="1" string="Today Activities" name="activities_today" domain="[('my_activity_date_deadline', '=', context_today().strftime('%Y-%m-%d'))]"/>\n                    <filter invisible="1" string="Future Activities" name="activities_upcoming_all" domain="[('my_activity_date_deadline', '&gt;', context_today().strftime('%Y-%m-%d'))]"/>\n                    <group expand="0" string="Group By">\n                        <filter string="Salesperson" name="salesperson" context="{'group_by':'invoice_user_id'}"/>\n                        <filter name="status" string="Status" context="{'group_by':'state'}"/>\n                        <separator/>\n                        <filter string="Invoice Date" name="invoicedate" context="{'group_by': 'invoice_date'}"/>\n                        <filter string="Due Date" name="duedate" context="{'group_by': 'invoice_date_due'}"/>\n                    </group>\n               </search>\n            	account/views/account_move_views.xml	\N	\N	\N	\N	primary	t	1	2025-08-28 11:32:28.994214	1	2025-08-28 11:32:28.994214	f
1569	report_pmbdian_surat_sakit	\N	ehealth_document.report_pmbdian_surat_sakit	16	qweb	<?xml version="1.0"?>\n<t t-name="ehealth_document.report_pmbdian_surat_sakit">\n        <t t-set="company" t-value="res_company"/>\n        <t t-call="ehealth_document.header_pmbdian_document">\n          <div class="page">\n            <div class="row">\n              <div class="col-md-12" style="margin-top: 80px">\n                <p class="text-center mt-3 mb-0"><strong>SURAT KETERANGAN SAKIT</strong></p>\n                <p class="text-center">Nomor: <t t-esc="o['name']"/></p>\n                <p class="mt-4">Yang bertanda tangan di bawah ini menerangkan bahwa:</p>\n                <div class="mt-3 ml-3">\n                    <div class="row">\n                        <div class="col-3">\n                          <t t-if="o['partner_id']['identity_type'] == 'ktp'">NIK</t>\n                          <t t-if="o['partner_id']['identity_type'] == 'sim'">No. SIM</t>\n                          <t t-if="o['partner_id']['identity_type'] == 'paspor'">No. Paspor</t>\n                        </div>\n                        <div class="col-6">: \n                          <t t-if="o['partner_id']['identity_type'] == 'ktp'"><t t-esc="o['partner_id']['nik']"/></t>\n                          <t t-else=""><t t-esc="o['partner_id']['identity_number']"/></t>\n                        </div>\n                    </div>\n                    <div class="row">\n                        <div class="col-3">Nama</div>\n                        <div class="col-6">: <t t-esc="o['partner_id']['name']"/></div>\n                    </div>\n                    <div class="row">\n                        <div class="col-3">Tanggal Lahir</div>\n                        <div class="col-6">: <t t-esc="o['partner_id']['birthDate'].strftime('%d-%m-%Y')"/></div>\n                    </div>\n                    <div class="row">\n                        <div class="col-3">Jenis Kelamin</div>\n                        <div class="col-6">: \n                          <t t-if="o['partner_id']['gender'] == 'male'">Laki-Laki</t>\n                          <t t-else="">Perempuan</t>\n                        </div>\n                    </div>\n                    <div class="row">\n                        <div class="col-3">Pekerjaan</div>\n                        <div class="col-6">: <t t-esc="o['partner_id']['function']"/></div>\n                    </div>\n                    <div class="row">\n                        <div class="col-3">Alamat</div>\n                        <div class="col-6">: <t t-esc="o['partner_id']['street']"/></div>\n                    </div>\n                    <t t-if="'diagnosa' in data">\n                      <div class="row">\n                          <div class="col-3">Diagnosa</div>\n                          <div class="col-6">: <t t-esc="data['diagnosa']"/></div>\n                      </div>\n                    </t>\n                </div>\n                <p class="mt-3 mb-2">Perlu beristirahat karena sakit sehingga tidak dapat melaksanakan kewajibannya selama: <strong><t t-esc="o.count_date_delta(data['tanggal-awal'],data['tanggal-akhir'])"/> hari</strong> terhitung <br/> mulai tanggal <strong><t t-esc="data['tanggal-awal']"/></strong> s/d <strong><t t-esc="data['tanggal-akhir']"/></strong>.</p>\n                <p>Harap yang berkepentingan maklum.</p><br/>\n              </div>\n            </div>\n\n            <div class="row pt-5">\n                <div class="col-1"/>\n                <div class="col-3 mt-4">\n                    <p class="mb-0">Validasi</p>\n                    <div class="mt-3" id="qrcode">\n                        <img t-att-src="o['qr_code_url']" style="width:125px;height:125px;"/>\n                    </div>\n                </div>\n                <div class="col-4"/>\n                <div class="col-4">\n                    <p class="mb-0"><t t-esc="o['operating_unit_id']['company_id']['city']"/>, <t t-esc="o.to_date_string(data['registration_date'])"/></p>\n                    <p class="mb-0">Bidan</p>\n                    <div class="mt-3" id="qrcode">\n                        <!-- <t t-if="'qr_code_examiner_url' in data"> -->\n                          <!-- <img t-att-src="data['qr_code_examiner_url']" style="width:125px;height:125px;"/> -->\n                        <!-- </t> -->\n                        <!-- <t t-else=""> -->\n                          <div style="width:125px;height:125px;"/>\n                        <!-- </t> -->\n                    </div>\n                    <p class="mb-0 mt-2"><strong>\n                    Dian Indah Wahyuningsih, S.Tr.Keb.\n                    </strong></p>\n                </div>\n            </div>\n          </div>\n        </t>\n      </t>\n    	ehealth_document/report/template_surat_sakit/report_pmbdian_surat_sakit.xml	\N	\N	\N	\N	primary	t	1	2025-08-28 11:34:01.364376	1	2025-08-28 11:34:01.364376	f

515	res.partner.simplified.form.inherit.partner.autocomplete	res.partner	\N	16	form	<?xml version="1.0"?>\n<data><xpath expr="//div[hasclass('oe_title')]/h1/field[@name='name']" position="attributes">\n                <attribute name="widget">field_partner_autocomplete</attribute>\n            </xpath>\n            <xpath expr="//field[last()]" position="after">\n                <field name="partner_gid" invisible="True"/>\n                <field name="additional_info" invisible="True"/>\n            </xpath>\n        </data>	partner_autocomplete/views/res_partner_views.xml	\N	\N	116	\N	extension	t	1	2025-08-28 11:32:23.201028	1	2025-08-28 11:32:23.201028	\N
636	res.partner.search.inherit	res.partner	\N	16	search	<?xml version="1.0"?>\n<xpath expr="//filter[@name='inactive']" position="before">\n                   <filter string="Customer Invoices" name="customer" domain="[('customer_rank','&gt;', 0)]"/>\n                   <filter string="Vendor Bills" name="supplier" domain="[('supplier_rank','&gt;', 0)]"/>\n                   <separator/>\n                </xpath>\n            	account/views/partner_view.xml	\N	\N	120	\N	extension	t	1	2025-08-28 11:32:28.994214	1	2025-08-28 11:32:28.994214	f

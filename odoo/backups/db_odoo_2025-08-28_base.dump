602	account.move.reversal.form	account.move.reversal	\N	16	form	<?xml version="1.0"?>\n<form string="Reverse Journal Entry">\n                    <field name="residual" invisible="1"/>\n                    <field name="company_id" invisible="1"/>\n                    <field name="move_ids" invisible="1"/>\n                    <field name="move_type" invisible="1"/>\n                    <group>\n                         <group attrs="{'invisible': [('move_type', 'not in', ('out_invoice', 'in_invoice'))]}">\n                            <field name="refund_method" widget="radio" attrs="{'readonly': [('residual', '=', 0)]}"/>\n                         </group>\n                         <group attrs="{'invisible': [('move_type', 'not in', ('out_invoice', 'in_invoice', 'some_invoice'))]}">\n                            <div attrs="{'invisible':[('refund_method', '!=', 'refund')]}" class="oe_grey" colspan="4">\n                               The credit note is created in draft and can be edited before being issued.\n                            </div>\n                            <div attrs="{'invisible':[('refund_method', '!=', 'cancel')]}" class="oe_grey" colspan="4">\n                               The credit note is auto-validated and reconciled with the invoice.\n                            </div>\n                            <div attrs="{'invisible':[('refund_method', '!=', 'modify')]}" class="oe_grey" colspan="4">\n                               The credit note is auto-validated and reconciled with the invoice.\n                               The original invoice is duplicated as a new draft.\n                            </div>\n                         </group>\n                    </group>\n                    <group>\n                         <group>\n                             <field name="reason" attrs="{'invisible': [('move_type', '==', 'entry')], 'reason': [('move_type', '==', 'entry')]}"/>\n                             <field name="date_mode" string="Reversal Date" widget="radio"/>\n                         </group>\n                         <group>\n                            <field name="journal_id"/>\n                            <field name="date" string="Refund Date" attrs="{'invisible': ['|', ('move_type', 'not in', ('out_invoice', 'in_invoice')), ('date_mode', '!=', 'custom')], 'required':[('date_mode', '=', 'custom')]}"/>\n                            <field name="date" attrs="{'invisible': ['|', ('move_type', 'in', ('out_invoice', 'in_invoice')), ('date_mode', '!=', 'custom')], 'required':[('date_mode', '=', 'custom')]}"/>\n                         </group>\n                    </group>\n                    <footer>\n                        <button string="Reverse" name="reverse_moves" type="object" class="btn-primary"/>\n                        <button string="Cancel" class="btn-secondary" special="cancel"/>\n                    </footer>\n               </form>\n            	account/wizard/account_move_reversal_view.xml	\N	\N	\N	\N	primary	t	1	2025-08-28 11:32:28.994214	1	2025-08-28 11:32:28.994214	f
1554	report_yumarimedika_surat_sakit	\N	ehealth_document.report_yumarimedika_surat_sakit	16	qweb	<?xml version="1.0"?>\n<t t-name="ehealth_document.report_yumarimedika_surat_sakit">\n        <t t-set="company" t-value="res_company"/>\n        <t t-call="ehealth_document.header_yumarimedika_document">\n          <div class="page">\n            <div class="row">\n              <div class="col-md-12">\n                <p class="text-center mt-3 mb-0"><strong>SURAT KETERANGAN ISTIRAHAT</strong></p>\n                <p class="text-center">Nomor: <t t-esc="o['name']"/></p>\n                <p class="mt-4">Yang bertanda tangan di bawah ini <strong>dr. Hj. Andi Nur Ardiah Rahman</strong> menerangkan dengan sesungguhnya bahwa:</p>\n                <div class="mt-3 ml-3">\n                    <div class="row">\n                        <div class="col-3">Nama</div>\n                        <div class="col-6">: <strong><t t-esc="o['partner_id']['name']"/></strong></div>\n                    </div>\n                    <div class="row">\n                        <div class="col-3">Tempat/Tanggal Lahir</div>\n                        <div class="col-6">: <t t-if="o['partner_id']['birth_place']"><t t-esc="o['partner_id']['birth_place']"/>, </t><t t-esc="o['partner_id']['birthDate'].strftime('%d-%m-%Y')"/> </div>\n                    </div>\n                    <div class="row">\n                        <div class="col-3">Umur</div>\n                        <div class="col-6">: <t t-esc="o.count_age(o['partner_id']['birthDate'].strftime('%d/%m/%Y'))"/> Tahun</div>\n                    </div>\n                    <div class="row">\n                        <div class="col-3">Jenis Kelamin</div>\n                        <div class="col-6">: \n                          <t t-if="o['partner_id']['gender'] == 'male'">Laki-Laki</t>\n                          <t t-else="">Perempuan</t>\n                        </div>\n                    </div>\n                    <div class="row">\n                        <div class="col-3">Pekerjaan</div>\n                        <div class="col-6">: <t t-esc="o['partner_id']['function']"/></div>\n                    </div>\n                    <div class="row">\n                        <div class="col-3">Alamat</div>\n                        <div class="col-6">: <t t-esc="o['partner_id']['street']"/></div>\n                    </div>\n                </div>\n                <p class="mt-3 mb-2">Tidak dapat melaksanakan tugas/kewajibannya karena dalam keadaan sakit, selama: <strong><t t-esc="o.count_date_delta(data['tanggal-awal'],data['tanggal-akhir'])"/> hari</strong> terhitung mulai tanggal <strong><t t-esc="data['tanggal-awal']"/></strong> sampai dengan <strong><t t-esc="data['tanggal-akhir']"/></strong>.</p>\n                <p>Demikian Surat Keterangan ini dibuat untuk dapat digunakan sebagaimana mestinya.</p><br/>\n              </div>\n            </div>\n\n            <div class="row pt-5">\n                <div class="col-1"/>\n                <div class="col-3 mt-4">\n                    <p class="mb-0">Validasi</p>\n                    <div class="mt-3" id="qrcode">\n                        <img t-att-src="o['qr_code_url']" style="width:125px;height:125px;"/>\n                    </div>\n                </div>\n                <div class="col-2"/>\n                <div class="col-6">\n                    <p class="mb-0"><t t-esc="o['operating_unit_id']['city']"/>, <t t-esc="o.to_date_string(data['registration_date'])"/></p>\n                    <p class="mb-0">Dokter Pemeriksa</p>\n                    <div class="mt-3" id="qrcode">\n                        <t t-if="'qr_code_examiner_url' in data">\n                          <img t-att-src="data['qr_code_examiner_url']" style="width:125px;height:125px;"/>\n                        </t>\n                        <t t-else="">\n                          <div style="width:125px;height:125px;"/>\n                        </t>\n                    </div>\n                    <p class="mb-0 mt-2"><strong>\n                    <p class="mb-0">dr. Hj. Andi Nur Ardiah Rahman</p>\n                    <p>SIP: 998/027/SIPDU/DPM-PTSP/KES/IX/2023</p>\n                    </strong></p>\n                </div>\n            </div>\n          </div>\n        </t>\n      </t>\n    	ehealth_document/report/template_surat_sakit/report_yumarimedika_surat_sakit.xml	\N	\N	\N	\N	primary	t	1	2025-08-28 11:34:01.364376	1	2025-08-28 11:34:01.364376	f

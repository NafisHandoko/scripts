1194	res.partner.view.buttons	res.partner	\N	3	form	<?xml version="1.0"?>\n<data><div name="button_box" position="inside">\n                    <button class="oe_stat_button" type="object" name="action_view_sale_order" groups="sales_team.group_sale_salesman" icon="fa-usd">\n                        <field string="Sales" name="sale_order_count" widget="statinfo"/>\n                    </button>\n                </div>\n                <page name="internal_notes" position="inside">\n                    <group colspan="2" col="2" groups="sale.group_warning_sale">\n                        <separator string="Warning on the Sales Order" colspan="4"/>\n                            <field name="sale_warn" nolabel="1"/>\n                            <field name="sale_warn_msg" colspan="3" nolabel="1" attrs="{'required':[('sale_warn', '!=', False), ('sale_warn','!=','no-message')], 'invisible':[('sale_warn','in',(False,'no-message'))]}"/>\n                    </group>\n                </page>\n            </data>	sale/views/res_partner_views.xml	\N	\N	118	\N	extension	t	1	2025-08-28 11:33:25.849737	1	2025-08-28 11:33:25.849737	f
1197	Sale backend assets	\N	sale.assets_backend_inherit_sale	16	qweb	<?xml version="1.0"?>\n<data inherit_id="web.assets_backend" name="Sale backend assets">\n        <xpath expr="link[last()]" position="after">\n            <link rel="stylesheet" type="text/scss" href="/sale/static/src/scss/sale_onboarding.scss"/>\n            <link rel="stylesheet" type="text/scss" href="/sale/static/src/scss/product_configurator.scss"/>\n        </xpath>\n        <xpath expr="script[last()]" position="after">\n            <script type="text/javascript" src="/sale/static/src/js/sale.js"/>\n            <script type="text/javascript" src="/sale/static/src/js/tours/sale.js"/>\n            <script type="text/javascript" src="/sale/static/src/js/product_configurator_widget.js"/>\n            <script type="text/javascript" src="/sale/static/src/js/sale_order_view.js"/>\n            <script type="text/javascript" src="/sale/static/src/js/product_discount_widget.js"/>\n        </xpath>\n    </data>\n     	sale/views/assets.xml	\N	\N	185	\N	extension	t	1	2025-08-28 11:33:25.849737	1	2025-08-28 11:33:25.849737	f

1665	report_diatrans_surat_keterangan_dokter	\N	ehealth_document.report_diatrans_surat_keterangan_dokter	16	qweb	<?xml version="1.0"?>\n<t t-name="ehealth_document.report_diatrans_surat_keterangan_dokter">\n        <t t-set="company" t-value="res_company"/>\n        <t t-call="ehealth_document.header_diatrans_document">\n          <div class="page">\n            <div class="row">\n              <div class="col-md-12">\n                <div class="row">\n                  <div class="col-5">\n                    <div class="row">\n                      <div class="col-3">Dokter</div>\n                      <div class="col-12">:\n                        <t t-if="'examiner_name' in data">\n                          <t t-esc="data['examiner_name']"/>\n                        </t>\n                        <t t-else="">\n                          <t t-esc="data['sender']"/>\n                        </t>\n                      </div>\n                    </div>\n\n                    <div class="row">\n                      <div class="col-3">No. ID</div>\n                      <div class="col-12">: <t t-esc="data['id-pengirim-surat']"/></div>\n                    </div>\n                  </div>\n\n                  <div class="col-2"/>\n\n                  <div class="col-5">\n                    <div>Kepada</div>\n                    <div>Yth. T.S Dr. <t t-esc="data['tujuan-surat']"/> </div>\n                    <div>di - <t t-esc="data['tempat-tujuan-surat']"/>  </div>\n                  </div>\n                </div>\n\n                <div class="row">\n                  <div class="col-7"/>\n                  <div class="col-5">\n                    Jakarta, <t t-esc="o.to_date_string(data['registration_date'])"/>\n                  </div> \n                </div>\n\n                <div class="mt-4">\n                  <div> Yth. Teman Sejawat, </div>\n                  <div> Sudilah kiranya Sejawat,</div>\n                  <div class="mt-1"/>\n                  <div>a. Memeriksa dan memberikan nasehat pengobatan, </div>\n                  <div>b. Memeriksa dan memberikan pengobatan selanjutnya, </div>\n                  <div> Kepada penderita, </div>\n\n                  <div class="row">\n                    <div class="col-2">Nama </div>\n                    <div class="col-10">: <t t-esc="o['partner_id']['name']"/> </div>\n                  </div>\n\n                  <div class="row">\n                    <div class="col-2">Usia </div>\n                    <div class="col-2">: <t t-esc="o.count_age(o['partner_id']['birthDate'].strftime('%d/%m/%Y'))"/> Tahun, </div>\n                    <div class="col-6">\n                      <t t-if="o['partner_id']['gender'] == 'male'">\n                        laki-laki / <span style="text-decoration: line-through;"> perempuan</span>\n                      </t>\n                      <t t-if="o['partner_id']['gender'] == 'female'">\n                        <span style="text-decoration: line-through;"> laki-laki</span> / perempuan\n                      </t>\n                    </div>\n                  </div>\n\n                  <div class="row">\n                    <div class="col-2">Pekerjaan </div>\n                    <div class="col-10">: <t t-esc="o['partner_id']['function']"/>  </div>\n                  </div>\n\n                  <div> Dengan keluhan/gejala penyakit sbb : <t t-esc="data['anamnese-manual']"/> </div>\n                  \n                  <div class="row">\n                    <div class="col-2">Catatan </div>\n                    <div class="col-10">: <t t-esc="data['catatan-dokumen']"/> </div>\n                  </div>\n\n                  <p> Sekian, terima kasih atas bantuan Sejawat. </p>\n                </div>\n              </div>\n            </div>\n\n            <div class="row pt-5">\n                <div class="col-8"/>\n                <div class="col-4">\n                  <p class="mb-0">Hormat Kami, </p>\n                  <div style="width:125px;height:125px;"/>\n                  <p class="mb-0 mt-2"><strong>\n                  <t t-if="'examiner_name' in data">\n                    <t t-esc="data['examiner_name']"/>\n                  </t>\n                  <t t-else="">\n                    <t t-esc="data['sender']"/>\n                  </t>\n                  </strong></p>\n                </div>\n            </div>\n          </div>\n        </t>\n      </t>\n    	ehealth_document/report/template_surat_keterangan_dokter/report_diatrans_surat_keterangan_dokter.xml	\N	\N	\N	\N	primary	t	1	2025-08-28 11:34:01.364376	1	2025-08-28 11:34:01.364376	f

1666	report_emerald_keterangan_buta_warna	\N	ehealth_document.report_emerald_keterangan_buta_warna	16	qweb	<?xml version="1.0"?>\n<t t-name="ehealth_document.report_emerald_keterangan_buta_warna">\n        <t t-set="company" t-value="res_company"/>\n        <t t-call="ehealth_document.header_emerald_document">\n          <div class="page">\n            <div class="row">\n              <div class="col-md-12" style="font-size: 18px;">\n                <p class="text-center mt-2 mb-0" style="text-decoration: underline; font-size: 24px">\n                  <strong>SURAT KETERANGAN</strong>\n                </p>\n                <p class="text-center" style="font-size: 20px;">Nomor: <t t-esc="o['name']"/></p>\n                <p class="mt-4">Yang bertanda tangan di bawah ini, Pimpinan Emerald Clinic &amp; Diagnostik Jambi, menerangkan dengan mengingat Sumpah bahwa:</p>\n                <div class="mt-4 ml-4">\n                  <div class="row pb-2">\n                    <div class="col-2">Nama</div>\n                    <div class="col-10">: <t t-esc="o['partner_id']['name']"/></div>\n                  </div>\n                  <div class="row pb-2">\n                    <div class="col-2">Usia</div>\n                    <div class="col-10">: <t t-esc="o.count_age(o['partner_id']['birthDate'].strftime('%d/%m/%Y'))"/> tahun</div>\n                  </div>\n                  <div class="row pb-2">\n                    <div class="col-2">Pekerjaan</div>\n                    <div class="col-10">: <t t-esc="o['partner_id']['function']"/></div>\n                  </div>\n                  <div class="row pb-2">\n                    <div class="col-2">Alamat</div>\n                    <div class="col-10">: <t t-esc="o['partner_id']['street']"/></div>\n                  </div>\n                </div>\n\n                <div class="mt-4">\n                  <div>Setelah diperiksa pada saat ini ternyata <i>(coret tidak yang tidak benar)</i>:</div>\n                  <div class="mt-2" style="margin-left: 48px;"> \n                    <t t-if="data['buta-warna'].lower() == 'ya'"> \n                      <span style="text-decoration: line-through;">A. TIDAK BUTA WARNA </span>\n                    </t>\n                    <t t-if="data['buta-warna'].lower() == 'tidak'"> \n                      <span>A. TIDAK BUTA WARNA </span>\n                    </t>\n                  </div>\n                  <div style="margin-left: 48px;">\n                    <t t-if="data['buta-warna'].lower() == 'tidak'"> \n                      <span style="text-decoration: line-through;">B. BUTA WARNA </span>\n                    </t>\n                    <t t-if="data['buta-warna'].lower() == 'ya'"> \n                      <span>B. BUTA WARNA </span>\n                    </t>\n                  </div>\n                </div>\n\n                <div class="mt-2">\n                  <div>Surat keterangan ini digunakan untuk <t t-esc="data['keterangan']"/> </div>\n                </div>\n              </div>\n            </div>\n\n            <div class="row pt-5" style="font-size: 18px;">\n                <div class="col-7"/>\n                <div class="col-5">\n                    <p class="mb-0">Jambi, <t t-esc="o.to_date_string(data['registration_date'])"/></p>\n                    <p class="mb-0">Pimpinan Emerald Clinic &amp; Diagnostik</p>\n                    <p>Atas Nama</p>\n                    <div class="mt-3">\n                        <div style="width:125px;height:125px;"/>\n                    </div>\n                    <p class="mb-0 mt-2"><strong>\n                    <t t-if="'examiner_name' in data">\n                      <t t-esc="data['examiner_name']"/>\n                    </t>\n                    <t t-else="">\n                      <t t-esc="data['sender']"/>\n                    </t>\n                    </strong></p>\n                </div>\n            </div>\n          </div>\n        </t>\n      </t>\n    	ehealth_document/report/template_surat_keterangan_dokter/report_emerald_keterangan_buta_warna.xml	\N	\N	\N	\N	primary	t	1	2025-08-28 11:34:01.364376	1	2025-08-28 11:34:01.364376	f
775	report_generic_barcode	\N	stock.report_generic_barcode	16	qweb	<?xml version="1.0"?>\n<t t-name="stock.report_generic_barcode">\n    <t t-call="web.html_container">\n        <t t-set="nRows" t-value="8"/>\n        <t t-set="nCols" t-value="3"/>\n        <div t-foreach="[docs[x:x + nRows * nCols] for x in range(0, len(docs), nRows * nCols)]" t-as="page_docs" class="page article">\n        <t t-if="title">\n          <h2 style="text-align: center; font-size: 3em"><t t-esc="title"/></h2>\n        </t>\n        <table>\n            <t t-foreach="range(nRows)" t-as="row">\n                <tr>\n                    <t t-foreach="range(nCols)" t-as="col">\n                        <t t-set="barcode_index" t-value="(row * nCols + col)"/>\n                        <t t-if="barcode_index &lt; len(page_docs)">\n                            <t t-set="o" t-value="page_docs[barcode_index]"/>\n                        </t>\n                        <t t-else="">\n                            <t t-set="o" t-value="page_docs[0]"/>\n                        </t>\n                        <td t-att-style="barcode_index &gt;= len(page_docs) and 'visibility:hidden'">\n                            <div style="text-align: center; font-size: 2em"><span t-esc="o.name"/></div>\n                            <img t-if="o.barcode" class="barcode" t-att-src="'/report/barcode/?type=%s&amp;value=%s&amp;width=%s&amp;height=%s&amp;humanreadable=1' % ('Code128', o.barcode, 400, 100)" alt="Barcode"/>\n                        </td>\n                    </t>\n                </tr>\n            </t>\n        </table>\n      </div>\n    </t>\n</t>\n\n	stock/report/report_location_barcode.xml	\N	\N	\N	\N	primary	t	1	2025-08-28 11:32:42.235962	1	2025-08-28 11:32:42.235962	f
1667	report_default_surat_keterangan_hamil	\N	ehealth_document.report_default_surat_keterangan_hamil	16	qweb	<?xml version="1.0"?>\n<t t-name="ehealth_document.report_default_surat_keterangan_hamil">\n        <t t-set="company" t-value="res_company"/>\n        <t t-call="web.external_layout">\n        <t t-set="o" t-value="o.with_context(lang=lang)"/> \n        <div class="page">\n            <div class="row">\n                <div class="col-md-12">\n                    <p class="text-center mt-3 mb-0"><strong>SURAT KETERANGAN HAMIL</strong></p>\n                    <p class="text-center">Nomor: <t t-esc="o['name']"/></p>\n                    <p class="mt-4">Yang bertanda tangan di bawah ini menerangkan bahwa:</p>\n                    <div class="mt-3 ml-3">\n                        <div class="row">\n                            <div class="col-3">\n                            <t t-if="o['partner_id']['identity_type'] == 'ktp'">NIK</t>\n                            <t t-if="o['partner_id']['identity_type'] == 'sim'">No. SIM</t>\n                            <t t-if="o['partner_id']['identity_type'] == 'paspor'">No. Paspor</t>\n                            </div>\n                            <div class="col-6">: \n                            <t t-if="o['partner_id']['identity_type'] == 'ktp'"><t t-esc="o['partner_id']['nik']"/></t>\n                            <t t-else=""><t t-esc="o['partner_id']['identity_number']"/></t>\n                            </div>\n                        </div>\n                        <div class="row">\n                            <div class="col-3">Nama</div>\n                            <div class="col-6">: <t t-esc="o['partner_id']['name']"/></div>\n                        </div>\n                        <div class="row">\n                            <div class="col-3">Tanggal Lahir</div>\n                            <div class="col-6">: <t t-esc="o['partner_id']['birthDate'].strftime('%d-%m-%Y')"/></div>\n                        </div>\n                        <div class="row">\n                            <div class="col-3">Pekerjaan</div>\n                            <div class="col-6">: <t t-esc="o['partner_id']['function']"/></div>\n                        </div>\n                        <div class="row">\n                            <div class="col-3">Alamat</div>\n                            <div class="col-6">: <t t-esc="o['partner_id']['street']"/></div>\n                        </div>\n                    </div>\n                    <p class="mt-3 mb-2">Sedang hamil<t t-esc="data['masa-kehamilan']"/> Minggu</p>\n                </div>\n            </div>\n\n            <div class="row pt-5">\n                <div class="col-1"/>\n                <div class="col-3 mt-4">\n                    <p class="mb-0">Validasi</p>\n                    <div class="mt-3" id="qrcode">\n                        <img t-att-src="o['qr_code_url']" style="width:125px;height:125px;"/>\n                    </div>\n                </div>\n                <div class="col-4"/>\n                <div class="col-4">\n                    <p class="mb-0"><t t-esc="o['operating_unit_id']['company_id']['city']"/>, <t t-esc="o.to_date_string(data['registration_date'])"/></p>\n                    <p class="mb-0">Bidan Pemeriksa</p>\n                    <div class="mt-3" id="qrcode">\n                        <div style="width:125px;height:125px;"/>\n                    </div>\n                    <p class="mb-0 mt-2"><strong>\n                    <t t-if="'examiner_name' in data">\n                    <t t-esc="data['examiner_name']"/>\n                    </t>\n                    <t t-else="">\n                    <t t-esc="data['sender']"/>\n                    </t>\n                    </strong></p>\n                </div>\n            </div>\n        </div>\n        </t>\n    </t>\n    	ehealth_document/report/template_surat_keterangan_hamil/report_default_surat_keterangan_hamil.xml	\N	\N	\N	\N	primary	t	1	2025-08-28 11:34:01.364376	1	2025-08-28 11:34:01.364376	f
780	stock_report_delivery_has_serial_move_line	\N	stock.stock_report_delivery_has_serial_move_line	16	qweb	<?xml version="1.0"?>\n<t t-name="stock.stock_report_delivery_has_serial_move_line">\n        <td>\n            <span t-field="move_line.product_id"/>\n            <!-- this is an annoying workaround for the multiple types of descriptions (often auto-filled) that we do not want to print -->\n            <!-- this makes it so we can pre-filter the descriptions in inherited templates since we cannot extend the standard "if" condition -->\n            <!-- let's agree that pre-filtered descriptions will be set to "" -->\n            <t t-if="not description and description != ''">\n                <t t-set="description" t-value="move_line.move_id.description_picking"/>\n            </t>\n            <p t-if="description !='' and description != move_line.product_id.name">\n                <span t-esc="description"/>\n            </p>\n        </td>\n        <t t-if="has_serial_number" name="move_line_lot">\n            <td><span t-field="move_line.lot_id.name"/></td>\n        </t>\n        <td class="text-center" name="move_line_lot_qty_done">\n            <span t-field="move_line.qty_done"/>\n            <span t-field="move_line.product_uom_id"/>\n        </td>\n    </t>\n    	stock/report/report_deliveryslip.xml	\N	\N	\N	\N	primary	t	1	2025-08-28 11:32:42.235962	1	2025-08-28 11:32:42.235962	f
781	stock_report_delivery_aggregated_move_lines	\N	stock.stock_report_delivery_aggregated_move_lines	16	qweb	<?xml version="1.0"?>\n<t t-name="stock.stock_report_delivery_aggregated_move_lines">\n        <tr t-foreach="aggregated_lines" t-as="line">\n            <td>\n                <span t-esc="aggregated_lines[line]['name']"/>\n                <p t-if="aggregated_lines[line]['description']">\n                    <span t-esc="aggregated_lines[line]['description']"/>\n                </p>\n            </td>\n            <td class="text-center" name="move_line_aggregated_qty_done">\n                <span t-esc="aggregated_lines[line]['qty_done']" t-options="{'widget': 'float', 'decimal_precision': 'Product Unit of Measure'}"/>\n                <span t-esc="aggregated_lines[line]['product_uom']"/>\n            </td>\n        </tr>\n    </t>\n\n    	stock/report/report_deliveryslip.xml	\N	\N	\N	\N	primary	t	1	2025-08-28 11:32:42.235962	1	2025-08-28 11:32:42.235962	f

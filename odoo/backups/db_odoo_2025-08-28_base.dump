1386	purchase.order.form.inherit	purchase.order	\N	16	form	<?xml version="1.0"?>\n<data><xpath expr="//header" position="replace">\n          <header>\n              <button name="action_rfq_send" states="draft" string="Send by Email" type="object" context="{'send_rfq':True}" class="oe_highlight"/>\n              <button name="print_quotation" string="Print RFQ" type="object" states="draft" class="oe_highlight" groups="base.group_user"/>\n              <button name="button_confirm" type="object" string="Confirm Order" class="oe_highlight disabled_button" attrs="{'invisible': [('state', 'not in', ('draft', 'sent'))], 'readonly': [('is_disable_confirm', '=', True)]}" id="draft_confirm"/>\n              <button name="button_approve" type="object" states="to approve" string="Approve Order" class="oe_highlight" groups="purchase.group_purchase_manager"/>\n              <button name="send_order_and_request_otp" string="Send Order &amp; Request OTP" type="object" class="oe_highlight disabled_button" attrs="{'invisible': ['|', ('state', '!=', 'purchase'), ('is_special_vendor', '=', False)], 'readonly': [('is_disable_send_order', '=', True)]}"/>\n              <button name="print_purchase_order_by_category" string="Print Surat Pesanan" type="object" class="oe_highlight" attrs="{'invisible': ['|', ('state', '!=', 'purchase'), ('is_special_vendor', '=', False)]}"/>\n              <button name="input_otp" string="Input OTP" type="object" class="oe_highlight disabled_button" attrs="{'invisible': [('state', '!=', 'po-sent')], 'readonly': [('is_disable_otp', '=', True)]}"/>\n              <button name="action_view_picking" string="Receive Products" class="oe_highlight" type="object" attrs="{'invisible': ['|', '|' , ('is_shipped', '=', True), ('picking_count', '=', 0), '|', '&amp;', ('is_special_vendor', '=', True), ('state','not in', ('submitted','done')), '&amp;', ('is_special_vendor', '=', False), ('state','not in', ('purchase','submitted','done'))]}"/>\n              <button name="action_create_invoice" string="Create Bill" type="object" context="{'create_bill':True}" attrs="{'invisible': ['|', '|', ('state', 'not in', ('purchase', 'done')), ('invoice_status', 'not in', ('no', 'invoiced')), ('order_line', '=', [])]}"/>\n              <button name="action_create_invoice" string="Create Bill" type="object" class="oe_highlight" context="{'create_bill':True}" attrs="{'invisible': ['|', ('state', 'not in', ('purchase', 'done')), ('invoice_status', 'in', ('no', 'invoiced'))]}"/>\n              <button name="action_rfq_send" states="sent" string="Re-Send by Email" type="object" context="{'send_rfq':True}"/>\n              <button name="print_quotation" string="Print RFQ" type="object" states="sent" groups="base.group_user"/>\n              <button name="button_draft" string="Reset to Draft" type="object" attrs="{'invisible': [('state', '!=', 'cancel')]}"/>\n              <button name="button_cancel" string="Cancel" type="object" attrs="{'invisible': [('state', 'not in', ('draft', 'purchase', 'po-sent'))]}"/>\n              <button name="button_done" type="object" string="Lock" attrs="{'invisible': ['|', ('state', '!=', 'purchase'), ('is_special_vendor', '=', True)]}"/>\n              <button name="button_unlock" type="object" string="Unlock" groups="purchase.group_purchase_manager" attrs="{'invisible': [('state', '!=', 'done')]}"/>\n              <field name="state" widget="statusbar" statusbar_visible="draft,purchase,po-sent,submitted,done" readonly="1"/>\n\n              <!-- for attrs only -->\n              <field name="invoice_status" invisible="1"/>\n              <field name="order_line" invisible="1"/>\n              <field name="is_special_vendor" invisible="1"/>\n              <field name="is_disable_confirm" invisible="1"/>\n              <field name="is_disable_send_order" invisible="1"/>\n              <field name="is_shipped" invisible="1"/>\n              <field name="picking_count" invisible="1"/>\n              <field name="is_disable_otp" invisible="1"/>\n          </header>\n          <div class="alert alert-info" role="alert" attrs="{'invisible': ['|', ('state', '!=', 'po-sent'), ('is_disable_otp', '=', False)]}">\n              <span><strong>Your purchase order is under review. </strong> You will receive an OTP once it's approved</span>\n          </div>\n          <div class="alert alert-info" role="alert" attrs="{'invisible': ['|', '|', ('state', '!=', 'purchase'), ('is_disable_send_order', '=', False), ('is_special_vendor', '=', False)]}">\n              <span>You have to upload <strong>Foto Surat Pesanan </strong> to process  the Purchase Order.</span>\n          </div>\n        </xpath>\n\n        <xpath expr="//field[@name='date_order']" position="before">\n            <field name="is_special_vendor" invisible="1"/>\n            <field name="pharmacy_category" attrs="{'invisible':[('is_special_vendor', '=', False)], 'required':[('is_special_vendor', '=', True)]}"/>\n        </xpath>\n\n        <xpath expr="//field[@name='order_line']/tree/field[@name='product_id']" position="replace">\n          <field name="product_id" attrs="{'readonly': [('state', 'in', ('purchase','done', 'cancel'))], 'required': [('display_type', '=', False)],}" context="{'partner_id':parent.partner_id, 'quantity':product_qty,'uom':product_uom, 'company_id': parent.company_id}" force_save="1" domain="[                   ('purchase_ok', '=', True),                   '|',                   ('company_id', '=', False),                   ('company_id', '=', parent.company_id),                   '|',                   ('product_tmpl_id.use_restrict_location', '=', False),                   ('product_tmpl_id.allowed_location_ids', 'in', [parent.destination_stock_location]),                   ('product_tmpl_id.type', '!=', 'service'),                   '|',                   ('always_false', '=', parent.is_special_vendor),                   ('pharmacy_type_id', 'in', [parent.pharmacy_category])               ]" options="{'no_create_edit' : True, 'no_create': True }"/>\n        </xpath>\n\n        <xpath expr="//field[@name='order_line']/tree/field[@name='product_uom']" position="after">\n          <field name="avability" readonly="1" force_save="1" optional="show" decoration-success="avability == 'available'" decoration-danger="avability == 'not-available'" attrs="{'column_invisible': [('parent.is_special_vendor', '=', False)]}"/>\n        </xpath>\n\n        <xpath expr="//field[@name='order_line']/tree/field[@name='price_unit']" position="before">\n          <field name="notes"/>\n        </xpath>\n\n        <xpath expr="//field[@name='origin']" position="after">\n          <field name="picking_type_id"/>\n          <field name="destination_stock_location" invisible="1"/>\n        </xpath>\n\n        <xpath expr="//field[@name='qty_received']" position="attributes">\n          <attribute name="optional">hide</attribute>\n        </xpath>\n        <xpath expr="//field[@name='qty_invoiced']" position="attributes">\n          <attribute name="optional">hide</attribute>\n        </xpath>\n\n        <xpath expr="//page[@name='products']" position="after">\n          <page string="Surat Pesanan" states="purchase,po-sent,rejected,submitted,done,cancel">\n            <group string="Tanda Tangan Surat Pesanan">\n              <field name="attachment_ids" widget="many2many_image" options="{'accepted_file_extensions': 'image/*'}" string="Foto Surat Pesanan"/>\n            </group>\n          </page>\n        </xpath>\n\n      </data>	ehealth/views/purchase.xml	\N	\N	1053	\N	extension	t	1	2025-08-28 11:33:43.631866	1	2025-08-28 11:33:43.631866	f
193	Frontend Layout	\N	web.frontend_layout	16	qweb	<?xml version="1.0"?>\n<data name="Frontend Layout" inherit_id="web.layout" primary="True">\n        <xpath expr="//head/meta[last()]" position="after">\n            <meta name="viewport" content="width=device-width, initial-scale=1, user-scalable=no"/>\n        </xpath>\n        <xpath expr="//head/link[last()]" position="after">\n            <link rel="preload" href="/web/static/lib/fontawesome/fonts/fontawesome-webfont.woff2?v=4.7.0" as="font" crossorigin=""/>\n            <t t-call-assets="web.assets_common" t-js="false"/>\n            <t t-call-assets="web.assets_frontend" t-js="false"/>\n        </xpath>\n        <xpath expr="//head/script[@id='web.layout.odooscript'] | //head/script[last()]" position="after">\n            <script type="text/javascript">\n                odoo.session_info = <t t-raw="json.dumps(request.env['ir.http'].get_frontend_session_info())"/>;\n                if (!/(^|;\\s)tz=/.test(document.cookie)) {\n                    const userTZ = Intl.DateTimeFormat().resolvedOptions().timeZone;\n                    document.cookie = `tz=${userTZ}; path=/`;\n                }\n            </script>\n            <t t-call-assets="web.assets_common_minimal_js" t-css="false" defer_load="True"/>\n            <t t-call-assets="web.assets_frontend_minimal_js" t-css="false" defer_load="True"/>\n            <t t-call="web.conditional_assets_tests"/>\n            <t t-call-assets="web.assets_common_lazy" t-css="false" lazy_load="True"/>\n            <t t-call-assets="web.assets_frontend_lazy" t-css="false" lazy_load="True"/>\n        </xpath>\n        <xpath expr="//t[@t-raw='0']" position="replace">\n            <div id="wrapwrap" t-attf-class="#{pageName or ''}">\n                <header t-if="not no_header" id="top" data-anchor="true">\n                    <img class="img-responsive d-block mx-auto" t-attf-src="/web/binary/company_logo" alt="Logo"/>\n                </header>\n                <main>\n
1638	report_pmbdian_surat_rujukan	\N	ehealth_document.report_pmbdian_surat_rujukan	16	qweb	<?xml version="1.0"?>\n<t t-name="ehealth_document.report_pmbdian_surat_rujukan">\n        <t t-set="company" t-value="res_company"/>\n        <t t-call="ehealth_document.header_pmbdian_document">\n          <t t-set="o" t-value="o.with_context(lang=lang)"/> \n          <div class="page">\n            <div class="row">\n              <div class="col-md-12" style="margin-top: 80px">\n                <p class="text-center mt-3 mb-0"><strong>SURAT RUJUKAN</strong></p>\n                <p class="text-center">Nomor: <t t-esc="o['name']"/></p>\n                <div class="mt-3 ml-3 mb-3">\n                    <div class="row">\n                        <div class="col-2">Kepada Yth.</div>\n                        <div class="col-7">: <t t-esc="data['tujuan-surat']"/></div>\n                    </div>\n                    <div class="row">\n                        <div class="col-2">di</div>\n                        <div class="col-7">: <t t-esc="data['tempat-tujuan-surat']"/></div>\n                    </div>\n                </div>\n                <p class="mt-5">Mohon pemeriksaan / pengobatan lebih lanjut terhadap pasien:</p>\n                <div class="mt-3 ml-3">\n                    <div class="row">\n                        <div class="col-4">Nama</div>\n                        <div class="col-5">: <strong><t t-esc="o['partner_id']['name']"/></strong></div>\n                    </div>\n                    <div class="row">\n                        <div class="col-4">Tanggal Lahir</div>\n                        <div class="col-5">: <t t-esc="o['partner_id']['birthDate'].strftime('%d-%m-%Y')"/></div>\n                    </div>\n                    <div class="row">\n                        <div class="col-4">Jenis Kelamin</div>\n                        <div class="col-5">: \n                          <t t-if="o['partner_id']['gender'] == 'male'">Laki-Laki</t>\n                          <t t-else="">Perempuan</t>\n                        </div>\n                    </div>\n                    <div class="row">\n                        <div class="col-4">Alamat</div>\n                        <div class="col-8">: <t t-esc="o['partner_id']['street']"/></div>\n                    </div>\n                    <div class="row">\n                        <div class="col-4">Diagnosa</div>\n                        <div class="col-8">: <t t-esc="data['diagnosa']"/></div>\n                    </div>\n                    <div class="row">\n                        <div class="col-4">Pemeriksaan yang diperlukan</div>\n                        <div class="col-8">: <strong><t t-esc="data['keterangan-pemeriksaan']"/></strong></div>\n                    </div>\n                </div>\n                <p class="mt-3 mb-2">Demikian surat rujukan ini, atas kerjasama dan perhatiannya kami ucapkan terimakasih.</p><br/>\n\n                <t t-if="data['catatan'] != '-'">\n                  <p class="mb-0"><strong>Catatan:</strong></p>\n                  <p><t t-esc="data['catatan']"/></p>\n                </t>\n              </div>\n            </div>\n\n            <div class="row pt-5">\n                <div class="col-8"/>\n                <div class="col-5">\n                    <p class="mb-0"><t t-esc="o['operating_unit_id']['company_id']['city']"/>, <t t-esc="o.to_date_string(data['registration_date'])"/></p>\n                    <p class="mb-0">Salam Hormat</p>\n                    <!-- <img t-att-src="o['qr_code_url']" style="width:125px;height:125px;"/> -->\n                    <div style="width:125px; height:125px;"/>\n                    <!-- <t t-if="'examiner_name' in data">\n                      <t t-esc="data['examiner_name']"/>\n                    </t>\n                    <t t-else="">\n                      <t t-esc="data['sender']"/>\n                    </t> -->\n                    <p>Dian Indah Wahyuningsih, S.Tr.Keb.</p>\n                    <hr style="margin: 0; color: #000;"/>\n                    <p class="mb-0 mt-2" style="font-size: 10px; margin: 0;"><strong>No. SIP: </strong></p>\n                </div>\n            </div>\n          </div>\n        </t>\n      </t>\n    	ehealth_document/report/template_surat_rujukan/report_pmbdian_surat_rujukan.xml	\N	\N	\N	\N	primary	t	1	2025-08-28 11:34:01.364376	1	2025-08-28 11:34:01.364376	f
725	Common Report	account.common.report	\N	16	form	<?xml version="1.0"?>\n<form string="Report Options">\n            <group col="4">\n                <field name="target_move" widget="radio"/>\n                <field name="date_from"/>\n                <field name="date_to"/>\n            </group>\n            <group>\n                <field name="journal_ids" widget="many2many_tags" options="{'no_create': True}"/>\n                <field name="company_id" options="{'no_create': True}" groups="base.group_multi_company"/>\n            </group>\n            <footer>\n                <button name="check_report" string="Print" type="object" default_focus="1" class="oe_highlight"/>\n                <button string="Cancel" class="btn btn-secondary" special="cancel"/>\n            </footer>\n        </form>\n        	account/wizard/account_report_common_view.xml	\N	\N	\N	\N	primary	t	1	2025-08-28 11:32:28.994214	1	2025-08-28 11:32:28.994214	f
726	report_journal	\N	account.report_journal	16	qweb	<?xml version="1.0"?>\n<t t-name="account.report_journal">\n    <t t-call="web.html_container">\n        <t t-set="data_report_margin_top" t-value="12"/>\n        <t t-set="data_report_header_spacing" t-value="9"/>\n        <t t-set="data_report_dpi" t-value="110"/>\n        <t t-foreach="docs" t-as="o">\n            <t t-call="web.internal_layout">\n                <div class="page">\n                    <h2><t t-esc="o.name"/> Journal</h2>\n\n                    <div class="row mt32">\n                        <div class="col-3">\n                            <strong>Company:</strong>\n                            <p t-esc="(company_id or res_company).name"/>\n                        </div>\n                        <div class="col-3">\n                            <strong>Journal:</strong>\n                            <p t-esc="o.name"/>\n                        </div>\n                        <div class="col-3">\n                            <strong>Entries Sorted By:</strong>\n                            <p t-if="data['form'].get('sort_selection') == 'move_name'">Journal Entry Number</p>\n                            <p t-if="data['form'].get('sort_selection') == 'date'">Date</p>\n                        </div>\n                        <div class="col-3">\n                            <strong>Target Moves:</strong>\n                            <p t-if="data['form']['target_move'] == 'all'">All Entries</p>\n                            <p t-if="data['form']['target_move'] == 'posted'">All Posted Entries</p>\n                        </div>\n                    </div>\n\n                    <table class="table table-sm">\n                        <thead>\n                            <tr>\n                                <th>Move</th>\n                                <th>Date</th>\n                                <th>Account</th>\n                                <th>Partner</th>\n                                <th>Label</th>\n                                <th>Debit</th>\n                                <th>Credit</th>\n                                <th t-if="data['form']['amount_currency']">Currency</th>\n                            </tr>\n                        </thead>\n                        <tbody>\n                            <tr t-foreach="lines[o.id]" t-as="aml">\n                                <td><span t-esc="aml.move_id.name != '/' and aml.move_id.name or ('*'+str(aml.move_id.id))"/></td>\n                                <td><span t-field="aml.date"/></td>\n                                <td><span t-field="aml.account_id.code"/></td>\n                                <td><span t-esc="aml.sudo().partner_id and aml.sudo().partner_id.name and aml.sudo().partner_id.name[:23] or ''"/></td>\n                                <td><span t-esc="aml.name and aml.name[:35]"/></td>\n                                <td><span t-esc="aml.debit" t-options="{'widget': 'monetary', 'display_currency': (company_id or res_company).currency_id}"/></td>\n                                <td><span t-esc="aml.credit" t-options="{'widget': 'monetary', 'display_currency': (company_id or res_company).currency_id}"/></td>\n                                <td t-if="data['form']['amount_currency'] and aml.amount_currency">\n                                    <span t-esc="aml.amount_currency" t-options="{'widget': 'monetary', 'display_currency': aml.currency_id}"/>\n                                </td>\n                            </tr>\n                        </tbody>\n                    </table>\n\n                    <div class="row justify-content-end">\n                        <div class="col-4">\n                            <table class="table table-sm">\n                                <tr>\n                                    <td><strong>Total</strong></td>\n                                    <td><span t-esc="sum_debit(data, o)" t-options="{'widget': 'monetary', 'display_currency': (company_id or res_company).currency_id}"/></td>\n                                    <td><span t-esc="sum_credit(data, o)" t-options="{'widget': 'monetary', 'display_currency': (company_id or res_company).currency_id}"/></td>\n                                </tr>\n                            </table>\n                        </div>\n                    </div>\n\n                    <div class="row">\n                        <div class="col-4">\n                            <table class="table table-sm">\n                                <thead>\n                                    <tr><th colspan="3">Tax Declaration</th></tr>\n                                    <tr>\n                                        <th>Name</th>\n                                        <th>Base Amount</th>\n                                        <th>Tax Amount</th>\n                                    </tr>\n                                </thead>\n                                <tbody>\n                                    <t t-set="taxes" t-value="get_taxes(data, o)"/>\n                                    <tr t-foreach="taxes" t-as="tax">\n                                        <td><span t-esc="tax.name"/></td>\n                                        <td><span t-esc="taxes[tax]['base_amount']" t-options="{'widget': 'monetary', 'display_currency': (company_id or res_company).currency_id}"/></td>\n                                        <td><span t-esc="taxes[tax]['tax_amount']" t-options="{'widget': 'monetary', 'display_currency': (company_id or res_company).currency_id}"/></td>\n                                    </tr>\n                                </tbody>\n                            </table>\n                        </div>\n                    </div>\n\n                </div>\n            </t>\n        </t>\n    </t>\n</t>\n	account/views/report_journal.xml	\N	\N	\N	\N	primary	t	1	2025-08-28 11:32:28.994214	1	2025-08-28 11:32:28.994214	f
727	tax.adjustments.wizard.form	tax.adjustments.wizard	\N	16	form	<?xml version="1.0"?>\n<form>\n            <h1>\n                <field name="reason" class="oe_inline" placeholder="Reason..."/>\n            </h1>\n            <group>\n                <field name="report_id" invisible="1"/>\n                <field name="tax_report_line_id" widget="selection"/>\n            </group>\n            <group>\n                <group>\n                    <field name="amount"/>\n                </group>\n                <group>\n                    <field name="adjustment_type"/>\n                </group>\n                <group string="Accounts">\n                    <field name="debit_account_id"/>\n                    <field name="credit_account_id"/>\n                </group>\n                <group string="Options">\n                    <field name="journal_id"/>\n                    <field name="date"/>\n                </group>\n            </group>\n            <footer>\n                <button name="create_move" string="Create and post move" type="object" default_focus="1" class="oe_highlight"/>\n                <button string="Cancel" class="btn btn-secondary" special="cancel"/>\n            </footer>\n        </form>\n        	account/wizard/wizard_tax_adjustments_view.xml	\N	\N	\N	\N	primary	t	1	2025-08-28 11:32:28.994214	1	2025-08-28 11:32:28.994214	f
1639	report_default_surat_rujukan_ibu	\N	ehealth_document.report_default_surat_rujukan_ibu	16	qweb	<?xml version="1.0"?>\n<t t-name="ehealth_document.report_default_surat_rujukan_ibu">\n        <t t-set="company" t-value="res_company"/>\n        <t t-call="web.external_layout">\n          <t t-set="o" t-value="o.with_context(lang=lang)"/> \n          <div class="page">\n            <div class="row">\n              <div class="col-md-12">\n                <p class="text-center mt-3 mb-0"><strong>SURAT KETERANGAN RUJUKAN</strong></p>\n                <p class="text-center">No: <t t-esc="o['name']"/></p>\n                <div class="mt-3 ml-3 mb-3">\n                    <div class="row">\n                        <div class="col-2">Kepada Yth.</div>\n                        <div class="col-7">: <t t-esc="data['tujuan-surat']"/></div>\n                    </div>\n                </div>\n                <p class="mt-5">Dengan hormat</p>\n                <p>Bersama ini kami kirim seorang pasien:</p>\n                <div class="mt-3 ml-3">\n                    <div class="row">\n                        <div class="col-4">Nama</div>\n                        <div class="col-5">: <t t-esc="o['partner_id']['name']"/></div>\n                    </div>\n                    <div class="row">\n                        <div class="col-4">Umur</div>\n                        <div class="col-5">: <t t-esc="o.count_age(o['partner_id']['birthDate'].strftime('%d/%m/%Y'))"/> tahun</div>\n                    </div>\n                    <div class="row">\n                        <div class="col-4">Pekerjaan</div>\n                        <div class="col-5">: <t t-if="'occupation' in data"> <t t-esc="data['occupation']"/> </t></div>\n                    </div>\n                    <div class="row">\n                        <div class="col-4">Alamat</div>\n                        <div class="col-8">: <t t-esc="o['partner_id']['street']"/></div>\n                    </div>\n                    <div>Subyektif Data</div>\n                    <div class="row">\n                        <div class="col-4">Keluhan Utama</div>\n                        <div class="col-8">: <t t-esc="data['anamnese-manual']"/></div>\n                    </div>\n                    <div>Fisik</div>\n                    <div class="row">\n                        <div class="col-4">Keadaan Umum</div>\n                        <div class="col-8">: <t t-esc="data['general-condition']"/></div>\n                    </div>\n                    <div class="row">\n                        <div class="col-4">Inspeksi</div>\n                        <div class="col-8">: <t t-esc="data['inspection']"/></div>\n                    </div>\n                    <div class="row">\n                        <div class="col-4">Palpasi</div>\n                        <div class="col-8">: L1: <t t-esc="data['palpation-l1']"/>cm</div>\n                    </div>\n                    <div class="row">\n                        <div class="col-4"/>\n                        <div class="col-8">  L2: <t t-esc="data['palpation-l2']"/></div>\n                    </div>\n                    <div class="row">\n                        <div class="col-4"/>\n                        <div class="col-8">  L3: <t t-esc="data['palpation-l3']"/></div>\n                    </div>\n                    <div class="row">\n                        <div class="col-4"/>\n                        <div class="col-8">  L4: <t t-esc="data['palpation-l4']"/></div>\n                    </div>\n                    <div class="row">\n                        <div class="col-4"/>\n                        <div class="col-8">  DJJ: <t t-esc="data['palpation-djj']"/></div>\n                    </div>\n                    <div class="row">\n                        <div class="col-4">Pemeriksaan Dalam</div>\n                        <div class="col-8"><t t-esc="data['detail-inspection']"/></div>\n                    </div>\n                    <div class="row">\n                        <div class="col-4">HPHT</div>\n                        <div class="col-8">: <t t-esc="data['hpht']"/></div>\n                    </div>\n                    <div class="row">\n                        <div class="col-4">HPL</div>\n                        <div class="col-8">: <t t-esc="data['hpl']"/></div>\n                    </div>\n                    <div class="row">\n                        <div class="col-4">Assesment / Diagnosa</div>\n                        <div class="col-8">: <t t-esc="data['diagnosa']"/></div>\n                    </div>\n                </div>\n                <p class="mt-3 mb-2">Demikian kami sampaikan mohon perawatan, kolaborasi / kosultasi dan tindakan medis selanjutnya, Atas kerjasamanya kami ucapkan terima kasih.</p><br/>\n              </div>\n            </div>\n\n            <div class="row pt-5">\n                <div class="col-8"/>\n                <div class="col-5">\n                    <p class="mb-0"><t t-esc="o['operating_unit_id']['company_id']['city']"/>, <t t-esc="o.to_date_string(data['registration_date'])"/></p>\n                    <p class="mb-0">BIDAN</p>\n                    <!-- <img t-att-src="o['qr_code_url']" style="width:125px;height:125px;"/> -->\n                    <div style="width:125px; height:125px;"/>\n                    <t t-if="'examiner_name' in data">\n                      <t t-esc="data['examiner_name']"/>\n                    </t>\n                    <t t-else="">\n                      <t t-esc="data['sender']"/>\n                    </t>\n                </div>\n            </div>\n          </div>\n        </t>\n      </t>\n    	ehealth_document/report/template_surat_rujukan_ibu/report_default_rujukan_ibu.xml	\N	\N	\N	\N	primary	t	1	2025-08-28 11:34:01.364376	1	2025-08-28 11:34:01.364376	f
731	Show Invoices & Bills	\N	account.portal_my_home_invoice	30	qweb	<?xml version="1.0"?>\n<data name="Show Invoices &amp; Bills" inherit_id="portal.portal_my_home" customize_show="True" priority="30">\n        <xpath expr="//div[hasclass('o_portal_docs')]" position="inside">\n            <t t-call="portal.portal_docs_entry">\n                <t t-set="title">Invoices &amp; Bills</t>\n                <t t-set="url" t-value="'/my/invoices'"/>\n                <t t-set="placeholder_count" t-value="'invoice_count'"/>\n            </t>\n        </xpath>\n    </data>\n\n    	account/views/account_portal_templates.xml	\N	\N	532	\N	extension	t	1	2025-08-28 11:32:28.994214	1	2025-08-28 11:32:28.994214	t
732	My Invoices and Payments	\N	account.portal_my_invoices	16	qweb	<?xml version="1.0"?>\n<t name="My Invoices and Payments" t-name="account.portal_my_invoices">\n      <t t-call="portal.portal_layout">\n        <t t-set="breadcrumbs_searchbar" t-value="True"/>\n\n        <t t-call="portal.portal_searchbar">\n            <t t-set="title">Invoices</t>\n        </t>\n        <t t-if="not invoices">\n            <p>There are currently no invoices and payments for your account.</p>\n        </t>\n        <t t-if="invoices" t-call="portal.portal_table">\n            <thead>\n                <tr class="active">\n                    <th>Invoice #</th>\n                    <th>Invoice Date</th>\n                    <th class="d-none d-md-table-cell">Due Date</th>\n                    <th/>\n                    <th class="text-right">Amount Due</th>\n                </tr>\n            </thead>\n            <tbody>\n                <t t-foreach="invoices" t-as="invoice">\n                    <tr>\n                        <td>\n                            <a t-att-href="invoice.get_portal_url()" t-att-title="invoice.name">\n                                <t t-esc="invoice.name" t-if="invoice.name != '/'"/>\n                                <em t-else="">Draft Invoice</em>\n                            </a>\n                        </td>\n                        <td><span t-field="invoice.invoice_date"/></td>\n                        <td class="d-none d-md-table-cell"><span t-field="invoice.invoice_date_due"/></td>\n                        <td class="tx_status">\n                            <t t-if="invoice.state == 'posted' and invoice.payment_state not in ('in_payment', 'paid', 'reversed')">\n                                <span class="badge badge-pill badge-info"><i class="fa fa-fw fa-clock-o" aria-label="Opened" title="Opened" role="img"/><span class="d-none d-md-inline"> Waiting for Payment</span></span>\n                            </t>\n                            <t t-if="invoice.state == 'posted' and invoice.payment_state in ('paid', 'in_payment')">\n                                <span class="badge badge-pill badge-success"><i class="fa fa-fw fa-check" aria-label="Paid" title="Paid" role="img"/><span class="d-none d-md-inline"> Paid</span></span>\n                            </t>\n                            <t t-if="invoice.state == 'posted' and invoice.payment_state == 'reversed'">\n                                <span class="badge badge-pill badge-success"><i class="fa fa-fw fa-check" aria-label="Reversed" title="Reversed" role="img"/><span class="d-none d-md-inline"> Reversed</span></span>\n                            </t>\n                            <t t-if="invoice.state == 'cancel'">\n                                <span class="badge badge-pill badge-warning"><i class="fa fa-fw fa-remove" aria-label="Cancelled" title="Cancelled" role="img"/><span class="d-none d-md-inline"> Cancelled</span></span>\n                            </t>\n                        </td>\n                        <td class="text-right"><span t-esc="-invoice.amount_residual if invoice.move_type == 'out_refund' else invoice.amount_residual" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: invoice.currency_id}"/></td>\n                    </tr>\n                </t>\n            </tbody>\n        </t>\n      </t>\n    </t>\n\n    	account/views/account_portal_templates.xml	\N	\N	\N	\N	primary	t	1	2025-08-28 11:32:28.994214	1	2025-08-28 11:32:28.994214	f
1640	report_default_lab	\N	ehealth_document.report_default_lab	16	qweb	<?xml version="1.0"?>\n<t t-name="ehealth_document.report_default_lab">\n        <t t-set="company" t-value="res_company"/>\n        <t t-call="web.external_layout">\n          <t t-set="o" t-value="o.with_context(lang=lang)"/> \n          <div class="page">\n            <div class="row">\n              <div class="col-md-12">\n                <div>\n                    <div class="row">\n                        <div class="col-5"/>\n                        <div class="col-3">Dokter Penanggungjawab</div>\n                        <div class="col-4">: dr. eHealth </div>\n                    </div>\n                    <div class="row">\n                        <div class="col-5"/>\n                        <div class="col-3">No. SIP</div>\n                        <div class="col-4" style="font-size: 11px;">: 0000.00000/XX.0000/00/000.0/000/X/0000 </div>\n                    </div>\n                    <br/>\n                    <div class="row">\n                        <div class="col-5"/>\n                        <div class="col-3">Nama</div>\n                        <div class="col-4">: <t t-esc="o['partner_id']['name']"/></div>\n                    </div>\n                    <div class="row">\n                        <div class="col-5"/>\n                        <div class="col-3">No. Sample</div>\n                        <div class="col-4">: </div>\n                    </div>\n                    <div class="row">\n                        <div class="col-5"/>\n                        <div class="col-3">Umur / JK</div>\n                        <div class="col-4">: <t t-esc="o.count_age(o['partner_id']['birthDate'].strftime('%d/%m/%Y'))"/> Tahun / \n                          <t t-if="o['partner_id']['gender'] == 'male'">Laki-Laki</t>\n                          <t t-else="">Perempuan</t>\n                        </div>\n                    </div>\n                    <div class="row">\n                        <div class="col-5"/>\n                        <div class="col-3">Alamat</div>\n                        <div class="col-4">: <t t-esc="o['partner_id']['street']"/></div>\n                    </div>\n                </div>\n                <p class="text-center mt-3 mb-0"><strong>HASIL PEMERIKSAAN LABORATORIUM</strong></p>\n                <p class="text-center">Nomor: <t t-esc="o['name']"/></p>                \n\n                <table class="table table-bordered table-sm mt-1">\n                  <tr class="text-center">\n                      <th>Pemeriksaan</th>\n                      <th>Hasil</th>\n                      <th>Nilai Rujukan</th>\n                      <th>Satuan</th>\n                  </tr>\n                  <t t-foreach="data['observation']" t-as="obs">\n                    <tr>\n                        <td colspan="4"><strong><t t-esc="obs.upper()"/></strong></td>\n                    </tr>\n                    \n                    <t t-foreach="data['observation'].get(obs)" t-as="obs_item">\n                      <tr>\n                        <td colspan="4"><strong><t t-esc="obs_item['name']"/></strong></td>\n                      </tr>\n                      <t t-foreach="obs_item['items']" t-as="item">\n                        <tr>\n                          <td><t t-esc="item['name']"/></td>                          \n                          <td><t t-esc="item['value']"/></td>\n                          <td><t t-esc="item['reference']"/></td>\n                          <td><t t-esc="item['unit']"/></td>\n                        </tr>\n                      </t>\n                    </t>\n\n                    <tr>\n                        <td colspan="4"/>\n                    </tr>\n                  </t>\n                </table>\n              </div>\n            </div>\n\n            <div class="row pt-5" style="page-break-inside: avoid; page-break-before: auto;">\n                <div class="col-1"/>\n                <div class="col-3 py-3 mt-4">\n                    <div class="my-3" id="qrcode">\n                        <img t-att-src="o['qr_code_url']" style="width:125px;height:125px;"/>\n                    </div>\n                </div>\n                <div class="col-4"/>\n                <div class="col-4 py-3">\n                    <p>Semarang, <t t-esc="o.to_date_string(data['registration_date'])"/></p>\n                    <div class="my-3" id="qrcode">\n                        <img t-att-src="data['signature']" style="width:125px;height:125px;"/>\n                    </div>\n                    <p><strong>dr. eHealth</strong></p>\n                </div>\n            </div>\n          </div>\n        </t>\n      </t>\n    	ehealth_document/report/template_laboratory/report_default_lab.xml	\N	\N	\N	\N	primary	t	1	2025-08-28 11:34:01.364376	1	2025-08-28 11:34:01.364376	f
733	Invoice Portal Template	\N	account.portal_invoice_page	16	qweb	<?xml version="1.0"?>\n<data name="Invoice Portal Template" inherit_id="portal.portal_sidebar" primary="True">\n        <xpath expr="//div[hasclass('o_portal_sidebar')]" position="inside">\n            <t t-set="o_portal_fullwidth_alert" groups="sales_team.group_sale_salesman,account.group_account_invoice,account.group_account_readonly">\n                <t t-call="portal.portal_back_in_edit_mode">\n                    <t t-set="backend_url" t-value="'/web#model=%s&amp;id=%s&amp;action=%s&amp;view_type=form' % (invoice._name, invoice.id, invoice.env.ref('account.action_move_out_invoice_type').id)"/>\n                </t>\n            </t>\n\n            <div class="row mt16 o_portal_invoice_sidebar">\n                <!-- Sidebar -->\n                <t t-call="portal.portal_record_sidebar">\n                    <t t-set="classes" t-value="'col-lg-auto d-print-none'"/>\n                    <t t-set="title">\n                        <h2 class="mb-0">\n                            <b t-if="invoice.amount_residual &gt; 0" t-field="invoice.amount_residual"/>\n                            <b t-else="1" t-field="invoice.amount_total"/>\n                        </h2>\n                        <div class="small" t-if="invoice.payment_state not in ('paid', 'in_payment') and invoice.move_type == 'out_invoice'"><i class="fa fa-clock-o"/><span class="o_portal_sidebar_timeago ml4" t-att-datetime="invoice.invoice_date_due"/></div>\n                    </t>\n\n                    <t t-set="entries">\n                        <ul class="list-group list-group-flush flex-wrap flex-row flex-lg-column">\n                            <li class="list-group-item flex-grow-1">\n                                <div class="o_download_pdf btn-toolbar flex-sm-nowrap">\n                                    <div class="btn-group  flex-grow-1 mr-1 mb-1">\n                                        <a class="btn btn-secondary btn-block o_download_btn" t-att-href="invoice.get_portal_url(report_type='pdf', download=True)" title="Download"><i class="fa fa-download"/> Download</a>\n                                    </div>\n                                    <div class="btn-group flex-grow-1 mb-1">\n                                        <a class="btn btn-secondary btn-block o_print_btn o_portal_invoice_print" t-att-href="invoice.get_portal_url(report_type='pdf')" id="print_invoice_report" title="Print" target="_blank"><i class="fa fa-print"/> Print</a>\n                                    </div>\n                                </div>\n                            </li>\n                            <li t-if="invoice.invoice_user_id" class="list-group-item flex-grow-1">\n                                <div class="small mb-1"><strong class="text-muted">\n                                    <t t-if="invoice.move_type == 'out_invoice'">\n                                        Salesperson\n                                    </t>\n                                    <t t-if="invoice.move_type == 'in_invoice'">\n                                        Purchase Representative\n                                    </t>\n                                </strong></div>\n                                <div class="row">\n                                    <div class="col flex-grow-0 pr-2">\n                                        <img t-if="invoice.invoice_user_id.image_1024" class="rounded-circle mt-1 o_portal_contact_img" t-att-src="image_data_uri(invoice.invoice_user_id.image_1024)" alt="Contact"/>\n                                        <img t-else="" class="rounded-circle mt-1 o_portal_contact_img" src="/web/static/src/img/user_menu_avatar.png" alt="Contact"/>\n                                    </div>\n                                    <div class="col pl-0">\n                                        <span t-field="invoice.invoice_user_id" t-options="{&quot;widget&quot;: &quot;contact&quot;, &quot;fields&quot;: [&quot;name&quot;, &quot;phone&quot;], &quot;no_marker&quot;: True}"/>\n                                        <a href="#discussion" class="small"><i class="fa fa-fw fa-comments"/><b>Send message</b></a>\n                                    </div>\n                                </div>\n                            </li>\n                        </ul>\n                    </t>\n                </t>\n\n                <!-- Page Content -->\n                <div id="invoice_content" class="col-12 col-lg">\n                    <t t-if="error or warning" t-call="account.portal_invoice_error"/>\n                    <t t-if="success and (not error and not warning)" t-call="account.portal_invoice_success"/>\n\n                    <div class="o_portal_html_view shadow p-3">\n                        <div class="o_portal_html_loader text-center">\n                            <i class="fa fa-circle-o-notch fa-spin fa-2x fa-fw text-black-50"/>\n                        </div>\n                        <iframe id="invoice_html" class="mt8 mb8" width="100%" height="100%" frameborder="0" scrolling="no" t-att-src="invoice.get_portal_url(report_type='html')"/>\n                    </div>\n                    <!-- chatter -->\n                    <div id="invoice_communication" class="mt-4">\n                        <h2>History</h2>\n                        <t t-call="portal.message_thread">\n                            <t t-set="object" t-value="invoice"/>\n                        </t>\n                    </div>\n                </div>\n            </div>\n        </xpath>\n    <xpath expr="." position="attributes"><attribute name="t-name">account.portal_invoice_page</attribute></xpath></data>\n\n    	account/views/account_portal_templates.xml	\N	\N	546	\N	primary	t	1	2025-08-28 11:32:28.994214	1	2025-08-28 11:32:28.994214	f

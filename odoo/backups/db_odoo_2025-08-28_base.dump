609	account.move.line.tree.grouped	account.move.line	\N	1	tree	<?xml version="1.0"?>\n<tree string="Journal Items" create="false" expand="context.get('expand', False)" multi_edit="1">\n                    <field name="date" optional="show" readonly="1"/>\n                    <field name="company_id" groups="base.group_multi_company" options="{'no_create': True}" optional="show"/>\n                    <field name="move_id" optional="show"/>\n                    <field name="account_id" optional="show" options="{'no_open': True, 'no_create': True}" domain="[('company_id', '=', company_id)]" groups="account.group_account_readonly"/>\n                    <field name="statement_id" invisible="1"/>\n                    <field name="partner_id" optional="show" readonly="1"/>\n                    <field name="ref" optional="hide"/>\n                    <field name="name"/>\n                    <field name="reconciled" invisible="1"/>\n                    <field name="matching_number" string="Matching" optional="show"/>\n                    <field name="reconcile_model_id" invisible="1"/>\n                    <field name="date_maturity" optional="hide"/>\n                    <field name="analytic_account_id" optional="hide" groups="analytic.group_analytic_accounting" attrs="{'readonly':[('parent_state','=','posted')]}"/>\n                    <field name="analytic_tag_ids" optional="hide" widget="many2many_tags" readonly="1" groups="analytic.group_analytic_tags"/>\n                    <field name="debit" sum="Total Debit" readonly="1"/>\n                    <field name="credit" sum="Total Credit" readonly="1"/>\n                    <field name="balance" sum="Total Balance" readonly="1" optional="hide"/>\n                    <field name="amount_currency" readonly="1" groups="base.group_multi_currency"/>\n                    <field name="currency_id" readonly="1" groups="base.group_multi_currency" optional="hide" string="Original Currency"/>\n                    <field name="company_currency_id" invisible="1"/>\n                    <field name="parent_state" invisible="1"/>\n                    <field name="tax_ids" widget="many2many_tags" width="0.5" optional="hide" readonly="1"/>\n                    <field name="tax_tag_ids" widget="many2many_tags" width="0.5" optional="hide" string="Tax Grids" options="{'no_open': True, 'no_create': True}" domain="[('applicability', '=', 'taxes')]"/>\n                    <groupby name="move_id">\n                        <field name="state" invisible="1"/>\n                        <button name="edit" type="edit" icon="fa-edit" title="Edit"/>\n                        <button name="action_post" states="draft" icon="fa-check" title="Post" type="object" groups="account.group_account_invoice"/>\n                        <button name="196" states="posted" title="Reverse" icon="fa-refresh" type="action" groups="account.group_account_invoice"/>\n                        <button name="action_duplicate" icon="fa-files-o" title="Duplicate" type="object" groups="account.group_account_invoice"/>\n                    </groupby>\n                </tree>\n            	account/views/account_move_views.xml	\N	\N	\N	\N	primary	t	1	2025-08-28 11:32:28.994214	1	2025-08-28 11:32:28.994214	f
1560	report_emerald_surat_sakit	\N	ehealth_document.report_emerald_surat_sakit	16	qweb	<?xml version="1.0"?>\n<t t-name="ehealth_document.report_emerald_surat_sakit">\n        <t t-set="company" t-value="res_company"/>\n        <t t-call="ehealth_document.header_emerald_document">\n          <div class="page">\n            <div class="row">\n              <div class="col-md-12" style="font-size: 18px;">\n                <p class="text-center mt-2 mb-0" style="text-decoration: underline; font-size: 30px">\n                  <strong>SURAT KETERANGAN ISTIRAHAT</strong>\n                </p>\n                <p class="text-center" style="font-size: 20px;">Nomor: <t t-esc="o['name']"/></p>\n                <p class="mt-4">Yang bertanda tangan di bawah ini, Pimpinan Emerald Clinic &amp; Diagnostik Jambi, menerangkan bahwa:</p>\n                <div class="mt-4 ml-4">\n                  <div class="row pb-2">\n                    <div class="col-2">Nama</div>\n                    <div class="col-10">: <t t-esc="o['partner_id']['name']"/></div>\n                  </div>\n                  <div class="row pb-2">\n                    <div class="col-2">Usia</div>\n                    <div class="col-10">: <t t-esc="o.count_age(o['partner_id']['birthDate'].strftime('%d/%m/%Y'))"/> tahun</div>\n                  </div>\n                  <div class="row pb-2">\n                    <div class="col-2">Pekerjaan</div>\n                    <div class="col-10">: <t t-esc="o['partner_id']['function']"/></div>\n                  </div>\n                  <div class="row pb-2">\n                    <div class="col-2">Alamat</div>\n                    <div class="col-10">: <t t-esc="o['partner_id']['street']"/></div>\n                  </div>\n                </div>\n\n                <div class="mt-2">\n                  <div>Berhubungan dengan sakitnya, yang tersebut namanya diatas perlu diberi istirahat selama \n                    <strong><t t-esc="o.count_date_delta(data['tanggal-awal'],data['tanggal-akhir'])"/> hari</strong> \n                    terhitung sejak\n                    <strong><t t-esc="data['tanggal-awal']"/></strong> sampai dengan tanggal <strong><t t-esc="data['tanggal-akhir']"/></strong>\n                  </div>\n                </div>\n\n                <div class="mt-4">\n                  <div>Demikianlah surat keterangan ini dibuat untuk dapat dipergunakan seperlunya.</div>\n                </div>\n              </div>\n            </div>\n\n            <div class="row pt-5" style="font-size: 18px;">\n                <div class="col-7"/>\n                <div class="col-5">\n                    <p class="mb-0">Jambi, <t t-esc="o.to_date_string(data['registration_date'])"/></p>\n                    <p class="mb-0">A/N. Pimpinan Emerald Clinic &amp; Diagnostik - Jambi</p>\n                    <div class="mt-3">\n                        <div style="width:125px;height:125px;"/>\n                    </div>\n                    <p class="mb-0 mt-2"><strong>\n                    <t t-if="'examiner_name' in data">\n                      <t t-esc="data['examiner_name']"/>\n                    </t>\n                    <t t-else="">\n                      <t t-esc="data['sender']"/>\n                    </t>\n                    </strong></p>\n                </div>\n            </div>\n          </div>\n        </t>\n      </t>\n    	ehealth_document/report/template_surat_sakit/report_emerald_surat_sakit.xml	\N	\N	\N	\N	primary	t	1	2025-08-28 11:34:01.364376	1	2025-08-28 11:34:01.364376	f

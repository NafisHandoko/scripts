1481	report_jsc_antigen	\N	ehealth_document.report_jsc_antigen	16	qweb	<?xml version="1.0"?>\n<t t-name="ehealth_document.report_jsc_antigen">\n        <t t-set="company" t-value="res_company"/>\n        <t t-call="ehealth_document.layout_jsc_antigen">\n          <div class="page">\n            <div class="row">\n              <div class="col">\n                <table class="table table-bordered table-sm mb-0">\n                  <tr>\n                      <td width="50%">\n                          <table class="table table-borderless table-sm">\n                              <tr>\n                                  <th width="180">NAMA</th>\n                                  <th>: <t t-esc="o['partner_id']['name']"/></th>\n                              </tr>\n                              <tr>\n                                  <th>TANGGAL LAHIR</th>\n                                  <th>: <t t-esc="o['partner_id']['birthDate']"/></th>\n                              </tr>\n                              <tr>\n                                  <th>NIK</th>\n                                  <th>: <t t-esc="o['partner_id']['nik']"/></th>\n                              </tr>\n                          </table>\n                      </td>\n                      <td width="50%">\n                          <table class="table table-borderless table-sm">\n                              <tr>\n                                  <th width="180">STAFF MEDIS</th>\n                                  <th>: <t t-esc="data['practitioner']"/></th>\n                              </tr>\n                              <tr>\n                                  <th>NOMOR SURAT</th>\n                                  <th>: <t t-esc="o['name']"/></th>\n                              </tr>\n                              <tr>\n                                  <th>WAKTU PEMERIKSAAN</th>\n                                  <th>: <t t-esc="o.to_date_string(data['registration_date'])"/> <t t-esc="o.to_time_string(data['registration_date'])"/></th>\n                              </tr>\n                          </table>\n                      </td>\n                  </tr>\n                </table>\n                <table class="table table-bordered table-sm">\n                  <tr>\n                      <th colspan="5" class="text-center">HASIL PEMERIKSAAN</th>\n                  </tr>\n                  <tr class="text-center">\n                      <th>PEMERIKSAAN</th>\n                      <th>HASIL</th>\n                      <th>NILAI RUJUKAN</th>\n                      <th>SATUAN</th>\n                      <th>KETERANGAN</th>\n                  </tr>\n                  <tr>\n                      <td><t t-esc="data['examination_type']"/></td>\n                      <td rowspan="2" width="130" class="text-center">\n                        <strong>\n                          <t t-if="data['result'] == 'Positive'">\n                            <span style="color:red">\n                               <t t-esc="data['result']"/>\n                            </span>\n                          </t>\n                          <t t-if="data['result'] == 'Negative'">\n                            <span>\n                               <t t-esc="data['result']"/>\n                            </span>\n                          </t>\n                        </strong>\n                      </td>\n                      <td rowspan="2" class="text-center">Negative</td>\n                      <td rowspan="2"/>\n                      <td width="300" rowspan="2">\n                          <p>Metode : Rapid Antigen Covid-19 Nasal Swab</p>\n                          <p>Intepretasi Hasil:</p>\n                          <p>Jika hasil Positive\n                          Material genetic SARS-CoV-2 terdeteksi dalam specimen.\n                          Saran :\n                              - Lanjutkan dengan pemeriksaan konfirmasi PCR.\n                              - Tetap lakukan social distancing / isolasi diri.</p>\n                          <p>Jika hasil Negative\n                          Material genetic SARS-CoV-2 tidak terdeteksi dalam specimen.\n                          Catatan:\n                          Hasil Negatif tidak menyingkirkan kemungkinan terinfeksi SARS-CoV-2 sehingga masih beresiko menularkan ke orang lain.</p>\n                      </td>\n                  </tr>\n                  <tr>\n                      <td>Swab Nasofaring / Orofaring</td>\n                  </tr>\n                </table>\n                  <table class="table table-borderless table-sm">\n                      <tr>\n                          <td class="text-right">Spesimen</td>\n                          <th class="text-center" width="200">: SW</th>\n                          <td class="text-right">Acc</td>\n                          <th width="400">: </th>\n                      </tr>\n                  </table>\n              </div>\n            </div>\n\n            <div class="row pt-5">\n                <div class="col-5 py-3">\n                    <div class="text-center my-3" id="qrcode">\n                        <img t-att-src="o['qr_code_url']" style="width:125px;height:125px;"/>\n                    </div>\n                </div>\n              <div class="col-4 offset-3">\n                  <img t-att-src="data['signature']" style="height: 125px;"/>\n                  <p>Tanggal: <t t-esc="o.to_date_string(data['registration_date'])"/></p>\n              </div>\n            </div>\n          </div>\n        </t>\n      </t>\n    	ehealth_document/report/template_covid_report/report_jsc_antigen.xml	\N	\N	\N	\N	primary	t	1	2025-08-28 11:34:01.364376	1	2025-08-28 11:34:01.364376	f

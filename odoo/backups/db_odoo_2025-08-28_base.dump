1705	ubl_20_PaymentMeansType	\N	account_edi_ubl_cii.ubl_20_PaymentMeansType	16	qweb	<?xml version="1.0"?>\n<t t-name="account_edi_ubl_cii.ubl_20_PaymentMeansType">\n        <t xmlns="urn:oasis:names:specification:ubl:schema:xsd:Invoice-2" xmlns:cac="urn:oasis:names:specification:ubl:schema:xsd:CommonAggregateComponents-2" xmlns:cbc="urn:oasis:names:specification:ubl:schema:xsd:CommonBasicComponents-2">\n            <cbc:PaymentMeansCode t-att="vals.get('payment_means_code_attrs', {})" t-esc="vals.get('payment_means_code')"/>\n            <cbc:PaymentDueDate t-esc="vals.get('payment_due_date')"/>\n            <cbc:InstructionID t-esc="vals.get('instruction_id')"/>\n            <t t-foreach="vals.get('payment_id_vals', [])" t-as="payment_id">\n                <cbc:PaymentID t-esc="payment_id"/>\n            </t>\n            <cac:PayeeFinancialAccount>\n                <t t-set="payee_financial_account_vals" t-value="vals.get('payee_financial_account_vals', {})"/>\n                <cbc:ID t-att="payee_financial_account_vals.get('id_attrs', {})" t-esc="payee_financial_account_vals.get('id')"/>\n                <cac:FinancialInstitutionBranch>\n                    <t t-set="financial_institution_branch_vals" t-value="payee_financial_account_vals.get('financial_institution_branch_vals', {})"/>\n                    <cbc:ID t-att="financial_institution_branch_vals.get('id_attrs', {})" t-esc="financial_institution_branch_vals.get('id')"/>\n                    <cac:FinancialInstitution>\n                        <t t-set="financial_institution_vals" t-value="financial_institution_branch_vals.get('financial_institution_vals', {})"/>\n                        <cbc:ID t-att="financial_institution_vals.get('id_attrs', {})" t-esc="financial_institution_vals.get('id')"/>\n                        <cbc:Name t-esc="financial_institution_vals.get('name')"/>\n                        <cac:Address>\n                            <t t-call="{{AddressType_template}}">\n                                <t t-set="vals" t-value="financial_institution_vals.get('address_vals', {})"/>\n                            </t>\n                        </cac:Address>\n                    </cac:FinancialInstitution>\n                </cac:FinancialInstitutionBranch>\n            </cac:PayeeFinancialAccount>\n        </t>\n    </t>\n\n    	account_edi_ubl_cii/data/ubl_20_templates.xml	\N	\N	\N	\N	primary	t	1	2025-08-28 11:34:13.779942	1	2025-08-28 11:34:13.779942	f

('%d-%m-%Y')"/> (<t t-esc="o.count_age(o.patient.birthDate.strftime('%d/%m/%Y'))"/> Tahun)</td></tr>\n                    <tr><td style="width: 100px;">Kategori</td><td>: <t t-esc="o.patient.category"/></td></tr>\n                    <tr><td style="width: 100px;">No. RM</td><td>: <t t-esc="o.compositionId"/></td></tr>\n                  </table>\n                </div>\n              </t>\n            </t>\n        </t>\n    	ehealth_document/report/template_prescription/template_prescription_senopatiskincenter.xml	\N	\N	\N	\N	primary	t	1	2025-08-28 11:34:01.364376	1	2025-08-28 11:34:01.364376	f

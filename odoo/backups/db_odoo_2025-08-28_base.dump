1085	Show Purchase Orders	\N	purchase.portal_my_home_purchase	25	qweb	<?xml version="1.0"?>\n<data name="Show Purchase Orders" customize_show="True" inherit_id="portal.portal_my_home" priority="25">\n    <xpath expr="//div[hasclass('o_portal_docs')]" position="inside">\n        <t t-call="portal.portal_docs_entry">\n            <t t-set="title">Purchase Orders</t>\n            <t t-set="url" t-value="'/my/purchase'"/>\n            <t t-set="placeholder_count" t-value="'purchase_count'"/>\n        </t>\n    </xpath>\n  </data>\n\n  	purchase/views/portal_templates.xml	\N	\N	532	\N	extension	t	1	2025-08-28 11:33:08.048846	1	2025-08-28 11:33:08.048846	t
1086	Portal: My Purchase Orders	\N	purchase.portal_my_purchase_orders	16	qweb	<?xml version="1.0"?>\n<t name="Portal: My Purchase Orders" t-name="purchase.portal_my_purchase_orders">\n    <t t-call="portal.portal_layout">\n      <t t-set="breadcrumbs_searchbar" t-value="True"/>\n      <t t-call="portal.portal_searchbar"/>\n      <t t-if="orders" t-call="portal.portal_table">\n        <thead>\n          <tr class="active">\n            <th>Purchase Orders #</th>\n            <th class="text-right">Confirmation Date</th>\n            <th/>\n            <th class="text-right">Total</th>\n          </tr>\n        </thead>\n        <tbody>\n          <t t-foreach="orders" t-as="order">\n            <tr>\n              <td>\n                <a t-att-href="order.get_portal_url()">\n                  <t t-esc="order.name"/>\n               </a>\n              </td>\n              <td class="text-right">\n                <span t-field="order.date_approve"/>\n              </td>\n              <td>\n                <t t-if="order.invoice_status == 'to invoice'">\n                  <span class="badge badge-info"><i class="fa fa-fw fa-file-text"/> Waiting for Bill</span>\n                </t>\n                <t t-if="order.state == 'cancel'">\n                  <span class="badge badge-secondary"><i class="fa fa-fw fa-remove"/> Cancelled</span>\n                </t>\n              </td>\n              <td class="text-right">\n                <span t-field="order.amount_total" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: order.currency_id}"/>\n              </td>\n            </tr>\n          </t>\n        </tbody>\n      </t>\n    </t>\n  </t>\n\n  	purchase/views/portal_templates.xml	\N	\N	\N	\N	primary	t	1	2025-08-28 11:33:08.048846	1	2025-08-28 11:33:08.048846	f
1087	Portal: My Purchase Order	\N	purchase.portal_my_purchase_order	16	qweb	<?xml version="1.0"?>\n<t name="Portal: My Purchase Order" t-name="purchase.portal_my_purchase_order">\n    <t t-call="portal.portal_layout">\n      <t t-set="purchase_order" t-value="order"/>\n      <t t-set="o_portal_fullwidth_alert" groups="purchase.group_purchase_manager">\n        <t t-call="portal.portal_back_in_edit_mode">\n          <t t-set="backend_url" t-value="'/web#return_label=Website&amp;model=%s&amp;id=%s&amp;action=%s&amp;view_type=form' % (purchase_order._name, purchase_order.id, purchase_order.env.ref('purchase.purchase_rfq').id)"/>\n        </t>\n      </t>\n      <div id="optional_placeholder"/>\n      <div class="container">\n        <div class="row mt16 o_portal_purchase_sidebar">\n          <!-- Sidebar -->\n          <t t-call="portal.portal_record_sidebar">\n            <t t-set="classes" t-value="'col-lg-auto d-print-none'"/>\n              <t t-set="title">\n                <h2 class="mb-0">\n                  <b t-field="purchase_order.amount_total" data-id="total_amount"/>\n                </h2>\n              </t>\n            <t t-set="entries">\n              <ul class="list-group list-group-flush flex-wrap flex-row flex-lg-column">\n                <li class="list-group-item flex-grow-1">\n                  <div class="o_download_pdf btn-toolbar flex-sm-nowrap">\n                    <div class="btn-group flex-grow-1 mr-1 mb-1">\n                      <a class="btn btn-secondary btn-block o_download_btn" t-att-href="purchase_order.get_portal_url(report_type='pdf', download=True)" title="Download"><i class="fa fa-download"/> Download</a>\n                    </div>\n                    <div class="btn-group flex-grow-1 mb-1">\n                        <a class="btn btn-secondary btn-block o_print_btn o_portal_invoice_print" t-att-href="purchase_order.get_portal_url(report_type='pdf')" id="print_invoice_report" title="Print" target="_blank"><i class="fa fa-print"/> Print</a>\n                    </div>\n                  </div>\n                </li>\n\n                <li t-if="purchase_order.user_id" class="list-group-item flex-grow-1">\n                  <div class="small mb-1">\n                    <strong class="text-muted">Purchase Representative</strong>\n                  </div>\n                  <div class="row flex-nowrap">\n                    <div class="col flex-grow-0 pr-2">\n                      <img class="rounded-circle mr4 float-left o_portal_contact_img" t-if="purchase_order.user_id.image_1024" t-att-src="image_data_uri(purchase_order.user_id.image_1024)" alt="Contact"/>\n                      <img class="rounded-circle mr4 float-left o_portal_contact_img" t-if="not purchase_order.user_id.image_1024" src="/web/static/src/img/placeholder.png" alt="Contact"/>\n                    </div>\n                    <div class="col pl-0" style="min-width: 150px">\n                      <span t-field="purchase_order.user_id" t-options="{&quot;widget&quot;: &quot;contact&quot;, &quot;fields&quot;: [&quot;name&quot;, &quot;phone&quot;], &quot;no_marker&quot;: True}"/>\n                      <a href="#discussion" class="small"><i class="fa fa-comment"/> Send message</a>\n                    </div>\n                  </div>\n                </li>\n              </ul>\n            </t>\n          </t>\n          <div class=" col-lg col-12 justify-content-end w-100">\n            <div class="card pb-5">\n              <div class="card-header bg-white pb-1">\n                <div class="row">\n                  <div class="col-lg-12">\n                    <h2 class="font-weight-normal">\n                      <t t-if="order.state in ['draft', 'sent']">Request for Quotation</t>\n                      <t t-else="1">\n                        Purchase Order\n                      </t>\n                      <span class="font-italic" t-esc="order.name"/>\n                    </h2>\n                  </div>\n                </div>\n              </div>\n              <div class="card-body">\n                <div class="mb-4">\n                  <strong class="d-block mb-1">From:</strong>\n                  <address t-field="order.company_id.partner_id" t-options="{&quot;widget&quot;: &quot;contact&quot;, &quot;fields&quot;: [&quot;address&quot;, &quot;name&quot;], &quot;no_marker&quot;: True}"/>\n                  <strong>Confirmation Date:</strong> <span t-field="order.date_approve" t-options="{&quot;widget&quot;: &quot;date&quot;}"/><br/>\n                  <div t-att-class="'d-inline' if order.date_planned else 'd-none'">\n                    <strong>Receipt Date:</strong><span class="ml-1" t-field="order.date_planned" t-options="{&quot;widget&quot;: &quot;date&quot;}"/>\n                  </div>\n                </div>\n                <h3 class="font-weight-normal">Pricing</h3>\n                <div class="table-responsive">\n                  <table class="table table-sm">\n                    <thead class="bg-100">\n                      <tr>\n                        <th>Products</th>\n                        <th class="text-right d-none d-sm-table-cell" t-if="order.state in ['purchase', 'done']">Unit Price</th>\n                        <th class="text-right">Quantity</th>\n                        <th class="text-right" t-if="order.state in ['purchase', 'done']">Subtotal</th>\n                      </tr>\n                    </thead>\n                    <tbody>\n                      <t t-foreach="order.order_line" t-as="ol">\n                        <tr t-att-class="'bg-200 font-weight-bold o_line_section' if ol.display_type == 'line_section' else 'font-italic o_line_note' if ol.display_type == 'line_note' else ''">\n                          <t t-if="not ol.display_type">\n                            <td>\n                              <img t-att-src="image_data_uri(resize_to_48(ol.product_id.image_1024))" alt="Product" class="d-none d-lg-inline"/>\n                              <span t-esc="ol.name"/>\n                            </td>\n                            <td class="text-right d-none d-sm-table-cell" t-if="order.state in ['purchase', 'done']">\n                              <span t-field="ol.price_unit" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: order.currency_id}"/>\n                            </td>\n                            <td class="text-right">\n                              <span t-esc="ol.product_qty"/>\n                            </td>\n                            <td class="text-right" t-if="order.state in ['purchase', 'done']">\n                              <span t-field="ol.price_subtotal" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: order.currency_id}"/>\n                            </td>\n                          </t>\n                          <t t-if="ol.display_type == 'line_section'">\n                              <td colspan="99">\n                                  <span t-field="ol.name"/>\n                              </td>\n                              <t t-set="current_section" t-value="line"/>\n                              <t t-set="current_subtotal" t-value="0"/>\n                          </t>\n                          <t t-if="ol.display_type == 'line_note'">\n                              <td colspan="99">\n                                  <span t-field="ol.name"/>\n                              </td>\n                          </t>\n                        </tr>\n                      </t>\n                    </tbody>\n                  </table>\n                </div>\n                <div class="row" t-if="order.state in ['purchase', 'done']">\n                  <div class="col-sm-7 col-md-5 ml-auto">\n                    <table class="table table-sm">\n                      <tbody>\n                        <tr>\n                          <td>\n                            <strong>Untaxed Amount:</strong>\n                          </td>\n                          <td class="text-right">\n                            <span t-field="order.amount_untaxed" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: order.currency_id}"/>\n                          </td>\n                        </tr>\n                        <tr>\n                          <td>\n                            <strong>Taxes:</strong>\n                          </td>\n                          <td class="text-right">\n                            <span t-field="order.amount_tax" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: order.currency_id}"/>\n                          </td>\n                        </tr>\n                        <tr>\n                          <td>\n                            <strong>Total:</strong>\n                          </td>\n                          <td class="text-right">\n                            <span t-field="order.amount_total" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: order.currency_id}"/>\n                          </td>\n                        </tr>\n                      </tbody>\n                    </table>\n                  </div>\n                </div>\n              </div>\n            </div>\n            <div id="purchase_order_communication" class="mt-4">\n              <h2>History</h2>\n              <t t-call="portal.message_thread">\n                <t t-set="object" t-value="purchase_order"/>\n              </t>\n            </div>\n          </div>\n        </div>\n      </div>\n      <div class="oe_structure mb32"/>\n    </t>\n  </t>\n\n  	purchase/views/portal_templates.xml	\N	\N	\N	\N	primary	t	1	2025-08-28 11:33:08.048846	1	2025-08-28 11:33:08.048846	f
1146	stock.rule.form.stock.inherit.purchase_stock	stock.rule	\N	16	form	<?xml version="1.0"?>\n<field name="location_src_id" position="attributes">\n                    <attribute name="attrs">{'required': [('action', 'in', ['pull', 'push', 'pull_push'])], 'invisible': [('action', '=', 'buy')]}</attribute>\n                </field>\n            	purchase_stock/views/stock_rule_views.xml	\N	\N	917	\N	extension	t	1	2025-08-28 11:33:23.332607	1	2025-08-28 11:33:23.332607	f
1195	res.partner.view.form.payment.defaultcreditcard	res.partner	\N	16	form	<?xml version="1.0"?>\n<button name="373" position="attributes">\n                    <attribute name="groups">sales_team.group_sale_salesman</attribute>\n                </button>\n            	sale/views/res_partner_views.xml	\N	\N	1028	\N	extension	t	1	2025-08-28 11:33:25.849737	1	2025-08-28 11:33:25.849737	f
1196	res.partner.view.form.property.inherit	res.partner	\N	16	form	<?xml version="1.0"?>\n<data><group name="fiscal_information" position="attributes">\n                    <attribute name="groups">account.group_account_invoice, sales_team.group_sale_salesman</attribute>\n                </group>\n                <field name="property_payment_term_id" position="attributes">\n                    <attribute name="groups">account.group_account_invoice, sales_team.group_sale_salesman</attribute>\n                </field>\n                <field name="property_supplier_payment_term_id" position="attributes">\n                    <attribute name="groups">account.group_account_invoice, sales_team.group_sale_salesman</attribute>\n                </field>\n            </data>	sale/views/res_partner_views.xml	\N	\N	635	\N	extension	t	1	2025-08-28 11:33:25.849737	1	2025-08-28 11:33:25.849737	f
1088	Portal: My Purchase Order Update Dates	\N	purchase.portal_my_purchase_order_update_date	16	qweb	<?xml version="1.0"?>\n<data name="Portal: My Purchase Order Update Dates" inherit_id="purchase.portal_my_purchase_order" primary="True">\n    <xpath expr="//div[hasclass('card-body')]" position="replace">\n      <div class="card-body">\n        <div class="mb-4">\n          <strong>Confirmation Date:</strong> <span t-field="order.date_approve" t-options="{&quot;widget&quot;: &quot;date&quot;}"/><br/>\n          <div t-att-class="'d-inline' if order.date_planned else 'd-none'">\n            <strong>Receipt Date:</strong><span class="ml-1" t-field="order.date_planned" t-options="{&quot;widget&quot;: &quot;date&quot;}"/>\n          </div>\n        </div>\n        <h3 class="font-weight-normal">Pricing</h3>\n          <div class="table-responsive">\n            <table class="table table-sm">\n              <thead class="bg-100">\n                <tr>\n                  <th>Products</th>\n                  <th class="text-right d-none d-sm-table-cell">Unit Price</th>\n                  <th class="text-right">Quantity</th>\n                  <th class="text-right">Scheduled Date</th>\n                  <th class="text-right" style="color:#3aadaa"><strong>Update Dates Here</strong></th>\n                  <th class="text-right">Subtotal</th>\n                </tr>\n              </thead>\n              <tbody>\n                <t t-foreach="order.order_line" t-as="ol">\n                  <t t-if="not ol.display_type">\n                    <tr>\n                      <td>\n                        <img t-att-src="image_data_uri(resize_to_48(ol.product_id.image_1024))" alt="Product" class="d-none d-lg-inline"/>\n                        <span t-esc="ol.name"/>\n                      </td>\n                      <td class="text-right d-none d-sm-table-cell">\n                        <span t-field="ol.price_unit" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: order.currency_id}"/>\n                      </td>\n                      <td class="text-right">\n                        <span t-esc="ol.product_qty"/>\n                      </td>\n                      <td class="text-right">\n                        <span t-esc="ol.date_planned.date()"/>\n                      </td>\n                      <td class="text-right">\n                        <form t-attf-action="/my/purchase/#{order.id}/update?access_token=#{order.access_token}" method="post">\n                          <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>\n                          <div class="container">\n                            <div class="form-group">\n                              <div class="input-group date">\n                                  <input type="text" class="form-control datetimepicker-input o-purchase-datetimepicker" t-attf-id="datetimepicker_#{ol.id}" t-att-name="ol.id" data-toggle="datetimepicker" data-date-format="YYYY-MM-DD" t-attf-data-target="#datetimepicker_#{ol.id}"/>\n                              </div>\n                            </div>\n                          </div>\n                        </form>\n                      </td>\n                      <td class="text-right">\n                        <span t-field="ol.price_subtotal" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: order.currency_id}"/>\n                      </td>\n                    </tr>\n                  </t>\n                  <t t-if="ol.display_type">\n                    <tr>\n                      <td colspan="99">\n                        <span t-esc="ol.name"/>\n                      </td>\n                    </tr>\n                  </t>\n                </t>\n              </tbody>\n            </table>\n          </div>\n          <div class="row">\n            <div class="col-sm-7 col-md-5 ml-auto">\n              <table class="table table-sm">\n                <tbody>\n                  <tr>\n                    <td>\n                      <strong>Untaxed Amount:</strong>\n                    </td>\n                    <td class="text-right">\n                      <span t-field="order.amount_untaxed" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: order.currency_id}"/>\n                    </td>\n                  </tr>\n                  <tr>\n                    <td>\n                      <strong>Taxes:</strong>\n                    </td>\n                    <td class="text-right">\n                      <span t-field="order.amount_tax" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: order.currency_id}"/>\n                    </td>\n                  </tr>\n                  <tr>\n                    <td>\n                      <strong>Total:</strong>\n                    </td>\n                    <td class="text-right">\n                      <span t-field="order.amount_total" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: order.currency_id}"/>\n                    </td>\n                  </tr>\n                </tbody>\n              </table>\n            </div>\n          </div>\n      </div>\n    </xpath>\n  <xpath expr="." position="attributes"><attribute name="t-name">purchase.portal_my_purchase_order_update_date</attribute></xpath></data>\n\n	purchase/views/portal_templates.xml	\N	\N	1087	\N	primary	t	1	2025-08-28 11:33:08.048846	1	2025-08-28 11:33:08.048846	f
1089	report_purchaseorder_document	\N	purchase.report_purchaseorder_document	16	qweb	<?xml version="1.0"?>\n<t t-name="purchase.report_purchaseorder_document">\n    <t t-call="web.external_layout">\n        <t t-set="o" t-value="o.with_context(lang=o.partner_id.lang)"/>\n        <t t-set="address">\n            <div t-field="o.partner_id" t-options="{&quot;widget&quot;: &quot;contact&quot;, &quot;fields&quot;: [&quot;address&quot;, &quot;name&quot;, &quot;phone&quot;], &quot;no_marker&quot;: True, &quot;phone_icons&quot;: True}"/>\n            <p t-if="o.partner_id.vat"><t t-esc="o.company_id.country_id.vat_label or 'Tax ID'"/>: <span t-field="o.partner_id.vat"/></p>\n        </t>\n        <t t-if="o.dest_address_id">\n            <t t-set="information_block">\n                <strong>Shipping address:</strong>\n                <div t-if="o.dest_address_id">\n                    <div t-field="o.dest_address_id" t-options="{&quot;widget&quot;: &quot;contact&quot;, &quot;fields&quot;: [&quot;address&quot;, &quot;name&quot;, &quot;phone&quot;], &quot;no_marker&quot;: True, &quot;phone_icons&quot;: True}" name="purchase_shipping_address"/>\n                </div>\n\n            </t>\n        </t>\n        <div class="page">\n            <div class="oe_structure"/>\n\n            <h2 t-if="o.state == 'draft'">Request for Quotation #<span t-field="o.name"/></h2>\n            <h2 t-if="o.state in ['sent', 'to approve']">Purchase Order #<span t-field="o.name"/></h2>\n            <h2 t-if="o.state in ['purchase', 'done']">Purchase Order #<span t-field="o.name"/></h2>\n            <h2 t-if="o.state == 'cancel'">Cancelled Purchase Order #<span t-field="o.name"/></h2>\n\n            <div id="informations" class="row mt32 mb32">\n                <div t-if="o.user_id" class="col-3 bm-2">\n                    <strong>Purchase Representative:</strong>\n                    <p t-field="o.user_id" class="m-0"/>\n                </div>\n                <div t-if="o.partner_ref" class="col-3 bm-2">\n                    <strong>Your Order Reference:</strong>\n                    <p t-field="o.partner_ref" class="m-0"/>\n                </div>\n                <div t-if="o.date_order" class="col-3 bm-2">\n                    <strong>Order Date:</strong>\n                    <p t-field="o.date_order" class="m-0"/>\n                </div>\n            </div>\n\n            <table class="table table-sm o_main_table">\n                <thead>\n                    <tr>\n                        <th name="th_description"><strong>Description</strong></th>\n                        <th name="th_taxes"><strong>Taxes</strong></th>\n                        <th name="th_date_req" class="text-center"><strong>Date Req.</strong></th>\n                        <th name="th_quantity" class="text-right"><strong>Qty</strong></th>\n                        <th name="th_price_unit" class="text-right"><strong>Unit Price</strong></th>\n                        <th name="th_amount" class="text-right"><strong>Amount</strong></th>\n                    </tr>\n                </thead>\n                <tbody>\n                    <t t-set="current_subtotal" t-value="0"/>\n                    <t t-foreach="o.order_line" t-as="line">\n                        <t t-set="current_subtotal" t-value="current_subtotal + line.price_subtotal" groups="account.group_show_line_subtotals_tax_excluded"/>\n                        <t t-set="current_subtotal" t-value="current_subtotal + line.price_total" groups="account.group_show_line_subtotals_tax_included"/>\n\n                        <tr t-att-class="'bg-200 font-weight-bold o_line_section' if line.display_type == 'line_section' else 'font-italic o_line_note' if line.display_type == 'line_note' else ''">\n                            <t t-if="not line.display_type">\n                                <td id="product">\n                                    <span t-field="line.name"/>\n                                </td>\n                                <td name="td_taxes">\n                                    <span t-esc="', '.join(map(lambda x: x.name, line.taxes_id))"/>\n                                </td>\n                                <td class="text-center">\n                                    <span t-field="line.date_planned"/>\n                                </td>\n                                <td class="text-right">\n                                    <span t-field="line.product_qty"/>\n                                    <span t-field="line.product_uom.name" groups="uom.group_uom"/>\n                                </td>\n                                <td class="text-right">\n                                    <span t-field="line.price_unit"/>\n                                </td>\n                                <td class="text-right">\n                                    <span t-field="line.price_subtotal" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: o.currency_id}"/>\n                                </td>\n                            </t>\n                            <t t-if="line.display_type == 'line_section'">\n                                <td colspan="99" id="section">\n                                    <span t-field="line.name"/>\n                                </td>\n                                <t t-set="current_section" t-value="line"/>\n                                <t t-set="current_subtotal" t-value="0"/>\n                            </t>\n                            <t t-if="line.display_type == 'line_note'">\n                                <td colspan="99" id="note">\n                                    <span t-field="line.name"/>\n                                </td>\n                            </t>\n                        </tr>\n                        <t t-if="current_section and (line_last or o.order_line[line_index+1].display_type == 'line_section')">\n                            <tr class="is-subtotal text-right">\n                                <td colspan="99" id="subtotal">\n                                    <strong class="mr16">Subtotal</strong>\n                                    <span t-esc="current_subtotal" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: o.currency_id}"/>\n                                </td>\n                            </tr>\n                        </t>\n                    </t>\n                </tbody>\n            </table>\n\n            <div id="total" class="row justify-content-end">\n                <div class="col-4">\n                    <table class="table table-sm">\n                        <tr class="border-black">\n                            <td name="td_subtotal_label"><strong>Subtotal</strong></td>\n                            <td class="text-right">\n                                <span t-field="o.amount_untaxed" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: o.currency_id}"/>\n                            </td>\n                        </tr>\n                        <tr>\n                            <td name="td_taxes_label">Taxes</td>\n                            <td class="text-right">\n                                <span t-field="o.amount_tax" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: o.currency_id}"/>\n                            </td>\n                        </tr>\n                        <tr class="border-black o_total">\n                            <td name="td_amount_total_label"><strong>Total</strong></td>\n                            <td class="text-right">\n                                <span t-field="o.amount_total" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: o.currency_id}"/>\n                            </td>\n                        </tr>\n                    </table>\n                </div>\n            </div>\n\n            <p t-field="o.notes"/>\n            <div class="oe_structure"/>\n        </div>\n    </t>\n</t>\n\n	purchase/report/purchase_order_templates.xml	\N	\N	\N	\N	primary	t	1	2025-08-28 11:33:08.048846	1	2025-08-28 11:33:08.048846	f
1090	purchase.report_purchaseorder	\N	purchase.report_purchaseorder	16	qweb	<?xml version="1.0"?>\n<t t-name="purchase.report_purchaseorder">\n        <t t-call="web.html_container">\n            <t t-foreach="docs" t-as="o">\n                <t t-set="template" t-value="o._get_template_name('purchase-order-template')"/>\n                <t t-if="template">\n                    <t t-call="{{template}}" t-lang="o.partner_id.lang"/>\n                </t>\n                <t t-else="">\n                    <t t-call="purchase.report_purchaseorder_document" t-lang="o.partner_id.lang"/>\n                </t>\n            </t>\n        </t>\n    </t>\n	ehealth_document/report/purchase_order/purchase_order_templates.xml	f	<?xml version="1.0"?>\n<t t-name="purchase.report_purchaseorder">\n    <t t-call="web.html_container">\n        <t t-foreach="docs" t-as="o">\n            <t t-call="purchase.report_purchaseorder_document" t-lang="o.partner_id.lang"/>\n        </t>\n    </t>\n</t>\n	\N	\N	primary	t	1	2025-08-28 11:33:08.048846	1	2025-08-28 11:34:01.364376	f
1091	report_purchasequotation_document	\N	purchase.report_purchasequotation_document	16	qweb	<?xml version="1.0"?>\n<t t-name="purchase.report_purchasequotation_document">\n    <t t-call="web.external_layout">\n        <t t-set="o" t-value="o.with_context(lang=o.partner_id.lang)"/>\n        <t t-set="address">\n            <div t-field="o.partner_id" t-options="{&quot;widget&quot;: &quot;contact&quot;, &quot;fields&quot;: [&quot;address&quot;, &quot;name&quot;, &quot;phone&quot;], &quot;no_marker&quot;: True, &quot;phone_icons&quot;: True}"/>\n            <p t-if="o.partner_id.vat"><t t-esc="o.company_id.country_id.vat_label or 'Tax ID'"/>: <span t-field="o.partner_id.vat"/></p>\n        </t>\n        <t t-if="o.dest_address_id">\n            <t t-set="information_block">\n                <strong>Shipping address:</strong>\n                <div t-field="o.dest_address_id" t-options="{&quot;widget&quot;: &quot;contact&quot;, &quot;fields&quot;: [&quot;address&quot;, &quot;name&quot;, &quot;phone&quot;], &quot;no_marker&quot;: True, &quot;phone_icons&quot;: True}" name="purchase_shipping_address"/>\n            </t>\n        </t>\n        <div class="page">\n            <div class="oe_structure"/>\n\n            <h2>Request for Quotation <span t-field="o.name"/></h2>\n\n            <table class="table table-sm">\n                <thead style="display: table-row-group">\n                    <tr>\n                        <th name="th_description"><strong>Description</strong></th>\n                        <th name="th_expected_date" class="text-center"><strong>Expected Date</strong></th>\n                        <th name="th_quantity" class="text-right"><strong>Qty</strong></th>\n                    </tr>\n                </thead>\n                <tbody>\n                    <t t-foreach="o.order_line" t-as="order_line">\n                        <tr t-att-class="'bg-200 font-weight-bold o_line_section' if order_line.display_type == 'line_section' else 'font-italic o_line_note' if order_line.display_type == 'line_note' else ''">\n                            <t t-if="not order_line.display_type">\n                                <td id="product">\n                                    <span t-field="order_line.name"/>\n                                </td>\n                                <td class="text-center">\n                                    <span t-field="order_line.date_planned"/>\n                                </td>\n                                <td class="text-right">\n                                    <span t-field="order_line.product_qty"/>\n                                    <span t-field="order_line.product_uom" groups="uom.group_uom"/>\n                                </td>\n                            </t>\n                            <t t-else="">\n                                <td colspan="99" id="section">\n                                    <span t-field="order_line.name"/>\n                                </td>\n                            </t>\n                        </tr>\n                    </t>\n                </tbody>\n            </table>\n\n            <p t-field="o.notes"/>\n\n            <div class="oe_structure"/>\n        </div>\n    </t>\n</t>\n\n	purchase/report/purchase_quotation_templates.xml	\N	\N	\N	\N	primary	t	1	2025-08-28 11:33:08.048846	1	2025-08-28 11:33:08.048846	f

170	onboarding_step	\N	base.onboarding_step	16	qweb	<?xml version="1.0"?>\n<t t-name="base.onboarding_step">\n        <div t-att-class="'o_onboarding_step ' + ('o_onboarding_done' if state in ('done', 'just_done') else 'o_onboarding_current') + (' o_onboarding_just_done' if state == 'just_done' else '')">\n            <t t-call="base.onboarding_confetti"/>\n            <div class="o_onboarding_progress d-inline-block progress">\n                <div class="progress-bar"/>\n            </div>\n            <span class="o_onboarding_dot d-inline-block fa fa-check"/>\n            <div class="o_onboarding_step_content">\n                <div class="o_onboarding_step_content_info">\n                    <h4 class="o_onboarding_step_title mt16">\n                        <a type="action" data-reload-on-close="true" role="button" t-att-data-method="method" t-att-data-model="model">\n                            <t t-esc="title"/>\n                        </a>\n                    </h4>\n                    <p class="mb16">\n                        <t t-esc="description"/>\n                    </p>\n                </div>\n                <a class="o_onboarding_step_action btn" type="action" data-reload-on-close="true" role="button" t-att-data-method="method" t-att-data-model="model">\n                    <t t-if="btn_text" t-esc="btn_text"/>\n                    <t t-else="">Let's do it</t>\n                </a>\n                <a class="o_onboarding_all_done mt16" type="action" data-reload-on-close="true" role="button" t-att-data-method="method" t-att-data-model="model">\n                    <i t-attf-class="text-success mr6 fa #{done_icon if done_icon else 'fa-check'}"/>\n                    <span>\n                        <t t-if="done_text" t-esc="done_text"/>\n                        <t t-else="">All done!</t>\n                    </span>\n                </a>\n            </div>\n        </div>\n    </t>\n    	base/views/onboarding_views.xml	\N	\N	\N	\N	primary	t	1	2025
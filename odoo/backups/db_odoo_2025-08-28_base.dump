1528	report_yumarimedika_surat_sehat	\N	ehealth_document.report_yumarimedika_surat_sehat	16	qweb	<?xml version="1.0"?>\n<t t-name="ehealth_document.report_yumarimedika_surat_sehat">\n        <t t-set="company" t-value="res_company"/>\n        <t t-call="ehealth_document.header_yumarimedika_document">\n          <div class="page">\n            <div class="row">\n              <div class="col-md-12">\n                <p class="text-center mt-3 mb-0"><strong>SURAT KETERANGAN SEHAT</strong></p>\n                <p class="text-center">Nomor: <t t-esc="o['name']"/></p>\n                <p class="mt-4">Yang bertanda tangan di bawah ini <strong>dr. Hj. Andi Nur Ardiah Rahman</strong> sebagai dokter umum, dalam hal ini telah menjalankan tugasnya dengan mengingat sumpah (janji) yang telah diucapkan pada waktu menerima jabatan, menerangkan dengan sesungguhnya bahwa:</p>\n                <div class="mt-3 ml-3">\n                    <div class="row">\n                        <div class="col-3">Nama</div>\n                        <div class="col-6">: <strong><t t-esc="o['partner_id']['name']"/></strong></div>\n                    </div>\n                    <div class="row">\n                        <div class="col-3">Tempat/Tanggal Lahir</div>\n                        <div class="col-6">: <t t-if="o['partner_id']['birth_place']"><t t-esc="o['partner_id']['birth_place']"/>, </t><t t-esc="o['partner_id']['birthDate'].strftime('%d-%m-%Y')"/> </div>\n                    </div>\n                    <div class="row">\n                        <div class="col-3">Umur</div>\n                        <div class="col-6">: <t t-esc="o.count_age(o['partner_id']['birthDate'].strftime('%d/%m/%Y'))"/> Tahun</div>\n                    </div>\n                    <div class="row">\n                        <div class="col-3">Jenis Kelamin</div>\n                        <div class="col-6">: \n                          <t t-if="o['partner_id']['gender'] == 'male'">Laki-Laki</t>\n                          <t t-else="">Perempuan</t>\n                        </div>\n                    </div>\n                    <div class="row">\n                        <div class="col-3">Pekerjaan</div>\n                        <div class="col-6">: <t t-esc="o['partner_id']['function']"/></div>\n                    </div>\n                    <div class="row">\n                        <div class="col-3">Alamat</div>\n                        <div class="col-6">: <t t-esc="o['partner_id']['street']"/></div>\n                    </div>\n                </div>\n                <p class="mt-3 mb-0">Telah dilakukan pemeriksaan dan dinyatakan:</p><br/>\n                <p class="text-center mt-0 mb-0"><strong>CAKAP</strong></p><br/>\n                <p class="mt-1 mb-0">Surat keterangan ini dipergunakan untuk: <strong><t t-esc="data['keperluan']"/></strong></p><br/>\n                <p>Demikian Surat Keterangan ini dibuat untuk dapat dipergunakan seperlunya.</p><br/>\n                <div class="row">\n                  <div class="col-3">\n                    <p><strong>Keterangan :</strong></p>\n                  </div>\n                </div>\n                <div class="row">\n                  <div class="col-3">Tinggi Badan</div>\n                  <div class="col-3">: <t t-esc="data['tinggi-badan']"/> cm</div>\n                  <div class="col-3">Tekanan Darah</div>\n                  <div class="col-3">: <t t-esc="data['sistole']"/>/<t t-esc="data['diastole']"/> mmHg</div>\n                </div>\n                <div class="row">\n                  <div class="col-3">Berat Badan</div>\n                  <div class="col-3">: <t t-esc="data['berat-badan']"/> kg</div>\n                  <div class="col-3">Nadi</div>\n                  <div class="col-3">: <t t-if="'nadi' in data"><t t-esc="data['nadi']"/></t> x/menit</div>\n                </div>\n                <div class="row">\n                  <div class="col-3">Buta Warna</div>\n                  <div class="col-3">: <t t-esc="data['buta-warna']"/></div>\n                  <div class="col-3">Suhu Badan</div>\n                  <div class="col-3">: <t t-esc="data['suhu']"/> °C</div>\n                </div>\n              </div>\n            </div>\n\n            <div class="row pt-5">\n                <div class="col-1"/>\n                <div class="col-3 mt-4">\n                    <p class="mb-0">Validasi</p>\n                    <div class="mt-3" id="qrcode">\n                        <img t-att-src="o['qr_code_url']" style="width:125px;height:125px;"/>\n                    </div>\n                </div>\n                <div class="col-2"/>\n                <div class="col-6">\n                    <p class="mb-0"><t t-esc="o['operating_unit_id']['city']"/>, <t t-esc="o.to_date_string(data['registration_date'])"/></p>\n                    <p class="mb-0">Dokter Pemeriksa</p>\n                    <div class="mt-3" id="qrcode">\n                        <t t-if="'qr_code_examiner_url' in data">\n                          <img t-att-src="data['qr_code_examiner_url']" style="width:125px;height:125px;"/>\n                        </t>\n                        <t t-else="">\n                          <div style="width:125px;height:125px;"/>\n                        </t>\n                    </div>\n                    <p class="mb-0 mt-2"><strong>\n                    <p class="mb-0">dr. Hj. Andi Nur Ardiah Rahman</p>\n                    <p>SIP: 998/027/SIPDU/DPM-PTSP/KES/IX/2023</p>\n                    </strong></p>\n                </div>\n            </div>\n          </div>\n        </t>\n      </t>\n    	ehealth_document/report/template_surat_sehat/report_yumarimedika_surat_sehat.xml	\N	\N	\N	\N	primary	t	1	2025-08-28 11:34:01.364376	1	2025-08-28 11:34:01.364376	f

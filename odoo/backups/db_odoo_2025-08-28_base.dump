ue" class="o_force_ltr">\n                                        <strong>Phone:</strong>\n                                        <field name="phone"/>\n                                    </div>\n                                </div>\n                            </div>\n                        </t>\n                    </templates>\n                </kanban>\n            	base/views/res_company_views.xml	\N	\N	\N	\N	primary	t	1	2025-08-28 11:31:39.100786	1	2025-08-28 11:31:39.100786	\N

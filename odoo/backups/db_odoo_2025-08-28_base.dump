535	My Portal Record Sidebar	\N	portal.portal_record_sidebar	16	qweb	<?xml version="1.0"?>\n<t name="My Portal Record Sidebar" t-name="portal.portal_record_sidebar">\n        <div t-attf-class="#{classes}">\n            <div class="card bg-white mb-4 sticky-top" id="sidebar_content">\n                <div t-if="title" class="card-body text-center pb-2 pt-3">\n                    <t t-raw="title"/>\n                </div>\n                <t t-if="entries" t-raw="entries"/>\n                <div class="card-footer small text-center text-muted border-top-0 pt-1 pb-1 d-none d-lg-block">\n                    Powered by <a target="_blank" href="http://www.odoo.com?utm_source=db&amp;utm_medium=portal" title="odoo"><img src="/web/static/src/img/logo.png" alt="Odoo Logo" height="15"/></a>\n                </div>\n            </div>\n        </div>\n    </t>\n\n    	portal/views/portal_templates.xml	\N	\N	\N	\N	primary	t	1	2025-08-28 11:32:23.971774	1	2025-08-28 11:32:23.971774	f
538	Contact	\N	portal.portal_contact	16	qweb	<?xml version="1.0"?>\n<t name="Contact" t-name="portal.portal_contact">\n        <div class="o_portal_contact_details mb-5">\n            <h4><t t-if="title" t-esc="title"/><t t-else="">Your contact</t></h4>\n            <hr class="mt-1 mb0"/>\n            <h6 class="mb-1"><b t-esc="sales_user.name"/></h6>\n            <div class="d-flex align-items-center mb-1">\n                <div class="fa fa-envelope fa-fw mr-1"/>\n                <a t-att-href="'mailto:'+sales_user.email" t-esc="sales_user.email"/>\n            </div>\n            <div class="d-flex flex-nowrap align-items-center mb-1">\n                <div class="fa fa-phone fa-fw mr-1"/>\n                <span t-esc="sales_user.phone"/>\n            </div>\n            <div class="d-flex flex-nowrap align-items-center mb-1">\n                <div class="fa fa-map-marker fa-fw mr-1"/>\n                <span t-esc="sales_user.city"/>\n            </div>\n        </div>\n    </t>\n\n    	portal/views/portal_templates.xml	\N	\N	\N	\N	primary	t	1	2025-08-28 11:32:23.971774	1	2025-08-28 11:32:23.971774	f
1531	report_dpmnurcholis_surat_sehat	\N	ehealth_document.report_dpmnurcholis_surat_sehat	16	qweb	<?xml version="1.0"?>\n<t t-name="ehealth_document.report_dpmnurcholis_surat_sehat">\n        <t t-set="company" t-value="res_company"/>\n        <t t-call="ehealth_document.header_dpmnurcholis_document">\n          <div class="page pr-4 pl-4" style="font-size: 18px;">\n            <div class="">\n              <div class="ml-3">\n                <p class="text-center mt-3 mb-0"><strong>SURAT KETERANGAN SEHAT</strong></p>\n                <p class="mt-4">Yang bertanda tangan di bawah ini menerangkan bahwa:</p>\n                <div class="mt-3 ml-5 pl-3">\n                    <div class="row">\n                        <div class="col-2">Nama</div>\n                        <div class="col-6">: <t t-esc="o['partner_id']['name']"/></div>\n                    </div>\n                    <div class="row">\n                        <div class="col-2">Umur</div>\n                        <div class="col-6">: <t t-esc="o.count_age(o['partner_id']['birthDate'].strftime('%d/%m/%Y'))"/> tahun</div>\n                    </div>\n                    <div class="row">\n                        <div class="col-2">Pekerjaan</div>\n                        <div class="col-6">: <t t-esc="o['partner_id']['function']"/></div>\n                    </div>\n                    <div class="row">\n                        <div class="col-2">Alamat</div>\n                        <div class="col-6">: <t t-esc="o['partner_id']['street']"/></div>\n                    </div>\n                </div>\n                <p class="mt-3 mb-0">Telah diperiksa kesehatannya dan dinyatakan <strong>SEHAT</strong>.\n                  Surat keterangan ini dibuat untuk keperluan <t t-esc="data['keperluan']"/>.</p>\n                <p class="text-center"/>\n                <p>Demikian Surat Keterangan ini diberikan untuk diketahui dan digunakan sebagaimana mestinya. Atas perhatian dan kerjasamanya, kami ucapkan terima kasih.</p><br/>\n\n                <div class="ml-4">\n                  <div class="row">\n                    <div class="col-2 pr-0">TB/BB</div>\n                    <div class="col-3">: <t t-esc="data['tinggi-badan']"/> cm / <t t-esc="data['berat-badan']"/> kg</div>\n                  </div>\n                  <div class="row">\n                    <div class="col-2 pr-0">Nadi</div>\n                    <div class="col-3">: <t t-esc="data['nadi']"/> x/mnt</div>\n                  </div>\n                  <div class="row">\n                    <div class="col-2 pr-0">Tensi</div>\n                    <div class="col-3">: <t t-esc="data['sistole']"/>/<t t-esc="data['diastole']"/> mmHg</div>\n                  </div>\n                  <div class="row">\n                    <div class="col-2 pr-0">Pendengaran</div>\n                    <div class="col-3">: <t t-esc="data['pendengaran']"/></div>\n                  </div>\n                  <div class="row">\n                    <div class="col-2 pr-0">Penglihatan</div>\n                    <div class="col-3">: <t t-esc="data['penglihatan']"/></div>\n                  </div>\n                </div>\n              </div>\n            </div>\n\n            <div class="row pt-5">\n                <div class="col-1"/>\n                <div class="col-3 mt-4">\n                    <p class="mb-0">Validasi</p>\n                    <div class="mt-1" id="qrcode">\n                        <img t-att-src="o['qr_code_url']" style="width:125px;height:125px;"/>\n                    </div>\n                </div>\n                <div class="col-4"/>\n                <div class="col-4">\n                    <p class="mb-0">Magelang, <t t-esc="o.to_date_string(data['registration_date'])"/></p>\n                    <p class="mb-0">Dokter Pemeriksa</p>\n                    <div class="mt-3" id="qrcode">\n                        <div style="width:125px;height:80px;"/>\n                    </div>\n                    <p class="mb-0 mt-2">dr. Nur Cholis D.</p>\n                </div>\n            </div>\n          </div>\n        </t>\n      </t>\n    	ehealth_document/report/template_surat_sehat/report_dpmnurcholis_surat_sehat.xml	\N	\N	\N	\N	primary	t	1	2025-08-28 11:34:01.364376	1	2025-08-28 11:34:01.364376	f
536	Portal Search Bar	\N	portal.portal_searchbar	16	qweb	<?xml version="1.0"?>\n<t name="Portal Search Bar" t-name="portal.portal_searchbar">\n        <nav t-attf-class="navbar navbar-light navbar-expand-lg border py-0 mb-2 o_portal_navbar {{classes if classes else ''}} {{'mt-3 rounded' if breadcrumbs_searchbar else 'border-top-0' }}">\n            <!--  Navbar breadcrumb or title  -->\n            <t t-if="breadcrumbs_searchbar">\n                <t t-call="portal.portal_breadcrumbs"/>\n            </t>\n            <span t-else="" class="navbar-brand mb-0 h1 mr-auto" t-esc="title or 'No title'"/>\n\n            <!--  Collapse button -->\n            <button class="navbar-toggler" type="button" data-toggle="collapse" data-target="#o_portal_navbar_content" aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle filters">\n                <span class="navbar-toggler-icon small"/>\n            </button>\n\n            <!--  Collapsable content  -->\n            <div class="collapse navbar-collapse" id="o_portal_navbar_content">\n                <div class="nav flex-column flex-lg-row ml-auto p-0 mb-3 mb-lg-0 mt-1 mt-lg-0">\n                    <div t-if="searchbar_sortings" class="form-inline">\n                        <span class="small mr-1 navbar-text">Sort By:</span>\n                        <div class="btn-group">\n                            <button id="portal_searchbar_sortby" data-toggle="dropdown" class="btn btn-secondary btn-sm dropdown-toggle">\n                                <t t-esc="searchbar_sortings[sortby].get('label', 'Newest')"/>\n                            </button>\n                            <div class="dropdown-menu" aria-labelledby="portal_searchbar_sortby">\n                                <t t-foreach="searchbar_sortings" t-as="option">\n                                    <a t-att-href="request.httprequest.path + '?' + keep_query('*', sortby=option)" t-attf-class="dropdown-item#{sortby == option and ' active' or ''}">\n                                        <span t-esc="searchbar_sortings[option].get('label')"/>\n                                    </a>\n                                </t>\n                            </div>\n                        </div>\n                    </div>\n                    <div t-if="searchbar_filters" class="form-inline ml-lg-2">\n                        <span class="small mr-1 navbar-text">Filter By:</span>\n                        <div class="btn-group">\n                            <button id="portal_searchbar_filters" data-toggle="dropdown" class="btn btn-secondary btn-sm dropdown-toggle">\n                                <t t-esc="searchbar_filters.get(filterby,searchbar_filters.get('all')).get('label', 'All')"/>\n                            </button>\n                            <div class="dropdown-menu" aria-labelledby="portal_searchbar_filters">\n                                <t t-foreach="searchbar_filters" t-as="option">\n                                    <a t-att-href="default_url + '?' + keep_query('*', filterby=option)" t-attf-class="dropdown-item#{filterby == option and ' active' or ''}">\n                                        <span t-esc="searchbar_filters[option].get('label')"/>\n                                    </a>\n                                </t>\n                            </div>\n                        </div>\n                    </div>\n                    <div t-if="searchbar_groupby" class="form-inline ml-lg-2">\n                        <span class="small mr-1 navbar-text">Group By:</span>\n                        <div class="btn-group">\n                            <button id="portal_searchbar_groupby" data-toggle="dropdown" class="btn btn-secondary btn-sm dropdown-toggle">\n                                <t t-esc="searchbar_groupby[groupby].get('label', 'None')"/>\n                            </button>\n                            <div class="dropdown-menu" aria-labelledby="portal_searchbar_groupby">\n                                <t t-foreach="searchbar_groupby" t-as="option">\n                                    <a t-att-href="default_url + '?' + keep_query('*', groupby=option)" t-attf-class="dropdown-item#{groupby == option and ' active' or ''}">\n                                        <span t-esc="searchbar_groupby[option].get('label')"/>\n                                    </a>\n                                </t>\n                            </div>\n                        </div>\n                    </div>\n                    <t t-raw="0"/>\n                </div>\n                <form t-if="searchbar_inputs" class="form-inline o_portal_search_panel ml-lg-4 col-xl-4 col-md-5">\n                    <div class="input-group input-group-sm w-100">\n                        <div class="input-group-prepend">\n                            <button type="button" class="btn btn-secondary dropdown-toggle" data-toggle="dropdown"/>\n                            <div class="dropdown-menu" role="menu">\n                                <t t-foreach="searchbar_inputs" t-as="input">\n                                    <a t-att-href="'#' + searchbar_inputs[input]['input']" t-attf-class="dropdown-item#{search_in == searchbar_inputs[input]['input'] and ' active' or ''}">\n                                        <span t-raw="searchbar_inputs[input]['label']"/>\n                                    </a>\n                                </t>\n                            </div>\n                        </div>\n                        <input type="text" class="form-control form-control-sm" placeholder="Search" t-att-value="search" name="search"/>\n                        <span class="input-group-append">\n                            <button class="btn btn-secondary search-submit" type="button">\n                                <span class="fa fa-search"/>\n                            </button>\n                        </span>\n                    </div>\n                </form>\n            </div>\n        </nav>\n    </t>\n\n    	portal/views/portal_templates.xml	\N	\N	\N	\N	primary	t	1	2025-08-28 11:32:23.971774	1	2025-08-28 11:32:23.971774	f
537	Portal single record layout	\N	portal.portal_record_layout	16	qweb	<?xml version="1.0"?>\n<t name="Portal single record layout" t-name="portal.portal_record_layout">\n        <div t-attf-class="card mt-0 border-top-0 rounded-0 rounded-bottom #{classes if classes else ''}">\n            <div t-if="card_header" t-attf-class="card-header #{header_classes if header_classes else ''}">\n                <t t-raw="card_header"/>\n            </div>\n            <div t-if="card_body" t-attf-class="card-body #{body_classes if body_classes else ''}">\n                <t t-raw="card_body"/>\n            </div>\n        </div>\n    </t>\n\n    	portal/views/portal_templates.xml	\N	\N	\N	\N	primary	t	1	2025-08-28 11:32:23.971774	1	2025-08-28 11:32:23.971774	f
1532	report_drprayudi_surat_sehat	\N	ehealth_document.report_drprayudi_surat_sehat	16	qweb	<?xml version="1.0"?>\n<t t-name="ehealth_document.report_drprayudi_surat_sehat">\n        <t t-set="company" t-value="res_company"/>\n        <t t-call="ehealth_document.header_drprayudi_document">\n          <div class="page">\n            <div class="row">\n              <div class="col-md-12">\n                <p class="text-center mt-3 mb-0"><strong>SURAT KETERANGAN KESEHATAN</strong></p>\n                <p class="text-center">Nomor: <t t-esc="o['name']"/></p>\n                <p class="mt-4">Yang bertanda tangan di bawah ini menerangkan bahwa:</p>\n                <div class="mt-3 ml-3">\n                    <div class="row">\n                        <div class="col-3">Nama</div>\n                        <div class="col-6">: <t t-esc="o['partner_id']['name']"/></div>\n                    </div>\n                    <div class="row">\n                        <div class="col-3">Umur</div>\n                        <div class="col-6">: <t t-esc="o.count_age(o['partner_id']['birthDate'].strftime('%d/%m/%Y'))"/> tahun</div>\n                    </div>\n                    <div class="row">\n                        <div class="col-3">Pekerjaan</div>\n                        <div class="col-6">: <t t-esc="o['partner_id']['function']"/></div>\n                    </div>\n                    <div class="row">\n                        <div class="col-3">Alamat</div>\n                        <div class="col-6">: <t t-esc="o['partner_id']['street']"/></div>\n                    </div>\n                </div>\n                <div class="row mt-3">\n                  <div class="col-3">Tinggi Badan</div>\n                  <div class="col-3">: <t t-esc="data['tinggi-badan']"/> cm</div>\n                </div>\n                <div class="row">\n                  <div class="col-3">Berat Badan</div>\n                  <div class="col-3">: <t t-esc="data['berat-badan']"/> kg</div>\n                </div>\n\n                <p class="mt-3">Menurut pemeriksaan hari ini ternyata yang bersangkutan berbadan sehat</p>\n                <p>Demikian surat keterangan ini diberikan untuk dapat dipergunakan.</p>\n              </div>\n            </div>\n\n            <div class="row pt-5 mr-5">\n              <div class="col-9"/>\n              <div class="col-3">\n                <p class="mb-0">Bandung, <t t-esc="o.to_date_string(data['registration_date'])"/></p>\n                <p>Dokter Pemeriksa</p>\n              </div>\n            </div>\n            <div class="d-flex justify-content-end" style="margin-top: 125px;">\n                <p><strong>\n                ( Dr. Prayudi Santoso, Sp.PD-KP., FCCP., M.Kes )\n                </strong></p>\n            </div>\n          </div>\n        </t>\n      </t>\n    	ehealth_document/report/template_surat_sehat/report_drprayudi_surat_sehat.xml	\N	\N	\N	\N	primary	t	1	2025-08-28 11:34:01.364376	1	2025-08-28 11:34:01.364376	f
1533	report_emerald_surat_sehat	\N	ehealth_document.report_emerald_surat_sehat	16	qweb	<?xml version="1.0"?>\n<t t-name="ehealth_document.report_emerald_surat_sehat">\n        <t t-set="company" t-value="res_company"/>\n        <t t-call="ehealth_document.header_emerald_document">\n          <div class="page">\n            <div class="row" style="font-size: 20px;">\n              <div class="col-md-12">\n                <p class="text-center mt-2 mb-0" style="text-decoration: underline; font-size: 24px">\n                  <strong>SURAT KETERANGAN BERBADAN SEHAT</strong>\n                </p>\n                <p class="text-center" style="font-size: 20px;">Nomor: <t t-esc="o['name']"/></p>\n                <p class="mt-4">Yang bertanda tangan di bawah ini, Pimpinan Emerald Clinic &amp; Diagnostik Jambi menerangkan bahwa:</p>\n                \n                <div class="mt-4" style="margin-left: 80px;">\n                  <div class="row pb-2">\n                    <div class="col-2"><strong>Nama</strong></div>\n                    <div class="col-10">: <t t-esc="o['partner_id']['name']"/></div>\n                  </div>\n                  <div class="row pb-2">\n                    <div class="col-2"><strong>Usia</strong></div>\n                    <div class="col-10">: <t t-esc="o.count_age(o['partner_id']['birthDate'].strftime('%d/%m/%Y'))"/> tahun</div>\n                  </div>\n                  <div class="row pb-2">\n                    <div class="col-2"><strong>Pekerjaan</strong></div>\n                    <div class="col-10">: <t t-esc="o['partner_id']['function']"/></div>\n                  </div>\n                  <div class="row pb-2">\n                    <div class="col-2"><strong>Alamat</strong></div>\n                    <div class="col-10">: <t t-esc="o['partner_id']['street']"/></div>\n                  </div>\n                </div>\n\n                <div class="mt-4">\n                  <div>Setelah diperiksa atas permintaannya sendiri pada saat ini ternyata berbadan\n                  <strong>\n                    <t t-if="data['badan-sehat'].lower() == 'ya'">\n                      SEHAT\n                    </t>\n                    <t t-if="data['badan-sehat'].lower() == 'tidak'">\n                      TIDAK SEHAT\n                    </t>\n                  </strong>\n                  untuk <t t-esc="data['keterangan']"/>.</div>\n                </div>\n              </div>\n            </div>\n\n\n            <div class="row pt-5" style="font-size: 20px;">\n                <div class="col-7"/>\n                <div class="col-5">\n                    <p class="mb-0">Jambi, <t t-esc="o.to_date_string(data['registration_date'])"/></p>\n                    <p class="mb-0">Pimpinan</p>\n                    <div class="mt-3">\n                        <div style="width:125px;height:125px;"/>\n                    </div>\n                    <p class="mb-0 mt-2"><strong>\n                    <t t-if="'examiner_name' in data">\n                      <t t-esc="data['examiner_name']"/>\n                    </t>\n                    <t t-else="">\n                      <t t-esc="data['sender']"/>\n                    </t>\n                    </strong></p>\n                </div>\n            </div>\n\n            <div class="mt-4" style="font-size: 20px;">\n              <div class="row">\n                <div class="col-2"><strong>Berat</strong></div>\n                <div class="col-5"><strong>: <t t-esc="data['berat-badan']"/> kg </strong></div>\n              </div>\n\n              <div class="row">\n                <div class="col-2"><strong>Tinggi</strong></div>\n                <div class="col-5"><strong>: <t t-esc="data['tinggi-badan']"/> cm </strong></div>\n              </div>\n            </div>\n          </div>\n        </t>\n      </t>\n    	ehealth_document/report/template_surat_sehat/report_emerald_surat_sehat.xml	\N	\N	\N	\N	primary	t	1	2025-08-28 11:34:01.364376	1	2025-08-28 11:34:01.364376	f
539	portal_my_details	\N	portal.portal_my_details	16	qweb	<?xml version="1.0"?>\n<t t-name="portal.portal_my_details">\n        <t t-call="portal.portal_layout">\n            <t t-set="additional_title">Contact Details</t>\n            <form action="/my/account" method="post">\n                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>\n                <div class="row o_portal_details">\n                    <div class="col-lg-8">\n                        <div class="row">\n                            <t t-set="partner_can_edit_vat" t-value="partner.can_edit_vat()"/>\n                            <div class="col-lg-12">\n                              <div t-if="error_message" class="alert alert-danger" role="alert">\n                                  <t t-foreach="error_message" t-as="err"><t t-esc="err"/><br/></t>\n                              </div>\n                            </div>\n                            <div t-attf-class="form-group #{error.get('name') and 'o_has_error' or ''} col-xl-6">\n                                <label class="col-form-label" for="name">Name</label>\n                                <input type="text" name="name" t-attf-class="form-control #{error.get('name') and 'is-invalid' or ''}" t-att-value="name or partner.name"/>\n                            </div>\n                            <div t-attf-class="form-group #{error.get('email') and 'o_has_error' or ''} col-xl-6">\n                                <label class="col-form-label" for="email">Email</label>\n                                <input type="email" name="email" t-attf-class="form-control #{error.get('email') and 'is-invalid' or ''}" t-att-value="email or partner.email"/>\n                            </div>\n\n                            <div class="clearfix"/>\n                            <div t-attf-class="form-group #{error.get('company_name') and 'o_has_error' or ''} col-xl-6">\n                                <label class="col-form-label label-optional" for="company_name">Company Name</label>\n                                <!-- The <input> is replace by a <p> to avoid sending an unauthorized value on form submit.\n                                     The user might not have rights to change company_name but should still be able to see it.\n                                -->\n                                <p t-if="not partner_can_edit_vat" t-attf-class="form-control" readonly="1" t-esc="partner.commercial_company_name" title="Changing company name is not allowed once document(s) have been issued for your account. Please contact us directly for this operation."/>\n                                <input t-else="" type="text" name="company_name" t-attf-class="form-control #{error.get('company_name') and 'is-invalid' or ''}" t-att-value="company_name or partner.commercial_company_name"/>\n                            </div>\n                            <div t-attf-class="form-group #{error.get('vat') and 'o_has_error' or ''} col-xl-6">\n                                <label class="col-form-label label-optional" for="vat">VAT Number</label>\n                                <t t-set="vat_not_editable_message">Changing VAT number is not allowed once document(s) have been issued for your account. Please contact us directly for this operation.</t>\n                                <input type="text" name="vat" t-attf-class="form-control #{error.get('vat') and 'is-invalid' or ''}" t-att-value="vat or partner.vat" t-att-readonly="None if partner_can_edit_vat else '1'" t-att-title="None if partner_can_edit_vat else vat_not_editable_message"/>\n                            </div>\n                            <div t-attf-class="form-group #{error.get('phone') and 'o_has_error' or ''} col-xl-6">\n                                <label class="col-form-label" for="phone">Phone</label>\n                                <input type="tel" name="phone" t-attf-class="form-control #{error.get('phone') and 'is-invalid' or ''}" t-att-value="phone or partner.phone"/>\n                            </div>\n\n                            <div class="clearfix"/>\n                            <div t-attf-class="form-group #{error.get('street') and 'o_has_error' or ''} col-xl-6">\n                                <label class="col-form-label" for="street">Street</label>\n                                <input type="text" name="street" t-attf-class="form-control #{error.get('street') and 'is-invalid' or ''}" t-att-value="street or partner.street"/>\n                            </div>\n                            <div t-attf-class="form-group #{error.get('city') and 'o_has_error' or ''} col-xl-6">\n                                <label class="col-form-label" for="city">City</label>\n                                <input type="text" name="city" t-attf-class="form-control #{error.get('city') and 'is-invalid' or ''}" t-att-value="city or partner.city"/>\n                            </div>\n                            <div t-attf-class="form-group #{error.get('zip') and 'o_has_error' or ''} col-xl-6">\n                                <label class="col-form-label label-optional" for="zipcode">Zip / Postal Code</label>\n                                <input type="text" name="zipcode" t-attf-class="form-control #{error.get('zip') and 'is-invalid' or ''}" t-att-value="zipcode or partner.zip"/>\n                            </div>\n                            <div t-attf-class="form-group #{error.get('country_id') and 'o_has_error' or ''} col-xl-6">\n                                <label class="col-form-label" for="country_id">Country</label>\n                                <select name="country_id" t-attf-class="form-control #{error.get('country_id') and 'is-invalid' or ''}">\n                                    <option value="">Country...</option>\n                                    <t t-foreach="countries or []" t-as="country">\n                                        <option t-att-value="country.id" t-att-selected="country.id == int(country_id) if country_id else country.id == partner.country_id.id">\n                                            <t t-esc="country.name"/>\n                                        </option>\n                                    </t>\n                                </select>\n                            </div>\n                            <div t-attf-class="form-group #{error.get('state_id') and 'o_has_error' or ''} col-xl-6">\n                                <label class="col-form-label label-optional" for="state_id">State / Province</label>\n                                <select name="state_id" t-attf-class="form-control #{error.get('state_id') and 'is-invalid' or ''}">\n                                    <option value="">select...</option>\n                                    <t t-foreach="states or []" t-as="state">\n                                        <option t-att-value="state.id" style="display:none;" t-att-data-country_id="state.country_id.id" t-att-selected="state.id == partner.state_id.id">\n                                            <t t-esc="state.name"/>\n                                        </option>\n                                    </t>\n                                </select>\n                            </div>\n                            <input type="hidden" name="redirect" t-att-value="redirect"/>\n                        </div>\n                        <div class="clearfix">\n                            <button type="submit" class="btn btn-primary float-right mb32 ">\n                                Confirm\n                                <span class="fa fa-long-arrow-right"/>\n                            </button>\n                        </div>\n                    </div>\n                </div>\n            </form>\n        </t>\n    </t>\n\n    	portal/views/portal_templates.xml	\N	\N	\N	\N	primary	t	1	2025-08-28 11:32:23.971774	1	2025-08-28 11:32:23.971774	f
1534	report_drsonyasiahaan_surat_sehat	\N	ehealth_document.report_drsonyasiahaan_surat_sehat	16	qweb	<?xml version="1.0"?>\n<t t-name="ehealth_document.report_drsonyasiahaan_surat_sehat">\n        <t t-set="company" t-value="res_company"/>\n        <t t-call="ehealth_document.header_drsonyasiahaan_document">\n          <div class="page">\n            <div class="row">\n              <div class="col-md-12 mt-5">\n                <p class="text-center mt-3 mb-0"><strong>SURAT KETERANGAN SEHAT</strong></p>\n                <p class="text-center">Nomor: <t t-esc="o['name']"/></p>\n                <p class="mt-4">Yang bertanda tangan di bawah ini menerangkan bahwa:</p>\n                <div class="mt-3 ml-3">\n                    <div class="row">\n                        <div class="col-3">\n                          <t t-if="o['partner_id']['identity_type'] == 'ktp'">NIK</t>\n                          <t t-if="o['partner_id']['identity_type'] == 'sim'">No. SIM</t>\n                          <t t-if="o['partner_id']['identity_type'] == 'paspor'">No. Paspor</t>\n                        </div>\n                        <div class="col-6">: \n                          <t t-if="o['partner_id']['identity_type'] == 'ktp'"><t t-esc="o['partner_id']['nik']"/></t>\n                          <t t-else=""><t t-esc="o['partner_id']['identity_number']"/></t>\n                        </div>\n                    </div>\n                    <div class="row">\n                        <div class="col-3">Nama</div>\n                        <div class="col-6">: <t t-esc="o['partner_id']['name']"/></div>\n                    </div>\n                    <div class="row">\n                        <div class="col-3">Tanggal Lahir</div>\n                        <div class="col-6">: <t t-esc="o['partner_id']['birthDate'].strftime('%d-%m-%Y')"/></div>\n                    </div>\n                    <div class="row">\n                        <div class="col-3">Jenis Kelamin</div>\n                        <div class="col-6">: \n                          <t t-if="o['partner_id']['gender'] == 'male'">Laki-Laki</t>\n                          <t t-else="">Perempuan</t>\n                        </div>\n                    </div>\n                    <div class="row">\n                        <div class="col-3">Pekerjaan</div>\n                        <div class="col-6">: <t t-esc="o['partner_id']['function']"/></div>\n                    </div>\n                    <div class="row">\n                        <div class="col-3">Alamat</div>\n                        <div class="col-6">: <t t-esc="o['partner_id']['street']"/></div>\n                    </div>\n                </div>\n                <p class="mt-3 mb-0">Setelah dilakukan pemeriksaan, maka yang bersangkutan dinyatakan </p>\n                <p class="text-center"><strong>SEHAT</strong></p>\n                <p>Demikian Surat Keterangan ini dibuat untuk dapat dipergunakan seperlunya.</p><br/>\n                <div class="row">\n                  <div class="col-3">\n                    <p><strong>Keterangan :</strong></p>\n                  </div>\n                </div>\n                <div class="row">\n                  <div class="col-3">Tinggi Badan</div>\n                  <div class="col-3">: <t t-esc="data['tinggi-badan']"/> cm</div>\n                  <div class="col-3">Tekanan Darah</div>\n                  <div class="col-3">: <t t-esc="data['sistole']"/>/<t t-esc="data['diastole']"/> mmHg</div>\n                </div>\n                <div class="row">\n                  <div class="col-3">Berat Badan</div>\n                  <div class="col-3">: <t t-esc="data['berat-badan']"/> kg</div>\n                  <div class="col-3">Buta Warna</div>\n                  <div class="col-3">: <t t-esc="data['buta-warna']"/></div>\n                </div>\n              </div>\n            </div>\n\n            <div class="row pt-5">\n                <div class="col-1"/>\n                <div class="col-3 mt-4">\n                    <p class="mb-0">Validasi</p>\n                    <div class="mt-3" id="qrcode">\n                        <img t-att-src="o['qr_code_url']" style="width:125px;height:125px;"/>\n                    </div>\n                </div>\n                <div class="col-4"/>\n                <div class="col-4">\n                    <p class="mb-0">Tarutung<t t-esc="o['operating_unit_id']['company_id']['city']"/>, <t t-esc="o.to_date_string(data['registration_date'])"/></p>\n                    <p class="mb-0">Dokter Pemeriksa</p>\n                    <div class="mt-1" id="signature">\n                        <img t-att-src="'/ehealth_document/static/src/img/signature/signature-drsonyasiahaan.png'" style="max-height: 125px;" alt="Logo"/>\n                    </div>\n                    <p class="mb-0 mt-2"><strong>\n                      dr. Sonya Siahaan\n                    </strong></p>\n                </div>\n            </div>\n          </div>\n        </t>\n      </t>\n    	ehealth_document/report/template_surat_sehat/report_drsonyasiahaan_surat_sehat.xml	\N	\N	\N	\N	primary	t	1	2025-08-28 11:34:01.364376	1	2025-08-28 11:34:01.364376	f
540	portal_my_security	\N	portal.portal_my_security	16	qweb	<?xml version="1.0"?>\n<t t-name="portal.portal_my_security">\n        <t t-call="portal.portal_layout"><div class="o_portal_security_body">\n            <t t-set="additional_title">Security</t>\n            <t t-set="no_breadcrumbs" t-value="1"/>\n            <div class="alert alert-danger" role="alert" t-if="get_error(errors)">\n                <t t-esc="errors"/>\n            </div>\n            <section>\n                <h3>Change Password</h3>\n                <t t-set="path">password</t>\n                <div class="alert alert-success" role="alert" t-if="success and success.get('password')">\n                    Password Updated!\n                </div>\n                <div class="alert alert-danger" role="alert" t-if="get_error(errors, 'password')">\n                    <t t-esc="errors['password']"/>\n                </div>\n                <form action="/my/security" method="post" class="oe_reset_password_form">\n                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>\n                    <input type="hidden" name="op" value="password"/>\n                    <div class="form-group">\n                        <label for="current">Password:</label>\n                        <input type="password" t-attf-class="form-control form-control-sm {{ 'is-invalid' if get_error(errors, 'password.old') else '' }}" id="current" name="old" autocomplete="current-password" required="required"/>\n                        <div class="invalid-feedback">\n                            <t t-esc="get_error(errors, 'password.old')"/>\n                        </div>\n                    </div>\n                    <div class="form-group">\n                        <label for="new">New Password:</label>\n                        <input type="password" t-attf-class="form-control form-control-sm {{ 'is-invalid' if get_error(errors, 'password.new1') else '' }}" id="new" name="new1" autocomplete="new-password" required="required"/>\n                        <div class="invalid-feedback">\n                            <t t-esc="get_error(errors, 'password.new1')"/>\n                        </div>\n                    </div>\n                    <div class="form-group">\n                        <label for="new2">Verify New Password:</label>\n                        <input type="password" t-attf-class="form-control form-control-sm {{ 'is-invalid' if get_error(errors, 'password.new2') else '' }}" id="new2" name="new2" autocomplete="new-password" required="required"/>\n                        <div class="invalid-feedback">\n                            <t t-esc="get_error(errors, 'password.new2')"/>\n                        </div>\n                    </div>\n                    <button type="submit" class="btn btn-danger">Change Password</button>\n                </form>\n            </section>\n        </div></t>\n    </t>\n\n    	portal/views/portal_templates.xml	\N	\N	\N	\N	primary	t	1	2025-08-28 11:32:23.971774	1	2025-08-28 11:32:23.971774	f

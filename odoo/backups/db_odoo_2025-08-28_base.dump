169	onboarding_container	\N	base.onboarding_container	16	qweb	<?xml version="1.0"?>\n<t t-name="base.onboarding_container">\n        <div class="modal o_onboarding_modal o_technical_modal" tabindex="-1" role="dialog">\n            <div class="modal-dialog" role="document">\n                <div class="modal-content">\n                    <div class="modal-header">\n                        <h5 class="modal-title">Remove Configuration Tips</h5>\n                        <button type="button" class="close" data-dismiss="modal" aria-label="Close">\n                            <span aria-label="Close">×</span>\n                        </button>\n                    </div>\n                    <div class="modal-body">\n                        <p>Do you want to remove this configuration panel?</p>\n                    </div>\n                    <div class="modal-footer">\n                        <a type="action" class="btn btn-primary" data-dismiss="modal" data-toggle="collapse" href=".o_onboarding_container" t-att-data-model="close_model" t-att-data-method="close_method">\n                            Remove\n                        </a>\n                        <button type="button" class="btn btn-secondary" data-dismiss="modal">Discard</button>\n                    </div>\n                </div>\n            </div>\n        </div>\n        <div class="o_onboarding_container collapse show">\n            <div t-att-class="'o_onboarding ' + ('o_onboarding_completed ' if steps_completed else ' ') + classes" t-att-style="'background-image:url(' + bg_image + ')'">\n                <div class="o_onboarding_wrap">\n                    <a href="#" data-toggle="modal" data-target=".o_onboarding_modal" class="float-right o_onboarding_btn_close">\n                        <i class="fa fa-times" title="Close the onboarding panel"/>\n                    </a>\n                    <div class="o_onboarding_steps">\n                        <t t-raw="0"/>\n                    </div>\n                    <div t-att-class="'o_onboarding_completed_message text-center' + (' o_onboarding_steps_done' if state.get('onboarding_state') in ('done', 'just_done') else '') + (' o_onboarding_steps_just_done' if state.get('onboarding_state') == 'just_done' else '')">\n                        <i class="fa fa-check text-success mr8"/>\n                        <span class="h3 mr16">\n                            <t t-if="text_completed" t-esc="text_completed"/>\n                            <t t-else="">Nice work! Your configuration is done.</t>\n                        </span>\n                            <a type="action" class="btn btn-primary" data-toggle="collapse" href=".o_onboarding_container" t-att-data-model="close_model" t-att-data-method="close_method">\n                                Close\n                            </a>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </t>\n    	base/views/onboarding_views.xml	\N	\N	\N	\N	primary	t	1	2025-08-28 11:31:39.100786	1	2025-08-28 11:31:39.100786	\N

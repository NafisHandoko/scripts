1427	header_swift_document	\N	ehealth_document.header_swift_document	16	qweb	<?xml version="1.0"?>\n<t t-name="ehealth_document.header_swift_document">\n        <div t-attf-class="header mb-4 o_company_#{company.id}_layout" t-att-style="report_header_style">\n            <div class="row zero_min_height mb-3">\n                <div class="col-12" style="width: 100%; height: 20px; background-color:#00a79d;"/>\n            </div>\n            <div class="row">\n                <div class="col-7">\n                    <img t-att-src="'/ehealth_document/static/src/img/logo-swift-test.png'" style="max-height: 90px;" alt="Logo"/>\n                </div>\n                <div class="col-5 text-right">\n                    <p style="font-size: 14px">\n                      <strong>SWIFTTEST.ID</strong><br/>\n                      <t t-esc="o['operating_unit_id']['address']"/><br/>\n                    </p>\n                </div>\n            </div>\n        </div>\n\n        <div t-attf-class="article o_report_layout_standard o_company_#{company.id}_layout" t-att-data-oe-model="o and o._name" t-att-data-oe-id="o and o.id" t-att-data-oe-lang="o and o.env.context.get('lang')">\n            <t t-call="web.address_layout"/>\n            <t t-raw="0"/>\n        </div>\n\n        <div t-attf-class="footer o_company_#{company.id}_layout">\n            <div class="row mt-3">\n                <div class="col-12" style="width: 100%; height: 20px; background-color:#00a79d;"/>\n            </div>\n        </div>\n      </t>\n    	ehealth_document/report/header_document/header_swift_document.xml	\N	\N	\N	\N	primary	t	1	2025-08-28 11:34:01.364376	1	2025-08-28 11:34:01.364376	f

1130	export_ubl_invoice_partner	\N	account_edi_ubl.export_ubl_invoice_partner	16	qweb	<?xml version="1.0"?>\n<t t-name="account_edi_ubl.export_ubl_invoice_partner">\n            <cac:Party xmlns="urn:oasis:names:specification:ubl:schema:xsd:Invoice-2" xmlns:cac="urn:oasis:names:specification:ubl:schema:xsd:CommonAggregateComponents-2" xmlns:cbc="urn:oasis:names:specification:ubl:schema:xsd:CommonBasicComponents-2">\n                <cbc:WebsiteURI t-if="partner.website" t-esc="partner.website"/>\n                <cac:PartyName>\n                    <cbc:Name t-esc="partner.name"/>\n                </cac:PartyName>\n                <cac:Language t-if="partner.lang">\n                    <cbc:LocaleCode t-esc="partner.lang"/>\n                </cac:Language>\n                <cac:PostalAddress>\n                    <cbc:StreetName t-if="partner.street" t-esc="partner.street"/>\n                    <cbc:AdditionalStreetName t-if="partner.street2" t-esc="partner.street2"/>\n                    <cbc:CityName t-if="partner.city" t-esc="partner.city"/>\n                    <cbc:PostalZone t-if="partner.zip" t-esc="partner.zip"/>\n                    <cbc:CountrySubentity t-if="partner.state_id" t-esc="partner.state_id.name"/>\n                    <cbc:CountrySubentityCode t-if="partner.state_id" t-esc="partner.state_id.code"/>\n                    <cac:Country t-if="partner.country_id">\n                        <cbc:IdentificationCode t-esc="partner.country_id.code"/>\n                        <cbc:Name t-esc="partner.country_id.name"/>\n                    </cac:Country>\n                </cac:PostalAddress>\n                <cac:PartyTaxScheme t-if="partner.vat">\n                    <cbc:RegistrationName t-esc="partner.name"/>\n                    <cbc:CompanyID t-esc="partner.vat"/>\n                    <cac:TaxScheme>\n                        <cbc:ID schemeID="UN/ECE 5153" schemeAgencyID="6">VAT</cbc:ID>\n                    </cac:TaxScheme>\n                </cac:PartyTaxScheme>\n                <cac:Contact>\n                    <cbc:Name t-esc="partner.name"/>\n                    <cbc:Telephone t-if="partner.phone" t-esc="partner.phone"/>\n                    <cbc:ElectronicMail t-if="partner.email" t-esc="partner.email"/>\n                </cac:Contact>\n            </cac:Party>\n        </t>\n\n        	account_edi_ubl/data/ubl_templates.xml	\N	\N	\N	\N	primary	t	1	2025-08-28 11:33:17.982965	1	2025-08-28 11:33:17.982965	f
1131	export_ubl_invoice_line	\N	account_edi_ubl.export_ubl_invoice_line	16	qweb	<?xml version="1.0"?>\n<t t-name="account_edi_ubl.export_ubl_invoice_line">\n            <cac:InvoiceLine xmlns="urn:oasis:names:specification:ubl:schema:xsd:Invoice-2" xmlns:cac="urn:oasis:names:specification:ubl:schema:xsd:CommonAggregateComponents-2" xmlns:cbc="urn:oasis:names:specification:ubl:schema:xsd:CommonBasicComponents-2">\n                <cbc:ID t-esc="line._origin.id"/>\n                <cbc:Note t-if="line.discount">Discount (<t t-esc="line.discount"/> %)</cbc:Note>\n                <cbc:InvoicedQuantity t-esc="line.quantity"/>\n                <cbc:LineExtensionAmount t-att-currencyID="line.currency_id.name or invoice.currency_id.name" t-esc="format_monetary(line.price_subtotal)"/>\n                <cac:TaxTotal t-foreach="line.tax_ids.compute_all(line.price_unit, quantity=line.quantity, product=line.product_id, partner=invoice.partner_id)['taxes']" t-as="tax">\n                    <cbc:TaxAmount t-att-currencyID="line.currency_id.name or invoice.currency_id.name" t-esc="format_monetary(tax['amount'])"/>\n                </cac:TaxTotal>\n                <cac:Item>\n                    <cbc:Description t-if="line.name" t-esc="line.name.replace('\\n', ', ')"/>\n                    <cbc:Name t-esc="line.product_id.name"/>\n                    <cac:SellersItemIdentification t-if="line.product_id.default_code">\n                        <cbc:ID t-esc="line.product_id.default_code"/>\n                    </cac:SellersItemIdentification>\n                </cac:Item>\n                <cac:Price>\n                    <cbc:PriceAmount t-att-currencyID="line.currency_id.name or invoice.currency_id.name" t-esc="format_monetary(line.price_unit)"/>\n                </cac:Price>\n            </cac:InvoiceLine>\n        </t>\n\n        	account_edi_ubl/data/ubl_templates.xml	\N	\N	\N	\N	primary	t	1	2025-08-28 11:33:17.982965	1	2025-08-28 11:33:17.982965	f

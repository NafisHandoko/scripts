966	account.move.form	account.move	\N	16	form	<?xml version="1.0"?>\n<data><xpath expr="//group[hasclass('oe_subtotal_footer')]" position="replace">\n                    <group>\n                        <group>\n                            <field name="global_discount_type" groups="discount_account_invoice.group_order_global_discount" class="oe_inline" attrs="{'required': [('global_order_discount', '&gt;', 0.0)], 'readonly' : [('state', 'not in', ['draft'])]}"/>\n                            <field name="global_order_discount" groups="discount_account_invoice.group_order_global_discount" class="oe_inline" attrs="{'readonly' :[('state', 'not in', ['draft'])]}"/>\n                        </group>\n                        <group class="oe_subtotal_footer oe_right" attrs="{'invisible': ['|', ('move_type', 'not in', ('out_invoice', 'out_refund', 'in_invoice', 'in_refund', 'out_receipt', 'in_receipt')), ('payment_state' ,'=', 'invoicing_legacy')]}">\n                            <field name="amount_tax" invisible="1"/>\n                            <field name="amount_untaxed" attrs="{'invisible': [('amount_tax', '=', 0)]}"/>\n                            <field name="amount_by_group" widget="tax-group-custom-field" nolabel="1" colspan="2" attrs="{'invisible': [('amount_tax', '=', 0)]}"/>\n                            <field name="total_discount" groups="product.group_discount_per_so_line,discount_account_invoice.group_order_global_discount" widget="monetary" options="{'currency_field': 'currency_id'}"/>\n                            <field name="amount_total" attrs="{'invisible': [('amount_tax', '!=', 0)]}"/>\n                            <field name="amount_total" class="oe_subtotal_footer_separator" attrs="{'invisible': [('amount_tax', '=', 0)]}"/>\n                            <field name="invoice_payments_widget" colspan="2" nolabel="1" widget="payment"/>\n                            <field name="amount_residual" class="oe_subtotal_footer_separator" attrs="{'invisible': [('state', '=', 'draft')]}"/>\n                        </group>\n                    </group>\n                </xpath>\n\n                <xpath expr="//field[@name='invoice_line_ids']/tree/field[@name='discount']" position="before">\n                    <field name="discount_type" groups="product.group_discount_per_so_line" optional="show"/>\n                </xpath>\n\n                <xpath expr="//field[@name='invoice_line_ids']/tree/field[@name='discount']" position="attributes">\n                    <attribute name="string">Discount</attribute>\n                    <attribute name="optional">show</attribute>\n                    <attribute name="groups">product.group_discount_per_so_line</attribute>\n                </xpath>\n\n                <xpath expr="//field[@name='line_ids']/tree/field[@name='discount']" position="before">\n                    <field name="is_global_line" invisible="1"/>\n                    <field name="discount_type" invisible="1"/>\n                </xpath>\n            </data>	discount_account_invoice/views/account_move_view.xml	\N	\N	624	\N	extension	t	1	2025-08-28 11:32:57.984551	1	2025-08-28 11:32:57.984551	f
967	asset.depreciation.confirmation.wizard	asset.depreciation.confirmation.wizard	\N	16	form	<?xml version="1.0"?>\n<form string="Compute Asset">\n                <div>\n                    <p>\n                        This wizard will post installment/depreciation lines for the selected month.<br/>\n                        This will generate journal entries for all related installment lines on this period of asset/revenue recognition as well.\n                    </p> \n                </div>\n                <group>\n                    <field name="date"/>\n                </group>\n                <footer>\n                    <button string="Generate Entries" name="asset_compute" type="object" class="btn-primary"/>\n                    <button string="Cancel" class="btn-secondary" special="cancel"/>\n                </footer>\n            </form>\n         	om_account_asset/wizard/asset_depreciation_confirmation_wizard_views.xml	\N	\N	\N	\N	primary	t	1	2025-08-28 11:32:59.711572	1	2025-08-28 11:32:59.711572	f
973	account.asset.asset.form	account.asset.asset	\N	16	form	<?xml version="1.0"?>\n<form string="Asset">\n                <header>\n                    <button name="validate" states="draft" string="Confirm" type="object" class="oe_highlight"/>\n                    <button type="object" name="compute_depreciation_board" string="Compute Depreciation" states="draft"/>\n                    <button name="set_to_close" states="open" string="Sell or Dispose" type="object" class="oe_highlight"/>\n                    <button name="set_to_draft" string="Set to Draft" type="object" attrs="{'invisible': ['|', ('entry_count', '!=', 0), ('state', '!=', 'open')]}"/>\n                    <button name="358" states="open" string="Modify Depreciation" type="action"/>\n                    <field name="state" widget="statusbar" statusbar_visible="draft,open"/>\n                </header>\n                <sheet>\n                    <div class="oe_button_box" name="button_box">\n                        <button class="oe_stat_button" name="open_entries" type="object" icon="fa-pencil">\n                            <field string="Items" name="entry_count" widget="statinfo"/>\n                        </button>\n                    </div>\n                    <div class="oe_title">\n                        <label for="name" class="oe_edit_only"/>\n                        <h1>\n                            <field name="name" placeholder="e.g. Laptop iBook"/>\n                        </h1>\n                    </div>\n                    <group>\n                        <group>\n                            <field name="category_id" string="Asset Category" domain="[('type', '=', 'purchase')]" context="{'default_type': 'purchase'}" help="Category of asset"/>\n                            <field name="code"/>\n                            <field name="date" help="Date of asset"/>\n                            <field name="date_first_depreciation"/>\n                            <field name="first_depreciation_manual_date" attrs="{'invisible': [('date_first_depreciation', '!=', 'manual')], 'required': [('date_first_depreciation', '=', 'manual')]}"/>\n                            <field name="type" invisible="1"/>\n                            <field name="account_analytic_id" groups="analytic.group_analytic_accounting"/>\n                        </group>\n                        <group>\n                            <field name="currency_id" groups="base.group_multi_currency"/>\n                            <field name="company_id" options="{'no_create': True}" groups="base.group_multi_company"/>\n                            <field name="value" widget="monetary" options="{'currency_field': 'currency_id'}" help="Gross value of asset"/>\n                            <field name="salvage_value" widget="monetary" options="{'currency_field': 'currency_id'}" attrs="{'invisible': [('type','=','sale')]}"/>\n                            <field name="value_residual" widget="monetary" options="{'currency_field': 'currency_id'}"/>\n                            <field name="partner_id" string="Vendor" widget="res_partner_many2one" context="{'res_partner_search_mode': 'supplier'}"/>\n                            <field name="invoice_id" string="Invoice" options="{'no_create': True}"/>\n                            <field name="analytic_tag_ids" groups="analytic.group_analytic_accounting" widget="many2many_tags"/>\n                        </group>\n                    </group>\n                    <notebook colspan="4">\n                        <page string="Depreciation Board">\n                            <field name="depreciation_line_ids" mode="tree" options="{'reload_whole_on_button': true}">\n                                <tree string="Depreciation Lines" decoration-info="(move_check == False)" create="false">\n                                    <field name="depreciation_date"/>\n                                    <field name="amount" widget="monetary" string="Depreciation"/>\n                                    <field name="depreciated_value" readonly="1"/>\n                                    <field name="remaining_value" readonly="1" widget="monetary" string="Residual"/>\n                                    <field name="move_check" widget="deprec_lines_toggler" attrs="{'invisible': [('parent_state', '!=', 'open')]}"/>\n                                    <field name="move_posted_check" invisible="1"/>\n                                    <field name="parent_state" invisible="1"/>\n                                </tree>\n                                <form string="Depreciation Lines" create="false">\n                                    <group>\n                                        <group>\n                                            <field name="parent_state" invisible="1"/>\n                                            <field name="name"/>\n                                            <field name="sequence"/>\n                                            <field name="move_id"/>\n                                            <field name="move_check"/>\n                                            <field name="parent_state" invisible="1"/>\n                                        </group>\n                                        <group>\n                                            <field name="amount" widget="monetary"/>\n                                            <field name="depreciation_date"/>\n                                            <field name="depreciated_value"/>\n                                            <field name="remaining_value"/>\n                                        </group>\n                                    </group>\n                                </form>\n                            </field>\n                        </page>\n                        <page string="Depreciation Information">\n                            <group>\n                                <field name="method" widget="radio" attrs="{'invisible': [('type','=','sale')]}"/>\n                                <field name="method_progress_factor" attrs="{'invisible':[('method','=','linear')], 'required':[('method','=','degressive')]}"/>\n                                <field name="method_time" string="Time Method Based On" widget="radio" attrs="{'invisible': [('type','!=','purchase')]}"/>\n                                <field name="prorata" attrs="{'invisible': [('method_time','=','end')]}"/>\n                            </group>\n                            <group>\n                                <field name="method_number" attrs="{'invisible':[('method_time','=','end')], 'required':[('method_time','=','number')]}"/>\n                                <field name="method_period"/>\n                                <field name="method_end" attrs="{'required': [('method_time','=','end')], 'invisible':[('method_time','=','number')]}"/>\n                            </group>\n                        </page>\n                    </notebook>\n                </sheet>\n                <div class="oe_chatter">\n                    <field name="message_follower_ids" widget="mail_followers"/>\n                    <field name="message_ids" widget="mail_thread"/>\n                </div>\n            </form>\n        	om_account_asset/views/account_asset_views.xml	\N	\N	\N	\N	primary	t	1	2025-08-28 11:32:59.711572	1	2025-08-28 11:32:59.711572	f

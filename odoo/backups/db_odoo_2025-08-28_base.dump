596	account.payment.kanban	account.payment	\N	16	kanban	<?xml version="1.0"?>\n<kanban class="o_kanban_mobile" create="0" group_create="0" sample="1">\n                    <field name="name"/>\n                    <field name="partner_id"/>\n                    <field name="date"/>\n                    <field name="state"/>\n                    <templates>\n                        <t t-name="kanban-box">\n                            <div t-attf-class="oe_kanban_global_click">\n                                <div class="row mb4">\n                                    <div class="col-6">\n                                        <strong><span><field name="name"/></span></strong>\n                                    </div>\n                                    <div class="col-6 text-right">\n                                        <strong><i class="fa fa-clock-o" role="img" aria-label="Date" title="Date"/> <t t-esc="record.date.value"/></strong>\n                                    </div>\n                                </div>\n                                <div class="row">\n                                    <div class="col-12">\n                                        <span><field name="partner_id"/></span>\n                                    </div>\n                                </div>\n                                <div class="row">\n                                    <div class="col-6">\n                                        <field name="amount" widget="monetary"/>\n                                        <field name="currency_id" invisible="1"/>\n                                    </div>\n                                    <div class="col-6">\n                                        <span class="float-right">\n                                            <field name="state" widget="label_selection" options="{'classes': {'draft': 'secondary', 'sent': 'success'}}"/>\n                                        </span>\n                                    </div>\n                                </div>\n                            </div>\n                        </t>\n                    </templates>\n                </kanban>\n            	account/views/account_payment_view.xml	\N	\N	\N	\N	primary	t	1	2025-08-28 11:32:28.994214	1	2025-08-28 11:32:28.994214	f
597	account.payment.search	account.payment	\N	16	search	<?xml version="1.0"?>\n<search string="Payments">\n                    <field name="name" string="Payment" filter_domain="['|', '|', ('name', 'ilike', self), ('partner_id', 'ilike', self), ('ref', 'ilike', self)]"/>\n                    <field name="partner_id" string="Customer/Vendor"/>\n                    <field name="journal_id"/>\n                    <field name="is_internal_transfer"/>\n                    <separator/>\n                    <filter string="Customer Payments" name="inbound_filter" domain="[('partner_type', '=', 'customer'), ('is_internal_transfer', '=', False)]"/>\n                    <filter string="Vendor Payments" name="outbound_filter" domain="[('partner_type', '=', 'supplier'), ('is_internal_transfer', '=', False)]"/>\n                    <filter string="Transfers" name="transfers_filter" domain="[('is_internal_transfer', '=', True)]"/>\n                    <separator/>\n                    <filter string="Draft" name="state_draft" domain="[('state', '=', 'draft')]"/>\n                    <filter string="Posted" name="state_posted" domain="[('state', '=', 'posted')]"/>\n                    <separator/>\n                    <filter string="Sent" name="state_sent" domain="[('is_move_sent', '=', True)]"/>\n                    <filter string="Bank Matched" name="matched" domain="[('is_matched', '=', True)]"/>\n                    <filter string="Reconciled" name="reconciled" domain="[('is_reconciled', '=', True)]"/>\n                    <separator/>\n                    <filter string="Payment Date" name="date" date="date"/>\n                    <separator/>\n                    <field name="company_id" groups="base.group_multi_company"/>\n                    <filter string="Customer/Vendor" name="partner" domain="[]" context="{'group_by': 'partner_id'}"/>\n                    <filter string="Journal" name="journal" domain="[]" context="{'group_by': 'journal_id'}"/>\n                    <filter string="Payment Method" name="paymentmethod" domain="[]" context="{'group_by': 'payment_method_id'}"/>\n                    <filter string="Status" name="state" domain="[]" context="{'group_by': 'state'}"/>\n                    <filter string="Payment Date" name="groupby_date" domain="[]" context="{'group_by': 'date'}"/>\n                    <filter string="Currency" name="currency" domain="[]" context="{'group_by': 'currency_id'}" groups="base.group_multi_currency"/>\n                    <filter string="Company" name="company" domain="[]" context="{'group_by': 'company_id'}" groups="base.group_multi_company"/>\n                    <separator/>\n                    <filter invisible="1" string="Late Activities" name="activities_overdue" domain="[('my_activity_date_deadline', '&lt;', context_today().strftime('%Y-%m-%d'))]" help="Show all records which has next action date is before today"/>\n                    <filter invisible="1" string="Today Activities" name="activities_today" domain="[('my_activity_date_deadline', '=', context_today().strftime('%Y-%m-%d'))]"/>\n                    <filter invisible="1" string="Future Activities" name="activities_upcoming_all" domain="[('my_activity_date_deadline', '&gt;', context_today().strftime('%Y-%m-%d'))]"/>\n                </search>\n            	account/views/account_payment_view.xml	\N	\N	\N	\N	primary	t	1	2025-08-28 11:32:28.994214	1	2025-08-28 11:32:28.994214	f
1549	report_westerindo_surat_sakit	\N	ehealth_document.report_westerindo_surat_sakit	16	qweb	<?xml version="1.0"?>\n<t t-name="ehealth_document.report_westerindo_surat_sakit">\n        <t t-set="company" t-value="res_company"/>\n        <t t-call="ehealth_document.header_westerindo_multi_ou_document">\n          <div class="page">\n            <div class="row">\n              <div class="col-md-12">\n                <p class="text-center mt-3 mb-0"><strong>SURAT KETERANGAN SAKIT</strong></p>\n                <p class="text-center">Nomor: <t t-esc="o['name']"/></p>\n                <p class="mt-4">Yang bertanda tangan di bawah ini menerangkan bahwa:</p>\n                <div class="mt-3 ml-3">\n                    <div class="row">\n                        <div class="col-3">\n                          <t t-if="o['partner_id']['identity_type'] == 'ktp'">NIK</t>\n                          <t t-if="o['partner_id']['identity_type'] == 'sim'">No. SIM</t>\n                          <t t-if="o['partner_id']['identity_type'] == 'paspor'">No. Paspor</t>\n                        </div>\n                        <div class="col-6">: \n                          <t t-if="o['partner_id']['identity_type'] == 'ktp'"><t t-esc="o['partner_id']['nik']"/></t>\n                          <t t-else=""><t t-esc="o['partner_id']['identity_number']"/></t>\n                        </div>\n                    </div>\n                    <div class="row">\n                        <div class="col-3">Nama</div>\n                        <div class="col-6">: <strong><t t-esc="o['partner_id']['name']"/></strong></div>\n                    </div>\n                    <div class="row">\n                        <div class="col-3">Tanggal Lahir</div>\n                        <div class="col-6">: <t t-esc="o['partner_id']['birthDate'].strftime('%d-%m-%Y')"/></div>\n                    </div>\n                    <div class="row">\n                        <div class="col-3">Jenis Kelamin</div>\n                        <div class="col-6">: \n                          <t t-if="o['partner_id']['gender'] == 'male'">Laki-Laki</t>\n                          <t t-else="">Perempuan</t>\n                        </div>\n                    </div>\n                    <div class="row">\n                        <div class="col-3">Pekerjaan</div>\n                        <div class="col-6">: <t t-esc="o['partner_id']['function']"/></div>\n                    </div>\n                    <div class="row">\n                        <div class="col-3">Alamat</div>\n                        <div class="col-6">: <t t-esc="o['partner_id']['street']"/></div>\n                    </div>\n                    <div class="row">\n                        <div class="col-3">Diagnosa</div>\n                        <div class="col-6">: <t t-esc="data['diagnosa']"/></div>\n                    </div>\n                </div>\n                <p class="mt-3 mb-2">Perlu beristirahat karena sakit sehingga tidak dapat melaksanakan kewajibannya selama: <strong><t t-esc="o.count_date_delta(data['tanggal-awal'],data['tanggal-akhir'])"/> hari</strong> terhitung <br/> mulai tanggal <strong><t t-esc="data['tanggal-awal']"/></strong> s/d <strong><t t-esc="data['tanggal-akhir']"/></strong>.</p>\n                <p>Harap yang berkepentingan maklum.</p><br/>\n              </div>\n            </div>\n\n            <div class="row pt-5">\n                <div class="col-1"/>\n                <div class="col-3 mt-4">\n                    <div class="pt-5" id="qrcode">\n                        <img t-att-src="o['qr_code_url']" style="width:125px;height:125px;"/>\n                    </div>\n                </div>\n                <div class="col-4"/>\n                <div class="col-4">\n                    <p class="mb-0"><t t-esc="o['operating_unit_id']['city']"/>, <t t-esc="o.to_date_string(data['registration_date'])"/></p>\n                    <p class="mb-0">Dokter Pemeriksa</p>\n                    <div class="mt-3" id="qrcode">\n                        <t t-if="'qr_code_examiner_url' in data">\n                          <img t-att-src="data['qr_code_examiner_url']" style="width:125px;height:125px;"/>\n                        </t>\n                        <t t-else="">\n                          <div style="width:125px;height:125px;"/>\n                        </t>\n                    </div>\n                    <p class="mb-0 mt-2"><strong>\n                    <t t-if="'examiner_name' in data">\n                      <t t-esc="data['examiner_name']"/>\n                    </t>\n                    <t t-else="">\n                      <t t-esc="data['sender']"/>\n                    </t>\n                    </strong></p>\n                </div>\n            </div>\n          </div>\n        </t>\n      </t>\n    	ehealth_document/report/template_surat_sakit/report_westerindo_surat_sakit.xml	\N	\N	\N	\N	primary	t	1	2025-08-28 11:34:01.364376	1	2025-08-28 11:34:01.364376	f
598	account.payment.form	account.payment	\N	16	form	<?xml version="1.0"?>\n<form string="Register Payment">\n                    <header>\n                        <button name="action_post" string="Confirm" type="object" class="oe_highlight" attrs="{'invisible': [('state', '!=', 'draft')]}"/>\n                        <button name="action_draft" string="Reset To Draft" type="object" class="btn btn-secondary" attrs="{'invisible': [('state', 'not in', ('posted', 'cancel'))]}" groups="account.group_account_invoice"/>\n                        <button name="action_cancel" string="Cancel" type="object" attrs="{'invisible': [('state', '!=', 'draft')]}"/>\n                        <button name="mark_as_sent" string="Mark as Sent" type="object" attrs="{'invisible': ['|', '|', ('state', '!=', 'posted'), ('is_move_sent', '=', True), ('payment_method_code', '!=', 'manual')]}"/>\n                        <button name="unmark_as_sent" string="Unmark as Sent" type="object" attrs="{'invisible': ['|', '|', ('state', '!=', 'posted'), ('is_move_sent', '=', False), ('payment_method_code', '!=', 'manual')]}"/>\n                        <field name="state" widget="statusbar" statusbar_visible="draft,posted"/>\n                    </header>\n\n                    <sheet>\n                        <!-- Invisible fields -->\n                        <field name="id" invisible="1"/>\n                        <field name="is_move_sent" invisible="1"/>\n                        <field name="is_reconciled" invisible="1"/>\n                        <field name="is_matched" invisible="1"/>\n                        <field name="payment_method_code" invisible="1"/>\n                        <field name="show_partner_bank_account" invisible="1"/>\n                        <field name="require_partner_bank_account" invisible="1"/>\n                        <field name="hide_payment_method" invisible="1"/>\n                        <field name="available_partner_bank_ids" invisible="1"/>\n                        <field name="available_payment_method_ids" invisible="1"/>\n                        <field name="suitable_journal_ids" invisible="1"/>\n                        <field name="country_code" invisible="1"/>\n\n                        <div class="oe_button_box" name="button_box">\n                            <!-- Invoice stat button -->\n                            <button name="button_open_invoices" type="object" class="oe_stat_button" icon="fa-bars" attrs="{'invisible': [('reconciled_invoices_count','=', 0)]}">\n                                <field name="reconciled_invoices_count"/>\n                                <span attrs="{'invisible': [('reconciled_invoices_count','&gt;', 1)]}">Invoice</span>\n                                <span attrs="{'invisible': [('reconciled_invoices_count','&lt;=', 1)]}">Invoices</span>\n                            </button>\n\n                            <!-- Bill stat button -->\n                            <button name="button_open_bills" type="object" class="oe_stat_button" icon="fa-bars" attrs="{'invisible': [('reconciled_bills_count','=', 0)]}">\n                                <field name="reconciled_bills_count"/>\n                                <span attrs="{'invisible': [('reconciled_bills_count','&gt;', 1)]}">Bill</span>\n                                <span attrs="{'invisible': [('reconciled_bills_count','&lt;=', 1)]}">Bills</span>\n                            </button>\n\n                            <!-- Statement stat button -->\n                            <button name="button_open_statements" type="object" class="oe_stat_button" icon="fa-bars" attrs="{'invisible': [('reconciled_statements_count','=', 0)]}">\n                                <field name="reconciled_statements_count"/>\n                                <span attrs="{'invisible': [('reconciled_statements_count','&gt;', 1)]}">Statement</span>\n                                <span attrs="{'invisible': [('reconciled_statements_count','&lt;=', 1)]}">Statements</span>\n                            </button>\n                        </div>\n\n                        <widget name="web_ribbon" text="Invoicing App Legacy" bg_color="bg-info" attrs="{'invisible': [('state', '!=', 'invoicing_legacy')]}" tooltip="This payment has been generated through the Invoicing app, before installing Accounting. It has been disabled by the 'Invoicing Switch Threshold Date' setting so that it does not impact your accounting."/>\n\n                        <div class="oe_title" attrs="{'invisible': [('state', '=', 'draft')]}">\n                            <h1><field name="name" attrs="{'readonly': [('state', '!=', 'draft')]}"/></h1>\n                        </div>\n\n                        <group>\n                            <group name="group1">\n                                <field name="payment_type" widget="radio" attrs="{'readonly': [('state', '!=', 'draft')]}"/>\n                                <field name="partner_type" widget="selection" attrs="{'readonly': [('state', '!=', 'draft')], 'invisible': [('is_internal_transfer', '=', True)]}"/>\n                                <field name="partner_id" context="{'default_is_company': True}" attrs="{'readonly': ['|', ('state', '!=', 'draft'), ('is_internal_transfer', '=', True)]}"/>\n                                <field name="destination_account_id" options="{'no_create': True}" required="1" attrs="{'readonly': ['|', ('state', '!=', 'draft'), ('is_internal_transfer', '=', True)]}"/>\n                                <field name="is_internal_transfer" attrs="{'readonly': [('state', '!=', 'draft')]}"/>\n                                <field name="company_id" groups="base.group_multi_company"/>\n                            </group>\n                            <group name="group2">\n                                <field name="journal_id" widget="selection" domain="[('type', 'in', ('bank', 'cash'))]" attrs="{'readonly': [('state', '!=', 'draft')]}"/>\n                                <field name="payment_method_id" widget="radio" required="1" attrs="{'readonly': [('state', '!=', 'draft')], 'invisible': [('hide_payment_method', '=', True)]}"/>\n                                <field name="partner_bank_id" context="{'default_partner_id': partner_id}" attrs="{'invisible': [('show_partner_bank_account', '=', False)], 'required': [('require_partner_bank_account', '=', True)], 'readonly': [('state', '!=', 'draft')]}"/>\n\n                                <!-- /!\\ Required due to the _inherits but must not be required when saving a new\n                                record. Using 'required': [('id', '!=', False)] is not working due to the groups set on\n                                the field.\n                                -->\n                                <field name="move_id" required="0" attrs="{'invisible': [('id', '=', False)]}" groups="account.group_account_readonly"/>\n                            </group>\n                            <group name="group3">\n                                <label for="amount"/>\n                                <div name="amount_div" class="o_row">\n                                    <field name="amount" attrs="{'readonly': [('state', '!=', 'draft')]}"/>\n                                    <field name="currency_id" options="{'no_create': True, 'no_open': True}" required="1" attrs="{'readonly': [('state', '!=', 'draft')]}" groups="base.group_multi_currency"/>\n                                </div>\n                                <field name="date" attrs="{'readonly': [('state', '!=', 'draft')]}"/>\n                                <field name="ref" string="Memo"/>\n                            </group>\n\n                            <group>\n                                <field name="qr_code" invisible="1"/>\n                                <div attrs="{'invisible': [('qr_code', '=', False)]}" colspan="2" class="text-center">\n                                    <field name="qr_code" widget="html"/>\n                                </div>\n                            </group>\n                        </group>\n                    </sheet>\n                    <div class="o_attachment_preview"/>\n                    <div class="oe_chatter">\n                        <field name="message_follower_ids" groups="base.group_user"/>\n                        <field name="activity_ids"/>\n                        <field name="message_ids"/>\n                    </div>\n                </form>\n            	account/views/account_payment_view.xml	\N	\N	\N	\N	primary	t	1	2025-08-28 11:32:28.994214	1	2025-08-28 11:32:28.994214	f
587	digest.digest.view.form	digest.digest	\N	16	form	<?xml version="1.0"?>\n<form string="KPI Digest">\n                <field name="is_subscribed" invisible="1"/>\n                <header>\n                    <button type="object" name="action_subscribe" string="Subscribe" class="oe_highlight" attrs="{'invisible': ['|',('is_subscribed', '=', True), ('state','=','deactivated')]}"/>\n                    <button type="object" name="action_unsubcribe" string="Unsubscribe me" class="oe_highlight" attrs="{'invisible': ['|',('is_subscribed', '=', False), ('state','=','deactivated')]}"/>\n                    <button type="object" name="action_deactivate" string="Deactivate for everyone" class="oe_highlight" attrs="{'invisible': [('state','=','deactivated')]}" groups="base.group_system"/>\n                    <button type="object" name="action_activate" string="Activate" class="oe_highlight" attrs="{'invisible': [('state','=','activated')]}" groups="base.group_system"/>\n                    <button type="object" name="action_send" string="Send Now" class="oe_highlight" attrs="{'invisible': [('state','=','deactivated')]}" groups="base.group_system"/>\n                    <field name="state" widget="statusbar"/>\n                </header>\n                <sheet>\n                    <div class="oe_title">\n                        <label for="name" class="oe_edit_only"/>\n                        <h1>\n                            <field name="name"/>\n                        </h1>\n                    </div>\n                    <group>\n                        <group>\n                            <field name="periodicity" widget="radio" options="{'horizontal': true}"/>\n                            <field name="next_run_date" groups="base.group_system"/>\n                            <field name="company_id" options="{'no_create': True}" invisible="1"/>\n                        </group>\n                    </group>\n                    <notebook>\n                        <page name="kpis" string="KPIs">\n                            <group name="kpis">\n                                <group name="kpi_general" string="General" groups="base.group_system">\n                                    <field name="kpi_res_users_connected"/>\n                                    <field name="kpi_mail_message_total"/>\n                                </group>\n                                <group name="kpi_sales"/>\n                            </group>\n                        </page>\n                        <page name="recipients" string="Recipients" groups="base.group_system">\n                            <group>\n                                <field name="user_ids" options="{'no_create': True}">\n                                    <tree string="Recipients">\n                                        <field name="name"/>\n                                        <field name="email"/>\n                                    </tree>\n                                </field>\n                            </group>\n                        </page>\n                        <page name="how_to" string="How to customize your digest?" groups="base.group_no_one">\n                            <div class="alert alert-info" role="alert">\n                                In order to build your customized digest, follow these steps:\n                                <ol>\n                                    <li>\n                                        You may want to add new computed fields with Odoo Studio:\n                                        <ul>\n                                            <li>\n                                                you must create 2 fields on the\n                                                <code>digest</code>\n                                                object:\n                                            </li>\n                                            <li>\n                                                first create a boolean field called\n                                                <code>kpi_myfield</code>\n                                                and display it in the KPI's tab;\n                                            </li>\n                                            <li>\n                                                then create a computed field called\n                                                <code>kpi_myfield_value</code>\n                                                that will compute your customized KPI.\n                                            </li>\n                                        </ul>\n                                    </li>\n                                    <li>Select your KPIs in the KPI's tab.</li>\n                                    <li>\n                                        Create or edit the mail template: you may get computed KPI's value using these fields:\n                                        <code>\n                                            <field name="available_fields" class="oe_inline"/>\n                                        </code>\n                                    </li>\n                                </ol>\n                            </div>\n                        </page>\n                    </notebook>\n                </sheet>\n            </form>\n        	digest/views/digest_views.xml	\N	\N	\N	\N	primary	t	1	2025-08-28 11:32:28.180417	1	2025-08-28 11:32:28.180417	f

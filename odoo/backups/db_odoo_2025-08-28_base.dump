1315	Prescription Form	ehealth.prescription	\N	16	form	<?xml version="1.0"?>\n<form string="Prescription Form" duplicate="0"> \n          <header>\n            <field name="status_prescription" widget="statusbar" clickable="True"/>\n            <button string="Dispense" type="object" name="open_wizard" class="oe_highlight" attrs="{'invisible': [('status_prescription', '!=', 'prescribed')]}"/>\n            <button string="Cancel" type="object" name="cancel_prescription_btn" attrs="{'invisible': [('status_prescription', '!=', 'prescribed')]}"/>\n            <button string="Re-dispense" type="object" name="open_wizard" attrs="{'invisible': [('status_prescription', '!=', 'dispensed')]}" confirm="Are you sure? Redispense action will make multiple Medication Dispense entries."/>\n            <button name="reset_to_prescribed_btn" string="Reset to Prescribed" type="object" confirm="Are you sure want to reset this entry to prescribed?" attrs="{'invisible': [('status_prescription', '=', 'prescribed')]}"/>\n            <button style="background-color: #00A09D; color: #fff;" name="call_button" string="Panggil Pasien" type="object"/>\n          </header>\n          <sheet>\n<!--            <div class="oe_title">-->\n<!--                <h1 class="mt0">-->\n<!--                    <field name="name" placeholder="MED/PRESC/001"/>-->\n<!--                </h1>-->\n<!--            </div>-->\n            <group>\n              <field name="name"/>\n              <field name="patient" string="Patient"/>\n              <field name="practitioner" string="Practitioner"/>\n              <field name="compositionDate" string="Order Date"/>\n              <field name="operating_unit_id" string="Operating Unit"/>\n              <field name="pricelist_id" string="Payment Scheme"/>\n            </group>\n            <group>\n              <notebook>\n                <page string="Medication Request" attrs="{'autofocus': [('status_prescription', '==', 'prescribed')]}">\n                    <field name="requestIds" string="Medication Request">\n                        <tree decoration-bf="invocatio == 'R/'">\n                              <field name="invocatio" string=" " style="width:30px; max-width:30px;"/>\n                              <field name="inscriptio" string="Inscriptio"/>\n                              <field name="concoction_type" string="Tipe Racikan"/>\n                              <field name="subscriptio" string="Subscriptio"/>\n                              <field name="signatura" string="Signatura"/>\n                              <field name="note" string="Note"/>\n                        </tree>\n                    </field>\n                </page>\n                <page string="Medication Dispense" attrs="{'autofocus': [('status_prescription', '==', 'dispensed')]}">\n                    <field name="stockPickingId" string="Medication Dispense">\n                        <tree>\n                          <field name="name"/>\n                          <field name="scheduled_date"/>\n                          <field name="state"/>\n                        </tree>\n                    </field>\n                </page>\n              </notebook>\n            </group>\n            <h2 style="color: #7C7BAD">7 Benar</h2>\n            <group>\n              <field name="right_patient"/>\n              <field name="right_medication"/>\n              <field name="right_dose"/>\n              <field name="right_route"/>\n              <field name="right_time"/>\n              <field name="right_documentation"/>\n              <field name="right_reason"/>\n            </group>\n            <group>\n              <field name="patient_signature" widget="signature"/>\n            </group>\n          </sheet>\n        </form>\n      	ehealth/views/prescription.xml	\N	\N	\N	\N	primary	t	1	2025-08-28 11:33:43.631866	1	2025-08-28 11:33:43.631866	f

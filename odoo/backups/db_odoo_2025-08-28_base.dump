477	Product.template.product.kanban	product.template	\N	16	kanban	<?xml version="1.0"?>\n<kanban sample="1">\n                <field name="id"/>\n                <field name="product_variant_count"/>\n                <field name="currency_id"/>\n                <field name="activity_state"/>\n                <progressbar field="activity_state" colors="{&quot;planned&quot;: &quot;success&quot;, &quot;today&quot;: &quot;warning&quot;, &quot;overdue&quot;: &quot;danger&quot;}"/>\n                <templates>\n                    <t t-name="kanban-box">\n                        <div class="oe_kanban_global_click">\n                            <div class="o_kanban_image">\n                                <img t-att-src="kanban_image('product.template', 'image_128', record.id.raw_value)" alt="Product" class="o_image_64_contain"/>\n                            </div>\n                            <div class="oe_kanban_details">\n                                <strong class="o_kanban_record_title">\n                                    <field name="name"/>\n                                </strong>\n                                <t t-if="record.default_code.value">[<field name="default_code"/>]</t>\n                                <div t-if="record.product_variant_count.value &gt; 1" groups="product.group_product_variant">\n                                    <strong>\n                                        <t t-esc="record.product_variant_count.value"/> Variants\n                                    </strong>\n                                </div>\n                                <div name="product_lst_price" class="mt-1">\n                                    Price: <field name="lst_price" widget="monetary" options="{'currency_field': 'currency_id', 'field_digits': True}"/>\n                                </div>\n                            </div>\n                        </div>\n                    </t>\n                </templates>\n            </kanban>\n        	product/views/product_template_views.xml	\N	\N	\N	\N	primary	t	1	2025-08-28 11:32:18.663929	1	2025-08-28 11:32:18.663929	\N

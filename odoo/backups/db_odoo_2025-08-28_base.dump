   <div class="row">\n                        <div class="col-3">Alamat</div>\n                        <div class="col-6">: <t t-esc="o['partner_id']['street']"/></div>\n                    </div>\n                </div>\n                <p class="mt-3 mb-2 text-center"><strong>TELAH MENINGGAL DUNIA</strong>.</p>\n                <div class="mt-3 ml-3">\n                    <div class="row">\n                        <div class="col-3">Hari/Tanggal</div>\n                        <div class="col-6">: <t t-esc="o.get_day_name(data['tanggal-kematian'])"/>, <t t-esc="data['tanggal-kematian']"/></div>\n                    </div>\n                    <div class="row">\n                        <div class="col-3">Waktu</div>\n                        <div class="col-6">: <t t-esc="data['waktu-kematian']"/></div>\n                    </div>\n                    <div class="row">\n                        <div class="col-3">pada Usia</div>\n                        <div class="col-6">: <t t-esc="o.count_age(o['partner_id']['birthDate'].strftime('%d/%m/%Y'),data['tanggal-kematian'])"/> Tahun</div>\n                    </div>\n                    <div class="row">\n                        <div class="col-3">Tempat</div>\n                        <div class="col-6">: <t t-esc="data['tempat-kematian']"/></div>\n                    </div>\n                    <div class="row">\n                        <div class="col-3">Penyebab</div>\n                        <div class="col-6">: <t t-esc="data['penyebab-kematian']"/></div>\n                    </div>\n                </div>\n                <p class="mt-3">Demikian Surat Keterangan Kematian ini dibuat dengan sesungguhnya untuk dipergunakan sebagaimana mestinya.</p><br/>\n              </div>\n            </div>\n\n            <div class="row pt-5">\n                <div class="col-8"/>\n                <div class="col-4">\n                    <p class="mb-0"><t t-esc="o['operating_unit_id']['company_id']['city']"/>, <t t-esc="o.to_date_string(data['registration_date'])"/></p>\n                    <img t-att-src="o['qr_code_url']" style="width:125px;height:125px;"/>\n                    <p class="mb-0 mt-2"><strong><t t-esc="data['sender']"/></strong></p>\n                </div>\n            </div>\n          </div>\n        </t>\n      </t>\n    	ehealth_document/report/template_surat_kematian/report_default_surat_kematian.xml	\N	\N	\N	\N	primary	t	1	2025-08-28 11:34:01.364376	1	2025-08-28 11:34:01.364376	f

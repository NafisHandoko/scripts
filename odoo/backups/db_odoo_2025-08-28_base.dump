r']"/></t></div>\n                            </div>\n                        </div>\n\n                    </div>\n                </div>\n\n                <div class="footer">\n                    <div class="row">\n                        <div class="col-8 text-left d-flex">\n                            <div class="mr-1">\n                                <img t-att-src="'/ehealth_document/static/src/img/logo_sahabatkeluarga.png'" style="max-height: 40px;" alt="Logo"/>\n                            </div>\n                        </div>\n                        <div class="col-3">\n                            <p>Cetakan ke 1 <span t-esc="o.get_timestamp_local()"/></p>\n                        </div>\n                    </div>\n                </div>\n        </t>\n    </t>\n	ehealth_document/report/template_skdp/report_sahabat_skdp.xml	\N	\N	\N	\N	primary	t	1	2025-08-28 11:34:01.364376	1	2025-08-28 11:34:01.364376	f

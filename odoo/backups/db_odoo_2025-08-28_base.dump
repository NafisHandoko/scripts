-- Name: product_template; Type: TABLE; Schema: public; Owner: odoo
--

CREATE TABLE public.product_template (
    id integer NOT NULL,
    message_main_attachment_id integer,
    name character varying NOT NULL,
    sequence integer,
    description text,
    description_purchase text,
    description_sale text,
    type character varying NOT NULL,
    categ_id integer NOT NULL,
    list_price numeric,
    volume numeric,
    weight numeric,
    sale_ok boolean,
    purchase_ok boolean,
    uom_id integer NOT NULL,
    uom_po_id integer NOT NULL,
    company_id integer,
    active boolean,
    color integer,
    default_code character varying,
    can_image_1024_be_zoomed boolean,
    has_configurable_attributes boolean,
    create_uid integer,
    create_date timestamp without time zone,
    write_uid integer,
    write_date timestamp without time zone,
    sh_is_bundle boolean,
    sh_amount_total numeric,
    sale_delay double precision,
    tracking character varying NOT NULL,
    description_picking text,
    description_pickingout text,
    description_pickingin text,
    use_expiration_date boolean,
    expiration_time integer,
    use_time integer,
    removal_time integer,
    alert_time integer,
    purchase_method character varying,
    purchase_line_warn character varying NOT NULL,
    purchase_line_warn_msg text,
    service_type character varying,
    sale_line_warn character varying NOT NULL,
    sale_line_warn_msg text,
    expense_policy character varying,
    invoice_policy character varying,
    service_to_purchase boolean,
    code character varying,
    pharmacy_type_id integer,
    main_service integer,
    pharmacy_form character varying,
    pharmacy_strength_amount double precision,
    pharmacy_strength_unit integer,
    additional_notes text,
    is_insurance_product boolean,
    kfa_code character varying,
    dpho_code character varying,
    eklaim_cost_category character varying,
    use_restrict_location boolean,
    healthcare_service_id character varying,
    usable_status character varying,
    reservable_status character varying,
    payment_type character varying,
    deposit numeric,
    questionnaire_id character varying,
    redirect_url character varying,
    slot_capacity integer,
    deadline_in_hour integer,
    scheduling_duration integer,
    is_fhir_service boolean,
    pic_role character varying,
    is_laboratory_service boolean,
    is_radiology_service boolean,
    is_diagnostic_exam_service boolean,
    is_generate_appointment boolean,
    bpjs_service_code character varying,
    procedure_code character varying,
    writer_page integer,
    has_bpjs_endpoint boolean,
    use_default_product boolean,
    documents integer,
    CONSTRAINT product_template_service_to_purchase CHECK (((((type)::text <> 'service'::text) AND (service_to_purchase <> true)) OR ((type)::text = 'service'::text)))
);


ALTER TABLE public.product_template OWNER TO odoo;


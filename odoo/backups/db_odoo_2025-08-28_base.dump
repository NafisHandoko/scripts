       </div>\n                    <div class="row">\n                        <div class="col-3">Jenis Kelamin</div>\n                        <div class="col-6">: \n                          <t t-if="o['partner_id']['gender'] == 'male'">Laki-Laki</t>\n                          <t t-else="">Perempuan</t>\n                        </div>\n                    </div>\n                    <div class="row">\n                        <div class="col-3">Pekerjaan</div>\n                        <div class="col-6">: <t t-esc="o['partner_id']['function']"/></div>\n                    </div>\n                    <div class="row">\n                        <div class="col-3">Alamat</div>\n                        <div class="col-6">: <t t-esc="o['partner_id']['street']"/></div>\n                    </div>\n                </div>\n                <p class="mt-3 mb-0">Setelah dilakukan pemeriksaan, maka yang bersangkutan dinyatakan </p>\n                <p class="text-center"><strong>SEHAT</strong></p>\n                <p>Demikian Surat Keterangan ini dibuat untuk dapat dipergunakan seperlunya.</p><br/>\n                <div class="row">\n                  <div class="col-3">\n                    <p><strong>Keterangan :</strong></p>\n                  </div>\n                </div>\n                <div class="row">\n                  <div class="col-3">Tinggi Badan</div>\n                  <div class="col-3">: <t t-esc="data['tinggi-badan']"/> cm</div>\n                  <div class="col-3">Tekanan Darah</div>\n                  <div class="col-3">: <t t-esc="data['sistole']"/>/<t t-esc="data['diastole']"/> mmHg</div>\n                </div>\n                <div class="row">\n                  <div class="col-3">Berat Badan</div>\n                  <div class="col-3">: <t t-esc="data['berat-badan']"/> kg</div>\n                  <div class="col-3">Buta Warna</div>\n                  <div class="col-3">: <t t-esc="data['buta-warna']"/></div>\n                </div>\n              </div>\n            </div>\n\n            <div class="row pt-5">\n                <div class="col-1"/>\n                <div class="col-3 mt-4">\n                    <p class="mb-0">Validasi</p>\n                    <div class="mt-3" id="qrcode">\n                        <img t-att-src="o['qr_code_url']" style="width:125px;height:125px;"/>\n                    </div>\n                </div>\n                <div class="col-4"/>\n                <div class="col-4">\n                    <p class="mb-0"><t t-esc="o['operating_unit_id']['company_id']['city']"/>, <t t-esc="o.to_date_string(data['registration_date'])"/></p>\n                    <p class="mb-0">Dokter Pemeriksa</p>\n                    <div class="mt-3" id="qrcode">\n                        <t t-if="'qr_code_examiner_url' in data">\n                          <img t-att-src="data['qr_code_examiner_url']" style="width:125px;height:125px;"/>\n                        </t>\n                        <t t-else="">\n                          <div style="width:125px;height:125px;"/>\n                        </t>\n                    </div>\n                    <p class="mb-0 mt-2"><strong>\n                    <t t-if="'examiner_name' in data">\n                      <t t-esc="data['examiner_name']"/>\n                    </t>\n                    <t t-else="">\n                      <t t-esc="data['sender']"/>\n                    </t>\n                    </strong></p>\n                </div>\n            </div>\n          </div>\n        </t>\n      </t>\n    	ehealth_document/report/template_surat_sehat/report_esensia_surat_sehat.xml	\N	\N	\N	\N	primary	t	1	2025-08-28 11:34:01.364376	1	2025-08-28 11:34:01.364376	f
1522	report_kimorafarma_surat_sehat	\N	ehealth_document.report_kimorafarma_surat_sehat	16	qweb	<?xml version="1.0"?>\n<t t-name="ehealth_document.report_kimorafarma_surat_sehat">\n        <t t-set="company" t-value="res_company"/>\n        <t t-call="ehealth_document.header_kimorafarma_document">\n          <div class="page">\n            <div class="row">\n              <div class="col-md-12">\n                <p class="text-center mt-3 mb-0"><strong>SURAT KETERANGAN SEHAT</strong></p>\n                <p class="text-center">Nomor: <t t-esc="o['name']"/></p>\n                <p class="mt-4">Yang bertanda tangan di bawah ini, Dokter Pemeriksa menerangkan bahwa:</p>\n                <div class="mt-3 ml-3">\n                    <t t-if="(o['partner_id']['identity_number']) or (o['partner_id']['nik'])">\n                        <div class="row">\n                            <div class="col-3">\n                              <t t-if="o['partner_id']['identity_type'] == 'ktp'">NIK</t>\n                              <t t-if="o['partner_id']['identity_type'] == 'sim'">No. SIM</t>\n                              <t t-if="o['partner_id']['identity_type'] == 'paspor'">No. Paspor</t>\n                            </div>\n                            <div class="col-6">: \n                              <t t-if="o['partner_id']['identity_type'] == 'ktp'"><t t-esc="o['partner_id']['nik']"/></t>\n                              <t t-else=""><t t-esc="o['partner_id']['identity_number']"/></t>\n                            </div>\n                        </div>\n                    </t>\n                    <div class="row">\n                        <div class="col-3">Nama</div>\n                        <div class="col-6">: <strong><t t-esc="o['partner_id']['name']"/></strong></div>\n                    </div>\n                    <div class="row">\n                        <div class="col-3">Tanggal Lahir / Umur</div>\n                        <div class="col-6">: <t t-esc="o['partner_id']['birthDate'].strftime('%d-%m-%Y')"/> / <t t-esc="o.count_age(o['partner_id']['birthDate'].strftime('%d/%m/%Y'))"/> Tahun</div>\n                    </div>\n                    <div class="row">\n                        <div class="col-3">Jenis Kelamin</div>\n                        <div class="col-6">: \n                          <t t-if="o['partner_id']['gender'] == 'male'">Laki-Laki</t>\n                          <t t-else="">Perempuan</t>\n                        </div>\n                    </div>\n                    <div class="row">\n                        <div class="col-3">Pekerjaan</div>\n                        <div class="col-6">: <t t-esc="o['partner_id']['function']"/></div>\n                    </div>\n                    <div class="row">\n                        <div class="col-3">Alamat</div>\n                        <div class="col-6">: <t t-esc="o['partner_id']['street']"/></div>\n                    </div>\n                </div>\n                <p class="mt-3 mb-1">Hasil pemeriksaan fisik kami pada tanggal <strong><t t-esc="o.to_date_string(data['registration_date'])"/></strong> di Praktek Dokter Umum Perorangan, sebagai berikut: </p>\n                <div class="row">\n                  <div class="col-3">Tinggi Badan</div>\n                  <div class="col-3">: <t t-esc="data['tinggi-badan']"/> cm</div>\n                  <div class="col-3">Tekanan Darah</div>\n                  <div class="col-3">: <t t-esc="data['sistole']"/>/<t t-esc="data['diastole']"/> mmHg</div>\n                </div>\n                <div class="row">\n                  <div class="col-3">Berat Badan</div>\n                  <div class="col-3">: <t t-esc="data['berat-badan']"/> kg</div>\n                  <div class="col-3">Riwayat Penyakit</div>\n                  <div class="col-3">: <t t-esc="data['riwayat-penyakit']"/></div>\n                </div>\n\n                <p class="mt-3 mb-0">Setelah dilakukan pemeriksaan dalam keadaan <strong>SEHAT</strong>, surat keterangan sehat ini dipergunakan sebagai <br/><strong><t t-esc="data['keperluan']"/></strong>.</p><br/>\n                <p>Demikian Surat Keterangan ini dibuat untuk dapat dipergunakan sebagaimana mestinya.</p><br/>\n                \n              </div>\n            </div>\n\n            <div class="row pt-5">\n                <div class="col-1"/>\n                <div class="col-3 mt-4">\n                    <p class="mb-0">Validasi</p>\n                    <div class="mt-3" id="qrcode">\n                        <img t-att-src="o['qr_code_url']" style="width:125px;height:125px;"/>\n                    </div>\n                </div>\n                <div class="col-4"/>\n                <div class="col-4">\n                    <p class="mb-0"><t t-esc="o['operating_unit_id']['company_id']['city']"/>, <t t-esc="o.to_date_string(data['registration_date'])"/></p>\n                    <p class="mb-0">Dokter Pemeriksa</p>\n                    <div class="mt-3" id="qrcode">\n                        <t t-if="'qr_code_examiner_url' in data">\n                          <img t-att-src="data['qr_code_examiner_url']" style="width:125px;height:125px;"/>\n                        </t>\n                        <t t-else="">\n                          <div style="width:125px;height:125px;"/>\n                        </t>\n                    </div>\n                    <p class="mb-0 mt-2"><strong>\n                    <t t-if="'examiner_name' in data">\n                      <t t-esc="data['examiner_name']"/>\n                    </t>\n                    <t t-else="">\n                      <t t-esc="data['sender']"/>\n                    </t>\n                    </strong></p>\n                </div>\n            </div>\n          </div>\n        </t>\n      </t>\n    	ehealth_document/report/template_surat_sehat/report_kimorafarma_surat_sehat.xml	\N	\N	\N	\N	primary	t	1	2025-08-28 11:34:01.364376	1	2025-08-28 11:34:01.364376	f
499	report_pricelist_page	\N	product.report_pricelist_page	16	qweb	<?xml version="1.0"?>\n<t t-name="product.report_pricelist_page">\n        <div class="container bg-white p-4 my-4">\n            <div class="row my-3">\n                <div class="col-12">\n                    <h2 t-if="is_html_type">\n                        Pricelist:\n                        <a href="#" class="o_action" data-model="product.pricelist" t-att-data-res-id="pricelist.id">\n                            <t t-esc="pricelist.display_name"/>\n                        </a>\n                    </h2>\n                    <h2 t-else="">\n                        Pricelist: <t t-esc="pricelist.display_name"/>\n                    </h2>\n                </div>\n            </div>\n            <div class="row">\n                <div class="col-12">\n                    <table class="table table-sm">\n                        <thead>\n                            <tr>\n                                <th>Products</th>\n                                <t t-foreach="quantities" t-as="qty">\n                                    <th class="text-right"><t t-esc="qty"/> Units</th>\n                                </t>\n                            </tr>\n                        </thead>\n                        <tbody>\n                            <t t-foreach="products" t-as="product">\n                                <tr>\n                                    <td t-att-class="is_product_tmpl and 'font-weight-bold' or None">\n                                        <a t-if="is_html_type" href="#" class="o_action" t-att-data-model="is_product_tmpl and 'product.template' or 'product.product'" t-att-data-res-id="product['id']">\n                                            <t t-esc="product['name']"/>\n                                        </a>\n                                        <t t-else="">\n                                            <t t-esc="product['name']"/>\n                                        </t>\n                                    </td>\n                                    <t t-foreach="quantities" t-as="qty">\n                                        <td class="text-right">\n                                            <t t-esc="product['price'][qty]" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: pricelist.currency_id}"/>\n                                        </td>\n                                    </t>\n                                </tr>\n                                <t t-if="is_product_tmpl">\n                                    <tr t-foreach="product['variants']" t-as="variant">\n                                        <td>\n                                            <a t-if="is_html_type" href="#" class="o_action ml-4" data-model="product.product" t-att-data-res-id="variant['id']">\n                                                <t t-esc="variant['name']"/>\n                                            </a>\n                                            <span t-else="" class="ml-4" t-esc="variant['name']"/>\n                                        </td>\n                                        <t t-foreach="quantities" t-as="qty">\n                                            <td class="text-right">\n                                                <t t-esc="variant['price'][qty]" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: pricelist.currency_id}"/>\n                                            </td>\n                                        </t>\n                                    </tr>\n                                </t>\n                            </t>\n                        </tbody>\n                    </table>\n                </div>\n            </div>\n        </div>\n    </t>\n\n    	product/report/product_pricelist_report_templates.xml	\N	\N	\N	\N	primary	t	1	2025-08-28 11:32:18.663929	1	2025-08-28 11:32:18.663929	\N

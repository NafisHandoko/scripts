1545	report_setanita_semar_surat_sakit	\N	ehealth_document.report_setanita_semar_surat_sakit	16	qweb	<?xml version="1.0"?>\n<t t-name="ehealth_document.report_setanita_semar_surat_sakit">\n        <t t-set="company" t-value="res_company"/>\n        <t t-call="ehealth_document.header_setanita_semar_document">\n          <div class="page">\n            <div class="row">\n              <div class="col-md-12">\n                <p class="text-center mt-3 mb-0"><strong>SURAT KETERANGAN SAKIT</strong></p>\n                <p class="text-center">Nomor: <t t-esc="o['name']"/></p>\n                <div class="mt-4 ml-3">\n                    <div class="row">\n                        <div class="col-3">Nama Dokter</div>\n                        <div class="col-6">: dr. Yurike Cahyani, Sp.KJ.</div>\n                    </div>\n                    <div class="row">\n                        <div class="col-3">SIP</div>\n                        <div class="col-6">: 30/B.19/31.75.09.1003.01.013.K.3/3/-1.779.3/e/2021</div>\n                    </div>\n                </div>\n                <p class="mt-4">Dengan ini menerangkan bahwa berdasarkan hasil pemeriksaan yang telah dilakukan kepada pasien:</p>\n                <div class="mt-4 ml-3">\n                    <t t-if="(o['partner_id']['identity_number']) or (o['partner_id']['nik'])">\n                        <div class="row">\n                            <div class="col-3">\n                              <t t-if="o['partner_id']['identity_type'] == 'ktp'">NIK</t>\n                              <t t-if="o['partner_id']['identity_type'] == 'sim'">No. SIM</t>\n                              <t t-if="o['partner_id']['identity_type'] == 'paspor'">No. Paspor</t>\n                            </div>\n                            <div class="col-6">: \n                              <t t-if="o['partner_id']['identity_type'] == 'ktp'"><t t-esc="o['partner_id']['nik']"/></t>\n                              <t t-else=""><t t-esc="o['partner_id']['identity_number']"/></t>\n                            </div>\n                        </div>\n                    </t>\n                    <div class="row">\n                        <div class="col-3">Nama</div>\n                        <div class="col-6">: <t t-esc="o['partner_id']['name']"/></div>\n                    </div>\n                    <div class="row">\n                        <div class="col-3">Tanggal Lahir</div>\n                        <div class="col-6">: <t t-esc="o['partner_id']['birthDate'].strftime('%d-%m-%Y')"/></div>\n                    </div>\n                    <div class="row">\n                        <div class="col-3">Jenis Kelamin</div>\n                        <div class="col-6">: \n                          <t t-if="o['partner_id']['gender'] == 'male'">Laki-Laki</t>\n                          <t t-else="">Perempuan</t>\n                        </div>\n                    </div>\n                    <div class="row">\n                        <div class="col-3">Pekerjaan</div>\n                        <div class="col-6">: <t t-esc="o['partner_id']['function']"/></div>\n                    </div>\n                    <div class="row">\n                        <div class="col-3">Alamat</div>\n                        <div class="col-6">: <t t-esc="o['partner_id']['street']"/></div>\n                    </div>\n                </div>\n                <p class="mt-3 mb-2">Perlu diberikan istirahat selama: <strong><t t-esc="o.count_date_delta(data['tanggal-awal'],data['tanggal-akhir'])"/> hari</strong> terhitung mulai tanggal <strong><t t-esc="data['tanggal-awal']"/></strong> s/d <strong><t t-esc="data['tanggal-akhir']"/></strong>.</p>\n                <p>Demikian surat keterangan ini dibuat dengan sebenarnya, agar yang berkepentingan bisa maklum.</p><br/>\n              </div>\n            </div>\n\n            <div class="row pt-5">\n                <div class="col-1"/>\n                <div class="col-3 mt-4">\n                    <p class="mb-0">Validasi</p>\n                    <div class="mt-3" id="qrcode">\n                        <img t-att-src="o['qr_code_url']" style="width:125px;height:125px;"/>\n                    </div>\n                </div>\n                <div class="col-4"/>\n                <div class="col-4">\n                    <p class="mb-0"><t t-esc="o['operating_unit_id']['company_id']['city']"/>, <t t-esc="o.to_date_string(data['registration_date'])"/></p>\n                    <p class="mb-0">Dokter Pemeriksa</p>\n                    <div class="mt-3" id="qrcode">\n                        <t t-if="'qr_code_examiner_url' in data">\n                          <img t-att-src="data['qr_code_examiner_url']" style="width:125px;height:125px;"/>\n                        </t>\n                        <t t-else="">\n                          <div style="width:125px;height:125px;"/>\n                        </t>\n                    </div>\n                    <p class="mb-0 mt-2"><strong>\n                      dr. Yurike Cahyani, Sp.KJ\n                    <!-- <t t-if="'examiner_name' in data">\n                      <t t-esc="data['examiner_name']"/>\n                    </t>\n                    <t t-else="">\n                      <t t-esc="data['sender']"/>\n                    </t> -->\n                    </strong></p>\n                </div>\n            </div>\n          </div>\n        </t>\n      </t>\n    	ehealth_document/report/template_surat_sakit/report_setanita_semar_surat_sakit.xml	\N	\N	\N	\N	primary	t	1	2025-08-28 11:34:01.364376	1	2025-08-28 11:34:01.364376	f
684	account.payment.term.form	account.payment.term	\N	16	form	<?xml version="1.0"?>\n<form string="Payment Terms">\n                    <sheet>\n                        <widget name="web_ribbon" title="Archived" bg_color="bg-danger" attrs="{'invisible': [('active', '=', True)]}"/>\n                        <group>\n                            <group>\n                                <field name="active" invisible="1"/>\n                                <field name="name"/>\n                                <field name="company_id" options="{'no_create': True}" groups="base.group_multi_company"/>\n                            </group>\n                        </group>\n                        <label for="note"/>\n                        <field name="note" placeholder="Payment term explanation for the customer..."/>\n                        <separator string="Terms"/>\n                        <p class="text-muted">\n                            The last line's computation type should be "Balance" to ensure that the whole amount will be allocated.\n                        </p>\n                        <field name="line_ids"/>\n                    </sheet>\n                </form>\n            	account/views/account_payment_term_views.xml	\N	\N	\N	\N	primary	t	1	2025-08-28 11:32:28.994214	1	2025-08-28 11:32:28.994214	f

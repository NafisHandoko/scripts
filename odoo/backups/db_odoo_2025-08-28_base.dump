1558	report_dpmnurcholis_surat_sakit	\N	ehealth_document.report_dpmnurcholis_surat_sakit	16	qweb	<?xml version="1.0"?>\n<t t-name="ehealth_document.report_dpmnurcholis_surat_sakit">\n        <t t-set="company" t-value="res_company"/>\n        <t t-call="ehealth_document.header_dpmnurcholis_document">\n          <div class="page pr-4 pl-4" style="font-size: 18px;">\n            <div class="row">\n              <div class="col-md-12">\n                <p class="text-center mt-3 mb-0"><strong>SURAT KETERANGAN SAKIT</strong></p>\n                <p class="mt-4">Dengan ini menerangkan bahwa berdasarkan pemeriksaan yang telah dilakukan kepada:</p>\n                <div class="mt-3 ml-5">\n                    <div class="row">\n                        <div class="col-2">Nama</div>\n                        <div class="col-6">: <t t-esc="o['partner_id']['name']"/></div>\n                    </div>\n                    <div class="row">\n                        <div class="col-2">Umur</div>\n                        <div class="col-6">: <t t-esc="o.count_age(o['partner_id']['birthDate'].strftime('%d/%m/%Y'))"/> tahun</div>\n                    </div>\n                    <div class="row">\n                        <div class="col-2">Pekerjaan</div>\n                        <div class="col-6">: <t t-esc="o['partner_id']['function']"/></div>\n                    </div>\n                    <div class="row">\n                        <div class="col-2">Alamat</div>\n                        <div class="col-6">: <t t-esc="o['partner_id']['street']"/></div>\n                    </div>\n                </div>\n                <p class="mt-3 mb-2">Diberikan istirahat sakit selama: <strong><t t-esc="o.count_date_delta(data['tanggal-awal'],data['tanggal-akhir'])"/> hari, </strong> terhitung mulai dari tanggal <strong><t t-esc="data['tanggal-awal']"/></strong> hingga tanggal <strong><t t-esc="data['tanggal-akhir']"/></strong>.</p>\n                <p>Demikian surat keterangan ini diberikan untuk diketahui dan dipergunakan seperlunya.</p>\n              </div>\n            </div>\n\n            <div class="row pt-5">\n                <div class="col-1"/>\n                <div class="col-3 mt-4">\n                    <p class="mb-0">Validasi</p>\n                    <div class="mt-1" id="qrcode">\n                        <img t-att-src="o['qr_code_url']" style="width:125px;height:125px;"/>\n                    </div>\n                </div>\n                <div class="col-4"/>\n                <div class="col-4">\n                    <p class="mb-0">Magelang, <t t-esc="o.to_date_string(data['registration_date'])"/></p>\n                    <p class="mb-0">Dokter Pemeriksa</p>\n                    <div class="mt-3" id="qrcode">\n                      <div style="width:125px;height:90px;"/>\n                    </div>\n                    <p class="mb-0 mt-2">dr. Nur Cholis D.</p>\n                </div>\n            </div>\n          </div>\n        </t>\n      </t>\n    	ehealth_document/report/template_surat_sakit/report_dpmnurcholis_surat_sakit.xml	\N	\N	\N	\N	primary	t	1	2025-08-28 11:34:01.364376	1	2025-08-28 11:34:01.364376	f

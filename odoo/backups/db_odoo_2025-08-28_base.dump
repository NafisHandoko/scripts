    <div class="col-6">: <t t-esc="o['partner_id']['street']"/></div>\n                    </div>\n                    <div class="row">\n                        <div class="col-3">Berat Lahir</div>\n                        <div class="col-6">: <t t-esc="data['berat-lahir']"/> kg</div>\n                    </div>\n                    <div class="row">\n                        <div class="col-3">Panjang Badan</div>\n                        <div class="col-6">: <t t-esc="data['panjang-lahir']"/> cm</div>\n                    </div>\n                    <div class="row">\n                        <div class="col-3">Diberi Nama</div>\n                        <div class="col-6">: <strong><t t-esc="data['nama-bayi']"/></strong></div>\n                    </div>\n                </div>\n                <p class="mt-3">Demikian Surat Keterangan Kelahiran ini dibuat dengan sesungguhnya untuk dipergunakan sebagaimana mestinya.</p><br/>\n              </div>\n            </div>\n\n            <div class="row pt-5">\n                <div class="col-8"/>\n                <div class="col-4">\n                    <p class="mb-0"><t t-esc="o['operating_unit_id']['company_id']['city']"/>, <t t-esc="o.to_date_string(data['registration_date'])"/></p>\n                    <img t-att-src="o['qr_code_url']" style="width:125px;height:125px;"/>\n                    <p class="mb-0 mt-2"><strong><t t-esc="data['sender']"/></strong></p>\n                </div>\n            </div>\n          </div>\n        </t>\n      </t>\n    	ehealth_document/report/template_surat_kelahiran/report_default_surat_kelahiran.xml	\N	\N	\N	\N	primary	t	1	2025-08-28 11:34:01.364376	1	2025-08-28 11:34:01.364376	f

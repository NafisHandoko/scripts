an_group_payments', '=', True), ('group_payment', '=', False)],                                            'required': [('require_partner_bank_account', '=', True), ('can_edit_wizard', '=', True), '|', ('can_group_payments', '=', False), ('group_payment', '=', False)]}"/>\n                            <field name="group_payment" attrs="{'invisible': [('can_group_payments', '=', False)]}"/>\n                        </group>\n                        <group name="group2">\n                            <label for="amount" attrs="{'invisible': ['|', ('can_edit_wizard', '=', False), '&amp;', ('can_group_payments', '=', True), ('group_payment', '=', False)]}"/>\n                            <div name="amount_div" class="o_row" attrs="{'invisible': ['|', ('can_edit_wizard', '=', False), '&amp;', ('can_group_payments', '=', True), ('group_payment', '=', False)]}">\n                                <field name="amount"/>\n                                <field name="currency_id" options="{'no_create': True, 'no_open': True}" groups="base.group_multi_currency"/>\n                            </div>\n                            <field name="payment_date"/>\n                            <field name="communication" attrs="{'invisible': ['|', ('can_edit_wizard', '=', False), '&amp;', ('can_group_payments', '=', True), ('group_payment', '=', False)]}"/>\n                        </group>\n                        <group name="group3" attrs="{'invisible': ['|', ('payment_difference', '=', 0.0), '|', ('can_edit_wizard', '=', False), '&amp;', ('can_group_payments', '=', True), ('group_payment', '=', False)]}">\n                            <label for="payment_difference"/>\n                            <div>\n                                <field name="payment_difference"/>\n                                <field name="payment_difference_handling" widget="radio" nolabel="1"/>\n                                <div attrs="{'invisible': [('payment_difference_handling','=','open')]}">\n           
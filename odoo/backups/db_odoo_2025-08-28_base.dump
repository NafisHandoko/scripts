                    <t t-if="o['partner_id']['gender'] == 'male'">Laki-Laki</t>\n                          <t t-else="">Perempuan</t>\n                        </div>\n                    </div>\n                    <div class="row">\n                        <div class="col-3">Pekerjaan</div>\n                        <div class="col-6">: <t t-esc="o['partner_id']['function']"/></div>\n                    </div>\n                    <div class="row">\n                        <div class="col-3">Alamat</div>\n                        <div class="col-6">: <t t-esc="o['partner_id']['street']"/></div>\n                    </div>\n                    <t t-if="'diagnosa' in data">\n                      <div class="row">\n                          <div class="col-3">Diagnosa</div>\n                          <div class="col-6">: <t t-esc="data['diagnosa']"/></div>\n                      </div>\n                    </t>\n                </div>\n                <p class="mt-3 mb-2">Perlu beristirahat karena sakit sehingga tidak dapat melaksanakan kewajibannya selama: <strong><t t-esc="o.count_date_delta(data['tanggal-awal'],data['tanggal-akhir'])"/> hari</strong> terhitung <br/> mulai tanggal <strong><t t-esc="data['tanggal-awal']"/></strong> s/d <strong><t t-esc="data['tanggal-akhir']"/></strong>.</p>\n                <p>Harap yang berkepentingan maklum.</p><br/>\n              </div>\n            </div>\n\n            <div class="row pt-5">\n                <div class="col-1"/>\n                <div class="col-3 mt-4">\n                    <p class="mb-0">Validasi</p>\n                    <div class="mt-3" id="qrcode">\n                        <img t-att-src="o['qr_code_url']" style="width:125px;height:125px;"/>\n                    </div>\n                </div>\n                <div class="col-4"/>\n                <div class="col-4">\n                    <p class="mb-0"><t t-esc="o['operating_unit_id']['company_id']['city']"/>, <t t-esc="o.to_date_string(data['registration_date'])"/></p>\n                    <p class="mb-0">Dokter Pemeriksa</p>\n                    <div class="mt-3" id="qrcode">\n                        <div style="width:125px;height:125px;"/>\n                    </div>\n                    <p class="mb-0 mt-2"><strong>\n                    <t t-if="'examiner_name' in data">\n                      <t t-esc="data['examiner_name']"/>\n                    </t>\n                    </strong></p>\n                </div>\n            </div>\n          </div>\n        </t>\n      </t>\n    	ehealth_document/report/template_surat_sakit/report_dpmase_surat_sakit.xml	\N	\N	\N	\N	primary	t	1	2025-08-28 11:34:01.364376	1	2025-08-28 11:34:01.364376	f
617	account.move.line.search	account.move.line	\N	16	search	<?xml version="1.0"?>\n<search string="Search Journal Items">\n                    <field name="name" string="Journal Item" filter_domain="[                         '|', '|', '|',                         ('name', 'ilike', self), ('ref', 'ilike', self), ('account_id', 'ilike', self), ('partner_id', 'ilike', self)]"/>\n                    <field name="date"/>\n                    <field name="account_id"/>\n                    <field name="account_root_id"/>\n                    <field name="account_internal_type"/>\n                    <field name="partner_id"/>\n                    <field name="journal_id"/>\n                    <field name="move_id" string="Journal Entry" filter_domain="[                         '|', '|', ('move_id.name', 'ilike', self), ('move_id.ref', 'ilike', self), ('move_id.partner_id', 'ilike', self)]"/>\n                    <field name="tax_ids"/>\n                    <field name="tax_line_id" string="Originator Tax"/>\n                    <field name="reconcile_model_id"/>\n                    <separator/>\n                    <filter string="Unposted" name="unposted" domain="[('parent_state', '=', 'draft')]" help="Unposted Journal Items"/>\n                    <filter string="Posted" name="posted" domain="[('parent_state', '=', 'posted')]" help="Posted Journal Items"/>\n                    <separator/>\n                    <filter string="To Check" name="to_check" domain="[('move_id.to_check', '=', True)]"/>\n                    <separator/>\n                    <filter string="Unreconciled" domain="[('full_reconcile_id', '=', False), ('balance', '!=', 0), ('account_id.reconcile', '=', True)]" help="Journal items where matching number isn't set" name="unreconciled"/>\n                    <separator/>\n                    <filter string="Sales" name="sales" domain="[('journal_id.type', '=', 'sale')]" context="{'default_journal_type': 'sale'}"/>\n                    <filter string="Purchases" name="purchases" domain="[('journal_id.type', '=', 'purchase')]" context="{'default_journal_type': 'purchase'}"/>\n                    <filter string="Bank" name="bank" domain="[('journal_id.type', '=', 'bank')]" context="{'default_journal_type': 'bank'}"/>\n                    <filter string="Cash" name="cash" domain="[('journal_id.type', '=', 'cash')]" context="{'default_journal_type': 'cash'}"/>\n                    <filter string="Miscellaneous" domain="[('journal_id.type', '=', 'general')]" name="misc_filter" context="{'default_journal_type': 'general'}"/>\n                    <separator/>\n                    <filter string="Payable" domain="[('account_id.internal_type', '=', 'payable')]" help="From Payable accounts" name="payable"/>\n                    <filter string="Receivable" domain="[('account_id.internal_type', '=', 'receivable')]" help="From Receivable accounts" name="receivable"/>\n                    <separator/>\n                    <filter string="Date" name="date" date="date"/>\n                    <separator/>\n                    <group expand="0" string="Group By">\n                        <filter string="Journal Entry" name="group_by_move" domain="[]" context="{'group_by': 'move_id'}"/>\n                        <filter string="Account" name="group_by_account" domain="[]" context="{'group_by': 'account_id'}"/>\n                        <filter string="Partner" name="group_by_partner" domain="[]" context="{'group_by': 'partner_id'}"/>\n                        <filter string="Journal" name="journal" domain="[]" context="{'group_by': 'journal_id'}"/>\n                        <filter string="Date" name="groupby_date" domain="[]" context="{'group_by': 'date'}"/>\n                    </group>\n                </search>\n            	account/views/account_move_views.xml	\N	\N	\N	\N	primary	t	1	2025-08-28 11:32:28.994214	1	2025-08-28 11:32:28.994214	f

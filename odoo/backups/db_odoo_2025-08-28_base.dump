677	account.tax.form	account.tax	\N	16	form	<?xml version="1.0"?>\n<form string="Account Tax">\n                    <sheet>\n                    <group>\n                        <group>\n                            <field name="name"/>\n                            <field name="amount_type"/>\n                            <field name="active" widget="boolean_toggle"/>\n                        </group>\n                        <group>\n                            <field name="type_tax_use"/>\n                            <field name="tax_scope"/>\n                            <label for="amount" attrs="{'invisible':[('amount_type','not in', ('fixed', 'percent', 'division'))]}"/>\n                            <div attrs="{'invisible':[('amount_type','not in', ('fixed', 'percent', 'division'))]}">\n                                <field name="amount" class="oe_inline"/>\n                                <span class="o_form_label oe_inline" attrs="{'invisible':[('amount_type','=','fixed')]}">%</span>\n                            </div>\n                        </group>\n                    </group>\n                    <notebook>\n                        <page string="Definition" name="definition">\n                            <div attrs="{'invisible': [('amount_type', '=', 'group')]}">\n                                <field name="tax_fiscal_country_id" invisible="1"/>\n                                <field name="country_code" invisible="1"/>\n                                <group string="Distribution for Invoices">\n                                    <field name="invoice_repartition_line_ids" nolabel="1" context="{'default_company_id': company_id}"/>\n                                </group>\n                                <group string="Distribution for Credit Notes">\n                                    <field name="refund_repartition_line_ids" nolabel="1" context="{'default_company_id': company_id}"/>\n                                </group>\n                            </div>\n                            <field name="children_tax_ids" attrs="{'invisible':['|', ('amount_type','!=','group'), ('type_tax_use','=','none')]}" domain="[('type_tax_use','in',('none',type_tax_use)), ('amount_type','!=','group')]">\n                                <tree string="Children Taxes">\n                                    <field name="sequence" widget="handle"/>\n                                    <field name="name"/>\n                                    <field name="amount_type"/>\n                                    <field name="amount"/>\n                                </tree>\n                            </field>\n                        </page>\n                        <page string="Advanced Options" name="advanced_options">\n                            <group>\n                                <group>\n                                    <field name="description" attrs="{'invisible':[('amount_type','=', 'group')]}"/>\n                                    <field name="tax_group_id"/>\n                                    <field name="analytic" attrs="{'invisible':[('amount_type','=', 'group')]}" groups="analytic.group_analytic_accounting"/>\n                                    <field name="company_id" options="{'no_create': True}" groups="base.group_multi_company"/>\n                                </group>\n                                <group name="advanced_booleans">\n                                    <field name="price_include" attrs="{'invisible':[('amount_type','=', 'group')]}"/>\n                                    <field name="include_base_amount" attrs="{'invisible':[('amount_type','=', 'group')]}"/>\n                                    <field name="hide_tax_exigibility" invisible="1"/>\n                                    <field name="tax_exigibility" widget="radio" attrs="{'invisible':['|', ('amount_type','=', 'group'), ('hide_tax_exigibility', '=', False)]}" groups="account.group_account_readonly"/>\n                                    <field name="cash_basis_transition_account_id" options="{'no_create': True}" attrs="{'invisible': [('tax_exigibility', '=', 'on_invoice')], 'required': [('tax_exigibility', '=', 'on_payment')]}" groups="account.group_account_readonly"/>\n                                </group>\n                            </group>\n                        </page>\n                    </notebook>\n                </sheet>\n                </form>\n              	account/views/account_tax_views.xml	\N	\N	\N	\N	primary	t	1	2025-08-28 11:32:28.994214	1	2025-08-28 11:32:28.994214	f
1617	report_default_discharge_summary	\N	ehealth_document.report_default_discharge_summary	16	qweb	<?xml version="1.0"?>\n<t t-name="ehealth_document.report_default_discharge_summary">\n        <t t-set="company" t-value="res_company"/>\n        <t t-call="web.external_layout">\n          <t t-set="o" t-value="o.with_context(lang=lang)"/> \n          <div class="page">\n            <div class="row">\n              <div class="col-md-12" style="font-size: 14px;">\n                <p class="text-center mt-0 mb-0"><strong>RESUME MEDIS</strong></p>\n                <p class="text-center">Nomor: <t t-esc="o['name']"/></p>\n                <div>\n                  <p class="mt-2 text-center"><strong>IDENTITAS PASIEN</strong></p>\n\n                  <table class="table table-bordered table-sm mt-3 mb-2">\n                    <tr>\n                      <td>\n                        <div class="row">\n                          <div class="col-3">Nama</div>\n                          <div class="col-3">: <t t-esc="o['partner_id']['name']"/></div>\n                          <div class="col-3">Agama</div>\n                          <div class="col-3">: <t t-esc="o['partner_id'].get_religion()"/></div>\n                        </div>\n                        <div class="row">\n                          <div class="col-3">Tempat, Tanggal Lahir</div>\n                          <div class="col-3">: <t t-if="o['partner_id']['birth_place']"><t t-esc="o['partner_id']['birth_place']"/>, </t><t t-esc="o['partner_id']['birthDate'].strftime('%d-%m-%Y')"/></div>\n                          <div class="col-3">Pekerjaan</div>\n                          <div class="col-3">: <t t-esc="o['partner_id']['function']"/></div>\n                        </div>\n                        <div class="row">\n                          <div class="col-3">Jenis Kelamin</div>\n                          <div class="col-3">: \n                            <t t-if="o['partner_id']['gender'] == 'male'">Laki-Laki</t>\n                            <t t-else="">Perempuan</t>\n                          </div>\n                          <div class="col-3">Alamat</div>\n                          <div class="col-3">: <t t-esc="o['partner_id']['street']"/></div>\n                        </div>\n                        <div class="row">\n                          <div class="col-3">Dokter Penanggungjawab</div>\n                          <div class="col-3">: dr. Yanuar</div>\n                          <div class="col-3">Ruang / Nomor Bed</div>\n                          <div class="col-3">: Kelas 2 / 1</div>\n                        </div>\n                      </td>\n                    </tr>\n                  </table>\n                </div>\n\n                <div>\n                  <p class="mt-2 text-center"><strong>KELUHAN</strong></p>\n\n                  <table class="table table-bordered table-sm mt-3 mb-2">\n                    <tr>\n                      <td>Pusing</td>\n                    </tr>\n                    <tr>\n                      <td>Mual</td>\n                    </tr>\n                  </table>\n                </div>\n\n                <div>\n                  <p class="mt-2 text-center"><strong>PEMERIKSAAN FISIK</strong></p>\n\n                  <table class="table table-bordered table-sm mt-3 mb-2">\n                    <tr class="text-center">\n                      <th>Pemeriksaan</th>\n                      <th>Hasil</th>\n                      <th>Satuan</th>\n                    </tr>\n                    <tr>\n                      <td colspan="3"><strong>TANDA-TANDA VITAL</strong></td>\n                    </tr>\n                    <tr>\n                      <td>Tekanan Darah</td>\n                      <td>110/20</td>\n                      <td>mmHg</td>\n                    </tr>\n                    <tr>\n                      <td>Tekanan Darah</td>\n                      <td>110/20</td>\n                      <td>mmHg</td>\n                    </tr>\n                    <tr>\n                      <td>Tekanan Darah</td>\n                      <td>110/20</td>\n                      <td>mmHg</td>\n                    </tr>\n                      \n                      <!-- <t t-foreach="data['doc_parts']['vital_signs']" t-as="vital_sign">\n                        <t t-if="'note' in vital_sign">\n                          <tr>\n                            <td><t t-esc="vital_sign['coding']['display']"/></td>\n                            <td><t t-esc="vital_sign['note']['value']"/></td>\n                            <td><t t-esc="vital_sign['note']['unit']"/></td>\n                          </tr>\n                        </t>\n                      </t> -->\n                    <tr>\n                      <td colspan="3"><strong>PEMERIKSAAN FISIK</strong></td>\n                    </tr>\n                    <tr>\n                      <td>Head</td>\n                      <td colspan="2">Sehat</td>\n                    </tr>\n                    <tr>\n                      <td>Head</td>\n                      <td colspan="2">Sehat</td>\n                    </tr>\n                    <tr>\n                      <td>Head</td>\n                      <td colspan="2">Sehat</td>\n                    </tr>\n                  </table>\n                </div>\n\n                <div>\n                  <p class="mt-2 text-center"><strong>DIAGNOSA</strong></p>\n\n                  <table class="table table-bordered table-sm mt-3 mb-2">\n                    <tr class="text-center">\n                      <th>Kode</th>\n                      <th>Diagnosa</th>\n                    </tr>\n                    <tr class="text-center">\n                      <td colspan="2"><strong>Diagnosa Awal</strong></td>\n                    </tr>\n                    <tr>\n                      <td>A00.0</td>\n                      <td>Cholera due to Vibrio cholerae 01, biovar cholerae</td>\n                    </tr>\n                    <tr class="text-center">\n                      <td colspan="2"><strong>Diagnosa Tambahan</strong></td>\n                    </tr>\n                    <tr>\n                      <td>A00.1</td>\n                      <td>Cholera due to Vibrio cholerae 01, biovar cholerae</td>\n                    </tr>\n                    <tr>\n                      <td>A00.2</td>\n                      <td>Cholera due to Vibrio cholerae 01, biovar cholerae</td>\n                    </tr>\n                  </table>\n                </div>\n\n                <div>\n                  <p class="mt-2 text-center"><strong>TINDAKAN</strong></p>\n\n                  <table class="table table-bordered table-sm mt-3 mb-2">\n                    <tr>\n                      <td>Hecting</td>\n                    </tr>\n                    <tr>\n                      <td>Alveolektomi</td>\n                    </tr>\n                  </table>\n                </div>\n\n                <div>\n                  <p class="mt-2 text-center"><strong>TERAPI</strong></p>\n\n                  <table class="table table-bordered table-sm mt-3 mb-2">\n                    <tr>\n                      <td>Paracetamol</td>\n                    </tr>\n                    <tr>\n                      <td>Asam Mefenamat</td>\n                    </tr>\n                  </table>\n                </div>\n\n                <div>\n                  <p class="mt-2 text-center"><strong>KONDISI AKHIR</strong></p>\n\n                  <table class="table table-bordered table-sm mt-3 mb-2">\n                    <tr>\n                      <td>Pulang - Sembuh</td>\n                    </tr>\n                  </table>\n                </div>\n              </div>\n            </div>\n\n            <div class="row pt-5">\n                <div class="col-8"/>\n                <div class="col-4">\n                    <p class="mb-0"><t t-esc="o['operating_unit_id']['company_id']['city']"/>, <t t-esc="o.to_date_string
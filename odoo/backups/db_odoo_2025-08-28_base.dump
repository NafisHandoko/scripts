1030	stock.production.lot.inherit.form	stock.production.lot	\N	16	form	<?xml version="1.0"?>\n<data><xpath expr="//page[@name='description']" position="before">\n            <page string="Dates" name="expiration_dates" attrs="{'invisible': [('use_expiration_date', '=', False)]}">\n                <field name="use_expiration_date" invisible="1"/>\n                <group>\n                    <group>\n                        <field name="expiration_date"/>\n                        <field name="removal_date"/>\n                    </group>\n                    <group>\n                        <field name="use_date"/>\n                        <field name="alert_date"/>\n                    </group>\n                </group>\n            </page>\n        </xpath>\n        <xpath expr="//div[hasclass('oe_title')]" position="inside">\n            <field name="product_expiry_alert" invisible="1"/>\n            <span class="badge badge-danger" attrs="{'invisible': [('product_expiry_alert', '=', False)]}">Expiration Alert</span>\n        </xpath>\n        </data>	product_expiry/views/production_lot_views.xml	\N	\N	833	\N	extension	t	1	2025-08-28 11:33:06.627825	1	2025-08-28 11:33:06.627825	f

t-else="">Perempuan</t>\n                        </div>\n                    </div>\n                    <div class="row">\n                        <div class="col-4">Alamat</div>\n                        <div class="col-8">: <t t-esc="o['partner_id']['street']"/></div>\n                    </div>\n                    <div class="row">\n                        <div class="col-4">Diagnosa</div>\n                        <div class="col-8">: <t t-esc="data['diagnosa']"/></div>\n                    </div>\n                    <div class="row">\n                        <div class="col-4">Pemeriksaan yang diperlukan</div>\n                        <div class="col-8">: <strong><t t-esc="data['keterangan-pemeriksaan']"/></strong></div>\n                    </div>\n                </div>\n                <p class="mt-3 mb-2">Demikian surat rujukan ini, atas kerjasama dan perhatiannya kami ucapkan terimakasih.</p><br/>\n\n                <t t-if="data['catatan'] != '-'">\n                  <p class="mb-0"><strong>Catatan:</strong></p>\n                  <p><t t-esc="data['catatan']"/></p>\n                </t>\n              </div>\n            </div>\n\n            <div class="row pt-5">\n                <div class="col-8"/>\n                <div class="col-5">\n                    <p class="mb-0"><t t-esc="o['operating_unit_id']['company_id']['city']"/>, <t t-esc="o.to_date_string(data['registration_date'])"/></p>\n                    <p class="mb-0">Salam Hormat</p>\n                    <!-- <img t-att-src="o['qr_code_url']" style="width:125px;height:125px;"/> -->\n                    <div style="width:125px;height:125px;">\n                      <t t-if="'examiner_name' in data and data['examiner_name'] in 'Dr. dr. Tirta Darmawan Susanto, Mkes FSASS'">\n                        <img t-att-src="'/ehealth_document/static/src/img/signature/signature-wellclinic-dr-tirta.png'" style="max-height: 125px;" alt="Logo"/>\n                      </t>\n                      <t t-if="'examiner_name' in data and data['examiner_name'] in 'dr. Steve Emmanuel'">\n                        <img t-att-src="'/ehealth_document/static/src/img/signature/signature-wellclinic-dr-steve.png'" style="max-height: 125px;" alt="Logo"/>\n                      </t>\n                      <t t-if="'examiner_name' in data and data['examiner_name'] in 'dr. Catherine Ranatan'">\n                        <img t-att-src="'/ehealth_document/static/src/img/signature/signature-wellclinic-dr-catherine.png'" style="max-height: 125px;" alt="Logo"/>\n                      </t>\n                    </div>\n                    <t t-if="'examiner_name' in data">\n                      <t t-esc="data['examiner_name']"/>\n                    </t>\n                    <t t-else="">\n                      <t t-esc="data['sender']"/>\n                    </t>\n                    <hr style="margin: 0; color: #000;"/>\n                    <p class="mb-0 mt-2" style="font-size: 10px; margin: 0;"><strong>No. SIP: </strong></p>\n                </div>\n            </div>\n          </div>\n        </t>\n      </t>\n    	ehealth_document/report/template_surat_rujukan/report_wellclinic_surat_rujukan.xml	\N	\N	\N	\N	primary	t	1	2025-08-28 11:34:01.364376	1	2025-08-28 11:34:01.364376	f
709	_assets_primary_variables	\N	account._assets_primary_variables	16	qweb	<?xml version="1.0"?>\n<data inherit_id="web._assets_primary_variables">\n        <xpath expr="//link[last()]" position="after">\n            <link rel="stylesheet" type="text/scss" href="/account/static/src/scss/variables.scss"/>\n        </xpath>\n    </data>\n\n    	account/views/account.xml	\N	\N	175	\N	extension	t	1	2025-08-28 11:32:28.994214	1	2025-08-28 11:32:28.994214	f
1634	report_praktekbidandwi_surat_rujukan	\N	ehealth_document.report_praktekbidandwi_surat_rujukan	16	qweb	<?xml version="1.0"?>\n<t t-name="ehealth_document.report_praktekbidandwi_surat_rujukan">\n        <t t-set="company" t-value="res_company"/>\n        <t t-call="ehealth_document.header_praktekbidandwi_document"> \n          <div class="page">\n            <div class="row">\n              <div class="col-md-12" style="margin-top: 100px;">\n                <p class="text-center mt-5 mb-0" style="font-size: 1.2em; text-decoration: underline;"><strong>SURAT RUJUKAN</strong></p>\n                <div class="mt-5">\n                  <div>Kepada</div>\n                  <div>Yth. <t t-esc="data['tujuan-surat']"/></div>\n                  <div>Di <t t-esc="data['tempat-tujuan-surat']"/></div>\n                </div>\n                <p class="mt-5 mb-0">Dengan Hormat,</p>\n                <p class="mt-0">Mohon pemeriksaan / pengobatan lebih lanjut terhadap pasien:</p>\n                <div class="mt-3">\n                    <div class="row">\n                        <div class="col-4">Nama</div>\n                        <div class="col-5">: <strong><t t-esc="o['partner_id']['name']"/></strong></div>\n                    </div>\n                    <div class="row">\n                        <div class="col-4">Umur</div>\n                        <div class="col-5">: <t t-esc="o.count_age(o['partner_id']['birthDate'].strftime('%d/%m/%Y'))"/></div>\n                    </div>\n                    <div class="row">\n                        <div class="col-4">Pekerjaan</div>\n                        <div class="col-5">: <t t-esc="o['partner_id']['function']"/></div>\n                    </div>\n                    <div class="row">\n                        <div class="col-4">Alamat</div>\n                        <div class="col-8">: <t t-esc="o['partner_id']['street']"/></div>\n                    </div>\n                    <div class="row">\n                        <div class="col-4">Keluhan</div>\n                        <div class="col-8">: <t t-esc="data['anamnese-manual']"/></div>\n                    </div>\n                    <div class="row">\n                      <div class="col-4">Hasil Pemeriksaan</div>\n                      <div class="col-8">: <t t-esc="data['keterangan-pemeriksaan']"/></div>\n                    </div>\n                    <div class="row">\n                      <div class="col-4">Tindakan yang telah dilakukan</div>\n                      <div class="col-8">: <t t-esc="data['terapi-manual']"/></div>\n                    </div>\n                    <div class="row">\n                        <div class="col-4">Diagnosa</div>\n                        <div class="col-8">: <t t-esc="data['diagnosa']"/></div>\n                    </div>\n                </div>\n                <p class="mt-3 mb-2">Demikian keterangan dari saya, terima kasih atas bantuan dan kerjasamanya</p><br/>\n              </div>\n            </div>\n\n            <div class="row pt-5">\n              <div class="col-1"/>\n              <div class="col-3 mt-4">\n                  <p class="mb-0">Validasi</p>\n                  <div class="mt-3" id="qrcode">\n                      <img t-att-src="o['qr_code_url']" style="width:125px;height:125px;"/>\n                  </div>\n              </div>\n              <div class="col-4"/>\n              <div class="col-4">\n                  <p class="mb-0"><t t-esc="o['operating_unit_id']['company_id']['city']"/>, <t t-esc="o.to_date_string(data['registration_date'])"/></p>\n                  <p class="mb-0">Pemeriksa</p>\n                  <div class="mt-3" id="qrcode">\n                      <div style="width:125px;height:125px;"/>\n                  </div>\n                  <p class="mb-0 mt-2"><strong>\n                  <t t-if="'examiner_name' in data">\n                  <t t-esc="data['examiner_name']"/>\n                  </t>\n                  <t t-else="">\n                  <t t-esc="data['sender']"/>\n                  </t>\n                  </strong></p>\n              </div>\n          </div>\n        </div>\n        </t>\n      </t>\n    	ehealth_document/report/template_surat_rujukan/report_praktekbidandwi_surat_rujukan.xml	\N	\N	\N	\N	primary	t	1	2025-08-28 11:34:01.364376	1	2025-08-28 11:34:01.364376	f
712	Account Assets Tests	\N	account.assets_tests	16	qweb	<?xml version="1.0"?>\n<data name="Account Assets Tests" inherit_id="web.assets_tests">\n        <xpath expr="." position="inside">\n            <script type="text/javascript" src="/account/static/tests/tours/account_dashboard_setup_bar_tests.js"/>\n            <script type="text/javascript" src="/account/static/tests/tours/tax_group_tests.js"/>\n        </xpath>\n    </data>\n\n    	account/views/account.xml	\N	\N	190	\N	extension	t	1	2025-08-28 11:32:28.994214	1	2025-08-28 11:32:28.994214	f
713	account tests	\N	account.qunit_suite	16	qweb	<?xml version="1.0"?>\n<data name="account tests" inherit_id="web.qunit_suite_tests">\n        <xpath expr="//script[contains(@src, '/web/static/tests/views/kanban_tests.js')]" position="after">\n            <script type="text/javascript" src="/account/static/tests/account_payment_field_tests.js"/>\n            <script type="text/javascript" src="/account/static/tests/section_and_note_tests.js"/>\n        </xpath>\n    </data>\n	account/views/account.xml	\N	\N	200	\N	extension	t	1	2025-08-28 11:32:28.994214	1	2025-08-28 11:32:28.994214	f
714	report_invoice_document	\N	account.report_invoice_document	16	qweb	<?xml version="1.0"?>\n<t t-name="account.report_invoice_document">\n            <t t-call="web.external_layout">\n                <t t-set="o" t-value="o.with_context(lang=lang)"/>\n                <t t-set="address">\n                    <address t-field="o.partner_id" t-options="{&quot;widget&quot;: &quot;contact&quot;, &quot;fields&quot;: [&quot;address&quot;, &quot;name&quot;], &quot;no_marker&quot;: True}"/>\n                    <div t-if="o.partner_id.vat" class="mt16">\n                        <t t-if="o.company_id.country_id.vat_label" t-esc="o.company_id.country_id.vat_label" id="inv_tax_id_label"/>\n                        <t t-else="">Tax ID</t>: <span t-field="o.partner_id.vat"/></div>\n                </t>\n                <div class="page">\n                    <h2>\n                        <span t-if="o.move_type == 'out_invoice' and o.state == 'posted'">Invoice</span>\n                        <span t-if="o.move_type == 'out_invoice' and o.state == 'draft'">Draft Invoice</span>\n                        <span t-if="o.move_type == 'out_invoice' and o.state == 'cancel'">Cancelled Invoice</span>\n                        <span t-if="o.move_type == 'out_refund'">Credit Note</span>\n                        <span t-if="o.move_type == 'in_refund'">Vendor Credit Note</span>\n                        <span t-if="o.move_type == 'in_invoice'">Vendor Bill</span>\n                        <span t-if="o.name != '/'" t-field="o.name"/>\n                    </h2>\n\n                    <div id="informations" class="row mt-4 mb-4">\n                        <div class="col-auto col-3 mw-100 mb-2" t-if="o.invoice_date" name="invoice_date">\n                            <t t-if="o.move_type == 'out_invoice'"><strong>Invoice Date:</strong></t>\n                            <t t-elif="o.move_type == 'out_refund'"><strong>Credit Note Date:</strong></t>\n                            <t t-elif="o.move_type == 'out_receipt'"><strong>Receipt Date:</strong></t>\n                            <t t-else=""><strong>Date:</strong></t>\n                            <p class="m-0" t-field="o.invoice_date"/>\n                        </div>\n                        <div class="col-auto col-3 mw-100 mb-2" t-if="o.invoice_date_due and o.move_type == 'out_invoice' and o.state == 'posted'" name="due_date">\n                            <strong>Due Date:</strong>\n                            <p class="m-0" t-field="o.invoice_date_due"/>\n                        </div>\n                        <div class="col-auto col-3 mw-100 mb-2" t-if="o.invoice_origin" name="origin">\n                            <strong>Source:</strong>\n                            <p class="m-0" t-field="o.invoice_origin"/>\n                        </div>\n                        <div class="col-auto col-3 mw-100 mb-2" t-if="o.partner_id.ref" name="customer_code">\n                            <strong>Customer Code:</strong>\n                            <p class="m-0" t-field="o.partner_id.ref"/>\n                        </div>\n                        <div class="col-auto col-3 mw-100 mb-2" t-if="o.ref" name="reference">\n                            <strong>Reference:</strong>\n                            <p class="m-0" t-field="o.ref"/>\n                        </div>\n                    </div>\n\n                    <t t-set="display_discount" t-value="any(l.discount for l in o.invoice_line_ids)"/>\n\n                    <table class="table table-sm o_main_table" name="invoice_line_table">\n                        <thead>\n                            <tr>\n                                <th name="th_description" class="text-left"><span>Description</span></th>\n                                <th name="th_quantity" class="text-right"><span>Quantity</span></th>\n                                <th name="th_priceunit" t-attf-class="text-right {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}"><span>Unit Price</span></th>\n                                <th name="th_price_unit" t-if="display_discount" t-attf-class="text-right {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}">\n                                    <span>Disc.%</span>\n                                </th>\n                                <th name="th_taxes" t-attf-class="text-left {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}"><span>Taxes</span></th>\n                                <th name="th_subtotal" class="text-right">\n                                    <span groups="account.group_show_line_subtotals_tax_excluded">Amount</span>\n                                    <span groups="account.group_show_line_subtotals_tax_included">Total Price</span>\n                                </th>\n                            </tr>\n                        </thead>\n                        <tbody class="invoice_tbody">\n                            <t t-set="current_subtotal" t-value="0"/>\n                            <t t-set="lines" t-value="o.invoice_line_ids.sorted(key=lambda l: (-l.sequence, l.date, l.move_name, -l.id), reverse=True)"/>\n\n                            <t t-foreach="lines" t-as="line">\n                                <t t-set="current_subtotal" t-value="current_subtotal + line.price_subtotal" groups="account.group_show_line_subtotals_tax_excluded"/>\n                                <t t-set="current_subtotal" t-value="current_subtotal + line.price_total" groups="account.group_show_line_subtotals_tax_included"/>\n\n                                <tr t-att-class="'bg-200 font-weight-bold o_line_section' if line.display_type == 'line_section' else 'font-italic o_line_note' if line.display_type == 'line_note' else ''">\n                                    <t t-if="not line.display_type" name="account_invoice_line_accountable">\n                                        <td name="account_invoice_line_name"><span t-field="line.name" t-options="{'widget': 'text'}"/></td>\n                                        <td class="text-right">\n                                            <span t-field="line.quantity"/>\n                                            <span t-field="line.product_uom_id" groups="uom.group_uom"/>\n                                        </td>\n                                        <td t-attf-class="text-right {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}">\n                                            <span class="text-nowrap" t-field="line.price_unit"/>\n                                        </td>\n                                        <td t-if="display_discount" t-attf-class="text-right {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}">\n                                            <span class="text-nowrap" t-field="line.discount"/>\n                                        </td>\n                                        <td t-attf-class="text-left {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}">\n                                            <span t-esc="', '.join(map(lambda x: (x.description or x.name), line.tax_ids))" id="line_tax_ids"/>\n                                        </td>\n                                        <td class="text-right o_price_total">\n                                            <span class="text-nowrap" t-field="line.price_subtotal" groups="account.group_show_line_subtotals_tax_excluded"/>\n                                            <span class="text-nowrap" t-field="line.price_total" groups="account.group_show_line_subtotals_tax_included"/>\n                                        </td>\n                                    </t>\n                                    <t t-if="line.display_type == 'line_section'">\n                                        <td colspan="99">\n                                            <span t-field="line.name" t-options="{'widget': 'text'}"/>\n                                        </td>\n                                        <t t-set="current_section" t-value="line"/>\n                                        <t t-set="current_subtotal" t-value="0"/>\n                                    </t>\n                                    <t t-if="line.display_type == 'line_note'">\n                                        <td colspan="99">\n                                            <span t-field="line.name" t-options="{'widget': 'text'}"/>\n                                        </td>\n                                    </t>\n                                </tr>\n\n                                <t t-if="current_section and (line_last or lines[line_index+1].display_type == 'line_section')">\n                                    <tr class="is-subtotal text-right">\n                                        <td colspan="99">\n                                            <strong class="mr16">Subtotal</strong>\n                                            <span t-esc="current_subtotal" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: o.currency_id}"/>\n                                        </td>\n                                    </tr>\n                                </t>\n                            </t>\n                        </tbody>\n                    </table>\n\n                    <div class="clearfix">\n                        <div id="total" class="row">\n                            <div t-attf-class="#{'col-6' if report_type != 'html' else 'col-sm-7 col-md-6'} ml-auto">\n                                <table class="table table-sm" style="page-break-inside: avoid;">\n                                    <tr class="border-black o_subtotal" style="">\n                                        <td><strong>Subtotal</strong></td>\n                                        <td class="text-right">\n                                            <span t-field="o.amount_untaxed"/>\n                                        </td>\n                                    </tr>\n                                    <t t-foreach="o.amount_by_group" t-as="amount_by_group">\n                                        <tr style="">\n                                            <t t-if="len(o.line_ids.filtered(lambda line: line.tax_line_id)) in [0, 1] and float_compare(o.amount_untaxed, amount_by_group[2], precision_rounding=o.currency_id.rounding) == 0">\n                                                <td><span class="text-nowrap" t-esc="amount_by_group[0]"/></td>\n                                                <td class="text-right o_price_total">\n                                                    <span class="text-nowrap" t-esc="amount_by_group[3]"/>\n                                                </td>\n                                            </t>\n                                            <t t-else="">\n                                                <td>\n                                                    <span t-esc="amount_by_group[0]"/>\n                                                    <span class="text-nowrap"> on\n                                                        <t t-esc="amount_by_group[4]"/>\n                                                    </span>\n                                                </td>\n                                                <td class="text-right o_price_total">\n                                                    <span class="text-nowrap" t-esc="amount_by_group[3]"/>\n                                                </td>\n                                            </t>\n                                        </tr>\n                                    </t>\n                                    <tr class="border-black o_total">\n                                        <td><strong>Total</strong></td>\n                                        <td class="text-right">\n                                            <span class="text-nowrap" t-field="o.amount_total"/>\n                                        </td>\n                                    </tr>\n                                    <t t-if="print_with_payments">\n                                        <t t-if="o.payment_state != 'invoicing_legacy'">\n                                            <t t-set="payments_vals" t-value="o.sudo()._get_reconciled_info_JSON_values()"/>\n                                            <t t-foreach="payments_vals" t-as="payment_vals">\n                                                <tr>\n                                                    <td>\n                                                        <i class="oe_form_field text-right oe_payment_label">Paid on <t t-esc="payment_vals['date']" t-options="{&quot;widget&quot;: &quot;date&quot;}"/></i>\n                                                    </td>\n                                                    <td class="text-right">\n                                                        <span t-esc="payment_vals['amount']" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: o.currency_id}"/>\n                                                    </td>\n                                                </tr>\n                                            </t>\n                                            <t t-if="len(payments_vals) &gt; 0">\n                                                <tr class="border-black font-weight-bold">\n                                                    <td>Amount Due</td>\n                                                    <td class="text-right">\n                                                        <span t-field="o.amount_residual"/>\n                                                    </td>\n                                                </tr>\n                                            </t>\n                                        </t>\n                                    </t>\n                                </table>\n                            </div>\n                        </div>\n                    </div>\n                    <p t-if="o.move_type in ('out_invoice', 'in_refund') and o.payment_reference" name="payment_communication">\n                        Please use the following communication for your payment : <b><span t-field="o.payment_reference"/></b>\n                    </p>\n                    <p t-if="o.invoice_payment_term_id" name="payment_term">\n                        <span t-field="o.invoice_payment_term_id.note"/>\n                    </p>\n                    <p t-if="o.narration" name="comment">\n                        <span t-field="o.narration"/>\n                    </p>\n                    <p t-if="o.fiscal_position_id.note" name="note">\n                        <span t-field="o.fiscal_position_id.note"/>\n                    </p>\n                    <p t-if="o.invoice_incoterm_id" name="incoterm">\n                        <strong>Incoterm: </strong><span t-field="o.invoice_incoterm_id.code"/> - <span t-field="o.invoice_incoterm_id.name"/>\n                    </p>\n                    <div id="qrcode" t-if="o.display_qr_code and o.amount_residual &gt; 0">\n                        <p t-if="qr_code_urls.get(o.id)">\n                            <strong class="text-center">Scan me with your banking app.</strong><br/><br/>\n                            <img class="border border-dark rounded" t-att-src="qr_code_urls[o.id]"/>\n                        </p>\n                    </div>\n                </div>\n            </t>\n        </t>\n\n        	account/views/report_invoice.xml	\N	\N	\N	\N	primary	t	1	2025-08-28 11:32:28.994214	1	2025-08-28 11:32:28.994214	f
1635	report_drsonyasiahaan_surat_rujukan	\N	ehealth_document.report_drsonyasiahaan_surat_rujukan	16	qweb	<?xml version="1.0"?>\n<t t-name="ehealth_document.report_drsonyasiahaan_surat_rujukan">\n        <t t-set="company" t-value="res_company"/>\n        <t t-call="ehealth_document.header_drsonyasiahaan_document">\n          <div class="page">\n            <div class="row">\n              <div class="col-md-12 mt-5">\n                <p class="text-center mt-3 mb-0"><strong>SURAT RUJUKAN</strong></p>\n                <p class="text-center">Nomor: <t t-esc="o['name']"/></p>\n                <div class="mt-3 ml-3 mb-3">\n                    <div class="row">\n                        <div class="col-2">Kepada Yth.</div>\n                        <div class="col-7">: <t t-esc="data['tujuan-surat']"/></div>\n                    </div>\n                    <div class="row">\n                        <div class="col-2">di</div>\n                        <div class="col-7">: <t t-esc="data['tempat-tujuan-surat']"/></div>\n                    </div>\n                </div>\n                <p class="mt-5">Mohon pemeriksaan / pengobatan lebih lanjut terhadap pasien:</p>\n                <div class="mt-3 ml-3">\n                    <div class="row">\n                        <div class="col-4">Nama</div>\n                        <div class="col-5">: <strong><t t-esc="o['partner_id']['name']"/></strong></div>\n                    </div>\n                    <div class="row">\n                        <div class="col-4">Tanggal Lahir</div>\n                        <div class="col-5">: <t t-esc="o['partner_id']['birthDate'].strftime('%d-%m-%Y')"/></div>\n                    </div>\n                    <div class="row">\n                        <div class="col-4">Jenis Kelamin</div>\n                        <div class="col-5">: \n                          <t t-if="o['partner_id']['gender'] == 'male'">Laki-Laki</t>\n                          <t t-else="">Perempuan</t>\n                        </div>\n                    </div>\n                    <div class="row">\n                        <div class="col-4">Alamat</div>\n                        <div class="col-8">: <t t-esc="o['partner_id']['street']"/></div>\n                    </div>\n                    <div class="row">\n                        <div class="col-4">Diagnosa</div>\n                        <div class="col-8">: <t t-esc="data['diagnosa']"/></div>\n                    </div>\n                    <div class="row">\n                        <div class="col-4">Pemeriksaan yang diperlukan</div>\n                        <div class="col-8">: <strong><t t-esc="data['keterangan-pemeriksaan']"/></strong></div>\n                    </div>\n                </div>\n                <p class="mt-3 mb-2">Demikian surat rujukan ini, atas kerjasama dan perhatiannya kami ucapkan terimakasih.</p><br/>\n\n                <t t-if="data['catatan'] != '-'">\n                  <p class="mb-0"><strong>Catatan:</strong></p>\n                  <p><t t-esc="data['catatan']"/></p>\n                </t>\n              </div>\n            </div>\n\n            <div class="row pt-5">\n                <div class="col-8"/>\n                <div class="col-5">\n                    <p class="mb-0">Tarutung<t t-esc="o['operating_unit_id']['company_id']['city']"/>, <t t-esc="o.to_date_string(data['registration_date'])"/></p>\n                    <p class="mb-0">Salam Hormat</p>\n                    <div class="mt-1" id="signature">\n                        <img t-att-src="'/ehealth_document/static/src/img/signature/signature-drsonyasiahaan.png'" style="max-height: 125px;" alt="Logo"/>\n                    </div>\n                    <p class="mb-0 mt-2"><strong>\n                      dr. Sonya Siahaan\n                    </strong></p>\n                </div>\n            </div>\n          </div>\n        </t>\n      </t>\n    	ehealth_document/report/template_surat_rujukan/report_drsonyasiahaan_surat_rujukan.xml	\N	\N	\N	\N	primary	t	1	2025-08-28 11:34:01.364376	1	2025-08-28 11:34:01.364376	f

772	report_package_barcode	\N	stock.report_package_barcode	16	qweb	<?xml version="1.0"?>\n<t t-name="stock.report_package_barcode">\n    <t t-call="web.basic_layout">\n        <t t-foreach="docs" t-as="o">\n            <t>\n                <div class="page">\n                    <div class="oe_structure"/>\n                    <table class="table table-condensed" style="border-bottom: 0px solid white !important;">\n                        <tr>\n                            <th>\n                              <h1 t-field="o.name" class="mt0 float-left"/>\n                            </th>\n                            <th name="td_pk_barcode" style="text-align: center">\n                                <img t-att-src="'/report/barcode/?type=%s&amp;value=%s&amp;width=%s&amp;height=%s' % ('Code128', o.name, 600, 100)" alt="Barcode" style="width:300px;height:50px"/>\n                                  <p t-field="o.name"/>\n                            </th>\n                        </tr>\n                    </table>\n                    <div class="row mt32 mb32">\n                        <div t-if="o.packaging_id" class="o_packaging_type col-auto">\n                            <strong>Package Type:</strong>\n                            <p t-field="o.packaging_id.name"/>\n                        </div>\n                    </div>\n                    <table class="table table-sm" style="border-bottom: 0px solid white !important;">\n                        <t t-set="has_serial_number" t-value="o.quant_ids.mapped('lot_id')"/>\n                        <thead>\n                            <tr>\n                                <th>Product</th>\n                                <th name="th_quantity" class="text-right">Quantity</th>\n                                <th name="th_uom" groups="uom.group_uom"/>\n                                <th name="th_serial" class="text-right" t-if="has_serial_number">Lot/Serial Number</th>\n                            </tr>\n                        </thead>\n                        <tbody>\n                            <tr t-foreach="o.quant_ids" t-as="l">\n                                <td>\n                                   <span t-field="l.product_id.name"/>\n                                </td>\n                                <td class="text-right">\n                                    <span t-field="l.quantity"/>\n                                </td>\n                                <td groups="uom.group_uom">\n                                    <span t-field="l.product_id.uom_id.name"/>\n                                </td>\n                                <td class="text-right" t-if="has_serial_number">\n                                    <t t-if="l.lot_id"><span t-field="l.lot_id.name"/></t>\n                                </td>\n                            </tr>\n                        </tbody>\n                    </table>\n                </div>\n            </t>\n        </t>\n    </t>\n</t>\n\n	stock/report/report_package_barcode.xml	\N	\N	\N	\N	primary	t	1	2025-08-28 11:32:42.235962	1	2025-08-28 11:32:42.235962	f
1664	report_diatrans_surat_keterangan_hd	\N	ehealth_document.report_diatrans_surat_keterangan_hd	16	qweb	<?xml version="1.0"?>\n<t t-name="ehealth_document.report_diatrans_surat_keterangan_hd">\n        <t t-set="company" t-value="res_company"/>\n        <t t-call="ehealth_document.header_diatrans_document">\n          <div class="page">\n            <div class="row">\n              <div class="col-md-12">\n                <p class="text-center mt-3 mb-0"><strong>FORMULIR PERSETUAN</strong></p>\n                <p class="text-center"><strong>HEMODIALISIS RAWAT JALAN LEBIH DARI 2 KALI SEMINGGU</strong></p>\n\n                <div class="mt-3 ml-3">\n                    <div class="row">\n                        <div class="col-3 pr-0">Nama Peserta</div>\n                        <div class="col-6">: <t t-esc="o['partner_id']['name']"/></div>\n                    </div>\n                    <div class="row">\n                        <div class="col-3 pr-0">No. Anggota JKN</div>\n                        <div class="col-6">:\n                          <t t-esc="data['no-jkn']"/>\n                        </div>\n                    </div>\n                </div>\n                <p class="mt-4 ml-3"><strong>DIAGNOSIS</strong><br/>Utama:</p>\n                <div class="ml-3"><i style="font-size:24px" class="fa"></i> Chronic Kidney Disease Stage 5 (PenyakitGinjalTahap Akhir)</div>\n                <div class="ml-3"><i style="font-size:24px" class="fa"></i> Acute Kidney Injury</div>\n                <div class="ml-3"><i style="font-size:24px" class="fa"></i> Acute Kidney Injury Superimposed on Chronic Kidney Disease</div>\n                <div class="mt-3 ml-3">Sekunder:</div>\n                <div class="ml-3"><t t-esc="data['sekunder']"/></div>\n                <p class="mt-4 ml-3"><strong>INDIKASI HD LEBIH DARI 2 KALI SEMINGGU:</strong></p>\n                <div class="ml-3"><i style="font-size:24px" class="fa"></i> Hemodinamik tidak stabil (apa pun penyebabnya)</div>\n                <div class="ml-3"><i style="font-size:24px" class="fa"></i> Keperluan perioperatif</div>\n                <div class="ml-3"><i style="font-size:24px" class="fa"></i> Ibu hamil</div>\n                <div class="ml-3"><i style="font-size:24px" class="fa"></i> Kondisi overhidrasi yang sulit dikendalikan</div>\n                <div class="ml-3"><i style="font-size:24px" class="fa"></i> Pasien dengan berat badan kering &gt; 75 kg </div>\n                <div class="ml-3"><i style="font-size:24px" class="fa"></i> Pasien transplantasi ginjal dengan reaksi rejeksi</div>\n                <div class="ml-3"><i style="font-size:24px" class="fa"></i> Pasien transplantasi ginjal dengan delayed graft function</div>\n\n                <p class="mt-4 ml-3"><strong>SURAT KETERANGAN INI BERLAKU UNTUK:</strong></p>\n                <div class="ml-3"><i style="font-size:24px" class="fa"></i> 1 (satu) bulan</div>\n                <div class="ml-3"><i style="font-size:24px" class="fa"></i> 3 (tiga) bulan</div>\n              </div>\n            </div>\n\n            <div class="row pt-5">\n                <div class="col-6"/>\n                <div class="col-6 text-center">\n                    <p class="mb-0">Jakarta, <t t-esc="o.to_date_string(data['registration_date'])"/></p>\n                    <p>Dokter Penanggung Jawab Pelayanan</p>\n                    <div style="width:125px;height:110px;"/>\n                    <p class="mb-0 mt-2"><strong><t t-esc="data['nama-dokter']"/></strong></p>\n                </div>\n            </div>\n          </div>\n        </t>\n      </t>\n    	ehealth_document/report/template_surat_keterangan_hd/report_diatrans_surat_keterangan_hd.xml	\N	\N	\N	\N	primary	t	1	2025-08-28 11:34:01.364376	1	2025-08-28 11:34:01.364376	f

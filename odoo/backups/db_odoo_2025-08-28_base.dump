t t-esc="data['examiner_name']"/>\n                    </t>\n                    <t t-else="">\n                      <t t-esc="data['sender']"/>\n                    </t>\n                    </strong></p>\n                </div>\n            </div>\n          </div>\n        </t>\n      </t>\n    	ehealth_document/report/template_surat_sehat/report_kenko_surat_sehat.xml	\N	\N	\N	\N	primary	t	1	2025-08-28 11:34:01.364376	1	2025-08-28 11:34:01.364376	f
523	Main Frontend Layout	\N	portal.frontend_layout	16	qweb	<?xml version="1.0"?>\n<data name="Main Frontend Layout" inherit_id="web.frontend_layout">\n        <xpath expr="//div[@id='wrapwrap']" position="attributes">\n            <attribute name="t-attf-class" add="#{request.env['res.lang']._lang_get(request.env.lang).direction == 'rtl' and 'o_rtl' or ''}" separator=" "/>\n            <attribute name="t-attf-class" add="#{'o_portal' if is_portal else ''}" separator=" "/>\n        </xpath>\n        <xpath expr="//div[@id='wrapwrap']/header/img" position="replace">\n            <nav class="navbar navbar-expand navbar-light bg-light">\n                <div class="container">\n                    <a href="/" class="navbar-brand logo">\n                        <img t-att-src="'/logo.png?company=%s' % res_company.id" t-att-alt="'Logo of %s' % res_company.name" t-att-title="res_company.name"/>\n                    </a>\n                    <ul id="top_menu" class="nav navbar-nav ml-auto">\n                        <t t-call="portal.placeholder_user_sign_in">\n                            <t t-set="_item_class" t-value="'nav-item'"/>\n                            <t t-set="_link_class" t-value="'nav-link'"/>\n                        </t>\n                        <t t-call="portal.user_dropdown">\n                            <t t-set="_user_name" t-value="true"/>\n                            <t t-set="_item_class" t-value="'nav-item dropdown'"/>\n                            <t t-set="_link_class" t-value="'nav-link'"/>\n                            <t t-set="_dropdown_menu_class" t-value="'dropdown-menu-right'"/>\n                        </t>\n                    </ul>\n                </div>\n            </nav>\n        </xpath>\n        <xpath expr="//div[@id='wrapwrap']/main/t[@t-raw='0']" position="before">\n            <div t-if="o_portal_fullwidth_alert" class="alert alert-info alert-dismissible rounded-0 fade show d-print-none css_editable_mode_hidden">\n                <div class="container">\n                    <t t-raw="o_portal_fullwidth_alert"/>\n                </div>\n            </div>\n        </xpath>\n    </data>\n\n    	portal/views/portal_templates.xml	\N	\N	193	\N	extension	t	1	2025-08-28 11:32:23.971774	1	2025-08-28 11:32:23.971774	f
524	Footer Language Selector	\N	portal.footer_language_selector	16	qweb	<?xml version="1.0"?>\n<data inherit_id="portal.frontend_layout" name="Footer Language Selector">\n        <xpath expr="//*[hasclass('o_footer_copyright_name')]" position="after">\n            <t id="language_selector_call" t-call="portal.language_selector">\n                <t t-set="_div_classes" t-value="(_div_classes or '') + ' dropup'"/>\n            </t>\n        </xpath>\n    </data>\n\n    	portal/views/portal_templates.xml	\N	\N	523	\N	extension	t	1	2025-08-28 11:32:23.971774	1	2025-08-28 11:32:23.971774	f
1527	report_puskesmasdaruba_surat_sehat	\N	ehealth_document.report_puskesmasdaruba_surat_sehat	16	qweb	<?xml version="1.0"?>\n<t t-name="ehealth_document.report_puskesmasdaruba_surat_sehat">\n        <t t-set="company" t-value="res_company"/>\n        <t t-call="ehealth_document.header_puskesmasdaruba_document">\n          <div class="page">\n            <div class="row">\n              <div class="col-md-12">\n                <p class="text-center mt-3 mb-0"><strong>SURAT KETERANGAN DOKTER</strong></p>\n                <p class="text-center">Nomor: <t t-esc="o['name']"/></p>\n                <p class="mt-4">Yang bertanda tangan di bawah ini Dokter Puskesmas Daruba Kecamatan Morotai Selatan, menerangkan bahwa :</p>\n                <div class="mt-3 ml-3">\n                    <div class="row">\n                        <div class="col-3">\n                          <t t-if="o['partner_id']['identity_type'] == 'ktp'">NIK</t>\n                          <t t-if="o['partner_id']['identity_type'] == 'sim'">No. SIM</t>\n                          <t t-if="o['partner_id']['identity_type'] == 'paspor'">No. Paspor</t>\n                        </div>\n                        <div class="col-6">: \n                          <t t-if="o['partner_id']['identity_type'] == 'ktp'"><t t-esc="o['partner_id']['nik']"/></t>\n                          <t t-else=""><t t-esc="o['partner_id']['identity_number']"/></t>\n                        </div>\n                    </div>\n                    <div class="row">\n                        <div class="col-3">Nama</div>\n                        <div class="col-6">: <strong><t t-esc="o['partner_id']['name']"/></strong></div>\n                    </div>\n                    <div class="row">\n                        <div class="col-3">Tanggal Lahir</div>\n                        <div class="col-6">: <t t-esc="o['partner_id']['birthDate'].strftime('%d-%m-%Y')"/>, <t t-esc="o.count_age(o['partner_id']['birthDate'].strftime('%d/%m/%Y'))"/> Tahun</div>\n                    </div>\n                    <div class="row">\n                        <div class="col-3">Jenis Kelamin</div>\n                        <div class="col-6">: \n                          <t t-if="o['partner_id']['gender'] == 'male'">Laki-Laki</t>\n                          <t t-else="">Perempuan</t>\n                        </div>\n                    </div>\n                    <div class="row">\n                        <div class="col-3">Pekerjaan</div>\n                        <div class="col-6">: <t t-esc="o['partner_id']['function']"/></div>\n                    </div>\n                    <div class="row">\n                        <div class="col-3">Alamat</div>\n                        <div class="col-6">: <t t-esc="o['partner_id']['street']"/></div>\n                    </div>\n                </div>\n                <p class="mt-3 mb-0">Telah dilakukan pemeriksaan kesehatan terhadap yang bersangkutan dalam keadaan </p><br/>\n                <p class="mt-0 mb-0 text-center"><strong>Sehat baik secara Jasmani maupun Rohani</strong></p><br/>\n                <p class="mt-0 mb-0">Surat keterangan ini dipergunakan untuk <strong><t t-esc="data['keperluan']"/></strong>.</p><br/>\n                <p>Demikian Surat Keterangan ini dibuat, untuk digunakan sebagaimana mestinya.</p><br/>\n                <div class="row">\n                  <div class="col-3">\n                    <p><strong>Keterangan :</strong></p>\n                  </div>\n                </div>\n                <div class="row">\n                  <div class="col-3">Tinggi Badan</div>\n                  <div class="col-3">: <t t-esc="data['tinggi-badan']"/> cm</div>\n                  <div class="col-3">Tekanan Darah</div>\n                  <div class="col-3">: <t t-esc="data['sistole']"/>/<t t-esc="data['diastole']"/> mmHg</div>\n                </div>\n                <div class="row">\n                  <div class="col-3">Berat Badan</div>\n                  <div class="col-3">: <t t-esc="data['berat-badan']"/> kg</div>\n                  <div class="col-3">Buta Warna</div>\n                  <div class="col-3">: <t t-esc="data['buta-warna']"/></div>\n                </div>\n              </div>\n            </div>\n\n            <div class="row pt-5">\n                <div class="col-1"/>\n                <div class="col-3 mt-4">\n                    <p class="mb-0">Validasi</p>\n                    <div class="mt-3" id="qrcode">\n                        <img t-att-src="o['qr_code_url']" style="width:125px;height:125px;"/>\n                    </div>\n                </div>\n                <div class="col-3"/>\n                <div class="col-5">\n                    <p class="mb-0"><t t-esc="o['operating_unit_id']['city']"/>, <t t-esc="o.to_date_string(data['registration_date'])"/></p>\n                    <p class="mb-0">Dokter Puskesmas</p>\n                    <div class="mt-3" id="qrcode">\n                        <t t-if="'qr_code_examiner_url' in data">\n                          <img t-att-src="data['qr_code_examiner_url']" style="width:125px;height:125px;"/>\n                        </t>\n                        <t t-else="">\n                          <div style="width:125px;height:125px;"/>\n                        </t>\n                    </div>\n                    <p class="mb-0 mt-2"><strong>\n                    <p class="mb-0">dr. Adil Makmur</p>\n                    <p>NIP: 198506242014101001</p>\n                    </strong></p>\n                </div>\n            </div>\n          </div>\n        </t>\n      </t>\n    	ehealth_document/report/template_surat_sehat/report_puskesmasdaruba_surat_sehat.xml	\N	\N	\N	\N	primary	t	1	2025-08-28 11:34:01.364376	1	2025-08-28 11:34:01.364376	f
527	Portal Breadcrumbs	\N	portal.portal_breadcrumbs	16	qweb	<?xml version="1.0"?>\n<t name="Portal Breadcrumbs" t-name="portal.portal_breadcrumbs">\n        <ol t-if="page_name != 'home'" class="o_portal_submenu breadcrumb mb-0 py-2 flex-grow-1 row">\n            <li class="breadcrumb-item ml-1"><a href="/my/home" aria-label="Home" title="Home"><i class="fa fa-home"/></a></li>\n            <li t-if="page_name == 'my_details'" class="breadcrumb-item">Details</li>\n        </ol>\n    </t>\n\n    	portal/views/portal_templates.xml	\N	\N	\N	\N	primary	t	1	2025-08-28 11:32:23.971774	1	2025-08-28 11:32:23.971774	f
525	Language Selector	\N	portal.language_selector	16	qweb	<?xml version="1.0"?>\n<t name="Language Selector" t-name="portal.language_selector">\n        <t t-set="active_lang" t-value="list(filter(lambda lg : lg[0] == lang, languages))[0]"/>\n        <t t-set="language_selector_visible" t-value="len(languages) &gt; 1"/>\n        <div t-attf-class="js_language_selector #{_div_classes}" t-if="language_selector_visible">\n            <button class="btn btn-sm btn-outline-secondary border-0 dropdown-toggle" type="button" data-toggle="dropdown" aria-haspopup="true" aria-expanded="true">\n                <span t-if="not no_text" class="align-middle" t-esc="active_lang[2].split('/').pop()"/>\n            </button>\n            <div class="dropdown-menu" role="menu">\n                <t t-foreach="languages" t-as="lg">\n                    <a t-att-href="url_for(request.httprequest.path + '?' + keep_query(), lang_code=lg[0])" class="dropdown-item js_change_lang" t-att-data-url_code="lg[1]">\n                        <span t-if="not no_text" t-esc="lg[2].split('/').pop()"/>\n                    </a>\n                </t>\n            </div>\n        </div>\n    </t>\n\n    	portal/views/portal_templates.xml	\N	\N	\N	\N	primary	t	1	2025-08-28 11:32:23.971774	1	2025-08-28 11:32:23.971774	f
526	Portal User Dropdown	\N	portal.user_dropdown	16	qweb	<?xml version="1.0"?>\n<t name="Portal User Dropdown" t-name="portal.user_dropdown">\n        <t t-set="is_connected" t-value="not user_id._is_public()"/>\n        <li t-if="is_connected" t-attf-class="#{_item_class} o_no_autohide_item">\n            <a href="#" role="button" data-toggle="dropdown" t-attf-class="dropdown-toggle #{_link_class}">\n                <t t-if="_avatar">\n                    <t t-if="user_id.image_256" t-set="avatar_source" t-value="image_data_uri(user_id.image_256)"/>\n                    <t t-else="" t-set="avatar_source" t-value="'/web/static/src/img/placeholder.png'"/>\n                    <img t-att-src="avatar_source" t-attf-class="rounded-circle o_object_fit_cover #{_avatar_class}" width="24" height="24" alt="" loading="eager"/>\n                </t>\n                <i t-if="_icon" t-attf-class="fa fa-1x fa-fw fa-user-circle-o #{_icon_class}"/>\n                <span t-if="_user_name" t-attf-class="#{_user_name_class}" t-esc="user_id.name[:23] + '...' if user_id.name and len(user_id.name) &gt; 25 else user_id.name"/>\n            </a>\n            <div t-attf-class="dropdown-menu js_usermenu #{_dropdown_menu_class}" role="menu">\n                <div id="o_logout_divider" class="dropdown-divider"/>\n                <a t-attf-href="/web/session/logout?redirect=/" role="menuitem" id="o_logout" class="dropdown-item">Logout</a>\n            </div>\n        </li>\n    </t>\n\n    	portal/views/portal_templates.xml	\N	\N	\N	\N	primary	t	1	2025-08-28 11:32:23.971774	1	2025-08-28 11:32:23.971774	f

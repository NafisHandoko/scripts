1083	Purchase: Confirmation mail notification template	\N	purchase.mail_notification_confirm	16	qweb	<?xml version="1.0"?>\n<data inherit_id="mail.mail_notification_paynow" name="Purchase: Confirmation mail notification template">\n        <xpath expr="//t[@t-set='access_name']" position="after">\n            <t t-if="record._name == 'purchase.order'">\n                <t t-if="record.state == 'purchase' and not record.env.context.get('is_reminder')">\n                    <t t-set="access_name">Confirm</t>\n                    <t t-set="access_url" t-value="record.get_confirm_url(confirm_type='reception')"/>\n                </t>\n            </t>\n        </xpath>\n        <xpath expr="//a[@t-att-href='access_url']" position="replace">\n            <t t-if="record._name == 'purchase.order' and record.env.context.get('is_reminder')">\n                <a t-att-href="record.get_confirm_url(confirm_type='reminder')" style="margin-right: 10px; background-color: #875A7B; padding: 8px 16px 8px 16px; text-decoration: none; color: #fff; border-radius: 5px; font-size:13px;">\n                    Yes\n                </a>\n                <a t-att-href="record.get_update_url()" style="margin-left: 10px; background-color: #875A7B; padding: 8px 16px 8px 16px; text-decoration: none; color: #fff; border-radius: 5px; font-size:13px;">\n                    No, Update Dates\n                </a>\n                <div>&amp;nbsp;</div>\n                <div style="margin: 0px; padding: 0px; font-size:13px; text-align: left;">\n                    If you have any questions, please do not hesitate to contact us.\n                    <div>&amp;nbsp;</div>\n                    Best regards,\n                </div>\n            </t>\n            <t t-else="">\n                <a t-att-href="access_url" style="margin-left: 10px; background-color: #875A7B; padding: 8px 16px 8px 16px; text-decoration: none; color: #fff; border-radius: 5px; font-size:13px;">\n                    <t t-esc="access_name"/>\n                </a>\n            </t>\n        </xpath>\n    </data>\n\n    	purchase/data/mail_template_data.xml	\N	\N	379	\N	extension	t	1	2025-08-28 11:33:08.048846	1	2025-08-28 11:33:08.048846	f

                    </td>\n                                            <t t-set="current_section" t-value="line"/>\n                                            <t t-set="current_subtotal" t-value="0"/>\n                                        </t>\n                                        <t t-if="line.display_type == 'line_note'">\n                                            <td colspan="99">\n                                                <span t-field="line.name" t-options="{'widget': 'text'}"/>\n                                            </td>\n                                        </t>\n                                    </tr>\n\n                                    <t t-if="current_section and (line_last or lines[line_index+1].display_type == 'line_section')">\n                                        <tr class="is-subtotal text-right">\n                                            <td colspan="99">\n                                                <strong class="mr16">Subtotal</strong>\n                                                <span t-esc="current_subtotal" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: o.currency_id}"/>\n                                            </td>\n                                        </tr>\n                                    </t>\n                                </t>\n                            </tbody>\n                        </table>\n\n                        <div class="clearfix">\n                            <div id="total" class="row">\n                                <div t-attf-class="#{'col-6' if report_type != 'html' else 'col-sm-7 col-md-6'} ml-auto">\n                                    <table class="table table-sm" style="page-break-inside: avoid;">\n                                        <tr class="border-black o_subtotal" style="">\n                                            <td><strong>Subtotal</strong></td>\n                                            <td class="text-right">\n                                                <span t-field="o.amount_untaxed"/>\n                                            </td>\n                                        </tr>\n                                        <t t-foreach="o.amount_by_group" t-as="amount_by_group">\n                                            <tr style="">\n                                                <t t-if="len(o.line_ids.filtered(lambda line: line.tax_line_id)) in [0, 1] and o.amount_untaxed == amount_by_group[2]">\n                                                    <td><span class="text-nowrap" t-esc="amount_by_group[0]"/></td>\n                                                    <td class="text-right o_price_total">\n                                                        <span class="text-nowrap" t-esc="amount_by_group[3]"/>\n                                                    </td>\n                                                </t>\n                                                <t t-else="">\n                                                    <td>\n                                                        <span t-esc="amount_by_group[0]"/>\n                                                        <span class="text-nowrap"> on\n                                                            <t t-esc="amount_by_group[4]"/>\n                                                        </span>\n                                                    </td>\n                                                    <td class="text-right o_price_total">\n                                                        <span class="text-nowrap" t-esc="amount_by_group[3]"/>\n                                                    </td>\n                                                </t>\n                                            </tr>\n                                        </t>\n                                            <tr>\n                                                <t t-set="pay" t-value="o.sudo()._get_reconciled_info_JSON_values()"/>\n                                                <t t-foreach="pay" t-as="pay">\n                                                    <td>\n                                                        <strong>Dibayar (<span t-esc="pay['journal_name']"/>)</strong>\n                                                    </td>\n                                                    <td class="text-right">\n                                                            <span t-esc="pay['amount']" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: o.currency_id}"/>\n                                                    </td>\n                                                </t>\n                                            </tr>\n                                        <tr class="border-black o_total">\n                                            <td><strong>Total</strong></td>\n                                            <td class="text-right">\n                                                <span class="text-nowrap" t-field="o.amount_total"/>\n                                            </td>\n                                        </tr>\n                                        <t t-if="print_with_payments">\n                                            <t t-if="o.payment_state != 'invoicing_legacy'">\n                                                <t t-set="payments_vals" t-value="o.sudo()._get_reconciled_info_JSON_values()"/>\n                                                <t t-foreach="payments_vals" t-as="payment_vals">\n                                                    <tr>\n                                                        <td>\n                                                            <i class="oe_form_field text-right oe_payment_label">Paid on <t t-esc="payment_vals['date']" t-options="{&quot;widget&quot;: &quot;date&quot;}"/></i>\n                                                        </td>\n                                                        <td class="text-right">\n                                                            <span t-esc="payment_vals['amount']" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: o.currency_id}"/>\n                                                        </td>\n                                                    </tr>\n                                                </t>\n                                                <t t-if="len(payments_vals) &gt; 0">\n                                                    <tr class="border-black">\n                                                        <td><strong>Amount Due</strong></td>\n                                                        <td class="text-right">\n                                                            <span t-field="o.amount_residual"/>\n                                                        </td>\n                                                    </tr>\n                                                </t>\n                                            </t>\n                                        </t>\n                                    </table>\n                                </div>\n                            </div>\n                        </div>\n                        <hr/>\n                        <div id="section-notes" class="mt-4">\n                            <p><strong>Catatan</strong></p>\n                            <div>\n                                <span>1. Wajib melakukan DP sebesar Rp 50.000</span><br/>\n                                <span>2. Bukti transfer dapat dilampirkan pada kolom Chat/Comment dibawah ini</span><br/>\n                                <span>3. Pembatalan reservasi max H-1 dari jadwal, dapat menghub admin untuk pengembalian DP.</span><br/>\n                                <span>4. Untuk detail informasi lebih lanjut bisa menghubungi no wa klinik (by WA).</span>\n                            </div>\n                        </div>\n                        <div id="section-summary" class="mt-4">\n                            <p><strong>Detail Pembayaran</strong></p>\n                            <div class="row">\n                                <div class="col-5 col-sm-2 pl-auto pr-0">Nama Bank</div>\n                                <div class="col-5 col-sm-3">BCA</div>\n                            </div>\n                            <div class="row">\n                                <div class="col-5 col-sm-2 pl-auto pr-0">Nama Akun</div>\n                                <div class="col-5 col-sm-3">Mellisa</div>\n                            </div>\n                            <div class="row">\n                                <div class="col-5 col-sm-2 pl-auto pr-0">Nomor Akun</div>\n                                <div class="col-5 col-sm-3">4530010151</div>\n                            </div>\n                        </div>\n                    </div>\n                </t>\n        </t>\n    	ehealth_document/report/template_invoice/template_invoice_lins.xml	\N	\N	\N	\N	primary	t	1	2025-08-28 11:34:01.364376	1	2025-08-28 11:34:01.364376	f
1510	template_invoice_btari	\N	ehealth_document.template_invoice_btari	16	qweb	<?xml version="1.0"?>\n<t t-name="ehealth_document.template_invoice_btari">\n            <t t-call="web.external_layout">\n                <t t-set="o" t-value="o.with_context(lang=lang)"/>\n                <div class="page">\n                    <div id="section-identity">\n                        <div class="row mb-2">\n                            <div class="col-6">\n                                <div class="row">\n                                    <div class="col-10 text-left ml-1" style="font-size: 18px;"><strong><t t-esc="o['name']"/></strong></div>\n                                </div>\n                                <div class="row">\n                                    <div class="col-3 ml-1" style="font-size: 14px;">Tanggal</div>\n                                    <div class="col-8 text-left" style="font-size: 14px;"><t t-esc="o['invoice_date'].strftime('%d-%m-%Y')"/></div>\n                                </div>\n                                <div class="row">\n                                    <div class="col-3 ml-1" style="font-size: 14px;">Nama</div>\n                                    <div class="col-8 text-left" style="font-size: 14px;"><t t-esc="o['partner_id']['name']"/></div>\n                                </div>\n                            </div>\n                        </div>\n                    </div>\n\n\n                    <t t-set="display_discount" t-value="any(l.discount for l in o.invoice_line_ids)"/>\n\n                        <table class="table table-sm o_main_table" style="font-size: 14px;" name="invoice_line_table">\n                            <thead>\n                                <tr>\n                                    <th name="th_description" class="text-left"><span>Description</span></th>\n                                    <th name="th_quantity" class="text-right"><span>Quantity</span></th>\n                                    <th name="th_priceunit" t-attf-class="text-right {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}"><span>Unit Price</span></th>\n                                    <th name="th_price_unit" t-if="display_discount" t-attf-class="text-right {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}">\n                                        <span>Disc.%</span>\n                                    </th>\n                                    <th name="th_taxes" t-attf-class="text-left {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}"><span>Taxes</span></th>\n                                    <th name="th_subtotal" class="text-right">\n                                        <span groups="account.group_show_line_subtotals_tax_excluded">Amount</span>\n                                        <span groups="account.group_show_line_subtotals_tax_included">Total Price</span>\n                                    </th>\n                                </tr>\n                            </thead>\n                            <tbody class="invoice_tbody">\n                                <t t-set="current_subtotal" t-value="0"/>\n                                <t t-set="lines" t-value="o.invoice_line_ids.sorted(key=lambda l: (-l.sequence, l.date, l.move_name, -l.id), reverse=True)"/>\n\n                                <t t-foreach="lines" t-as="line">\n                                    <t t-set="current_subtotal" t-value="current_subtotal + line.price_subtotal" groups="account.group_show_line_subtotals_tax_excluded"/>\n                                    <t t-set="current_subtotal" t-value="current_subtotal + line.price_total" groups="account.group_show_line_subtotals_tax_included"/>\n\n                                    <tr t-att-class="'bg-200 font-weight-bold o_line_section' if line.display_type == 'line_section' else 'font-italic o_line_note' if line.display_type == 'line_note' else ''">\n                                        <t t-if="not line.display_type" name="account_invoice_line_accountable">\n                                            <td name="account_invoice_line_name"><span t-field="line.name" t-options="{'widget': 'text'}"/></td>\n                                            <td class="text-right">\n                                                <span t-field="line.quantity"/>\n                                                <span t-field="line.product_uom_id" groups="uom.group_uom"/>\n                                            </td>\n                                            <td t-attf-class="text-right {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}">\n                                                <span class="text-nowrap" t-field="line.price_unit"/>\n                                            </td>\n                                            <td t-if="display_discount" t-attf-class="text-right {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}">\n                                                <span class="text-nowrap" t-field="line.discount"/>\n                                            </td>\n                                            <td t-attf-class="text-left {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}">\n                                                <span t-esc="', '.join(map(lambda x: (x.description or x.name), line.tax_ids))" id="line_tax_ids"/>\n                                            </td>\n                                            <td class="text-right o_price_total">\n                                                <span class="text-nowrap" t-field="line.price_subtotal" groups="account.group_show_line_subtotals_tax_excluded"/>\n                                                <span class="text-nowrap" t-field="line.price_total" groups="account.group_show_line_subtotals_tax_included"/>\n                                            </td>\n                                        </t>\n                                        <t t-if="line.display_type == 'line_section'">\n                                            <td colspan="99">\n                                                <span t-field="line.name" t-options="{'widget': 'text'}"/>\n                                            </td>\n                                            <t t-set="current_section" t-value="line"/>\n                                            <t t-set="current_subtotal" t-value="0"/>\n                                        </t>\n                                        <t t-if="line.display_type == 'line_note'">\n                                            <td colspan="99">\n                                                <span t-field="line.name" t-options="{'widget': 'text'}"/>\n                                            </td>\n                                        </t>\n                                    </tr>\n\n                                    <t t-if="current_section and (line_last or lines[line_index+1].display_type == 'line_section')">\n                                        <tr class="is-subtotal text-right">\n                                            <td colspan="99">\n                                                <strong class="mr16">Subtotal</strong>\n                                                <span t-esc="current_subtotal" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: o.currency_id}"/>\n                                            </td>\n                                        </tr>\n                                    </t>\n                                </t>\n                            </tbody>\n                        </table>\n\n                        <div class="clearfix">\n                            <div id="total" class="row">\n                                <div t-attf-class="#{'col-6' if report_type != 'html' else 'col-sm-7 col-md-6'} ml-auto">\n                                    <table class="table table-sm" style="page-break-inside: avoid; font-size: 14px;">\n                                        <tr class="border-black o_subtotal" style="">\n                                            <td><strong>Subtotal</strong></td>\n                                            <td class="text-right">\n                                                <span class="text-nowrap" t-field="o.amount_without_discount"/>\n                                            </td>\n                                        </tr>\n                                        <t t-foreach="o.amount_by_group" t-as="amount_by_group">\n                                            <tr style="">\n                                                <t t-if="len(o.line_ids.filtered(lambda line: line.tax_line_id)) in [0, 1] and o.amount_untaxed == amount_by_group[2]">\n                                                    <td><span class="text-nowrap" t-esc="amount_by_group[0]"/></td>\n                                                    <td class="text-right o_price_total">\n                                                        <span class="text-nowrap" t-esc="amount_by_group[3]"/>\n                                                    </td>\n                                                </t>\n                                                <t t-else="">\n                                                    <td>\n                                                        <span t-esc="amount_by_group[0]"/>\n                                                        <span class="text-nowrap"> on\n                                                            <t t-esc="amount_by_group[4]"/>\n                                                        </span>\n                                                    </td>\n                                                    <td class="text-right o_price_total">\n                                                        <span class="text-nowrap" t-esc="amount_by_group[3]"/>\n                                                    </td>\n                                                </t>\n                                            </tr>\n                                        </t>\n                                            <tr>\n                                                <td><strong>Diskon</strong></td>\n                                                <td class="text-right">\n                                                    -<span t-field="o.total_discount"/>\n                                                </td>\n                                            </tr>\n                                        <tr class="border-black o_total">\n                                            <td><strong>Total</strong></td>\n                                            <td class="text-right">\n                                                <span class="text-nowrap" t-field="o.amount_total"/>\n                                            </td>\n                                        </tr>\n                                        <t t-if="print_with_payments">\n                                            <t t-if="o.payment_state != 'invoicing_legacy'">\n                                                <t t-set="pay" t-value="o.sudo()._get_reconciled_info_JSON_values()"/>\n                                                <t t-foreach="pay" t-as="pay">\n                                                    <tr>\n                                                        <td>\n                                                            <strong>Dibayar (<span t-esc="pay['journal_name']"/>)</strong>\n                                                        </td>\n                                                        <td class="text-right">\n                                                            <span t-esc="pay['amount']" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: o.currency_id}"/>\n                                                        </td>\n                                                    </tr>\n                                                </t>\n                                                \n                                                <t t-if="len(pay) &gt; 0">\n                                                    <tr class="border-black">\n                                                        <td><strong>Amount Due</strong></td>\n                                                        <td class="text-right">\n                                                            <span t-field="o.amount_residual"/>\n                                                        </td>\n                                                    </tr>\n                                                </t>\n                                            </t>\n                                        </t>\n                                    </table>\n                                </div>\n                            </div>\n                        </div>\n                        <p t-if="o.move_type in ('out_invoice', 'in_refund') and o.payment_reference" style="font-size: 13px;" name="payment_communication">\n                            Please use the following communication for your payment : <b><span t-field="o.payment_reference"/></b>\n                        </p>\n                        <p t-if="o.invoice_payment_term_id" name="payment_term" style="font-size: 14px;">\n                            <span t-field="o.invoice_payment_term_id.note"/>\n                        </p>\n                        <p t-if="o.narration" name="comment" style="font-size: 14px;">\n                            <span t-field="o.narration"/>\n                        </p>\n                        <p t-if="o.fiscal_position_id.note" name="note" style="font-size: 14px;">\n                            <span t-field="o.fiscal_position_id.note"/>\n                        </p>\n                        <p t-if="o.invoice_incoterm_id" name="incoterm" style="font-size: 14px;">\n                            <strong>Incoterm: </strong><span t-field="o.invoice_incoterm_id.code"/> - <span t-field="o.invoice_incoterm_id.name"/>\n                        </p>\n                        <div id="qrcode" t-if="o.display_qr_code">\n                            <p t-if="qr_code_urls.get(o.id)">\n                                <strong class="text-center">Scan me with your banking app.</strong><br/><br/>\n                                <img class="border border-dark rounded" t-att-src="qr_code_urls[o.id]"/>\n                            </p>\n                        </div>\n                </div>\n            </t>\n        </t>\n    	ehealth_document/report/template_invoice/template_invoice_btari.xml	\N	\N	\N	\N	primary	t	1	2025-08-28 11:34:01.364376	1	2025-08-28 11:34:01.364376	f
1511	template_invoice_westerindo	\N	ehealth_document.template_invoice_westerindo	16	qweb	<?xml version="1.0"?>\n<t t-name="ehealth_document.template_invoice_westerindo">\n            <t t-call="web.external_layout">\n                    <t t-set="o" t-value="o.with_context(lang=lang)"/>\n                    <!-- <t t-set="address">\n                        <address t-field="o.partner_id" t-options='{"widget": "contact", "fields": ["address", "name", "no_cm"], "no_marker": True}' />\n                        <div t-if="o.partner_id.vat" class="mt16">\n                            <t t-if="o.company_id.country_id.vat_label" t-esc="o.company_id.country_id.vat_label" id="inv_tax_id_label"/>\n                            <t t-else="">Tax ID</t>: <span t-field="o.partner_id.vat"/></div>\n                    </t> -->\n                    \n\n                    <div class="page" style="font-size: 12px;">\n                        <div style="font-size: 14px;">\n                            <div class="row">\n                                <div class="col-6"/>\n                                <div class="col-2">Nama</div>\n                                <div class="col-4">: <t t-esc="o['partner_id']['name']"/></div>\n                            </div>\n                            <div class="row" t-if="o.partner_id.medical_record">\n                                <div class="col-6"/>\n                                <div class="col-2">No. RM</div>\n                                <div class="col-4">: <t t-esc="o['partner_id']['medical_record']"/></div>\n                            </div>\n                            <div class="row">\n                                <div class="col-6"/>\n                                <div class="col-2">Alamat</div>\n                                <div class="col-4">: <t t-esc="o['partner_id']['street']"/></div>\n                            </div>\n                        </div>\n                        <h4>\n                            <span t-if="o.move_type == 'out_invoice' and o.state == 'posted'">Invoice</span>\n                            <span t-if="o.move_type == 'out_invoice' and o.state == 'draft'">Draft Invoice</span>\n                            <span t-if="o.move_type == 'out_invoice' and o.state == 'cancel'">Cancelled Invoice</span>\n                            <span t-if="o.move_type == 'out_refund'">Credit Note</span>\n                            <span t-if="o.move_type == 'in_refund'">Vendor Credit Note</span>\n                            <span t-if="o.move_type == 'in_invoice'">Vendor Bill</span>\n                            <span t-if="o.name != '/'" t-field="o.name"/>\n                        </h4>\n\n                        <div id="informations" class="row mt32 mb32">\n                            <div class="col-auto col-6 mw-100 mb-2" t-if="o.invoice_date" name="invoice_date">\n                                <strong>Tanggal Invoice:</strong>\n                                <p class="m-0" t-field="o.invoice_date"/>\n                            </div>\n                            <div class="col-auto col-6 mw-100 mb-2" t-if="'pricelist' in o" name="pricelist">\n                                <strong>Skema Pembayaran:</strong>\n                                <p class="m-0" t-field="o.pricelist"/>\n                            </div>\n                        </div>\n\n                        <t t-set="display_discount" t-value="any(l.discount for l in o.invoice_line_ids)"/>\n\n                        <table class="table table-sm o_main_table" name="invoice_line_table">\n                            <thead>\n                                <tr>\n                                    <th name="th_description" class="text-left"><span>Item</span></th>\n                                    <th name="th_quantity" class="text-right"><span>Jumlah</span></th>\n                                    <th name="th_priceunit" t-attf-class="text-right {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}"><span>Harga</span></th>\n                                    <th name="th_price_unit" t-if="display_discount" t-attf-class="text-right {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}">\n                                        <span>Disc.%</span>\n                                    </th>\n                                    <th name="th_taxes" t-attf-class="text-left {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}" t-if="o.move_type == 'in_invoice'"><span>Taxes</span></th>\n                                    <th name="th_subtotal" class="text-right">\n                                        <span groups="account.group_show_line_subtotals_tax_excluded">Total</span>\n                                        <span groups="account.group_show_line_subtotals_tax_included">Total</span>\n                                    </th>\n                                </tr>\n                            </thead>\n                            <tbody class="invoice_tbody">\n                                <t t-set="current_subtotal" t-value="0"/>\n                                <t t-set="lines" t-value="o.invoice_line_ids.sorted(key=lambda l: (-l.sequence, l.date, l.move_name, -l.id), reverse=True)"/>\n\n                                <t t-foreach="lines" t-as="line">\n                                    <t t-set="current_subtotal" t-value="current_subtotal + line.price_subtotal" groups="account.group_show_line_subtotals_tax_excluded"/>\n                                    <t t-set="current_subtotal" t-value="current_subtotal + line.price_total" groups="account.group_show_line_subtotals_tax_included"/>\n\n                                    <tr t-att-class="'bg-200 font-weight-bold o_line_section' if line.display_type == 'line_section' else 'font-italic o_line_note' if line.display_type == 'line_note' else ''">\n                                        <t t-if="not line.display_type" name="account_invoice_line_accountable">\n                                            <td name="account_invoice_line_name"><span t-field="line.product_id.name" t-options="{'widget': 'text'}"/></td>\n                                            <td class="text-right">\n                                                <span t-esc="round(line['quantity'])"/>\n                                                <span t-field="line.product_uom_id" groups="uom.group_uom"/>\n                                            </td>\n                                            <td t-attf-class="text-right {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}">\n                                                <span t-esc="round(line['price_unit'])"/>\n                                            </td>\n                                            <td t-if="display_discount" t-attf-class="text-right {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}">\n                                                <span class="text-nowrap" t-field="line.discount"/>\n                                            </td>\n                                            <td t-attf-class="text-left {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}" t-if="o.move_type == 'in_invoice'">\n                                                <span t-esc="', '.join(map(lambda x: (x.description or x.name), line.tax_ids))" id="line_tax_ids"/>\n                                            </td>\n                                            <td class="text-right o_price_total">\n                                                <span class="text-nowrap" t-field="line.price_subtotal" groups="account.group_show_line_subtotals_tax_excluded"/>\n                                                <span class="text-nowrap" t-field="line.price_total" groups="account.group_show_line_subtotals_tax_included"/>\n                                            </td>\n                                        </t>\n                                        <t t-if="line.display_type == 'line_section'">\n                                            <td colspan="99">\n                                                <span t-field="line.name" t-options="{'widget': 'text'}"/>\n                                            </td>\n                                            <t t-set="current_section" t-value="line"/>\n                                            <t t-set="current_subtotal" t-value="0"/>\n                                        </t>\n                                        <t t-if="line.display_type == 'line_note'">\n                                            <td colspan="99">\n                                                <span t-field="line.name" t-options="{'widget': 'text'}"/>\n                                            </td>\n                                        </t>\n                                    </tr>\n\n                                    <t t-if="current_section and (line_last or lines[line_index+1].display_type == 'line_section')">\n                                        <tr class="is-subtotal text-right">\n                                            <td colspan="99">\n                                                <strong class="mr16">Subtotal</strong>\n                                                <span t-esc="current_subtotal" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: o.currency_id}"/>\n                                            </td>\n                                        </tr>\n                                    </t>\n                                </t>\n                            </tbody>\n                        </table>\n\n                        <div class="clearfix">\n                            <div id="total" class="row">\n                                <div t-attf-class="#{'col-6' if report_type != 'html' else 'col-sm-7 col-md-6'} ml-auto">\n                                    <table class="table table-sm" style="page-break-inside: avoid;">\n                                        <tr class="border-black o_subtotal" style="">\n                                            <td><strong>Subtotal (sebelum diskon)</strong></td>\n                                            <td class="text-right">\n                                                <span t-esc="o.compute_subtotal_with_discount()" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: o.currency_id}"/>\n                                            </td>\n                                        </tr>\n                                        <t t-foreach="o.amount_by_group" t-as="amount_by_group">\n                                            <tr style="">\n                                                <t t-if="len(o.line_ids.filtered(lambda line: line.tax_line_id)) in [0, 1] and o.amount_untaxed == amount_by_group[2]">\n                                                    <td><span class="text-nowrap" t-esc="amount_by_group[0]"/></td>\n                                                    <td class="text-right o_price_total">\n                                                        <span class="text-nowrap" t-esc="amount_by_group[3]"/>\n                                                    </td>\n                                                </t>\n                                                <t t-else="">\n                                                    <td>\n                                                        <span t-esc="amount_by_group[0]"/>\n                                                        <span class="text-nowrap"> on\n                                                            <t t-esc="amount_by_group[4]"/>\n                                                        </span>\n                                                    </td>\n                                                    <td class="text-right o_price_total">\n                                                        <span class="text-nowrap" t-esc="amount_by_group[3]"/>\n                                                    </td>\n                                                </t>\n                                            </tr>\n                                        </t>\n                                            <tr>\n                                                <td><strong>Diskon</strong></td>\n                                                <td class="text-right">\n                                                    -<span t-field="o.total_discount"/>\n                                                </td>\n                                            </tr>\n                                            \n                                        <tr class="border-black o_total">\n                                            <td><strong>Total</strong></td>\n                                            <td class="text-right">\n                                                <span class="text-nowrap" t-field="o.amount_total"/>\n                                            </td>\n                                        </tr>\n                                        <t t-if="print_with_payments">\n                                            <tr>\n                                                <t t-set="pay" t-value="o.sudo()._get_reconciled_info_JSON_values()"/>\n                                                <t t-foreach="pay" t-as="pay">\n                                                    <td>\n                                                        <strong>Dibayar (<span t-esc="pay['journal_name']"/>)</strong>\n                                                    </td>\n                                                    <td class="text-right">\n                                                            <span t-esc="pay['amount']" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: o.currency_id}"/>\n                                                    </td>\n                                                </t>\n                                            </tr>\n                                            <t t-if="len(pay) &gt; 0">\n                                                <tr class="border-black">\n                                                    <td><strong>Sisa Tagihan</strong></td>\n                                                    <td class="text-right">\n                                                        <span t-field="o.amount_residual"/>\n                                                    </td>\n                                                </tr>\n                                            </t>\n                                        </t>\n                                    </table>\n                                </div>\n                            </div>\n                        </div>\n\n                        <div class="mt-5" t-if="o.cashier.name" name="cashier">\n                            <div class="row py-0">\n                                <div class="col-9"/>\n                                <div class="col-3 py-0">\n                                    <p class="mb-0"><span t-field="o.operating_unit_id.city"/>, <span t-esc="o.invoice_date.strftime('%d-%m-%Y')"/></p>\n                                    <p>Kasir</p>\n                                </div>\n                            </div>\n                            <div class="row pt-5 mt-4">\n                                <div class="col-9"/>\n                                <div class="col-3 py-y">(   <span t-field="o.cashier.name"/>   )</div>\n                            </div>\n                        </div>\n\n                        <p t-if="o.invoice_payment_term_id" name="payment_term">\n                            <span t-field="o.invoice_payment_term_id.note"/>\n                        </p>\n                        <p t-if="o.narration" name="comment">\n                            <span t-field="o.narration"/>\n                        </p>\n                        <p t-if="o.fiscal_position_id.note" name="note">\n                            <span t-field="o.fiscal_position_id.note"/>\n                        </p>\n                        <p t-if="o.invoice_incoterm_id" name="incoterm">\n                            <strong>Incoterm: </strong><span t-field="o.invoice_incoterm_id.code"/> - <span t-field="o.invoice_incoterm_id.name"/>\n                        </p>\n                        <div id="qrcode" t-if="o.display_qr_code">\n                            <p t-if="qr_code_urls.get(o.id)">\n                                <strong class="text-center">Scan me with your banking app.</strong><br/><br/>\n                                <img class="border border-dark rounded" t-att-src="qr_code_urls[o.id]"/>\n                            </p>\n                        </div>\n                    </div>\n                </t>\n        </t>\n    	ehealth_document/report/template_invoice/template_invoice_westerindo.xml	\N	\N	\N	\N	primary	t	1	2025-08-28 11:34:01.364376	1	2025-08-28 11:34:01.364376	f
1512	template_invoice_lis_medika	\N	ehealth_document.template_invoice_lis_medika	16	qweb	<?xml version="1.0"?>\n<t t-name="ehealth_document.template_invoice_lis_medika">\n            <t t-set="company" t-value="res_company"/>\n            <t t-call="ehealth_document.header_lis_medika_document">\n                <t t-set="o" t-value="o.with_context(lang=lang)"/>\n\n                    <div class="page" style="font-size: 12px;">\n                    <div style="font-size: 14px;">\n                        <div class="row">\n                            <div class="col-6"/>\n                            <div class="col-2">Nama</div>\n                            <div class="col-4">: <t t-esc="o['partner_id']['name']"/></div>\n                        </div>\n                        <div class="row" t-if="o.partner_id.medical_record">\n                            <div class="col-6"/>\n                            <div class="col-2">No. RM</div>\n                            <div class="col-4">: <t t-esc="o['partner_id']['medical_record']"/></div>\n                        </div>\n                        <div class="row">\n                            <div class="col-6"/>\n                            <div class="col-2">Alamat</div>\n                            <div class="col-4">: <t t-esc="o['partner_id']['street']"/></div>\n                        </div>\n                    </div>\n                    <h4>\n                        <span t-if="o.move_type == 'out_invoice' and o.state == 'posted'">Invoice</span>\n                        <span t-if="o.move_type == 'out_invoice' and o.state == 'draft'">Draft Invoice</span>\n                        <span t-if="o.move_type == 'out_invoice' and o.state == 'cancel'">Cancelled Invoice</span>\n                        <span t-if="o.move_type == 'out_refund'">Credit Note</span>\n                        <span t-if="o.move_type == 'in_refund'">Vendor Credit Note</span>\n                        <span t-if="o.move_type == 'in_invoice'">Vendor Bill</span>\n                        <span t-if="o.name != '/'" t-field="o.name"/>\n                    </h4>\n    \n                    <div id="informations" class="row mt32 mb32">\n                        <div class="col-auto col-6 mw-100 mb-2" t-if="o.invoice_date" name="invoice_date">\n                            <strong>Tanggal Invoice:</strong>\n                            <p class="m-0" t-field="o.invoice_date"/>\n                        </div>\n                        <div class="col-auto col-6 mw-100 mb-2" t-if="'pricelist' in o" name="pricelist">\n                            <strong>Skema Pembayaran:</strong>\n                            <p class="m-0" t-field="o.pricelist"/>\n                        </div>\n                    </div>\n    \n                    <t t-set="display_discount" t-value="any(l.discount for l in o.invoice_line_ids)"/>\n    \n                    <table class="table table-sm o_main_table" name="invoice_line_table">\n                        <thead>\n                            <tr>\n                                <th name="th_description" class="text-left"><span>Item</span></th>\n                                <th name="th_quantity" class="text-right"><span>Jumlah</span></th>\n                                <th name="th_priceunit" t-attf-class="text-right {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}"><span>Harga</span></th>\n                                <th name="th_price_unit" t-if="display_discount" t-attf-class="text-right {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}">\n                                    <span>Disc.%</span>\n                                </th>\n                                <th name="th_taxes" t-attf-class="text-left {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}" t-if="o.move_type == 'in_invoice'"><span>Taxes</span></th>\n                                <th name="th_subtotal" class="text-right">\n                                    <span groups="account.group_show_line_subtotals_tax_excluded">Total</span>\n                                    <span groups="account.group_show_line_subtotals_tax_included">Total</span>\n                                </th>\n                            </tr>\n                        </thead>\n                        <tbody class="invoice_tbody">\n                            <t t-set="total_price_excl_tax" t-value="0"/>\n                            <t t-set="lines" t-value="o.invoice_line_ids.sorted(key=lambda l: (-l.sequence, l.date, l.move_name, -l.id), reverse=True)"/>\n                    \n                            <t t-foreach="lines" t-as="line">\n                                <t t-set="total_price_excl_tax" t-value="total_price_excl_tax + line.price_subtotal"/>\n                            </t>\n                    \n                            <tr>\n                                <td name="account_invoice_line_name" class="text-left"><span>Biaya Total</span></td>\n                                <td class="text-right"><span>1</span></td>\n                                <td t-attf-class="text-right {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}">\n                                    <span t-esc="total_price_excl_tax"/>\n                                </td>\n                                <td t-if="display_discount" t-attf-class="text-right {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}">\n                                    <span>0</span>\n                                </td>\n                                <td t-attf-class="text-left {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}" t-if="o.move_type == 'in_invoice'">\n                                    <span>0</span>\n                                </td>\n                                <td class="text-right o_price_total">\n                                    <span class="text-nowrap" t-esc="total_price_excl_tax" groups="account.group_show_line_subtotals_tax_excluded"/>\n                                </td>\n                            </tr>\n                        </tbody>\n                    </table>\n                    \n                    \n                    \n    \n                    <div class="clearfix">\n                        <div id="total" class="row">\n                            <div t-attf-class="#{'col-6' if report_type != 'html' else 'col-sm-7 col-md-6'} ml-auto">\n                                <table class="table table-sm" style="page-break-inside: avoid;">\n                                    <tr class="border-black o_subtotal" style="">\n                                        <td><strong>Subtotal</strong></td>\n                                        <td class="text-right">\n                                            <span t-esc="o.amount_untaxed + o.total_discount" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: o.currency_id}"/>\n                                        </td>\n                                    </tr>\n                                    <t t-foreach="o.amount_by_group" t-as="amount_by_group">\n                                        <tr style="">\n                                            <t t-if="len(o.line_ids.filtered(lambda line: line.tax_line_id)) in [0, 1] and o.amount_untaxed == amount_by_group[2]">\n                                                <td><span class="text-nowrap" t-esc="amount_by_group[0]"/></td>\n                                                <td class="text-right o_price_total">\n                                                    <span class="text-nowrap" t-esc="amount_by_group[3]"/>\n                                                </td>\n                                            </t>\n                                            <t t-else="">\n                                                <td>\n                                                    <span t-esc="amount_by_group[0]"/>\n                                                    <span class="text-nowrap"> on\n                                                        <t t-esc="amount_by_group[4]"/>\n                                                    </span>\n                                                </td>\n                                                <td class="text-right o_price_total">\n                                                    <span class="text-nowrap" t-esc="amount_by_group[3]"/>\n                                                </td>\n                                            </t>\n                                        </tr>\n                                    </t>\n                                        <tr>\n                                            <td><strong>Diskon</strong></td>\n                                            <td class="text-right">\n                                                -<span t-field="o.total_discount"/>\n                                            </td>\n                                        </tr>\n                                        \n                                    <tr class="border-black o_total">\n                                        <td><strong>Total</strong></td>\n                                        <td class="text-right">\n                                            <span class="text-nowrap" t-field="o.amount_total"/>\n                                        </td>\n                                    </tr>\n                                    <t t-if="print_with_payments">\n                                        <tr>\n                                            <t t-set="pay" t-value="o.sudo()._get_reconciled_info_JSON_values()"/>\n                                            <t t-foreach="pay" t-as="pay">\n                                                <td>\n                                                    <strong>Dibayar (<span t-esc="pay['journal_name']"/>)</strong>\n                                                </td>\n                                                <td class="text-right">\n                                                        <span t-esc="pay['amount']" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: o.currency_id}"/>\n                                                </td>\n                                            </t>\n                                        </tr>\n                                        <t t-if="len(pay) &gt; 0">\n                                            <tr class="border-black">\n                                                <td><strong>Sisa Tagihan</strong></td>\n                                                <td class="text-right">\n                                                    <span t-field="o.amount_residual"/>\n                                                </td>\n                                            </tr>\n                                        </t>\n                                    </t>\n                                </table>\n                            </div>\n                        </div>\n                    </div>\n    \n                    <div class="mt-5" t-if="o.cashier.name" name="cashier">\n                        <div class="row py-0">\n                            <div class="col-9"/>\n                            <div class="col-3 py-0">\n                                <p class="mb-0"><span t-field="o.operating_unit_id.city"/>, <span t-esc="o.invoice_date.strftime('%d-%m-%Y')"/></p>\n                                <p>Kasir</p>\n                            </div>\n                        </div>\n                        <div class="row pt-5 mt-4">\n                            <div class="col-9"/>\n                            <div class="col-3 py-y">(   <span t-field="o.cashier.name"/>   )</div>\n                        </div>\n                    </div>\n    \n                    <p t-if="o.invoice_payment_term_id" name="payment_term">\n                        <span t-field="o.invoice_payment_term_id.note"/>\n                    </p>\n                    <p t-if="o.narration" name="comment">\n                        <span t-field="o.narration"/>\n                    </p>\n                    <p t-if="o.fiscal_position_id.note" name="note">\n                        <span t-field="o.fiscal_position_id.note"/>\n                    </p>\n                    <p t-if="o.invoice_incoterm_id" name="incoterm">\n                        <strong>Incoterm: </strong><span t-field="o.invoice_incoterm_id.code"/> - <span t-field="o.invoice_incoterm_id.name"/>\n                    </p>\n                    <div id="qrcode" t-if="o.display_qr_code">\n                        <p t-if="qr_code_urls.get(o.id)">\n                            <strong class="text-center">Scan me with your banking app.</strong><br/><br/>\n                            <img class="border border-dark rounded" t-att-src="qr_code_urls[o.id]"/>\n                        </p>\n                    </div>\n                    </div>\n            </t>\n        </t>\n    	ehealth_document/report/template_invoice/template_invoice_lis_medika.xml	\N	\N	\N	\N	primary	t	1	2025-08-28 11:34:01.364376	1	2025-08-28 11:34:01.364376	f
1513	template_invoice_wisra	\N	ehealth_document.template_invoice_wisra	16	qweb	<?xml version="1.0"?>\n<t t-name="ehealth_document.template_invoice_wisra">\n            <t t-set="company" t-value="res_company"/>\n            <t t-call="ehealth_optic.header_optik_wisra_document">\n                <t t-set="o" t-value="o.with_context(lang=lang)"/>\n                <t t-set="prescription" t-value="o.get_prescription_from_invoice()"/>\n                \n                <div class="page" style="font-size: 14px;!important">\n                    <div style="text-align: center;">\n                        <strong>INVOICE</strong>\n                        <p t-if="o.name != '/'" t-field="o.name"/>\n                    </div>\n\n                    <div class="row" style="margin-top: 36px">\n                        <div class="col-6">\n                            <div class="row">\n                                <div class="col-12">\n                                    <div class="row">\n                                        <div class="col-5">Nama Pasien</div>\n                                        <div class="col-0">:</div>\n                                        <div class="col-7"><t t-esc="o['partner_id']['name']"/></div>\n                                    </div>\n\n                                    <div class="row">\n                                        <div class="col-5">Umur</div>\n                                        <div class="col-0">:</div>\n                                        <div class="col-7"><t t-esc="o['partner_id']['age']"/></div>\n                                    </div>\n\n                                    <div class="row">\n                                        <div class="col-5">Nomor Kartu JKN</div>\n                                        <div class="col-0">:</div>\n                                        <div class="col-7"><t t-esc="o['partner_id']['jkn_number']"/></div>\n                                    </div>\n\n                                    <div class="row">\n                                        <div class="col-5">No HP</div>\n                                        <div class="col-0">:</div>\n                                        <div class="col-7"><t t-esc="o['partner_id']['phone']"/></div>\n                                    </div>\n\n                                    <div class="row">\n                                        <div class="col-5">Alamat</div>\n                                        <div class="col-0">:</div>\n                                        <div class="col-7"><t t-esc="o['partner_id']['contact_address']"/></div>\n                                    </div>\n                                </div>\n                                <div class="col-12">\n                                    <div class="row">\n                                        <div class="col-5">Asal Resep</div>\n                                        <div class="col-0">:</div>\n                                        <div class="col-7"><t t-esc="prescription.prescription_origin"/></div>\n                                    </div>\n\n                                    <div class="row">\n                                        <div class="col-5">Tanggal Pemesanan</div>\n                                        <div class="col-0">:</div>\n                                        <div class="col-7"><t t-esc="o['invoice_date']"/></div>\n                                    </div>\n                                </div>\n                            </div>\n                        </div>\n                    </div>\n                    \n                    <hr/>\n\n                    <div class="row" style="margin: 16px 0">\n                        <div class="col-4" style="padding: 0/">\n                            <strong>Invoice Date:</strong>\n                            <p><t t-esc="o['invoice_date']"/></p>\n                        </div>\n                        <div class="col-4">\n                            <strong>Due Date:</strong>\n                            <p><t t-esc="o['invoice_date_due']"/></p>\n                        </div>\n                        <div class="col-4">\n                            <strong>Payment Scheme:</strong>\n                            <p><t t-esc="o['partner_id']['patient_payment_category'].name"/></p>\n                        </div>\n                    </div>\n\n                    <table class="table table-sm o_main_table mt16" name="invoice_line_table">\n                        <thead>\n                            <tr>\n                                <th name="th_description" class="text-left"><span>Product</span></th>\n                                <th name="th_quantity" class="text-right"><span>Quantity</span></th>\n                                <th name="th_priceunit" t-attf-class="text-right {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}"><span>Unit Price</span></th>\n                                <th name="th_subtotal" class="text-right"><span groups="account.group_show_line_subtotals_tax_excluded">Amount</span></th>\n                            </tr>\n                        </thead>\n                        <tbody class="invoice_tbody">\n                            <t t-set="current_subtotal" t-value="0"/>\n                            <t t-set="lines" t-value="o.invoice_line_ids.sorted(key=lambda l: (-l.sequence, l.date, l.move_name, -l.id), reverse=True)"/>\n\n                            <t t-foreach="lines" t-as="line">\n                                <t t-set="current_subtotal" t-value="current_subtotal + line.price_subtotal" groups="account.group_show_line_subtotals_tax_excluded"/>\n                                <t t-set="current_subtotal" t-value="current_subtotal + line.price_total" groups="account.group_show_line_subtotals_tax_included"/>\n\n                                <tr t-att-class="'bg-200 font-weight-bold o_line_section' if line.display_type == 'line_section' else 'font-italic o_line_note' if line.display_type == 'line_note' else ''">\n                                    <t t-if="not line.display_type" name="account_invoice_line_accountable">\n                                        <td name="account_invoice_line_name"><span t-field="line.product_id.name" t-options="{'widget': 'text'}"/></td>\n                                        <td class="text-right">\n                                            <span t-esc="line['quantity']"/>\n                                            <span t-field="line.product_uom_id" groups="uom.group_uom"/>\n                                        </td>\n                                        <td t-attf-class="text-right {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}">\n                                            <span t-esc="round(line['price_unit'])"/>\n                                        </td>\n                                        <td t-if="display_discount" t-attf-class="text-right {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}">\n                                            <span class="text-nowrap" t-field="line.discount"/>\n                                        </td>\n                                        <td t-attf-class="text-left {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}" t-if="o.move_type == 'in_invoice'">\n                                            <span t-esc="', '.join(map(lambda x: (x.description or x.name), line.tax_ids))" id="line_tax_ids"/>\n                                        </td>\n                                        <td class="text-right o_price_total">\n                                            <span class="text-nowrap" t-field="line.price_subtotal" groups="account.group_show_line_subtotals_tax_excluded"/>\n                                            <span class="text-nowrap" t-field="line.price_total" groups="account.group_show_line_subtotals_tax_included"/>\n                                        </td>\n                                    </t>\n                                    <t t-if="line.display_type == 'line_section'">\n                                        <td colspan="99">\n                                            <span t-field="line.name" t-options="{'widget': 'text'}"/>\n                                        </td>\n                                        <t t-set="current_section" t-value="line"/>\n                                        <t t-set="current_subtotal" t-value="0"/>\n                                    </t>\n                                    <t t-if="line.display_type == 'line_note'">\n                                        <td colspan="99">\n                                            <span t-field="line.name" t-options="{'widget': 'text'}"/>\n                                        </td>\n                                    </t>\n                                </tr>\n\n                                <t t-if="current_section and (line_last or lines[line_index+1].display_type == 'line_section')">\n                                    <tr class="is-subtotal text-right">\n                                        <td colspan="99">\n                                            <strong class="mr16">Subtotal</strong>\n                                            <span t-esc="current_subtotal" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: o.currency_id}"/>\n                                        </td>\n                                    </tr>\n                                </t>\n                            </t>\n                        </tbody>\n                    </table>\n\n                    <div id="total" class="row clearfix">\n                        <div t-attf-class="#{'col-6' if report_type != 'html' else 'col-sm-7 col-md-6'} ml-auto">\n                            <table class="table table-sm" style="page-break-inside: avoid;">\n                                <tr class="border-black o_subtotal" style="">\n                                    <td><strong>Subtotal</strong></td>\n                                    <td class="text-right">\n                                        <span t-esc="o.amount_untaxed + o.total_discount" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: o.currency_id}"/>\n                                    </td>\n                                </tr>\n                                <t t-foreach="o.amount_by_group" t-as="amount_by_group">\n                                    <tr style="">\n                                        <t t-if="len(o.line_ids.filtered(lambda line: line.tax_line_id)) in [0, 1] and o.amount_untaxed == amount_by_group[2]">\n                                            <td><span class="text-nowrap" t-esc="amount_by_group[0]"/></td>\n                                            <td class="text-right o_price_total">\n                                                <span class="text-nowrap" t-esc="amount_by_group[3]"/>\n                                            </td>\n                                        </t>\n                                        <t t-else="">\n                                            <td>\n                                                <span t-esc="amount_by_group[0]"/>\n                                                <span class="text-nowrap"> on\n                                                    <t t-esc="amount_by_group[4]"/>\n                                                </span>\n                                            </td>\n                                            <td class="text-right o_price_total">\n                                                <span class="text-nowrap" t-esc="amount_by_group[3]"/>\n                                            </td>\n                                        </t>\n                                    </tr>\n                                </t>\n                                    <tr>\n                                        <td><strong>Diskon</strong></td>\n                                        <td class="text-right">\n                                            -<span t-field="o.total_discount"/>\n                                        </td>\n                                    </tr>\n                                    \n                                <t t-if="print_with_payments">\n                                    <t t-set="pay" t-value="o.sudo()._get_reconciled_info_JSON_values()"/>\n                                    <tr>\n                                        <t t-foreach="pay" t-as="pay">\n                                            <td>\n                                                <strong>Dibayar (<span t-esc="pay['journal_name']"/>)</strong>\n                                            </td>\n                                            <td class="text-right">\n                                                    <span t-esc="pay['amount']" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: o.currency_id}"/>\n                                            </td>\n                                        </t>\n                                    </tr>\n                                    <tr class="border-black o_total">\n                                        <td><strong>Total</strong></td>\n                                        <td class="text-right">\n                                            <span class="text-nowrap" t-field="o.amount_total"/>\n                                        </td>\n                                    </tr>\n                                    <!-- <tr>\n                                        <td><span class="font-italic">Paid on 10/11/2023</span></td>\n                                        <td class="text-right">\n                                            <span class="text-nowrap" t-field="o.amount_total"/>\n                                        </td>\n                                    </tr>\n                                    <tr>\n                                        <td><span class="font-italic">Paid on 10/11/2023</span></td>\n                                        <td class="text-right">\n                                            <span class="text-nowrap" t-field="o.amount_total"/>\n                                        </td>\n                                    </tr> -->\n                                    <t t-set="payments_vals" t-value="o.sudo()._get_reconciled_info_JSON_values()"/>\n                                    <t t-foreach="payments_vals" t-as="payment_vals">\n                                        <tr>\n                                            <td>\n                                                <i class="oe_form_field text-right oe_payment_label">Paid on <t t-esc="payment_vals['date']" t-options="{&quot;widget&quot;: &quot;date&quot;}"/></i>\n                                            </td>\n                                            <td class="text-right">\n                                                <span t-esc="payment_vals['amount']" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: o.currency_id}"/>\n                                            </td>\n                                        </tr>\n                                    </t>\n                                    <t t-if="len(pay) &gt; 0">\n                                        <tr class="border-black">\n                                            <td><strong>Amount Due</strong></td>\n                                            <td class="text-right">\n                                                <span t-field="o.amount_residual"/>\n                                            </td>\n                                        </tr>\n                                    </t>\n                                </t>\n                            </table>\n                        </div>\n                    </div>\n\n                    <p style="margin-top: 36px">Saya peserta BPJS/keluarga BPJS sesuai data di atas, bersedia untuk iur bayar atas produk dan jasa yang saya/keluarga saya terima/peroleh.</p>\n                    \n                    <div class="row mt-4">\n                        <div class="col-4">\n                            <p class="mb-0">Peserta/Keluarga Peserta BPJS</p>\n                            <div style="height:125px;"/>\n                            <p class="mb-0 mt-4">\n                                <t t-esc="o['partner_id']['name']"/>\n                            </p>\n                        </div>\n                        <div class="col-4"/>\n                        <div class="col-4">\n                            <p class="mb-0">Pihak/Petugas Optik</p>\n                            <div style="height:125px;"/>\n                            <p class="mb-0 mt-4">\n                                <t t-esc="prescription.refractionist.name"/>\n                            </p>\n                        </div>\n                    </div>\n\n                    <span style="padding: 4px 8px; display: inline-block;" class="border border-dark mt-5 font-italic">Note: Pesanan tidak diambil dalam jangka waktu 1 bulan, jika hilang bukan lagi tanggung jawab kami</span>\n                </div>\n            </t>\n        </t>\n    	ehealth_document/report/template_invoice/template_invoice_wisra.xml	\N	\N	\N	\N	primary	t	1	2025-08-28 11:34:01.364376	1	2025-08-28 11:34:01.364376	f
487	product.pricelist.form.inherit	product.pricelist	\N	16	form	<?xml version="1.0"?>\n<!-- When in advanced pricelist mode : pricelist rules\n                  Should open in a form view and not be editable inline anymore.\n                -->\n                <field name="item_ids" position="replace">\n                  <field name="item_ids" nolabel="1" context="{'default_base':'list_price'}" groups="product.group_product_pricelist">\n                      <tree string="Pricelist Items">\n                          <field name="name" string="Applicable On"/>\n                          <field name="min_quantity"/>\n                          <field name="price" string="Price"/>\n                          <field name="date_start"/>\n                          <field name="date_end"/>\n                          <field name="base" invisible="1"/>\n                          <field name="price_discount" invisible="1"/>\n                          <field name="applied_on" invisible="1"/>\n                          <field name="compute_price" invisible="1"/>\n                      </tree>\n                  </field>\n                </field>\n            	product/views/product_pricelist_views.xml	\N	\N	486	\N	extension	t	1	2025-08-28 11:32:18.663929	1	2025-08-28 11:32:18.663929	\N

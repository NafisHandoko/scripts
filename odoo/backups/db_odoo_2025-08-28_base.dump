                  </div>\n                    </t>\n                    <div class="row">\n                        <div class="col-3">Nama</div>\n                        <div class="col-6">: <strong><t t-esc="o['partner_id']['name']"/></strong></div>\n                    </div>\n                    <div class="row">\n                        <div class="col-3">Tanggal Lahir</div>\n                        <div class="col-6">: <t t-esc="o['partner_id']['birthDate'].strftime('%d-%m-%Y')"/></div>\n                    </div>\n                    <div class="row">\n                        <div class="col-3">Jenis Kelamin</div>\n                        <div class="col-6">: \n                          <t t-if="o['partner_id']['gender'] == 'male'">Laki-Laki</t>\n                          <t t-else="">Perempuan</t>\n                        </div>\n                    </div>\n                </div>\n\n                <p class="mt-3 mb-0"><strong>Riwayat keluhan:</strong></p>\n                <div class="mt-1"><t t-esc="data['anamnese-manual']"/></div>\n                <p class="mt-4 mb-0"><strong>Diagnosis sementara:</strong></p>\n                <div class="mt-1"><t t-esc="data['diagnosa-manual']"/></div>\n                <p class="mt-4 mb-0"><strong>Terapi yang telah diberikan:</strong></p>\n                <div class="mt-1"><t t-esc="data['terapi-manual']"/></div>\n\n                <p class="mt-4 mb-2">Demikian surat rujukan ini, atas kerjasama dan perhatian Teman Sejawat kami ucapkan terimakasih.</p><br/>\n              </div>\n            </div>\n\n            <div class="row pt-5">\n                <div class="col-1"/>\n                <div class="col-3 mt-4">\n                    <p class="mb-0">Validasi</p>\n                    <div class="mt-3" id="qrcode">\n                        <img t-att-src="o['qr_code_url']" style="width:125px;height:125px;"/>\n                    </div>\n                </div>\n                <div class="col-4"/>\n                <div class="col-4">\n                    <p class="mb-0"><t t-esc="o['operating_unit_id']['company_id']['city']"/>, <t t-esc="o.to_date_string(data['registration_date'])"/></p>\n                    <p class="mb-0">Salam Sejawat</p>\n                    <div class="mt-3" id="qrcode">\n                        <t t-if="'qr_code_examiner_url' in data">\n                          <img t-att-src="data['qr_code_examiner_url']" style="width:125px;height:125px;"/>\n                        </t>\n                        <t t-else="">\n                          <div style="width:125px;height:125px;"/>\n                        </t>\n                    </div>\n                    <p class="mb-0 mt-2"><strong>\n                    <t t-if="'examiner_name' in data">\n                      <t t-esc="data['examiner_name']"/>\n                    </t>\n                    <t t-else="">\n                      <t t-esc="data['sender']"/>\n                    </t>\n                    </strong></p>\n                </div>\n            </div>\n          </div>\n        </t>\n      </t>\n    	ehealth_document/report/template_surat_rujukan/report_esensia_surat_rujukan.xml	\N	\N	\N	\N	primary	t	1	2025-08-28 11:34:01.364376	1	2025-08-28 11:34:01.364376	f

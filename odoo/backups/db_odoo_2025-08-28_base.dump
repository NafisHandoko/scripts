550	sms.cancel.form	sms.cancel	\N	16	form	<?xml version="1.0"?>\n<form string="Cancel notification in failure">\n                <field name="model" invisible="1"/>\n                <field name="help_message"/>\n                <p>If you want to re-send them, click Cancel now, then click on the notification and review them one by one by clicking on the red icon next to each message.</p>\n                <footer>  \n                    <button string="Discard delivery failures" name="action_cancel" type="object" class="btn-primary"/>\n                    <button string="Cancel" class="btn-secondary" special="cancel"/>\n                </footer>\n            </form>\n        	sms/wizard/sms_cancel_views.xml	\N	\N	\N	\N	primary	t	1	2025-08-28 11:32:25.511275	1	2025-08-28 11:32:25.511275	f
548	Grant Portal Access	portal.wizard	\N	16	form	<?xml version="1.0"?>\n<form string="Grant Portal Access">\n                    <div>\n                        Select which contacts should belong to the portal in the list below.\n                        The email address of each selected contact must be valid and unique.\n                        If necessary, you can fix any contact's email address directly in the list.\n                    </div>\n                    <field name="user_ids">\n                        <tree string="Contacts" editable="bottom" create="false" delete="false">\n                            <field name="partner_id" force_save="1"/>\n                            <field name="email"/>\n                            <field name="in_portal"/>\n                        </tree>\n                    </field>\n                    <field name="welcome_message" placeholder="This text is included in the email sent to new portal users."/>\n                    <footer>\n                        <button string="Apply" name="action_apply" type="object" class="btn-primary"/>\n                        <button string="Cancel" class="btn-secondary" special="cancel"/>\n                    </footer>\n                </form>\n            	portal/wizard/portal_wizard_views.xml	\N	\N	\N	\N	primary	t	1	2025-08-28 11:32:23.971774	1	2025-08-28 11:32:23.971774	f
549	sh.product.form.view	product.template	\N	16	form	<?xml version="1.0"?>\n<data><field name="sale_ok" position="before">\n                <field name="sh_is_bundle"/>\n                <label for="sh_is_bundle" string="Is Bundled ?"/>\n                <div/>\n            </field>\n            <xpath expr="//div[@name='pricing']" position="after">\n                <button name="compute_bundle_price" string="Compute Bundle Sales Price" type="object" class="btn-primary" attrs="{'invisible':[('sh_is_bundle','=',False)]}"/>\n            </xpath>\n            \n            <field name="company_id" position="before">\n           \t\t<button name="compute_bundle_cost_price" string="Compute Bundle Cost Price" type="object" class="btn-primary" attrs="{'invisible':[('sh_is_bundle','=',False)]}"/>\n           \t</field>\n            <xpath expr="//notebook//page[last()]" position="after">\n                <page string="Pack/Bundle Products" attrs="{'invisible':[('sh_is_bundle','=',False)]}">\n                    <field name="sh_bundle_product_ids">\n                        <form string="Product Bundles"> \n                            <group>\n                                <group>\n                                    <field name="sh_product_id"/>\n                                    <field name="sh_qty"/>\n                                    <field name="sh_uom"/>\n                                    <field name="sh_cost_price"/>\n                                    <field name="sh_price_unit"/>\n                                    <field name="sh_price_subtotal" force_save="1"/>\n                                </group>\n                            </group>\n                        </form>\n                        <tree editable="bottom">\n                            <field name="sh_product_id" options="{'no_create_edit' : True, 'no_create': True}"/>\n                            <field name="sh_qty"/>\n                            <field name="sh_uom"/>\n                            <field name="sh_cost_price"/>\n                            <field name="sh_price_unit"/>\n                            <field name="sh_price_subtotal" force_save="1"/>\n                        </tree>\n                    </field>\n                    <group name="note_group" col="6">\n                        <group class="oe_subtotal_footer oe_right" colspan="2" name="pack_total">\n                            <field name="sh_amount_total" class="oe_subtotal_footer_separator" widget="monetary" options="{'currency_field': 'currency_id'}"/>\n                        </group>\n                        <div class="oe_clear"/>\n                    </group>\n                </page>\n            </xpath>\n        </data>	sh_base_bundle/views/sh_product_view.xml	\N	\N	456	\N	extension	t	1	2025-08-28 11:32:25.136338	1	2025-08-28 11:32:25.136338	f
1538	report_nsbeny_surat_sehat	\N	ehealth_document.report_nsbeny_surat_sehat	16	qweb	<?xml version="1.0"?>\n<t t-name="ehealth_document.report_nsbeny_surat_sehat">\n      <t t-set="company" t-value="res_company"/>\n      <t t-call="ehealth_document.header_nsbeny_document">\n        <div class="page">\n          <div class="row">\n            <div class="col-md-12">\n              <p class="text-center mt-3 mb-0">\n                <strong>SURAT KETERANGAN SEHAT JASMANI DAN ROHANI</strong>\n              </p>\n              <p class="text-center">Nomor: <t t-esc="o['name']"/></p>\n              <p class="mt-4">Yang bertanda tangan di bawah ini menerangkan bahwa:</p>\n              <div class="mt-3 ml-3">\n                <div class="row">\n                  <div class="col-3">\n                    <t t-if="o['partner_id']['identity_type'] == 'ktp'">NIK</t>\n                    <t t-if="o['partner_id']['identity_type'] == 'sim'">No. SIM</t>\n                    <t t-if="o['partner_id']['identity_type'] == 'paspor'">No. Paspor</t>\n                  </div>\n                  <div class="col-6">: <t t-if="o['partner_id']['identity_type'] == 'ktp'">\n                      <t t-esc="o['partner_id']['nik']"/>\n                    </t>\n                          <t t-else="">\n                      <t t-esc="o['partner_id']['identity_number']"/>\n                    </t>\n                  </div>\n                </div>\n                <div class="row">\n                  <div class="col-3">Nama</div>\n                  <div class="col-6">: <strong>\n                      <t t-esc="o['partner_id']['name']"/>\n                    </strong></div>\n                </div>\n                <div class="row">\n                  <div class="col-3">Tanggal Lahir</div>\n                  <div class="col-6">: <t t-esc="o['partner_id']['birthDate'].strftime('%d-%m-%Y')"/></div>\n                </div>\n                <div class="row">\n                  <div class="col-3">Jenis Kelamin</div>\n                  <div class="col-6">: <t t-if="o['partner_id']['gender'] == 'male'">Laki-Laki</t>\n                          <t t-else="">Perempuan</t>\n                  </div>\n                </div>\n                <div class="row">\n                  <div class="col-3">Pekerjaan</div>\n                  <div class="col-6">: <t t-esc="o['partner_id']['function']"/></div>\n                </div>\n                <div class="row">\n                  <div class="col-3">Alamat</div>\n                  <div class="col-6">: <t t-esc="o['partner_id']['street']"/></div>\n                </div>\n                <div class="row">\n                  <div class="col-3">Kesimpulan pada saat ini</div>\n                </div>\n                <div class="row">\n                  <div class="col-3 pl-5"> - Jasmani </div>\n                  <div class="col-6"> : <strong>SEHAT</strong>\n                  </div>\n                </div>\n                <div class="row ">\n                  <div class="col-3 pl-5"> - Rohani </div>\n                  <div class="col-6"> : <strong>SEHAT</strong>\n                  </div>\n                </div>\n                <div class="row">\n                  <div class="col-3">Keperluan Surat Sebagai </div>\n                  <div class="col-6">: <strong>\n                      <t t-esc="data['keperluan']"/>\n                    </strong></div>\n                </div>\n              </div>\n              <p>Demikian Surat Keterangan ini dibuat untuk dapat dipergunakan seperlunya.</p>\n              <br/>\n              <div class="row">\n                <div class="col-3">\n                  <p>\n                    <strong>Keterangan :</strong>\n                  </p>\n                </div>\n              </div>\n              <div class="row">\n                <div class="col-3">Tinggi Badan</div>\n                <div class="col-3">: <t t-esc="data['tinggi-badan']"/> cm</div>\n                <div class="col-3">Tekanan Darah</div>\n                <div class="col-3">: <t t-esc="data['sistole']"/>/<t t-esc="data['diastole']"/>\n                  mmHg</div>\n              </div>\n              <div class="row">\n                <div class="col-3">Berat Badan</div>\n                <div class="col-3">: <t t-esc="data['berat-badan']"/> kg</div>\n                <div class="col-3">Buta Warna</div>\n                <div class="col-3">: <t t-esc="data['buta-warna']"/></div>\n              </div>\n              <div class="row">\n                <div class="col-3">Visus</div>\n                <div class="col-3">: <t t-esc="data['visus']"/></div>\n                <div class="col-3"/>\n                <div class="col-3"/>\n              </div>\n            </div>\n          </div>\n\n          <div class="row pt-5">\n            <div class="col-1"/>\n            <div class="col-3 mt-4">\n              <div class="pt-5" id="qrcode">\n                <img t-att-src="o['qr_code_url']" style="width:125px;height:125px;"/>\n              </div>\n            </div>\n            <div class="col-4"/>\n            <div class="col-4">\n              <p class="mb-0">Ungaran, <t t-esc="o.to_date_string(data['registration_date'])"/></p>\n              <p class="mb-0">Pemeriksa</p>\n              <div class="mt-3" id="qrcode">\n                <div style="width:125px;height:125px;"/>\n              </div>\n              <p class="mb-0 mt-2">\n                <strong>\n                  Ns. Beny Hermawanto,S.Kep\n                </strong>\n              </p>\n            </div>\n          </div>\n        </div>\n      </t>\n    </t>\n  	ehealth_document/report/template_surat_sehat/report_nsbeny_surat_sehat.xml	\N	\N	\N	\N	primary	t	1	2025-08-28 11:34:01.364376	1	2025-08-28 11:34:01.364376	f

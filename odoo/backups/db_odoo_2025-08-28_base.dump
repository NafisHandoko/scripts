1573	report_diatrans_surat_kematian	\N	ehealth_document.report_diatrans_surat_kematian	16	qweb	<?xml version="1.0"?>\n<t t-name="ehealth_document.report_diatrans_surat_kematian">\n        <t t-set="company" t-value="res_company"/>\n        <t t-call="ehealth_document.header_diatrans_document">\n          <div class="page">\n            <div class="row">\n              <div class="col-md-12">\n                <p class="text-center mt-3 mb-0"><strong>SURAT KETERANGAN KEMATIAN</strong></p>\n                <p class="text-center">Nomor: <t t-esc="o['name']"/></p>\n                <p class="mt-4">Yang bertanda-tangan di bawah ini:</p>\n                <div class="mt-3 ml-3">\n                    <div class="row">\n                        <div class="col-3">Nama</div>\n                        <div class="col-6">: <t t-esc="data['nama-dokter']"/></div>\n                    </div>\n                    <div class="row">\n                        <div class="col-3">Jabatan</div>\n                        <div class="col-6">: dokter jaga Klinik Hemodialisa Yayasan Ginjal Diatrans Indonesia</div>\n                    </div>\n                </div>\n                <p class="mt-4">Dengan ini menyatakan bahwa:</p>\n                <div class="mt-3 ml-3">\n                    <div class="row">\n                        <div class="col-3">Nama</div>\n                        <div class="col-6">: <t t-esc="o['partner_id']['name']"/></div>\n                    </div>\n                    <div class="row">\n                        <div class="col-3">Jenis Kelamin</div>\n                        <div class="col-6">:\n                          <t t-if="o['partner_id']['gender'] == 'male'">Laki-Laki</t>\n                          <t t-else="">Perempuan</t>\n                        </div>\n                    </div>\n                    <div class="row">\n                        <div class="col-3">Umur</div>\n                        <div class="col-6">:  <t t-esc="o.count_age(o['partner_id']['birthDate'].strftime('%d/%m/%Y'))"/> Tahun</div>\n                    </div>\n                    <div class="row">\n                        <div class="col-3">Alamat</div>\n                        <div class="col-6">: <t t-esc="o['partner_id']['street']"/></div>\n                    </div>\n                </div>\n                <p class="mt-3 mb-2">Pasien hemodialisa di YGDI, telah meninggal dunia pada hari <t t-esc="o.get_day_name(data['tanggal-kematian'])"/>, <t t-esc="data['tanggal-kematian']"/>\n                waktu <t t-esc="data['waktu-kematian']"/> wib di klinik hemodialisa YGDI, dengan sebab kematian <t t-esc="data['penyebab-kematian']"/>\n                </p>\n                <p class="mt-3">Demikian surat keterangan ini dibuat untuk dipergunakan sebagaimana-mestinya.</p><br/>\n              </div>\n            </div>\n\n            <div class="row pt-5">\n                <div class="col-8"/>\n                <div class="col-4">\n                    <p class="mb-0">Jakarta, <t t-esc="o.to_date_string(data['registration_date'])"/></p>\n                    <p>Dokter Jaga</p>\n                    <div style="width:125px;height:125px;"/>\n                    <p class="mb-0 mt-2"><strong><t t-esc="data['nama-dokter']"/></strong></p>\n                </div>\n            </div>\n          </div>\n        </t>\n      </t>\n    	ehealth_document/report/template_surat_kematian/report_diatrans_surat_kematian.xml	\N	\N	\N	\N	primary	t	1	2025-08-28 11:34:01.364376	1	2025-08-28 11:34:01.364376	f

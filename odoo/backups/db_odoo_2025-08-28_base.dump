1164	Quotation: Sign and Pay mail notification template	\N	sale.mail_notification_paynow_online	16	qweb	<?xml version="1.0"?>\n<data inherit_id="mail.mail_notification_paynow" name="Quotation: Sign and Pay mail notification template">\n            <xpath expr="//t[@t-set='access_name']" position="after">\n                <t t-if="record._name == 'sale.order'">\n                    <t t-set="is_transaction_pending" t-value="record.get_portal_last_transaction().state == 'pending'"/>\n                    <t t-if="record.has_to_be_signed(include_draft=True)">\n                        <t t-if="record.has_to_be_paid()" t-set="access_name">\n                            <t t-if="is_transaction_pending">View Quotation</t>\n                            <t t-else="">Sign &amp; Pay Quotation</t>\n                        </t>\n                        <t t-else="" t-set="access_name">Accept &amp; Sign Quotation</t>\n                    </t>\n                    <t t-elif="record.has_to_be_paid(include_draft=True) and not is_transaction_pending">\n                        <t t-set="access_name">Accept &amp; Pay Quotation</t>\n                    </t>\n                    <t t-elif="record.state in ('draft', 'sent')">\n                        <t t-set="access_name">View Quotation</t>\n                    </t>\n                </t>\n            </xpath>\n        </data>\n\n        	sale/data/mail_data.xml	\N	\N	379	\N	extension	t	1	2025-08-28 11:33:25.849737	1	2025-08-28 11:33:25.849737	f
1165	Invoice Orders	sale.advance.payment.inv	\N	16	form	<?xml version="1.0"?>\n<form string="Invoice Sales Order">\n                    <p class="oe_grey">\n                        Invoices will be created in draft so that you can review\n                        them before validation.\n                    </p>\n                    <group>\n                        <field name="count" attrs="{'invisible': [('count','=', 1)]}" readonly="True"/>\n                        <field name="advance_payment_method" class="oe_inline" widget="radio" attrs="{'invisible': [('count','&gt;',1)]}"/>\n                        <field name="has_down_payments" invisible="1"/>\n                        <label for="deduct_down_payments" string="" attrs="{'invisible': ['|', ('has_down_payments', '=', False), ('advance_payment_method', '!=', 'delivered')]}"/>\n                        <div attrs="{'invisible': ['|', ('has_down_payments', '=', False), ('advance_payment_method', '!=', 'delivered')]}" id="down_payment_details">\n                            <field name="deduct_down_payments" nolabel="1"/>\n                            <label for="deduct_down_payments"/>\n                        </div>\n                        <field name="product_id" context="{'default_invoice_policy': 'order'}" class="oe_inline" invisible="1"/>\n                        <label for="amount" attrs="{'invisible': [('advance_payment_method', 'not in', ('fixed','percentage'))]}"/>\n                        <div attrs="{'invisible': [('advance_payment_method', 'not in', ('fixed','percentage'))]}" id="payment_method_details">\n                            <field name="currency_id" invisible="1"/>\n                            <field name="fixed_amount" attrs="{'required': [('advance_payment_method', '=', 'fixed')], 'invisible': [('advance_payment_method', '!=','fixed')]}" class="oe_inline"/>\n                            <field name="amount" attrs="{'required': [('advance_payment_method', '=', 'percentage')], 'invisible': [('advance_payment_method', '!=', 'percentage')]}" class="oe_inline"/>\n                            <span attrs="{'invisible': [('advance_payment_method', '!=', 'percentage')]}" class="oe_inline">%</span>\n                        </div>\n                        <field name="deposit_account_id" options="{'no_create': True}" class="oe_inline" attrs="{'invisible': ['|', ('advance_payment_method', 'not in', ('fixed', 'percentage')), ('product_id', '!=', False)]}" groups="account.group_account_manager"/>\n                        <field name="deposit_taxes_id" class="oe_inline" widget="many2many_tags" domain="[('type_tax_use','=','sale')]" attrs="{'invisible': ['|', ('advance_payment_method', 'not in', ('fixed', 'percentage')), ('product_id', '!=', False)]}"/>\n                    </group>\n                    <footer>\n                        <button name="create_invoices" id="create_invoice_open" string="Create and View Invoice" type="object" context="{'open_invoices': True}" class="btn-primary"/>\n                        <button name="create_invoices" id="create_invoice" string="Create Invoice" type="object"/>\n                        <button string="Cancel" class="btn-secondary" special="cancel"/>\n                    </footer>\n                </form>\n            	sale/wizard/sale_make_invoice_advance_views.xml	\N	\N	\N	\N	primary	t	1	2025-08-28 11:33:25.849737	1	2025-08-28 11:33:25.849737	f

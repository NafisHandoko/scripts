1574	report_default_informed_consent	\N	ehealth_document.report_default_informed_consent	16	qweb	<?xml version="1.0"?>\n<t t-name="ehealth_document.report_default_informed_consent">\n        <t t-set="company" t-value="res_company"/>\n        <t t-call="web.external_layout">\n          <t t-set="o" t-value="o.with_context(lang=lang)"/> \n          <div class="page">\n            <div class="row">\n              <div class="col-md-12">\n                <p class="text-center mt-3 mb-0"><strong>Surat Pernyataan Tindakan Medis</strong></p>\n                <p class="text-center">Nomor: <t t-esc="o['name']"/></p>\n                <p class="mt-3">Yang bertanda tangan di bawah ini, saya:</p>\n                <div class="mt-1 ml-3">\n                    <div class="row">\n                        <div class="col-3">Nama</div>\n                        <div class="col-6">: <strong><t t-esc="data['nama-pj']"/></strong></div>\n                    </div>\n                    <t t-if="'umur-pj' in data">\n                      <div class="row">\n                        <div class="col-3">Umur</div>\n                        <div class="col-6">: <t t-esc="data['umur-pj']"/></div>\n                      </div>\n                    </t>\n                    <t t-if="'tgl-lahir-pj' in data">\n                      <div class="row">\n                        <div class="col-3">Tanggal Lahir</div>\n                        <div class="col-6">: <t t-esc="data['tgl-lahir-pj']"/></div>\n                      </div>\n                    </t>\n                    <div class="row">\n                        <div class="col-3">Jenis Kelamin</div>\n                        <div class="col-6">:\n                          <t t-if="data['jenis-kelamin-pj'] == 'male'">Laki-Laki</t>\n                          <t t-else="">Perempuan</t>\n                        </div>\n                    </div>\n                    <t t-if="'relasi-pj' in data">\n                      <div class="row">\n                          <div class="col-3">Relasi dengan pasien</div>\n                           <div class="col-6">: <t t-esc="data['relasi-pj']"/></div>\n                      </div>\n                    </t>\n                </div>\n                <p>Dengan ini saya menyatakan dengan sesungguhnya telah memberikan</p>\n                <p class="mt-2 mb-2 text-center"><strong><t t-esc="data['jenis-consent']"/></strong></p>\n                <t t-if="'tujuan-consent' in data">\n                  <p>untuk dilakukan <t t-esc="data['tujuan-consent']"/> berupa</p>\n                </t>\n                <t t-else="">\n                  <p>untuk dilakukan pemeriksaan, pengobatan dan tindakan medis berupa</p>\n                </t>\n                <p class="mt-2 mb-2 text-center"><t t-esc="data['objek-consent']"/></p>\n                <t t-if="'catatan-consent' in data">\n                  <p>Dengan catatan</p>\n                  <p><t t-esc="data['catatan-consent']"/></p>\n                </t>\n                <p>terhadap <t t-esc="data['relasi-pj']"/> saya dengan identitas sebagai berikut: </p>\n                <div class="mt-3 ml-3">\n                    <div class="row">\n                        <div class="col-3">Nama</div>\n                        <div class="col-6">: <strong><t t-esc="o['partner_id']['name']"/></strong></div>\n                    </div>\n                    <div class="row">\n                        <div class="col-3">Tanggal Lahir</div>\n                        <div class="col-6">: <t t-esc="o['partner_id']['birthDate'].strftime('%d-%m-%Y')"/></div>\n                    </div>\n                    <div class="row">\n                        <div class="col-3">Jenis Kelamin</div>\n                        <div class="col-6">: \n                          <t t-if="o['partner_id']['gender'] == 'male'">Laki-Laki</t>\n                          <t t-else="">Perempuan</t>\n                        </div>\n                    </div>\n                    <div class="row">\n                        <div class="col-3">Alamat</div>\n                        <div class="col-6">: <t t-esc="o['partner_id']['street']"/></div>\n                    </div>\n                    <t t-if="'no-cm' in data">\n                        <div class="row">\n                            <div class="col-3">No. CM</div>\n                            <div class="col-6">: <t t-esc="data['no-cm']"/></div>\n                        </div>\n                    </t>\n                </div>\n                <p class="mt-3" style="page-break-inside: avoid; page-break-before: auto;">yang cara, manfaat dan tujuan serta resiko yang ditimbulkan dari pemeriksaan, pengobatan serta tindakan medis tersebut di atas telah dijelaskan oleh dokter dan saya telah mengerti sepenuhnya.</p>\n                <p>Demikian pernyataan ini saya buat dengan penuh kesadaran dan tanpa paksaan agar dapat dipergunakan sebagaimana mestinya.</p><br/>\n              </div>\n            </div>\n            <div class="row" style="page-break-inside: avoid; page-break-before: auto;">\n                <div class="col-4">\n                    <p class="pt-3 mb-2">Dokter yang Memberi Penjelasan</p>\n                  <!-- <img t-att-src="o['qr_code_url']" style="width:110px;height:110px;" /> -->\n                    <div style="width:110px;height:80px;">\n                      <t t-if="'practitioner' in data and data['practitioner'] and 'sign-img' in data['practitioner']">\n                        <img height="80" t-att-src="data['practitioner']['sign-img']"/>\n                      </t>\n                    </div>\n                    <p class="mb-0 mt-2">\n                      <strong>\n                        <t t-if="'dokter-pelaksana' in data">\n                          <t t-esc="data['dokter-pelaksana']"/>\n                        </t>\n                        <t t-else="">\n                          <t t-esc="data['sender']"/>\n                        </t>\n                      </strong>\n                    </p>\n                </div>\n                <div class="col-4"/>\n                <div class="col-4">\n                    <p class="mb-0"><t t-esc="o['operating_unit_id']['company_id']['city']"/>, <t t-esc="o.to_date_string(data['registration_date'])"/></p>\n                    <p class="mb-0">Yang Memberi Pernyataan</p>\n                    <t t-if="'sign-pj' in data">\n                      <div style="width:110px;height:80px;">\n                          <img height="80" t-att-src="data['sign-pj']"/>\n                        </div>\n                    </t>\n                    <p class="mb-0 mt-2"><strong><t t-esc="data['nama-pj']"/></strong></p>\n                </div>\n            </div>\n            <div class="row mt-3" style="page-break-inside: avoid; page-break-before: auto;">\n                <t t-if="'nama-saksi-1' in data">\n                  <div class="col-4">\n                    <p class="mb-0">Saksi 1</p>\n                    <div style="width:110px;height:80px;"/>\n                    <p class="mb-0 mt-2"><strong><t t-esc="o.arrange_signature(data['nama-saksi-1'])"/></strong></p>\n                  </div>\n                </t>\n                <t t-if="'nama-saksi-2' in data">\n                  <div class="col-4"/>\n                  <div class="col-4">\n                    <p class="mb-0">Saksi 2</p>\n                    <div style="width:110px;height:80px;"/>\n                    <p class="mb-0 mt-2"><strong><t t-esc="o.arrange_signature(data['nama-saksi-2'])"/></strong></p>\n                  </div>\n                </t>\n                <t t-if="'saksi' in data">\n                  <t t-foreach="data['saksi']" t-as="saksi">\n                    <div class="col-4">\n                        <p> Saksi\n                            <t t-esc="saksi['saksi-idx']"/>\n                        </p>\n                        <div style="width:110px;height:80px;">\n                          <img height="80" t-att-src="saksi['sign-img']"/>\n                        </div>\n                        <p class="mb-0 mt-2"><strong><t t-esc="o.arrange_signature(saksi['nama-saksi'])"/></strong></p>\n                    </div>\n                    <div class="col-4"/>\n                  </t>\n                </t>\n            </div>\n          </div>\n        </t>\n      </t>\n    	ehealth_document/report/template_informed_consent/report_default_informed_consent.xml	\N	\N	\N	\N	primary	t	1	2025-08-28 11:34:01.364376	1	2025-08-28 11:34:01.364376	f
1575	report_default_kki_informed_consent	\N	ehealth_document.report_default_kki_informed_consent	16	qweb	<?xml version="1.0"?>\n<t t-name="ehealth_document.report_default_kki_informed_consent">\n        <t t-set="company" t-value="res_company"/>\n        <t t-call="web.external_layout">\n          <t t-set="o" t-value="o.with_context(lang=lang)"/> \n          <div class="page" style="font-size:13px; line-height: 1.4;">\n            <div class="" style="">\n              <div class="">\n\n                <table style="width: 100%; margin: 0;" class="table table-bordered table-sm">\n                  <thead><tr><th colspan="4" style="text-align: center;"><strong>PEMBERIAN INFORMASI</strong></th></tr></thead>\n                  <tbody>\n                    <tr>\n                      <td style="width: 224px;" colspan="2">Nama &amp; Jabatan Pemberi Informasi</td>\n                      <td style="width: 493px; padding-left: 5px; margin: 0;" colspan="2">\n                        <t t-if="'dokter-pelaksana' in data">\n                          <!-- <span><t t-esc="data['dokter-pelaksana']"/></span> -->\n                          <span>Tester</span>\n                        </t>\n                      </td>\n                    </tr>\n                    <tr>\n                      <td style="width: 224px;" colspan="2">Nama Pasien</td>\n                      <td style="width: 493px; padding-left: 5px; margin: 0;" colspan="2">\n                        <span><t t-esc="o['partner_id']['name']"/> </span>\n                      </td>\n                    </tr>\n                    <tr>\n                      <td style="width: 224px;" colspan="2">Nomor Rekam Medis</td>\n                      <td style="width: 493px; padding-left: 5px; margin: 0;" colspan="2">\n                        <t t-if="'no-cm' in data">\n                          <span><t t-esc="data['no-cm']"/></span>\n                        </t>\n                      </td>\n                    </tr>\n                    <tr>\n                      <td style="width: 224px;" colspan="2">Tempat/Tanggal Lahir</td>\n                      <td style="width: 493px; padding-left: 5px; margin: 0;" colspan="2">\n                        <span> <t t-esc="o['partner_id']['birth_place']"/></span>,\n                        <span> <t t-esc="o['partner_id']['birthDate'].strftime('%d-%m-%Y')"/></span>\n                        (<span> <t t-esc="o.count_age(o['partner_id']['birthDate'].strftime('%d/%m/%Y'))"/></span> Tahun)\n                      </td>\n                    </tr>\n                    <tr>\n                      <td style="width: 224px;" colspan="2">Jenis Kelamin</td>\n                      <td style="width: 493px; padding-left: 5px; margin: 0;" colspan="2">\n                        <span><t t-if="o['partner_id']['gender'] == 'male'">Laki-Laki</t><t t-else="">Perempuan</t></span>\n                      </td>\n                    </tr>\n                    <tr>\n                      <td style="width: 224px;" colspan="2">Alamat Pasien</td>\n                      <td style="width: 493px; padding-left: 5px; margin: 0;" colspan="2">\n                        <span><t t-esc="o['partner_id']['street']"/> </span>\n                      </td>\n                    </tr>\n\n                    <tr><td colspan="4" style="text-align: center;"><strong>Jika penerima informasi bukan pasien**, lengkapi isian pada dua kolom di bawah </strong></td></tr>\n                    <tr>\n                      <td style="width: 224px;" colspan="2">Nama Penerima Informasi</td>\n                      <td style="width: 493px; padding-left: 5px; margin: 0;" colspan="2">\n                        <t t-if="'nama-pj' in data">\n                          <span><t t-esc="data['nama-pj']"/></span>\n                        </t>\n                      </td>\n                    </tr>\n                    <tr>\n                      <td style="width: 224px;" colspan="2">Hubungan dengan Pasien</td>\n                      <td style="width: 493px; padding-left: 5px; margin: 0;" colspan="2">\n                        <t t-if="'relasi-pj' in data">\n                          <span><t t-esc="data['relasi-pj']"/></span>\n                        </t>\n                      </td>\n                    </tr>\n                    \n                    <tr style="height: 23px;">\n                      <td style="width: 15px; height: 23px; text-align: center;"><strong>No</strong></td>\n                      <td style="width: 209px; height: 23px; text-align: center;"><strong>JENIS INFORMASI</strong></td>\n                      <td style="width: 493px; height: 23px; text-align: center;"><strong>ISI INFORMASI</strong></td>\n                      <td style="width: 90px; height: 23px; text-align: center;"><strong>Verifikasi</strong></td>\n                    </tr>\n                    <tr style="height: 23px;">\n                      <td style="width: 15px; height: 23px;">1</td>\n                      <td style="width: 209px; height: 23px;">Diagnosis (WD &amp; DD)</td>\n                      <td style="width: 493px; height: 23.5px; padding-left: 5px; margin: 0;">\n                        <t t-if="'diagnosis' in data">\n                          <span><t t-esc="data['diagnosis']"/></span>\n                        </t>\n                      </td>\n                      <td style="width: 90px; height: 23px; text-align: center;">\n                        <span><t t-if="'diagnosis' in data"><b>✓</b></t></span>\n                      </td>\n                    </tr>\n                    <tr style="height: 23px;">\n                      <td style="width: 15px; height: 23px;">2</td>\n                      <td style="width: 209px; height: 23px;">Dasar Diagnosis</td>\n                      <td style="width: 493px; height: 23px; padding-left: 5px; margin: 0;">\n                        <t t-if="'dasar-diagnosis' in data">\n                          <span><t t-esc="data['dasar-diagnosis']"/></span>\n                        </t>\n                      </td>\n                      <td style="width: 90px; height: 23px; text-align: center;">\n                        <span><t t-if="'dasar-diagnosis' in data"><b>✓</b></t></span>\n                      </td>\n                    </tr>\n                    <tr style="height: 23px;">\n                      <td style="width: 15px; height: 23px;">3</td>\n                      <td style="width: 209px; height: 23px;">Tindakan Kedokteran</td>\n                      <td style="width: 493px; height: 23px; padding-left: 5px; margin: 0;">\n                        <t t-if="'tindakan-kedokteran' in data">\n                          <span><t t-esc="data['tindakan-kedokteran']"/></span>\n                        </t>\n                      </td>\n                      <td style="width: 90px; height: 23px; text-align: center;">\n                        <span><t t-if="'tindakan-kedokteran' in data"><b>✓</b></t></span>\n                      </td>\n                    </tr>\n                    <tr style="height: 23px;">\n                      <td style="width: 15px; height: 23px;">4</td>\n                      <td style="width: 209px; height: 23px;">Indikasi Tindakan</td>\n                      <td style="width: 493px; height: 23px; padding-left: 5px; margin: 0;">\n                        <t t-if="'indikasi-tindakan' in data">\n                          <span><t t-esc="data['indikasi-tindakan']"/></span>\n                        </t>\n                      </td>\n                      <td style="width: 90px; height: 23px; text-align: center;">\n                        <span><t t-if="'indikasi-tindakan' in data"><b>✓</b></t></span>\n                      </td>\n                    </tr>\n                    <tr style="height: 23px;">\n                      <td style="width: 15px; height: 23px;">5</td>\n                      <td style="width: 209px; height: 23px;">Tata Cara</td>\n                      <td style="width: 493px; height: 23px; padding-left: 5px; margin: 0;">\n                        <t t-if="'tata-cara' in data">\n                          <span><t t-esc="data['tata-cara']"/></span>\n                        </t>\n                      </td>\n                      <td style="width: 90px; height: 23px; text-align: center;">\n                        <span><t t-if="'tata-cara' in data"><b>✓</b></t></span>\n                      </td>\n                    </tr>\n                    <tr style="height: 23px;">\n                      <td style="width: 15px; height: 23px;">6</td>\n                      <td style="width: 209px; height: 23px;">Tujuan</td>\n                      <td style="width: 493px; height: 23px; padding-left: 5px; margin: 0;">\n                        <t t-if="'tujuan' in data">\n                          <span><t t-esc="data['tujuan']"/></span>\n                        </t>\n                      </td>\n                      <td style="width: 90px; height: 23px; text-align: center;">\n                        <span><t t-if="'tujuan' in data"><b>✓</b></t></span>\n                      </td>\n                    </tr>\n                    <tr style="height: 23px;">\n                      <td style="width: 15px; height: 23px;">7</td>\n                      <td style="width: 209px; height: 23px;">Risiko</td>\n                      <td style="width: 493px; height: 23px; padding-left: 5px; margin: 0;">\n                        <t t-if="'risiko' in data">\n                          <span><t t-esc="data['risiko']"/></span>\n                        </t>\n                      </td>\n                      <td style="width: 90px; height: 23px; text-align: center;">\n                        <span><t t-if="'risiko' in data"><b>✓</b></t></span>\n                      </td>\n                    </tr>\n                    <tr style="height: 23px;">\n                      <td style="width: 15px; height: 23px;">8</td>\n                      <td style="width: 209px; height: 23px;">Komplikasi</td>\n                      <td style="width: 493px; height: 23px; padding-left: 5px; margin: 0;">\n                        <t t-if="'komplikasi' in data">\n                          <span><t t-esc="data['komplikasi']"/></span>\n                        </t>\n                      </td>\n                      <td style="width: 90px; height: 23px; text-align: center;">\n                        <span><t t-if="'komplikasi' in data"><b>✓</b></t></span>\n                      </td>\n                    </tr>\n                    <tr style="height: 23px;">\n                      <td style="width: 15px; height: 23px;">9</td>\n                      <td style="width: 209px; height: 23px;">Prognosis</td>\n                      <td style="width: 493px; height: 23px; padding-left: 5px; margin: 0;">\n                        <t t-if="'prognosis' in data">\n                          <span><t t-esc="data['prognosis']"/></span>\n                        </t>\n                      </td>\n                      <td style="width: 90px; height: 23px; text-align: center;">\n                        <span><t t-if="'prognosis' in data"><b>✓</b></t></span>\n                      </td>\n                    </tr>\n                    <tr style="height: 23px;">\n                      <td style="width: 15px; height: 23px;">10</td>\n                      <td style="width: 209px; height: 23px;">Alternatif &amp; Risiko</td>\n                      <td style="width: 493px; height: 23px; padding-left: 5px; margin: 0;">\n                        <t t-if="'alternatif-risiko' in data">\n                          <span><t t-esc="data['alternatif-risiko']"/></span>\n                        </t>\n                      </td>\n                      <td style="width: 90px; height: 23px; text-align: center;">\n                        <span><t t-if="'alternatif-risiko' in data"><b>✓</b></t></span>\n                      </td>\n                    </tr>\n                    <tr style="height: 23px;">\n                      <td style="width: 15px; height: 23px;">11</td>\n                      <td style="width: 209px; height: 23px;">Lain-lain</td>\n                      <td style="width: 493px; height: 23px; padding-left: 5px; margin: 0;">\n                        <t t-if="'lain-lain' in data">\n                          <span><t t-esc="data['lain-lain']"/></span>\n                        </t>\n                      </td>\n                      <td style="width: 90px; height: 23px; text-align: center;">\n                        <span><t t-if="'lain-lain' in data"><b>✓</b></t></span>\n                      </td>\n                    </tr>\n                    <tr style="height: 23px;">\n                      <td style="width: 15px; height: 23px;"/>\n                      <td style="width: 209px; height: 23px;"/>\n                      <td colspan="2" style="text-align: right;">\n                        <span style="margin-right: 10px;">\n                          Lokasi : <t t-esc="o['operating_unit_id']['company_id']['city']"/>, Tanggal : <t t-esc="o.to_date_string(data['registration_date'])"/>, Pukul :  <t t-esc="o.to_time_string(data['registration_date'])"/>\n                        </span>\n                      </td>\n                    </tr>\n                  </tbody>\n                </table>\n\n                <table style="width: 100%; margin: 0;" class="table table-bordered table-sm">\n                  <tbody>\n                    <tr>\n                      <td rowspan="2" style="width: 75%; vertical-align: middle;">\n                        Dengan ini menyatakan bahwa saya telah menerangkan hal-hal di atas secara benar dan jelas dan memberikan kesempatan untuk bertanya dan/atau berdiskusi\n                      </td>\n                      <td style="width: 25%; text-align: center;">\n                        Tanda Tangan Dokter:\n                      </td>\n                    </tr>\n                    <tr>\n                      <td>\n                        <div style="width:110px;height:80px; margin: auto;">\n                          <t t-if="'practitioner' in data">\n                            <t t-if="'practitioner' in data and data['practitioner'] and 'sign-img' in data['practitioner']">\n                                <img t-att-src="data['practitioner']['sign-img']" alt="Logo" height="80"/>\n                            </t>\n                          </t>\n                          <t t-else=""/>\n                        </div>\n                      </td>\n                    </tr>\n                    <tr>\n                      <td rowspan="2" style="width: 75%; vertical-align: middle;">\n                        Dengan ini menyatakan bahwa saya telah menerima informasi sebagaimana di atas yang saya beri tanda √ / paraf di kolom kanannya, dan telah memahaminya\n                      </td>\n                      <td style="width: 25%; text-align: center;">\n                        Tanda Tangan Pasien/Wali Pasien:\n                      </td>\n                    </tr>\n                    <tr>\n                      <td>\n                        <t t-if="'sign-pj' in data">\n                          <div style="width:110px;height:80px; margin: auto;">\n                            <img height="80" t-att-src="data['sign-pj']"/>\n                          </div>\n                        </t>\n                      </td>\n                    </tr>\n                  </tbody>\n                </table>\n\n                <div style="page-break-after: always; break-after: always;"> </div>\n\n                <table style="width: 100%; margin: 0;" class="table table-bordered table-sm">\n                  <tbody>\n                    <tr><td style="text-align: center;"><strong>PERSETUJUAN PROSEDUR TINDAKAN MEDIS (CONSENT)</strong></td></tr>\n                    <tr>\n                      <td>\n                        <div class="row mb-1" style="margin: 0px;">Yang bertanda tangan di bawah ini: </div>\n                        <div class="row mb-1">\n                          <div class="col-3">Nama </div>\n                          <div class="col-4">: <t t-if="'nama-pj' in data"> <span><t t-esc="data['nama-pj']"/></span></t> </div>\n                          <div class="col-4"><span><t t-if="o['partner_id']['gender'] == 'male'">Laki-Laki</t><t t-else="">Perempuan</t></span></div>\n                        </div>\n                        <div class="row mb-1">\n                          <div class="col-3">No. KTP/SIM/PASPOR  </div>\n                          <div class="col-4">: <t t-if="'identifier-pj' in data"> <span><t t-esc="data['identifier-pj']"/></span></t></div>\n                          <div class="col-2">Tgl Lahir/Umur</div>\n                          <div class="col-3">:\n                            <t t-if="'tgl-lahir-pj' in data">\n                              <t t-esc="data['tgl-lahir-pj']"/>\n                              ( <t t-esc="o.count_age(data['tgl-lahir-pj'].replace('-', '/'))"/> Th )\n                            </t>\n                          </div>\n                        </div>\n                        <div class="row mb-1">\n                          <div class="col-3">Alamat Pasien  </div>\n                          <div class="col-4">: <span style="margin-right: 15px;"><span><t t-esc="o['partner_id']['street']"/> </span></span></div>\n                          <div class="col-2">Telepon</div>\n                          <div class="col-3">: <t t-if="'telepon-pj' in data"> <span><t t-esc="data['telepon-pj']"/></span></t></div>\n                        </div>\n                      </td>\n                    </tr>\n                    <tr>\n                      <td>\n                        <div class="row mb-1">\n                          <div class="col-3">Hubungan dengan pasien</div>\n                          <div class="col-8">: \n                            <t t-if="'relasi-pj' in data">\n                              <span><t t-esc="data['relasi-pj']"/></span>\n                            </t>\n                          </div>\n                        </div>\n                      </td>\n                    </tr>\n                    <tr>\n                      <td>\n                        <div class="row mb-1">\n                          <div class="col-1"/>\n                          <div class="col-11">Dengan ini menyatakan sesungguhnya, bahwa saya telah menerima informasi yang diberikan oleh dokter sebagaimana di atas dan telah memahaminya. Untuk itu saya memberikan \n                            <t t-if="'jenis-consent' in data and data['jenis-consent'] == 'Persetujuan'">\n                              PERSETUJUAN / <span style="text-decoration: line-through;">PENOLAKAN </span>\n                            </t>\n                            <t t-if="'jenis-consent' in data and data['jenis-consent'] == 'Penolakan'">\n                              <span style="text-decoration: line-through;">PERSETUJUAN</span> / PENOLAKAN \n                            </t>\n                          *  untuk dilakukan tindakan tersebut terhadap : \n                          </div>\n                        </div>\n                        <div class="row mb-1">\n                          <div class="col-3">Nama </div>\n                          <div class="col-4">: <t t-esc="o['partner_id']['name']"/> </div>\n                          <div class="col-4"><span><t t-if="o['partner_id']['gender'] == 'male'">Laki-Laki</t><t t-else="">Perempuan</t></span></div>\n                        </div>\n                        <div class="row mb-1">\n                          <div class="col-3">No. Rekam Medis  </div>\n                          <div class="col-4">: <t t-if="'no-cm' in data"><t t-esc="data['no-cm']"/></t><t t-else="">-</t></div>\n                          <div class="col-2">Tgl Lahir/Umur</div>\n                          <div class="col-3">: \n                            <t t-esc="o['partner_id']['birthDate'].strftime('%d-%m-%Y')"/>  \n                            ( <t t-esc="o.count_age(o['partner_id']['birthDate'].strftime('%d/%m/%Y'))"/> Th )\n                          </div>\n                        </div>\n                        <div class="row mb-1">\n                          <div class="col-3">Alamat Pasien  </div>\n                          <div class="col-8">: <span><span><t t-esc="o['partner_id']['street']"/> </span></span> </div>\n                        </div>\n                        <div class="row mb-1">\n                          <div class="col-1"/>\n                          <div class="col-11">Saya memahami perlunya dan manfaat tindakan tersebut termasuk risiko dan komplikasi yang akan timbul. Saya juga menyadari bahwa ilmu kedokteran bukanlah ilmu pasti, maka keberhasilan tindakan kedokteran bukanlah keniscayaan, melainkan tergantung Tuhan YME\n                          </div>\n                        </div>\n                      </td>\n                    </tr>\n                    <tr>\n                      <td style="text-align: right;">\n                        <span style="margin-right: 10px;">\n                          Lokasi : <t t-esc="o['operating_unit_id']['company_id']['city']"/>, Tanggal : <t t-esc="o.to_date_string(data['registration_date'])"/>, Pukul :  <t t-esc="o.to_time_string(data['registration_date'])"/>                        </span>\n                      </td>\n                    </tr>\n                    <tr>\n                      <td>\n                        <div class="row mt-2" style="page-break-inside: avoid; page-break-before: auto; width: 100%;">\n                          <div class="col-3 text-center">\n                            <div class="mb-1">Yang Menyatakan </div>\n                            <t t-if="'sign-pj' in data">\n                              <div style="width:110px;height:80px; margin: auto;">\n                                  <img height="80" t-att-src="data['sign-pj']"/>\n                                </div>\n                            </t>\n                            <div class="mt-2"><strong>( <t t-esc="data['nama-pj']"/> )</strong></div>\n                          </div>\n                          <div class="col-3 text-center"> \n                            <div class="mb-1">Dokter</div>\n                              <div style="width:110px;height:80px; margin: auto;">\n                                <t t-if="'practitioner' in data">\n                                  <t t-if="'practitioner' in data and data['practitioner'] and 'sign-img' in data['practitioner']">          \n                                    <img height="80" t-att-src="data['practitioner']['sign-img']"/>\n                                  </t>\n                                </t>\n                                <t t-else="">\n                                  <t t-if="'dokter-pelaksana' in data and data['dokter-pelaksana'] in 'Dr. dr. Tirta Darmawan Susanto, Mkes FSASS'">\n                                    <img t-att-src="'/ehealth_document/static/src/img/signature/signature-wellclinic-dr-tirta.png'" style="max-height: 125px;" alt="Logo"/>\n                                  </t>\n                                  <t t-if="'dokter-pelaksana' in data and data['dokter-pelaksana'] in 'dr. Steve Emmanuel'">\n                                    <img t-att-src="'/ehealth_document/static/src/img/signature/signature-wellclinic-dr-steve.png'" style="max-height: 125px;" alt="Logo"/>\n                                  </t>\n                                  <t t-if="'dokter-pelaksana' in data and data['dokter-pelaksana'] in 'dr. Catherine Ranatan'">\n                                    <img t-att-src="'/ehealth_document/static/src/img/signature/signature-wellclinic-dr-catherine.png'" style="max-height: 125px;" alt="Logo"/>\n                                  </t>\n                                </t>\n                              </div>\n                            <div class="mt-2"><strong>( <t t-esc="data['dokter-pelaksana']"/> )</strong> </div>\n                          </div>\n                          <t t-if="'saksi' in data">\n                            <t t-foreach="data['saksi']" t-as="saksi">\n                              <div class="col-3 text-center">\n                                  <div class="mb-1"> Saksi <t t-esc="saksi['saksi-idx']"/></div>\n                                  <t t-if="'sign-img' in saksi">\n                                    <div style="width:110px;height:80px; margin: auto;">\n                                      <img height="80" t-att-src="saksi['sign-img']"/>\n                                    </div>\n                                  </t>\n                                  <p class="mb-0 mt-2"><strong>( <t t-esc="saksi['nama-saksi']"/> )</strong></p>\n                              </div>\n                            </t>\n                          </t>\n                        </div>\n                        <div class="row mt-2" style="margin: 0px;">\n                          ** Bila pasien tidak kompeten atau tidak mau menerima informasi, maka penerima informasi adalah wali atau keluarga terdekat (suami, istri, ayah/ibu kandung, kakak/adik kandung, anak kandung)\t\t\t\t\n                        </div>\n                        <div class="row" style="margin: 0px;">\n                          * Coret pada pernyataan yang tidak sesuai\t\t\t\n                        </div>\n                      </td>\n                    </tr>\n                    \n                  </tbody>\n                </table>\n                \n              </div>\n            </div>\n          </div>\n        </t>\n      </t>\n    	ehealth_document/report/template_informed_consent/report_default_kki_informed_consent.xml	\N	\N	\N	\N	primary	t	1	2025-08-28 11:34:01.364376	1	2025-08-28 11:34:01.364376	f
1577	report_sahabatkeluarga_informed_consent	\N	ehealth_document.report_sahabatkeluarga_informed_consent	16	qweb	<?xml version="1.0"?>\n<t t-name="ehealth_document.report_sahabatkeluarga_informed_consent">\n        <t t-set="company" t-value="res_company"/>\n        <t t-call="ehealth_document.header_sahabatkeluarga_document">\n          <div class="page" style="font-size:13px; line-height: 1.4;">\n            <div class="" style="">\n              <div class="">\n\n                <table style="width: 100%; margin: 0;" class="table table-bordered table-sm">\n                  <thead><tr><th colspan="4" style="text-align: center;"><strong>PEMBERIAN INFORMASI</strong></th></tr></thead>\n                  <tbody>\n                    <tr>\n                      <td style="width: 224px;" colspan="2">Pelaksana Tindakan</td>\n                      <td style="width: 493px; padding-left: 5px; margin: 0;" colspan="2">\n                        <t t-if="'dokter-pelaksana' in data">\n                          <span><t t-esc="data['dokter-pelaksana']"/></span>\n                        </t>\n                      </td>\n                    </tr>\n                    <tr>\n                      <td style="width: 224px;" colspan="2">Pemberi Informasi</td>\n                      <td style="width: 493px; padding-left: 5px; margin: 0;" colspan="2">\n                        <t t-if="'pemberi-informasi' in data">\n                          <span><t t-esc="data['pemberi-informasi']"/></span>\n                        </t>\n                      </td>\n                    </tr>\n                    <tr>\n                      <td style="width: 224px;" colspan="2">Penerima Informasi / Pemberi Persetujuan</td>\n                      <td style="width: 493px; padding-left: 5px; margin: 0;" colspan="2">\n                        <span><t t-esc="o['partner_id']['name']"/> </span>\n                      </td>\n                    </tr>\n                    <tr>\n                      <td style="width: 224px;" colspan="2">Diberikan pada tanggal/jam</td>\n                      <td style="width: 493px; padding-left: 5px; margin: 0;" colspan="2">\n                        <span> <t t-esc="o.to_date_string(data['registration_date'])"/> /  <t t-esc="o.to_time_string(data['registration_date'])"/></span>\n                      </td>\n                    </tr>\n                    \n                    <tr style="height: 23px;">\n                      <td style="width: 15px; height: 23px; text-align: center;"><strong>No</strong></td>\n                      <td style="width: 209px; height: 23px; text-align: center;"><strong>JENIS INFORMASI</strong></td>\n                      <td style="width: 493px; height: 23px; text-align: center;"><strong>ISI INFORMASI</strong></td>\n                      <td style="width: 90px; height: 23px; text-align: center;"><strong>Tandai (✓)</strong></td>\n                    </tr>\n                    <tr style="height: 23px;">\n                      <td style="width: 15px; height: 23px;">1</td>\n                      <td style="width: 209px; height: 23px;">Diagnosis (WD &amp; DD)</td>\n                      <td style="width: 493px; height: 23.5px; padding-left: 5px; margin: 0;">\n                        <t t-if="'diagnosis' in data">\n                          <span><t t-esc="data['diagnosis']"/></span>\n                        </t>\n                      </td>\n                      <td style="width: 90px; height: 23px; text-align: center;">\n                        <span><t t-if="'diagnosis' in data"><b>✓</b></t></span>\n                      </td>\n                    </tr>\n                    <tr style="height: 23px;">\n                      <td style="width: 15px; height: 23px;">2</td>\n                      <td style="width: 209px; height: 23px;">Dasar Diagnosis</td>\n                      <td style="width: 493px; height: 23px; padding-left: 5px; margin: 0;">\n                        <t t-if="'dasar-diagnosis' in data">\n                          <span><t t-esc="data['dasar-diagnosis']"/></span>\n                        </t>\n                      </td>\n                      <td style="width: 90px; height: 23px; text-align: center;">\n                        <span><t t-if="'dasar-diagnosis' in data"><b>✓</b></t></span>\n                      </td>\n                    </tr>\n                    <tr style="height: 23px;">\n                      <td style="width: 15px; height: 23px;">3</td>\n                      <td style="width: 209px; height: 23px;">Tindakan Kedokteran</td>\n                      <td style="width: 493px; height: 23px; padding-left: 5px; margin: 0;">\n                        <t t-if="'tindakan-kedokteran' in data">\n                          <span><t t-esc="data['tindakan-kedokteran']"/></span>\n                        </t>\n                      </td>\n                      <td style="width: 90px; height: 23px; text-align: center;">\n                        <span><t t-if="'tindakan-kedokteran' in data"><b>✓</b></t></span>\n                      </td>\n                    </tr>\n                    <tr style="height: 23px;">\n                      <td style="width: 15px; height: 23px;">4</td>\n                      <td style="width: 209px; height: 23px;">Indikasi Tindakan</td>\n                      <td style="width: 493px; height: 23px; padding-left: 5px; margin: 0;">\n                        <t t-if="'indikasi-tindakan' in data">\n                          <span><t t-esc="data['indikasi-tindakan']"/></span>\n                        </t>\n                      </td>\n                      <td style="width: 90px; height: 23px; text-align: center;">\n                        <span><t t-if="'indikasi-tindakan' in data"><b>✓</b></t></span>\n                      </td>\n                    </tr>\n                    <tr style="height: 23px;">\n                      <td style="width: 15px; height: 23px;">5</td>\n                      <td style="width: 209px; height: 23px;">Tata Cara</td>\n                      <td style="width: 493px; height: 23px; padding-left: 5px; margin: 0;">\n                        <t t-if="'tata-cara' in data">\n                          <span><t t-esc="data['tata-cara']"/></span>\n                        </t>\n                      </td>\n                      <td style="width: 90px; height: 23px; text-align: center;">\n                        <span><t t-if="'tata-cara' in data"><b>✓</b></t></span>\n                      </td>\n                    </tr>\n                    <tr style="height: 23px;">\n                      <td style="width: 15px; height: 23px;">6</td>\n                      <td style="width: 209px; height: 23px;">Tujuan</td>\n                      <td style="width: 493px; height: 23px; padding-left: 5px; margin: 0;">\n                        <t t-if="'tujuan' in data">\n                          <span><t t-esc="data['tujuan']"/></span>\n                        </t>\n                      </td>\n                      <td style="width: 90px; height: 23px; text-align: center;">\n                        <span><t t-if="'tujuan' in data"><b>✓</b></t></span>\n                      </td>\n                    </tr>\n                    <tr style="height: 23px;">\n                      <td style="width: 15px; height: 23px;">7</td>\n                      <td style="width: 209px; height: 23px;">Risiko</td>\n                      <td style="width: 493px; height: 23px; padding-left: 5px; margin: 0;">\n                        <t t-if="'risiko' in data">\n                          <span><t t-esc="data['risiko']"/></span>\n                        </t>\n                      </td>\n                      <td style="width: 90px; height: 23px; text-align: center;">\n                        <span><t t-if="'risiko' in data"><b>✓</b></t></span>\n                      </td>\n                    </tr>\n                    <tr style="height: 23px;">\n                      <td style="width: 15px; height: 23px;">8</td>\n                      <td style="width: 209px; height: 23px;">Komplikasi</td>\n                      <td style="width: 493px; height: 23px; padding-left: 5px; margin: 0;">\n                        <t t-if="'komplikasi' in data">\n                          <span><t t-esc="data['komplikasi']"/></span>\n                        </t>\n                      </td>\n                      <td style="width: 90px; height: 23px; text-align: center;">\n                        <span><t t-if="'komplikasi' in data"><b>✓</b></t></span>\n                      </td>\n                    </tr>\n                    <tr style="height: 23px;">\n                      <td style="width: 15px; height: 23px;">9</td>\n                      <td style="width: 209px; height: 23px;">Prognosis</td>\n                      <td style="width: 493px; height: 23px; padding-left: 5px; margin: 0;">\n                        <t t-if="'prognosis' in data">\n                          <span><t t-esc="data['prognosis']"/></span>\n                        </t>\n                      </td>\n                      <td style="width: 90px; height: 23px; text-align: center;">\n                        <span><t t-if="'prognosis' in data"><b>✓</b></t></span>\n                      </td>\n                    </tr>\n                    <tr style="height: 23px;">\n                      <td style="width: 15px; height: 23px;">10</td>\n                      <td style="width: 209px; height: 23px;">Alternatif &amp; Risiko</td>\n                      <td style="width: 493px; height: 23px; padding-left: 5px; margin: 0;">\n                        <t t-if="'alternatif-risiko' in data">\n                          <span><t t-esc="data['alternatif-risiko']"/></span>\n                        </t>\n                      </td>\n                      <td style="width: 90px; height: 23px; text-align: center;">\n                        <span><t t-if="'alternatif-risiko' in data"><b>✓</b></t></span>\n                      </td>\n                    </tr>\n                    <tr style="height: 23px;">\n                      <td style="width: 15px; height: 23px;">11</td>\n                      <td style="width: 209px; height: 23px;">Lain-lain</td>\n                      <td style="width: 493px; height: 23px; padding-left: 5px; margin: 0;">\n                        <t t-if="'lain-lain' in data">\n                          <span><t t-esc="data['lain-lain']"/></span>\n                        </t>\n                      </td>\n                      <td style="width: 90px; height: 23px; text-align: center;">\n                        <span><t t-if="'lain-lain' in data"><b>✓</b></t></span>\n                      </td>\n                    </tr>\n                  </tbody>\n                </table>\n\n                <table style="width: 100%; margin: 0;" class="table table-bordered table-sm">\n                  <tbody>\n                    <tr>\n                      <td rowspan="2" style="width: 75%; vertical-align: middle;">\n                        Dengan ini menyatakan bahwa saya telah menerangkan hal-hal di atas secara benar dan jelas dan memberikan kesempatan untuk bertanya dan/atau berdiskusi\n                      </td>\n                      <td style="width: 25%; text-align: center;">\n                        Tanda Tangan:\n                      </td>\n                    </tr>\n                    <tr>\n                      <td>\n                          <div style="width:110px;height:80px; margin: auto;"/>\n                      </td>\n                    </tr>\n                    <tr>\n                      <td rowspan="2" style="width: 75%; vertical-align: middle;">\n                        Dengan ini menyatakan bahwa saya telah menerima informasi sebagaimana di atas yang saya beri tanda √ / paraf di kolom kanannya, dan telah memahaminya\n                      </td>\n                      <td style="width: 25%; text-align: center;">\n                        Tanda Tangan Pasien/Wali Pasien:\n                      </td>\n                    </tr>\n                    <tr>\n                      <td>\n                        <t t-if="'sign-pj' in data">\n                          <div style="width:110px;height:80px; margin: auto;">\n                            <img height="80" t-att-src="data['sign-pj']"/>\n                          </div>\n                        </t>\n                      </td>\n                    </tr>\n                    <tr>\n                      <td colspan="4" style="width: 25%; text-align: center;">\n                        <b>Bila pasien tidak kompeten atau tidak mau menerima informasi, <br/> maka penerima informasi adalah wali atau keluarga terdekat</b>\n                      </td>\n                    </tr>\n                  </tbody>\n                </table>\n\n                <div style="page-break-after: always; break-after: always;"> </div>\n\n                <table style="width: 100%; margin: 0;" class="table table-bordered table-sm">\n                  <tbody>\n                    <tr>\n                      <td style="text-align: center;">\n                        <t t-if="'jenis-consent' in data and data['jenis-consent'] == 'Persetujuan'">\n                          <strong>PERSETUJUAN PROSEDUR TINDAKAN MEDIS</strong>\n                        </t>\n                        <t t-if="'jenis-consent' in data and data['jenis-consent'] == 'Penolakan'">\n                          <strong>PENOLAKAN PROSEDUR TINDAKAN MEDIS</strong>\n                        </t>\n                      </td>\n                    </tr>\n                    <tr>\n                      <td>\n                        <div class="row mb-1" style="margin: 0px;">Yang bertanda tangan di bawah ini: </div>\n                        <div class="row mb-1">\n                          <div class="col-2"><b>Nama</b></div>\n                          <div class="col-4">: <t t-if="'nama-pj' in data"> <span><t t-esc="data['nama-pj']"/></span></t></div>\n                        </div>\n                        <div class="row mb-1">\n                          <div class="col-2"><b>Umur</b></div>\n                          <div class="col-4">: <t t-esc="o.count_age(data['tgl-lahir-pj'].replace('-', '/'))"/> tahun</div>\n                          <div class="col-4"><span><b>Jenis Kelamin</b>: <t t-if="data['jenis-kelamin-pj'] == 'male'">Laki-Laki</t><t t-else="">Perempuan</t></span></div>\n                        </div>\n                        <div class="row mb-1">\n                          <div class="col-2"><b>Alamat</b></div>\n                          <div class="col-4">: <t t-esc="o['partner_id']['street']"/></div>\n                        </div>\n\n                        <p>dengan ini menyatakan\n                          <t t-if="'jenis-consent' in data and data['jenis-consent'] == 'Persetujuan'">\n                            <b>PERSETUJUAN</b>\n                          </t>\n                          <t t-if="'jenis-consent' in data and data['jenis-consent'] == 'Penolakan'">\n                            <b>TIDAK SETUJU</b>\n                          </t>\n                          \n                          untuk dilakukan tindakan kedokteran <b style="text-transform: uppercase;"><t t-esc="data['tindakan-kedokteran']"/></b> terhadap <t t-esc="data['relasi-pj']"/> saya :\n                        </p>\n\n                        <div class="row mb-1">\n                          <div class="col-2"><b>Nama</b></div>\n                          <div class="col-4">: <t t-if="'nama-pj' in data"> <span><t t-esc="o['partner_id']['name']"/></span></t></div>\n                        </div>\n                        <div class="row mb-1">\n                          <div class="col-2"><b>Umur</b></div>\n                          <div class="col-4">: <t t-esc="o.count_age(o['partner_id']['birthDate'].strftime('%d/%m/%Y'))"/> tahun</div>\n                          <div class="col-4"><span><b>Jenis Kelamin</b>: <t t-if="o['partner_id']['gender'] == 'male'">Laki-Laki</t><t t-else="">Perempuan</t></span></div>\n                        </div>\n                        <div class="row mb-1">\n                          <div class="col-2"><b>Alamat</b></div>\n                          <div class="col-4">: <t t-esc="o['partner_id']['street']"/></div>\n                        </div>\n\n                        <p>Saya memahami perlunya dan manfaat tindakan tersebut sebagaimana telah dijelaskan seperti di atas kepada saya, termasuk risiko dan komplikasi yang akan timbul. Saya juga menyadari bahwa ilmu kedokteran bukanlah ilmu pasti, maka keberhasilan tindakan medik/kedokteran bukanlah keniscayaan, melainkan sangat bergantung kepada Tuhan Yang Maha Esa. Oleh sebab itu saya membebaskan <b>Klinik Utama &amp; Hemodialisa Sahabat Keluarga / dokter / Petugas Lainnya</b> dari tanggung jawab hukum apabila risiko atau komplikasi yang tidak diharapkan benar-benar terjadi di kemudian hari. </p>\n\n                        <p style="margin-right: 48px; text-align: right;">\n                          <t t-esc="o['operating_unit_id']['company_id']['city']"/>, <t t-esc="o.to_date_string(data['registration_date'])"/> Jam  <t t-esc="o.to_time_string(data['registration_date'])"/>\n                        </p>\n\n                        <div class="row mt-2" style="page-break-inside: avoid; page-break-before: auto; width: 100%;">\n                          <div class="col-3 text-center">\n                            <div class="mb-1">Yang Menyatakan </div>\n                            <t t-if="'sign-pj' in data">\n                              <div style="width:110px;height:80px; margin: auto;">\n                                  <img height="80" t-att-src="data['sign-pj']"/>\n                                </div>\n                            </t>\n                            <div class="mt-2"><strong>( <t t-esc="data['nama-pj']"/> )</strong></div>\n                          </div>\n                          <div class="col-3 text-center"> \n                            <div class="mb-1">Dokter</div>\n                              <div style="width:110px;height:80px; margin: auto;"/>\n                            <!-- <div class="mt-2"><strong>( <t t-esc="data['dokter-pelaksana']"/> )</strong> </div> -->\n                            <div class="mt-2"><strong>( dr. Verawaty Sugianto )</strong> </div>\n                          </div>\n                          <t t-if="'saksi' in data">\n                            <t t-foreach="data['saksi']" t-as="saksi">\n                              <div class="col-3 text-center">\n                                  <div class="mb-1"> Saksi <t t-esc="saksi['saksi-idx']"/></div>\n                                  <t t-if="'sign-img' in saksi">\n                                    <div style="width:110px;height:80px; margin: auto;">\n                                      <img height="80" t-att-src="saksi['sign-img']"/>\n                                    </div>\n                                  </t>\n                                  <t t-if="saksi['nama-saksi'] == false">\n                                    <p class="mb-0 mt-2">(.......................................................)</p>\n                                  </t>\n                                  <t t-else="">\n                                    <p class="mb-0 mt-2"><strong>( <t t-esc="saksi['nama-saksi']"/> )</strong></p>\n                                  </t>\n                              </div>\n                            </t>\n                          </t>\n                        </div>\n                      </td>\n                    </tr>\n                    \n                  </tbody>\n                </table>\n                \n              </div>\n            </div>\n          </div>\n        </t>\n      </t>\n    	ehealth_document/report/template_informed_consent/report_sahabatkeluarga_informed_consent.xml	\N	\N	\N	\N	primary	t	1	2025-08-28 11:34:01.364376	1	2025-08-28 11:34:01.364376	f
1578	report_drbibin_informed_consent	\N	ehealth_document.report_drbibin_informed_consent	16	qweb	<?xml version="1.0"?>\n<t t-name="ehealth_document.report_drbibin_informed_consent">\n        <t t-set="company" t-value="res_company"/>\n        <t t-call="ehealth_document.header_drbibin_document">\n          <div class="page">\n            <div class="row">\n              <div class="col-md-12">\n                <p class="text-center mt-3 mb-0"><strong>Surat Pernyataan Tindakan Medis</strong></p>\n                <p class="text-center">Nomor: <t t-esc="o['name']"/></p>\n                <p class="mt-3">Yang bertanda tangan di bawah ini, saya:</p>\n                <div class="mt-1 ml-3">\n                    <div class="row">\n                        <div class="col-3">Nama</div>\n                        <div class="col-6">: <strong><t t-esc="data['nama-pj']"/></strong></div>\n                    </div>\n                    <t t-if="'umur-pj' in data">\n                      <div class="row">\n                        <div class="col-3">Umur</div>\n                        <div class="col-6">: <t t-esc="data['umur-pj']"/></div>\n                      </div>\n                    </t>\n                    <t t-if="'tgl-lahir-pj' in data">\n                      <div class="row">\n                        <div class="col-3">Tanggal Lahir</div>\n                        <div class="col-6">: <t t-esc="data['tgl-lahir-pj']"/></div>\n                      </div>\n                    </t>\n                    <div class="row">\n                        <div class="col-3">Jenis Kelamin</div>\n                        <div class="col-6">:\n                          <t t-if="data['jenis-kelamin-pj'] == 'male'">Laki-Laki</t>\n                          <t t-else="">Perempuan</t>\n                        </div>\n                    </div>\n                    <t t-if="'relasi-pj' in data">\n                      <div class="row">\n                          <div class="col-3">Relasi dengan pasien</div>\n                           <div class="col-6">: <t t-esc="data['relasi-pj']"/></div>\n                      </div>\n                    </t>\n                </div>\n                <p>Dengan ini saya menyatakan dengan sesungguhnya telah memberikan</p>\n                <p class="mt-2 mb-2 text-center"><strong><t t-esc="data['jenis-consent']"/></strong></p>\n                <t t-if="'tujuan-consent' in data">\n                  <p>untuk dilakukan <t t-esc="data['tujuan-consent']"/> berupa</p>\n                </t>\n                <t t-else="">\n                  <p>untuk dilakukan pemeriksaan, pengobatan dan tindakan medis berupa</p>\n                </t>\n                <p class="mt-2 mb-2 text-center"><t t-esc="data['objek-consent']"/></p>\n                <t t-if="'catatan-consent' in data">\n                  <p>Dengan catatan</p>\n                  <p><t t-esc="data['catatan-consent']"/></p>\n                </t>\n                <p>terhadap <t t-esc="data['relasi-pj']"/> saya dengan identitas sebagai berikut: </p>\n                <div class="mt-3 ml-3">\n                    <div class="row">\n                        <div class="col-3">Nama</div>\n                        <div class="col-6">: <strong><t t-esc="o['partner_id']['name']"/></strong></div>\n                    </div>\n                    <div class="row">\n                        <div class="col-3">Tanggal Lahir</div>\n                        <div class="col-6">: <t t-esc="o['partner_id']['birthDate'].strftime('%d-%m-%Y')"/></div>\n                    </div>\n                    <div class="row">\n                        <div class="col-3">Jenis Kelamin</div>\n                        <div class="col-6">:\n                          <t t-if="o['partner_id']['gender'] == 'male'">Laki-Laki</t>\n                          <t t-else="">Perempuan</t>\n                        </div>\n                    </div>\n                    <div class="row">\n                        <div class="col-3">Alamat</div>\n                        <div class="col-6">: <t t-esc="o['partner_id']['street']"/></div>\n                    </div>\n                    <t t-if="'no-cm' in data">\n                        <div class="row">\n                            <div class="col-3">No. CM</div>\n                            <div class="col-6">: <t t-esc="data['no-cm']"/></div>\n                        </div>\n                    </t>\n                </div>\n                <p class="mt-3" style="page-break-inside: avoid; page-break-before: auto;">yang cara, manfaat dan tujuan serta resiko yang ditimbulkan dari pemeriksaan, pengobatan serta tindakan medis tersebut di atas telah dijelaskan oleh dokter dan saya telah mengerti sepenuhnya.</p>\n                <p>Demikian pernyataan ini saya buat dengan penuh kesadaran dan tanpa paksaan agar dapat dipergunakan sebagaimana mestinya.</p><br/>\n              </div>\n            </div>\n\n            <div class="row" style="page-break-inside: avoid; page-break-before: auto;">\n                <div class="col-4">\n                    <p class="pt-3 mb-2">Dokter yang Memberi Penjelasan</p>\n                    <div style="width:110px;height:80px;">\n                      <t t-if="data['practitioner'] and 'sign-img' in data['practitioner']">          \n                        <img height="80" t-att-src="data['practitioner']['sign-img']"/>\n                      </t>\n                    </div>\n                     <p class="mb-0 mt-2"><strong><t t-esc="data['dokter-pelaksana'] if 'dokter-pelaksana' in data and data['dokter-pelaksana'] else '-'"/></strong></p>\n                </div>\n                <div class="col-4"/>\n                <div class="col-4">\n                    <p class="mb-0">Sampang, <t t-esc="o.to_date_string(data['registration_date'])"/></p>\n                    <p class="mb-0">Yang Memberi Pernyataan</p>\n                    <t t-if="'sign-pj' in data">\n                      <div style="width:110px;height:80px;">\n                          <img height="80" t-att-src="data['sign-pj']"/>\n                        </div>\n                    </t>\n                    <p class="mb-0 mt-2"><strong><t t-esc="data['nama-pj']"/></strong></p>\n                </div>\n            </div>\n            <div class="row mt-3" style="page-break-inside: avoid; page-break-before: auto;">\n                <t t-if="'nama-saksi-1' in data">\n                  <div class="col-4">\n                    <p class="mb-0">Saksi 1</p>\n                    <div style="width:110px;height:80px;"/>\n                    <p class="mb-0 mt-2"><strong><t t-esc="o.arrange_signature(data['nama-saksi-1'])"/></strong></p>\n                  </div>\n                </t>\n                <t t-if="'nama-saksi-1' in data">\n                  <div class="col-4"/>\n                  <div class="col-4">\n                    <p class="mb-0">Saksi 2</p>\n                    <div style="width:110px;height:80px;"/>\n                    <p class="mb-0 mt-2"><strong><t t-esc="o.arrange_signature(data['nama-saksi-2'])"/></strong></p>\n                  </div>\n                </t>\n                <t t-if="'saksi' in data">\n                  <t t-foreach="data['saksi']" t-as="saksi">\n                    <div class="col-4">\n                        <p> Saksi\n                            <t t-esc="saksi['saksi-idx']"/>\n                        </p>\n                        <div style="width:110px;height:80px;">\n                          <img height="80" t-att-src="saksi['sign-img']"/>\n                        </div>\n                        <p class="mb-0 mt-2"><strong><t t-esc="o.arrange_signature(saksi['nama-saksi'])"/></strong></p>\n                    </div>\n                    <div class="col-4"/>\n                  </t>\n                </t>\n            </div>\n          </div>\n        </t>\n      </t>\n    	ehealth_document/report/template_informed_consent/report_drbibin_informed_consent.xml	\N	\N	\N	\N	primary	t	1	2025-08-28 11:34:01.364376	1	2025-08-28 11:34:01.364376	f
633	account.fiscal.position.tree	account.fiscal.position	\N	16	tree	<?xml version="1.0"?>\n<tree string="Fiscal Position">\n                    <field name="sequence" widget="handle"/>\n                    <field name="name"/>\n                    <field name="company_id" groups="base.group_multi_company" options="{'no_create': True}"/>\n                </tree>\n            	account/views/partner_view.xml	\N	\N	\N	\N	primary	t	1	2025-08-28 11:32:28.994214	1	2025-08-28 11:32:28.994214	f
634	partner.view.buttons	res.partner	\N	11	form	<?xml version="1.0"?>\n<data><div name="button_box" position="inside">\n                    <button type="object" class="oe_stat_button" icon="fa-pencil-square-o" name="action_view_partner_invoices" context="{'default_partner_id': active_id}">\n                        <div class="o_form_field o_stat_info">\n                            <span class="o_stat_value">\n                                <field name="currency_id" invisible="1"/>\n                                <field name="total_invoiced" widget="monetary" options="{'currency_field': 'currency_id'}"/>\n                            </span>\n                            <span class="o_stat_text">Invoiced</span>\n                        </div>\n                    </button>\n                </div>\n\n                <page name="internal_notes" position="inside">\n                    <group colspan="2" col="2" groups="account.group_warning_account">\n                        <separator string="Warning on the Invoice" colspan="4"/>\n                        <field name="invoice_warn" nolabel="1"/>\n                        <field name="invoice_warn_msg" colspan="3" nolabel="1" attrs="{'required':[('invoice_warn', '!=', False), ('invoice_warn','!=','no-message')],'readonly':[('invoice_warn','=','no-message')]}"/>\n                    </group>\n                </page>\n            </data>	account/views/partner_view.xml	\N	\N	118	\N	extension	t	1	2025-08-28 11:32:28.994214	1	2025-08-28 11:32:28.994214	f
1579	report_esensia_informed_consent	\N	ehealth_document.report_esensia_informed_consent	16	qweb	<?xml version="1.0"?>\n<t t-name="ehealth_document.report_esensia_informed_consent">\n        <t t-set="company" t-value="res_company"/>\n        <t t-call="ehealth_document.header_esensia_document">\n          <div class="page">\n            <div class="row">\n              <div class="col-md-12">\n                <p class="text-center mt-3 mb-0"><strong>Surat Pernyataan Tindakan Medis</strong></p>\n                <p class="text-center">Nomor: <t t-esc="o['name']"/></p>\n                <p class="mt-3">Yang bertanda tangan di bawah ini, saya:</p>\n                <div class="mt-1 ml-3">\n\n                   <div class="row">\n                        <div class="col-3">Nama</div>\n                        <div class="col-6">\n                            : \n                            <t t-if="'nama-pj' in data"><strong><t t-esc="data['nama-pj']"/></strong></t>\n                            <t t-else="">-</t>\n                        </div>\n                    </div>\n                    <div class="row">\n                        <div class="col-3">Umur</div>\n                        <div class="col-6">\n                            : \n                            <t t-if="'umur-pj' in data"><t t-esc="data['umur-pj']"/></t>\n                            <t t-else="">-</t>\n                        </div>\n                    </div>\n                    <div class="row">\n                        <div class="col-3">Jenis Kelamin</div>\n                        <div class="col-6">\n                            : \n                            <t t-if="'jenis-kelamin-pj' in data"><t t-esc="data['jenis-kelamin-pj']"/></t>\n                            <t t-else="">-</t>\n                        </div>\n                    </div>\n\n                </div>\n                <p>Dengan ini saya menyatakan dengan sesungguhnya telah memberikan</p>\n                <p class="mt-2 mb-2 text-center"><strong><t t-esc="data['jenis-consent']"/></strong></p>\n                <p>untuk dilakukan pemeriksaan, pengobatan dan tindakan medis berupa</p>\n                <p class="mt-2 mb-2 text-center"><t t-esc="data['objek-consent']"/></p>\n                <p>terhadap <t t-esc="data['relasi-pj']"/> saya dengan identitas sebagai berikut: </p>\n                <div class="mt-3 ml-3">\n                    <div class="row">\n                        <div class="col-3">Nama</div>\n                        <div class="col-6">: <strong><t t-esc="o['partner_id']['name']"/></strong></div>\n                    </div>\n                    <div class="row">\n                        <div class="col-3">Tanggal Lahir</div>\n                        <div class="col-6">: <t t-esc="o['partner_id']['birthDate'].strftime('%d-%m-%Y')"/></div>\n                    </div>\n                    <div class="row">\n                        <div class="col-3">Jenis Kelamin</div>\n                        <div class="col-6">: \n                          <t t-if="o['partner_id']['gender'] == 'male'">Laki-Laki</t>\n                          <t t-else="">Perempuan</t>\n                        </div>\n                    </div>\n                    <div class="row">\n                        <div class="col-3">Alamat</div>\n                        <div class="col-6">: <t t-esc="o['partner_id']['street']"/></div>\n                    </div>\n                    <div class="row">\n                        <div class="col-3">No. CM</div>\n                        <div class="col-6">: <t t-esc="data['no-cm']"/></div>\n                    </div>\n                </div>\n                <p class="mt-3" style="page-break-inside: avoid; page-break-before: auto;">yang cara, manfaat dan tujuan serta resiko yang ditimbulkan dari pemeriksaan, pengobatan serta tindakan medis tersebut di atas telah dijelaskan oleh dokter dan saya telah mengerti sepenuhnya.</p>\n                <p>Demikian pernyataan ini saya buat dengan penuh kesadaran dan tanpa paksaan agar dapat dipergunakan sebagaimana mestinya.</p><br/>\n              </div>\n            </div>\n\n            <div class="row" style="page-break-inside: avoid; page-break-before: auto;">\n                <div class="col-4">\n                    <p class="pt-3 mb-2">Dokter yang Memberi Penjelasan</p>\n                        <t t-if="'practitioner' in data">\n                            <t t-if="data['practitioner'] and 'sign-img' in data['practitioner']">          \n                                <img t-att-src="data['practitioner']['sign-img']" style="width:110px;height:110px;"/>\n                            </t>\n                        </t>\n                        <t t-else=""/>\n                    <p class="mb-0 mt-2"><strong><t t-esc="data['dokter-pelaksana'] if 'dokter-pelaksana' in data and data['dokter-pelaksana'] else data['sender']"/></strong></p>\n                </div>\n                <div class="col-4"/>\n                <div class="col-4">\n                    <p class="mb-0"><t t-esc="o['operating_unit_id']['company_id']['city']"/>, <t t-esc="o.to_date_string(data['registration_date'])"/></p>\n                    <p class="mb-0">Yang Memberi Pernyataan</p>\n                    <t t-if="'sign-pj' in data">\n                        <div style="width:110px;height:110px;">\n                            <img height="80" t-att-src="data['sign-pj']"/>\n                        </div>\n                    </t>\n                    <p class="mb-0 mt-2"><strong><t t-esc="data['nama-pj']"/></strong></p>\n                </div>\n            </div>\n            <div class="row mt-3" style="page-break-inside: avoid; page-break-before: auto;">\n                <div class="col-4">\n                    <p class="mb-0">Saksi 1</p>\n                    <t t-if="'saksi' in data and len(data['saksi']) &gt; 0">\n                        <t t-if="'sign-img' in data['saksi'][0]">\n                            <div style="width:110px;height:80px;">\n                                <img t-att-src="data['saksi'][0]['sign-img']" height="80"/>\n                            </div>\n                        </t>\n                        <t t-else="">\n                            <div style="width:110px;height:80px;"/>\n                        </t>\n                        <p class="mb-0 mt-2">\n                            <t t-if="'nama-saksi' in data['saksi'][0]">\n                                <strong><span t-esc="data['saksi'][0]['nama-saksi']"/></strong>\n                            </t>\n                            <t t-else="">\n                                -\n                            </t>\n                        </p>\n                    </t>\n                    <t t-else="">\n                        <div style="width:110px;height:80px;"/>\n                        <p class="mb-0 mt-2">-</p>\n                    </t>\n                </div>\n                <div class="col-4"/>\n                <div class="col-4">\n                    <p class="mb-0">Saksi 2</p>\n                    <t t-if="'saksi' in data and len(data['saksi']) &gt; 1">\n                        <t t-if="'sign-img' in data['saksi'][1]">\n                            <div style="width:110px;height:80px;">\n                                <img t-att-src="data['saksi'][1]['sign-img']" height="80"/>\n                            </div>\n                        </t>\n                        <t t-else="">\n                            <div style="width:110px;height:80px;"/>\n                        </t>\n                        <p class="mb-0 mt-2">\n                            <t t-if="'nama-saksi' in data['saksi'][1]">\n                                <strong><span t-esc="data['saksi'][1]['nama-saksi']"/></strong>\n                            </t>\n                            <t t-else="">\n                                -\n                            </t>\n                        </p>\n                    </t>\n                    <t t-else="">\n                        <div style="width:110px;height:80px;"/>\n                        <p class="mb-0 mt-2">-</p>\n                    </t>\n                </div>\n            </div>\n          </div>\n        </t>\n      </t>\n    	ehealth_document/report/template_informed_consent/report_esensia_informed_consent.xml	\N	\N	\N	\N	primary	t	1	2025-08-28 11:34:01.364376	1	2025-08-28 11:34:01.364376	f
1580	report_drg_mega_informed_consent	\N	ehealth_document.report_drg_mega_informed_consent	16	qweb	<?xml version="1.0"?>\n<t t-name="ehealth_document.report_drg_mega_informed_consent">\n        <t t-set="company" t-value="res_company"/>\n        <t t-call="ehealth_document.header_drg_mega_document">\n          <div class="page">\n            <div class="row">\n              <div class="col-md-12">\n                <p class="text-center mt-3 mb-0"><strong>FORMULIR PERSETUJUAN TINDAKAN KEDOKTERAN</strong></p>\n                <p class="text-center">Nomor: <t t-esc="o['name']"/></p>\n\n                <table class="table table-bordered table-sm mt-2 mb-2" style="font-size:14px;">\n                  <tr>\n                      <td class="text-center" colspan="4" style="font-size:16px;"><strong>PEMBERIAN INFORMASI</strong></td>\n                  </tr>\n                  <tr>\n                      <td colspan="2">Dokter Pelaksana Tindakan</td>\n                      <td class="text-center" colspan="2"/>\n                  </tr>\n                  <tr>\n                      <td colspan="2">Pemberi Informasi</td>\n                      <td class="text-center" colspan="2"/>\n                  </tr>\n                  <tr>\n                      <td colspan="2">Penerima Informasi/Pemberi Persetujuan</td>\n                      <td class="text-center" colspan="2"/>\n                  </tr>\n                  <tr>\n                      <td class="text-center"><strong>No</strong></td>\n                      <td class="text-center"><strong>JENIS INFORMASI</strong></td>\n                      <td class="text-center"><strong>ISI INFORMASI</strong></td>\n                      <td class="text-center"><strong>TANDAI [v]</strong></td>\n                  </tr>\n                  <tr>\n                      <td class="text-center" style="width: 30px;">1</td>\n                      <td style="width: 300px;">Diagnosis (WD &amp; DD)</td>\n                      <td class="text-center"/>\n                      <td class="text-center"/>\n                  </tr>\n                  <tr>\n                      <td class="text-center" style="width: 30px;">2</td>\n                      <td style="width: 300px;">Tindakan Kedokteran</td>\n                      <td class="text-center"/>\n                      <td class="text-center"/>\n                  </tr>\n                  <tr>\n                      <td class="text-center" style="width: 30px;">3</td>\n                      <td style="width: 300px;">Indikasi Tindakan</td>\n                      <td class="text-center"/>\n                      <td class="text-center"/>\n                  </tr>\n                  <tr>\n                      <td class="text-center" style="width: 30px;">4</td>\n                      <td style="width: 300px;">Tata Cara</td>\n                      <td class="text-center"/>\n                      <td class="text-center"/>\n                  </tr>\n                  <tr>\n                      <td class="text-center" style="width: 30px;">5</td>\n                      <td style="width: 300px;">Tujuan</td>\n                      <td class="text-center"/>\n                      <td class="text-center"/>\n                  </tr>\n                  <tr>\n                      <td class="text-center" style="width: 30px;">6</td>\n                      <td style="width: 300px;">Risiko dan Komplikasi</td>\n                      <td class="text-center"/>\n                      <td class="text-center"/>\n                  </tr>\n                  <tr>\n                      <td class="text-center" style="width: 30px;">7</td>\n                      <td style="width: 300px;">Prognosis</td>\n                      <td class="text-center"/>\n                      <td class="text-center"/>\n                  </tr>\n                  <tr>\n                      <td class="text-center" style="width: 30px;">8</td>\n                      <td style="width: 300px;">Alternatif &amp; Risiko</td>\n                      <td class="text-center"/>\n                      <td class="text-center"/>\n                  </tr>\n                  <tr>\n                      <td class="text-center" style="width: 30px;">9</td>\n                      <td style="width: 300px;">Lain Lain</td>\n                      <td class="text-center"/>\n                      <td class="text-center"/>\n                  </tr>\n                  <tr>\n                      <td colspan="3">Dengan ini menyatakan bahwa saya telah menerangkan hal-hal di atas secara benar dan jelas serta memberikan kesempatan untuk bertanya dan/atau berdiskusi</td>\n                      <td class="text-center" style="font-size:10px;"><br/><br/>Tanda Tangan Dokter</td>\n                  </tr>\n                  <tr style="page-break-inside: avoid; page-break-before: auto;">\n                      <td colspan="3">Dengan ini menyatakan bahwa saya telah menerima informasi dari dokter sebagaimana di atas yang saya beri tanda [v] di kolom kanannya dan telah memahaminya</td>\n                      <td class="text-center" style="font-size:10px;"><br/><br/>Tanda Tangan Pasien</td>\n                  </tr>\n                  <tr>\n                      <td class="text-center" colspan="4" style="font-size:16px;"><strong>PERSETUJUAN TINDAKAN KEDOKTERAN</strong></td>\n                  </tr>\n                  <tr style="page-break-inside: avoid; page-break-before: auto;">\n                      <td colspan="4">\n                        <div>\n                          <p style="font-size:14px; margin-bottom:3px">\n                          Yang bertandatangan di bawah ini,\n                             Yang bertandatangan di bawah ini,\n                            <t t-if="'nama-pj' in data">\n                                <strong><t t-esc="data['nama-pj']"/></strong>,\n                            </t>\n                            <t t-if="'umur-pj' in data">\n                                umur <t t-esc="data['umur-pj']"/> tahun,\n                            </t>\n                            <t t-if="'jenis-kelamin-pj' in data">\n                                <t t-esc="data['jenis-kelamin-pj']"/>,\n                            </t>\n                            <t t-if="'alamat-pj' in data">\n                                alamat <t t-esc="data['alamat-pj']"/>,\n                            </t>\n                          dengan ini menyatakan <strong>persetujuan</strong> untuk dilakukannya tindakan <strong><t t-esc="data['objek-consent']"/></strong> terhadap \n                          <t t-if="data['relasi-pj'] != '-'"><t t-esc="data['relasi-pj']"/> saya,</t> \n                          <t t-if="data['relasi-pj'] == '-'">saya,</t> \n                          yang bernama <strong><t t-esc="o['partner_id']['name']"/></strong>, umur <t t-esc="o.count_age(o['partner_id']['birthDate'].strftime('%d/%m/%Y'))"/> Tahun, <t t-if="o['partner_id']['gender'] == 'male'">Laki-Laki</t><t t-else="">Perempuan</t>, alamat <t t-esc="o['partner_id']['street']"/>.\n                          </p>\n                          <p style="font-size:14px; margin-bottom:3px">\n                            Saya memahami perlunya dan manfaat tindakan sebagaimana telah dijelaskan seperti di atas kepada saya, termasuk risiko dan komplikasi yang mungkin timbul\n                          </p>\n                          <p style="font-size:14px; margin-bottom:3px">\n                            Saya juga menyadari bahwa dokter melakukan suatu upaya dan oleh karena ilmu kedokteran bukanlah ilmu pasti, maka keberhasilan tindakan kedokteran bukanlah keniscayaan, melainkan sangat bergantung kepada ijin Tuhan Yang Maha Esa.\n                          </p>\n                        </div>\n                      </td>\n                  </tr>\n                </table>\n              </div>\n            </div>\n\n            <div class="row mt-2" style="page-break-inside: avoid; page-break-before: auto;">\n                <div class="col-3">\n                    <p class="pt-3 mb-2">Dokter</p>\n                    <div style="width:60px;height:60px;">\n                        <t t-if="'practitioner' in data">\n                            <t t-if="data['practitioner'] and 'sign-img' in data['practitioner']">          \n                                <img height="80" t-att-src="data['practitioner']['sign-img']"/>\n                            </t>\n                        </t>\n                        <t t-else=""/>\n                    </div>\n                    <!-- <img t-att-src="o['qr_code_url']" style="width:60px;height:60px;"/> -->\n                     <p class="mb-0 mt-2"><strong><t t-esc="data['dokter-pelaksana'] if 'dokter-pelaksana' in data and data['dokter-pelaksana'] else '-'"/></strong></p>\n                </div>\n               <div class="col-3">\n                    <p class="pt-3 mb-2">Saksi 1</p>\n                    <div style="width:60px;height:60px;"/>\n                    <t t-if="'nama-saksi-1' in data">\n                        <p class="mb-0 mt-2"><strong><t t-esc="o.arrange_signature(data['nama-saksi-1'], 1)"/></strong></p>\n                    </t>\n                </div>\n\n                <div class="col-3">\n                    <t t-if="'operating_unit_id' in o and 'company_id' in o['operating_unit_id'] and 'city' in o['operating_unit_id']['company_id']">\n                        <p class="mb-0">\n                            <t t-esc="o['operating_unit_id']['company_id']['city']"/>,\n                            <t t-if="'registration_date' in data">\n                                <t t-esc="o.to_date_string(data['registration_date'])"/>\n                            </t>\n                        </p>\n                    </t>\n                    <p class="mb-0">Yang Menyatakan</p>\n                    <div style="width:60px;height:60px;"/>\n                    <t t-if="'nama-pj' in data">\n                        <p class="mb-0 mt-2"><strong><t t-esc="data['nama-pj']"/></strong></p>\n                    </t>\n                </div>\n\n                <div class="col-3">\n                    <p class="pt-3 mb-2">Saksi 2</p>\n                    <div style="width:60px;height:60px;"/>\n                    <t t-if="'nama-saksi-2' in data">\n                        <p class="mb-0 mt-2"><strong><t t-esc="o.arrange_signature(data['nama-saksi-2'], 1)"/></strong></p>\n                    </t>\n                </div>\n\n            </div>\n          </div>\n        </t>\n      </t>\n    	ehealth_document/report/template_informed_consent/report_drg_mega_informed_consent.xml	\N	\N	\N	\N	primary	t	1	2025-08-28 11:34:01.364376	1	2025-08-28 11:34:01.364376	f
1581	report_kenko_informed_consent	\N	ehealth_document.report_kenko_informed_consent	16	qweb	<?xml version="1.0"?>\n<t t-name="ehealth_document.report_kenko_informed_consent">\n        <t t-set="company" t-value="res_company"/>\n        <t t-call="ehealth_document.header_kenko_document">\n          <div class="page">\n            <div class="row">\n              <div class="col-md-12">\n                <p class="text-center mt-3 mb-0"><strong>PERSETUJUAN / PENOLAKAN TINDAKAN MEDIS</strong></p>\n                <p class="text-center">Nomor: <t t-esc="o['name']"/></p>\n                <p class="mt-3">Saya yang bertanda tangan di bawah ini :</p>\n                <div class="mt-1 ml-3">\n                    <div class="row">\n                        <div class="col-3">Nama</div>\n                        <div class="col-6">\n                            : <strong>\n                                <t t-if="'nama-pj' in data">\n                                    <t t-esc="data['nama-pj']"/>\n                                </t>\n                                <t t-else="">-</t>\n                            </strong>\n                        </div>\n                    </div>\n                    <div class="row">\n                        <div class="col-3">Umur</div>\n                        <div class="col-6">\n                            : \n                            <t t-if="'umur-pj' in data">\n                                <t t-esc="data['umur-pj']"/>\n                            </t>\n                            <t t-else="">-</t>\n                        </div>\n                    </div>\n                    <div class="row">\n                        <div class="col-3">Jenis Kelamin</div>\n                        <div class="col-6">\n                            : \n                            <t t-if="'jenis-kelamin-pj' in data">\n                                <t t-esc="data['jenis-kelamin-pj']"/>\n                            </t>\n                            <t t-else="">-</t>\n                        </div>\n                    </div>\n                    <div class="row">\n                        <div class="col-3">Alamat</div>\n                        <div class="col-6">\n                            : \n                            <t t-if="'alamat-pj' in data">\n                                <t t-esc="data['alamat-pj']"/>\n                            </t>\n                            <t t-else="">-</t>\n                        </div>\n                    </div>\n                    <div class="row">\n                        <div class="col-3">Bukti diri / KTP</div>\n                        <div class="col-6">\n                            : \n                            <t t-if="'no-identitas-pj' in data">\n                                <t t-esc="data['no-identitas-pj']"/>\n                            </t>\n                            <t t-else="">-</t>\n                        </div>\n                    </div>\n                </div>\n                <p>Dengan ini telah menyatakan dengan sesungguhnya telah memberikan</p>\n                <p class="mt-2 mb-2 text-center"><strong><t t-esc="data['jenis-consent']"/></strong></p>\n                <p>untuk dilakukan tindakan medis berupa</p>\n                <p class="mt-2 mb-2 text-center"><t t-esc="data['objek-consent']"/></p>\n                <p>terhadap <t t-esc="data['relasi-pj']"/> saya dengan </p>\n                <div class="mt-3 ml-3">\n                    <div class="row">\n                        <div class="col-3">Nama</div>\n                        <div class="col-6">\n                            : <strong>\n                                <t t-if="'partner_id' in o and 'name' in o['partner_id']">\n                                    <t t-esc="o['partner_id']['name']"/>\n                                </t>\n                                <t t-else="">-</t>\n                            </strong>\n                        </div>\n                    </div>\n                    <div class="row">\n                        <div class="col-3">Umur</div>\n                        <div class="col-6">\n                            : \n                            <t t-if="'partner_id' in o and 'birthDate' in o['partner_id']">\n                                <t t-esc="o.count_age(o['partner_id']['birthDate'].strftime('%d/%m/%Y'))"/> tahun\n                            </t>\n                            <t t-else="">-</t>\n                        </div>\n                    </div>\n                    <div class="row">\n                        <div class="col-3">Jenis Kelamin</div>\n                        <div class="col-6">:\n                          <t t-if="o['partner_id']['gender'] == 'male'">Laki-Laki</t>\n                          <t t-else="">Perempuan</t>\n                        </div>\n                    </div>\n                    <div class="row">\n                        <div class="col-3">Alamat</div>\n                        <div class="col-6">: <t t-esc="o['partner_id']['street']"/></div>\n                    </div>\n                    <div class="row">\n                        <div class="col-3">\n                          <t t-if="o['partner_id']['identity_type'] == 'ktp'">NIK</t>\n                          <t t-if="o['partner_id']['identity_type'] == 'sim'">No. SIM</t>\n                          <t t-if="o['partner_id']['identity_type'] == 'paspor'">No. Paspor</t>\n                        </div>\n                        <div class="col-6">:\n                          <t t-if="o['partner_id']['identity_type'] == 'ktp'"><t t-esc="o['partner_id']['nik']"/></t>\n                          <t t-else=""><t t-esc="o['partner_id']['identity_number']"/></t>\n                        </div>\n                    </div>\n                    <div class="row">\n                        <div class="col-3">No. CM</div>\n                        <div class="col-6">: <t t-esc="data['no-cm']"/></div>\n                    </div>\n                </div>\n                <p class="mt-3" style="page-break-inside: avoid; page-break-before: auto;">Yang tujuan, sifat dan perlunya tindakan medis tersebut di atas, serta resiko yang ditimbulkan telah cukup dijelaskan oleh dokter/paramedis dan telah saya mengerti sepenuhnya.</p>\n                <p>Demikian pernyataan ini saya buat dengan penuh kesadaran dan tanpa paksaan.</p><br/>\n              </div>\n            </div>\n            <div class="col-12 text-right" style="page-break-inside: avoid; page-break-before: auto;">\n              <p class="mb-0 text-right pr-1"><t t-esc="o['operating_unit_id']['company_id']['city']"/>, <t t-esc="o.to_date_string(data['registration_date'])"/></p>\n            </div>\n            <div class="row" style="page-break-inside: avoid; page-break-before: auto;">\n           \n              <div class="col-3 text-center">\n                  <p class="pt-3 mb-2">Perawat/Bidan</p>\n                  <div style="width:110px;height:80px;"/>\n                  <p class="mb-0 mt-2">\n                      <strong>\n                          <t t-if="'perawat-bidan' in data">\n                              <t t-esc="o.arrange_signature(data['perawat-bidan'])"/>\n                          </t>\n                          <t t-else="">-</t>\n                      </strong>\n                  </p>\n              </div>\n\n           \n              <div class="col-3 text-center">\n                  <p class="pt-3 mb-2">Dokter</p>\n                  <div style="width:110px;height:80px;">\n                      <t t-if="'practitioner' in data">\n                          <t t-if="data['practitioner'] and 'sign-img' in data['practitioner']">\n                              <img height="80" t-att-src="data['practitioner']['sign-img']"/>\n                          </t>\n                      </t>\n                  </div>\n                  <p class="mb-0 mt-2">\n                      <strong>\n                          <t t-if="'sender' in data">\n                              <t t-esc="data['dokter-pelaksana'] if 'dokter-pelaksana' in data and data['dokter-pelaksana'] else data['sender']"/>\n                          </t>\n                          <t t-else="">-</t>\n                      </strong>\n                  </p>\n              </div>\n\n             \n              <div class="col-3 pr-2 text-center">\n                  <p class="pt-3 mb-2">Yang membuat pernyataan</p>\n                  <div style="width:110px;height:80px;">\n                      <t t-if="'sign-pj' in data">\n                          <img height="80" t-att-src="data['sign-pj']"/>\n                      </t>\n                  </div>\n                  <p class="mb-0 mt-2">\n                      <strong>\n                          <t t-if="'nama-pj' in data">\n                              <t t-esc="data['nama-pj']"/>\n                          </t>\n                          <t t-else="">-</t>\n                      </strong>\n                  </p>\n              </div>\n\n            \n              <div class="col-3 text-center">\n                  <p class="pt-3 mb-2">Saksi</p>\n                  <t t-if="'saksi' in data and data['saksi']">\n                      <div style="width:110px;height:80px;">\n                          <t t-if="'sign-img' in data['saksi'][0]">\n                              <img t-att-src="data['saksi'][0]['sign-img']" height="80"/>\n                          </t>\n                      </div>\n                      <p class="mb-0 mt-2">\n                          <strong>\n                              <t t-esc="data['saksi'][0].get('nama-saksi', '-')"/>\n                          </strong>\n                      </p>\n                  </t>\n                  <t t-else="">\n                      <div style="width:110px;height:80px;"/>\n                      <p class="mb-0 mt-2">-</p>\n                  </t>\n              </div>\n\n            </div>\n          </div>\n        </t>\n      </t>\n    	ehealth_document/report/template_informed_consent/report_kenko_informed_consent.xml	\N	\N	\N	\N	primary	t	1	2025-08-28 11:34:01.364376	1	2025-08-28 11:34:01.364376	f
1582	report_westerindo_informed_consent	\N	ehealth_document.report_westerindo_informed_consent	16	qweb	<?xml version="1.0"?>\n<t t-name="ehealth_document.report_westerindo_informed_consent">\n        <t t-set="company" t-value="res_company"/>\n        <t t-call="ehealth_document.header_westerindo_multi_ou_document">\n          <div class="page" style="font-size:13px; line-height: 1.4;">\n            <div class="" style="">\n              <div class="">\n\n                <table style="width: 100%; margin: 0;" class="table table-bordered table-sm">\n                  <thead><tr><th colspan="4" style="text-align: center;"><strong>PEMBERIAN INFORMASI</strong></th></tr></thead>\n                  <tbody>\n                    <tr>\n                      <td style="width: 224px;" colspan="2">Nama &amp; Jabatan Pemberi Informasi</td>\n                      <td style="width: 493px; padding-left: 5px; margin: 0;" colspan="2">\n                        <t t-if="'dokter-pelaksana' in data">\n                          <span><t t-esc="data['dokter-pelaksana']"/></span>\n                        </t>\n                      </td>\n                    </tr>\n                    <tr>\n                      <td style="width: 224px;" colspan="2">Nama Pasien</td>\n                      <td style="width: 493px; padding-left: 5px; margin: 0;" colspan="2">\n                        <span><t t-esc="o['partner_id']['name']"/> </span>\n                      </td>\n                    </tr>\n                    <tr>\n                      <td style="width: 224px;" colspan="2">Nomor Rekam Medis</td>\n                      <td style="width: 493px; padding-left: 5px; margin: 0;" colspan="2">\n                        <t t-if="'no-cm' in data">\n                          <span><t t-esc="data['no-cm']"/></span>\n                        </t>\n                      </td>\n                    </tr>\n                    <tr>\n                      <td style="width: 224px;" colspan="2">Tempat/Tanggal Lahir</td>\n                      <td style="width: 493px; padding-left: 5px; margin: 0;" colspan="2">\n                        <span> <t t-esc="o['partner_id']['birth_place']"/></span>,\n                        <span> <t t-esc="o['partner_id']['birthDate'].strftime('%d-%m-%Y')"/></span>\n                        (<span> <t t-esc="o.count_age(o['partner_id']['birthDate'].strftime('%d/%m/%Y'))"/></span> Tahun)\n                      </td>\n                    </tr>\n                    <tr>\n                      <td style="width: 224px;" colspan="2">Jenis Kelamin</td>\n                      <td style="width: 493px; padding-left: 5px; margin: 0;" colspan="2">\n                        <span><t t-if="o['partner_id']['gender'] == 'male'">Laki-Laki</t><t t-else="">Perempuan</t></span>\n                      </td>\n                    </tr>\n                    <tr>\n                      <td style="width: 224px;" colspan="2">Alamat Pasien</td>\n                      <td style="width: 493px; padding-left: 5px; margin: 0;" colspan="2">\n                        <span><t t-esc="o['partner_id']['street']"/> </span>\n                      </td>\n                    </tr>\n\n                    <tr><td colspan="4" style="text-align: center;"><strong>Jika penerima informasi bukan pasien**, lengkapi isian pada dua kolom di bawah </strong></td></tr>\n                    <tr>\n                      <td style="width: 224px;" colspan="2">Nama Penerima Informasi</td>\n                      <td style="width: 493px; padding-left: 5px; margin: 0;" colspan="2">\n                        <t t-if="'nama-pj' in data">\n                          <span><t t-esc="data['nama-pj']"/></span>\n                        </t>\n                      </td>\n                    </tr>\n                    <tr>\n                      <td style="width: 224px;" colspan="2">Hubungan dengan Pasien</td>\n                      <td style="width: 493px; padding-left: 5px; margin: 0;" colspan="2">\n                        <t t-if="'relasi-pj' in data">\n                          <span><t t-esc="data['relasi-pj']"/></span>\n                        </t>\n                      </td>\n                    </tr>\n                    \n                    <tr style="height: 23px;">\n                      <td style="width: 15px; height: 23px; text-align: center;"><strong>No</strong></td>\n                      <td style="width: 209px; height: 23px; text-align: center;"><strong>JENIS INFORMASI</strong></td>\n                      <td style="width: 493px; height: 23px; text-align: center;"><strong>ISI INFORMASI</strong></td>\n                      <td style="width: 90px; height: 23px; text-align: center;"><strong>Verifikasi</strong></td>\n                    </tr>\n                    <tr style="height: 23px;">\n                      <td style="width: 15px; height: 23px;">1</td>\n                      <td style="width: 209px; height: 23px;">Diagnosis (WD &amp; DD)</td>\n                      <td style="width: 493px; height: 23.5px; padding-left: 5px; margin: 0;">\n                        <t t-if="'diagnosis' in data">\n                          <span><t t-esc="data['diagnosis']"/></span>\n                        </t>\n                      </td>\n                      <td style="width: 90px; height: 23px; text-align: center;">\n                        <span><t t-if="'diagnosis' in data"><b>✓</b></t></span>\n                      </td>\n                    </tr>\n                    <tr style="height: 23px;">\n                      <td style="width: 15px; height: 23px;">2</td>\n                      <td style="width: 209px; height: 23px;">Dasar Diagnosis</td>\n                      <td style="width: 493px; height: 23px; padding-left: 5px; margin: 0;">\n                        <t t-if="'dasar-diagnosis' in data">\n                          <span><t t-esc="data['dasar-diagnosis']"/></span>\n                        </t>\n                      </td>\n                      <td style="width: 90px; height: 23px; text-align: center;">\n                        <span><t t-if="'dasar-diagnosis' in data"><b>✓</b></t></span>\n                      </td>\n                    </tr>\n                    <tr style="height: 23px;">\n                      <td style="width: 15px; height: 23px;">3</td>\n                      <td style="width: 209px; height: 23px;">Tindakan Kedokteran</td>\n                      <td style="width: 493px; height: 23px; padding-left: 5px; margin: 0;">\n                        <t t-if="'tindakan-kedokteran' in data">\n                          <span><t t-esc="data['tindakan-kedokteran']"/></span>\n                        </t>\n                      </td>\n                      <td style="width: 90px; height: 23px; text-align: center;">\n                        <span><t t-if="'tindakan-kedokteran' in data"><b>✓</b></t></span>\n                      </td>\n                    </tr>\n                    <tr style="height: 23px;">\n                      <td style="width: 15px; height: 23px;">4</td>\n                      <td style="width: 209px; height: 23px;">Indikasi Tindakan</td>\n                      <td style="width: 493px; height: 23px; padding-left: 5px; margin: 0;">\n                        <t t-if="'indikasi-tindakan' in data">\n                          <span><t t-esc="data['indikasi-tindakan']"/></span>\n                        </t>\n                      </td>\n                      <td style="width: 90px; height: 23px; text-align: center;">\n                        <span><t t-if="'indikasi-tindakan' in data"><b>✓</b></t></span>\n                      </td>\n                    </tr>\n                    <tr style="height: 23px;">\n                      <td style="width: 15px; height: 23px;">5</td>\n                      <td style="width: 209px; height: 23px;">Tata Cara</td>\n                      <td style="width: 493px; height: 23px; padding-left: 5px; margin: 0;">\n                        <t t-if="'tata-cara' in data">\n                          <span><t t-esc="data['tata-cara']"/></span>\n                        </t>\n                      </td>\n                      <td style="width: 90px; height: 23px; text-align: center;">\n                        <span><t t-if="'tata-cara' in data"><b>✓</b></t></span>\n                      </td>\n                    </tr>\n                    <tr style="height: 23px;">\n                      <td style="width: 15px; height: 23px;">6</td>\n                      <td style="width: 209px; height: 23px;">Tujuan</td>\n                      <td style="width: 493px; height: 23px; padding-left: 5px; margin: 0;">\n                        <t t-if="'tujuan' in data">\n                          <span><t t-esc="data['tujuan']"/></span>\n                        </t>\n                      </td>\n                      <td style="width: 90px; height: 23px; text-align: center;">\n                        <span><t t-if="'tujuan' in data"><b>✓</b></t></span>\n                      </td>\n                    </tr>\n                    <tr style="height: 23px;">\n                      <td style="width: 15px; height: 23px;">7</td>\n                      <td style="width: 209px; height: 23px;">Risiko</td>\n                      <td style="width: 493px; height: 23px; padding-left: 5px; margin: 0;">\n                        <t t-if="'risiko' in data">\n                          <span><t t-esc="data['risiko']"/></span>\n                        </t>\n                      </td>\n                      <td style="width: 90px; height: 23px; text-align: center;">\n                        <span><t t-if="'risiko' in data"><b>✓</b></t></span>\n                      </td>\n                    </tr>\n                    <tr style="height: 23px;">\n                      <td style="width: 15px; height: 23px;">8</td>\n                      <td style="width: 209px; height: 23px;">Komplikasi</td>\n                      <td style="width: 493px; height: 23px; padding-left: 5px; margin: 0;">\n                        <t t-if="'komplikasi' in data">\n                          <span><t t-esc="data['komplikasi']"/></span>\n                        </t>\n                      </td>\n                      <td style="width: 90px; height: 23px; text-align: center;">\n                        <span><t t-if="'komplikasi' in data"><b>✓</b></t></span>\n                      </td>\n                    </tr>\n                    <tr style="height: 23px;">\n                      <td style="width: 15px; height: 23px;">9</td>\n                      <td style="width: 209px; height: 23px;">Prognosis</td>\n                      <td style="width: 493px; height: 23px; padding-left: 5px; margin: 0;">\n                        <t t-if="'prognosis' in data">\n                          <span><t t-esc="data['prognosis']"/></span>\n                        </t>\n                      </td>\n                      <td style="width: 90px; height: 23px; text-align: center;">\n                        <span><t t-if="'prognosis' in data"><b>✓</b></t></span>\n                      </td>\n                    </tr>\n                    <tr style="height: 23px;">\n                      <td style="width: 15px; height: 23px;">10</td>\n                      <td style="width: 209px; height: 23px;">Alternatif &amp; Risiko</td>\n                      <td style="width: 493px; height: 23px; padding-left: 5px; margin: 0;">\n                        <t t-if="'alternatif-risiko' in data">\n                          <span><t t-esc="data['alternatif-risiko']"/></span>\n                        </t>\n                      </td>\n                      <td style="width: 90px; height: 23px; text-align: center;">\n                        <span><t t-if="'alternatif-risiko' in data"><b>✓</b></t></span>\n                      </td>\n                    </tr>\n                    <tr style="height: 23px;">\n                      <td style="width: 15px; height: 23px;">11</td>\n                      <td style="width: 209px; height: 23px;">Lain-lain</td>\n                      <td style="width: 493px; height: 23px; padding-left: 5px; margin: 0;">\n                        <t t-if="'lain-lain' in data">\n                          <span><t t-esc="data['lain-lain']"/></span>\n                        </t>\n                      </td>\n                      <td style="width: 90px; height: 23px; text-align: center;">\n                        <span><t t-if="'lain-lain' in data"><b>✓</b></t></span>\n                      </td>\n                    </tr>\n                    <tr style="height: 23px;">\n                      <td style="width: 15px; height: 23px;"/>\n                      <td style="width: 209px; height: 23px;"/>\n                      <td colspan="2" style="text-align: right;">\n                        <span style="margin-right: 10px;">\n                          <t t-esc="o['operating_unit_id']['company_id']['city']"/> Tanggal : <t t-esc="o.to_date_string(data['registration_date'])"/> Pukul :  <t t-esc="o.to_time_string(data['registration_date'])"/>\n                        </span>\n                      </td>\n                    </tr>\n                  </tbody>\n                </table>\n\n                <table style="width: 100%; margin: 0;" class="table table-bordered table-sm">\n                  <tbody>\n                    <tr>\n                      <td rowspan="2" style="width: 75%; vertical-align: middle;">\n                        Dengan ini menyatakan bahwa saya telah menerangkan hal-hal di atas secara benar dan jelas dan memberikan kesempatan untuk bertanya dan/atau berdiskusi\n                      </td>\n                      <td style="width: 25%; text-align: center;">\n                        Tanda Tangan Dokter:\n                      </td>\n                    </tr>\n                    <tr>\n                      <td>\n                        <div style="width:110px;height:80px; margin: auto;">\n                          <t t-if="'practitioner' in data and data['practitioner'] and 'sign-img' in data['practitioner']">         \n                            <img height="80" t-att-src="data['practitioner']['sign-img']"/>\n                          </t>\n                        </div>\n                      </td>\n                    </tr>\n                    <tr>\n                      <td rowspan="2" style="width: 75%; vertical-align: middle;">\n                        Dengan ini menyatakan bahwa saya telah menerima informasi sebagaimana di atas yang saya beri tanda √ / paraf di kolom kanannya, dan telah memahaminya\n                      </td>\n                      <td style="width: 25%; text-align: center;">\n                        Tanda Tangan Pasien/Wali Pasien:\n                      </td>\n                    </tr>\n                    <tr>\n                      <td>\n                        <t t-if="'sign-pj' in data">\n                          <div style="width:110px;height:80px; margin: auto;">\n                            <img height="80" t-att-src="data['sign-pj']"/>\n                          </div>\n                        </t>\n                      </td>\n                    </tr>\n                  </tbody>\n                </table>\n\n                <div style="page-break-after: always; break-after: always;"> </div>\n\n                <table style="width: 100%; margin: 0;" class="table table-bordered table-sm">\n                  <tbody>\n                    <tr><td style="text-align: center;"><strong>PERSETUJUAN PROSEDUR TINDAKAN MEDIS (CONSENT)</strong></td></tr>\n                    <tr>\n                      <td>\n                        <div class="row mb-1" style="margin: 0px;">Yang bertanda tangan di bawah ini: </div>\n                        <div class="row mb-1">\n                          <div class="col-3">Nama </div>\n                          <div class="col-4">: <t t-if="'nama-pj' in data"> <span><t t-esc="data['nama-pj']"/></span></t> </div>\n                          <div class="col-4"><span><t t-if="o['partner_id']['gender'] == 'male'">Laki-Laki</t><t t-else="">Perempuan</t></span></div>\n                        </div>\n                        <div class="row mb-1">\n                          <div class="col-3">No. KTP/SIM/PASPOR  </div>\n                          <div class="col-4">: <t t-if="'identifier-pj' in data"> <span><t t-esc="data['identifier-pj']"/></span></t></div>\n                          <div class="col-2">Tgl Lahir/Umur</div>\n                          <div class="col-3">:\n                            <t t-if="'tgl-lahir-pj' in data">\n                              <t t-esc="data['tgl-lahir-pj']"/>\n                              ( <t t-esc="o.count_age(data['tgl-lahir-pj'].replace('-', '/'))"/> Th )\n                            </t>\n                          </div>\n                        </div>\n                        <div class="row mb-1">\n                          <div class="col-3">Alamat Pasien  </div>\n                          <div class="col-4">: <span style="margin-right: 15px;"><span><t t-esc="o['partner_id']['street']"/> </span></span></div>\n                          <div class="col-2">Telepon</div>\n                          <div class="col-3">: <t t-if="'telepon-pj' in data"> <span><t t-esc="data['telepon-pj']"/></span></t></div>\n                        </div>\n                      </td>\n                    </tr>\n                    <tr>\n                      <td>\n                        <div class="row mb-1">\n                          <div class="col-3">Hubungan dengan pasien</div>\n                          <div class="col-8">: \n                            <t t-if="'relasi-pj' in data">\n                              <span><t t-esc="data['relasi-pj']"/></span>\n                            </t>\n                          </div>\n                        </div>\n                      </td>\n                    </tr>\n                    <tr>\n                      <td>\n                        <div class="row mb-1">\n                          <div class="col-1"/>\n                          <div class="col-11">Dengan ini menyatakan sesungguhnya, bahwa saya telah menerima informasi yang diberikan oleh dokter sebagaimana di atas dan telah memahaminya. Untuk itu saya memberikan \n                            <t t-if="'jenis-consent' in data and data['jenis-consent'] == 'Persetujuan'">\n                              PERSETUJUAN / <span style="text-decoration: line-through;">PENOLAKAN </span>\n                            </t>\n                            <t t-if="'jenis-consent' in data and data['jenis-consent'] == 'Penolakan'">\n                              <span style="text-decoration: line-through;">PERSETUJUAN</span> / PENOLAKAN \n                            </t>\n                          *  untuk dilakukan tindakan tersebut terhadap : \n                          </div>\n                        </div>\n                        <div class="row mb-1">\n                          <div class="col-3">Nama </div>\n                          <div class="col-4">: <t t-esc="o['partner_id']['name']"/> </div>\n                          <div class="col-4"><span><t t-if="o['partner_id']['gender'] == 'male'">Laki-Laki</t><t t-else="">Perempuan</t></span></div>\n                        </div>\n                        <div class="row mb-1">\n                          <div class="col-3">No. Rekam Medis  </div>\n                          <div class="col-4">: <t t-if="'no-cm' in data"><t t-esc="data['no-cm']"/></t><t t-else="">-</t></div>\n                          <div class="col-2">Tgl Lahir/Umur</div>\n                          <div class="col-3">: \n                            <t t-esc="o['partner_id']['birthDate'].strftime('%d-%m-%Y')"/>  \n                            ( <t t-esc="o.count_age(o['partner_id']['birthDate'].strftime('%d/%m/%Y'))"/> Th )\n                          </div>\n                        </div>\n                        <div class="row mb-1">\n                          <div class="col-3">Alamat Pasien  </div>\n                          <div class="col-8">: <span><span><t t-esc="o['partner_id']['street']"/> </span></span> </div>\n                        </div>\n                        <div class="row mb-1">\n                          <div class="col-1"/>\n                          <div class="col-11">Saya memahami perlunya dan manfaat tindakan tersebut termasuk risiko dan komplikasi yang akan timbul. Saya juga menyadari bahwa ilmu kedokteran bukanlah ilmu pasti, maka keberhasilan tindakan kedokteran bukanlah keniscayaan, melainkan tergantung Tuhan YME\n                          </div>\n                        </div>\n                      </td>\n                    </tr>\n                    <tr>\n                      <td style="text-align: right;">\n                        <span style="margin-right: 10px;">\n                          <t t-esc="o['operating_unit_id']['company_id']['city']"/> Tanggal : <t t-esc="o.to_date_string(data['registration_date'])"/> Pukul :  <t t-esc="o.to_time_string(data['registration_date'])"/>\n                        </span>\n                      </td>\n                    </tr>\n                    <tr>\n                      <td>\n                        <div class="row mt-2" style="page-break-inside: avoid; page-break-before: auto; width: 100%;">\n                          <div class="col-3 text-center">\n                            <div class="mb-1">Yang Menyatakan </div>\n                            <t t-if="'sign-pj' in data">\n                              <div style="width:110px;height:80px; margin: auto;">\n                                  <img height="80" t-att-src="data['sign-pj']"/>\n                              </div>\n                            </t>\n                            <div class="mt-2"><strong>( <t t-esc="data['nama-pj']"/> )</strong></div>\n                          </div>\n                          <div class="col-3 text-center"> \n                            <div class="mb-1">Dokter</div>\n                              <div style="width:110px;height:80px; margin: auto;">\n                                  <t t-if="'practitioner' in data and data['practitioner'] and 'sign-img' in data['practitioner']">          \n                                    <img height="80" t-att-src="data['practitioner']['sign-img']"/>\n                                  </t>\n                              </div>\n                            <div class="mt-2"><strong>( <t t-esc="data['dokter-pelaksana']"/> )</strong> </div>\n                          </div>\n                          <t t-if="'saksi' in data">\n                            <t t-foreach="data['saksi']" t-as="saksi">\n                              <div class="col-3 text-center">\n                                  <div class="mb-1"> Saksi <t t-esc="saksi['saksi-idx']"/></div>\n                                  <t t-if="'sign-img' in saksi">\n                                    <div style="width:110px;height:80px; margin: auto;">\n                                      <img height="80" t-att-src="saksi['sign-img']"/>\n                                    </div>\n                                  </t>\n                                  <p class="mb-0 mt-2"><strong>( <t t-esc="saksi['nama-saksi']"/> )</strong></p>\n                              </div>\n                            </t>\n                          </t>\n                        </div>\n                        <div class="row mt-2" style="margin: 0px;">\n                          ** Bila pasien tidak kompeten atau tidak mau menerima informasi, maka penerima informasi adalah wali atau keluarga terdekat (suami, istri, ayah/ibu kandung, kakak/adik kandung, anak kandung)\t\t\t\t\n                        </div>\n                        <div class="row" style="margin: 0px;">\n                          * Coret pada pernyataan yang tidak sesuai\t\t\t\n                        </div>\n                      </td>\n                    </tr>\n                    \n                  </tbody>\n                </table>\n                \n              </div>\n            </div>\n          </div>\n        </t>\n      </t>\n    	ehealth_document/report/template_informed_consent/report_westerindo_informed_consent.xml	\N	\N	\N	\N	primary	t	1	2025-08-28 11:34:01.364376	1	2025-08-28 11:34:01.364376	f
1583	report_studiosunat_informed_consent	\N	ehealth_document.report_studiosunat_informed_consent	16	qweb	<?xml version="1.0"?>\n<t t-name="ehealth_document.report_studiosunat_informed_consent">\n        <t t-set="company" t-value="res_company"/>\n        <t t-call="ehealth_document.header_studiosunat_document">\n          <div class="page">\n            <div class="row">\n              <div class="col-md-12">\n                <p class="text-center mt-3 mb-0"><strong>PERSETUJUAN TINDAKAN MEDIS</strong></p>\n                <p class="text-center">Nomor: <t t-esc="o['name']"/></p>\n                <p class="mt-3">Saya yang bertanda tangan di bawah ini:</p>\n                <div class="mt-1 ml-3">\n                    <div class="row">\n                        <div class="col-3">Nama</div>\n                        <div class="col-6">: <strong><t t-esc="data['nama-pj']"/></strong></div>\n                    </div>\n                    <t t-if="'tgl-lahir-pj' in data">\n                      <div class="row">\n                        <div class="col-3">Tanggal Lahir</div>\n                        <div class="col-6">: <t t-esc="data['tgl-lahir-pj']"/></div>\n                      </div>\n                    </t>\n                    <div class="row">\n                        <div class="col-3">Jenis Kelamin</div>\n                        <div class="col-6">:\n                          <t t-if="data['jenis-kelamin-pj'] == 'male'">Laki-Laki</t>\n                          <t t-else="">Perempuan</t>\n                        </div>\n                    </div>\n                    <t t-if="'relasi-pj' in data">\n                      <div class="row">\n                          <div class="col-3">Relasi dengan pasien</div>\n                           <div class="col-6">: <t t-esc="data['relasi-pj']"/></div>\n                      </div>\n                    </t>\n                </div>\n                <p>Dengan ini menyatakan dengan sesungguhnya telah menerima informasi yang sejelas-jelasnya\n                  terhadap tindakan medis berupa <strong><t t-esc="data['objek-consent']"/></strong> dan telah memberikan: </p>\n                <p class="mt-2 mb-2 text-center" style="font-size: 20px"><strong><t t-esc="data['jenis-consent']"/></strong></p>\n                <t t-if="'catatan-consent' in data">\n                  <p>Dengan catatan</p>\n                  <p><t t-esc="data['catatan-consent']"/></p>\n                </t>\n                <p>terhadap <t t-esc="data['relasi-pj']"/> saya dengan identitas sebagai berikut: </p>\n                <div class="mt-3 ml-3">\n                    <div class="row">\n                        <div class="col-3">Nama</div>\n                        <div class="col-6">: <strong><t t-esc="o['partner_id']['name']"/></strong></div>\n                    </div>\n                    <div class="row">\n                        <div class="col-3">Tanggal Lahir</div>\n                        <div class="col-6">: <t t-esc="o['partner_id']['birthDate'].strftime('%d-%m-%Y')"/></div>\n                    </div>\n                    <div class="row">\n                        <div class="col-3">Jenis Kelamin</div>\n                        <div class="col-6">:\n                          <t t-if="o['partner_id']['gender'] == 'male'">Laki-Laki</t>\n                          <t t-else="">Perempuan</t>\n                        </div>\n                    </div>\n                    <div class="row">\n                        <div class="col-3">Alamat</div>\n                        <div class="col-6">: <t t-esc="o['partner_id']['street']"/></div>\n                    </div>\n                    <t t-if="'no-cm' in data">\n                        <div class="row">\n                            <div class="col-3">No. CM</div>\n                            <div class="col-6">: <t t-esc="data['no-cm']"/></div>\n                        </div>\n                    </t>\n                </div>\n                <p class="mt-3" style="page-break-inside: avoid; page-break-before: auto;">Saya menyatakan paham dan mengerti akan tindakan yang akan dilakukan beserta resiko,\n                  komplikasi dan segala sesuatu yang merupakan akibat dari tindakan tersebut. Saya juga menyadari bahwa\n                  tindakan ini bukanlah keniscayaan, melainkan sangat tergantung pada izin Tuhan Yang Maha Esa.\n                  Dan saya tidak akan menyalahkan/menuntut pihak pelaksana KHITAN terhadap akibat yang ditimbulkan\n                  dari tindakan diatas di kemudian hari.</p>\n                <p>Demikian surat pernyataan ini saya buat tanpa ada paksaan dari pihak manapun, untuk dapat dipergunakan sebagaimana mestinya.</p><br/>\n              </div>\n            </div>\n\n            <div class="row" style="page-break-inside: avoid; page-break-before: auto;">\n                <div class="col-4">\n                    <p class="pt-3 mb-2">Yang Mengkhitan</p>\n                    <div style="width:110px;height:80px;"/>\n                     <p class="mb-0 mt-2"><strong><t t-esc="data['dokter-pelaksana'] if 'dokter-pelaksana' in data and data['dokter-pelaksana'] else '-'"/></strong></p>\n                </div>\n                <div class="col-4"/>\n                <div class="col-4">\n                    <p class="mb-0">JAKARTA, <t t-esc="o.to_date_string(data['registration_date'])"/></p>\n                    <p class="mb-0">Yang Memberi Persetujuan</p>\n                    <t t-if="'sign-pj' in data">\n                      <div style="width:110px;height:80px;">\n                          <img height="80" t-att-src="data['sign-pj']"/>\n                        </div>\n                    </t>\n                    <p class="mb-0 mt-2"><strong><t t-esc="data['nama-pj']"/></strong></p>\n                </div>\n            </div>\n            <div class="row mt-3" style="page-break-inside: avoid; page-break-before: auto;">\n                <t t-if="'nama-saksi-1' in data">\n                  <div class="col-4">\n                    <p class="mb-0">Saksi 1</p>\n                    <div style="width:110px;height:80px;"/>\n                    <p class="mb-0 mt-2"><strong><t t-esc="o.arrange_signature(data['nama-saksi-1'])"/></strong></p>\n                  </div>\n                </t>\n                <t t-if="'nama-saksi-2' in data">\n                  <div class="col-4"/>\n                  <div class="col-4">\n                    <p class="mb-0">Saksi 2</p>\n                    <div style="width:110px;height:80px;"/>\n                    <p class="mb-0 mt-2"><strong><t t-esc="o.arrange_signature(data['nama-saksi-2'])"/></strong></p>\n                  </div>\n                </t>\n            </div>\n          </div>\n        </t>\n      </t>\n    	ehealth_document/report/template_informed_consent/report_studiosunat_informed_consent.xml	\N	\N	\N	\N	primary	t	1	2025-08-28 11:34:01.364376	1	2025-08-28 11:34:01.364376	f
639	account.account.type.form	account.account.type	\N	16	form	<?xml version="1.0"?>\n<form string="Account Type">\n                    <group>\n                        <group>\n                            <field name="name"/>\n                            <field name="type"/>\n                        </group>\n                        <group>\n                            <field name="include_initial_balance"/>\n                        </group>\n                    </group>\n                    <separator string="Description"/>\n                    <field name="note"/>\n                </form>\n            	account/views/account_account_type_views.xml	\N	\N	\N	\N	primary	t	1	2025-08-28 11:32:28.994214	1	2025-08-28 11:32:28.994214	f
640	account.account.form	account.account	\N	16	form	<?xml version="1.0"?>\n<form string="Account">\n                   <sheet>\n                        <div class="oe_button_box" name="button_box">\n                            <button class="oe_stat_button" name="account.action_move_line_select" string="Journal Items" type="action" icon="fa-bars"/>\n                        </div>\n                       <div class="oe_title">\n                           <h1 class="oe_read_only">\n                             <field name="code" placeholder="code"/> - <field name="name" placeholder="name"/>\n                             <field name="company_id" invisible="1"/>\n                           </h1>\n                           <div class="oe_inline oe_edit_only">\n                             <label for="code"/>\n                             <field name="code" placeholder="code"/>\n                             <label for="name"/>\n                             <field name="name" placeholder="name"/>\n                           </div>\n                       </div>\n                       <group>\n                           <group name="left_main_group">\n                             <field name="company_id" options="{'no_create': True}" groups="base.group_multi_company"/>\n                             <field name="user_type_id" widget="account_hierarchy_selection"/>\n                             <field name="group_id"/>\n                             <field name="internal_type" invisible="1" readonly="1"/>\n                             <field name="internal_group" invisible="1" readonly="1"/>\n                           </group>\n                           <group name="right_main_group">\n                             <field name="currency_id" options="{'no_create': True}" groups="base.group_multi_currency"/>\n                             <field name="deprecated"/>\n                           </group>\n                           <group string="Account Options" name="options_group">\n                             <field name="tax_ids" widget="many2many_tags" domain="[('company_id','=',company_id)]" attrs="{'invisible': [('internal_group', '=', 'off_balance')]}"/>\n                             <field name="tag_ids" widget="many2many_tags" domain="[('applicability', '!=', 'taxes')]" context="{'default_applicability': 'accounts'}" options="{'no_create_edit': True}"/>\n                           </group>\n                           <group string="Security" name="security_group">\n                             <field name="allowed_journal_ids" widget="many2many_tags" domain="[('company_id','=',company_id)]" options="{'no_create_edit': True}"/>\n                           </group>\n                       </group>\n                    </sheet>\n                </form>\n            	account/views/account_account_views.xml	\N	\N	\N	\N	primary	t	1	2025-08-28 11:32:28.994214	1	2025-08-28 11:32:28.994214	f
1584	report_diatrans_informed_consent	\N	ehealth_document.report_diatrans_informed_consent	16	qweb	<?xml version="1.0"?>\n<t t-name="ehealth_document.report_diatrans_informed_consent">\n        <t t-set="company" t-value="res_company"/>\n        <t t-call="ehealth_document.header_diatrans_document">\n          <div class="page">\n            <div class="row">\n              <div class="col-md-12">\n                <p class="text-center mt-3 mb-0"><strong>INFORM CONSENT</strong></p>\n                <p class="text-center">Nomor: <t t-esc="o['name']"/></p>\n                <p class="mt-3">Dengan ini menyatakan persetujuan  untuk dilakukan tindakan Hemodialisis dan penggunaaan Dialiser Single Use terhadap saya bernama:</p>\n                <div class="mt-1 ml-3">\n                    <div class="row">\n                        <div class="col-3">Nama</div>\n                        <div class="col-6">: <strong><t t-esc="o['partner_id']['name']"/></strong></div>\n                    </div>\n                    <div class="row">\n                      <div class="col-3">Tanggal Lahir</div>\n                      <div class="col-6">: <t t-esc="o['partner_id']['birthDate'].strftime('%d-%m-%Y')"/></div>\n                    </div>\n                    <div class="row">\n                        <div class="col-3">Alamat</div>\n                        <div class="col-6">: <t t-esc="o['partner_id']['street']"/></div>\n                    </div>\n                </div>\n                <p style="page-break-inside: avoid; page-break-before: auto;">Saya memahami perlunya dan manfaat tindakan tersebut sebagaimana telah dijelaskan seperti diatas kepada saya, termasuk resiko dan komplikasi yang timbul.\n                  Saya juga menyadari bahwa oleh karena ilmu kedokteran bukanlah ilmu pasti, maka keberhasilan tindakan kedokteran bukanlah keniscayaan melainkan sangat bergantung kepada izin Tuhan Yang Maha Esa.</p>\n              </div>\n            </div>\n\n            <div class="row" style="page-break-inside: avoid; page-break-before: auto;">\n                <div class="col-4">\n                    <p class="pt-3 mb-2"/>\n                    <div t-att-src="o['qr_code_url']" style="width:110px;height:110px;"/>\n                    <p class="mb-0 mt-2"><strong/></p>\n                </div>\n                <div class="col-4"/>\n                <div class="col-4">\n                    <p class="mb-0"><t t-esc="o['operating_unit_id']['company_id']['city']"/>, <t t-esc="o.to_date_string(data['registration_date'])"/></p>\n                    <p class="mb-0">Yang Menyatakan</p>\n                    <div style="width:110px;height:80px;"/>\n                    <p class="mb-0 mt-2"><strong><t t-esc="o['partner_id']['name']"/></strong></p>\n                </div>\n            </div>\n          </div>\n        </t>\n      </t>\n    	ehealth_document/report/template_informed_consent/report_diatrans_informed_consent.xml	\N	\N	\N	\N	primary	t	1	2025-08-28 11:34:01.364376	1	2025-08-28 11:34:01.364376	f
1585	report_assyifa_informed_consent	\N	ehealth_document.report_assyifa_informed_consent	16	qweb	<?xml version="1.0"?>\n<t t-name="ehealth_document.report_assyifa_informed_consent">\n        <t t-set="company" t-value="res_company"/>\n        <t t-call="ehealth_document.header_assyifa_document">\n          <div class="page">\n            <div class="row">\n              <div class="col-md-12">\n                <p class="text-center mt-3 mb-0"><strong>Surat Pernyataan Tindakan Medis</strong></p>\n                <p class="text-center">Nomor: <t t-esc="o['name']"/></p>\n                <p class="mt-3">Yang bertanda tangan di bawah ini, saya:</p>\n                <div class="mt-1 ml-3">\n                    <div class="row">\n                        <div class="col-3">Nama</div>\n                        <div class="col-6">: <strong><t t-esc="data['nama-pj']"/></strong></div>\n                    </div>\n                    <t t-if="'umur-pj' in data">\n                      <div class="row">\n                        <div class="col-3">Umur</div>\n                        <div class="col-6">: <t t-esc="data['umur-pj']"/></div>\n                      </div>\n                    </t>\n                    <t t-if="'tgl-lahir-pj' in data">\n                      <div class="row">\n                        <div class="col-3">Tanggal Lahir</div>\n                        <div class="col-6">: <t t-esc="data['tgl-lahir-pj']"/></div>\n                      </div>\n                    </t>\n                    <div class="row">\n                        <div class="col-3">Jenis Kelamin</div>\n                        <div class="col-6">:\n                          <t t-if="data['jenis-kelamin-pj'] == 'male'">Laki-Laki</t>\n                          <t t-else="">Perempuan</t>\n                        </div>\n                    </div>\n                    <t t-if="'relasi-pj' in data">\n                      <div class="row">\n                          <div class="col-3">Relasi dengan pasien</div>\n                           <div class="col-6">: <t t-esc="data['relasi-pj']"/></div>\n                      </div>\n                    </t>\n                </div>\n                <p>Dengan ini saya menyatakan dengan sesungguhnya telah memberikan</p>\n                <p class="mt-2 mb-2 text-center"><strong><t t-esc="data['jenis-consent']"/></strong></p>\n                <t t-if="'tujuan-consent' in data">\n                  <p>untuk dilakukan <t t-esc="data['tujuan-consent']"/> berupa</p>\n                </t>\n                <t t-else="">\n                  <p>untuk dilakukan pemeriksaan, pengobatan dan tindakan medis berupa</p>\n                </t>\n                <p class="mt-2 mb-2 text-center"><t t-esc="data['objek-consent']"/></p>\n                <t t-if="'catatan-consent' in data">\n                  <p>Dengan catatan</p>\n                  <p><t t-esc="data['catatan-consent']"/></p>\n                </t>\n                <p>terhadap <t t-esc="data['relasi-pj']"/> saya dengan identitas sebagai berikut: </p>\n                <div class="mt-3 ml-3">\n                    <div class="row">\n                        <div class="col-3">Nama</div>\n                        <div class="col-6">: <strong><t t-esc="o['partner_id']['name']"/></strong></div>\n                    </div>\n                    <div class="row">\n                        <div class="col-3">Tanggal Lahir</div>\n                        <div class="col-6">: <t t-esc="o['partner_id']['birthDate'].strftime('%d-%m-%Y')"/></div>\n                    </div>\n                    <div class="row">\n                        <div class="col-3">Jenis Kelamin</div>\n                        <div class="col-6">:\n                          <t t-if="o['partner_id']['gender'] == 'male'">Laki-Laki</t>\n                          <t t-else="">Perempuan</t>\n                        </div>\n                    </div>\n                    <div class="row">\n                        <div class="col-3">Alamat</div>\n                        <div class="col-6">: <t t-esc="o['partner_id']['street']"/></div>\n                    </div>\n                    <t t-if="'no-cm' in data">\n                        <div class="row">\n                            <div class="col-3">No. CM</div>\n                            <div class="col-6">: <t t-esc="data['no-cm']"/></div>\n                        </div>\n                    </t>\n                </div>\n                <p class="mt-3" style="page-break-inside: avoid; page-break-before: auto;">yang cara, manfaat dan tujuan serta resiko yang ditimbulkan dari pemeriksaan, pengobatan serta tindakan medis tersebut di atas telah dijelaskan oleh dokter dan saya telah mengerti sepenuhnya.</p>\n                <p>Demikian pernyataan ini saya buat dengan penuh kesadaran dan tanpa paksaan agar dapat dipergunakan sebagaimana mestinya.</p><br/>\n              </div>\n            </div>\n\n            <div class="row" style="page-break-inside: avoid; page-break-before: auto;">\n                <div class="col-4">\n                    <p class="pt-3 mb-2">Dokter yang Memberi Penjelasan</p>\n                    <div style="width:110px;height:80px;">\n                      <t t-if="data['practitioner'] and 'sign-img' in data['practitioner']">          \n                        <img height="80" t-att-src="data['practitioner']['sign-img']"/>\n                      </t>\n                    </div>\n                   <p class="mb-0 mt-2"><strong><t t-esc="data['dokter-pelaksana'] if 'dokter-pelaksana' in data and data['dokter-pelaksana'] else '-'"/></strong></p>\n                </div>\n                <div class="col-4"/>\n                <div class="col-4">\n                    <p class="mb-0"><t t-esc="o['operating_unit_id']['company_id']['city']"/>, <t t-esc="o.to_date_string(data['registration_date'])"/></p>\n                    <p class="mb-0">Yang Memberi Pernyataan</p>\n                    <t t-if="'sign-pj' in data">\n                      <div style="width:110px;height:80px;">\n                          <img height="80" t-att-src="data['sign-pj']"/>\n                        </div>\n                    </t>\n                    <p class="mb-0 mt-2"><strong><t t-esc="data['nama-pj']"/></strong></p>\n                </div>\n            </div>\n            <div class="row mt-3" style="page-break-inside: avoid; page-break-before: auto;">\n                <t t-if="'nama-saksi-1' in data">\n                  <div class="col-4">\n                    <p class="mb-0">Saksi 1</p>\n                    <div style="width:110px;height:80px;"/>\n                    <p class="mb-0 mt-2"><strong><t t-esc="o.arrange_signature(data['nama-saksi-1'])"/></strong></p>\n                  </div>\n                </t>\n                <t t-if="'nama-saksi-2' in data">\n                  <div class="col-4"/>\n                  <div class="col-4">\n                    <p class="mb-0">Saksi 2</p>\n                    <div style="width:110px;height:80px;"/>\n                    <p class="mb-0 mt-2"><strong><t t-esc="o.arrange_signature(data['nama-saksi-2'])"/></strong></p>\n                  </div>\n                </t>\n                <t t-if="'saksi' in data">\n                  <t t-foreach="data['saksi']" t-as="saksi">\n                    <div class="col-4">\n                        <p> Saksi\n                            <t t-esc="saksi['saksi-idx']"/>\n                        </p>\n                        <div style="width:110px;height:80px;">\n                          <img height="80" t-att-src="saksi['sign-img']"/>\n                        </div>\n                        <p class="mb-0 mt-2"><strong><t t-esc="o.arrange_signature(saksi['nama-saksi'])"/></strong></p>\n                    </div>\n                    <div class="col-4"/>\n                  </t>\n                </t>\n            </div>\n          </div>\n        </t>\n      </t>\n    	ehealth_document/report/template_informed_consent/report_assyifa_informed_consent.xml	\N	\N	\N	\N	primary	t	1	2025-08-28 11:34:01.364376	1	2025-08-28 11:34:01.364376	f
1586	report_yayumedika_informed_consent	\N	ehealth_document.report_yayumedika_informed_consent	16	qweb	<?xml version="1.0"?>\n<t t-name="ehealth_document.report_yayumedika_informed_consent">\n        <t t-set="company" t-value="res_company"/>\n        <t t-call="ehealth_document.header_yayumedika_document">\n          <div class="page" style="font-size:13px; line-height: 1.4;">\n            <div class="" style="border: 1px solid #dee2e6">\n              <div class="">\n                <div style="border-bottom: 1px solid #dee2e6">\n                  <p class="text-center mb-0" style="width: 100%;">\n                    <strong>PEMBERIAN INFORMASI</strong>\n                  </p>\n                </div>\n                <table style="width: 100%; margin: 0;" class="table table-bordered table-sm">\n                  <tbody>\n                    <tr>\n                      <td style="width: 224px;" colspan="2">Dokter Pelaksana Tindakan</td>\n                      <td style="width: 493px; padding-left: 5px; margin: 0;" colspan="2">\n                        <t t-if="'dokter-pelaksana' in data">\n                          <span><t t-esc="data['dokter-pelaksana']"/></span>\n                        </t>\n                      </td>\n                    </tr>\n                    <tr>\n                      <td style="width: 224px;" colspan="2">Pemberi Informasi</td>\n                      <td style="width: 493px; padding-left: 5px; margin: 0;" colspan="2">\n                        <t t-if="'pemberi-informasi' in data">\n                          <span><t t-esc="data['pemberi-informasi']"/></span>\n                        </t>\n                      </td>\n                    </tr>\n                    <tr style="height: 23.5px;">\n                      <td style="width: 224px; height: 23.5px;" colspan="2">Penerima Informasi / pemberi persetujuan</td>\n                      <td style="width: 493px; height: 23.5px; padding-left: 5px; margin: 0;" colspan="2">\n                        <t t-if="'penerima-informasi' in data">\n                          <span><t t-esc="data['penerima-informasi']"/></span>\n                        </t>\n                      </td>\n                    </tr>\n                    <tr style="height: 23px;">\n                      <td style="width: 15px; height: 23px;"/>\n                      <td style="width: 209px; height: 23px;">JENIS INFORMASI</td>\n                      <td style="width: 493px; height: 23px; text-align: center;">ISI INFORMASI</td>\n                      <td style="width: 90px; height: 23px;">TANDA (v)</td>\n                    </tr>\n                    <tr style="height: 23px;">\n                      <td style="width: 15px; height: 23px;">1</td>\n                      <td style="width: 209px; height: 23px;">Diagnosis (WD &amp; DD)</td>\n                      <td style="width: 493px; height: 23.5px; padding-left: 5px; margin: 0;">\n                        <t t-if="'diagnosis' in data">\n                          <span><t t-esc="data['diagnosis']"/></span>\n                        </t>\n                      </td>\n                      <td style="width: 90px; height: 23px; text-align: center;">\n                        <span><t t-if="'diagnosis' in data">v</t></span>\n                      </td>\n                    </tr>\n                    <tr style="height: 23px;">\n                      <td style="width: 15px; height: 23px;">2</td>\n                      <td style="width: 209px; height: 23px;">Dasar Diagnosis</td>\n                      <td style="width: 493px; height: 23px; padding-left: 5px; margin: 0;">\n                        <t t-if="'dasar-diagnosis' in data">\n                          <span><t t-esc="data['dasar-diagnosis']"/></span>\n                        </t>\n                      </td>\n                      <td style="width: 90px; height: 23px; text-align: center;">\n                        <span><t t-if="'dasar-diagnosis' in data">v</t></span>\n                      </td>\n                    </tr>\n                    <tr style="height: 23px;">\n                      <td style="width: 15px; height: 23px;">3</td>\n                      <td style="width: 209px; height: 23px;">Tindakan Kedokteran</td>\n                      <td style="width: 493px; height: 23px; padding-left: 5px; margin: 0;">\n                        <t t-if="'tindakan-kedokteran' in data">\n                          <span><t t-esc="data['tindakan-kedokteran']"/></span>\n                        </t>\n                      </td>\n                      <td style="width: 90px; height: 23px; text-align: center;">\n                        <span><t t-if="'tindakan-kedokteran' in data">v</t></span>\n                      </td>\n                    </tr>\n                    <tr style="height: 23px;">\n                      <td style="width: 15px; height: 23px;">4</td>\n                      <td style="width: 209px; height: 23px;">Indikasi Tindakan</td>\n                      <td style="width: 493px; height: 23px; padding-left: 5px; margin: 0;">\n                        <t t-if="'indikasi-tindakan' in data">\n                          <span><t t-esc="data['indikasi-tindakan']"/></span>\n                        </t>\n                      </td>\n                      <td style="width: 90px; height: 23px; text-align: center;">\n                        <span><t t-if="'indikasi-tindakan' in data">v</t></span>\n                      </td>\n                    </tr>\n                    <tr style="height: 23px;">\n                      <td style="width: 15px; height: 23px;">5</td>\n                      <td style="width: 209px; height: 23px;">Tata Cara</td>\n                      <td style="width: 493px; height: 23px; padding-left: 5px; margin: 0;">\n                        <t t-if="'tata-cara' in data">\n                          <span><t t-esc="data['tata-cara']"/></span>\n                        </t>\n                      </td>\n                      <td style="width: 90px; height: 23px; text-align: center;">\n                        <span><t t-if="'tata-cara' in data">v</t></span>\n                      </td>\n                    </tr>\n                    <tr style="height: 23px;">\n                      <td style="width: 15px; height: 23px;">6</td>\n                      <td style="width: 209px; height: 23px;">Tujuan</td>\n                      <td style="width: 493px; height: 23px; padding-left: 5px; margin: 0;">\n                        <t t-if="'tujuan' in data">\n                          <span><t t-esc="data['tujuan']"/></span>\n                        </t>\n                      </td>\n                      <td style="width: 90px; height: 23px; text-align: center;">\n                        <span><t t-if="'tujuan' in data">v</t></span>\n                      </td>\n                    </tr>\n                    <tr style="height: 23px;">\n                      <td style="width: 15px; height: 23px;">7</td>\n                      <td style="width: 209px; height: 23px;">Risiko</td>\n                      <td style="width: 493px; height: 23px; padding-left: 5px; margin: 0;">\n                        <t t-if="'risiko' in data">\n                          <span><t t-esc="data['risiko']"/></span>\n                        </t>\n                      </td>\n                      <td style="width: 90px; height: 23px; text-align: center;">\n                        <span><t t-if="'risiko' in data">v</t></span>\n                      </td>\n                    </tr>\n                    <tr style="height: 23px;">\n                      <td style="width: 15px; height: 23px;">8</td>\n                      <td style="width: 209px; height: 23px;">Komplikasi</td>\n                      <td style="width: 493px; height: 23px; padding-left: 5px; margin: 0;">\n                        <t t-if="'komplikasi' in data">\n                          <span><t t-esc="data['komplikasi']"/></span>\n                        </t>\n                      </td>\n                      <td style="width: 90px; height: 23px; text-align: center;">\n                        <span><t t-if="'komplikasi' in data">v</t></span>\n                      </td>\n                    </tr>\n                    <tr style="height: 23px;">\n                      <td style="width: 15px; height: 23px;">9</td>\n                      <td style="width: 209px; height: 23px;">Prognosis</td>\n                      <td style="width: 493px; height: 23px; padding-left: 5px; margin: 0;">\n                        <t t-if="'prognosis' in data">\n                          <span><t t-esc="data['prognosis']"/></span>\n                        </t>\n                      </td>\n                      <td style="width: 90px; height: 23px; text-align: center;">\n                        <span><t t-if="'prognosis' in data">v</t></span>\n                      </td>\n                    </tr>\n                    <tr style="height: 23px;">\n                      <td style="width: 15px; height: 23px;">10</td>\n                      <td style="width: 209px; height: 23px;">Alternatif &amp; Risiko</td>\n                      <td style="width: 493px; height: 23px; padding-left: 5px; margin: 0;">\n                        <t t-if="'alternatif-risiko' in data">\n                          <span><t t-esc="data['alternatif-risiko']"/></span>\n                        </t>\n                      </td>\n                      <td style="width: 90px; height: 23px; text-align: center;">\n                        <span><t t-if="'alternatif-risiko' in data">v</t></span>\n                      </td>\n                    </tr>\n                    <tr style="height: 23px;">\n                      <td style="width: 15px; height: 23px;"/>\n                      <td style="width: 209px; height: 23px;">Lain-lain</td>\n                      <td style="width: 493px; height: 23px; padding-left: 5px; margin: 0;">\n                        <t t-if="'lain-lain' in data">\n                          <span><t t-esc="data['lain-lain']"/></span>\n                        </t>\n                      </td>\n                      <td style="width: 90px; height: 23px; text-align: center;">\n                        <span><t t-if="'lain-lain' in data">v</t></span>\n                      </td>\n                    </tr>\n                    <tr style="height: 26px;">\n                      <td style="width: 717px; height: 26px;" colspan="3">Dengan ini menyatakan bahwa saya telah menerangkan hal-hal di atas secara benar dan jelas dan memberikan kesempatan untuk bertanya dan/atau berdiskusi</td>\n                      <td style="width: 90px; height: 26px;"/>\n                    </tr>\n                    <tr>\n                      <td style="width: 717px;" colspan="3">\n                        Dengan ini menyatakan bahwa saya telah menerima informasi sebagaimana di atas yang saya beri tanda/paraf di kolom kanannya, dan telah memahaminya\n                      </td>\n                      <td style="width: 90px;"/>\n                    </tr>\n                    <tr style="height: 23px;">\n                      <td style="width: 798.75px; height: 18px;" colspan="4">\n                        <div class="page" title="Page 34">\n                          <div class="layoutArea">\n                            <div class="column">\n                              <p>* Bila pasien tidak kompeten atau tidak mau menerima informasi, maka penerima informasi adalah wali atau keluarga terdekat</p>\n                            </div>\n                          </div>\n                        </div>\n                      </td>\n                    </tr>\n                    <tr style="height: 23px;">\n                      <td style="width: 798.75px; height: 23px; text-align: center;" colspan="4">\n                        <p class="text-center mb-0" style="width: 100%;">\n                          <strong><span style="text-transform: uppercase;"> <t t-esc="data['jenis-consent']"/> </span> TINDAKAN KEDOKTERAN</strong>\n                        </p>\n                      </td>\n                    </tr>\n                    <tr style="height: 23px;">\n                      <td style="width: 798.75px; height: 23px; page-break-inside: avoid; page-break-before: auto;" colspan="4">\n                        Yang bertandatangan di bawah ini, saya ,\n                        nama <span style="text-decoration: underline;"><t t-esc="data['nama-pj'] if 'nama-pj' in data and data['nama-pj'] else '-'"/></span>, \n                        umur <span style="text-decoration: underline;"><t t-esc="data['umur-pj'] if 'umur-pj' in data and data['umur-pj'] else '-'"/></span> tahun,\n                        <span style="text-decoration: underline;"><t t-esc="o.get_gender(data['jenis-kelamin-pj']) if 'jenis-kelamin-pj' in data and data['jenis-kelamin-pj'] else '-'"/></span>, \n                        alamat <span style="text-decoration: underline;"><t t-esc="data['alamat-pj'] if 'alamat-pj' in data and data['alamat-pj'] else '-'"/></span>, \n                        dengan ini menyatakan <span style="text-transform: lowercase;"><t t-esc="data['jenis-consent'] if 'jenis-consent' in data and data['jenis-consent'] else '-'"/></span> \n                        untuk dilakukannya tindakan <span style="text-decoration: underline;"><t t-esc="data['objek-consent'] if 'objek-consent' in data and data['objek-consent'] else '-'"/></span> \n                        terhadap <span style="text-decoration: underline;"><t t-esc="data['relasi-pj'] if 'relasi-pj' in data and data['relasi-pj'] else '-'"/></span> saya \n                        bernama <span style="text-decoration: underline;"><t t-esc="o['partner_id'].name if o['partner_id'] and o['partner_id'].name else '-'"/></span>, \n                        umur <span style="text-decoration: underline;"><t t-esc="o.count_age(o['partner_id'].birthDate.strftime('%d/%m/%Y')) if o['partner_id'] and o['partner_id'].birthDate else '-'"/></span> tahun, \n                        <span style="text-decoration: underline;"><t t-esc="'Laki-Laki' if o['partner_id'] and o['partner_id'].gender == 'male' else 'Perempuan' if o['partner_id'] and o['partner_id'].gender == 'female' else '-'"/></span>, \n                        alamat <span style="text-decoration: underline;"><t t-esc="o['partner_id'].street if o['partner_id'] and o['partner_id'].street else '-'"/></span>.\n                        <div>Saya memahami perlunya dan manfaat tindakan tersebut sebagaimana telah dijelaskan seperti di atas kepada saya, termasuk risiko dan komplikasi yang mungkin timbul.</div>\n                        <div>Saya juga menyadari bahwa oleh karena ilmu kedokteran bukanlah ilmu pasti, maka keberhasilan tindakan kedokteran bukanlah keniscayaan, melainkan sangat bergantung kepada izin Tuhan Yang Maha Esa.</div>\n                        <p class="mb-0 mt-2"><t t-esc="o['operating_unit_id']['company_id']['city']"/>, tanggal <t t-esc="o.to_date_string(data['registration_date'])"/>  pukul  <t t-esc="o.to_time_string(data['registration_date'])"/></p>\n                        <div class="row" style="page-break-inside: avoid; page-break-before: auto;">\n                          <div class="col-4">\n                              <p class="pt-3 mb-2">Yang menyatakan</p>\n                              <div style="width:110px;height:80px;"/>\n                              <p class="mb-0 mt-2">(<strong><t t-esc="data['penerima-informasi'] if 'penerima-informasi' in data and data['penerima-informasi'] else '-'"/></strong>)</p>\n                          </div>\n                          <t t-if="'saksi' in data">\n                            <t t-foreach="data['saksi']" t-as="saksi">\n                              <div class="col-4">\n                                <p class="pt-3 ml-3 mb-0">Saksi:</p>\n                                <div style="width:110px;height:80px;">\n                                  <t t-if="'sign-img' in saksi">\n                                    <div style="width:110px;height:80px; margin: auto;">\n                                      <img height="80" t-att-src="saksi['sign-img']"/>\n                                    </div>\n                                  </t>\n                                </div>\n                                <p class="mb-0 mt-2">\n                                  (<strong><t t-esc="o.arrange_signature(saksi['nama-saksi']) if saksi.get('nama-saksi') else '-'"/></strong>)\n                                </p>\n                              </div>\n                            </t>\n                          </t>\n                      </div>\n                      </td>\n                    </tr>\n                  </tbody>\n                </table>\n              </div>\n            </div>\n          </div>\n        </t>\n      </t>\n    	ehealth_document/report/template_informed_consent/report_yayumedika_informed_consent.xml	\N	\N	\N	\N	primary	t	1	2025-08-28 11:34:01.364376	1	2025-08-28 11:34:01.364376	f
1587	report_devara_informed_consent	\N	ehealth_document.report_devara_informed_consent	16	qweb	<?xml version="1.0"?>\n<t t-name="ehealth_document.report_devara_informed_consent">\n        <t t-set="company" t-value="res_company"/>\n        <t t-call="ehealth_document.header_devara_document">\n          <div class="page" style="font-size:13px; line-height: 1.4;">\n            <div class="" style="">\n              <div class="">\n\n                <table style="width: 100%; margin: 0;" class="table table-bordered table-sm">\n                  <thead><tr><th colspan="4" style="text-align: center;"><strong>PEMBERIAN INFORMASI</strong></th></tr></thead>\n                  <tbody>\n                    <tr>\n                      <td style="width: 224px;" colspan="2">Nama &amp; Jabatan Pemberi Informasi</td>\n                      <td style="width: 493px; padding-left: 5px; margin: 0;" colspan="2">\n                        <t t-if="'dokter-pelaksana' in data">\n                          <span><t t-esc="data['dokter-pelaksana']"/></span>\n                        </t>\n                      </td>\n                    </tr>\n                    <tr>\n                      <td style="width: 224px;" colspan="2">Nama Pasien</td>\n                      <td style="width: 493px; padding-left: 5px; margin: 0;" colspan="2">\n                        <span><t t-esc="o['partner_id']['name']"/> </span>\n                      </td>\n                    </tr>\n                    <tr>\n                      <td style="width: 224px;" colspan="2">Nomor Rekam Medis</td>\n                      <td style="width: 493px; padding-left: 5px; margin: 0;" colspan="2">\n                        <t t-if="'no-cm' in data">\n                          <span><t t-esc="data['no-cm']"/></span>\n                        </t>\n                      </td>\n                    </tr>\n                    <tr>\n                      <td style="width: 224px;" colspan="2">Tempat/Tanggal Lahir</td>\n                      <td style="width: 493px; padding-left: 5px; margin: 0;" colspan="2">\n                        <span> <t t-esc="o['partner_id']['birth_place']"/></span>,\n                        <span> <t t-esc="o['partner_id']['birthDate'].strftime('%d-%m-%Y')"/></span>\n                        (<span> <t t-esc="o.count_age(o['partner_id']['birthDate'].strftime('%d/%m/%Y'))"/></span> Tahun)\n                      </td>\n                    </tr>\n                    <tr>\n                      <td style="width: 224px;" colspan="2">Jenis Kelamin</td>\n                      <td style="width: 493px; padding-left: 5px; margin: 0;" colspan="2">\n                        <span><t t-if="o['partner_id']['gender'] == 'male'">Laki-Laki</t><t t-else="">Perempuan</t></span>\n                      </td>\n                    </tr>\n                    <tr>\n                      <td style="width: 224px;" colspan="2">Alamat Pasien</td>\n                      <td style="width: 493px; padding-left: 5px; margin: 0;" colspan="2">\n                        <span><t t-esc="o['partner_id']['street']"/> </span>\n                      </td>\n                    </tr>\n\n                    <tr><td colspan="4" style="text-align: center;"><strong>Jika penerima informasi bukan pasien**, lengkapi isian pada dua kolom di bawah </strong></td></tr>\n                    <tr>\n                      <td style="width: 224px;" colspan="2">Nama Penerima Informasi</td>\n                      <td style="width: 493px; padding-left: 5px; margin: 0;" colspan="2">\n                        <t t-if="'nama-pj' in data">\n                          <span><t t-esc="data['nama-pj']"/></span>\n                        </t>\n                      </td>\n                    </tr>\n                    <tr>\n                      <td style="width: 224px;" colspan="2">Hubungan dengan Pasien</td>\n                      <td style="width: 493px; padding-left: 5px; margin: 0;" colspan="2">\n                        <t t-if="'relasi-pj' in data">\n                          <span><t t-esc="data['relasi-pj']"/></span>\n                        </t>\n                      </td>\n                    </tr>\n                    \n                    <tr style="height: 23px;">\n                      <td style="width: 15px; height: 23px; text-align: center;"><strong>No</strong></td>\n                      <td style="width: 209px; height: 23px; text-align: center;"><strong>JENIS INFORMASI</strong></td>\n                      <td style="width: 493px; height: 23px; text-align: center;"><strong>ISI INFORMASI</strong></td>\n                      <td style="width: 90px; height: 23px; text-align: center;"><strong>Verifikasi</strong></td>\n                    </tr>\n                    <tr style="height: 23px;">\n                      <td style="width: 15px; height: 23px;">1</td>\n                      <td style="width: 209px; height: 23px;">Diagnosis (WD &amp; DD)</td>\n                      <td style="width: 493px; height: 23.5px; padding-left: 5px; margin: 0;">\n                        <t t-if="'diagnosis' in data">\n                          <span><t t-esc="data['diagnosis']"/></span>\n                        </t>\n                      </td>\n                      <td style="width: 90px; height: 23px; text-align: center;">\n                        <span><t t-if="'diagnosis' in data"><b>✓</b></t></span>\n                      </td>\n                    </tr>\n                    <tr style="height: 23px;">\n                      <td style="width: 15px; height: 23px;">2</td>\n                      <td style="width: 209px; height: 23px;">Dasar Diagnosis</td>\n                      <td style="width: 493px; height: 23px; padding-left: 5px; margin: 0;">\n                        <t t-if="'dasar-diagnosis' in data">\n                          <span><t t-esc="data['dasar-diagnosis']"/></span>\n                        </t>\n                      </td>\n                      <td style="width: 90px; height: 23px; text-align: center;">\n                        <span><t t-if="'dasar-diagnosis' in data"><b>✓</b></t></span>\n                      </td>\n                    </tr>\n                    <tr style="height: 23px;">\n                      <td style="width: 15px; height: 23px;">3</td>\n                      <td style="width: 209px; height: 23px;">Tindakan Kedokteran</td>\n                      <td style="width: 493px; height: 23px; padding-left: 5px; margin: 0;">\n                        <t t-if="'tindakan-kedokteran' in data">\n                          <span><t t-esc="data['tindakan-kedokteran']"/></span>\n                        </t>\n                      </td>\n                      <td style="width: 90px; height: 23px; text-align: center;">\n                        <span><t t-if="'tindakan-kedokteran' in data"><b>✓</b></t></span>\n                      </td>\n                    </tr>\n                    <tr style="height: 23px;">\n                      <td style="width: 15px; height: 23px;">4</td>\n                      <td style="width: 209px; height: 23px;">Indikasi Tindakan</td>\n                      <td style="width: 493px; height: 23px; padding-left: 5px; margin: 0;">\n                        <t t-if="'indikasi-tindakan' in data">\n                          <span><t t-esc="data['indikasi-tindakan']"/></span>\n                        </t>\n                      </td>\n                      <td style="width: 90px; height: 23px; text-align: center;">\n                        <span><t t-if="'indikasi-tindakan' in data"><b>✓</b></t></span>\n                      </td>\n                    </tr>\n                    <tr style="height: 23px;">\n                      <td style="width: 15px; height: 23px;">5</td>\n                      <td style="width: 209px; height: 23px;">Tata Cara</td>\n                      <td style="width: 493px; height: 23px; padding-left: 5px; margin: 0;">\n                        <t t-if="'tata-cara' in data">\n                          <span><t t-esc="data['tata-cara']"/></span>\n                        </t>\n                      </td>\n                      <td style="width: 90px; height: 23px; text-align: center;">\n                        <span><t t-if="'tata-cara' in data"><b>✓</b></t></span>\n                      </td>\n                    </tr>\n                    <tr style="height: 23px;">\n                      <td style="width: 15px; height: 23px;">6</td>\n                      <td style="width: 209px; height: 23px;">Tujuan</td>\n                      <td style="width: 493px; height: 23px; padding-left: 5px; margin: 0;">\n                        <t t-if="'tujuan' in data">\n                          <span><t t-esc="data['tujuan']"/></span>\n                        </t>\n                      </td>\n                      <td style="width: 90px; height: 23px; text-align: center;">\n                        <span><t t-if="'tujuan' in data"><b>✓</b></t></span>\n                      </td>\n                    </tr>\n                    <tr style="height: 23px;">\n                      <td style="width: 15px; height: 23px;">7</td>\n                      <td style="width: 209px; height: 23px;">Risiko</td>\n                      <td style="width: 493px; height: 23px; padding-left: 5px; margin: 0;">\n                        <t t-if="'risiko' in data">\n                          <span><t t-esc="data['risiko']"/></span>\n                        </t>\n                      </td>\n                      <td style="width: 90px; height: 23px; text-align: center;">\n                        <span><t t-if="'risiko' in data"><b>✓</b></t></span>\n                      </td>\n                    </tr>\n                    <tr style="height: 23px;">\n                      <td style="width: 15px; height: 23px;">8</td>\n                      <td style="width: 209px; height: 23px;">Komplikasi</td>\n                      <td style="width: 493px; height: 23px; padding-left: 5px; margin: 0;">\n                        <t t-if="'komplikasi' in data">\n                          <span><t t-esc="data['komplikasi']"/></span>\n                        </t>\n                      </td>\n                      <td style="width: 90px; height: 23px; text-align: center;">\n                        <span><t t-if="'komplikasi' in data"><b>✓</b></t></span>\n                      </td>\n                    </tr>\n                    <tr style="height: 23px;">\n                      <td style="width: 15px; height: 23px;">9</td>\n                      <td style="width: 209px; height: 23px;">Prognosis</td>\n                      <td style="width: 493px; height: 23px; padding-left: 5px; margin: 0;">\n                        <t t-if="'prognosis' in data">\n                          <span><t t-esc="data['prognosis']"/></span>\n                        </t>\n                      </td>\n                      <td style="width: 90px; height: 23px; text-align: center;">\n                        <span><t t-if="'prognosis' in data"><b>✓</b></t></span>\n                      </td>\n                    </tr>\n                    <tr style="height: 23px;">\n                      <td style="width: 15px; height: 23px;">10</td>\n                      <td style="width: 209px; height: 23px;">Alternatif &amp; Risiko</td>\n                      <td style="width: 493px; height: 23px; padding-left: 5px; margin: 0;">\n                        <t t-if="'alternatif-risiko' in data">\n                          <span><t t-esc="data['alternatif-risiko']"/></span>\n                        </t>\n                      </td>\n                      <td style="width: 90px; height: 23px; text-align: center;">\n                        <span><t t-if="'alternatif-risiko' in data"><b>✓</b></t></span>\n                      </td>\n                    </tr>\n                    <tr style="height: 23px;">\n                      <td style="width: 15px; height: 23px;">11</td>\n                      <td style="width: 209px; height: 23px;">Lain-lain</td>\n                      <td style="width: 493px; height: 23px; padding-left: 5px; margin: 0;">\n                        <t t-if="'lain-lain' in data">\n                          <span><t t-esc="data['lain-lain']"/></span>\n                        </t>\n                      </td>\n                      <td style="width: 90px; height: 23px; text-align: center;">\n                        <span><t t-if="'lain-lain' in data"><b>✓</b></t></span>\n                      </td>\n                    </tr>\n                    <tr style="height: 23px;">\n                      <td style="width: 15px; height: 23px;"/>\n                      <td style="width: 209px; height: 23px;"/>\n                      <td colspan="2" style="text-align: right;">\n                        <span style="margin-right: 10px;">\n                          <t t-esc="o['operating_unit_id']['company_id']['city']"/> Tanggal : <t t-esc="o.to_date_string(data['registration_date'])"/> Pukul :  <t t-esc="o.to_time_string(data['registration_date'])"/>\n                        </span>\n                      </td>\n                    </tr>\n                  </tbody>\n                </table>\n\n                <table style="width: 100%; margin: 0;" class="table table-bordered table-sm">\n                  <tbody>\n                    <tr>\n                      <td rowspan="2" style="width: 75%; vertical-align: middle;">\n                        Dengan ini menyatakan bahwa saya telah menerangkan hal-hal di atas secara benar dan jelas dan memberikan kesempatan untuk bertanya dan/atau berdiskusi\n                      </td>\n                      <td style="width: 25%; text-align: center;">\n                        Tanda Tangan Dokter:\n                      </td>\n                    </tr>\n                    <tr>\n                        <td>\n                          <div style="width:110px;height:80px; margin: auto;">\n                            <t t-if="'practitioner' in data">\n                              <t t-if="data['practitioner'] and 'sign-img' in data['practitioner']">\n                                  <img t-att-src="data['practitioner']['sign-img']" alt="Logo" height="80"/>\n                              </t>\n                            </t>\n                            <t t-else=""/>\n                          </div>\n                        </td>\n                    </tr>\n                    <tr>\n                      <td rowspan="2" style="width: 75%; vertical-align: middle;">\n                        Dengan ini menyatakan bahwa saya telah menerima informasi sebagaimana di atas yang saya beri tanda √ / paraf di kolom kanannya, dan telah memahaminya\n                      </td>\n                      <td style="width: 25%; text-align: center;">\n                        Tanda Tangan Pasien/Wali Pasien:\n                      </td>\n                    </tr>\n                    <tr>\n                      <td>\n                        <t t-if="'sign-pj' in data">\n                          <div style="width:110px;height:80px; margin: auto;">\n                            <img height="80" t-att-src="data['sign-pj']"/>\n                          </div>\n                        </t>\n                      </td>\n                    </tr>\n                  </tbody>\n                </table>\n\n                <div style="page-break-after: always; break-after: always;"> </div>\n\n                <table style="width: 100%; margin: 0;" class="table table-bordered table-sm">\n                  <tbody>\n                    <tr><td style="text-align: center;"><strong>PERSETUJUAN PROSEDUR TINDAKAN MEDIS (CONSENT)</strong></td></tr>\n                    <tr>\n                      <td>\n                        <div class="row mb-1" style="margin: 0px;">Yang bertanda tangan di bawah ini: </div>\n                        <div class="row mb-1">\n                          <div class="col-3">Nama </div>\n                          <div class="col-4">: <t t-if="'nama-pj' in data"> <span><t t-esc="data['nama-pj']"/></span></t> </div>\n                          <div class="col-4"><span><t t-if="o['partner_id']['gender'] == 'male'">Laki-Laki</t><t t-else="">Perempuan</t></span></div>\n                        </div>\n                        <div class="row mb-1">\n                          <div class="col-3">No. KTP/SIM/PASPOR  </div>\n                          <div class="col-4">: <t t-if="'identifier-pj' in data"> <span><t t-esc="data['identifier-pj']"/></span></t></div>\n                          <div class="col-2">Tgl Lahir/Umur</div>\n                          <div class="col-3">:\n                            <t t-if="'tgl-lahir-pj' in data">\n                              <t t-esc="data['tgl-lahir-pj']"/>\n                              ( <t t-esc="o.count_age(data['tgl-lahir-pj'].replace('-', '/'))"/> Th )\n                            </t>\n                          </div>\n                        </div>\n                        <div class="row mb-1">\n                          <div class="col-3">Alamat Pasien  </div>\n                          <div class="col-4">: <span style="margin-right: 15px;"><span><t t-esc="o['partner_id']['street']"/> </span></span></div>\n                          <div class="col-2">Telepon</div>\n                          <div class="col-3">: <t t-if="'telepon-pj' in data"> <span><t t-esc="data['telepon-pj']"/></span></t></div>\n                        </div>\n                      </td>\n                    </tr>\n                    <tr>\n                      <td>\n                        <div class="row mb-1">\n                          <div class="col-3">Hubungan dengan pasien</div>\n                          <div class="col-8">: \n                            <t t-if="'relasi-pj' in data">\n                              <span><t t-esc="data['relasi-pj']"/></span>\n                            </t>\n                          </div>\n                        </div>\n                      </td>\n                    </tr>\n                    <tr>\n                      <td>\n                        <div class="row mb-1">\n                          <div class="col-1"/>\n                          <div class="col-11">Dengan ini menyatakan sesungguhnya, bahwa saya telah menerima informasi yang diberikan oleh dokter sebagaimana di atas dan telah memahaminya. Untuk itu saya memberikan \n                            <t t-if="'jenis-consent' in data and data['jenis-consent'] == 'Persetujuan'">\n                              PERSETUJUAN / <span style="text-decoration: line-through;">PENOLAKAN </span>\n                            </t>\n                            <t t-if="'jenis-consent' in data and data['jenis-consent'] == 'Penolakan'">\n                              <span style="text-decoration: line-through;">PERSETUJUAN</span> / PENOLAKAN \n                            </t>\n                          *  untuk dilakukan tindakan tersebut terhadap : \n                          </div>\n                        </div>\n                        <div class="row mb-1">\n                          <div class="col-3">Nama </div>\n                          <div class="col-4">: <t t-esc="o['partner_id']['name']"/> </div>\n                          <div class="col-4"><span><t t-if="o['partner_id']['gender'] == 'male'">Laki-Laki</t><t t-else="">Perempuan</t></span></div>\n                        </div>\n                        <div class="row mb-1">\n                          <div class="col-3">No. Rekam Medis  </div>\n                          <div class="col-4">: <t t-if="'no-cm' in data"><t t-esc="data['no-cm']"/></t><t t-else="">-</t></div>\n                          <div class="col-2">Tgl Lahir/Umur</div>\n                          <div class="col-3">: \n                            <t t-esc="o['partner_id']['birthDate'].strftime('%d-%m-%Y')"/>  \n                            ( <t t-esc="o.count_age(o['partner_id']['birthDate'].strftime('%d/%m/%Y'))"/> Th )\n                          </div>\n                        </div>\n                        <div class="row mb-1">\n                          <div class="col-3">Alamat Pasien  </div>\n                          <div class="col-8">: <span><span><t t-esc="o['partner_id']['street']"/> </span></span> </div>\n                        </div>\n                        <div class="row mb-1">\n                          <div class="col-1"/>\n                          <div class="col-11">Saya memahami perlunya dan manfaat tindakan tersebut termasuk risiko dan komplikasi yang akan timbul. Saya juga menyadari bahwa ilmu kedokteran bukanlah ilmu pasti, maka keberhasilan tindakan kedokteran bukanlah keniscayaan, melainkan tergantung Tuhan YME\n                          </div>\n                        </div>\n                      </td>\n                    </tr>\n                    <tr>\n                      <td style="text-align: right;">\n                        <span style="margin-right: 10px;">\n                          <t t-esc="o['operating_unit_id']['company_id']['city']"/> Tanggal : <t t-esc="o.to_date_string(data['registration_date'])"/> Pukul :  <t t-esc="o.to_time_string(data['registration_date'])"/>\n                        </span>\n                      </td>\n                    </tr>\n                    <tr>\n                      <td>\n                        <div class="row mt-2" style="page-break-inside: avoid; page-break-before: auto; width: 100%;">\n                          <div class="col-3 text-center">\n                            <div class="mb-1">Yang Menyatakan </div>\n                            <t t-if="'sign-pj' in data">\n                              <div style="width:110px;height:80px; margin: auto;">\n                                  <img height="80" t-att-src="data['sign-pj']"/>\n                              </div>\n                            </t>\n                            <div class="mt-2"><strong>( <t t-esc="data['nama-pj']"/> )</strong></div>\n                          </div>\n                          <div class="col-3 text-center"> \n                            <div class="mb-1">Dokter</div>\n                              <div style="width:110px;height:80px; margin: auto;">\n                                <t t-if="'practitioner' in data">\n                                  <t t-if="data['practitioner'] and 'sign-img' in data['practitioner']">          \n                                    <img height="80" t-att-src="data['practitioner']['sign-img']"/>\n                                  </t>\n                                </t>\n                                <t t-else=""/>\n                              </div>\n                            <div class="mt-2"><strong>( <t t-esc="data['dokter-pelaksana']"/> )</strong> </div>\n                          </div>\n                          <t t-if="'saksi' in data">\n                            <t t-foreach="data['saksi']" t-as="saksi">\n                              <div class="col-3 text-center">\n                                  <div class="mb-1"> Saksi <t t-esc="saksi['saksi-idx']"/></div>\n                                  <t t-if="'sign-img' in saksi">\n                                    <div style="width:110px;height:80px; margin: auto;">\n                                      <img height="80" t-att-src="saksi['sign-img']"/>\n                                    </div>\n                                  </t>\n                                  <p class="mb-0 mt-2"><strong>( <t t-esc="saksi['nama-saksi']"/> )</strong></p>\n                              </div>\n                            </t>\n                          </t>\n                        </div>\n                        <div class="row mt-2" style="margin: 0px;">\n                          ** Bila pasien tidak kompeten atau tidak mau menerima informasi, maka penerima informasi adalah wali atau keluarga terdekat (suami, istri, ayah/ibu kandung, kakak/adik kandung, anak kandung)\t\t\t\t\n                        </div>\n                        <div class="row" style="margin: 0px;">\n                          * Coret pada pernyataan yang tidak sesuai\t\t\t\n                        </div>\n                      </td>\n                    </tr>\n                    \n                  </tbody>\n                </table>\n                \n              </div>\n            </div>\n          </div>\n        </t>\n      </t>\n    	ehealth_document/report/template_informed_consent/report_devara_informed_consent.xml	\N	\N	\N	\N	primary	t	1	2025-08-28 11:34:01.364376	1	2025-08-28 11:34:01.364376	f
1588	report_nsbeny_informed_consent	\N	ehealth_document.report_nsbeny_informed_consent	16	qweb	<?xml version="1.0"?>\n<t t-name="ehealth_document.report_nsbeny_informed_consent">\n        <t t-set="company" t-value="res_company"/>\n        <t t-call="ehealth_document.header_nsbeny_document">\n          <div class="page">\n            <div class="row">\n              <div class="col-md-12">\n                <p class="text-center mt-3 mb-0"><strong>Surat Pernyataan Tindakan Medis</strong></p>\n                <p class="text-center">Nomor: <t t-esc="o['name']"/></p>\n                <p class="mt-3">Yang bertanda tangan di bawah ini, saya:</p>\n                <div class="mt-1 ml-3">\n                    <div class="row">\n                        <div class="col-3">Nama</div>\n                        <div class="col-6">: <strong><t t-esc="data['nama-pj']"/></strong></div>\n                    </div>\n                    <t t-if="'umur-pj' in data">\n                      <div class="row">\n                        <div class="col-3">Umur</div>\n                        <div class="col-6">: <t t-esc="data['umur-pj']"/></div>\n                      </div>\n                    </t>\n                    <t t-if="'tgl-lahir-pj' in data">\n                      <div class="row">\n                        <div class="col-3">Tanggal Lahir</div>\n                        <div class="col-6">: <t t-esc="data['tgl-lahir-pj']"/></div>\n                      </div>\n                    </t>\n                    <div class="row">\n                        <div class="col-3">Jenis Kelamin</div>\n                        <div class="col-6">:\n                          <t t-if="data['jenis-kelamin-pj'] == 'male'">Laki-Laki</t>\n                          <t t-else="">Perempuan</t>\n                        </div>\n                    </div>\n                    <t t-if="'relasi-pj' in data">\n                      <div class="row">\n                          <div class="col-3">Relasi dengan pasien</div>\n                           <div class="col-6">: <t t-esc="data['relasi-pj']"/></div>\n                      </div>\n                    </t>\n                </div>\n                <p>Dengan ini saya menyatakan dengan sesungguhnya telah memberikan</p>\n                <p class="mt-2 mb-2 text-center"><strong><t t-esc="data['jenis-consent']"/></strong></p>\n                <t t-if="'tujuan-consent' in data">\n                  <p>untuk dilakukan <t t-esc="data['tujuan-consent']"/> berupa</p>\n                </t>\n                <t t-else="">\n                  <p>untuk dilakukan pemeriksaan, pengobatan dan tindakan medis berupa</p>\n                </t>\n                <p class="mt-2 mb-2 text-center"><t t-esc="data['objek-consent']"/></p>\n                <t t-if="'catatan-consent' in data">\n                  <p>Dengan catatan</p>\n                  <p><t t-esc="data['catatan-consent']"/></p>\n                </t>\n                <p>terhadap <t t-esc="data['relasi-pj']"/> saya dengan identitas sebagai berikut: </p>\n                <div class="mt-3 ml-3">\n                    <div class="row">\n                        <div class="col-3">Nama</div>\n                        <div class="col-6">: <strong><t t-esc="o['partner_id']['name']"/></strong></div>\n                    </div>\n                    <div class="row">\n                        <div class="col-3">Tanggal Lahir</div>\n                        <div class="col-6">: <t t-esc="o['partner_id']['birthDate'].strftime('%d-%m-%Y')"/></div>\n                    </div>\n                    <div class="row">\n                        <div class="col-3">Jenis Kelamin</div>\n                        <div class="col-6">: \n                          <t t-if="o['partner_id']['gender'] == 'male'">Laki-Laki</t>\n                          <t t-else="">Perempuan</t>\n                        </div>\n                    </div>\n                    <div class="row">\n                        <div class="col-3">Alamat</div>\n                        <div class="col-6">: <t t-esc="o['partner_id']['street']"/></div>\n                    </div>\n                    <t t-if="'no-cm' in data">\n                        <div class="row">\n                            <div class="col-3">No. CM</div>\n                            <div class="col-6">: <t t-esc="data['no-cm']"/></div>\n                        </div>\n                    </t>\n                </div>\n                <p class="mt-3" style="page-break-inside: avoid; page-break-before: auto;">yang cara, manfaat dan tujuan serta resiko yang ditimbulkan dari pemeriksaan, pengobatan serta tindakan medis tersebut di atas telah dijelaskan oleh dokter dan saya telah mengerti sepenuhnya.</p>\n                <p>Demikian pernyataan ini saya buat dengan penuh kesadaran dan tanpa paksaan agar dapat dipergunakan sebagaimana mestinya.</p><br/>\n              </div>\n            </div>\n\n            <div class="row" style="page-break-inside: avoid; page-break-before: auto;">\n                <div class="col-4">\n                    <p class="pt-3 mb-2">Yang Memberi Penjelasan</p>\n                    <div style="width:110px;height:80px;"/>\n                    <p class="mb-0 mt-2"><strong>Ns. Beny Hermawanto, S.Kep</strong></p>\n                </div>\n                <div class="col-4"/>\n                <div class="col-4">\n                    <p class="mb-0"><t t-esc="o['operating_unit_id']['company_id']['city']"/>, <t t-esc="o.to_date_string(data['registration_date'])"/></p>\n                    <p class="mb-0">Yang Memberi Pernyataan</p>\n                    <t t-if="'sign-pj' in data">\n                      <div style="width:110px;height:80px;">\n                          <img height="80" t-att-src="data['sign-pj']"/>\n                        </div>\n                    </t>\n                    <p class="mb-0 mt-2"><strong><t t-esc="data['nama-pj']"/></strong></p>\n                </div>\n            </div>\n            <div class="row mt-3" style="page-break-inside: avoid; page-break-before: auto;">\n                <t t-if="'nama-saksi-1' in data">\n                  <div class="col-4">\n                    <p class="mb-0">Saksi 1</p>\n                    <div style="width:110px;height:80px;"/>\n                    <p class="mb-0 mt-2"><strong><t t-esc="o.arrange_signature(data['nama-saksi-1'])"/></strong></p>\n                  </div>\n                </t>\n                <t t-if="'nama-saksi-2' in data">\n                  <div class="col-4"/>\n                  <div class="col-4">\n                    <p class="mb-0">Saksi 2</p>\n                    <div style="width:110px;height:80px;"/>\n                    <p class="mb-0 mt-2"><strong><t t-esc="o.arrange_signature(data['nama-saksi-2'])"/></strong></p>\n                  </div>\n                </t>\n                <t t-if="'saksi' in data">\n                  <t t-foreach="data['saksi']" t-as="saksi">\n                    <div class="col-4">\n                        <p> Saksi\n                            <t t-esc="saksi['saksi-idx']"/>\n                        </p>\n                        <div style="width:110px;height:80px;">\n                          <img height="80" t-att-src="saksi['sign-img']"/>\n                        </div>\n                        <p class="mb-0 mt-2"><strong><t t-esc="o.arrange_signature(saksi['nama-saksi'])"/></strong></p>\n                    </div>\n                    <div class="col-4"/>\n                  </t>\n                </t>\n            </div>\n          </div>\n        </t>\n      </t>\n    	ehealth_document/report/template_informed_consent/report_nsbeny_informed_consent.xml	\N	\N	\N	\N	primary	t	1	2025-08-28 11:34:01.364376	1	2025-08-28 11:34:01.364376	f
641	account.account.list	account.account	\N	16	tree	<?xml version="1.0"?>\n<tree editable="top" create="1" delete="1" multi_edit="1" string="Chart of accounts">\n                    <field name="code"/>\n                    <field name="name"/>\n                    <field name="user_type_id" widget="account_hierarchy_selection"/>\n                    <field name="group_id" optional="hide"/>\n                    <field name="internal_type" invisible="1"/>\n                    <field name="internal_group" invisible="1"/>\n                    <field name="reconcile" widget="boolean_toggle" attrs="{'invisible': ['|', ('internal_type','=','liquidity'), ('internal_group', '=', 'off_balance')]}"/>\n                    <field name="tax_ids" optional="hide" widget="many2many_tags"/>\n                    <field name="tag_ids" optional="hide" widget="many2many_tags"/>\n                    <field name="allowed_journal_ids" optional="hide" widget="many2many_tags"/>\n                    <field name="currency_id" options="{'no_create': True}" groups="base.group_multi_currency"/>\n                    <field name="company_id" options="{'no_create': True}" groups="base.group_multi_company"/>\n                    <button name="action_read_account" type="object" string="Setup" class="float-right btn-secondary"/>\n                </tree>\n            	account/views/account_account_views.xml	\N	\N	\N	\N	primary	t	1	2025-08-28 11:32:28.994214	1	2025-08-28 11:32:28.994214	f
642	account.account.kanban	account.account	\N	16	kanban	<?xml version="1.0"?>\n<kanban class="o_kanban_mobile">\n                    <field name="name"/>\n                    <field name="code"/>\n                    <field name="user_type_id"/>\n                    <templates>\n                        <t t-name="kanban-box">\n                            <div t-attf-class="oe_kanban_global_click">\n                                <div class="row">\n                                    <div class="col-6">\n                                        <strong><field name="name"/></strong>\n                                    </div>\n                                    <div class="col-6 text-right">\n                                        <span class="badge badge-pill"><t t-esc="record.code.value"/></span>\n                                    </div>\n                                </div>\n                                <div>\n                                    <strong>Type: </strong><t t-esc="record.user_type_id.value"/>\n                                </div>\n                            </div>\n                        </t>\n                    </templates>\n                </kanban>\n            	account/views/account_account_views.xml	\N	\N	\N	\N	primary	t	1	2025-08-28 11:32:28.994214	1	2025-08-28 11:32:28.994214	f
1589	report_akamedicalcenter_informed_consent	\N	ehealth_document.report_akamedicalcenter_informed_consent	16	qweb	<?xml version="1.0"?>\n<t t-name="ehealth_document.report_akamedicalcenter_informed_consent">\n      <t t-set="company" t-value="res_company"/>\n      <t t-call="ehealth_document.header_akamedicalcenter_document">\n        <div class="page" style="font-size:13px; line-height: 1.4;">\n          <div class="" style="">\n            <div class="">\n\n              <table style="width: 100%; margin: 0;" class="table table-bordered table-sm">\n                <thead>\n                  <tr>\n                    <th colspan="4" style="text-align: center;">\n                      <strong>PEMBERIAN INFORMASI</strong>\n                    </th>\n                  </tr>\n                </thead>\n                <tbody>\n                  <tr>\n                    <td style="width: 224px;" colspan="2">Nama &amp; Jabatan Pemberi Informasi</td>\n                    <td style="width: 493px; padding-left: 5px; margin: 0;" colspan="2">\n                      <t t-if="'dokter-pelaksana' in data">\n                        <span>\n                          <t t-esc="data['dokter-pelaksana']"/>\n                        </span>\n                      </t>\n                    </td>\n                  </tr>\n                  <tr>\n                    <td style="width: 224px;" colspan="2">Nama Pasien</td>\n                    <td style="width: 493px; padding-left: 5px; margin: 0;" colspan="2">\n                      <span>\n                        <t t-esc="o['partner_id']['name']"/>\n                      </span>\n                    </td>\n                  </tr>\n                  <tr>\n                    <td style="width: 224px;" colspan="2">Nomor Rekam Medis</td>\n                    <td style="width: 493px; padding-left: 5px; margin: 0;" colspan="2">\n                      <t t-if="'no-cm' in data">\n                        <span>\n                          <t t-esc="data['no-cm']"/>\n                        </span>\n                      </t>\n                    </td>\n                  </tr>\n                  <tr>\n                    <td style="width: 224px;" colspan="2">Tempat/Tanggal Lahir</td>\n                    <td style="width: 493px; padding-left: 5px; margin: 0;" colspan="2">\n                      <span>\n                        <t t-esc="o['partner_id']['birth_place']"/>\n                      </span>, <span>\n                        <t t-esc="o['partner_id']['birthDate'].strftime('%d-%m-%Y')"/>\n                      </span>\n                      (<span>\n                        <t t-esc="o.count_age(o['partner_id']['birthDate'].strftime('%d/%m/%Y'))"/>\n                      </span>\n                      Tahun) </td>\n                  </tr>\n                  <tr>\n                    <td style="width: 224px;" colspan="2">Jenis Kelamin</td>\n                    <td style="width: 493px; padding-left: 5px; margin: 0;" colspan="2">\n                      <span>\n                        <t t-if="o['partner_id']['gender'] == 'male'">Laki-Laki</t>\n                        <t t-else="">Perempuan</t>\n                      </span>\n                    </td>\n                  </tr>\n                  <tr>\n                    <td style="width: 224px;" colspan="2">Alamat Pasien</td>\n                    <td style="width: 493px; padding-left: 5px; margin: 0;" colspan="2">\n                      <span>\n                        <t t-esc="o['partner_id']['street']"/>\n                      </span>\n                    </td>\n                  </tr>\n\n                  <tr>\n                    <td colspan="4" style="text-align: center;">\n                      <strong>Jika penerima informasi bukan pasien**, lengkapi isian pada dua kolom\n                        di bawah </strong>\n                    </td>\n                  </tr>\n                  <tr>\n                    <td style="width: 224px;" colspan="2">Nama Penerima Informasi</td>\n                    <td style="width: 493px; padding-left: 5px; margin: 0;" colspan="2">\n                      <t t-if="'nama-pj' in data">\n                        <span>\n                          <t t-esc="data['nama-pj']"/>\n                        </span>\n                      </t>\n                    </td>\n                  </tr>\n                  <tr>\n                    <td style="width: 224px;" colspan="2">Hubungan dengan Pasien</td>\n                    <td style="width: 493px; padding-left: 5px; margin: 0;" colspan="2">\n                      <t t-if="'relasi-pj' in data">\n                        <span>\n                          <t t-esc="data['relasi-pj']"/>\n                        </span>\n                      </t>\n                    </td>\n                  </tr>\n\n                  <tr style="height: 23px;">\n                    <td style="width: 15px; height: 23px; text-align: center;">\n                      <strong>No</strong>\n                    </td>\n                    <td style="width: 209px; height: 23px; text-align: center;">\n                      <strong>JENIS INFORMASI</strong>\n                    </td>\n                    <td style="width: 493px; height: 23px; text-align: center;">\n                      <strong>ISI INFORMASI</strong>\n                    </td>\n                    <td style="width: 90px; height: 23px; text-align: center;">\n                      <strong>Verifikasi</strong>\n                    </td>\n                  </tr>\n                  <tr style="height: 23px;">\n                    <td style="width: 15px; height: 23px;">1</td>\n                    <td style="width: 209px; height: 23px;">Diagnosis (WD &amp; DD)</td>\n                    <td style="width: 493px; height: 23.5px; padding-left: 5px; margin: 0;">\n                      <t t-if="'diagnosis' in data">\n                        <span>\n                          <t t-esc="data['diagnosis']"/>\n                        </span>\n                      </t>\n                    </td>\n                    <td style="width: 90px; height: 23px; text-align: center;">\n                      <span>\n                        <t t-if="'diagnosis' in data">\n                          <b>✓</b>\n                        </t>\n                      </span>\n                    </td>\n                  </tr>\n                  <tr style="height: 23px;">\n                    <td style="width: 15px; height: 23px;">2</td>\n                    <td style="width: 209px; height: 23px;">Dasar Diagnosis</td>\n                    <td style="width: 493px; height: 23px; padding-left: 5px; margin: 0;">\n                      <t t-if="'dasar-diagnosis' in data">\n                        <span>\n                          <t t-esc="data['dasar-diagnosis']"/>\n                        </span>\n                      </t>\n                    </td>\n                    <td style="width: 90px; height: 23px; text-align: center;">\n                      <span>\n                        <t t-if="'dasar-diagnosis' in data">\n                          <b>✓</b>\n                        </t>\n                      </span>\n                    </td>\n                  </tr>\n                  <tr style="height: 23px;">\n                    <td style="width: 15px; height: 23px;">3</td>\n                    <td style="width: 209px; height: 23px;">Tindakan Kedokteran</td>\n                    <td style="width: 493px; height: 23px; padding-left: 5px; margin: 0;">\n                      <t t-if="'tindakan-kedokteran' in data">\n                        <span>\n                          <t t-esc="data['tindakan-kedokteran']"/>\n                        </span>\n                      </t>\n                    </td>\n                    <td style="width: 90px; height: 23px; text-align: center;">\n                      <span>\n                        <t t-if="'tindakan-kedokteran' in data">\n                          <b>✓</b>\n                        </t>\n                      </span>\n                    </td>\n                  </tr>\n                  <tr style="height: 23px;">\n                    <td style="width: 15px; height: 23px;">4</td>\n                    <td style="width: 209px; height: 23px;">Indikasi Tindakan</td>\n                    <td style="width: 493px; height: 23px; padding-left: 5px; margin: 0;">\n                      <t t-if="'indikasi-tindakan' in data">\n                        <span>\n                          <t t-esc="data['indikasi-tindakan']"/>\n                        </span>\n                      </t>\n                    </td>\n                    <td style="width: 90px; height: 23px; text-align: center;">\n                      <span>\n                        <t t-if="'indikasi-tindakan' in data">\n                          <b>✓</b>\n                        </t>\n                      </span>\n                    </td>\n                  </tr>\n                  <tr style="height: 23px;">\n                    <td style="width: 15px; height: 23px;">5</td>\n                    <td style="width: 209px; height: 23px;">Tata Cara</td>\n                    <td style="width: 493px; height: 23px; padding-left: 5px; margin: 0;">\n                      <t t-if="'tata-cara' in data">\n                        <span>\n                          <t t-esc="data['tata-cara']"/>\n                        </span>\n                      </t>\n                    </td>\n                    <td style="width: 90px; height: 23px; text-align: center;">\n                      <span>\n                        <t t-if="'tata-cara' in data">\n                          <b>✓</b>\n                        </t>\n                      </span>\n                    </td>\n                  </tr>\n                  <tr style="height: 23px;">\n                    <td style="width: 15px; height: 23px;">6</td>\n                    <td style="width: 209px; height: 23px;">Tujuan</td>\n                    <td style="width: 493px; height: 23px; padding-left: 5px; margin: 0;">\n                      <t t-if="'tujuan' in data">\n                        <span>\n                          <t t-esc="data['tujuan']"/>\n                        </span>\n                      </t>\n                    </td>\n                    <td style="width: 90px; height: 23px; text-align: center;">\n                      <span>\n                        <t t-if="'tujuan' in data">\n                          <b>✓</b>\n                        </t>\n                      </span>\n                    </td>\n                  </tr>\n                  <tr style="height: 23px;">\n                    <td style="width: 15px; height: 23px;">7</td>\n                    <td style="width: 209px; height: 23px;">Risiko</td>\n                    <td style="width: 493px; height: 23px; padding-left: 5px; margin: 0;">\n                      <t t-if="'risiko' in data">\n                        <span>\n                          <t t-esc="data['risiko']"/>\n                        </span>\n                      </t>\n                    </td>\n                    <td style="width: 90px; height: 23px; text-align: center;">\n                      <span>\n                        <t t-if="'risiko' in data">\n                          <b>✓</b>\n                        </t>\n                      </span>\n                    </td>\n                  </tr>\n                  <tr style="height: 23px;">\n                    <td style="width: 15px; height: 23px;">8</td>\n                    <td style="width: 209px; height: 23px;">Komplikasi</td>\n                    <td style="width: 493px; height: 23px; padding-left: 5px; margin: 0;">\n                      <t t-if="'komplikasi' in data">\n                        <span>\n                          <t t-esc="data['komplikasi']"/>\n                        </span>\n                      </t>\n                    </td>\n                    <td style="width: 90px; height: 23px; text-align: center;">\n                      <span>\n                        <t t-if="'komplikasi' in data">\n                          <b>✓</b>\n                        </t>\n                      </span>\n                    </td>\n                  </tr>\n                  <tr style="height: 23px;">\n                    <td style="width: 15px; height: 23px;">9</td>\n                    <td style="width: 209px; height: 23px;">Prognosis</td>\n                    <td style="width: 493px; height: 23px; padding-left: 5px; margin: 0;">\n                      <t t-if="'prognosis' in data">\n                        <span>\n                          <t t-esc="data['prognosis']"/>\n                        </span>\n                      </t>\n                    </td>\n                    <td style="width: 90px; height: 23px; text-align: center;">\n                      <span>\n                        <t t-if="'prognosis' in data">\n                          <b>✓</b>\n                        </t>\n                      </span>\n                    </td>\n                  </tr>\n                  <tr style="height: 23px;">\n                    <td style="width: 15px; height: 23px;">10</td>\n                    <td style="width: 209px; height: 23px;">Alternatif &amp; Risiko</td>\n                    <td style="width: 493px; height: 23px; padding-left: 5px; margin: 0;">\n                      <t t-if="'alternatif-risiko' in data">\n                        <span>\n                          <t t-esc="data['alternatif-risiko']"/>\n                        </span>\n                      </t>\n                    </td>\n                    <td style="width: 90px; height: 23px; text-align: center;">\n                      <span>\n                        <t t-if="'alternatif-risiko' in data">\n                          <b>✓</b>\n                        </t>\n                      </span>\n                    </td>\n                  </tr>\n                  <tr style="height: 23px;">\n                    <td style="width: 15px; height: 23px;">11</td>\n                    <td style="width: 209px; height: 23px;">Lain-lain</td>\n                    <td style="width: 493px; height: 23px; padding-left: 5px; margin: 0;">\n                      <t t-if="'lain-lain' in data">\n                        <span>\n                          <t t-esc="data['lain-lain']"/>\n                        </span>\n                      </t>\n                    </td>\n                    <td style="width: 90px; height: 23px; text-align: center;">\n                      <span>\n                        <t t-if="'lain-lain' in data">\n                          <b>✓</b>\n                        </t>\n                      </span>\n                    </td>\n                  </tr>\n                  <tr style="height: 23px;">\n                    <td style="width: 15px; height: 23px;"/>\n                    <td style="width: 209px; height: 23px;"/>\n                    <td colspan="2" style="text-align: right;">\n                      <span style="margin-right: 10px;">\n                        <t t-esc="o['operating_unit_id']['company_id']['city']"/> Tanggal : <t t-esc="o.to_date_string(data['registration_date'])"/> Pukul : <t t-esc="o.to_time_string(data['registration_date'])"/>\n                      </span>\n                    </td>\n                  </tr>\n                </tbody>\n              </table>\n\n              <table style="width: 100%; margin: 0;" class="table table-bordered table-sm">\n                <tbody>\n                  <tr>\n                    <td rowspan="2" style="width: 75%; vertical-align: middle;">\n                      Dengan ini menyatakan bahwa saya telah menerangkan hal-hal di atas secara\n                      benar dan jelas dan memberikan kesempatan untuk bertanya dan/atau berdiskusi\n                    </td>\n                    <td style="width: 25%; text-align: center;">\n                      Tanda Tangan Dokter:\n                    </td>\n                  </tr>\n                  <tr>\n                      <td>\n                        <div style="width:110px;height:80px; margin: auto;">\n                          <t t-if="'practitioner' in data">\n                            <t t-if="'practitioner' in data and data['practitioner'] and 'sign-img' in data['practitioner']">\n                                <img t-att-src="data['practitioner']['sign-img']" alt="Logo" height="80"/>\n                            </t>\n                          </t>\n                          <t t-else=""/>\n                        </div>\n                      </td>\n                  </tr>\n                  <tr>\n                    <td rowspan="2" style="width: 75%; vertical-align: middle;">\n                      Dengan ini menyatakan bahwa saya telah menerima informasi sebagaimana di atas\n                      yang saya beri tanda √ / paraf di kolom kanannya, dan telah memahaminya\n                    </td>\n                    <td style="width: 25%; text-align: center;">\n                      Tanda Tangan Pasien/Wali Pasien:\n                    </td>\n                  </tr>\n                  <tr>\n                    <td>\n                      <t t-if="'sign-pj' in data">\n                        <div style="width:110px;height:80px; margin: auto;">\n                          <img height="80" t-att-src="data['sign-pj']"/>\n                        </div>\n                      </t>\n                    </td>\n                  </tr>\n                </tbody>\n              </table>\n\n              <div style="page-break-after: always; break-after: always;"> </div>\n\n              <table style="width: 100%; margin: 0;" class="table table-bordered table-sm">\n                <tbody>\n                  <tr>\n                    <td style="text-align: center;">\n                      <strong>PERSETUJUAN PROSEDUR TINDAKAN MEDIS (CONSENT)</strong>\n                    </td>\n                  </tr>\n                  <tr>\n                    <td>\n                      <div class="row mb-1" style="margin: 0px;">Yang bertanda tangan di bawah ini: </div>\n                      <div class="row mb-1">\n                        <div class="col-3">Nama </div>\n                        <div class="col-4">: <t t-if="'nama-pj' in data">\n                            <span>\n                              <t t-esc="data['nama-pj']"/>\n                            </span>\n                          </t>\n                        </div>\n                        <div class="col-4">\n                          <span>\n                            <t t-if="o['partner_id']['gender'] == 'male'">Laki-Laki</t>\n                            <t t-else="">Perempuan</t>\n                          </span>\n                        </div>\n                      </div>\n                      <div class="row mb-1">\n                        <div class="col-3">No. KTP/SIM/PASPOR </div>\n                        <div class="col-4">: <t t-if="'identifier-pj' in data">\n                            <span>\n                              <t t-esc="data['identifier-pj']"/>\n                            </span>\n                          </t></div>\n                        <div class="col-2">Tgl Lahir/Umur</div>\n                        <div class="col-3">: <t t-if="'tgl-lahir-pj' in data">\n                            <t t-esc="data['tgl-lahir-pj']"/> ( <t t-esc="o.count_age(data['tgl-lahir-pj'].replace('-', '/'))"/> Th ) </t>\n                        </div>\n                      </div>\n                      <div class="row mb-1">\n                        <div class="col-3">Alamat Pasien </div>\n                        <div class="col-4">: <span style="margin-right: 15px;">\n                            <span>\n                              <t t-esc="o['partner_id']['street']"/>\n                            </span>\n                          </span></div>\n                        <div class="col-2">Telepon</div>\n                        <div class="col-3">: <t t-if="'telepon-pj' in data">\n                            <span>\n                              <t t-esc="data['telepon-pj']"/>\n                            </span>\n                          </t></div>\n                      </div>\n                    </td>\n                  </tr>\n                  <tr>\n                    <td>\n                      <div class="row mb-1">\n                        <div class="col-3">Hubungan dengan pasien</div>\n                        <div class="col-8">: <t t-if="'relasi-pj' in data">\n                            <span>\n                              <t t-esc="data['relasi-pj']"/>\n                            </span>\n                          </t>\n                        </div>\n                      </div>\n                    </td>\n                  </tr>\n                  <tr>\n                    <td>\n                      <div class="row mb-1">\n                        <div class="col-1"/>\n                        <div class="col-11">Dengan ini menyatakan sesungguhnya, bahwa saya telah\n                          menerima informasi yang diberikan oleh dokter sebagaimana di atas dan\n                          telah memahaminya. Untuk itu saya memberikan <t t-if="'jenis-consent' in data and data['jenis-consent'] == 'Persetujuan'">\n                          PERSETUJUAN / <span style="text-decoration: line-through;">PENOLAKAN </span>\n                          </t>\n                            <t t-if="'jenis-consent' in data and data['jenis-consent'] == 'Penolakan'">\n                            <span style="text-decoration: line-through;">PERSETUJUAN</span> /\n                          PENOLAKAN </t> * untuk dilakukan tindakan tersebut terhadap : </div>\n                      </div>\n                      <div class="row mb-1">\n                        <div class="col-3">Nama </div>\n                        <div class="col-4">: <t t-esc="o['partner_id']['name']"/>\n                        </div>\n                        <div class="col-4">\n                          <span>\n                            <t t-if="o['partner_id']['gender'] == 'male'">Laki-Laki</t>\n                            <t t-else="">Perempuan</t>\n                          </span>\n                        </div>\n                      </div>\n                      <div class="row mb-1">\n                        <div class="col-3">No. Rekam Medis </div>\n                        <div class="col-4">: <t t-if="'no-cm' in data">\n                            <t t-esc="data['no-cm']"/>\n                          </t><t t-else="">\n                          -</t></div>\n                        <div class="col-2">Tgl Lahir/Umur</div>\n                        <div class="col-3">: <t t-esc="o['partner_id']['birthDate'].strftime('%d-%m-%Y')"/> ( <t t-esc="o.count_age(o['partner_id']['birthDate'].strftime('%d/%m/%Y'))"/>\n                          Th ) </div>\n                      </div>\n                      <div class="row mb-1">\n                        <div class="col-3">Alamat Pasien </div>\n                        <div class="col-8">: <span>\n                            <span>\n                              <t t-esc="o['partner_id']['street']"/>\n                            </span>\n                          </span>\n                        </div>\n                      </div>\n                      <div class="row mb-1">\n                        <div class="col-1"/>\n                        <div class="col-11">Saya memahami perlunya dan manfaat tindakan tersebut\n                          termasuk risiko dan komplikasi yang akan timbul. Saya juga menyadari bahwa\n                          ilmu kedokteran bukanlah ilmu pasti, maka keberhasilan tindakan kedokteran\n                          bukanlah keniscayaan, melainkan tergantung Tuhan YME\n                        </div>\n                      </div>\n                    </td>\n                  </tr>\n                  <tr>\n                    <td style="text-align: right;">\n                      <span style="margin-right: 10px;">\n                        <t t-esc="o['operating_unit_id']['company_id']['city']"/> Tanggal : <t t-esc="o.to_date_string(data['registration_date'])"/> Pukul : <t t-esc="o.to_time_string(data['registration_date'])"/>\n                      </span>\n                    </td>\n                  </tr>\n                  <tr>\n                    <td>\n                      <div class="row mt-2" style="page-break-inside: avoid; page-break-before: auto; width: 100%;">\n                        <div class="col-3 text-center">\n                          <div class="mb-1">Yang Menyatakan </div>\n                          <t t-if="'sign-pj' in data">\n                            <div style="width:110px;height:80px; margin: auto;">\n                              <img height="80" t-att-src="data['sign-pj']"/>\n                            </div>\n                          </t>\n                          <div class="mt-2">\n                            <strong>( <t t-esc="data['nama-pj']"/> )</strong>\n                          </div>\n                        </div>\n                        <div class="col-3 text-center"> \n                          <div class="mb-1">Dokter</div>\n                              <div style="width:110px;height:80px; margin: auto;">\n                                <t t-if="'practitioner' in data">\n                                  <t t-if="'practitioner' in data and data['practitioner'] and 'sign-img' in data['practitioner']">          \n                                    <img height="80" t-att-src="data['practitioner']['sign-img']"/>\n                                  </t>\n                                </t>\n                                <t t-else=""/>\n                              </div>\n                          <div class="mt-2"><strong>( <t t-esc="data['dokter-pelaksana']"/> )</strong> </div>\n                        </div>\n                        <t t-if="'saksi' in data">\n                          <t t-foreach="data['saksi']" t-as="saksi">\n                            <div class="col-3 text-center">\n                              <div class="mb-1"> Saksi <t t-esc="saksi['saksi-idx']"/></div>\n                              <t t-if="'sign-img' in saksi">\n                                <div style="width:110px;height:80px; margin: auto;">\n                                  <img height="80" t-att-src="saksi['sign-img']"/>\n                                </div>\n                              </t>\n                              <p class="mb-0 mt-2">\n                                <strong>( <t t-esc="saksi['nama-saksi']"/> )</strong>\n                              </p>\n                            </div>\n                          </t>\n                        </t>\n                      </div>\n                      <div class="row mt-2" style="margin: 0px;">\n                        ** Bila pasien tidak kompeten atau tidak mau menerima informasi, maka\n                        penerima informasi adalah wali atau keluarga terdekat (suami, istri,\n                        ayah/ibu kandung, kakak/adik kandung, anak kandung)\n                      </div>\n                      <div class="row" style="margin: 0px;">\n                        * Coret pada pernyataan yang tidak sesuai\n                      </div>\n                    </td>\n                  </tr>\n\n                </tbody>\n              </table>\n\n            </div>\n          </div>\n        </div>\n      </t>\n    </t>\n  	ehealth_document/report/template_informed_consent/report_akamedicalcenter_informed_consent.xml	\N	\N	\N	\N	primary	t	1	2025-08-28 11:34:01.364376	1	2025-08-28 11:34:01.364376	f
1576	report_wellclinic_kki_informed_consent	\N	ehealth_document.report_wellclinic_kki_informed_consent	16	qweb	<?xml version="1.0"?>\n<t t-name="ehealth_document.report_wellclinic_kki_informed_consent">\n        <t t-set="company" t-value="res_company"/>\n        <t t-call="ehealth_document.header_wellclinic_document">\n          <t t-set="o" t-value="o.with_context(lang=lang)"/> \n          <div class="page" style="font-size:13px; line-height: 1.4;">\n            <div class="" style="">\n              <div class="">\n\n                <table style="width: 100%; margin: 0;" class="table table-bordered table-sm">\n                  <thead><tr><th colspan="4" style="text-align: center;"><strong>PEMBERIAN INFORMASI</strong></th></tr></thead>\n                  <tbody>\n                    <tr>\n                      <td style="width: 224px;" colspan="2">Nama &amp; Jabatan Pemberi Informasi</td>\n                      <td style="width: 493px; padding-left: 5px; margin: 0;" colspan="2">\n                        <t t-if="'dokter-pelaksana' in data">\n                          <span><t t-esc="data['dokter-pelaksana']"/></span>\n                          <!-- <span>Tester</span> -->\n                        </t>\n                      </td>\n                    </tr>\n                    <tr>\n                      <td style="width: 224px;" colspan="2">Nama Pasien</td>\n                      <td style="width: 493px; padding-left: 5px; margin: 0;" colspan="2">\n                        <span><t t-esc="o['partner_id']['name']"/> </span>\n                      </td>\n                    </tr>\n                    <tr>\n                      <td style="width: 224px;" colspan="2">Nomor Rekam Medis</td>\n                      <td style="width: 493px; padding-left: 5px; margin: 0;" colspan="2">\n                        <t t-if="'no-cm' in data">\n                          <span><t t-esc="data['no-cm']"/></span>\n                        </t>\n                      </td>\n                    </tr>\n                    <tr>\n                      <td style="width: 224px;" colspan="2">Tempat/Tanggal Lahir</td>\n                      <td style="width: 493px; padding-left: 5px; margin: 0;" colspan="2">\n                        <span> <t t-esc="o['partner_id']['birth_place']"/></span>,\n                        <span> <t t-esc="o['partner_id']['birthDate'].strftime('%d-%m-%Y')"/></span>\n                        (<span> <t t-esc="o.count_age(o['partner_id']['birthDate'].strftime('%d/%m/%Y'))"/></span> Tahun)\n                      </td>\n                    </tr>\n                    <tr>\n                      <td style="width: 224px;" colspan="2">Jenis Kelamin</td>\n                      <td style="width: 493px; padding-left: 5px; margin: 0;" colspan="2">\n                        <span><t t-if="o['partner_id']['gender'] == 'male'">Laki-Laki</t><t t-else="">Perempuan</t></span>\n                      </td>\n                    </tr>\n                    <tr>\n                      <td style="width: 224px;" colspan="2">Alamat Pasien</td>\n                      <td style="width: 493px; padding-left: 5px; margin: 0;" colspan="2">\n                        <span><t t-esc="o['partner_id']['street']"/> </span>\n                      </td>\n                    </tr>\n\n                    <tr><td colspan="4" style="text-align: center;"><strong>Jika penerima informasi bukan pasien**, lengkapi isian pada dua kolom di bawah </strong></td></tr>\n                    <tr>\n                      <td style="width: 224px;" colspan="2">Nama Penerima Informasi</td>\n                      <td style="width: 493px; padding-left: 5px; margin: 0;" colspan="2">\n                        <t t-if="'nama-pj' in data">\n                          <span><t t-esc="data['nama-pj']"/></span>\n                        </t>\n                      </td>\n                    </tr>\n                    <tr>\n                      <td style="width: 224px;" colspan="2">Hubungan dengan Pasien</td>\n                      <td style="width: 493px; padding-left: 5px; margin: 0;" colspan="2">\n                        <t t-if="'relasi-pj' in data">\n                          <span><t t-esc="data['relasi-pj']"/></span>\n                        </t>\n                      </td>\n                    </tr>\n                    \n                    <tr style="height: 23px;">\n                      <td style="width: 15px; height: 23px; text-align: center;"><strong>No</strong></td>\n                      <td style="width: 209px; height: 23px; text-align: center;"><strong>JENIS INFORMASI</strong></td>\n                      <td style="width: 493px; height: 23px; text-align: center;"><strong>ISI INFORMASI</strong></td>\n                      <td style="width: 90px; height: 23px; text-align: center;"><strong>Verifikasi</strong></td>\n                    </tr>\n                    <tr style="height: 23px;">\n                      <td style="width: 15px; height: 23px;">1</td>\n                      <td style="width: 209px; height: 23px;">Diagnosis (WD &amp; DD)</td>\n                      <td style="width: 493px; height: 23.5px; padding-left: 5px; margin: 0;">\n                        <t t-if="'diagnosis' in data">\n                          <span><t t-esc="data['diagnosis']"/></span>\n                        </t>\n                      </td>\n                      <td style="width: 90px; height: 23px; text-align: center;">\n                        <span><t t-if="'diagnosis' in data"><b>✓</b></t></span>\n                      </td>\n                    </tr>\n                    <tr style="height: 23px;">\n                      <td style="width: 15px; height: 23px;">2</td>\n                      <td style="width: 209px; height: 23px;">Dasar Diagnosis</td>\n                      <td style="width: 493px; height: 23px; padding-left: 5px; margin: 0;">\n                        <t t-if="'dasar-diagnosis' in data">\n                          <span><t t-esc="data['dasar-diagnosis']"/></span>\n                        </t>\n                      </td>\n                      <td style="width: 90px; height: 23px; text-align: center;">\n                        <span><t t-if="'dasar-diagnosis' in data"><b>✓</b></t></span>\n                      </td>\n                    </tr>\n                    <tr style="height: 23px;">\n                      <td style="width: 15px; height: 23px;">3</td>\n                      <td style="width: 209px; height: 23px;">Tindakan Kedokteran</td>\n                      <td style="width: 493px; height: 23px; padding-left: 5px; margin: 0;">\n                        <t t-if="'tindakan-kedokteran' in data">\n                          <span><t t-esc="data['tindakan-kedokteran']"/></span>\n                        </t>\n                      </td>\n                      <td style="width: 90px; height: 23px; text-align: center;">\n                        <span><t t-if="'tindakan-kedokteran' in data"><b>✓</b></t></span>\n                      </td>\n                    </tr>\n                    <tr style="height: 23px;">\n                      <td style="width: 15px; height: 23px;">4</td>\n                      <td style="width: 209px; height: 23px;">Indikasi Tindakan</td>\n                      <td style="width: 493px; height: 23px; padding-left: 5px; margin: 0;">\n                        <t t-if="'indikasi-tindakan' in data">\n                          <span><t t-esc="data['indikasi-tindakan']"/></span>\n                        </t>\n                      </td>\n                      <td style="width: 90px; height: 23px; text-align: center;">\n                        <span><t t-if="'indikasi-tindakan' in data"><b>✓</b></t></span>\n                      </td>\n                    </tr>\n                    <tr style="height: 23px;">\n                      <td style="width: 15px; height: 23px;">5</td>\n                      <td style="width: 209px; height: 23px;">Tata Cara</td>\n                      <td style="width: 493px; height: 23px; padding-left: 5px; margin: 0;">\n                        <t t-if="'tata-cara' in data">\n                          <span><t t-esc="data['tata-cara']"/></span>\n                        </t>\n                      </td>\n                      <td style="width: 90px; height: 23px; text-align: center;">\n                        <span><t t-if="'tata-cara' in data"><b>✓</b></t></span>\n                      </td>\n                    </tr>\n                    <tr style="height: 23px;">\n                      <td style="width: 15px; height: 23px;">6</td>\n                      <td style="width: 209px; height: 23px;">Tujuan</td>\n                      <td style="width: 493px; height: 23px; padding-left: 5px; margin: 0;">\n                        <t t-if="'tujuan' in data">\n                          <span><t t-esc="data['tujuan']"/></span>\n                        </t>\n                      </td>\n                      <td style="width: 90px; height: 23px; text-align: center;">\n                        <span><t t-if="'tujuan' in data"><b>✓</b></t></span>\n                      </td>\n                    </tr>\n                    <tr style="height: 23px;">\n                      <td style="width: 15px; height: 23px;">7</td>\n                      <td style="width: 209px; height: 23px;">Risiko</td>\n                      <td style="width: 493px; height: 23px; padding-left: 5px; margin: 0;">\n                        <t t-if="'risiko' in data">\n                          <span><t t-esc="data['risiko']"/></span>\n                        </t>\n                      </td>\n                      <td style="width: 90px; height: 23px; text-align: center;">\n                        <span><t t-if="'risiko' in data"><b>✓</b></t></span>\n                      </td>\n                    </tr>\n                    <tr style="height: 23px;">\n                      <td style="width: 15px; height: 23px;">8</td>\n                      <td style="width: 209px; height: 23px;">Komplikasi</td>\n                      <td style="width: 493px; height: 23px; padding-left: 5px; margin: 0;">\n                        <t t-if="'komplikasi' in data">\n                          <span><t t-esc="data['komplikasi']"/></span>\n                        </t>\n                      </td>\n                      <td style="width: 90px; height: 23px; text-align: center;">\n                        <span><t t-if="'komplikasi' in data"><b>✓</b></t></span>\n                      </td>\n                    </tr>\n                    <tr style="height: 23px;">\n                      <td style="width: 15px; height: 23px;">9</td>\n                      <td style="width: 209px; height: 23px;">Prognosis</td>\n                      <td style="width: 493px; height: 23px; padding-left: 5px; margin: 0;">\n                        <t t-if="'prognosis' in data">\n                          <span><t t-esc="data['prognosis']"/></span>\n                        </t>\n                      </td>\n                      <td style="width: 90px; height: 23px; text-align: center;">\n                        <span><t t-if="'prognosis' in data"><b>✓</b></t></span>\n                      </td>\n                    </tr>\n                    <tr style="height: 23px;">\n                      <td style="width: 15px; height: 23px;">10</td>\n                      <td style="width: 209px; height: 23px;">Alternatif &amp; Risiko</td>\n                      <td style="width: 493px; height: 23px; padding-left: 5px; margin: 0;">\n                        <t t-if="'alternatif-risiko' in data">\n                          <span><t t-esc="data['alternatif-risiko']"/></span>\n                        </t>\n                      </td>\n                      <td style="width: 90px; height: 23px; text-align: center;">\n                        <span><t t-if="'alternatif-risiko' in data"><b>✓</b></t></span>\n                      </td>\n                    </tr>\n                    <tr style="height: 23px;">\n                      <td style="width: 15px; height: 23px;">11</td>\n                      <td style="width: 209px; height: 23px;">Lain-lain</td>\n                      <td style="width: 493px; height: 23px; padding-left: 5px; margin: 0;">\n                        <t t-if="'lain-lain' in data">\n                          <span><t t-esc="data['lain-lain']"/></span>\n                        </t>\n                      </td>\n                      <td style="width: 90px; height: 23px; text-align: center;">\n                        <span><t t-if="'lain-lain' in data"><b>✓</b></t></span>\n                      </td>\n                    </tr>\n                    <tr style="height: 23px;">\n                      <td style="width: 15px; height: 23px;"/>\n                      <td style="width: 209px; height: 23px;"/>\n                      <td colspan="2" style="text-align: right;">\n                        <span style="margin-right: 10px;">\n                          Lokasi : <t t-esc="o['operating_unit_id']['company_id']['city']"/>, Tanggal : <t t-esc="o.to_date_string(data['registration_date'])"/>, Pukul :  <t t-esc="o.to_time_string(data['registration_date'])"/>\n                        </span>\n                      </td>\n                    </tr>\n                  </tbody>\n                </table>\n\n                <table style="width: 100%; margin: 0;" class="table table-bordered table-sm">\n                  <tbody>\n                    <tr>\n                      <td rowspan="2" style="width: 75%; vertical-align: middle;">\n                        Dengan ini menyatakan bahwa saya telah menerangkan hal-hal di atas secara benar dan jelas dan memberikan kesempatan untuk bertanya dan/atau berdiskusi\n                      </td>\n                      <td style="width: 25%; text-align: center;">\n                        Tanda Tangan Dokter:\n                      </td>\n                    </tr>\n                    <tr>\n                      <td>\n                        <div style="width:110px;height:80px; margin: auto;">\n                          <t t-if="'practitioner' in data">\n                            <t t-if="data['practitioner'] and 'sign-img' in data['practitioner']">\n                                <img t-att-src="data['practitioner']['sign-img']" alt="Logo" height="80"/>\n                            </t>\n                          </t>\n                          <t t-else=""/>\n                        </div>\n                      </td>\n                    </tr>\n                    <tr>\n                      <td rowspan="2" style="width: 75%; vertical-align: middle;">\n                        Dengan ini menyatakan bahwa saya telah menerima informasi sebagaimana di atas yang saya beri tanda √ / paraf di kolom kanannya, dan telah memahaminya\n                      </td>\n                      <td style="width: 25%; text-align: center;">\n                        Tanda Tangan Pasien/Wali Pasien:\n                      </td>\n                    </tr>\n                    <tr>\n                      <td>\n                        <t t-if="'sign-pj' in data">\n                          <div style="width:110px;height:80px; margin: auto;">\n                            <img height="80" t-att-src="data['sign-pj']"/>\n                          </div>\n                        </t>\n                      </td>\n                    </tr>\n                  </tbody>\n                </table>\n\n                <div style="page-break-after: always; break-after: always;"> </div>\n\n                <table style="width: 100%; margin: 0;" class="table table-bordered table-sm">\n                  <tbody>\n                    <tr><td style="text-align: center;"><strong>PERSETUJUAN PROSEDUR TINDAKAN MEDIS (CONSENT)</strong></td></tr>\n                    <tr>\n                      <td>\n                        <div class="row mb-1" style="margin: 0px;">Yang bertanda tangan di bawah ini: </div>\n                        <div class="row mb-1">\n                          <div class="col-3">Nama </div>\n                          <div class="col-4">: <t t-if="'nama-pj' in data"> <span><t t-esc="data['nama-pj']"/></span></t> </div>\n                          <div class="col-4"><span><t t-if="o['partner_id']['gender'] == 'male'">Laki-Laki</t><t t-else="">Perempuan</t></span></div>\n                        </div>\n                        <div class="row mb-1">\n                          <div class="col-3">No. KTP/SIM/PASPOR  </div>\n                          <div class="col-4">: <t t-if="'identifier-pj' in data"> <span><t t-esc="data['identifier-pj']"/></span></t></div>\n                          <div class="col-2">Tgl Lahir/Umur</div>\n                          <div class="col-3">:\n                            <t t-if="'tgl-lahir-pj' in data">\n                              <t t-esc="data['tgl-lahir-pj']"/>\n                              ( <t t-esc="o.count_age(data['tgl-lahir-pj'].replace('-', '/'))"/> Th )\n                            </t>\n                          </div>\n                        </div>\n                        <div class="row mb-1">\n                          <div class="col-3">Alamat Pasien  </div>\n                          <div class="col-4">: <span style="margin-right: 15px;"><span><t t-esc="o['partner_id']['street']"/> </span></span></div>\n                          <div class="col-2">Telepon</div>\n                          <div class="col-3">: <t t-if="'telepon-pj' in data"> <span><t t-esc="data['telepon-pj']"/></span></t></div>\n                        </div>\n                      </td>\n                    </tr>\n                    <tr>\n                      <td>\n                        <div class="row mb-1">\n                          <div class="col-3">Hubungan dengan pasien</div>\n                          <div class="col-8">: \n                            <t t-if="'relasi-pj' in data">\n                              <span><t t-esc="data['relasi-pj']"/></span>\n                            </t>\n                          </div>\n                        </div>\n                      </td>\n                    </tr>\n                    <tr>\n                      <td>\n                        <div class="row mb-1">\n                          <div class="col-1"/>\n                          <div class="col-11">Dengan ini menyatakan sesungguhnya, bahwa saya telah menerima informasi yang diberikan oleh dokter sebagaimana di atas dan telah memahaminya. Untuk itu saya memberikan \n                            <t t-if="'jenis-consent' in data and data['jenis-consent'] == 'Persetujuan'">\n                              PERSETUJUAN / <span style="text-decoration: line-through;">PENOLAKAN </span>\n                            </t>\n                            <t t-if="'jenis-consent' in data and data['jenis-consent'] == 'Penolakan'">\n                              <span style="text-decoration: line-through;">PERSETUJUAN</span> / PENOLAKAN \n                            </t>\n                          *  untuk dilakukan tindakan tersebut terhadap : \n                          </div>\n                        </div>\n                        <div class="row mb-1">\n                          <div class="col-3">Nama </div>\n                          <div class="col-4">: <t t-esc="o['partner_id']['name']"/> </div>\n                          <div class="col-4"><span><t t-if="o['partner_id']['gender'] == 'male'">Laki-Laki</t><t t-else="">Perempuan</t></span></div>\n                        </div>\n                        <div class="row mb-1">\n                          <div class="col-3">No. Rekam Medis  </div>\n                          <div class="col-4">: <t t-if="'no-cm' in data"><t t-esc="data['no-cm']"/></t><t t-else="">-</t></div>\n                          <div class="col-2">Tgl Lahir/Umur</div>\n                          <div class="col-3">: \n                            <t t-esc="o['partner_id']['birthDate'].strftime('%d-%m-%Y')"/>  \n                            ( <t t-esc="o.count_age(o['partner_id']['birthDate'].strftime('%d/%m/%Y'))"/> Th )\n                          </div>\n                        </div>\n                        <div class="row mb-1">\n                          <div class="col-3">Alamat Pasien  </div>\n                          <div class="col-8">: <span><span><t t-esc="o['partner_id']['street']"/> </span></span> </div>\n                        </div>\n                        <div class="row mb-1">\n                          <div class="col-1"/>\n                          <div class="col-11">Saya memahami perlunya dan manfaat tindakan tersebut termasuk risiko dan komplikasi yang akan timbul. Saya juga menyadari bahwa ilmu kedokteran bukanlah ilmu pasti, maka keberhasilan tindakan kedokteran bukanlah keniscayaan, melainkan tergantung Tuhan YME\n                          </div>\n                        </div>\n                      </td>\n                    </tr>\n                    <tr>\n                      <td style="text-align: right;">\n                        <span style="margin-right: 10px;">\n                          Lokasi : <t t-esc="o['operating_unit_id']['company_id']['city']"/>, Tanggal : <t t-esc="o.to_date_string(data['registration_date'])"/>, Pukul :  <t t-esc="o.to_time_string(data['registration_date'])"/>                        </span>\n                      </td>\n                    </tr>\n                    <tr>\n                      <td>\n                        <div class="row mt-2" style="page-break-inside: avoid; page-break-before: auto; width: 100%;">\n                          <div class="col-3 text-center">\n                            <div class="mb-1">Yang Menyatakan </div>\n                            <t t-if="'sign-pj' in data">\n                              <div style="width:110px;height:80px; margin: auto;">\n                                  <img height="80" t-att-src="data['sign-pj']"/>\n                                </div>\n                            </t>\n                            <div class="mt-2"><strong>( <t t-esc="data['nama-pj']"/> )</strong></div>\n                          </div>\n                          <div class="col-3 text-center"> \n                            <div class="mb-1">Dokter</div>\n                              <div style="width:110px;height:80px; margin: auto;">\n                                <t t-if="'practitioner' in data">\n                                  <t t-if="data['practitioner'] and 'sign-img' in data['practitioner']">          \n                                    <img height="80" t-att-src="data['practitioner']['sign-img']"/>\n                                  </t>\n                                </t>\n                                <t t-else="">\n                                  <t t-if="'dokter-pelaksana' in data and data['dokter-pelaksana'] in 'Dr. dr. Tirta Darmawan Susanto, Mkes FSASS'">\n                                    <img t-att-src="'/ehealth_document/static/src/img/signature/signature-wellclinic-dr-tirta.png'" style="max-height: 125px;" alt="Logo"/>\n                                  </t>\n                                  <t t-if="'dokter-pelaksana' in data and data['dokter-pelaksana'] in 'dr. Steve Emmanuel'">\n                                    <img t-att-src="'/ehealth_document/static/src/img/signature/signature-wellclinic-dr-steve.png'" style="max-height: 125px;" alt="Logo"/>\n                                  </t>\n                                  <t t-if="'dokter-pelaksana' in data and data['dokter-pelaksana'] in 'dr. Catherine Ranatan'">\n                                    <img t-att-src="'/ehealth_document/static/src/img/signature/signature-wellclinic-dr-catherine.png'" style="max-height: 125px;" alt="Logo"/>\n                                  </t>\n                                </t>\n                              </div>\n                            <div class="mt-2"><strong>( <t t-esc="data['dokter-pelaksana']"/> )</strong> </div>\n                          </div>\n                          <t t-if="'saksi' in data">\n                            <t t-foreach="data['saksi']" t-as="saksi">\n                              <div class="col-3 text-center">\n                                  <div class="mb-1"> Saksi <t t-esc="saksi['saksi-idx']"/></div>\n                                  <t t-if="'sign-img' in saksi">\n                                    <div style="width:110px;height:80px; margin: auto;">\n                                      <img height="80" t-att-src="saksi['sign-img']"/>\n                                    </div>\n                                  </t>\n                                  <p class="mb-0 mt-2"><strong>( <t t-esc="saksi['nama-saksi']"/> )</strong></p>\n                              </div>\n                            </t>\n                          </t>\n                        </div>\n                        <div class="row mt-2" style="margin: 0px;">\n                          ** Bila pasien tidak kompeten atau tidak mau menerima informasi, maka penerima informasi adalah wali atau keluarga terdekat (suami, istri, ayah/ibu kandung, kakak/adik kandung, anak kandung)\t\t\t\t\n                        </div>\n                        <div class="row" style="margin: 0px;">\n                          * Coret pada pernyataan yang tidak sesuai\t\t\t\n                        </div>\n                      </td>\n                    </tr>\n                    \n                  </tbody>\n                </table>\n                \n              </div>\n            </div>\n          </div>\n        </t>\n      </t>\n    	ehealth_document/report/template_informed_consent/report_wellclinic_informed_consent.xml	f	<?xml version="1.0"?>\n<t t-name="ehealth_document.report_wellclinic_kki_informed_consent">\n        <t t-set="company" t-value="res_company"/>\n        <t t-call="ehealth_document.header_wellclinic_document">\n          <t t-set="o" t-value="o.with_context(lang=lang)"/> \n          <div class="page" style="font-size:13px; line-height: 1.4;">\n            <div class="" style="">\n              <div class="">\n\n                <table style="width: 100%; margin: 0;" class="table table-bordered table-sm">\n                  <thead><tr><th colspan="4" style="text-align: center;"><strong>PEMBERIAN INFORMASI</strong></th></tr></thead>\n                  <tbody>\n                    <tr>\n                      <td style="width: 224px;" colspan="2">Nama &amp; Jabatan Pemberi Informasi</td>\n                      <td style="width: 493px; padding-left: 5px; margin: 0;" colspan="2">\n                        <t t-if="'dokter-pelaksana' in data">\n                          <!-- <span><t t-esc="data['dokter-pelaksana']"/></span> -->\n                          <span>Tester</span>\n                        </t>\n                      </td>\n                    </tr>\n                    <tr>\n                      <td style="width: 224px;" colspan="2">Nama Pasien</td>\n                      <td style="width: 493px; padding-left: 5px; margin: 0;" colspan="2">\n                        <span><t t-esc="o['partner_id']['name']"/> </span>\n                      </td>\n                    </tr>\n                    <tr>\n                      <td style="width: 224px;" colspan="2">Nomor Rekam Medis</td>\n                      <td style="width: 493px; padding-left: 5px; margin: 0;" colspan="2">\n                        <t t-if="'no-cm' in data">\n                          <span><t t-esc="data['no-cm']"/></span>\n                        </t>\n                      </td>\n                    </tr>\n                    <tr>\n                      <td style="width: 224px;" colspan="2">Tempat/Tanggal Lahir</td>\n                      <td style="width: 493px; padding-left: 5px; margin: 0;" colspan="2">\n                        <span> <t t-esc="o['partner_id']['birth_place']"/></span>,\n                        <span> <t t-esc="o['partner_id']['birthDate'].strftime('%d-%m-%Y')"/></span>\n                        (<span> <t t-esc="o.count_age(o['partner_id']['birthDate'].strftime('%d/%m/%Y'))"/></span> Tahun)\n                      </td>\n                    </tr>\n                    <tr>\n                      <td style="width: 224px;" colspan="2">Jenis Kelamin</td>\n                      <td style="width: 493px; padding-left: 5px; margin: 0;" colspan="2">\n                        <span><t t-if="o['partner_id']['gender'] == 'male'">Laki-Laki</t><t t-else="">Perempuan</t></span>\n                      </td>\n                    </tr>\n                    <tr>\n                      <td style="width: 224px;" colspan="2">Alamat Pasien</td>\n                      <td style="width: 493px; padding-left: 5px; margin: 0;" colspan="2">\n                        <span><t t-esc="o['partner_id']['street']"/> </span>\n                      </td>\n                    </tr>\n\n                    <tr><td colspan="4" style="text-align: center;"><strong>Jika penerima informasi bukan pasien**, lengkapi isian pada dua kolom di bawah </strong></td></tr>\n                    <tr>\n                      <td style="width: 224px;" colspan="2">Nama Penerima Informasi</td>\n                      <td style="width: 493px; padding-left: 5px; margin: 0;" colspan="2">\n                        <t t-if="'nama-pj' in data">\n                          <span><t t-esc="data['nama-pj']"/></span>\n                        </t>\n                      </td>\n                    </tr>\n                    <tr>\n                      <td style="width: 224px;" colspan="2">Hubungan dengan Pasien</td>\n                      <td style="width: 493px; padding-left: 5px; margin: 0;" colspan="2">\n                        <t t-if="'relasi-pj' in data">\n                          <span><t t-esc="data['relasi-pj']"/></span>\n                        </t>\n                      </td>\n                    </tr>\n                    \n                    <tr style="height: 23px;">\n                      <td style="width: 15px; height: 23px; text-align: center;"><strong>No</strong></td>\n                      <td style="width: 209px; height: 23px; text-align: center;"><strong>JENIS INFORMASI</strong></td>\n                      <td style="width: 493px; height: 23px; text-align: center;"><strong>ISI INFORMASI</strong></td>\n                      <td style="width: 90px; height: 23px; text-align: center;"><strong>Verifikasi</strong></td>\n                    </tr>\n                    <tr style="height: 23px;">\n                      <td style="width: 15px; height: 23px;">1</td>\n                      <td style="width: 209px; height: 23px;">Diagnosis (WD &amp; DD)</td>\n                      <td style="width: 493px; height: 23.5px; padding-left: 5px; margin: 0;">\n                        <t t-if="'diagnosis' in data">\n                          <span><t t-esc="data['diagnosis']"/></span>\n                        </t>\n                      </td>\n                      <td style="width: 90px; height: 23px; text-align: center;">\n                        <span><t t-if="'diagnosis' in data"><b>✓</b></t></span>\n                      </td>\n                    </tr>\n                    <tr style="height: 23px;">\n                      <td style="width: 15px; height: 23px;">2</td>\n                      <td style="width: 209px; height: 23px;">Dasar Diagnosis</td>\n                      <td style="width: 493px; height: 23px; padding-left: 5px; margin: 0;">\n                        <t t-if="'dasar-diagnosis' in data">\n                          <span><t t-esc="data['dasar-diagnosis']"/></span>\n                        </t>\n                      </td>\n                      <td style="width: 90px; height: 23px; text-align: center;">\n                        <span><t t-if="'dasar-diagnosis' in data"><b>✓</b></t></span>\n                      </td>\n                    </tr>\n                    <tr style="height: 23px;">\n                      <td style="width: 15px; height: 23px;">3</td>\n                      <td style="width: 209px; height: 23px;">Tindakan Kedokteran</td>\n                      <td style="width: 493px; height: 23px; padding-left: 5px; margin: 0;">\n                        <t t-if="'tindakan-kedokteran' in data">\n                          <span><t t-esc="data['tindakan-kedokteran']"/></span>\n                        </t>\n                      </td>\n                      <td style="width: 90px; height: 23px; text-align: center;">\n                        <span><t t-if="'tindakan-kedokteran' in data"><b>✓</b></t></span>\n                      </td>\n                    </tr>\n                    <tr style="height: 23px;">\n                      <td style="width: 15px; height: 23px;">4</td>\n                      <td style="width: 209px; height: 23px;">Indikasi Tindakan</td>\n                      <td style="width: 493px; height: 23px; padding-left: 5px; margin: 0;">\n                        <t t-if="'indikasi-tindakan' in data">\n                          <span><t t-esc="data['indikasi-tindakan']"/></span>\n                        </t>\n                      </td>\n                      <td style="width: 90px; height: 23px; text-align: center;">\n                        <span><t t-if="'indikasi-tindakan' in data"><b>✓</b></t></span>\n                      </td>\n                    </tr>\n                    <tr style="height: 23px;">\n                      <td style="width: 15px; height: 23px;">5</td>\n                      <td style="width: 209px; height: 23px;">Tata Cara</td>\n                      <td style="width: 493px; height: 23px; padding-left: 5px; margin: 0;">\n                        <t t-if="'tata-cara' in data">\n                          <span><t t-esc="data['tata-cara']"/></span>\n                        </t>\n                      </td>\n                      <td style="width: 90px; height: 23px; text-align: center;">\n                        <span><t t-if="'tata-cara' in data"><b>✓</b></t></span>\n                      </td>\n                    </tr>\n                    <tr style="height: 23px;">\n                      <td style="width: 15px; height: 23px;">6</td>\n                      <td style="width: 209px; height: 23px;">Tujuan</td>\n                      <td style="width: 493px; height: 23px; padding-left: 5px; margin: 0;">\n                        <t t-if="'tujuan' in data">\n                          <span><t t-esc="data['tujuan']"/></span>\n                        </t>\n                      </td>\n                      <td style="width: 90px; height: 23px; text-align: center;">\n                        <span><t t-if="'tujuan' in data"><b>✓</b></t></span>\n                      </td>\n                    </tr>\n                    <tr style="height: 23px;">\n                      <td style="width: 15px; height: 23px;">7</td>\n                      <td style="width: 209px; height: 23px;">Risiko</td>\n                      <td style="width: 493px; height: 23px; padding-left: 5px; margin: 0;">\n                        <t t-if="'risiko' in data">\n                          <span><t t-esc="data['risiko']"/></span>\n                        </t>\n                      </td>\n                      <td style="width: 90px; height: 23px; text-align: center;">\n                        <span><t t-if="'risiko' in data"><b>✓</b></t></span>\n                      </td>\n                    </tr>\n                    <tr style="height: 23px;">\n                      <td style="width: 15px; height: 23px;">8</td>\n                      <td style="width: 209px; height: 23px;">Komplikasi</td>\n                      <td style="width: 493px; height: 23px; padding-left: 5px; margin: 0;">\n                        <t t-if="'komplikasi' in data">\n                          <span><t t-esc="data['komplikasi']"/></span>\n                        </t>\n                      </td>\n                      <td style="width: 90px; height: 23px; text-align: center;">\n                        <span><t t-if="'komplikasi' in data"><b>✓</b></t></span>\n                      </td>\n                    </tr>\n                    <tr style="height: 23px;">\n                      <td style="width: 15px; height: 23px;">9</td>\n                      <td style="width: 209px; height: 23px;">Prognosis</td>\n                      <td style="width: 493px; height: 23px; padding-left: 5px; margin: 0;">\n                        <t t-if="'prognosis' in data">\n                          <span><t t-esc="data['prognosis']"/></span>\n                        </t>\n                      </td>\n                      <td style="width: 90px; height: 23px; text-align: center;">\n                        <span><t t-if="'prognosis' in data"><b>✓</b></t></span>\n                      </td>\n                    </tr>\n                    <tr style="height: 23px;">\n                      <td style="width: 15px; height: 23px;">10</td>\n                      <td style="width: 209px; height: 23px;">Alternatif &amp; Risiko</td>\n                      <td style="width: 493px; height: 23px; padding-left: 5px; margin: 0;">\n                        <t t-if="'alternatif-risiko' in data">\n                          <span><t t-esc="data['alternatif-risiko']"/></span>\n                        </t>\n                      </td>\n                      <td style="width: 90px; height: 23px; text-align: center;">\n                        <span><t t-if="'alternatif-risiko' in data"><b>✓</b></t></span>\n                      </td>\n                    </tr>\n                    <tr style="height: 23px;">\n                      <td style="width: 15px; height: 23px;">11</td>\n                      <td style="width: 209px; height: 23px;">Lain-lain</td>\n                      <td style="width: 493px; height: 23px; padding-left: 5px; margin: 0;">\n                        <t t-if="'lain-lain' in data">\n                          <span><t t-esc="data['lain-lain']"/></span>\n                        </t>\n                      </td>\n                      <td style="width: 90px; height: 23px; text-align: center;">\n                        <span><t t-if="'lain-lain' in data"><b>✓</b></t></span>\n                      </td>\n                    </tr>\n                    <tr style="height: 23px;">\n                      <td style="width: 15px; height: 23px;"/>\n                      <td style="width: 209px; height: 23px;"/>\n                      <td colspan="2" style="text-align: right;">\n                        <span style="margin-right: 10px;">\n                          Lokasi : <t t-esc="o['operating_unit_id']['company_id']['city']"/>, Tanggal : <t t-esc="o.to_date_string(data['registration_date'])"/>, Pukul :  <t t-esc="o.to_time_string(data['registration_date'])"/>\n                        </span>\n                      </td>\n                    </tr>\n                  </tbody>\n                </table>\n\n                <table style="width: 100%; margin: 0;" class="table table-bordered table-sm">\n                  <tbody>\n                    <tr>\n                      <td rowspan="2" style="width: 75%; vertical-align: middle;">\n                        Dengan ini menyatakan bahwa saya telah menerangkan hal-hal di atas secara benar dan jelas dan memberikan kesempatan untuk bertanya dan/atau berdiskusi\n                      </td>\n                      <td style="width: 25%; text-align: center;">\n                        Tanda Tangan Dokter:\n                      </td>\n                    </tr>\n                    <tr>\n                      <td>\n                        <!-- <t t-if="'qr_code_examiner_url' in data"> -->\n                          <!-- <div style="width:110px;height:80px; margin: auto;"> -->\n                            <!-- <img height="80" t-att-src="data['qr_code_examiner_url']"></img> -->\n                          <!-- </div> -->\n                        <!-- </t> -->\n                        <!-- <t t-else=""> -->\n                          <div style="width:110px;height:80px; margin: auto;">\n                            <t t-if="'dokter-pelaksana' in data and data['dokter-pelaksana'] in 'Dr. dr. Tirta Darmawan Susanto, Mkes FSASS'">\n                              <img t-att-src="'/ehealth_document/static/src/img/signature/signature-wellclinic-dr-tirta.png'" height="80" alt="Signature"/>\n                            </t>\n                            <t t-if="'dokter-pelaksana' in data and data['dokter-pelaksana'] in 'dr. Steve Emmanuel'">\n                              <img t-att-src="'/ehealth_document/static/src/img/signature/signature-wellclinic-dr-steve.png'" height="80" alt="Signature"/>\n                            </t>\n                            <t t-if="'dokter-pelaksana' in data and data['dokter-pelaksana'] in 'dr. Catherine Ranatan'">\n                              <img t-att-src="'/ehealth_document/static/src/img/signature/signature-wellclinic-dr-catherine.png'" height="80" alt="Signature"/>\n                            </t>\n                          </div>\n                        <!-- </t> -->\n                      </td>\n                    </tr>\n                    <tr>\n                      <td rowspan="2" style="width: 75%; vertical-align: middle;">\n                        Dengan ini menyatakan bahwa saya telah menerima informasi sebagaimana di atas yang saya beri tanda √ / paraf di kolom kanannya, dan telah memahaminya\n                      </td>\n                      <td style="width: 25%; text-align: center;">\n                        Tanda Tangan Pasien/Wali Pasien:\n                      </td>\n                    </tr>\n                    <tr>\n                      <td>\n                        <t t-if="'sign-pj' in data">\n                          <div style="width:110px;height:80px; margin: auto;">\n                            <img height="80" t-att-src="data['sign-pj']"/>\n                          </div>\n                        </t>\n                      </td>\n                    </tr>\n                  </tbody>\n                </table>\n\n                <div style="page-break-after: always; break-after: always;"> </div>\n\n                <table style="width: 100%; margin: 0;" class="table table-bordered table-sm">\n                  <tbody>\n                    <tr><td style="text-align: center;"><strong>PERSETUJUAN PROSEDUR TINDAKAN MEDIS (CONSENT)</strong></td></tr>\n                    <tr>\n                      <td>\n                        <div class="row mb-1" style="margin: 0px;">Yang bertanda tangan di bawah ini: </div>\n                        <div class="row mb-1">\n                          <div class="col-3">Nama </div>\n                          <div class="col-4">: <t t-if="'nama-pj' in data"> <span><t t-esc="data['nama-pj']"/></span></t> </div>\n                          <div class="col-4"><span><t t-if="o['partner_id']['gender'] == 'male'">Laki-Laki</t><t t-else="">Perempuan</t></span></div>\n                        </div>\n                        <div class="row mb-1">\n                          <div class="col-3">No. KTP/SIM/PASPOR  </div>\n                          <div class="col-4">: <t t-if="'identifier-pj' in data"> <span><t t-esc="data['identifier-pj']"/></span></t></div>\n                          <div class="col-2">Tgl Lahir/Umur</div>\n                          <div class="col-3">:\n                            <t t-if="'tgl-lahir-pj' in data">\n                              <t t-esc="data['tgl-lahir-pj']"/>\n                              ( <t t-esc="o.count_age(data['tgl-lahir-pj'].replace('-', '/'))"/> Th )\n                            </t>\n                          </div>\n                        </div>\n                        <div class="row mb-1">\n                          <div class="col-3">Alamat Pasien  </div>\n                          <div class="col-4">: <span style="margin-right: 15px;"><span><t t-esc="o['partner_id']['street']"/> </span></span></div>\n                          <div class="col-2">Telepon</div>\n                          <div class="col-3">: <t t-if="'telepon-pj' in data"> <span><t t-esc="data['telepon-pj']"/></span></t></div>\n                        </div>\n                      </td>\n                    </tr>\n                    <tr>\n                      <td>\n                        <div class="row mb-1">\n                          <div class="col-3">Hubungan dengan pasien</div>\n                          <div class="col-8">: \n                            <t t-if="'relasi-pj' in data">\n                              <span><t t-esc="data['relasi-pj']"/></span>\n                            </t>\n                          </div>\n                        </div>\n                      </td>\n                    </tr>\n                    <tr>\n                      <td>\n                        <div class="row mb-1">\n                          <div class="col-1"/>\n                          <div class="col-11">Dengan ini menyatakan sesungguhnya, bahwa saya telah menerima informasi yang diberikan oleh dokter sebagaimana di atas dan telah memahaminya. Untuk itu saya memberikan \n                            <t t-if="'jenis-consent' in data and data['jenis-consent'] == 'Persetujuan'">\n                              PERSETUJUAN / <span style="text-decoration: line-through;">PENOLAKAN </span>\n                            </t>\n                            <t t-if="'jenis-consent' in data and data['jenis-consent'] == 'Penolakan'">\n                              <span style="text-decoration: line-through;">PERSETUJUAN</span> / PENOLAKAN \n                            </t>\n                          *  untuk dilakukan tindakan tersebut terhadap : \n                          </div>\n                        </div>\n                        <div class="row mb-1">\n                          <div class="col-3">Nama </div>\n                          <div class="col-4">: <t t-esc="o['partner_id']['name']"/> </div>\n                          <div class="col-4"><span><t t-if="o['partner_id']['gender'] == 'male'">Laki-Laki</t><t t-else="">Perempuan</t></span></div>\n                        </div>\n                        <div class="row mb-1">\n                          <div class="col-3">No. Rekam Medis  </div>\n                          <div class="col-4">: <t t-if="'no-cm' in data"><t t-esc="data['no-cm']"/></t><t t-else="">-</t></div>\n                          <div class="col-2">Tgl Lahir/Umur</div>\n                          <div class="col-3">: \n                            <t t-esc="o['partner_id']['birthDate'].strftime('%d-%m-%Y')"/>  \n                            ( <t t-esc="o.count_age(o['partner_id']['birthDate'].strftime('%d/%m/%Y'))"/> Th )\n                          </div>\n                        </div>\n                        <div class="row mb-1">\n                          <div class="col-3">Alamat Pasien  </div>\n                          <div class="col-8">: <span><span><t t-esc="o['partner_id']['street']"/> </span></span> </div>\n                        </div>\n                        <div class="row mb-1">\n                          <div class="col-1"/>\n                          <div class="col-11">Saya memahami perlunya dan manfaat tindakan tersebut termasuk risiko dan komplikasi yang akan timbul. Saya juga menyadari bahwa ilmu kedokteran bukanlah ilmu pasti, maka keberhasilan tindakan kedokteran bukanlah keniscayaan, melainkan tergantung Tuhan YME\n                          </div>\n                        </div>\n                      </td>\n                    </tr>\n                    <tr>\n                      <td style="text-align: right;">\n                        <span style="margin-right: 10px;">\n                          Lokasi : <t t-esc="o['operating_unit_id']['company_id']['city']"/>, Tanggal : <t t-esc="o.to_date_string(data['registration_date'])"/>, Pukul :  <t t-esc="o.to_time_string(data['registration_date'])"/>                        </span>\n                      </td>\n                    </tr>\n                    <tr>\n                      <td>\n                        <div class="row mt-2" style="page-break-inside: avoid; page-break-before: auto; width: 100%;">\n                          <div class="col-3 text-center">\n                            <div class="mb-1">Yang Menyatakan </div>\n                            <t t-if="'sign-pj' in data">\n                              <div style="width:110px;height:80px; margin: auto;">\n                                  <img height="80" t-att-src="data['sign-pj']"/>\n                                </div>\n                            </t>\n                            <div class="mt-2"><strong>( <t t-esc="data['nama-pj']"/> )</strong></div>\n                          </div>\n                          <div class="col-3 text-center"> \n                            <div class="mb-1">Dokter</div>\n                            <div style="width:110px;height:80px; margin: auto;">\n                              <t t-if="'dokter-pelaksana' in data and data['dokter-pelaksana'] in 'Dr. dr. Tirta Darmawan Susanto, Mkes FSASS'">\n                                <img t-att-src="'/ehealth_document/static/src/img/signature/signature-wellclinic-dr-tirta.png'" height="80" alt="Signature"/>\n                              </t>\n                              <t t-if="'dokter-pelaksana' in data and data['dokter-pelaksana'] in 'dr. Steve Emmanuel'">\n                                <img t-att-src="'/ehealth_document/static/src/img/signature/signature-wellclinic-dr-steve.png'" height="80" alt="Signature"/>\n                              </t>\n                              <t t-if="'dokter-pelaksana' in data and data['dokter-pelaksana'] in 'dr. Catherine Ranatan'">\n                                <img t-att-src="'/ehealth_document/static/src/img/signature/signature-wellclinic-dr-catherine.png'" height="80" alt="Signature"/>\n                              </t>\n                            </div>\n                            <!-- <t t-if="'qr_code_examiner_url' in data"> -->\n                              <!-- <div style="width:110px;height:80px; margin: auto;"> -->\n                                  <!-- <img height="80" t-att-src="data['qr_code_examiner_url']"></img> -->\n                                <!-- </div> -->\n                            <!-- </t> -->\n                            <!-- <t t-else=""> -->\n                              <!-- <div style="width:110px;height:80px; margin: auto;"></div> -->\n                            <!-- </t> -->\n                            <div class="mt-2"><strong>( <t t-esc="data['dokter-pelaksana']"/> )</strong> </div>\n                          </div>\n                          <t t-if="'saksi' in data">\n                            <t t-foreach="data['saksi']" t-as="saksi">\n                              <div class="col-3 text-center">\n                                  <div class="mb-1"> Saksi <t t-esc="saksi['saksi-idx']"/></div>\n                                  <t t-if="'sign-img' in saksi">\n                                    <div style="width:110px;height:80px; margin: auto;">\n                                      <img height="80" t-att-src="saksi['sign-img']"/>\n                                    </div>\n                                  </t>\n                                  <p class="mb-0 mt-2"><strong>( <t t-esc="saksi['nama-saksi']"/> )</strong></p>\n                              </div>\n                            </t>\n                          </t>\n                        </div>\n                        <div class="row mt-2" style="margin: 0px;">\n                          ** Bila pasien tidak kompeten atau tidak mau menerima informasi, maka penerima informasi adalah wali atau keluarga terdekat (suami, istri, ayah/ibu kandung, kakak/adik kandung, anak kandung)\t\t\t\t\n                        </div>\n                        <div class="row" style="margin: 0px;">\n                          * Coret pada pernyataan yang tidak sesuai\t\t\t\n                        </div>\n                      </td>\n                    </tr>\n                    \n                  </tbody>\n                </table>\n                \n              </div>\n            </div>\n          </div>\n        </t>\n      </t>\n    	\N	\N	primary	t	1	2025-08-28 11:34:01.364376	1	2025-08-28 11:34:01.364376	f
1590	report_praktekbidandwi_kki_informed_consent	\N	ehealth_document.report_praktekbidandwi_kki_informed_consent	16	qweb	<?xml version="1.0"?>\n<t t-name="ehealth_document.report_praktekbidandwi_kki_informed_consent">\n        <t t-set="company" t-value="res_company"/>\n        <t t-call="ehealth_document.header_praktekbidandwi_document">\n          <t t-set="o" t-value="o.with_context(lang=lang)"/> \n          <div class="page" style="font-size:13px; line-height: 1.4;">\n            <div style="height: 50px;"/>\n            <div class="" style="">\n              <div class="">\n\n                <table style="width: 100%; margin: 0;" class="table table-bordered table-sm">\n                  <thead><tr><th colspan="4" style="text-align: center;"><strong>PEMBERIAN INFORMASI</strong></th></tr></thead>\n                  <tbody>\n                    <tr>\n                      <td style="width: 224px;" colspan="2">Nama &amp; Jabatan Pemberi Informasi</td>\n                      <td style="width: 493px; padding-left: 5px; margin: 0;" colspan="2">\n                        <t t-if="'dokter-pelaksana' in data">\n                          <!-- <span><t t-esc="data['dokter-pelaksana']"/></span> -->\n                          <span>Tester</span>\n                        </t>\n                      </td>\n                    </tr>\n                    <tr>\n                      <td style="width: 224px;" colspan="2">Nama Pasien</td>\n                      <td style="width: 493px; padding-left: 5px; margin: 0;" colspan="2">\n                        <span><t t-esc="o['partner_id']['name']"/> </span>\n                      </td>\n                    </tr>\n                    <tr>\n                      <td style="width: 224px;" colspan="2">Nomor Rekam Medis</td>\n                      <td style="width: 493px; padding-left: 5px; margin: 0;" colspan="2">\n                        <t t-if="'no-cm' in data">\n                          <span><t t-esc="data['no-cm']"/></span>\n                        </t>\n                      </td>\n                    </tr>\n                    <tr>\n                      <td style="width: 224px;" colspan="2">Tempat/Tanggal Lahir</td>\n                      <td style="width: 493px; padding-left: 5px; margin: 0;" colspan="2">\n                        <span> <t t-esc="o['partner_id']['birth_place']"/></span>,\n                        <span> <t t-esc="o['partner_id']['birthDate'].strftime('%d-%m-%Y')"/></span>\n                        (<span> <t t-esc="o.count_age(o['partner_id']['birthDate'].strftime('%d/%m/%Y'))"/></span> Tahun)\n                      </td>\n                    </tr>\n                    <tr>\n                      <td style="width: 224px;" colspan="2">Jenis Kelamin</td>\n                      <td style="width: 493px; padding-left: 5px; margin: 0;" colspan="2">\n                        <span><t t-if="o['partner_id']['gender'] == 'male'">Laki-Laki</t><t t-else="">Perempuan</t></span>\n                      </td>\n                    </tr>\n                    <tr>\n                      <td style="width: 224px;" colspan="2">Alamat Pasien</td>\n                      <td style="width: 493px; padding-left: 5px; margin: 0;" colspan="2">\n                        <span><t t-esc="o['partner_id']['street']"/> </span>\n                      </td>\n                    </tr>\n\n                    <tr><td colspan="4" style="text-align: center;"><strong>Jika penerima informasi bukan pasien**, lengkapi isian pada dua kolom di bawah </strong></td></tr>\n                    <tr>\n                      <td style="width: 224px;" colspan="2">Nama Penerima Informasi</td>\n                      <td style="width: 493px; padding-left: 5px; margin: 0;" colspan="2">\n                        <t t-if="'nama-pj' in data">\n                          <span><t t-esc="data['nama-pj']"/></span>\n                        </t>\n                      </td>\n                    </tr>\n                    <tr>\n                      <td style="width: 224px;" colspan="2">Hubungan dengan Pasien</td>\n                      <td style="width: 493px; padding-left: 5px; margin: 0;" colspan="2">\n                        <t t-if="'relasi-pj' in data">\n                          <span><t t-esc="data['relasi-pj']"/></span>\n                        </t>\n                      </td>\n                    </tr>\n                    \n                    <tr style="height: 23px;">\n                      <td style="width: 15px; height: 23px; text-align: center;"><strong>No</strong></td>\n                      <td style="width: 209px; height: 23px; text-align: center;"><strong>JENIS INFORMASI</strong></td>\n                      <td style="width: 493px; height: 23px; text-align: center;"><strong>ISI INFORMASI</strong></td>\n                      <td style="width: 90px; height: 23px; text-align: center;"><strong>Verifikasi</strong></td>\n                    </tr>\n                    <tr style="height: 23px;">\n                      <td style="width: 15px; height: 23px;">1</td>\n                      <td style="width: 209px; height: 23px;">Diagnosis (WD &amp; DD)</td>\n                      <td style="width: 493px; height: 23.5px; padding-left: 5px; margin: 0;">\n                        <t t-if="'diagnosis' in data">\n                          <span><t t-esc="data['diagnosis']"/></span>\n                        </t>\n                      </td>\n                      <td style="width: 90px; height: 23px; text-align: center;">\n                        <span><t t-if="'diagnosis' in data"><b>✓</b></t></span>\n                      </td>\n                    </tr>\n                    <tr style="height: 23px;">\n                      <td style="width: 15px; height: 23px;">2</td>\n                      <td style="width: 209px; height: 23px;">Dasar Diagnosis</td>\n                      <td style="width: 493px; height: 23px; padding-left: 5px; margin: 0;">\n                        <t t-if="'dasar-diagnosis' in data">\n                          <span><t t-esc="data['dasar-diagnosis']"/></span>\n                        </t>\n                      </td>\n                      <td style="width: 90px; height: 23px; text-align: center;">\n                        <span><t t-if="'dasar-diagnosis' in data"><b>✓</b></t></span>\n                      </td>\n                    </tr>\n                    <tr style="height: 23px;">\n                      <td style="width: 15px; height: 23px;">3</td>\n                      <td style="width: 209px; height: 23px;">Tindakan Kedokteran</td>\n                      <td style="width: 493px; height: 23px; padding-left: 5px; margin: 0;">\n                        <t t-if="'tindakan-kedokteran' in data">\n                          <span><t t-esc="data['tindakan-kedokteran']"/></span>\n                        </t>\n                      </td>\n                      <td style="width: 90px; height: 23px; text-align: center;">\n                        <span><t t-if="'tindakan-kedokteran' in data"><b>✓</b></t></span>\n                      </td>\n                    </tr>\n                    <tr style="height: 23px;">\n                      <td style="width: 15px; height: 23px;">4</td>\n                      <td style="width: 209px; height: 23px;">Indikasi Tindakan</td>\n                      <td style="width: 493px; height: 23px; padding-left: 5px; margin: 0;">\n                        <t t-if="'indikasi-tindakan' in data">\n                          <span><t t-esc="data['indikasi-tindakan']"/></span>\n                        </t>\n                      </td>\n                      <td style="width: 90px; height: 23px; text-align: center;">\n                        <span><t t-if="'indikasi-tindakan' in data"><b>✓</b></t></span>\n                      </td>\n                    </tr>\n                    <tr style="height: 23px;">\n                      <td style="width: 15px; height: 23px;">5</td>\n                      <td style="width: 209px; height: 23px;">Tata Cara</td>\n                      <td style="width: 493px; height: 23px; padding-left: 5px; margin: 0;">\n                        <t t-if="'tata-cara' in data">\n                          <span><t t-esc="data['tata-cara']"/></span>\n                        </t>\n                      </td>\n                      <td style="width: 90px; height: 23px; text-align: center;">\n                        <span><t t-if="'tata-cara' in data"><b>✓</b></t></span>\n                      </td>\n                    </tr>\n                    <tr style="height: 23px;">\n                      <td style="width: 15px; height: 23px;">6</td>\n                      <td style="width: 209px; height: 23px;">Tujuan</td>\n                      <td style="width: 493px; height: 23px; padding-left: 5px; margin: 0;">\n                        <t t-if="'tujuan' in data">\n                          <span><t t-esc="data['tujuan']"/></span>\n                        </t>\n                      </td>\n                      <td style="width: 90px; height: 23px; text-align: center;">\n                        <span><t t-if="'tujuan' in data"><b>✓</b></t></span>\n                      </td>\n                    </tr>\n                    <tr style="height: 23px;">\n                      <td style="width: 15px; height: 23px;">7</td>\n                      <td style="width: 209px; height: 23px;">Risiko</td>\n                      <td style="width: 493px; height: 23px; padding-left: 5px; margin: 0;">\n                        <t t-if="'risiko' in data">\n                          <span><t t-esc="data['risiko']"/></span>\n                        </t>\n                      </td>\n                      <td style="width: 90px; height: 23px; text-align: center;">\n                        <span><t t-if="'risiko' in data"><b>✓</b></t></span>\n                      </td>\n                    </tr>\n                    <tr style="height: 23px;">\n                      <td style="width: 15px; height: 23px;">8</td>\n                      <td style="width: 209px; height: 23px;">Komplikasi</td>\n                      <td style="width: 493px; height: 23px; padding-left: 5px; margin: 0;">\n                        <t t-if="'komplikasi' in data">\n                          <span><t t-esc="data['komplikasi']"/></span>\n                        </t>\n                      </td>\n                      <td style="width: 90px; height: 23px; text-align: center;">\n                        <span><t t-if="'komplikasi' in data"><b>✓</b></t></span>\n                      </td>\n                    </tr>\n                    <tr style="height: 23px;">\n                      <td style="width: 15px; height: 23px;">9</td>\n                      <td style="width: 209px; height: 23px;">Prognosis</td>\n                      <td style="width: 493px; height: 23px; padding-left: 5px; margin: 0;">\n                        <t t-if="'prognosis' in data">\n                          <span><t t-esc="data['prognosis']"/></span>\n                        </t>\n                      </td>\n                      <td style="width: 90px; height: 23px; text-align: center;">\n                        <span><t t-if="'prognosis' in data"><b>✓</b></t></span>\n                      </td>\n                    </tr>\n                    <tr style="height: 23px;">\n                      <td style="width: 15px; height: 23px;">10</td>\n                      <td style="width: 209px; height: 23px;">Alternatif &amp; Risiko</td>\n                      <td style="width: 493px; height: 23px; padding-left: 5px; margin: 0;">\n                        <t t-if="'alternatif-risiko' in data">\n                          <span><t t-esc="data['alternatif-risiko']"/></span>\n                        </t>\n                      </td>\n                      <td style="width: 90px; height: 23px; text-align: center;">\n                        <span><t t-if="'alternatif-risiko' in data"><b>✓</b></t></span>\n                      </td>\n                    </tr>\n                    <tr style="height: 23px;">\n                      <td style="width: 15px; height: 23px;">11</td>\n                      <td style="width: 209px; height: 23px;">Lain-lain</td>\n                      <td style="width: 493px; height: 23px; padding-left: 5px; margin: 0;">\n                        <t t-if="'lain-lain' in data">\n                          <span><t t-esc="data['lain-lain']"/></span>\n                        </t>\n                      </td>\n                      <td style="width: 90px; height: 23px; text-align: center;">\n                        <span><t t-if="'lain-lain' in data"><b>✓</b></t></span>\n                      </td>\n                    </tr>\n                    <tr style="height: 23px;">\n                      <td style="width: 15px; height: 23px;"/>\n                      <td style="width: 209px; height: 23px;"/>\n                      <td colspan="2" style="text-align: right;">\n                        <span style="margin-right: 10px;">\n                          Lokasi : <t t-esc="o['operating_unit_id']['company_id']['city']"/>, Tanggal : <t t-esc="o.to_date_string(data['registration_date'])"/>, Pukul :  <t t-esc="o.to_time_string(data['registration_date'])"/>\n                        </span>\n                      </td>\n                    </tr>\n                  </tbody>\n                </table>\n\n                <table style="width: 100%; margin: 0;" class="table table-bordered table-sm">\n                  <tbody>\n                    <tr>\n                      <td rowspan="2" style="width: 75%; vertical-align: middle;">\n                        Dengan ini menyatakan bahwa saya telah menerangkan hal-hal di atas secara benar dan jelas dan memberikan kesempatan untuk bertanya dan/atau berdiskusi\n                      </td>\n                      <td style="width: 25%; text-align: center;">\n                        Tanda Tangan Dokter:\n                      </td>\n                    </tr>\n                    <tr>\n                      <td>\n                        <!-- <t t-if="'qr_code_examiner_url' in data"> -->\n                          <!-- <div style="width:110px;height:80px; margin: auto;"> -->\n                            <!-- <img height="80" t-att-src="data['qr_code_examiner_url']"></img> -->\n                          <!-- </div> -->\n                        <!-- </t> -->\n                        <!-- <t t-else=""> -->\n                          <div style="width:110px;height:80px; margin: auto;"/>\n                        <!-- </t> -->\n                      </td>\n                    </tr>\n                    <tr>\n                      <td rowspan="2" style="width: 75%; vertical-align: middle;">\n                        Dengan ini menyatakan bahwa saya telah menerima informasi sebagaimana di atas yang saya beri tanda √ / paraf di kolom kanannya, dan telah memahaminya\n                      </td>\n                      <td style="width: 25%; text-align: center;">\n                        Tanda Tangan Pasien/Wali Pasien:\n                      </td>\n                    </tr>\n                    <tr>\n                      <td>\n                        <t t-if="'sign-pj' in data">\n                          <div style="width:110px;height:80px; margin: auto;">\n                            <img height="80" t-att-src="data['sign-pj']"/>\n                          </div>\n                        </t>\n                      </td>\n                    </tr>\n                  </tbody>\n                </table>\n\n                <div style="page-break-after: always; break-after: always;"> </div>\n                <div style="height: 50px;"/>\n\n                <table style="width: 100%; margin: 0;" class="table table-bordered table-sm">\n                  <tbody>\n                    <tr><td style="text-align: center;"><strong>PERSETUJUAN PROSEDUR TINDAKAN MEDIS (CONSENT)</strong></td></tr>\n                    <tr>\n                      <td>\n                        <div class="row mb-1" style="margin: 0px;">Yang bertanda tangan di bawah ini: </div>\n                        <div class="row mb-1">\n                          <div class="col-3">Nama </div>\n                          <div class="col-4">: <t t-if="'nama-pj' in data"> <span><t t-esc="data['nama-pj']"/></span></t> </div>\n                          <div class="col-4"><span><t t-if="o['partner_id']['gender'] == 'male'">Laki-Laki</t><t t-else="">Perempuan</t></span></div>\n                        </div>\n                        <div class="row mb-1">\n                          <div class="col-3">No. KTP/SIM/PASPOR  </div>\n                          <div class="col-4">: <t t-if="'identifier-pj' in data"> <span><t t-esc="data['identifier-pj']"/></span></t></div>\n                          <div class="col-2">Tgl Lahir/Umur</div>\n                          <div class="col-3">:\n                            <t t-if="'tgl-lahir-pj' in data">\n                              <t t-esc="data['tgl-lahir-pj']"/>\n                              ( <t t-esc="o.count_age(data['tgl-lahir-pj'].replace('-', '/'))"/> Th )\n                            </t>\n                          </div>\n                        </div>\n                        <div class="row mb-1">\n                          <div class="col-3">Alamat Pasien  </div>\n                          <div class="col-4">: <span style="margin-right: 15px;"><span><t t-esc="o['partner_id']['street']"/> </span></span></div>\n                          <div class="col-2">Telepon</div>\n                          <div class="col-3">: <t t-if="'telepon-pj' in data"> <span><t t-esc="data['telepon-pj']"/></span></t></div>\n                        </div>\n                      </td>\n                    </tr>\n                    <tr>\n                      <td>\n                        <div class="row mb-1">\n                          <div class="col-3">Hubungan dengan pasien</div>\n                          <div class="col-8">: \n                            <t t-if="'relasi-pj' in data">\n                              <span><t t-esc="data['relasi-pj']"/></span>\n                            </t>\n                          </div>\n                        </div>\n                      </td>\n                    </tr>\n                    <tr>\n                      <td>\n                        <div class="row mb-1">\n                          <div class="col-1"/>\n                          <div class="col-11">Dengan ini menyatakan sesungguhnya, bahwa saya telah menerima informasi yang diberikan oleh dokter sebagaimana di atas dan telah memahaminya. Untuk itu saya memberikan \n                            <t t-if="'jenis-consent' in data and data['jenis-consent'] == 'Persetujuan'">\n                              PERSETUJUAN / <span style="text-decoration: line-through;">PENOLAKAN </span>\n                            </t>\n                            <t t-if="'jenis-consent' in data and data['jenis-consent'] == 'Penolakan'">\n                              <span style="text-decoration: line-through;">PERSETUJUAN</span> / PENOLAKAN \n                            </t>\n                          *  untuk dilakukan tindakan tersebut terhadap : \n                          </div>\n                        </div>\n                        <div class="row mb-1">\n                          <div class="col-3">Nama </div>\n                          <div class="col-4">: <t t-esc="o['partner_id']['name']"/> </div>\n                          <div class="col-4"><span><t t-if="o['partner_id']['gender'] == 'male'">Laki-Laki</t><t t-else="">Perempuan</t></span></div>\n                        </div>\n                        <div class="row mb-1">\n                          <div class="col-3">No. Rekam Medis  </div>\n                          <div class="col-4">: <t t-if="'no-cm' in data"><t t-esc="data['no-cm']"/></t><t t-else="">-</t></div>\n                          <div class="col-2">Tgl Lahir/Umur</div>\n                          <div class="col-3">: \n                            <t t-esc="o['partner_id']['birthDate'].strftime('%d-%m-%Y')"/>  \n                            ( <t t-esc="o.count_age(o['partner_id']['birthDate'].strftime('%d/%m/%Y'))"/> Th )\n                          </div>\n                        </div>\n                        <div class="row mb-1">\n                          <div class="col-3">Alamat Pasien  </div>\n                          <div class="col-8">: <span><span><t t-esc="o['partner_id']['street']"/> </span></span> </div>\n                        </div>\n                        <div class="row mb-1">\n                          <div class="col-1"/>\n                          <div class="col-11">Saya memahami perlunya dan manfaat tindakan tersebut termasuk risiko dan komplikasi yang akan timbul. Saya juga menyadari bahwa ilmu kedokteran bukanlah ilmu pasti, maka keberhasilan tindakan kedokteran bukanlah keniscayaan, melainkan tergantung Tuhan YME\n                          </div>\n                        </div>\n                      </td>\n                    </tr>\n                    <tr>\n                      <td style="text-align: right;">\n                        <span style="margin-right: 10px;">\n                          Lokasi : <t t-esc="o['operating_unit_id']['company_id']['city']"/>, Tanggal : <t t-esc="o.to_date_string(data['registration_date'])"/>, Pukul :  <t t-esc="o.to_time_string(data['registration_date'])"/>                        </span>\n                      </td>\n                    </tr>\n                    <tr>\n                      <td>\n                        <div class="row mt-2" style="page-break-inside: avoid; page-break-before: auto; width: 100%;">\n                          <div class="col-3 text-center">\n                            <div class="mb-1">Yang Menyatakan </div>\n                            <t t-if="'sign-pj' in data">\n                              <div style="width:110px;height:80px; margin: auto;">\n                                  <img height="80" t-att-src="data['sign-pj']"/>\n                                </div>\n                            </t>\n                            <div class="mt-2"><strong>( <t t-esc="data['nama-pj']"/> )</strong></div>\n                          </div>\n                          <div class="col-3 text-center"> \n                            <div class="mb-1">Dokter</div>\n                            <!-- <t t-if="'qr_code_examiner_url' in data"> -->\n                              <!-- <div style="width:110px;height:80px; margin: auto;"> -->\n                                  <!-- <img height="80" t-att-src="data['qr_code_examiner_url']"></img> -->\n                                <!-- </div> -->\n                            <!-- </t> -->\n                            <!-- <t t-else=""> -->\n                              <div style="width:110px;height:80px; margin: auto;"/>\n                            <!-- </t> -->\n                            <div class="mt-2"><strong>( <t t-esc="data['dokter-pelaksana']"/> )</strong> </div>\n                          </div>\n                          <t t-if="'saksi' in data">\n                            <t t-foreach="data['saksi']" t-as="saksi">\n                              <div class="col-3 text-center">\n                                  <div class="mb-1"> Saksi <t t-esc="saksi['saksi-idx']"/></div>\n                                  <t t-if="'sign-img' in saksi">\n                                    <div style="width:110px;height:80px; margin: auto;">\n                                      <img height="80" t-att-src="saksi['sign-img']"/>\n                                    </div>\n                                  </t>\n                                  <p class="mb-0 mt-2"><strong>( <t t-esc="saksi['nama-saksi']"/> )</strong></p>\n                              </div>\n                            </t>\n                          </t>\n                        </div>\n                        <div class="row mt-2" style="margin: 0px;">\n                          ** Bila pasien tidak kompeten atau tidak mau menerima informasi, maka penerima informasi adalah wali atau keluarga terdekat (suami, istri, ayah/ibu kandung, kakak/adik kandung, anak kandung)\t\t\t\t\n                        </div>\n                        <div class="row" style="margin: 0px;">\n                          * Coret pada pernyataan yang tidak sesuai\t\t\t\n                        </div>\n                      </td>\n                    </tr>\n                    \n                  </tbody>\n                </table>\n                \n              </div>\n            </div>\n          </div>\n        </t>\n      </t>\n    	ehealth_document/report/template_informed_consent/report_praktekbidandwi_kki_informed_consent.xml	\N	\N	\N	\N	primary	t	1	2025-08-28 11:34:01.364376	1	2025-08-28 11:34:01.364376	f
1591	report_pmbdian_informed_consent	\N	ehealth_document.report_pmbdian_informed_consent	16	qweb	<?xml version="1.0"?>\n<t t-name="ehealth_document.report_pmbdian_informed_consent">\n        <t t-set="company" t-value="res_company"/>\n        <t t-call="ehealth_document.header_pmbdian_document">\n          <div class="page">\n            <div class="row">\n              <div class="col-md-12" style="margin-top: 80px">\n                <p class="text-center mt-3 mb-0"><strong>Surat Pernyataan Tindakan Medis</strong></p>\n                <p class="text-center">Nomor: <t t-esc="o['name']"/></p>\n                <p class="mt-3">Yang bertanda tangan di bawah ini, saya:</p>\n                <div class="mt-1 ml-3">\n                    <div class="row">\n                        <div class="col-3">Nama</div>\n                        <div class="col-6">: <strong><t t-esc="data['nama-pj']"/></strong></div>\n                    </div>\n                    <t t-if="'umur-pj' in data">\n                      <div class="row">\n                        <div class="col-3">Umur</div>\n                        <div class="col-6">: <t t-esc="data['umur-pj']"/></div>\n                      </div>\n                    </t>\n                    <t t-if="'tgl-lahir-pj' in data">\n                      <div class="row">\n                        <div class="col-3">Tanggal Lahir</div>\n                        <div class="col-6">: <t t-esc="data['tgl-lahir-pj']"/></div>\n                      </div>\n                    </t>\n                    <div class="row">\n                        <div class="col-3">Jenis Kelamin</div>\n                        <div class="col-6">:\n                          <t t-if="data['jenis-kelamin-pj'] == 'male'">Laki-Laki</t>\n                          <t t-else="">Perempuan</t>\n                        </div>\n                    </div>\n                    <t t-if="'relasi-pj' in data">\n                      <div class="row">\n                          <div class="col-3">Relasi dengan pasien</div>\n                           <div class="col-6">: <t t-esc="data['relasi-pj']"/></div>\n                      </div>\n                    </t>\n                </div>\n                <p>Dengan ini saya menyatakan dengan sesungguhnya telah memberikan</p>\n                <p class="mt-2 mb-2 text-center"><strong><t t-esc="data['jenis-consent']"/></strong></p>\n                <t t-if="'tujuan-consent' in data">\n                  <p>untuk dilakukan <t t-esc="data['tujuan-consent']"/> berupa</p>\n                </t>\n                <t t-else="">\n                  <p>untuk dilakukan pemeriksaan, pengobatan dan tindakan medis berupa</p>\n                </t>\n                <p class="mt-2 mb-2 text-center"><t t-esc="data['objek-consent']"/></p>\n                <t t-if="'catatan-consent' in data">\n                  <p>Dengan catatan</p>\n                  <p><t t-esc="data['catatan-consent']"/></p>\n                </t>\n                <p>terhadap <t t-esc="data['relasi-pj']"/> saya dengan identitas sebagai berikut: </p>\n                <div class="mt-3 ml-3">\n                    <div class="row">\n                        <div class="col-3">Nama</div>\n                        <div class="col-6">: <strong><t t-esc="o['partner_id']['name']"/></strong></div>\n                    </div>\n                    <div class="row">\n                        <div class="col-3">Tanggal Lahir</div>\n                        <div class="col-6">: <t t-esc="o['partner_id']['birthDate'].strftime('%d-%m-%Y')"/></div>\n                    </div>\n                    <div class="row">\n                        <div class="col-3">Jenis Kelamin</div>\n                        <div class="col-6">: \n                          <t t-if="o['partner_id']['gender'] == 'male'">Laki-Laki</t>\n                          <t t-else="">Perempuan</t>\n                        </div>\n                    </div>\n                    <div class="row">\n                        <div class="col-3">Alamat</div>\n                        <div class="col-6">: <t t-esc="o['partner_id']['street']"/></div>\n                    </div>\n                    <t t-if="'no-cm' in data">\n                        <div class="row">\n                            <div class="col-3">No. CM</div>\n                            <div class="col-6">: <t t-esc="data['no-cm']"/></div>\n                        </div>\n                    </t>\n                </div>\n                <p class="mt-3" style="page-break-inside: avoid; page-break-before: auto;">yang cara, manfaat dan tujuan serta resiko yang ditimbulkan dari pemeriksaan, pengobatan serta tindakan medis tersebut di atas telah dijelaskan oleh dokter dan saya telah mengerti sepenuhnya.</p>\n                <p>Demikian pernyataan ini saya buat dengan penuh kesadaran dan tanpa paksaan agar dapat dipergunakan sebagaimana mestinya.</p><br/>\n              </div>\n            </div>\n            <div class="row" style="page-break-inside: avoid; page-break-before: auto;">\n                <div class="col-4">\n                    <p class="pt-3 mb-2">Bidan yang Memberi Penjelasan</p>\n                  <!-- <img t-att-src="o['qr_code_url']" style="width:110px;height:110px;" /> -->\n                    <div style="width:110px;height:80px;">\n                      <t t-if="'practitioner' in data and data['practitioner'] and 'sign-img' in data['practitioner']">\n                        <img height="80" t-att-src="data['practitioner']['sign-img']"/>\n                      </t>\n                    </div>\n                    <p class="mb-0 mt-2">\n                      <strong>Dian Indah Wahyuningsih, S.Tr.Keb.</strong>\n                    </p>\n                </div>\n                <div class="col-4"/>\n                <div class="col-4">\n                    <p class="mb-0"><t t-esc="o['operating_unit_id']['company_id']['city']"/>, <t t-esc="o.to_date_string(data['registration_date'])"/></p>\n                    <p class="mb-0">Yang Memberi Pernyataan</p>\n                    <t t-if="'sign-pj' in data">\n                      <div style="width:110px;height:80px;">\n                          <img height="80" t-att-src="data['sign-pj']"/>\n                        </div>\n                    </t>\n                    <p class="mb-0 mt-2"><strong><t t-esc="data['nama-pj']"/></strong></p>\n                </div>\n            </div>\n            <div class="row mt-3" style="page-break-inside: avoid; page-break-before: auto;">\n                <t t-if="'nama-saksi-1' in data">\n                  <div class="col-4">\n                    <p class="mb-0">Saksi 1</p>\n                    <div style="width:110px;height:80px;"/>\n                    <p class="mb-0 mt-2"><strong><t t-esc="o.arrange_signature(data['nama-saksi-1'])"/></strong></p>\n                  </div>\n                </t>\n                <t t-if="'nama-saksi-2' in data">\n                  <div class="col-4"/>\n                  <div class="col-4">\n                    <p class="mb-0">Saksi 2</p>\n                    <div style="width:110px;height:80px;"/>\n                    <p class="mb-0 mt-2"><strong><t t-esc="o.arrange_signature(data['nama-saksi-2'])"/></strong></p>\n                  </div>\n                </t>\n                <t t-if="'saksi' in data">\n                  <t t-foreach="data['saksi']" t-as="saksi">\n                    <div class="col-4">\n                        <p> Saksi\n                            <t t-esc="saksi['saksi-idx']"/>\n                        </p>\n                        <div style="width:110px;height:80px;">\n                          <img height="80" t-att-src="saksi['sign-img']"/>\n                        </div>\n                        <p class="mb-0 mt-2"><strong><t t-esc="o.arrange_signature(saksi['nama-saksi'])"/></strong></p>\n                    </div>\n                    <div class="col-4"/>\n                  </t>\n                </t>\n            </div>\n          </div>\n        </t>\n      </t>\n    	ehealth_document/report/template_informed_consent/report_pmbdian_informed_consent.xml	\N	\N	\N	\N	primary	t	1	2025-08-28 11:34:01.364376	1	2025-08-28 11:34:01.364376	f
1592	report_pmbfatma_informed_consent	\N	ehealth_document.report_pmbfatma_informed_consent	16	qweb	<?xml version="1.0"?>\n<t t-name="ehealth_document.report_pmbfatma_informed_consent">\n        <t t-set="company" t-value="res_company"/>\n        <t t-call="ehealth_document.header_pmbfatma_document">\n          <div class="page">\n            <div class="row">\n              <div class="col-md-12" style="margin-top: 80px">\n                <p class="text-center mt-3 mb-0"><strong>Surat Pernyataan Tindakan Medis</strong></p>\n                <p class="text-center">Nomor: <t t-esc="o['name']"/></p>\n                <p class="mt-3">Yang bertanda tangan di bawah ini, saya:</p>\n                <div class="mt-1 ml-3">\n                    <div class="row">\n                        <div class="col-3">Nama</div>\n                        <div class="col-6">: <strong><t t-esc="data['nama-pj']"/></strong></div>\n                    </div>\n                    <t t-if="'umur-pj' in data">\n                      <div class="row">\n                        <div class="col-3">Umur</div>\n                        <div class="col-6">: <t t-esc="data['umur-pj']"/></div>\n                      </div>\n                    </t>\n                    <t t-if="'tgl-lahir-pj' in data">\n                      <div class="row">\n                        <div class="col-3">Tanggal Lahir</div>\n                        <div class="col-6">: <t t-esc="data['tgl-lahir-pj']"/></div>\n                      </div>\n                    </t>\n                    <div class="row">\n                        <div class="col-3">Jenis Kelamin</div>\n                        <div class="col-6">:\n                          <t t-if="data['jenis-kelamin-pj'] == 'male'">Laki-Laki</t>\n                          <t t-else="">Perempuan</t>\n                        </div>\n                    </div>\n                    <t t-if="'relasi-pj' in data">\n                      <div class="row">\n                          <div class="col-3">Relasi dengan pasien</div>\n                           <div class="col-6">: <t t-esc="data['relasi-pj']"/></div>\n                      </div>\n                    </t>\n                </div>\n                <p>Dengan ini saya menyatakan dengan sesungguhnya telah memberikan</p>\n                <p class="mt-2 mb-2 text-center"><strong><t t-esc="data['jenis-consent']"/></strong></p>\n                <t t-if="'tujuan-consent' in data">\n                  <p>untuk dilakukan <t t-esc="data['tujuan-consent']"/> berupa</p>\n                </t>\n                <t t-else="">\n                  <p>untuk dilakukan pemeriksaan, pengobatan dan tindakan medis berupa</p>\n                </t>\n                <p class="mt-2 mb-2 text-center"><t t-esc="data['objek-consent']"/></p>\n                <t t-if="'catatan-consent' in data">\n                  <p>Dengan catatan</p>\n                  <p><t t-esc="data['catatan-consent']"/></p>\n                </t>\n                <p>terhadap <t t-esc="data['relasi-pj']"/> saya dengan identitas sebagai berikut: </p>\n                <div class="mt-3 ml-3">\n                    <div class="row">\n                        <div class="col-3">Nama</div>\n                        <div class="col-6">: <strong><t t-esc="o['partner_id']['name']"/></strong></div>\n                    </div>\n                    <div class="row">\n                        <div class="col-3">Tanggal Lahir</div>\n                        <div class="col-6">: <t t-esc="o['partner_id']['birthDate'].strftime('%d-%m-%Y')"/></div>\n                    </div>\n                    <div class="row">\n                        <div class="col-3">Jenis Kelamin</div>\n                        <div class="col-6">: \n                          <t t-if="o['partner_id']['gender'] == 'male'">Laki-Laki</t>\n                          <t t-else="">Perempuan</t>\n                        </div>\n                    </div>\n                    <div class="row">\n                        <div class="col-3">Alamat</div>\n                        <div class="col-6">: <t t-esc="o['partner_id']['street']"/></div>\n                    </div>\n                    <t t-if="'no-cm' in data">\n                        <div class="row">\n                            <div class="col-3">No. CM</div>\n                            <div class="col-6">: <t t-esc="data['no-cm']"/></div>\n                        </div>\n                    </t>\n                </div>\n                <p class="mt-3" style="page-break-inside: avoid; page-break-before: auto;">yang cara, manfaat dan tujuan serta resiko yang ditimbulkan dari pemeriksaan, pengobatan serta tindakan medis tersebut di atas telah dijelaskan oleh dokter/tenaga kesehatan dan saya telah mengerti sepenuhnya.</p>\n                <p>Demikian pernyataan ini saya buat dengan penuh kesadaran dan tanpa paksaan agar dapat dipergunakan sebagaimana mestinya.</p><br/>\n              </div>\n            </div>\n            <div class="row" style="page-break-inside: avoid; page-break-before: auto;">\n                <div class="col-4">\n                    <p class="pt-3 mb-2">Bidan yang Memberi Penjelasan</p>\n                  <!-- <img t-att-src="o['qr_code_url']" style="width:110px;height:110px;" /> -->\n                    <div style="width:110px;height:80px;">\n                      <t t-if="'practitioner' in data and data['practitioner'] and 'sign-img' in data['practitioner']">\n                        <img height="80" t-att-src="data['practitioner']['sign-img']"/>\n                      </t>\n                    </div>\n                    <p class="mb-0 mt-2">\n                      <strong>Dian Indah Wahyuningsih, S.Tr.Keb.</strong>\n                    </p>\n                </div>\n                <div class="col-4"/>\n                <div class="col-4">\n                    <p class="mb-0"><t t-esc="o['operating_unit_id']['company_id']['city']"/>, <t t-esc="o.to_date_string(data['registration_date'])"/></p>\n                    <p class="mb-0">Yang Memberi Pernyataan</p>\n                    <t t-if="'sign-pj' in data">\n                      <div style="width:110px;height:80px;">\n                          <img height="80" t-att-src="data['sign-pj']"/>\n                        </div>\n                    </t>\n                    <p class="mb-0 mt-2"><strong><t t-esc="data['nama-pj']"/></strong></p>\n                </div>\n            </div>\n            <div class="row mt-3" style="page-break-inside: avoid; page-break-before: auto;">\n                <t t-if="'nama-saksi-1' in data">\n                  <div class="col-4">\n                    <p class="mb-0">Saksi 1</p>\n                    <div style="width:110px;height:80px;"/>\n                    <p class="mb-0 mt-2"><strong><t t-esc="o.arrange_signature(data['nama-saksi-1'])"/></strong></p>\n                  </div>\n                </t>\n                <t t-if="'nama-saksi-2' in data">\n                  <div class="col-4"/>\n                  <div class="col-4">\n                    <p class="mb-0">Saksi 2</p>\n                    <div style="width:110px;height:80px;"/>\n                    <p class="mb-0 mt-2"><strong><t t-esc="o.arrange_signature(data['nama-saksi-2'])"/></strong></p>\n                  </div>\n                </t>\n                <t t-if="'saksi' in data">\n                  <t t-foreach="data['saksi']" t-as="saksi">\n                    <div class="col-4">\n                        <p> Saksi\n                            <t t-esc="saksi['saksi-idx']"/>\n                        </p>\n                        <div style="width:110px;height:80px;">\n                          <img height="80" t-att-src="saksi['sign-img']"/>\n                        </div>\n                        <p class="mb-0 mt-2"><strong><t t-esc="o.arrange_signature(saksi['nama-saksi'])"/></strong></p>\n                    </div>\n                    <div class="col-4"/>\n                  </t>\n                </t>\n            </div>\n          </div>\n        </t>\n      </t>\n    	ehealth_document/report/template_informed_consent/report_pmbfatma_informed_consent.xml	\N	\N	\N	\N	primary	t	1	2025-08-28 11:34:01.364376	1	2025-08-28 11:34:01.364376	f
1593	report_default_general_consent	\N	ehealth_document.report_default_general_consent	16	qweb	<?xml version="1.0"?>\n<t t-name="ehealth_document.report_default_general_consent">\n\t\t\t<t t-set="company" t-value="res_company"/>\n\t\t\t<t t-call="web.external_layout">\n\t\t\t\t<t t-set="o" t-value="o.with_context(lang=lang)"/> \n\t\t\t\t<div class="page" style="font-size:13px; line-height: 1.4;">\n\t\t\t\t\t<div class="row" style="border: 1px solid black">\n\t\t\t\t\t\t<div class="">\n\t\t\t\t\t\t\t<div style="background-color:#c1d09d; border-bottom: 1px solid black">\n\t\t\t\t\t\t\t\t<p class="text-center mb-0" style="width: 100%;">\n\t\t\t\t\t\t\t\t\t<strong>PENGKAJIAN DATA UMUM PASIEN</strong>\n\t\t\t\t\t\t\t\t</p>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t<div class="row mt-2" style="border-bottom: 1px solid black">\n\t\t\t\t\t\t\t\t<div class="ml-3 mb-1">\n\t\t\t\t\t\t\t\t\t<p>Diisi oleh Petugas Pendaftaran pada</p>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<div class="ml-2 mb-1">\n\t\t\t\t\t\t\t\t\t<p>tanggal: <t t-if="'tgl-consent' in data"><t t-esc="data['tgl-consent']"/></t></p>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<div class="ml-5 mb-1">\n\t\t\t\t\t\t\t\t\t<p>jam: <t t-if="'waktu-consent' in data"><t t-esc="data['waktu-consent']"/></t></p>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t<div class="pl-2" style="border-bottom: 1px solid black">\n\t\t\t\t\t\t\t\t<p class="mb-0" style="font-size: 16px">\n\t\t\t\t\t\t\t\t\t<strong>IDENTITAS PASIEN</strong>\n\t\t\t\t\t\t\t\t</p>\n\t\t\t\t\t\t\t\t<p class="mb-0" style="font-style: italic;">(Diisi sesuai Kartu Tanda Pengenal Pasien yang masih berlaku; KTP/ KK/ SIM/ Kartu Pelajar/ dsb)</p>\n\t\t\t\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t\t\t\t<div class="col-3">Nomer Rekam Medis</div>\n\t\t\t\t\t\t\t\t\t<div class="col-8">: <t t-esc="data['no-cm']"/> </div>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t\t\t\t<div class="col-3">Nama</div>\n\t\t\t\t\t\t\t\t\t<div class="col-8">: <t t-esc="o['partner_id']['name']"/></div>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t\t\t\t<div class="col-3">Jenis Kelamin</div>\n\t\t\t\t\t\t\t\t\t<div class="col-8">:\n\t\t\t\t\t\t\t\t\t\t<t t-if="o['partner_id']['gender'] == 'male'">Laki-Laki</t>\n\t\t\t\t\t\t\t\t\t\t<t t-else="">Perempuan</t>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t\t\t\t<div class="col-3">Tanggal Lahir</div>\n\t\t\t\t\t\t\t\t\t<div class="col-8">: <t t-esc="o['partner_id']['birthDate'].strftime('%d-%m-%Y')"/></div>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t\t\t\t<div class="col-3">Agama</div>\n\t\t\t\t\t\t\t\t\t<div class="col-8">: <t t-if="'religion' in data"> <t t-esc="data['religion']"/> </t></div>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t\t\t\t<div class="col-3">Pendidikan</div>\n\t\t\t\t\t\t\t\t\t<div class="col-8">: </div>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t\t\t\t<div class="col-3">Pekerjaan</div>\n\t\t\t\t\t\t\t\t\t<div class="col-8">: <t t-if="'occupation' in data"> <t t-esc="data['occupation']"/> </t></div>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t\t\t\t<div class="col-3">Alamat</div>\n\t\t\t\t\t\t\t\t\t<div class="col-8">: <t t-esc="o['partner_id']['street']"/></div>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t\t\t\t<div class="col-3">Status Perkawinan</div>\n\t\t\t\t\t\t\t\t\t<div class="col-8">: <t t-if="'marital-status' in data"> <t t-esc="data['marital-status']"/> </t></div>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t\t\t\t<div class="col-3">Nama Suami / Istri</div>\n\t\t\t\t\t\t\t\t\t<div class="col-8">: <t t-if="'partner' in data"> <t t-esc="data['partner']"/> </t></div>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t\t\t\t<div class="col-3">Status Pembiayaan</div>\n\t\t\t\t\t\t\t\t\t<div class="col-8">: <t t-if="'payment' in data"> <t t-esc="data['payment']"/> </t></div>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t<div style="background-color:#c1d09d; border-bottom: 1px solid black">\n\t\t\t\t\t\t\t\t<p class="text-center mb-0" style="width: 100%;">\n\t\t\t\t\t\t\t\t\t<strong>PERSETUJUAN UMUM / GENERAL CONSENT</strong>\n\t\t\t\t\t\t\t\t</p>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t<p class="text-center mt-1 mb-0" style="font-style: italic; text-decoration: underline;">\n\t\t\t\t\t\t\t\t<strong>PASIEN / WALI PASIEN HARUS MEMBACA, MEMAHAMI DAN MENGISI INFORMASI BERIKUT</strong>\n\t\t\t\t\t\t\t</p>\n\t\t\t\t\t\t\t<p class="mt-1 mb-1">Yang bertanda tangan di bawah ini, saya:</p>\n\t\t\t\t\t\t\t<div class="pl-2">\n\t\t\t\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t\t\t\t<div class="col-3">Nama Lengkap</div>\n\t\t\t\t\t\t\t\t\t<div class="col-6">:\n\t\t\t\t\t\t\t\t\t\t<strong>\n\t\t\t\t\t\t\t\t\t\t\t<t t-esc="data['nama-pj']"/>\n\t\t\t\t\t\t\t\t\t\t</strong>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<t t-if="'tgl-lahir-pj' in data">\n\t\t\t\t\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t\t\t\t\t<div class="col-3">Tempat / Tanggal Lahir</div>\n\t\t\t\t\t\t\t\t\t\t<div class="col-6">: <t t-if="'tempat-lahir-pj' in data"><t t-esc="data['tempat-lahir-pj']"/></t>/<t t-if="'tgl-lahir-pj' in data"><t t-esc="data['tgl-lahir-pj']"/></t></div>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t</t>\n\t\t\t\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t\t\t\t<div class="col-3">Alamat</div>\n\t\t\t\t\t\t\t\t\t<div class="col-6">: <t t-if="'alamat-pj' in data"><t t-esc="data['alamat-pj']"/></t></div>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t\t\t\t<div class="col-3">No. Telepon</div>\n\t\t\t\t\t\t\t\t\t<div class="col-6">: <t t-if="'telepon-pj' in data"><t t-esc="data['telepon-pj']"/></t></div>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t\t\t\t<div class="col-3">Email</div>\n\t\t\t\t\t\t\t\t\t<div class="col-6">: <t t-if="'email-pj' in data"><t t-esc="data['email-pj']"/></t></div>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<t t-if="'relasi-pj' in data">\n\t\t\t\t\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t\t\t\t\t<div class="col-3">Bertindak atas</div>\n\t\t\t\t\t\t\t\t\t\t<div class="col-6">: <t t-if="'relasi-pj' in data"><t t-esc="data['relasi-pj']"/></t></div>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t</t>\n\t\t\t\t\t\t\t\t<div>Menyatakan</div>\n\t\t\t\t\t\t\t\t<div class="pr-3" style="page-break-inside: avoid; page-break-before: auto;">\n\t\t\t\t\t\t\t\t\t<div>\n\t\t\t\t\t\t\t\t\t\t<strong>I. PERSETUJUAN UNTUK PERAWATAN DAN PENGOBATAN</strong>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t<div class="d-flex ml-3">\n\t\t\t\t\t\t\t\t\t\t<div class="pr-1">1.</div>\n\t\t\t\t\t\t\t\t\t\t<div>Saya mengetahui bahwa saya membutuhkan perawatan medis dan mengijinkan dokter/tenaga Kesehatan lainnya di fasilitas Kesehatan RS/Klinik/<t t-esc="res_company.name"/> untuk melakukan pemeriksaan dan memberikan pengobatan / tindakan/ asuhan yang sesuai prosedur</div>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t<div class="d-flex ml-3">\n\t\t\t\t\t\t\t\t\t\t<div class="pr-1">2.</div>\n\t\t\t\t\t\t\t\t\t\t<div>Saya sadar bahwa praktik kedokteran bukanlah ilmu pasti dan saya mengakui bahwa tidak ada jaminan atas hasil apapun terhadap pengobatan / Tindakan/ asuhan yang dilakukan pada saya</div>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t<div class="d-flex ml-3">\n\t\t\t\t\t\t\t\t\t\t<div class="pr-1">3.</div>\n\t\t\t\t\t\t\t\t\t\t<div class="">\n\t\t\t\t\t\t\t\t\t\t\t<p>Saya mengerti dan memahami bahwa </p>\n\t\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t<div class="d-flex ml-5 pr-3">\n\t\t\t\t\t\t\t\t\t\t<div class="pr-1">a.</div>\n\t\t\t\t\t\t\t\t\t\t<div>Saya memiliki hak untuk menyatakan persetujuan atau penolakan untuk setiap jasa perawatan medis yang akan diberikan pada saya. Saya memahani bahwa pemberian jasa yang melibatkan data pribadi saya yang saya tolak, tanpanya layanan tidak dapat diberikan, seperti pemeriksaan penyakit pasien, pemberian obat, asuhan, dan tindakan medis.</div>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t<div class="d-flex ml-5 pr-3">\n\t\t\t\t\t\t\t\t\t\t<div class="pr-1">b.</div>\n\t\t\t\t\t\t\t\t\t\t<div>Saya memiliki hak untuk mengajukan pertanyaan terkait rencana pelayanan yang akan diberikan pada saya, termasuk identitas setiap orang yang akan memberikan jasa perawatan medis.</div>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t<div class="d-flex ml-5 pr-3">\n\t\t\t\t\t\t\t\t\t\t<div class="pr-1">c.</div>\n\t\t\t\t\t\t\t\t\t\t<div>Saya memiliki hak untuk melakukan pernarikan persetujuan saat kewajiban pihak fasilitas kesehatan menyediakan layanan belum terlaksana atau saya mengubah keputusan persetujan atau penolakan yang sebelumnya saya berikan</div>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t<div class="d-flex ml-3">\n\t\t\t\t\t\t\t\t\t\t<div class="pr-1">4.</div>\n\t\t\t\t\t\t\t\t\t\t<div class="">\n\t\t\t\t\t\t\t\t\t\t\t<p>Saya menyetujui bahwa dalam keadaan darurat (atau gawat darurat) data pribadi Saya hanya akan digunakan untuk kepentingan perawatan medis. Pemrosesan data ini hanya akan dilakukan apabila cara lain tidak dapat diupayakan seperti saya yang tidak sadarkan diri atau saya yang memerlukan tindakan segera di IGD.</p>\n\t\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<div class="pr-3" style="page-break-inside: avoid; page-break-before: auto;">\n\t\t\t\t\t\t\t\t\t<div>\n\t\t\t\t\t\t\t\t\t\t<strong>II. PERSETUJUAN PELEPASAN DATA</strong>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t<div class="d-flex ml-3">\n\t\t\t\t\t\t\t\t\t\t<div class="pr-1">1.</div>\n\t\t\t\t\t\t\t\t\t\t<div>Saya memahami bahwa informasi pribadi saya terkait dengan kondisi Kesehatan saya, berdasarkan pemeriksaan yang saya jalani di fasilitas Kesehatan RS/Klinik/<t t-esc="res_company.name"/> akan terjamin kerahasiaannya</div>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t<div class="d-flex ml-3">\n\t\t\t\t\t\t\t\t\t\t<div class="pr-1">2.</div>\n\t\t\t\t\t\t\t\t\t\t<div>Saya memberikan wewenang kepada fasilitas Kesehatan RS/Klinik/<t t-esc="res_company.name"/> untuk memberikan informasi berkaitan dengan kondisi Kesehatan saya untuk keperluan proses klaim asuransi dan administrasi resmi apabila diperlukan (BPJS, Kemenkenkes, Dinkes)</div>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t<div class="d-flex ml-3">\n\t\t\t\t\t\t\t\t\t\t<div class="pr-1">3.</div>\n\t\t\t\t\t\t\t\t\t\t<div>Saya memberi wewenang akses kepada fasilitas Kesehatan RS/Klinik/<t t-esc="res_company.name"/> untuk memberikan informasi Kesehatan saya kepada pihak berikut apabila diperlukan:</div>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t<div class="d-flex- ml-5">\n\t\t\t\t\t\t\t\t\t\t<t t-if="'authorized-parties' in data">\n\t\t\t\t\t\t\t\t\t\t\t<t t-foreach="data['authorized-parties']" t-as="name">\n\t\t\t\t\t\t\t\t\t\t\t\t<div><t t-esc="name"/></div>\n\t\t\t\t\t\t\t\t\t\t\t</t>\n\t\t\t\t\t\t\t\t\t\t</t>\n\t\t\t\t\t\t\t\t\t\t<t t-else="">\n\t\t\t\t\t\t\t\t\t\t\t<div style="height: 15px;"/>\n\t\t\t\t\t\t\t\t\t\t</t>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<div class="pr-3" style="page-break-inside: avoid; page-break-before: auto;">\n\t\t\t\t\t\t\t\t\t<div>\n\t\t\t\t\t\t\t\t\t\t<strong>III. HAK DAN KEWAJIBAN PASIEN</strong>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t<div class="ml-3">Saya telah mendapatkan informasi tentang “Hak dan Kewajiban Pasien” di fasilitas Kesehatan RS/Klinik/<t t-esc="res_company.name"/> melalui informasi yang diberikan kepada saya oleh petugas yang melayani saya.</div>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<div class="pr-3" style="page-break-inside: avoid; page-break-before: auto;">\n\t\t\t\t\t\t\t\t\t<div>\n\t\t\t\t\t\t\t\t\t\t<strong>IV. INTEGRITAS DATA MEDIS</strong>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t<div class="ml-3">Saya menyetujui bahwa segala data Rekam Medis, termasuk didalamnya Kesalahan Pemasukan Data atau Pengubahan diagnosis medis, tetap akan didokumentasikan karena menjadi bagian dari rekam medis pasien bahkan setelah diagnosis saya diperbaiki. Saya memahami bahwa hal ini bertujuan menjelaskan riwayat tindakan medis yang diberikan kepada pasien, atau untuk masalah kesehatan lainnya.</div>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<div class="pr-3" style="page-break-inside: avoid; page-break-before: auto;">\n\t\t\t\t\t\t\t\t\t<div>\n\t\t\t\t\t\t\t\t\t\t<strong>V. KOMUNIKASI</strong>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t<div class="ml-3">Saya bersedia untuk dihubungi melalui alamat atau alamat email sehubungan dengan reporting hack dan kegagalan/gangguan sistem yang berdampak serius mengenai dampak serius kebocoran data pribadi agar Saya dapat mengantisipasi risiko dari peristiwa tersebut. Selain itu Saya mengijinkan pelaporan ini untuk diberikan kepada otoritas yang berwenang dan segera tanpa menunda-nunda sesuai dengan peraturan perundang-undangan yang berlaku.</div>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class="row" style="page-break-inside: avoid; page-break-before: auto;">\n\t\t\t\t\t\t<div class="col-4">\n\t\t\t\t\t\t\t<p class="pt-3">Petugas</p>\n\t\t\t\t\t\t\t<t t-if="'practitioner-sign' in data">\n\t\t\t\t\t\t\t\t<div style="width:110px;height:60px;">\n\t\t\t\t\t\t\t\t\t<img height="80" t-att-src="data['practitioner-sign']"/>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t</t>\n\t\t\t\t\t\t\t<t t-else="">\n\t\t\t\t\t\t\t\t<div style="width:110px;height:60px;"/>\n\t\t\t\t\t\t\t</t>\n\t\t\t\t\t\t\t<p class="mb-0 mt-1">\n\t\t\t\t\t\t\t\t<t t-if="'practitioner-name' in data">\n\t\t\t\t\t\t\t\t\t<strong>\n\t\t\t\t\t\t\t\t\t\t<t t-esc="data['practitioner-name']"/>\n\t\t\t\t\t\t\t\t\t</strong>\n\t\t\t\t\t\t\t\t</t>\n\t\t\t\t\t\t\t\t<t t-elif="'examiner_name' in data">\n\t\t\t\t\t\t\t\t\t<strong>\n\t\t\t\t\t\t\t\t\t\t<t t-esc="data['examiner_name']"/>\n\t\t\t\t\t\t\t\t\t</strong>\n\t\t\t\t\t\t\t\t</t>\n\t\t\t\t\t\t\t\t<t t-else="">\n\t\t\t\t\t\t\t\t\t<strong>\n\t\t\t\t\t\t\t\t\t\t<t t-esc="data['sender']"/>\n\t\t\t\t\t\t\t\t\t</strong>\n\t\t\t\t\t\t\t\t</t>\n\t\t\t\t\t\t\t</p>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t<div class="col-4"/>\n\t\t\t\t\t\t<div class="col-4">\n\t\t\t\t\t\t\t<p class="mb-0"><t t-esc="o['operating_unit_id']['company_id']['city']"/>,\n\t\t\t\t\t\t\t\t<t t-esc="o.to_date_string(data['registration_date'])"/>\n\t\t\t\t\t\t\t</p>\n\t\t\t\t\t\t\t<p class="mb-0">Pasien / Wali Pasien</p>\n\t\t\t\t\t\t\t<t t-if="'sign-pj' in data">\n\t\t\t\t\t\t\t\t<div style="width:110px;height:60px;">\n\t\t\t\t\t\t\t\t\t<img height="80" t-att-src="data['sign-pj']"/>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t</t>\n\t\t\t\t\t\t\t<p class="mb-0 mt-1">\n\t\t\t\t\t\t\t\t<strong>\n\t\t\t\t\t\t\t\t\t<t t-esc="data['nama-pj']"/>\n\t\t\t\t\t\t\t\t</strong>\n\t\t\t\t\t\t\t</p>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t</t>\n\t\t</t>\n\t	ehealth_document/report/template_general_consent/report_default_general_consent.xml	\N	\N	\N	\N	primary	t	1	2025-08-28 11:34:01.364376	1	2025-08-28 11:34:01.364376	f
1595	report_daruba_general_consent	\N	ehealth_document.report_daruba_general_consent	16	qweb	<?xml version="1.0"?>\n<t t-name="ehealth_document.report_daruba_general_consent">\n\t\t\t<t t-set="company" t-value="res_company"/>\n\t\t\t<t t-call="ehealth_document.header_puskesmasdaruba_document">\n\t\t\t\t<div class="page" style="font-size:13px; line-height: 1.4;">\n\t\t\t\t\t<div class="row" style="border: 1px solid black">\n\t\t\t\t\t\t<div class="">\n\t\t\t\t\t\t\t<div style="background-color:#c1d09d; border-bottom: 1px solid black">\n\t\t\t\t\t\t\t\t<p class="text-center mb-0" style="width: 100%;">\n\t\t\t\t\t\t\t\t\t<strong>PENGKAJIAN DATA UMUM PASIEN</strong>\n\t\t\t\t\t\t\t\t</p>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t<div class="row mt-2" style="border-bottom: 1px solid black">\n\t\t\t\t\t\t\t\t<div class="ml-4 mb-1">\n\t\t\t\t\t\t\t\t\t<p>Diisi oleh Petugas Pendaftaran pada</p>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<div class="ml-2 mb-1">\n\t\t\t\t\t\t\t\t\t<p>tanggal: <t t-if="'tgl-consent' in data"><t t-esc="data['tgl-consent']"/></t></p>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<div class="ml-5 mb-1">\n\t\t\t\t\t\t\t\t\t<p>jam: <t t-if="'waktu-consent' in data"><t t-esc="data['waktu-consent']"/></t></p>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t<div class="pl-2" style="border-bottom: 1px solid black">\n\t\t\t\t\t\t\t\t<p class="mb-0" style="font-size: 16px">\n\t\t\t\t\t\t\t\t\t<strong>IDENTITAS PASIEN</strong>\n\t\t\t\t\t\t\t\t</p>\n\t\t\t\t\t\t\t\t<p class="mb-0" style="font-style: italic;">(Diisi sesuai Kartu Tanda Pengenal Pasien yang masih berlaku; KTP/ KK/ SIM/ Kartu Pelajar/ dsb)</p>\n\t\t\t\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t\t\t\t<div class="col-3">Nomer Rekam Medis</div>\n\t\t\t\t\t\t\t\t\t<div class="col-8">: <t t-esc="data['no-cm']"/> </div>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t\t\t\t<div class="col-3">Nama</div>\n\t\t\t\t\t\t\t\t\t<div class="col-8">: <t t-esc="o['partner_id']['name']"/></div>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t\t\t\t<div class="col-3">Jenis Kelamin</div>\n\t\t\t\t\t\t\t\t\t<div class="col-8">:\n\t\t\t\t\t\t\t\t\t\t<t t-if="o['partner_id']['gender'] == 'male'">Laki-Laki</t>\n\t\t\t\t\t\t\t\t\t\t<t t-else="">Perempuan</t>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t\t\t\t<div class="col-3">Tanggal Lahir</div>\n\t\t\t\t\t\t\t\t\t<div class="col-8">: <t t-esc="o['partner_id']['birthDate'].strftime('%d-%m-%Y')"/></div>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t\t\t\t<div class="col-3">Agama</div>\n\t\t\t\t\t\t\t\t\t<div class="col-8">: <t t-if="'religion' in data"> <t t-esc="data['religion']"/> </t></div>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t\t\t\t<div class="col-3">Pendidikan</div>\n\t\t\t\t\t\t\t\t\t<div class="col-8">: </div>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t\t\t\t<div class="col-3">Pekerjaan</div>\n\t\t\t\t\t\t\t\t\t<div class="col-8">: <t t-if="'occupation' in data"> <t t-esc="data['occupation']"/> </t></div>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t\t\t\t<div class="col-3">Alamat</div>\n\t\t\t\t\t\t\t\t\t<div class="col-8">: <t t-esc="o['partner_id']['street']"/></div>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t\t\t\t<div class="col-3">Status Perkawinan</div>\n\t\t\t\t\t\t\t\t\t<div class="col-8">: <t t-if="'marital-status' in data"> <t t-esc="data['marital-status']"/> </t></div>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t\t\t\t<div class="col-3">Nama Suami / Istri</div>\n\t\t\t\t\t\t\t\t\t<div class="col-8">: <t t-if="'partner' in data"> <t t-esc="data['partner']"/> </t></div>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t\t\t\t<div class="col-3">Status Pembiayaan</div>\n\t\t\t\t\t\t\t\t\t<div class="col-8">: <t t-if="'payment' in data"> <t t-esc="data['payment']"/> </t></div>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t<div style="background-color:#c1d09d; border-bottom: 1px solid black">\n\t\t\t\t\t\t\t\t<p class="text-center mb-0" style="width: 100%;">\n\t\t\t\t\t\t\t\t\t<strong>PERSETUJUAN UMUM / GENERAL CONSENT</strong>\n\t\t\t\t\t\t\t\t</p>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t<p class="text-center mt-1 mb-0" style="font-style: italic; text-decoration: underline;">\n\t\t\t\t\t\t\t\t<strong>PASIEN / WALI PASIEN HARUS MEMBACA, MEMAHAMI DAN MENGISI INFORMASI BERIKUT</strong>\n\t\t\t\t\t\t\t</p>\n\t\t\t\t\t\t\t<p class="mt-1 mb-1">Yang bertanda tangan di bawah ini, saya:</p>\n\t\t\t\t\t\t\t<div class="pl-2">\n\t\t\t\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t\t\t\t<div class="col-3">Nama Lengkap</div>\n\t\t\t\t\t\t\t\t\t<div class="col-6">:\n\t\t\t\t\t\t\t\t\t\t<strong>\n\t\t\t\t\t\t\t\t\t\t\t<t t-esc="data['nama-pj']"/>\n\t\t\t\t\t\t\t\t\t\t</strong>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t\t\t\t<div class="col-3">Tempat Lahir</div>\n\t\t\t\t\t\t\t\t\t<div class="col-6">: <t t-if="'tempat-lahir-pj' in data"><t t-esc="data['tempat-lahir-pj']"/></t></div>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t\t\t\t<div class="col-3">Tanggal Lahir</div>\n\t\t\t\t\t\t\t\t\t<div class="col-6">: <t t-if="'tgl-lahir-pj' in data"><t t-esc="data['tgl-lahir-pj']"/></t></div>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t\t\t\t<div class="col-3">Jenis Kelamin</div>\n\t\t\t\t\t\t\t\t\t<div class="col-6">:\n\t\t\t\t\t\t\t\t\t\t<t t-if="'jenis-kelamin-pj' in data">\n\t\t\t\t\t\t\t\t\t\t\t<t t-if="data['jenis-kelamin-pj'] == 'male'">Laki-Laki</t>\n\t\t\t\t\t\t\t\t\t\t\t<t t-else="">Perempuan</t>\n\t\t\t\t\t\t\t\t\t\t</t>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t\t\t\t<div class="col-3">Alamat</div>\n\t\t\t\t\t\t\t\t\t<div class="col-6">: <t t-if="'alamat-pj' in data"><t t-esc="data['alamat-pj']"/></t></div>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t\t\t\t<div class="col-3">No. Telepon</div>\n\t\t\t\t\t\t\t\t\t<div class="col-6">: <t t-if="'telepon-pj' in data"><t t-esc="data['telepon-pj']"/></t></div>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t\t\t\t<div class="col-3">Email</div>\n\t\t\t\t\t\t\t\t\t<div class="col-6">: <t t-if="'email-pj' in data"><t t-esc="data['email-pj']"/></t></div>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<t t-if="'relasi-pj' in data">\n\t\t\t\t\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t\t\t\t\t<div class="col-3">Bertindak atas</div>\n\t\t\t\t\t\t\t\t\t\t<div class="col-6">: <t t-if="'relasi-pj' in data"><t t-esc="data['relasi-pj']"/></t></div>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t</t>\n\t\t\t\t\t\t\t\t<div>Menyatakan</div>\n\t\t\t\t\t\t\t\t<div class="pr-3" style="page-break-inside: avoid; page-break-before: auto;">\n\t\t\t\t\t\t\t\t\t<div>\n\t\t\t\t\t\t\t\t\t\t<strong>I. PERSETUJUAN UNTUK PERAWATAN DAN PENGOBATAN</strong>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t<div class="d-flex ml-3">\n\t\t\t\t\t\t\t\t\t\t<div class="pr-1">1.</div>\n\t\t\t\t\t\t\t\t\t\t<div>Saya mengetahui bahwa saya membutuhkan perawatan medis dan mengijinkan dokter/tenaga Kesehatan lainnya di fasilitas Kesehatan RS/Klinik/Puskesmas Daruba untuk melakukan pemeriksaan dan memberikan pengobatan / tindakan/ asuhan yang sesuai prosedur</div>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t<div class="d-flex ml-3">\n\t\t\t\t\t\t\t\t\t\t<div class="pr-1">2.</div>\n\t\t\t\t\t\t\t\t\t\t<div>Saya sadar bahwa praktik kedokteran bukanlah ilmu pasti dan saya mengakui bahwa tidak ada jaminan atas hasil apapun terhadap pengobatan / Tindakan/ asuhan yang dilakukan pada saya</div>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t<div class="d-flex ml-3">\n\t\t\t\t\t\t\t\t\t\t<div class="pr-1">3.</div>\n\t\t\t\t\t\t\t\t\t\t<div class="">\n\t\t\t\t\t\t\t\t\t\t\t<p>Saya mengerti dan memahami bahwa </p>\n\t\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t<div class="d-flex ml-5 pr-3">\n\t\t\t\t\t\t\t\t\t\t<div class="pr-1">a.</div>\n\t\t\t\t\t\t\t\t\t\t<div>Saya memiliki hak untuk menyatakan persetujuan atau penolakan untuk setiap jasa perawatan medis yang akan diberikan pada saya. Saya memahani bahwa pemberian jasa yang melibatkan data pribadi saya yang saya tolak, tanpanya layanan tidak dapat diberikan, seperti pemeriksaan penyakit pasien, pemberian obat, asuhan, dan tindakan medis.</div>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t<div class="d-flex ml-5 pr-3">\n\t\t\t\t\t\t\t\t\t\t<div class="pr-1">b.</div>\n\t\t\t\t\t\t\t\t\t\t<div>Saya memiliki hak untuk mengajukan pertanyaan terkait rencana pelayanan yang akan diberikan pada saya, termasuk identitas setiap orang yang akan memberikan jasa perawatan medis.</div>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t<div class="d-flex ml-5 pr-3">\n\t\t\t\t\t\t\t\t\t\t<div class="pr-1">c.</div>\n\t\t\t\t\t\t\t\t\t\t<div>Saya memiliki hak untuk melakukan pernarikan persetujuan saat kewajiban pihak fasilitas kesehatan menyediakan layanan belum terlaksana atau saya mengubah keputusan persetujan atau penolakan yang sebelumnya saya berikan</div>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t<div class="d-flex ml-3">\n\t\t\t\t\t\t\t\t\t\t<div class="pr-1">4.</div>\n\t\t\t\t\t\t\t\t\t\t<div class="">\n\t\t\t\t\t\t\t\t\t\t\t<p>Saya menyetujui bahwa dalam keadaan darurat (atau gawat darurat) data pribadi Saya hanya akan digunakan untuk kepentingan perawatan medis. Pemrosesan data ini hanya akan dilakukan apabila cara lain tidak dapat diupayakan seperti saya yang tidak sadarkan diri atau saya yang memerlukan tindakan segera di IGD.</p>\n\t\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<div class="pr-3" style="page-break-inside: avoid; page-break-before: auto;">\n\t\t\t\t\t\t\t\t\t<div>\n\t\t\t\t\t\t\t\t\t\t<strong>II. PERSETUJUAN PELEPASAN DATA</strong>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t<div class="d-flex ml-3">\n\t\t\t\t\t\t\t\t\t\t<div class="pr-1">1.</div>\n\t\t\t\t\t\t\t\t\t\t<div>Saya memahami bahwa informasi pribadi saya terkait dengan kondisi Kesehatan saya, berdasarkan pemeriksaan yang saya jalani di fasilitas Kesehatan RS/Klinik/Puskesmas Daruba akan terjamin kerahasiaannya</div>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t<div class="d-flex ml-3">\n\t\t\t\t\t\t\t\t\t\t<div class="pr-1">2.</div>\n\t\t\t\t\t\t\t\t\t\t<div>Saya memberikan wewenang kepada fasilitas Kesehatan RS/Klinik/Puskesmas Daruba untuk memberikan informasi berkaitan dengan kondisi Kesehatan saya untuk keperluan proses klaim asuransi dan administrasi resmi apabila diperlukan (BPJS, Kemenkenkes, Dinkes)</div>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t<div class="d-flex ml-3">\n\t\t\t\t\t\t\t\t\t\t<div class="pr-1">3.</div>\n\t\t\t\t\t\t\t\t\t\t<div>Saya memberi wewenang akses kepada fasilitas Kesehatan RS/Klinik/Puskesmas Daruba untuk memberikan informasi Kesehatan saya kepada pihak berikut apabila diperlukan:</div>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t<div class="d-flex- ml-5">\n\t\t\t\t\t\t\t\t\t\t<t t-if="'authorized-parties' in data">\n\t\t\t\t\t\t\t\t\t\t\t<t t-foreach="data['authorized-parties']" t-as="name">\n\t\t\t\t\t\t\t\t\t\t\t\t<div><t t-esc="name"/></div>\n\t\t\t\t\t\t\t\t\t\t\t</t>\n\t\t\t\t\t\t\t\t\t\t</t>\n\t\t\t\t\t\t\t\t\t\t<t t-else="">\n\t\t\t\t\t\t\t\t\t\t\t<div style="height: 15px;"/>\n\t\t\t\t\t\t\t\t\t\t</t>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<div class="pr-3" style="page-break-inside: avoid; page-break-before: auto;">\n\t\t\t\t\t\t\t\t\t<div>\n\t\t\t\t\t\t\t\t\t\t<strong>III. HAK DAN KEWAJIBAN PASIEN</strong>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t<div class="ml-3">Saya telah mendapatkan informasi tentang “Hak dan Kewajiban Pasien” di fasilitas Kesehatan RS/Klinik/Puskesmas Daruba melalui informasi yang diberikan kepada saya oleh petugas yang melayani saya.</div>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<div class="pr-3" style="page-break-inside: avoid; page-break-before: auto;">\n\t\t\t\t\t\t\t\t\t<div>\n\t\t\t\t\t\t\t\t\t\t<strong>IV. INTEGRITAS DATA MEDIS</strong>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t<div class="ml-3">Saya menyetujui bahwa segala data Rekam Medis, termasuk didalamnya Kesalahan Pemasukan Data atau Pengubahan diagnosis medis, tetap akan didokumentasikan karena menjadi bagian dari rekam medis pasien bahkan setelah diagnosis saya diperbaiki. Saya memahami bahwa hal ini bertujuan menjelaskan riwayat tindakan medis yang diberikan kepada pasien, atau untuk masalah kesehatan lainnya.</div>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<div class="pr-3" style="page-break-inside: avoid; page-break-before: auto;">\n\t\t\t\t\t\t\t\t\t<div>\n\t\t\t\t\t\t\t\t\t\t<strong>V. KOMUNIKASI</strong>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t<div class="ml-3">Saya bersedia untuk dihubungi melalui alamat atau alamat email sehubungan dengan reporting hack dan kegagalan/gangguan sistem yang berdampak serius mengenai dampak serius kebocoran data pribadi agar Saya dapat mengantisipasi risiko dari peristiwa tersebut. Selain itu Saya mengijinkan pelaporan ini untuk diberikan kepada otoritas yang berwenang dan segera tanpa menunda-nunda sesuai dengan peraturan perundang-undangan yang berlaku.</div>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class="row" style="page-break-inside: avoid; page-break-before: auto;">\n\t\t\t\t\t\t<div class="col-4">\n\t\t\t\t\t\t\t<p class="pt-3">Petugas</p>\n\t\t\t\t\t\t\t<div style="width:110px;height:50px;"/>\n\t\t\t\t\t\t\t<p class="mb-0 mt-1">\n\t\t\t\t\t\t\t\t<strong>\n\t\t\t\t\t\t\t\t\t<t t-esc="data['sender']"/>\n\t\t\t\t\t\t\t\t</strong>\n\t\t\t\t\t\t\t</p>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t<div class="col-4"/>\n\t\t\t\t\t\t<div class="col-4">\n\t\t\t\t\t\t\t<p class="mb-0">Morotai,\n\t\t\t\t\t\t\t\t<t t-esc="o.to_date_string(data['registration_date'])"/>\n\t\t\t\t\t\t\t</p>\n\t\t\t\t\t\t\t<p class="mb-0">Pasien / Wali Pasien</p>\n\t\t\t\t\t\t\t<t t-if="'sign-pj' in data">\n\t\t\t\t\t\t\t\t<div style="width:110px;height:60px;">\n\t\t\t\t\t\t\t\t\t<img height="80" t-att-src="data['sign-pj']"/>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t</t>\n\t\t\t\t\t\t\t<p class="mb-0 mt-1">\n\t\t\t\t\t\t\t\t<strong>\n\t\t\t\t\t\t\t\t\t<t t-esc="data['nama-pj']"/>\n\t\t\t\t\t\t\t\t</strong>\n\t\t\t\t\t\t\t</p>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t</t>\n\t\t</t>\n\t	ehealth_document/report/template_general_consent/report_daruba_general_consent.xml	\N	\N	\N	\N	primary	t	1	2025-08-28 11:34:01.364376	1	2025-08-28 11:34:01.364376	f
1596	report_yumari_general_consent	\N	ehealth_document.report_yumari_general_consent	16	qweb	<?xml version="1.0"?>\n<t t-name="ehealth_document.report_yumari_general_consent">\n\t\t\t<t t-set="company" t-value="res_company"/>\n\t\t\t<t t-call="ehealth_document.header_yumarimedika_document">\n\t\t\t\t<div class="page" style="font-size:13px; line-height: 1.4;">\n\t\t\t\t\t<div class="row" style="border: 1px solid black">\n\t\t\t\t\t\t<div class="">\n\t\t\t\t\t\t\t<div class="row mt-2" style="border-bottom: 1px solid black">\n\t\t\t\t\t\t\t\t<div class="ml-4 mb-1">\n\t\t\t\t\t\t\t\t\t<p>Diisi oleh Petugas Pendaftaran pada</p>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<div class="ml-2 mb-1">\n\t\t\t\t\t\t\t\t\t<p>tanggal: <t t-if="'tgl-consent' in data"><t t-esc="data['tgl-consent']"/></t></p>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<div class="ml-5 mb-1">\n\t\t\t\t\t\t\t\t\t<p>jam: <t t-if="'waktu-consent' in data"><t t-esc="data['waktu-consent']"/></t></p>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t<div class="pl-2" style="border-bottom: 1px solid black">\n\t\t\t\t\t\t\t\t<p class="mb-0" style="font-size: 16px">\n\t\t\t\t\t\t\t\t\t<strong>IDENTITAS PASIEN</strong>\n\t\t\t\t\t\t\t\t</p>\n\t\t\t\t\t\t\t\t<p class="mb-0" style="font-style: italic;">(Diisi sesuai Kartu Tanda Pengenal Pasien yang masih berlaku; KTP/ KK/ SIM/ Kartu Pelajar/ dsb)</p>\n\t\t\t\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t\t\t\t<div class="col-3">Nomer Rekam Medis</div>\n\t\t\t\t\t\t\t\t\t<div class="col-8">: <t t-esc="data['no-cm']"/> </div>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t\t\t\t<div class="col-3">Nama</div>\n\t\t\t\t\t\t\t\t\t<div class="col-8">: <t t-esc="o['partner_id']['name']"/></div>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t\t\t\t<div class="col-3">Jenis Kelamin</div>\n\t\t\t\t\t\t\t\t\t<div class="col-8">:\n\t\t\t\t\t\t\t\t\t\t<t t-if="o['partner_id']['gender'] == 'male'">Laki-Laki</t>\n\t\t\t\t\t\t\t\t\t\t<t t-else="">Perempuan</t>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t\t\t\t<div class="col-3">Tanggal Lahir</div>\n\t\t\t\t\t\t\t\t\t<div class="col-8">: <t t-esc="o['partner_id']['birthDate'].strftime('%d-%m-%Y')"/></div>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t\t\t\t<div class="col-3">Agama</div>\n\t\t\t\t\t\t\t\t\t<div class="col-8">: <t t-if="'religion' in data"> <t t-esc="data['religion']"/> </t></div>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t\t\t\t<div class="col-3">Pendidikan</div>\n\t\t\t\t\t\t\t\t\t<div class="col-8">: </div>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t\t\t\t<div class="col-3">Pekerjaan</div>\n\t\t\t\t\t\t\t\t\t<div class="col-8">: <t t-if="'occupation' in data"> <t t-esc="data['occupation']"/> </t></div>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t\t\t\t<div class="col-3">Alamat</div>\n\t\t\t\t\t\t\t\t\t<div class="col-8">: <t t-esc="o['partner_id']['street']"/></div>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t\t\t\t<div class="col-3">Status Perkawinan</div>\n\t\t\t\t\t\t\t\t\t<div class="col-8">: <t t-if="'marital-status' in data"> <t t-esc="data['marital-status']"/> </t></div>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t\t\t\t<div class="col-3">Nama Suami / Istri</div>\n\t\t\t\t\t\t\t\t\t<div class="col-8">: <t t-if="'partner' in data"> <t t-esc="data['partner']"/> </t></div>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t\t\t\t<div class="col-3">Status Pembiayaan</div>\n\t\t\t\t\t\t\t\t\t<div class="col-8">: <t t-if="'payment' in data"> <t t-esc="data['payment']"/> </t></div>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t<div style="background-color:#c1d09d; border-bottom: 1px solid black">\n\t\t\t\t\t\t\t\t<p class="text-center mb-0" style="width: 100%;">\n\t\t\t\t\t\t\t\t\t<strong>PERSETUJUAN UMUM / GENERAL CONSENT</strong>\n\t\t\t\t\t\t\t\t</p>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t<p class="text-center mt-1 mb-0" style="font-style: italic; text-decoration: underline;">\n\t\t\t\t\t\t\t\t<strong>PASIEN / WALI PASIEN HARUS MEMBACA, MEMAHAMI DAN MENGISI INFORMASI BERIKUT</strong>\n\t\t\t\t\t\t\t</p>\n\t\t\t\t\t\t\t<p class="mt-1 mb-1">Yang bertanda tangan di bawah ini, saya:</p>\n\t\t\t\t\t\t\t<div class="pl-2">\n\t\t\t\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t\t\t\t<div class="col-3">Nama Lengkap</div>\n\t\t\t\t\t\t\t\t\t<div class="col-6">:\n\t\t\t\t\t\t\t\t\t\t<strong>\n\t\t\t\t\t\t\t\t\t\t\t<t t-esc="data['nama-pj']"/>\n\t\t\t\t\t\t\t\t\t\t</strong>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t\t\t\t<div class="col-3">Tempat Lahir</div>\n\t\t\t\t\t\t\t\t\t<div class="col-6">: <t t-if="'tempat-lahir-pj' in data"><t t-esc="data['tempat-lahir-pj']"/></t></div>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t\t\t\t<div class="col-3">Tanggal Lahir</div>\n\t\t\t\t\t\t\t\t\t<div class="col-6">: <t t-if="'tgl-lahir-pj' in data"><t t-esc="data['tgl-lahir-pj']"/></t></div>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t\t\t\t<div class="col-3">Jenis Kelamin</div>\n\t\t\t\t\t\t\t\t\t<div class="col-6">:\n\t\t\t\t\t\t\t\t\t\t<t t-if="'jenis-kelamin-pj' in data">\n\t\t\t\t\t\t\t\t\t\t\t<t t-if="data['jenis-kelamin-pj'] == 'male'">Laki-Laki</t>\n\t\t\t\t\t\t\t\t\t\t\t<t t-else="">Perempuan</t>\n\t\t\t\t\t\t\t\t\t\t</t>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t\t\t\t<div class="col-3">Alamat</div>\n\t\t\t\t\t\t\t\t\t<div class="col-6">: <t t-if="'alamat-pj' in data"><t t-esc="data['alamat-pj']"/></t></div>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t\t\t\t<div class="col-3">No. Telepon</div>\n\t\t\t\t\t\t\t\t\t<div class="col-6">: <t t-if="'telepon-pj' in data"><t t-esc="data['telepon-pj']"/></t></div>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t\t\t\t<div class="col-3">Email</div>\n\t\t\t\t\t\t\t\t\t<div class="col-6">: <t t-if="'email-pj' in data"><t t-esc="data['email-pj']"/></t></div>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<t t-if="'relasi-pj' in data">\n\t\t\t\t\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t\t\t\t\t<div class="col-3">Bertindak atas</div>\n\t\t\t\t\t\t\t\t\t\t<div class="col-6">: <t t-if="'relasi-pj' in data"><t t-esc="data['relasi-pj']"/></t></div>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t</t>\n\t\t\t\t\t\t\t\t<div>Menyatakan</div>\n\t\t\t\t\t\t\t\t<div class="pr-3" style="page-break-inside: avoid; page-break-before: auto;">\n\t\t\t\t\t\t\t\t\t<div>\n\t\t\t\t\t\t\t\t\t\t<strong>I. PERSETUJUAN UNTUK PERAWATAN DAN PENGOBATAN</strong>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t<div class="d-flex ml-3">\n\t\t\t\t\t\t\t\t\t\t<div class="pr-1">1.</div>\n\t\t\t\t\t\t\t\t\t\t<div>Saya mengetahui bahwa saya membutuhkan perawatan medis dan mengijinkan dokter/tenaga Kesehatan lainnya di fasilitas Kesehatan RS/Klinik/Yumari Medika untuk melakukan pemeriksaan dan memberikan pengobatan / tindakan/ asuhan yang sesuai prosedur</div>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t<div class="d-flex ml-3">\n\t\t\t\t\t\t\t\t\t\t<div class="pr-1">2.</div>\n\t\t\t\t\t\t\t\t\t\t<div>Saya sadar bahwa praktik kedokteran bukanlah ilmu pasti dan saya mengakui bahwa tidak ada jaminan atas hasil apapun terhadap pengobatan / Tindakan/ asuhan yang dilakukan pada saya</div>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t<div class="d-flex ml-3">\n\t\t\t\t\t\t\t\t\t\t<div class="pr-1">3.</div>\n\t\t\t\t\t\t\t\t\t\t<div class="">\n\t\t\t\t\t\t\t\t\t\t\t<p>Saya mengerti dan memahami bahwa </p>\n\t\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t<div class="d-flex ml-5 pr-3">\n\t\t\t\t\t\t\t\t\t\t<div class="pr-1">a.</div>\n\t\t\t\t\t\t\t\t\t\t<div>Saya memiliki hak untuk menyatakan persetujuan atau penolakan untuk setiap jasa perawatan medis yang akan diberikan pada saya. Saya memahani bahwa pemberian jasa yang melibatkan data pribadi saya yang saya tolak, tanpanya layanan tidak dapat diberikan, seperti pemeriksaan penyakit pasien, pemberian obat, asuhan, dan tindakan medis.</div>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t<div class="d-flex ml-5 pr-3">\n\t\t\t\t\t\t\t\t\t\t<div class="pr-1">b.</div>\n\t\t\t\t\t\t\t\t\t\t<div>Saya memiliki hak untuk mengajukan pertanyaan terkait rencana pelayanan yang akan diberikan pada saya, termasuk identitas setiap orang yang akan memberikan jasa perawatan medis.</div>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t<div class="d-flex ml-5 pr-3">\n\t\t\t\t\t\t\t\t\t\t<div class="pr-1">c.</div>\n\t\t\t\t\t\t\t\t\t\t<div>Saya memiliki hak untuk melakukan pernarikan persetujuan saat kewajiban pihak fasilitas kesehatan menyediakan layanan belum terlaksana atau saya mengubah keputusan persetujan atau penolakan yang sebelumnya saya berikan</div>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t<div class="d-flex ml-3">\n\t\t\t\t\t\t\t\t\t\t<div class="pr-1">4.</div>\n\t\t\t\t\t\t\t\t\t\t<div class="">\n\t\t\t\t\t\t\t\t\t\t\t<p>Saya menyetujui bahwa dalam keadaan darurat (atau gawat darurat) data pribadi Saya hanya akan digunakan untuk kepentingan perawatan medis. Pemrosesan data ini hanya akan dilakukan apabila cara lain tidak dapat diupayakan seperti saya yang tidak sadarkan diri atau saya yang memerlukan tindakan segera di IGD.</p>\n\t\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<div class="pr-3" style="page-break-inside: avoid; page-break-before: auto;">\n\t\t\t\t\t\t\t\t\t<div>\n\t\t\t\t\t\t\t\t\t\t<strong>II. PERSETUJUAN PELEPASAN DATA</strong>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t<div class="d-flex ml-3">\n\t\t\t\t\t\t\t\t\t\t<div class="pr-1">1.</div>\n\t\t\t\t\t\t\t\t\t\t<div>Saya memahami bahwa informasi pribadi saya terkait dengan kondisi Kesehatan saya, berdasarkan pemeriksaan yang saya jalani di fasilitas Kesehatan RS/Klinik/Yumari Medika akan terjamin kerahasiaannya</div>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t<div class="d-flex ml-3">\n\t\t\t\t\t\t\t\t\t\t<div class="pr-1">2.</div>\n\t\t\t\t\t\t\t\t\t\t<div>Saya memberikan wewenang kepada fasilitas Kesehatan RS/Klinik/Yumari Medika untuk memberikan informasi berkaitan dengan kondisi Kesehatan saya untuk keperluan proses klaim asuransi dan administrasi resmi apabila diperlukan (BPJS, Kemenkenkes, Dinkes)</div>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t<div class="d-flex ml-3">\n\t\t\t\t\t\t\t\t\t\t<div class="pr-1">3.</div>\n\t\t\t\t\t\t\t\t\t\t<div>Saya memberi wewenang akses kepada fasilitas Kesehatan RS/Klinik/Yumari Medika untuk memberikan informasi Kesehatan saya kepada pihak berikut apabila diperlukan:</div>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t<div class="d-flex- ml-5">\n\t\t\t\t\t\t\t\t\t\t<t t-if="'authorized-parties' in data">\n\t\t\t\t\t\t\t\t\t\t\t<t t-foreach="data['authorized-parties']" t-as="name">\n\t\t\t\t\t\t\t\t\t\t\t\t<div><t t-esc="name"/></div>\n\t\t\t\t\t\t\t\t\t\t\t</t>\n\t\t\t\t\t\t\t\t\t\t</t>\n\t\t\t\t\t\t\t\t\t\t<t t-else="">\n\t\t\t\t\t\t\t\t\t\t\t<div style="height: 15px;"/>\n\t\t\t\t\t\t\t\t\t\t</t>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<div class="pr-3" style="page-break-inside: avoid; page-break-before: auto;">\n\t\t\t\t\t\t\t\t\t<div>\n\t\t\t\t\t\t\t\t\t\t<strong>III. HAK DAN KEWAJIBAN PASIEN</strong>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t<div class="ml-3">Saya telah mendapatkan informasi tentang “Hak dan Kewajiban Pasien” di fasilitas Kesehatan RS/Klinik/Yumari Medika melalui informasi yang diberikan kepada saya oleh petugas yang melayani saya.</div>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<div class="pr-3" style="page-break-inside: avoid; page-break-before: auto;">\n\t\t\t\t\t\t\t\t\t<div>\n\t\t\t\t\t\t\t\t\t\t<strong>IV. INTEGRITAS DATA MEDIS</strong>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t<div class="ml-3">Saya menyetujui bahwa segala data Rekam Medis, termasuk didalamnya Kesalahan Pemasukan Data atau Pengubahan diagnosis medis, tetap akan didokumentasikan karena menjadi bagian dari rekam medis pasien bahkan setelah diagnosis saya diperbaiki. Saya memahami bahwa hal ini bertujuan menjelaskan riwayat tindakan medis yang diberikan kepada pasien, atau untuk masalah kesehatan lainnya.</div>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<div class="pr-3" style="page-break-inside: avoid; page-break-before: auto;">\n\t\t\t\t\t\t\t\t\t<div>\n\t\t\t\t\t\t\t\t\t\t<strong>V. KOMUNIKASI</strong>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t<div class="ml-3">Saya bersedia untuk dihubungi melalui alamat atau alamat email sehubungan dengan reporting hack dan kegagalan/gangguan sistem yang berdampak serius mengenai dampak serius kebocoran data pribadi agar Saya dapat mengantisipasi risiko dari peristiwa tersebut. Selain itu Saya mengijinkan pelaporan ini untuk diberikan kepada otoritas yang berwenang dan segera tanpa menunda-nunda sesuai dengan peraturan perundang-undangan yang berlaku.</div>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class="row" style="page-break-inside: avoid; page-break-before: auto;">\n\t\t\t\t\t\t<div class="col-4">\n\t\t\t\t\t\t\t<p class="pt-3">Petugas</p>\n\t\t\t\t\t\t\t<t t-if="'practitioner-sign' in data">\n\t\t\t\t\t\t\t\t<div style="width:110px;height:60px;">\n\t\t\t\t\t\t\t\t\t<img height="80" t-att-src="data['practitioner-sign']"/>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t</t>\n\t\t\t\t\t\t\t<t t-else="">\n\t\t\t\t\t\t\t\t<div style="width:110px;height:60px;"/>\n\t\t\t\t\t\t\t</t>\n\t\t\t\t\t\t\t<p class="mb-0 mt-1">\n\t\t\t\t\t\t\t\t<t t-if="'practitioner-name' in data">\n\t\t\t\t\t\t\t\t\t<strong>\n\t\t\t\t\t\t\t\t\t\t<t t-esc="data['practitioner-name']"/>\n\t\t\t\t\t\t\t\t\t</strong>\n\t\t\t\t\t\t\t\t</t>\n\t\t\t\t\t\t\t\t<t t-elif="'examiner_name' in data">\n\t\t\t\t\t\t\t\t\t<strong>\n\t\t\t\t\t\t\t\t\t\t<t t-esc="data['examiner_name']"/>\n\t\t\t\t\t\t\t\t\t</strong>\n\t\t\t\t\t\t\t\t</t>\n\t\t\t\t\t\t\t\t<t t-else="">\n\t\t\t\t\t\t\t\t\t<strong>\n\t\t\t\t\t\t\t\t\t\t<t t-esc="data['sender']"/>\n\t\t\t\t\t\t\t\t\t</strong>\n\t\t\t\t\t\t\t\t</t>\n\t\t\t\t\t\t\t</p>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t<div class="col-4"/>\n\t\t\t\t\t\t<div class="col-4">\n\t\t\t\t\t\t\t<p class="mb-0">Majene,\n\t\t\t\t\t\t\t\t<t t-esc="o.to_date_string(data['registration_date'])"/>\n\t\t\t\t\t\t\t</p>\n\t\t\t\t\t\t\t<p class="mb-0">Pasien / Wali Pasien</p>\n\t\t\t\t\t\t\t<t t-if="'sign-pj' in data">\n\t\t\t\t\t\t\t\t<div style="width:110px;height:60px;">\n\t\t\t\t\t\t\t\t\t<img height="80" t-att-src="data['sign-pj']"/>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t</t>\n\t\t\t\t\t\t\t<p class="mb-0 mt-1">\n\t\t\t\t\t\t\t\t<strong>\n\t\t\t\t\t\t\t\t\t<t t-esc="data['nama-pj']"/>\n\t\t\t\t\t\t\t\t</strong>\n\t\t\t\t\t\t\t</p>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t</t>\n\t\t</t>\n\t	ehealth_document/report/template_general_consent/report_yumari_general_consent.xml	\N	\N	\N	\N	primary	t	1	2025-08-28 11:34:01.364376	1	2025-08-28 11:34:01.364376	f
643	account.account.search	account.account	\N	16	search	<?xml version="1.0"?>\n<search string="Accounts">\n                    <field name="name" filter_domain="['|', ('name','ilike',self), ('code','=like',str(self)+'%')]" string="Account"/>\n                    <filter string="Receivable Accounts" name="receivableacc" domain="[('internal_type','=','receivable')]"/>\n                    <filter string="Payable Accounts" name="payableacc" domain="[('internal_type','=','payable')]"/>\n                    <filter string="Equity" name="equityacc" domain="[('internal_group','=', 'equity')]"/>\n                    <filter string="Assets" name="assetsacc" domain="[('internal_group','=', 'asset')]"/>\n                    <filter string="Liability" name="liabilityacc" domain="[('internal_group','=', 'liability')]"/>\n                    <filter string="Income" name="incomeacc" domain="[('internal_group','=', 'income')]"/>\n                    <filter string="Expenses" name="expensesacc" domain="[('internal_group','=', 'expense')]"/>\n                    <separator/>\n                    <filter string="Account with Entries" name="used" domain="[('used', '=', True)]"/>\n                    <filter string="Active Account" name="activeacc" domain="[('deprecated', '=', False)]"/>\n                    <separator/>\n                    <field name="user_type_id"/>\n                    <group expand="0" string="Group By">\n                        <filter string="Account Type" name="accounttype" domain="" context="{'group_by':'user_type_id'}"/>\n                    </group>\n                    <searchpanel class="account_root">\n                        <field name="root_id" icon="fa-filter" limit="0"/>\n                    </searchpanel>\n                </search>\n            	account/views/account_account_views.xml	\N	\N	\N	\N	primary	t	1	2025-08-28 11:32:28.994214	1	2025-08-28 11:32:28.994214	f
1597	report_pelitainsani_general_consent	\N	ehealth_document.report_pelitainsani_general_consent	16	qweb	<?xml version="1.0"?>\n<t t-name="ehealth_document.report_pelitainsani_general_consent">\n\t\t\t<t t-set="company" t-value="res_company"/>\n\t\t\t<t t-call="ehealth_document.header_default_document">\n\t\t\t\t<div class="page" style="font-size:13px; line-height: 1.4;">\n\t\t\t\t\t<div class="row" style="border: 1px solid black">\n\t\t\t\t\t\t<div class="">\n\t\t\t\t\t\t\t<div class="row mt-2" style="border-bottom: 1px solid black">\n\t\t\t\t\t\t\t\t<div class="ml-4 mb-1">\n\t\t\t\t\t\t\t\t\t<p>Diisi oleh Petugas Pendaftaran pada</p>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<div class="ml-2 mb-1">\n\t\t\t\t\t\t\t\t\t<p>tanggal: <t t-if="'tgl-consent' in data"><t t-esc="data['tgl-consent']"/></t></p>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<div class="ml-5 mb-1">\n\t\t\t\t\t\t\t\t\t<p>jam: <t t-if="'waktu-consent' in data"><t t-esc="data['waktu-consent']"/></t></p>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t<div class="pl-2" style="border-bottom: 1px solid black">\n\t\t\t\t\t\t\t\t<p class="mb-0" style="font-size: 16px">\n\t\t\t\t\t\t\t\t\t<strong>IDENTITAS PASIEN</strong>\n\t\t\t\t\t\t\t\t</p>\n\t\t\t\t\t\t\t\t<p class="mb-0" style="font-style: italic;">(Diisi sesuai Kartu Tanda Pengenal Pasien yang masih berlaku; KTP/ KK/ SIM/ Kartu Pelajar/ dsb)</p>\n\t\t\t\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t\t\t\t<div class="col-3">Nomer Rekam Medis</div>\n\t\t\t\t\t\t\t\t\t<div class="col-8">: <t t-esc="data['no-cm']"/> </div>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t\t\t\t<div class="col-3">Nama</div>\n\t\t\t\t\t\t\t\t\t<div class="col-8">: <t t-esc="o['partner_id']['name']"/></div>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t\t\t\t<div class="col-3">Jenis Kelamin</div>\n\t\t\t\t\t\t\t\t\t<div class="col-8">:\n\t\t\t\t\t\t\t\t\t\t<t t-if="o['partner_id']['gender'] == 'male'">Laki-Laki</t>\n\t\t\t\t\t\t\t\t\t\t<t t-else="">Perempuan</t>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t\t\t\t<div class="col-3">Tanggal Lahir</div>\n\t\t\t\t\t\t\t\t\t<div class="col-8">: <t t-esc="o['partner_id']['birthDate'].strftime('%d-%m-%Y')"/></div>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t\t\t\t<div class="col-3">Agama</div>\n\t\t\t\t\t\t\t\t\t<div class="col-8">: <t t-if="'religion' in data"> <t t-esc="data['religion']"/> </t></div>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t\t\t\t<div class="col-3">Pendidikan</div>\n\t\t\t\t\t\t\t\t\t<div class="col-8">: </div>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t\t\t\t<div class="col-3">Pekerjaan</div>\n\t\t\t\t\t\t\t\t\t<div class="col-8">: <t t-if="'occupation' in data"> <t t-esc="data['occupation']"/> </t></div>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t\t\t\t<div class="col-3">Alamat</div>\n\t\t\t\t\t\t\t\t\t<div class="col-8">: <t t-esc="o['partner_id']['street']"/></div>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t\t\t\t<div class="col-3">Status Perkawinan</div>\n\t\t\t\t\t\t\t\t\t<div class="col-8">: <t t-if="'marital-status' in data"> <t t-esc="data['marital-status']"/> </t></div>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t\t\t\t<div class="col-3">Nama Suami / Istri</div>\n\t\t\t\t\t\t\t\t\t<div class="col-8">: <t t-if="'partner' in data"> <t t-esc="data['partner']"/> </t></div>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t\t\t\t<div class="col-3">Status Pembiayaan</div>\n\t\t\t\t\t\t\t\t\t<div class="col-8">: <t t-if="'payment' in data"> <t t-esc="data['payment']"/> </t></div>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t<div style="background-color:#c1d09d; border-bottom: 1px solid black">\n\t\t\t\t\t\t\t\t<p class="text-center mb-0" style="width: 100%;">\n\t\t\t\t\t\t\t\t\t<strong>PERSETUJUAN UMUM / GENERAL CONSENT</strong>\n\t\t\t\t\t\t\t\t</p>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t<p class="text-center mt-1 mb-0" style="font-style: italic; text-decoration: underline;">\n\t\t\t\t\t\t\t\t<strong>PASIEN / WALI PASIEN HARUS MEMBACA, MEMAHAMI DAN MENGISI INFORMASI BERIKUT</strong>\n\t\t\t\t\t\t\t</p>\n\t\t\t\t\t\t\t<p class="mt-1 mb-1">Yang bertanda tangan di bawah ini, saya:</p>\n\t\t\t\t\t\t\t<div class="pl-2">\n\t\t\t\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t\t\t\t<div class="col-3">Nama Lengkap</div>\n\t\t\t\t\t\t\t\t\t<div class="col-6">:\n\t\t\t\t\t\t\t\t\t\t<strong>\n\t\t\t\t\t\t\t\t\t\t\t<t t-esc="data['nama-pj']"/>\n\t\t\t\t\t\t\t\t\t\t</strong>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t\t\t\t<div class="col-3">Tempat Lahir</div>\n\t\t\t\t\t\t\t\t\t<div class="col-6">: <t t-if="'tempat-lahir-pj' in data"><t t-esc="data['tempat-lahir-pj']"/></t></div>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t\t\t\t<div class="col-3">Tanggal Lahir</div>\n\t\t\t\t\t\t\t\t\t<div class="col-6">: <t t-if="'tgl-lahir-pj' in data"><t t-esc="data['tgl-lahir-pj']"/></t></div>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t\t\t\t<div class="col-3">Jenis Kelamin</div>\n\t\t\t\t\t\t\t\t\t<div class="col-6">:\n\t\t\t\t\t\t\t\t\t\t<t t-if="'jenis-kelamin-pj' in data">\n\t\t\t\t\t\t\t\t\t\t\t<t t-if="data['jenis-kelamin-pj'] == 'male'">Laki-Laki</t>\n\t\t\t\t\t\t\t\t\t\t\t<t t-else="">Perempuan</t>\n\t\t\t\t\t\t\t\t\t\t</t>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t\t\t\t<div class="col-3">Alamat</div>\n\t\t\t\t\t\t\t\t\t<div class="col-6">: <t t-if="'alamat-pj' in data"><t t-esc="data['alamat-pj']"/></t></div>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t\t\t\t<div class="col-3">No. Telepon</div>\n\t\t\t\t\t\t\t\t\t<div class="col-6">: <t t-if="'telepon-pj' in data"><t t-esc="data['telepon-pj']"/></t></div>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t\t\t\t<div class="col-3">Email</div>\n\t\t\t\t\t\t\t\t\t<div class="col-6">: <t t-if="'email-pj' in data"><t t-esc="data['email-pj']"/></t></div>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<t t-if="'relasi-pj' in data">\n\t\t\t\t\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t\t\t\t\t<div class="col-3">Bertindak atas</div>\n\t\t\t\t\t\t\t\t\t\t<div class="col-6">: <t t-if="'relasi-pj' in data"><t t-esc="data['relasi-pj']"/></t></div>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t</t>\n\t\t\t\t\t\t\t\t<div>Menyatakan</div>\n\t\t\t\t\t\t\t\t<div class="pr-3" style="page-break-inside: avoid; page-break-before: auto;">\n\t\t\t\t\t\t\t\t\t<div>\n\t\t\t\t\t\t\t\t\t\t<strong>I. PERSETUJUAN UNTUK PERAWATAN DAN PENGOBATAN</strong>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t<div class="d-flex ml-3">\n\t\t\t\t\t\t\t\t\t\t<div class="pr-1">1.</div>\n\t\t\t\t\t\t\t\t\t\t<div>Saya mengetahui bahwa saya membutuhkan perawatan medis dan mengijinkan dokter/tenaga Kesehatan lainnya di fasilitas Kesehatan RS/Klinik Pratama Pelita Insani untuk melakukan pemeriksaan dan memberikan pengobatan / tindakan/ asuhan yang sesuai prosedur</div>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t<div class="d-flex ml-3">\n\t\t\t\t\t\t\t\t\t\t<div class="pr-1">2.</div>\n\t\t\t\t\t\t\t\t\t\t<div>Saya sadar bahwa praktik kedokteran bukanlah ilmu pasti dan saya mengakui bahwa tidak ada jaminan atas hasil apapun terhadap pengobatan / Tindakan/ asuhan yang dilakukan pada saya</div>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t<div class="d-flex ml-3">\n\t\t\t\t\t\t\t\t\t\t<div class="pr-1">3.</div>\n\t\t\t\t\t\t\t\t\t\t<div class="">\n\t\t\t\t\t\t\t\t\t\t\t<p>Saya mengerti dan memahami bahwa </p>\n\t\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t<div class="d-flex ml-5 pr-3">\n\t\t\t\t\t\t\t\t\t\t<div class="pr-1">a.</div>\n\t\t\t\t\t\t\t\t\t\t<div>Saya memiliki hak untuk menyatakan persetujuan atau penolakan untuk setiap jasa perawatan medis yang akan diberikan pada saya. Saya memahani bahwa pemberian jasa yang melibatkan data pribadi saya yang saya tolak, tanpanya layanan tidak dapat diberikan, seperti pemeriksaan penyakit pasien, pemberian obat, asuhan, dan tindakan medis.</div>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t<div class="d-flex ml-5 pr-3">\n\t\t\t\t\t\t\t\t\t\t<div class="pr-1">b.</div>\n\t\t\t\t\t\t\t\t\t\t<div>Saya memiliki hak untuk mengajukan pertanyaan terkait rencana pelayanan yang akan diberikan pada saya, termasuk identitas setiap orang yang akan memberikan jasa perawatan medis.</div>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t<div class="d-flex ml-5 pr-3">\n\t\t\t\t\t\t\t\t\t\t<div class="pr-1">c.</div>\n\t\t\t\t\t\t\t\t\t\t<div>Saya memiliki hak untuk melakukan pernarikan persetujuan saat kewajiban pihak fasilitas kesehatan menyediakan layanan belum terlaksana atau saya mengubah keputusan persetujan atau penolakan yang sebelumnya saya berikan</div>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t<div class="d-flex ml-3">\n\t\t\t\t\t\t\t\t\t\t<div class="pr-1">4.</div>\n\t\t\t\t\t\t\t\t\t\t<div class="">\n\t\t\t\t\t\t\t\t\t\t\t<p>Saya menyetujui bahwa dalam keadaan darurat (atau gawat darurat) data pribadi Saya hanya akan digunakan untuk kepentingan perawatan medis. Pemrosesan data ini hanya akan dilakukan apabila cara lain tidak dapat diupayakan seperti saya yang tidak sadarkan diri atau saya yang memerlukan tindakan segera di IGD.</p>\n\t\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<div class="pr-3" style="page-break-inside: avoid; page-break-before: auto;">\n\t\t\t\t\t\t\t\t\t<div>\n\t\t\t\t\t\t\t\t\t\t<strong>II. PERSETUJUAN PELEPASAN DATA</strong>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t<div class="d-flex ml-3">\n\t\t\t\t\t\t\t\t\t\t<div class="pr-1">1.</div>\n\t\t\t\t\t\t\t\t\t\t<div>Saya memahami bahwa informasi pribadi saya terkait dengan kondisi Kesehatan saya, berdasarkan pemeriksaan yang saya jalani di fasilitas Kesehatan RS/Klinik Pratama Pelita Insani akan terjamin kerahasiaannya</div>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t<div class="d-flex ml-3">\n\t\t\t\t\t\t\t\t\t\t<div class="pr-1">2.</div>\n\t\t\t\t\t\t\t\t\t\t<div>Saya memberikan wewenang kepada fasilitas Kesehatan RS/Klinik Pratama Pelita Insani untuk memberikan informasi berkaitan dengan kondisi Kesehatan saya untuk keperluan proses klaim asuransi dan administrasi resmi apabila diperlukan (BPJS, Kemenkenkes, Dinkes)</div>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t<div class="d-flex ml-3">\n\t\t\t\t\t\t\t\t\t\t<div class="pr-1">3.</div>\n\t\t\t\t\t\t\t\t\t\t<div>Saya memberi wewenang akses kepada fasilitas Kesehatan RS/Klinik Pratama Pelita Insani untuk memberikan informasi Kesehatan saya kepada pihak berikut apabila diperlukan:</div>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t<div class="d-flex- ml-5">\n\t\t\t\t\t\t\t\t\t\t<t t-if="'authorized-parties' in data">\n\t\t\t\t\t\t\t\t\t\t\t<t t-foreach="data['authorized-parties']" t-as="name">\n\t\t\t\t\t\t\t\t\t\t\t\t<div><t t-esc="name"/></div>\n\t\t\t\t\t\t\t\t\t\t\t</t>\n\t\t\t\t\t\t\t\t\t\t</t>\n\t\t\t\t\t\t\t\t\t\t<t t-else="">\n\t\t\t\t\t\t\t\t\t\t\t<div style="height: 15px;"/>\n\t\t\t\t\t\t\t\t\t\t</t>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<div class="pr-3" style="page-break-inside: avoid; page-break-before: auto;">\n\t\t\t\t\t\t\t\t\t<div>\n\t\t\t\t\t\t\t\t\t\t<strong>III. HAK DAN KEWAJIBAN PASIEN</strong>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t<div class="ml-3">Saya telah mendapatkan informasi tentang “Hak dan Kewajiban Pasien” di fasilitas Kesehatan RS/Klinik Pratama Pelita Insani melalui informasi yang diberikan kepada saya oleh petugas yang melayani saya.</div>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<div class="pr-3" style="page-break-inside: avoid; page-break-before: auto;"> \n\t\t\t\t\t\t\t\t\t<div>\n\t\t\t\t\t\t\t\t\t\t<strong>IV. INTEGRITAS DATA MEDIS</strong>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t<div class="ml-3">Saya menyetujui bahwa segala data Rekam Medis, termasuk didalamnya Kesalahan Pemasukan Data atau Pengubahan diagnosis medis, tetap akan didokumentasikan karena menjadi bagian dari rekam medis pasien bahkan setelah diagnosis saya diperbaiki. Saya memahami bahwa hal ini bertujuan menjelaskan riwayat tindakan medis yang diberikan kepada pasien, atau untuk masalah kesehatan lainnya.</div>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<div class="pr-3" style="page-break-inside: avoid; page-break-before: auto;">\n\t\t\t\t\t\t\t\t\t<div>\n\t\t\t\t\t\t\t\t\t\t<strong>V. KOMUNIKASI</strong>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t<div class="ml-3">Saya bersedia untuk dihubungi melalui alamat atau alamat email sehubungan dengan reporting hack dan kegagalan/gangguan sistem yang berdampak serius mengenai dampak serius kebocoran data pribadi agar Saya dapat mengantisipasi risiko dari peristiwa tersebut. Selain itu Saya mengijinkan pelaporan ini untuk diberikan kepada otoritas yang berwenang dan segera tanpa menunda-nunda sesuai dengan peraturan perundang-undangan yang berlaku.</div>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class="row" style="page-break-inside: avoid; page-break-before: auto;">\n\t\t\t\t\t\t<div class="col-4">\n\t\t\t\t\t\t\t<p class="pt-3">Petugas</p>\n\t\t\t\t\t\t\t<t t-if="'practitioner-sign' in data">\n\t\t\t\t\t\t\t\t<div style="width:110px;height:60px;">\n\t\t\t\t\t\t\t\t\t<img height="80" t-att-src="data['practitioner-sign']"/>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t</t>\n\t\t\t\t\t\t\t<t t-else="">\n\t\t\t\t\t\t\t\t<div style="width:110px;height:60px;"/>\n\t\t\t\t\t\t\t</t>\n\t\t\t\t\t\t\t<p class="mb-0 mt-1">\n\t\t\t\t\t\t\t\t<t t-if="'practitioner-name' in data">\n\t\t\t\t\t\t\t\t\t<strong>\n\t\t\t\t\t\t\t\t\t\t<t t-esc="data['practitioner-name']"/>\n\t\t\t\t\t\t\t\t\t</strong>\n\t\t\t\t\t\t\t\t</t>\n\t\t\t\t\t\t\t\t<t t-elif="'examiner_name' in data">\n\t\t\t\t\t\t\t\t\t<strong>\n\t\t\t\t\t\t\t\t\t\t<t t-esc="data['examiner_name']"/>\n\t\t\t\t\t\t\t\t\t</strong>\n\t\t\t\t\t\t\t\t</t>\n\t\t\t\t\t\t\t\t<t t-else="">\n\t\t\t\t\t\t\t\t\t<strong>\n\t\t\t\t\t\t\t\t\t\t<t t-esc="data['sender']"/>\n\t\t\t\t\t\t\t\t\t</strong>\n\t\t\t\t\t\t\t\t</t>\n\t\t\t\t\t\t\t</p>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t<div class="col-4"/>\n\t\t\t\t\t\t<div class="col-4">\n\t\t\t\t\t\t\t<p class="mb-0">Jakarta,\n\t\t\t\t\t\t\t\t<t t-esc="o.to_date_string(data['registration_date'])"/>\n\t\t\t\t\t\t\t</p>\n\t\t\t\t\t\t\t<p class="mb-0">Pasien / Wali Pasien</p>\n\t\t\t\t\t\t\t<t t-if="'sign-pj' in data">\n\t\t\t\t\t\t\t\t<div style="width:110px;height:60px;">\n\t\t\t\t\t\t\t\t\t<img height="80" t-att-src="data['sign-pj']"/>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t</t>\n\t\t\t\t\t\t\t<p class="mb-0 mt-1">\n\t\t\t\t\t\t\t\t<strong>\n\t\t\t\t\t\t\t\t\t<t t-esc="data['nama-pj']"/>\n\t\t\t\t\t\t\t\t</strong>\n\t\t\t\t\t\t\t</p>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t</t>\n\t\t</t>\n\t	ehealth_document/report/template_general_consent/report_pelitainsani_general_consent.xml	\N	\N	\N	\N	primary	t	1	2025-08-28 11:34:01.364376	1	2025-08-28 11:34:01.364376	f

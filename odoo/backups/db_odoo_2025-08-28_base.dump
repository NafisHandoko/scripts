                                          </t>\n                                            </td>\n                                            <td>Benar Obat</td>\n                                        </tr>\n                                        <tr>\n                                            <td>\n                                                <t t-if="o.right_dose">\n                                                    <span class="fa fa-check" style="color: green;"/>\n                                                </t>\n                                                <t t-if="not o.right_dose">\n                                                    <span class="fa fa-times" style="color: red;"/>\n                                                </t>\n                                            </td>\n                                            <td>Benar Dosis</td>\n                                        </tr>\n                                        <tr>\n                                            <td>\n                                                <t t-if="o.right_route">\n                                                    <span class="fa fa-check" style="color: green;"/>\n                                                </t>\n                                                <t t-if="not o.right_route">\n                                                    <span class="fa fa-times" style="color: red;"/>\n                                                </t>\n                                            </td>\n                                            <td>Benar Cara</td>\n                                        </tr>\n                                        <tr>\n                                            <td>\n                                                <t t-if="o.right_time">\n                                                    <span class="fa fa-check" style="color: green;"/>\n                                                </t>\n                  
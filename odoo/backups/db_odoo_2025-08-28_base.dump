1636	report_praktekdrargadia_surat_rujukan	\N	ehealth_document.report_praktekdrargadia_surat_rujukan	16	qweb	<?xml version="1.0"?>\n<t t-name="ehealth_document.report_praktekdrargadia_surat_rujukan">\n            <t t-set="company" t-value="res_company"/>\n            <t t-call="web.external_layout">\n                <t t-set="o" t-value="o.with_context(lang=lang)"/>\n                <div class="page">\n                    <!-- Header -->\n                    <div class="text-center mt-3 mb-4">\n                        <h5 class="mb-0"><strong>SURAT PENGANTAR RUJUKAN</strong></h5>\n                        <p class="mb-1">Nomor: <strong><t t-esc="o['name']"/></strong></p>\n                    </div>\n                    \n                    <!-- Recipient -->\n                    <p class="mt-6 mb-4">\n                        Kepada Yth.<br/>\n                        <strong><t t-esc="data['tujuan-surat']"/><span class="ml-2"><t t-esc="data['tempat-tujuan-surat']"/></span></strong>\n                    </p>\n\n                    <!-- Introduction -->\n                    <p class="mb-3">\n                        Dengan hormat,<br/>\n                        Kami hadapkan pasien:\n                    </p>\n                    \n                    <!-- Patient Data -->\n                    <div class="ml-3 mb-4">\n                        <div class="row">\n                            <div class="col-4"><strong>Nama</strong></div>\n                            <div class="col-8">: <strong><t t-esc="o['partner_id']['name']"/></strong></div>\n                        </div>\n                        <div class="row">\n                            <div class="col-4"><strong>Jenis Kelamin</strong></div>\n                            <div class="col-8">: \n                                <t t-if="o['partner_id']['gender'] == 'male'">Laki-Laki</t>\n                                <t t-else="">Perempuan</t>\n                            </div>\n                        </div>\n                        <div class="row">\n                            <div class="col-4"><strong>Usia</strong></div>\n                            <div class="col-8">: <t t-esc="o.count_age(o['partner_id']['birthDate'].strftime('%d/%m/%Y'))"/> Tahun</div>\n                        </div>\n                        <div class="row">\n                            <div class="col-4"><strong>Berat Badan</strong></div>\n                            <div class="col-8">: <t t-esc="data['berat-badan']"/> kg</div>\n                        </div>\n                        <div class="row">\n                            <div class="col-4"><strong>Alamat</strong></div>\n                            <div class="col-8">: <t t-esc="o['partner_id']['street']"/></div>\n                        </div>\n                        <div class="row">\n                            <div class="col-4"><strong>Diagnosa</strong></div>\n                            <div class="col-8">: <t t-esc="data['diagnosa']"/></div>\n                        </div>\n                    </div>\n\n                    <!-- Referral Request -->\n                    <p class="mb-3">\n                        Mohon untuk <strong>RAWAT INAP UNTUK TATALAKSANA SELANJUTNYA*</strong>\n                    </p>\n\n                    <!-- Closing -->\n                    <p class="mb-4">Demikian surat ini kami sampaikan, atas kerjasama dan perhatiannya kami ucapkan terima kasih.</p>\n\n                    <!-- Bottom Section - Two Columns -->\n                    <div class="row pt-5">\n                        <!-- Left Column - Signature -->\n                        <div class="col-6">\n                            <p class="mb-1">\n                                <t t-esc="o['operating_unit_id']['company_id']['city']"/>, \n                                <t t-esc="o.to_date_string(data['registration_date'])"/>\n                            </p>\n                            <p class="mb-3"><strong>Hormat kami,</strong></p>\n                            \n                            <!-- Signature Space -->\n                            <div style="width:100px; height:100px; border-bottom: 1px solid #000;"/>\n                            \n                            <!-- Doctor Name -->\n                            <div class="mt-2">\n                                <t t-if="'examiner_name' in data">\n                                    <strong><t t-esc="data['examiner_name']"/></strong>\n                                </t>\n                                <t t-else="">\n                                    <strong><t t-esc="data['sender']"/></strong>\n                                </t>\n                            </div>\n                            \n                            <!-- SIP Number -->\n                            <div class="mt-2">\n                                <small><strong>No. SIP:</strong> <t t-esc="data.get('no_sip', '')"/></small>\n                            </div>\n                        </div>\n                        \n                        <!-- Right Column - Treatment Suggestions -->\n                        <div class="col-6">\n                            <p class="mb-2"><strong>Nb.</strong></p>\n                            <p class="mb-2"><strong>Usulan tatalaksana di IGD:</strong></p>\n                            <div class="ml-3">\n                                <t t-if="'keterangan-pemeriksaan' in data and data['keterangan-pemeriksaan']">\n                                    <t t-if="',' in data['keterangan-pemeriksaan']">\n                                        <t t-set="treatment_list" t-value="data['keterangan-pemeriksaan'].split(',')"/>\n                                        <t t-foreach="treatment_list" t-as="item">\n                                            <div class="mb-1">- <t t-esc="item.strip()"/></div>\n                                        </t>\n                                    </t>\n                                    <t t-else="">\n                                        <div class="mb-1">- <t t-esc="data['keterangan-pemeriksaan']"/></div>\n                                    </t>\n                                </t>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n            </t>\n        </t>\n    	ehealth_document/report/template_surat_rujukan/report_praktekdrargadia_surat_rujukan.xml	\N	\N	\N	\N	primary	t	1	2025-08-28 11:34:01.364376	1	2025-08-28 11:34:01.364376	f

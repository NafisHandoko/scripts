 &quot;Product Unit of Measure&quot;}"/>\n                        <t t-esc="docs['uom']" groups="uom.group_uom"/>\n                    </div>\n                    <div>On Hand</div>\n                </div>\n                <div t-attf-class="mx-3 text-center #{docs['virtual_available'] &lt; 0 and 'text-danger'}">\n                    <div class="h3">\n                        <t t-esc="docs['virtual_available']" t-options="{&quot;widget&quot;: &quot;float&quot;, &quot;decimal_precision&quot;: &quot;Product Unit of Measure&quot;}"/>\n                        <t t-esc="docs['uom']" groups="uom.group_uom"/>\n                    </div>\n                    <div>Forecasted</div>\n                </div>\n                <div name="pending_forecasted" t-attf-class="mx-3 text-center #{future_virtual_available &lt; 0 and 'text-danger'}">\n                    <div class="h3">\n                        <t t-esc="future_virtual_available" t-options="{&quot;widget&quot;: &quot;float&quot;, &quot;decimal_precision&quot;: &quot;Product Unit of Measure&quot;}"/>\n                        <t t-esc="docs['uom']" groups="uom.group_uom"/>\n                    </div>\n                    <div>Forecasted<br/>+ Pending</div>\n                </div>\n            </div>\n        </div>\n    </t>\n\n    	stock/report/report_stock_forecasted.xml	\N	\N	\N	\N	primary	t	1	2025-08-28 11:32:42.235962	1	2025-08-28 11:32:42.235962	f
1658	report_default_hemodialisis	\N	ehealth_document.report_default_hemodialisis	16	qweb	<?xml version="1.0"?>\n<t t-name="ehealth_document.report_default_hemodialisis">\n        <t t-set="company" t-value="res_company"/>\n        <t t-call="web.external_layout">\n          <t t-set="o" t-value="o.with_context(lang=lang)"/> \n          <div class="page" style="font-size: 10px;">\n            <div class="row">\n              <div class="col-6">\n                <p class="text-center pt-2 mt-1 mb-0"><strong>STATUS HEMODIALISIS PASIEN</strong></p>\n                <p class="text-center">Nomor: <t t-esc="o['name']"/></p>\n              </div>\n              <div class="col-6">\n                <div>\n                  <div class="row">\n                    <div class="col-4">\n                      <p>No. RM</p>\n                    </div>\n                    <div class="col-8">\n                      <p><span class="pr-2">:</span> <t t-esc="o['partner_id']['medical_record']"/></p>\n                    </div>\n                  </div>\n                  <div class="row">\n                    <div class="col-4">\n                      <p>Hari, Tanggal</p>\n                    </div>\n                    <div class="col-8">\n                      <p><span class="pr-2">:</span> <t t-esc="o.to_date_string(data['registration_date'])"/></p>\n                    </div>\n                  </div>\n                  <div class="row">\n                    <div class="col-4">\n                      <p>Hemodialisis Ke</p>\n                    </div>\n                    <div class="col-8">\n                      <p>: 2</p>\n                    </div>\n                  </div>\n                </div>\n              </div>\n            </div>\n\n            <div class="row mt-1">\n              <div class="col-6">\n                <div>\n                  <p class="mt-0 mb-0"><strong>Data Pre HD</strong></p>\n                  <div class="row">\n                    <div class="col-4">\n                      <p>Nama</p>\n                    </div>\n                    <div class="col-8">\n                      <p><span class="pr-2">:</span> <t t-esc="o['partner_id']['name']"/></p>\n                    </div>\n                  </div>\n                  <div class="row">\n                    <div class="col-4">\n                      <p>Tanggal Lahir</p>\n                    </div>\n                    <div class="col-8">\n                      <p><span class="pr-2">:</span> <t t-esc="o['partner_id']['birthDate'].strftime('%d-%m-%Y')"/> (<t t-esc="o.count_age(o['partner_id']['birthDate'].strftime('%d/%m/%Y'))"/> Tahun)</p>\n                    </div>\n                  </div>\n                  <div class="row">\n                    <div class="col-4">\n                      <p>Mesin No.</p>\n                    </div>\n                    <div class="col-8">\n                      <p>: </p>\n                    </div>\n                  </div>\n                </div>\n              </div>\n              <div class="col-6">\n                <div>\n                  <div class="row pt-3">\n                    <div class="col-4">\n                      <p>Lama HD</p>\n                    </div>\n                    <t t-if="'procedure_hd' in data['doc_parts']">\n                      <div class="col-8">\n                        <p><span class="pr-2">:</span>\n                          <t t-esc="data['doc_parts']['procedure_hd']['lama-hd']"/> jam\n                        </p>\n                      </div>\n                    </t>\n                  </div>\n                  <div class="row">\n                    <div class="col-4">\n                      <p>UFG</p>\n                    </div>\n                    <t t-if="'procedure_hd' in data['doc_parts']">\n                      <div class="col-8">\n                        <p><span class="pr-2">:</span>\n                          <t t-esc="data['doc_parts']['procedure_hd']['ufg']"/> mL\n                        </p>\n                      </div>\n                    </t>\n                  </div>\n                  <div class="row">\n                    <div class="col-4">\n                      <p>BB Kering</p>\n                    </div>\n                    <t t-if="'vital_sign_pre' in data['doc_parts']">\n                      <div class="col-8">\n                        <p><span class="pr-2">:</span>\n                          <t t-esc="data['doc_parts']['vital_sign_pre']['bb-kering']"/> kg\n                        </p>\n                      </div>\n                    </t>\n                  </div>\n                  <div class="row">\n                    <div class="col-4">\n                      <p>BB HD Terakhir</p>\n                    </div>\n                    <t t-if="'vital_sign_pre' in data['doc_parts']">\n                      <div class="col-8">\n                        <p><span class="pr-2">:</span>\n                          <t t-if="'bb-terakhir' in data['doc_parts']['vital_sign_pre']">\n                            <t t-esc="data['doc_parts']['vital_sign_pre']['bb-terakhir']"/> kg\n                          </t>\n                        </p>\n                      </div>\n                    </t>\n                  </div>\n                </div>\n              </div>\n            </div>\n\n            <div class="row mt-1">\n              <div class="col-6">\n                <div>\n                  <p class="mt-0 mb-0"><strong>Pengkajian Keperawatan</strong></p>\n\n                  <t t-if="'chief_complaint' in data['doc_parts']">\n                    <div class="row">\n                      <div class="col-4">\n                        <p>1. Keluhan Utama</p>\n                      </div>\n                      <div class="col-4">\n                        <p><span class="pr-2">:</span>\n                          <t t-foreach="data['doc_parts']['chief_complaint']" t-as="chief_complaint">\n                            <t t-esc="chief_complaint"/>\n                          </t>\n                        </p>\n                      </div>\n                    </div>\n                  </t>\n                  <div class="row mt-2">\n                    <div class="col-4">\n                      <p>2. Pemeriksaan</p>\n                    </div>\n                    <div class="col-4">\n                      <p class="pl-3">Pre HD</p>\n                    </div>\n                    <div class="col-4">\n                      <p class="pl-1">Pasca HD</p>\n                    </div>\n                  </div>\n                  <div class="pl-2 row">\n                    <div class="col-4">\n                      <p>Keadaan Umum</p>\n                    </div>\n                    <t t-if="'general_condition_pre' in data['doc_parts']">\n                      <div class="col-4">\n                        <p><span class="pr-2">:</span>\n                          <t t-foreach="data['doc_parts']['general_condition_pre']" t-as="general_condition_pre">\n                            <t t-esc="general_condition_pre"/>\n                          </t>\n                        </p>\n                      </div>\n                    </t>\n                    <t t-if="'general_condition_post' in data['doc_parts']">\n                      <div class="col-4">\n                        <p>\n                          <t t-foreach="data['doc_parts']['general_condition_post']" t-as="general_condition_post">\n                            <t t-esc="general_condition_post"/>\n                          </t>\n                        </p>\n                      </div>\n                    </t>\n                  </div>\n                  <div class="pl-2 row">\n                    <div class="col-4">\n                      <p>Kesadaran</p>\n                    </div>\n                    <t t-if="'vital_sign_pre' in data['doc_parts'] and 'consciousness' in data['doc_parts']['vital_sign_pre']">\n                      <div class="col-4">\n                        <p><span class="pr-2">:</span>\n                          <t t-esc="data['doc_parts']['vital_sign_pre']['consciousness']"/>\n                        </p>\n                      </div>\n                    </t>\n                    <t t-if="'vital_sign_post' in data['doc_parts'] and 'consciousness' in data['doc_parts']['vital_sign_post']">\n                      <div class="col-4">\n                        <p>\n                          <t t-esc="data['doc_parts']['vital_sign_post']['consciousness']"/>\n                        </p>\n                      </div>\n                    </t>\n                  </div>\n                  <div class="pl-2 row">\n                    <div class="col-4">\n                      <p>Tekanan Darah</p>\n                    </div>\n                    <t t-if="'vital_sign_pre' in data['doc_parts']">\n                      <div class="col-4">\n                        <p><span class="pr-2">:</span>\n                          <t t-if="'sistole' in data['doc_parts']['vital_sign_pre']">\n                            <t t-esc="data['doc_parts']['vital_sign_pre']['sistole']"/>\n                          </t>\n                          /\n                          <t t-if="'diastole' in data['doc_parts']['vital_sign_pre']">\n                            <t t-esc="data['doc_parts']['vital_sign_pre']['diastole']"/>\n                          </t> mmHg\n                        </p>\n                      </div>\n                    </t>\n                    <t t-if="'vital_sign_post' in data['doc_parts']">\n                      <div class="col-4">\n                        <p>\n                          <t t-if="'sistole' in data['doc_parts']['vital_sign_post']">\n                            <t t-esc="data['doc_parts']['vital_sign_post']['sistole']"/>\n                          </t>\n                          /\n                          <t t-if="'diastole' in data['doc_parts']['vital_sign_post']">\n                            <t t-esc="data['doc_parts']['vital_sign_post']['diastole']"/>\n                          </t> mmHg\n                        </p>\n                      </div>\n                    </t>\n                  </div>\n                  <div class="pl-2 row">\n                    <div class="col-4">\n                      <p>Nadi</p>\n                    </div>\n                    <t t-if="'vital_sign_pre' in data['doc_parts'] and 'nadi' in data['doc_parts']['vital_sign_pre']">\n                      <div class="col-4">\n                        <p><span class="pr-2">:</span>\n                          <t t-esc="data['doc_parts']['vital_sign_pre']['nadi']"/> x/mnt\n                        </p>\n                      </div>\n                    </t>\n                    <t t-if="'vital_sign_post' in data['doc_parts'] and 'nadi' in data['doc_parts']['vital_sign_post']">\n                      <div class="col-4">\n                        <p>\n                          <t t-esc="data['doc_parts']['vital_sign_post']['nadi']"/> x/mnt\n                        </p>\n                      </div>\n                    </t>\n                  </div>\n                  <div class="pl-2 row">\n                    <div class="col-4">\n                      <p>Respirasi</p>\n                    </div>\n                    <t t-if="'vital_sign_pre' in data['doc_parts'] and 'respirasi' in data['doc_parts']['vital_sign_pre']">\n                      <div class="col-4">\n                        <p><span class="pr-2">:</span>\n                          <t t-esc="data['doc_parts']['vital_sign_pre']['respirasi']"/> x/mnt\n                        </p>\n                      </div>\n                    </t>\n                    <t t-if="'vital_sign_post' in data['doc_parts'] and 'respirasi' in data['doc_parts']['vital_sign_post']">\n                      <div class="col-4">\n                        <p>\n                          <t t-esc="data['doc_parts']['vital_sign_post']['respirasi']"/> x/mnt\n                        </p>\n                      </div>\n                    </t>\n                  </div>\n                  <div class="pl-2 row">\n                    <div class="col-4">\n                      <p>Suhu</p>\n                    </div>\n                    <t t-if="'vital_sign_pre' in data['doc_parts'] and 'suhu' in data['doc_parts']['vital_sign_pre']">\n                      <div class="col-4">\n                        <p><span class="pr-2">:</span>\n                          <t t-esc="data['doc_parts']['vital_sign_pre']['suhu']"/> °C\n                        </p>\n                      </div>\n                    </t>\n                    <t t-if="'vital_sign_post' in data['doc_parts'] and 'suhu' in data['doc_parts']['vital_sign_post']">\n                      <div class="col-4">\n                        <p>\n                          <t t-esc="data['doc_parts']['vital_sign_post']['suhu']"/> °C\n                        </p>\n                      </div>\n                    </t>\n                  </div>\n                  <div class="pl-2 row">\n                    <div class="col-4">\n                      <p>Berat Badan</p>\n                    </div>\n                    <t t-if="'vital_sign_pre' in data['doc_parts'] and 'berat-badan' in data['doc_parts']['vital_sign_pre']">\n                      <div class="col-4">\n                        <p><span class="pr-2">:</span>\n                          <t t-esc="data['doc_parts']['vital_sign_pre']['berat-badan']"/> kg\n                        </p>\n                      </div>\n                    </t>\n                    <t t-if="'vital_sign_post' in data['doc_parts'] and 'berat-badan' in data['doc_parts']['vital_sign_post']">\n                      <div class="col-4">\n                        <p>\n                          <t t-esc="data['doc_parts']['vital_sign_post']['berat-badan']"/> kg\n                        </p>\n                      </div>\n                    </t>\n                  </div>\n                  <div class="pl-2 row">\n                    <div class="col-4">\n                      <p>Penambahan Pengurangan</p>\n                    </div>\n                    <t t-if="'vital_sign_pre' in data['doc_parts'] and 'penambahan-bb' in data['doc_parts']['vital_sign_pre']">\n                      <div class="col-4">\n                        <p><span class="pr-2">:</span>\n                          <t t-esc="data['doc_parts']['vital_sign_pre']['penambahan-bb']"/> kg\n                        </p>\n                      </div>\n                    </t>\n                    <t t-if="'vital_sign_post' in data['doc_parts'] and 'penambahan-bb' in data['doc_parts']['vital_sign_post']">\n                      <div class="col-4">\n                        <p>\n                          <t t-esc="data['doc_parts']['vital_sign_post']['penambahan-bb']"/> kg\n                        </p>\n                      </div>\n                    </t>\n                  </div>\n                  <div class="pl-2 row mt-2">\n                    <div class="col-4">\n                      <p>Konjungtiva</p>\n                    </div>\n                    <t t-if="'conjunctiva' in data['doc_parts']">\n                      <div class="col-4">\n                        <p><span class="pr-2">:</span>\n                          <t t-esc="data['doc_parts']['conjunctiva']"/>\n                        </p>\n                      </div>\n                    </t>\n                  </div>\n                  <div class="pl-2 row">\n                    <div class="col-4">\n                      <p>Respirasi</p>\n                    </div>\n                    <t t-if="'respiratory' in data['doc_parts']">\n                      <div class="col-4">\n                        <p><span class="pr-2">:</span>\n                          <t t-esc="data['doc_parts']['respiratory']"/>\n                        </p>\n                      </div>\n                    </t>\n                  </div>\n                  <div class="pl-2 row">\n                    <div class="col-4">\n                      <p>Ekstremitas</p>\n                    </div>\n                    <t t-if="'extremities' in data['doc_parts']">\n                      <div class="col-4">\n                        <p><span class="pr-2">:</span>\n                          <t t-esc="data['doc_parts']['extremities']"/>\n                        </p>\n                      </div>\n                    </t>\n                  </div>\n                  <div class="pl-2 row">\n                    <div class="col-4">\n                      <p>Akses Vaskuler</p>\n                    </div>\n                    <t t-if="'procedure_hd' in data['doc_parts'] and 'akses-vaskuler' in data['doc_parts']['procedure_hd']">\n                      <div class="col-4">\n                        <p><span class="pr-2">:</span>\n                          <t t-esc="data['doc_parts']['procedure_hd']['akses-vaskuler']"/>\n                        </p>\n                      </div>\n                    </t>\n                  </div>\n                </div>\n              </div>\n              <div class="col-6">\n                <div>\n                  <div class="row">\n                    <div class="col-4">\n                      <p>Dialisat</p>\n                    </div>\n                    <t t-if="'procedure_hd' in data['doc_parts'] and 'dialisat' in data['doc_parts']['procedure_hd']">\n                      <div class="col-8">\n                        <p><span class="pr-2">:</span>\n                          <t t-esc="data['doc_parts']['procedure_hd']['dialisat']"/>\n                        </p>\n                      </div>\n                    </t>\n                  </div>\n                  <div class="row">\n                    <div class="col-4">\n                      <p>Volume Priming</p>\n                    </div>\n                    <t t-if="'procedure_hd' in data['doc_parts'] and 'volume-priming' in data['doc_parts']['procedure_hd']">\n                      <div class="col-8">\n                        <p><span class="pr-2">:</span>\n                          <t t-esc="data['doc_parts']['procedure_hd']['volume-priming']"/>\n                        </p>\n                      </div>\n                    </t>\n                  </div>\n                  <div class="row">\n                    <div class="col-4">\n                      <p>Heparinisasi</p>\n                    </div>\n                    <t t-if="'procedure_hd' in data['doc_parts'] and 'heparinisasi' in data['doc_parts']['procedure_hd']">\n                      <div class="col-8">\n                        <p><span class="pr-2">:</span>\n                          <t t-esc="data['doc_parts']['procedure_hd']['heparinisasi']"/>\n                        </p>\n                      </div>\n                    </t>\n                  </div>\n                  <div class="row">\n                    <div class="col-4">\n                      <p>- Dosis Awal</p>\n                    </div>\n                    <t t-if="'procedure_hd' in data['doc_parts'] and 'first-dose' in data['doc_parts']['procedure_hd']">\n                      <div class="col-8">\n                        <p><span class="pr-2">:</span>\n                          <t t-esc="data['doc_parts']['procedure_hd']['first-dose']"/> IU\n                        </p>\n                      </div>\n                    </t>\n                  </div>\n                  <div class="row">\n                    <div class="col-4">\n                      <p>- Dosis Pemeliharaan</p>\n                    </div>\n                    <t t-if="'procedure_hd' in data['doc_parts']">\n                      <div class="col-8">\n                        <p><span class="pr-2">:</span>\n                          <t t-if="'maintenance-dose' in data['doc_parts']['procedure_hd']">\n                            <t t-esc="data['doc_parts']['procedure_hd']['maintenance-dose']"/> IU\n                          </t>\n                            /\n                          <t t-if="'maintenance-dose-time' in data['doc_parts']['procedure_hd']">\n                            <t t-esc="data['doc_parts']['procedure_hd']['maintenance-dose-time']"/> jam\n                          </t>\n                        </p>\n                      </div>\n                    </t>\n                  </div>\n                  <div class="row">\n                    <div class="col-4">\n                      <p>- Dosis Sirkulasi</p>\n                    </div>\n                    <t t-if="'procedure_hd' in data['doc_parts'] and 'circulation-dose' in data['doc_parts']['procedure_hd']">\n                      <div class="col-8">\n                        <p><span class="pr-2">:</span>\n                          <t t-esc="data['doc_parts']['procedure_hd']['circulation-dose']"/> IU\n                        </p>\n                      </div>\n                    </t>\n                  </div>\n                </div>\n              </div>\n            </div>\n\n            <div class="row mt-2">\n              <div class="col-6">\n                <div>\n                  <div class="row">\n                    <div class="col-4">\n                      <p>3. Skala Nyeri</p>\n                    </div>\n                    <t t-if="'pain-scale' in data['doc_parts']">\n                      <div class="col-8">\n                        <p><span class="pr-2">:</span>\n                          <t t-esc="data['doc_parts']['pain-scale']"/>\n                        </p>\n                      </div>\n                    </t>\n                  </div>\n                  <div class="row mt-2">\n                    <div class="col-4">\n                      <p>4. Diagnosa Keperawatan</p>\n                    </div>\n                    <div class="col-8">\n                      <p/>\n                    </div>\n                  </div>\n                  <t t-if="'nurse_diagnose_on' in data['doc_parts']">\n                    <t t-foreach="data['doc_parts']['nurse_diagnose_on']" t-as="nurse_diagnose_on">\n                      <div class="pl-2 row">\n                        <div class="col-8">\n                          <p><span class="pr-1">-</span>\n                              <t t-esc="nurse_diagnose_on"/>\n                          </p>\n                        </div>\n                        <div class="col-4">\n                          <p/>\n                        </div>\n                      </div>\n                    </t>\n                  </t>\n                  <t t-if="'nurse_diagnose_post' in data['doc_parts']">\n                    <t t-foreach="data['doc_parts']['nurse_diagnose_post']" t-as="nurse_diagnose_post">\n                      <div class="pl-2 row">\n                        <div class="col-8">\n                          <p><span class="pr-1">-</span>\n                              <t t-esc="nurse_diagnose_post"/>\n                          </p>\n                        </div>\n                        <div class="col-4">\n                          <p/>\n                        </div>\n                      </div>\n                    </t>\n                  </t>\n                </div>\n              </div>\n              <div class="col-6">\n                <div>\n                  <div class="row">\n                    <div class="col-12">\n                      <p>5. Intervensi Keperawatan</p>\n                    </div>\n                  </div>\n                  <t t-if="'nurse_intervention_on' in data['doc_parts']">\n                    <t t-foreach="data['doc_parts']['nurse_intervention_on']" t-as="nurse_intervention_on">\n                      <div class="pl-2 row">\n                        <div class="col-12">\n                          <p><span class="pr-1">-</span>\n                              <t t-esc="nurse_intervention_on"/>\n                          </p>\n                        </div>\n                      </div>\n                    </t>\n                  </t>\n                  <t t-if="'nurse_intervention_post' in data['doc_parts']">\n                    <t t-foreach="data['doc_parts']['nurse_intervention_post']" t-as="nurse_intervention_post">\n                      <div class="pl-2 row">\n                        <div class="col-12">\n                          <p><span class="pr-1">-</span>\n                              <t t-esc="nurse_intervention_post"/>\n                          </p>\n                        </div>\n                      </div>\n                    </t>\n                  </t>\n                </div>\n              </div>\n            </div>\n\n            <div class="row mt-2">\n              <div class="col-6">\n                <div>\n                  <div class="row">\n                    <div class="col-12">\n                      <p>6. Intervensi Kolaborasi</p>\n                    </div>\n                  </div>\n                  <t t-if="'collaborative_intervention_on' in data['doc_parts']">\n                    <t t-foreach="data['doc_parts']['collaborative_intervention_on']" t-as="collaborative_intervention_on">\n                      <div class="pl-2 row">\n                        <div class="col-12">\n                          <p><span class="pr-1">-</span>\n                              <t t-esc="collaborative_intervention_on"/>\n                          </p>\n                        </div>\n                      </div>\n                    </t>\n                  </t>\n                  <t t-if="'collaborative_intervention_post' in data['doc_parts']">\n                    <t t-foreach="data['doc_parts']['collaborative_intervention_post']" t-as="collaborative_intervention_post">\n                      <div class="pl-2 row">\n                        <div class="col-12">\n                          <p><span class="pr-1">-</span>\n                              <t t-esc="collaborative_intervention_post"/>\n                          </p>\n                        </div>\n                      </div>\n                    </t>\n                  </t>\n                </div>\n              </div>\n              <div class="col-6">\n                <!-- <div>\n                  <div class="row">\n                    <div class="col-12">\n                      <p>5. Intervensi Keperawatan</p>\n                    </div>\n                  </div>\n                  <div class="row">\n                    <div class="col-12">\n                      <p>- Monitor berat badan, intake output, Atur posisi pasien agar ventilasi adekuat</p>\n                    </div>\n                  </div>\n                  <div class="row">\n                    <div class="col-12">\n                      <p>- Observasi pasien (monitor vital sign) dan mesin</p>\n                    </div>\n                  </div>\n                  <div class="row">\n                    <div class="col-12">\n                      <p>- Kaji kemampuan pasien mendapatkan nutrisi yang dibutuhkan</p>\n                    </div>\n                  </div>\n                </div> -->\n              </div>\n            </div>\n\n            <div class="row mt-2">\n              <div class="col-12">\n                <div>\n                  <div class="row">\n                    <div class="col-12">\n                      <p>7. Observasi Program Dialisis</p>\n                    </div>\n                  </div>\n                  <div class="pl-2 row">\n                    <div class="col-12">\n                      <table class="table table-bordered table-sm mt-3 mb-2">\n                        <tr class="text-center">\n                          <th>Waktu</th>\n                          <th>Qb<br/>(mL/menit)</th>\n                          <th>Tek. Arteri</th>\n                          <th>Tek. Vena</th>\n                          <th>TMP<br/>(mmHg)</th>\n                          <th>UF<br/>(mL)</th>\n                          <th>Tek. Darah</th>\n                          <th>Nadi</th>\n                          <th>Catatan Tindakan</th>\n                        </tr>\n                        <t t-if="'dialysis_obs_on' in data['doc_parts']">\n                          <t t-foreach="data['doc_parts']['dialysis_obs_on']" t-as="dialysis_obs_on">\n                            <tr>\n                              <td>\n                                <t t-if="'obs_time' in dialysis_obs_on">\n                                  <t t-esc="dialysis_obs_on['obs_time']"/>\n                                </t>\n                              </td>\n                              <td>\n                                <t t-if="'qb' in dialysis_obs_on">\n                                  <t t-esc="dialysis_obs_on['qb']"/>\n                                </t>\n                              </td>\n                              <td>\n                                <t t-if="'arteri' in dialysis_obs_on">\n                                  <t t-esc="dialysis_obs_on['arteri']"/>\n                                </t>\n                              </td>\n                              <td>\n                                <t t-if="'vena' in dialysis_obs_on">\n                                  <t t-esc="dialysis_obs_on['vena']"/>\n                                </t>\n                              </td>\n                              <td>\n                                <t t-if="'tmp' in dialysis_obs_on">\n                                  <t t-esc="dialysis_obs_on['tmp']"/>\n                                </t>\n                              </td>\n                              <td>\n                                <t t-if="'uf' in dialysis_obs_on">\n                                  <t t-esc="dialysis_obs_on['uf']"/>\n                                </t>\n                              </td>\n                              <td>\n                                <t t-if="'sistole' in dialysis_obs_on">\n                                  <t t-esc="dialysis_obs_on['sistole']"/>\n                                </t>\n                                /\n                                <t t-if="'diastole' in dialysis_obs_on">\n                                  <t t-esc="dialysis_obs_on['diastole']"/>\n                                </t>\n                              </td>\n                              <td>\n                                <t t-if="'nadi' in dialysis_obs_on">\n                                  <t t-esc="dialysis_obs_on['nadi']"/>\n                                </t>\n                              </td>\n                              <td>\n                                <t t-if="'note' in dialysis_obs_on">\n                                  <t t-esc="dialysis_obs_on['note']"/>\n                                </t>\n                              </td>\n                            </tr>\n                          </t>\n                        </t>\n                      </table>\n                    </div>\n                  </div>\n                </div>\n              </div>\n            </div>\n            <div class="pl-2 row mt-2">\n              <div class="col-6">\n                <p class="mb-0">Cairan masuk selama HD:</p>\n                <div>\n                  <div class="row">\n                    <div class="col-4">\n                      <p>Sisa priming</p>\n                    </div>\n                    <t t-if="'sisa_priming' in data['doc_parts']">\n                      <div class="col-8">\n                        <p><span class="pr-2">:</span>\n                          <t t-esc="data['doc_parts']['sisa_priming']"/> <span class="pl-1">mL</span>\n                        </p>\n                      </div>\n                    </t>\n                  </div>\n                  <div class="row">\n                    <div class="col-4">\n                      <p>Infus/Drip/Tranfusi</p>\n                    </div>\n                    <t t-if="'infus_drip_transfusi' in data['doc_parts']">\n                      <div class="col-8">\n                        <p><span class="pr-2">:</span>\n                          <t t-esc="data['doc_parts']['infus_drip_transfusi']"/> <span class="pl-1">mL</span>\n                        </p>\n                      </div>\n                    </t>\n                  </div>\n                  <div class="row">\n                    <div class="col-4">\n                      <p>Wash out</p>\n                    </div>\n                    <t t-if="'wash_out' in data['doc_parts']">\n                      <div class="col-8">\n                        <p><span class="pr-2">:</span>\n                          <t t-esc="data['doc_parts']['wash_out']"/> <span class="pl-1">mL</span>\n                        </p>\n                      </div>\n                    </t>\n                  </div>\n                  <div class="row">\n                    <div class="col-4">\n                      <p>Minum</p>\n                    </div>\n                    <t t-if="'minum' in data['doc_parts']">\n                      <div class="col-8">\n                        <p><span class="pr-2">:</span>\n                          <t t-esc="data['doc_parts']['minum']"/> <span class="pl-1">mL</span>\n                        </p>\n                      </div>\n                    </t>\n                  </div>\n                  <div class="row">\n                    <div class="col-4">\n                      <p>JUMLAH</p>\n                    </div>\n                    <t t-if="'total_fluid_intake' in data['doc_parts']">\n                      <div class="col-8">\n                        <p><span class="pr-2">:</span>\n                          <t t-esc="data['doc_parts']['total_fluid_intake']"/> <span class="pl-1">mL</span>\n                        </p>\n                      </div>\n                    </t>\n                  </div>\n                </div>\n              </div>\n              <div class="col-6">\n                <p class="mb-0">Cairan keluar selama HD:</p>\n                <div>\n                  <div class="row">\n                    <div class="col-4">\n                      <p>Urine</p>\n                    </div>\n                    <t t-if="'urine' in data['doc_parts']">\n                      <div class="col-8">\n                        <p><span class="pr-2">:</span>\n                          <t t-esc="data['doc_parts']['urine']"/> <span class="pl-1">cc</span>\n                        </p>\n                      </div>\n                    </t>\n                  </div>\n                  <div class="row">\n                    <div class="col-4">\n                      <p>Muntah</p>\n                    </div>\n                    <t t-if="'muntah' in data['doc_parts']">\n                      <div class="col-8">\n                        <p><span class="pr-2">:</span>\n                          <t t-esc="data['doc_parts']['muntah']"/> <span class="pl-1">cc</span>\n                        </p>\n                      </div>\n                    </t>\n                  </div>\n                  <div class="row">\n                    <div class="col-4">\n                      <p>Perdarahan</p>\n                    </div>\n                    <t t-if="'pendarahan' in data['doc_parts']">\n                      <div class="col-8">\n                        <p><span class="pr-2">:</span>\n                          <t t-esc="data['doc_parts']['pendarahan']"/> <span class="pl-1">cc</span>\n                        </p>\n                      </div>\n                    </t>\n                  </div>\n                </div>\n              </div>\n            </div>\n\n            <div class="row mt-2">\n              <div class="col-12">\n                <div>\n                  <div class="row">\n                    <div class="col-12">\n                      <p>8. Evaluasi Keperawatan</p>\n                    </div>\n                  </div>\n                  <div class="pl-2 row">\n                    <div class="col-12">\n                      <table class="table table-bordered table-sm mt-3 mb-2">\n                        <tr>\n                          <td colspan="4">\n                            <t t-if="'nurse_evaluation' in data['doc_parts']">\n                              <t t-foreach="data['doc_parts']['nurse_evaluation']" t-as="nurse_evaluation">\n                                - <t t-esc="nurse_evaluation"/>\n                              </t>\n                            </t>\n                          </td>\n                        </tr>\n                        <tr class="text-center">\n                          <td>Inisiasi</td>\n                          <td>Terminasi</td>\n                          <td>Tindakan Medis</td>\n                          <td>Obat-obatan</td>\n                        </tr>\n                        <tr class="text-center">\n                          <td><br/><br/><br/>(Nama Perawat)</td>\n                          <td><br/><br/><br/>(Nama Perawat)</td>\n                          <td><br/><br/><br/>(Pasien / Keluarga Pasien)</td>\n                          <td><br/><br/><br/>(Pasien / Keluarga Pasien)</td>\n                        </tr>\n                      </table>\n                    </div>\n                  </div>\n                </div>\n              </div>\n            </div>\n\n            <div class="row mt-2">\n              <div class="col-12">\n                <div>\n                  <div class="row">\n                    <div class="col-12">\n                      <p>9. Evaluasi Medik</p>\n                    </div>\n                  </div>\n                  <div class="pl-2 row">\n                    <div class="col-12">\n                      <table class="table table-bordered table-sm mt-3 mb-2">\n                        <tr class="text-center">\n                          <td>Catatan Medik</td>\n                          <td>Ttd &amp; Nama Dokter</td>\n                        </tr>\n                        <tr>\n                          <td>\n                            <t t-if="'medical_evaluation' in data['doc_parts']">\n                              <t t-foreach="data['doc_parts']['medical_evaluation']" t-as="medical_evaluation">\n                                - <t t-esc="medical_evaluation"/>\n                              </t>\n                            </t>\n                          </td>\n                          <td><br/><br/><br/></td>\n                        </tr>\n                      </table>\n                    </div>\n                  </div>\n                </div>\n              </div>\n            </div>\n\n            <!-- <div class="row pt-5">\n                <div class="col-8"></div>\n                <div class="col-4">\n                    <p class="mb-0"><t t-esc="o['operating_unit_id']['company_id']['city']"/>, <t t-esc="o.to_date_string(data['registration_date'])"/></p>\n                    <p class="mb-0">Dokter Penanggungjawab</p>\n                    <img t-att-src="o['qr_code_url']" style="width:125px;height:125px;"/>\n                    <p class="mb-0 mt-2"><strong><t t-esc="data['sender']"/></strong></p>\n                </div>\n            </div> -->\n          </div>\n        </t>\n      </t>\n    	ehealth_document/report/template_hemodialisis/report_default_hemodialisis.xml	\N	\N	\N	\N	primary	t	1	2025-08-28 11:34:01.364376	1	2025-08-28 11:34:01.364376	f
1659	report_diatrans_hemodialisis	\N	ehealth_document.report_diatrans_hemodialisis	16	qweb	<?xml version="1.0"?>\n<t t-name="ehealth_document.report_diatrans_hemodialisis">\n        <t t-set="company" t-value="res_company"/>\n        <t t-call="ehealth_document.header_diatrans_document">\n          <div class="page" style="font-size: 14px;">\n            <div class="col-md-12 text-right">\n              <p><span class="pr-2">No. RM :</span> <t t-esc="o['partner_id']['medical_record']"/></p>\n            </div>\n            <div>\n              <p class="text-center pt-2 mb-0" style="text-decoration: underline;"><strong>STATUS HEMODIALISIS HARIAN</strong></p>\n              <p class="text-center"><strong>(Catatan Perkembangan Pasien Terintegrasi)</strong></p>\n            </div>\n            <div class="row mt-1" style="border-bottom: 2px solid #000;">\n              <div class="col-6 mb-1">\n                <div>\n                  <div class="row pt-3">\n                    <div class="col-4">\n                      <p>Nama</p>\n                    </div>\n                    <div class="col-8">\n                      <p><span class="pr-2">:</span> <t t-esc="o['partner_id']['name']"/></p>\n                    </div>\n                  </div>\n                  <div class="row">\n                    <div class="col-4">\n                      <p>Umur</p>\n                    </div>\n                    <div class="col-8">\n                      <p><span class="pr-2">:</span> <t t-esc="o.count_age(o['partner_id']['birthDate'].strftime('%d/%m/%Y'))"/> tahun</p>\n                    </div>\n                  </div>\n                  <div class="row">\n                    <div class="col-4">\n                      <p>BB Kering (DW)</p>\n                    </div>\n                    <t t-if="'vital_sign_pre' in data['doc_parts']">\n                      <div class="col-8">\n                        <p><span class="pr-2">:</span>\n                          <t t-if="'bb-kering' in data['doc_parts']['vital_sign_pre']">\n                            <t t-esc="data['doc_parts']['vital_sign_pre']['bb-kering']"/> kg\n                          </t>\n                        </p>\n                      </div>\n                    </t>\n                  </div>\n                  <div class="row">\n                    <div class="col-4">\n                      <p>BB HD Terakhir</p>\n                    </div>\n                    <t t-if="'vital_sign_pre' in data['doc_parts']">\n                      <div class="col-8">\n                        <p><span class="pr-2">:</span>\n                          <t t-if="'bb-terakhir' in data['doc_parts']['vital_sign_pre']">\n                            <t t-esc="data['doc_parts']['vital_sign_pre']['bb-terakhir']"/> kg\n                          </t>\n                        </p>\n                      </div>\n                    </t>\n                  </div>\n                </div>\n              </div>\n              <div class="col-6">\n                <div>\n                  <div class="row">\n                    <div class="col-3">\n                      <p>Tanggal</p>\n                    </div>\n                    <div class="col-8">\n                      <p><span class="pr-2">:</span> <t t-esc="o.to_date_string(data['registration_date'])"/></p>\n                    </div>\n                  </div>\n                  <div class="row">\n                    <div class="col-3">\n                      <p>HD ke</p>\n                    </div>\n                    <div class="col-8">\n                      <p><span class="pr-2">:</span>\n                        <t t-if="'procedure_hd' in data['doc_parts'] and 'hd_sequence' in data['doc_parts']['procedure_hd']">\n                          <t t-esc="data['doc_parts']['procedure_hd']['hd_sequence']"/>\n                        </t>\n                      </p>\n                    </div>\n                  </div>\n                  <div class="row">\n                    <div class="col-3">\n                      <p>Lama HD</p>\n                    </div>\n                    <t t-if="'procedure_hd' in data['doc_parts']">\n                      <div class="col-8">\n                        <p><span class="pr-2">:</span>\n                          <t t-esc="data['doc_parts']['procedure_hd']['lama-hd']"/> jam\n                        </p>\n                      </div>\n                    </t>\n                  </div>\n                  <div class="row">\n                    <div class="col-3">\n                      <p>UFG</p>\n                    </div>\n                    <t t-if="'procedure_hd' in data['doc_parts']">\n                      <div class="col-8">\n                        <p><span class="pr-2">:</span>\n                          <t t-esc="data['doc_parts']['procedure_hd']['ufg']"/> mL\n                        </p>\n                      </div>\n                    </t>\n                  </div>\n                  <div class="row">\n                    <div class="col-3">\n                      <p>Mulai HD</p>\n                    </div>\n                    <div class="col-8">\n                      <p><span class="pr-2">:</span>\n                        <t t-if="'procedure_hd' in data['doc_parts'] and 'start_hd' in data['doc_parts']['procedure_hd']">\n                          <t t-esc="data['doc_parts']['procedure_hd']['start_hd']"/>\n                        </t>\n                        <span class="ml-1 mr-1">Selesai</span>\n                        <t t-if="'procedure_hd' in data['doc_parts'] and 'end_hd' in data['doc_parts']['procedure_hd']">\n                          <t t-esc="data['doc_parts']['procedure_hd']['end_hd']"/>\n                        </t>\n                        <span class="ml-1">WIB</span>\n                      </p>\n                    </div>\n                  </div>\n                </div>\n              </div>\n              <div class="pt-1" style="border-bottom: 6px solid #000;"/>\n            </div>\n\n            <div class="row mt-2">\n              <div class="col-6">\n                <div>\n                  <div class="row mt-2">\n                    <div class="col-4">\n                      <p>PEMERIKSAAN</p>\n                    </div>\n                    <div class="col-4">\n                      <p class="pl-3">Pre HD</p>\n                    </div>\n                    <div class="col-4">\n                      <p>Pasca HD</p>\n                    </div>\n                  </div>\n                  <div class="row" style="overflow-wrap: break-word;">\n                    <div class="col-4">\n                      <p>Keadaan Umum / Kesadaran</p>\n                    </div>\n                    <div class="col-4">\n                      <p><span class="pr-2">:</span>\n                        <t t-if="'general_condition_pre' in data['doc_parts']">\n                          <t t-esc="data['doc_parts']['general_condition_pre']"/>\n                        </t>/<t t-if="'vital_sign_pre' in data['doc_parts'] and 'consciousness' in data['doc_parts']['vital_sign_pre']">\n                          <t t-esc="data['doc_parts']['vital_sign_pre']['consciousness']"/>\n                       </t>\n                      </p>\n                    </div>\n                    <div class="col-4">\n                      <p>\n                        <t t-if="'general_condition_post' in data['doc_parts']">\n                          <t t-esc="data['doc_parts']['general_condition_post']"/>\n                        </t>/<t t-if="'vital_sign_post' in data['doc_parts'] and 'consciousness' in data['doc_parts']['vital_sign_post']">\n                          <t t-esc="data['doc_parts']['vital_sign_post']['consciousness']"/>\n                       </t>\n                      </p>\n                    </div>\n                  </div>\n                  <div class="row">\n                    <div class="col-4">\n                      <p>Tekanan Darah</p>\n                    </div>\n                    <t t-if="'vital_sign_pre' in data['doc_parts']">\n                      <div class="col-4">\n                        <p><span class="pr-2">:</span>\n                          <t t-if="'sistole' in data['doc_parts']['vital_sign_pre']">\n                            <t t-esc="data['doc_parts']['vital_sign_pre']['sistole']"/>\n                          </t>\n                          /\n                          <t t-if="'diastole' in data['doc_parts']['vital_sign_pre']">\n                            <t t-esc="data['doc_parts']['vital_sign_pre']['diastole']"/>\n                          </t> mmHg\n                        </p>\n                      </div>\n                    </t>\n                    <t t-if="'vital_sign_post' in data['doc_parts']">\n                      <div class="col-4">\n                        <p>\n                          <t t-if="'sistole' in data['doc_parts']['vital_sign_post']">\n                            <t t-esc="data['doc_parts']['vital_sign_post']['sistole']"/>\n                          </t>\n                          /\n                          <t t-if="'diastole' in data['doc_parts']['vital_sign_post']">\n                            <t t-esc="data['doc_parts']['vital_sign_post']['diastole']"/>\n                          </t> mmHg\n                        </p>\n                      </div>\n                    </t>\n                  </div>\n                  <div class="row">\n                    <div class="col-4">\n                      <p>Nadi</p>\n                    </div>\n                    <div class="col-4">\n                      <p><span class="pr-2">:</span>\n                        <t t-if="'vital_sign_pre' in data['doc_parts'] and 'nadi' in data['doc_parts']['vital_sign_pre']">\n                          <t t-esc="data['doc_parts']['vital_sign_pre']['nadi']"/> x/mnt\n                        </t>\n                      </p>\n                    </div>\n                    <div class="col-4">\n                      <p>\n                        <t t-if="'vital_sign_post' in data['doc_parts'] and 'nadi' in data['doc_parts']['vital_sign_post']">\n                          <t t-esc="data['doc_parts']['vital_sign_post']['nadi']"/> x/mnt\n                        </t>\n                      </p>\n                    </div>\n                  </div>\n                  <div class="row">\n                    <div class="col-4">\n                      <p>Suhu</p>\n                    </div>\n                    <div class="col-4">\n                      <p><span class="pr-2">:</span>\n                        <t t-if="'vital_sign_pre' in data['doc_parts'] and 'suhu' in data['doc_parts']['vital_sign_pre']">\n                          <t t-esc="data['doc_parts']['vital_sign_pre']['suhu']"/> °C\n                        </t>\n                      </p>\n                    </div>\n                    <div class="col-4">\n                      <p>\n                        <t t-if="'vital_sign_post' in data['doc_parts'] and 'suhu' in data['doc_parts']['vital_sign_post']">\n                          <t t-esc="data['doc_parts']['vital_sign_post']['suhu']"/> °C\n                        </t>\n                      </p>\n                    </div>\n                  </div>\n                  <div class="row">\n                    <div class="col-4">\n                      <p>Respirasi</p>\n                    </div>\n                    <t t-if="'vital_sign_pre' in data['doc_parts'] and 'respirasi' in data['doc_parts']['vital_sign_pre']">\n                      <div class="col-4">\n                        <p><span class="pr-2">:</span>\n                          <t t-esc="data['doc_parts']['vital_sign_pre']['respirasi']"/> x/mnt\n                        </p>\n                      </div>\n                    </t>\n                    <t t-if="'vital_sign_post' in data['doc_parts'] and 'respirasi' in data['doc_parts']['vital_sign_post']">\n                      <div class="col-4">\n                        <p>\n                          <t t-esc="data['doc_parts']['vital_sign_post']['respirasi']"/> x/mnt\n                        </p>\n                      </div>\n                    </t>\n                  </div>\n                  <div class="row">\n                    <div class="col-4">\n                      <p>Berat Badan</p>\n                    </div>\n                    <t t-if="'vital_sign_pre' in data['doc_parts'] and 'berat-badan' in data['doc_parts']['vital_sign_pre']">\n                      <div class="col-4">\n                        <p><span class="pr-2">:</span>\n                          <t t-esc="data['doc_parts']['vital_sign_pre']['berat-badan']"/> kg\n                        </p>\n                      </div>\n                    </t>\n                    <t t-if="'vital_sign_post' in data['doc_parts'] and 'berat-badan' in data['doc_parts']['vital_sign_post']">\n                      <div class="col-4">\n                        <p>\n                          <t t-esc="data['doc_parts']['vital_sign_post']['berat-badan']"/> kg\n                        </p>\n                      </div>\n                    </t>\n                  </div>\n                  <div class="row">\n                    <div class="col-4">\n                      <p style="overflow-wrap: break-word;">Penambahan / Pengurangan</p>\n                    </div>\n                    <t t-if="'vital_sign_pre' in data['doc_parts'] and 'penambahan-bb' in data['doc_parts']['vital_sign_pre']">\n                      <div class="col-4">\n                        <p><span class="pr-2">:</span>\n                          <t t-esc="data['doc_parts']['vital_sign_pre']['penambahan-bb']"/> kg\n                        </p>\n                      </div>\n                    </t>\n                    <t t-if="'vital_sign_post' in data['doc_parts'] and 'penambahan-bb' in data['doc_parts']['vital_sign_post']">\n                      <div cla
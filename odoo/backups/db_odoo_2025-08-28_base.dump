832	product.template_procurement	product.template	\N	16	form	<?xml version="1.0"?>\n<data>\n                    <header position="inside">\n                        <button string="Update Quantity" type="object" groups="stock.group_stock_manager" name="action_update_quantity_on_hand" attrs="{'invisible': [('show_on_hand_qty_status_button', '=', False)]}"/>\n                        <button string="Replenish" type="action" name="295" context="{'default_product_tmpl_id': id}" groups="stock.group_stock_user" attrs="{'invisible': [('show_on_hand_qty_status_button', '=', False)]}"/>\n                    </header>\n                    <div name="button_box" position="inside">\n                        <field name="show_on_hand_qty_status_button" invisible="1"/>\n                        <button type="object" name="action_open_quants" attrs="{'invisible':[('show_on_hand_qty_status_button', '=', False)]}" class="oe_stat_button" icon="fa-cubes">\n                            <div class="o_field_widget o_stat_info">\n                                <span class="o_stat_value" widget="statinfo">\n                                    <field name="qty_available" widget="statinfo" nolabel="1" class="mr4"/>\n                                    <field name="uom_name"/>\n                                </span>\n                                <span class="o_stat_text">On Hand</span>\n                            </div>\n                        </button>\n                        <button type="object" name="action_product_tmpl_forecast_report" attrs="{'invisible':[('show_on_hand_qty_status_button', '=', False)]}" context="{'default_product_tmpl_id': id}" class="oe_stat_button" icon="fa-cubes">\n                            <div class="o_field_widget o_stat_info">\n                                <span class="o_stat_value">\n                                    <field name="virtual_available" widget="statinfo" nolabel="1" class="mr4"/>\n                                    <field name="uom_name"/>\n                                </span>\n                                <span class="o_stat_text">Forecasted</span>\n                            </div>\n                        </button>\n                        <button string="Product Moves" type="object" name="action_view_stock_move_lines" attrs="{'invisible':[('type', 'not in', ['product', 'consu'])]}" class="oe_stat_button" icon="fa-exchange" groups="stock.group_stock_user"/>\n                        <button type="object" name="action_view_orderpoints" attrs="{'invisible':['|',('show_on_hand_qty_status_button', '=', False),('nbr_reordering_rules', '!=', 1)]}" class="oe_stat_button" icon="fa-refresh">\n                            <div class="o_field_widget o_stat_info mr4">\n                                <span class="o_stat_text">Min:</span>\n                                <span class="o_stat_text">Max:</span>\n                            </div>\n                            <div class="o_field_widget o_stat_info">\n                                <span class="o_stat_value"><field name="reordering_min_qty"/></span>\n                                <span class="o_stat_value"><field name="reordering_max_qty"/></span>\n                            </div>\n                        </button>\n                        <button type="object" name="action_view_orderpoints" attrs="{'invisible':['|',('show_on_hand_qty_status_button', '=', False),('nbr_reordering_rules', '==', 1)]}" class="oe_stat_button" icon="fa-refresh">\n                            <field name="nbr_reordering_rules" widget="statinfo"/>\n                         </button>\n                        <button string="Lot/Serial Numbers" type="object" name="action_open_product_lot" attrs="{'invisible': [('tracking', '=', 'none')]}" class="oe_stat_button" icon="fa-bars" groups="stock.group_production_lot"/>\n                        <button string="Putaway Rules" type="object" name="action_view_related_putaway_rules" class="oe_stat_button" icon="fa-random" groups="stock.group_stock_multi_locations" attrs="{'invisible': [('type', '=', 'service')]}" context="{                                 'invisible_handle': True,                                 'single_product': product_variant_count == 1,                             }"/>\n                    </div>\n\n                    <!-- change attrs of fields added in view_template_property_form\n                    to restrict the display for templates -->\n                    <xpath expr="//group[@name='group_lots_and_weight']" position="attributes">\n                        <attribute name="attrs">{'invisible': [('type', 'not in', ['product', 'consu'])]}</attribute>\n                    </xpath>\n\n                    <xpath expr="//label[@for='weight']" position="before">\n                        <field name="responsible_id" domain="[('share', '=', False)]"/>\n                    </xpath>\n                </data>\n            	stock/views/product_views.xml	\N	\N	476	\N	extension	t	1	2025-08-28 11:32:42.235962	1	2025-08-28 11:32:42.235962	f
1703	ubl_20_AddressType	\N	account_edi_ubl_cii.ubl_20_AddressType	16	qweb	<?xml version="1.0"?>\n<t t-name="account_edi_ubl_cii.ubl_20_AddressType">\n        <t xmlns="urn:oasis:names:specification:ubl:schema:xsd:Invoice-2" xmlns:cac="urn:oasis:names:specification:ubl:schema:xsd:CommonAggregateComponents-2" xmlns:cbc="urn:oasis:names:specification:ubl:schema:xsd:CommonBasicComponents-2">\n            <cbc:StreetName t-esc="vals.get('street_name')"/>\n            <cbc:AdditionalStreetName t-esc="vals.get('additional_street_name')"/>\n            <cbc:CityName t-esc="vals.get('city_name')"/>\n            <cbc:PostalZone t-esc="vals.get('postal_zone')"/>\n            <cbc:CountrySubentity t-esc="vals.get('country_subentity')"/>\n            <cbc:CountrySubentityCode t-esc="vals.get('country_subentity_code')"/>\n            <cac:Country>\n                <t t-set="country_vals" t-value="vals.get('country_vals', {})"/>\n                <cbc:IdentificationCode t-att="country_vals.get('identification_code_attrs', {})" t-esc="country_vals.get('identification_code')"/>\n                <cbc:Name t-esc="country_vals.get('name')"/>\n            </cac:Country>\n        </t>\n    </t>\n\n    	account_edi_ubl_cii/data/ubl_20_templates.xml	\N	\N	\N	\N	primary	t	1	2025-08-28 11:34:13.779942	1	2025-08-28 11:34:13.779942	f
833	stock.production.lot.form	stock.production.lot	\N	10	form	<?xml version="1.0"?>\n<form string="Lots/Serial Numbers">\n                <sheet>\n                <field name="display_complete" invisible="1"/>\n                <div class="oe_button_box" name="button_box" attrs="{'invisible': [('display_complete', '=', False)]}">\n                        <button name="action_lot_open_quants" icon="fa-arrows" class="oe_stat_button" string="Location" type="object"/>\n                        <button name="265" icon="fa-arrow-up" class="oe_stat_button" string="Traceability" type="action"/>\n                </div>\n                <div class="oe_title">\n                    <label for="name" class="oe_edit_only"/>\n                    <h1>\n                        <field name="name" placeholder="e.g. LOT/0001/20121"/>\n                    </h1>\n                </div>\n                <group name="main_group">\n                    <group>\n                        <field name="product_id" context="{'default_type': 'product'}" readonly="context.get('set_product_readonly', False)" force_save="1" help="Product this lot/serial number contains. You cannot change it anymore if it has already been moved."/>\n                        <label for="product_qty" attrs="{'invisible': [('display_complete', '=', False)]}"/>\n                        <div class="o_row" attrs="{'invisible': [('display_complete', '=', False)]}">\n                            <field name="product_qty"/>\n                            <field name="product_uom_id" readonly="1" groups="uom.group_uom"/>\n                        </div>\n                        <field name="ref"/>\n                        <field name="company_id" groups="base.group_multi_company"/>\n                    </group>\n                    <group/>\n                </group>\n                <notebook attrs="{'invisible': [('display_complete', '=', False)]}">\n                    <page string="Description" name="description">\n                        <field name="note"/>\n                    </page>\n                </notebook>\n                </sheet>\n                <div class="oe_chatter">\n                    <field name="message_follower_ids"/>\n                    <field name="activity_ids"/>\n                    <field name="message_ids"/>\n                </div>\n            </form>\n        	stock/views/stock_production_lot_views.xml	\N	\N	\N	\N	primary	t	1	2025-08-28 11:32:42.235962	1	2025-08-28 11:32:42.235962	f
1704	ubl_20_PartyType	\N	account_edi_ubl_cii.ubl_20_PartyType	16	qweb	<?xml version="1.0"?>\n<t t-name="account_edi_ubl_cii.ubl_20_PartyType">\n        <t xmlns="urn:oasis:names:specification:ubl:schema:xsd:Invoice-2" xmlns:cac="urn:oasis:names:specification:ubl:schema:xsd:CommonAggregateComponents-2" xmlns:cbc="urn:oasis:names:specification:ubl:schema:xsd:CommonBasicComponents-2">\n            <t t-set="partner" t-value="vals.get('partner') or builder.env['res.partner']"/>\n            <cbc:EndpointID t-att="vals.get('endpoint_id_attrs', {})" t-esc="vals.get('endpoint_id')"/>\n            <t t-foreach="vals.get('party_identification_vals', [])" t-as="party_vals">\n                <cac:PartyIdentification>\n                    <cbc:ID t-att="party_vals.get('id_attrs', {})" t-esc="party_vals.get('id')"/>\n                </cac:PartyIdentification>\n            </t>\n            <t t-foreach="vals.get('party_name_vals', [])" t-as="party_vals">\n                <cac:PartyName>\n                    <cbc:Name t-esc="party_vals.get('name')"/>\n                </cac:PartyName>\n            </t>\n            <cac:PostalAddress>\n                <t t-call="{{AddressType_template}}">\n                    <t t-set="vals" t-value="vals.get('postal_address_vals', {})"/>\n                </t>\n            </cac:PostalAddress>\n            <t t-foreach="vals.get('party_tax_scheme_vals', [])" t-as="foreach_vals">\n                <cac:PartyTaxScheme>\n                    <cbc:RegistrationName t-esc="foreach_vals.get('registration_name')"/>\n                    <cbc:CompanyID t-att="foreach_vals.get('company_id_attrs', {})" t-esc="foreach_vals.get('company_id')"/>\n                    <cac:RegistrationAddress>\n                        <t t-call="{{AddressType_template}}">\n                            <t t-set="vals" t-value="foreach_vals.get('registration_address_vals', {})"/>\n                        </t>\n                    </cac:RegistrationAddress>\n                    <cac:TaxScheme>\n                        <cbc:ID t-esc="foreach_vals.get('tax_scheme_id')"/>\n                    </cac:TaxScheme>\n                </cac:PartyTaxScheme>\n            </t>\n\n            <t t-foreach="vals.get('party_legal_entity_vals', [])" t-as="foreach_vals">\n                <cac:PartyLegalEntity>\n                    <cbc:RegistrationName t-esc="foreach_vals.get('registration_name')"/>\n                    <cbc:CompanyID t-att="foreach_vals.get('company_id_attrs', {})" t-esc="foreach_vals.get('company_id')"/>\n                    <cac:RegistrationAddress>\n                        <t t-call="{{AddressType_template}}">\n                            <t t-set="vals" t-value="foreach_vals.get('registration_address_vals', {})"/>\n                        </t>\n                    </cac:RegistrationAddress>\n                </cac:PartyLegalEntity>\n            </t>\n            <cac:Contact>\n                <t t-set="contact_vals" t-value="vals.get('contact_vals', {})"/>\n                <cbc:ID t-esc="contact_vals.get('id')"/>\n                <cbc:Name t-esc="contact_vals.get('name')"/>\n                <cbc:Telephone t-esc="contact_vals.get('telephone')"/>\n                <cbc:ElectronicMail t-esc="contact_vals.get('electronic_mail')"/>\n            </cac:Contact>\n        </t>\n    </t>\n\n    	account_edi_ubl_cii/data/ubl_20_templates.xml	\N	\N	\N	\N	primary	t	1	2025-08-28 11:34:13.779942	1	2025-08-28 11:34:13.779942	f

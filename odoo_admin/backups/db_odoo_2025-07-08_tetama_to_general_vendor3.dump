911	export_ubl_invoice_line	\N	account_edi_ubl.export_ubl_invoice_line	16	qweb	<?xml version="1.0"?>\n<t t-name="account_edi_ubl.export_ubl_invoice_line">\n            <cac:InvoiceLine xmlns="urn:oasis:names:specification:ubl:schema:xsd:Invoice-2" xmlns:cac="urn:oasis:names:specification:ubl:schema:xsd:CommonAggregateComponents-2" xmlns:cbc="urn:oasis:names:specification:ubl:schema:xsd:CommonBasicComponents-2">\n                <cbc:ID t-esc="line._origin.id"/>\n                <cbc:Note t-if="line.discount">Discount (<t t-esc="line.discount"/> %)</cbc:Note>\n                <cbc:InvoicedQuantity t-esc="line.quantity"/>\n                <cbc:LineExtensionAmount t-att-currencyID="line.currency_id.name or invoice.currency_id.name" t-esc="format_monetary(line.price_subtotal)"/>\n                <cac:TaxTotal t-foreach="line.tax_ids.compute_all(line.price_unit, quantity=line.quantity, product=line.product_id, partner=invoice.partner_id)['taxes']" t-as="tax">\n                    <cbc:TaxAmount t-att-currencyID="line.currency_id.name or invoice.currency_id.name" t-esc="format_monetary(tax['amount'])"/>\n                </cac:TaxTotal>\n                <cac:Item>\n                    <cbc:Description t-if="line.name" t-esc="line.name.replace('\\n', ', ')"/>\n                    <cbc:Name t-esc="line.product_id.name"/>\n                    <cac:SellersItemIdentification t-if="line.product_id.default_code">\n                        <cbc:ID t-esc="line.product_id.default_code"/>\n                    </cac:SellersItemIdentification>\n                </cac:Item>\n                <cac:Price>\n                    <cbc:PriceAmount t-att-currencyID="line.currency_id.name or invoice.currency_id.name" t-esc="format_monetary(line.price_unit)"/>\n                </cac:Price>\n            </cac:InvoiceLine>\n        </t>\n\n        	account_edi_ubl/data/ubl_templates.xml	\N	\N	\N	\N	primary	t	1	2025-06-10 03:56:16.843857	1	2025-06-10 03:56:16.843857	f
912	export_ubl_invoice	\N	account_edi_ubl.export_ubl_invoice	16	qweb	<?xml version="1.0"?>\n<t t-name="account_edi_ubl.export_ubl_invoice">\n            <Invoice xmlns="urn:oasis:names:specification:ubl:schema:xsd:Invoice-2" xmlns:cac="urn:oasis:names:specification:ubl:schema:xsd:CommonAggregateComponents-2" xmlns:cbc="urn:oasis:names:specification:ubl:schema:xsd:CommonBasicComponents-2">\n                <cbc:UBLVersionID t-esc="ubl_version"/>\n                <cbc:ID t-esc="invoice.name"/>\n                <cbc:IssueDate t-esc="invoice.invoice_date"/>\n                <cbc:InvoiceTypeCode t-esc="type_code"/>\n                <cbc:Note t-esc="invoice.narration"/>\n                <cbc:DocumentCurrencyCode t-esc="invoice.currency_id.name"/>\n                <cac:AccountingSupplierParty t-call="account_edi_ubl.export_ubl_invoice_partner">\n                    <t t-set="partner" t-value="invoice.company_id.partner_id.commercial_partner_id"/>\n                </cac:AccountingSupplierParty>\n                <cac:AccountingCustomerParty t-call="account_edi_ubl.export_ubl_invoice_partner">\n                    <t t-set="partner" t-value="invoice.commercial_partner_id"/>\n                </cac:AccountingCustomerParty>\n                <cac:PaymentMeans>\n                    <cbc:PaymentMeansCode listID="UN/ECE 4461" t-esc="payment_means_code"/>\n                    <cbc:PaymentDueDate t-esc="invoice.invoice_date_due"/>\n                    <cac:PayeeFinancialAccount t-if="invoice.journal_id.bank_account_id">\n                        <cbc:ID schemeName="IBAN" t-esc="invoice.journal_id.bank_account_id.acc_number"/>\n                        <cac:FinancialInstitutionBranch t-if="invoice.journal_id.bank_account_id.bank_bic">\n                            <cac:FinancialInstitution>\n                                <cbc:ID schemeName="BIC" t-esc="invoice.journal_id.bank_account_id.bank_bic"/>\n                            </cac:FinancialInstitution>\n                        </cac:FinancialInstitutionBranch>\n                    </cac:PayeeFinancialAccount>\n                </cac:PaymentMeans>\n                <cac:PaymentTerms t-if="invoice.invoice_payment_term_id">\n                    <cbc:Note t-esc="invoice.invoice_payment_term_id.name"/>\n                </cac:PaymentTerms>\n                <cac:TaxTotal t-if="not invoice.currency_id.is_zero(invoice.amount_tax)">\n                    <cbc:TaxAmount t-att-currencyID="invoice.currency_id.name" t-esc="format_monetary(invoice.amount_tax)"/>\n                </cac:TaxTotal>\n                <cac:LegalMonetaryTotal>\n                    <cbc:LineExtensionAmount t-att-currencyID="invoice.currency_id.name" t-esc="format_monetary(invoice.amount_untaxed)"/>\n                    <cbc:TaxExclusiveAmount t-att-currencyID="invoice.currency_id.name" t-esc="format_monetary(invoice.amount_untaxed)"/>\n                    <cbc:TaxInclusiveAmount t-att-currencyID="invoice.currency_id.name" t-esc="format_monetary(invoice.amount_total)"/>\n                    <cbc:PrepaidAmount t-att-currencyID="invoice.currency_id.name" t-esc="format_monetary(invoice.amount_total - invoice.amount_residual)"/>\n                    <cbc:PayableAmount t-att-currencyID="invoice.currency_id.name" t-esc="format_monetary(invoice.amount_residual)"/>\n                </cac:LegalMonetaryTotal>\n                <t t-call="account_edi_ubl.export_ubl_invoice_line" t-foreach="invoice.invoice_line_ids" t-as="line"/>\n            </Invoice>\n        </t>\n    	account_edi_ubl/data/ubl_templates.xml	\N	\N	\N	\N	primary	t	1	2025-06-10 03:56:16.843857	1	2025-06-10 03:56:16.843857	f
918	crm.iap.lead.mining.request.form	crm.iap.lead.mining.request	\N	16	form	<?xml version="1.0"?>\n<form>\n                <header>\n                    <button name="action_submit" type="object" string="Submit" states="draft" class="oe_highlight" invisible="context.get('is_modal')"/>\n                    <button name="action_submit" type="object" string="Retry" states="error" class="oe_highlight"/>\n                    <field name="state" widget="statusbar" statusbar_visible="draft,done" invisible="context.get('is_modal')"/>\n                </header>\n                <sheet>\n                    <div class="oe_button_box" name="button_box">\n                        <button name="action_get_opportunity_action" class="oe_stat_button" type="object" icon="fa-handshake-o" attrs="{'invisible': ['|', ('lead_type', '!=', 'opportunity'), ('state', '!=' , 'done')]}">\n                            <div class="o_stat_info">\n                                <field name="lead_count"/>\n                                <span class="o_stat_text">Opportunities</span>\n                            </div>\n                        </button>\n                        <button name="action_get_lead_action" class="oe_stat_button" type="object" icon="fa-handshake-o" groups="crm.group_use_lead" attrs="{'invisible': ['|', ('lead_type', '!=', 'lead'), ('state', '!=' , 'done')]}">\n                            <div class="o_stat_info">\n                                <field name="lead_count"/>\n                                <span class="o_stat_text">Leads</span>\n                            </div>\n                        </button>\n                    </div>\n                    <span invisible="context.get('is_modal')">\n                        <div class="row">\n                            <div class="col-md-6">\n                                <div class="oe_title">\n                                    <h1>\n                                        <field name="name"/>\n                                    </h1>\n                                </div>\n                            </div>\n                        </div>\n                    </span>\n\n                    <h2>What do you need ?</h2>\n\n                    <group name="requests">\n                        <group>\n                            <div class="o_row">\n                                <field name="lead_number" attrs="{'readonly': [('state', '!=', 'draft')]}" nolabel="1" class="oe_inline col-md-2 pl-0"/>\n                                <field name="search_type" widget="selection" attrs="{'readonly': [('state', '!=', 'draft')]}" nolabel="1" class="oe_inline col-md-6"/>\n                                <field name="error" attrs="{'invisible': [('state', '!=', 'error')]}"/>\n                            </div>\n                        </group>\n                    </group>\n\n                    <group>\n                        <group name="companies">\n                            <field name="country_ids" widget="many2many_tags" attrs="{'readonly': [('state', '!=', 'draft')]}" required="True" options="{'no_create': True, 'no_open': True}"/>\n                            <field name="state_ids" widget="many2many_tags" attrs="{'invisible': [('country_ids', '=', [])], 'readonly': [('state', '!=', 'draft')]}" domain="[('country_id', 'in', country_ids)]" options="{'no_create': True, 'no_open': True}"/>\n                            <field name="industry_ids" widget="many2many_tags" attrs="{'readonly': [('state', '!=', 'draft')]}" options="{'no_create': True, 'no_open': True}" class="o_industry"/>\n                            <field name="filter_on_size" attrs="{'readonly': [('state', '!=', 'draft')]}"/>\n                            <label for="company_size_min" attrs="{'invisible': [('filter_on_size', '=', False)]}"/>\n                            <div attrs="{'invisible': [('filter_on_size', '=', False)]}">\n                                From\n                                <field name="company_size_min" class="oe_inline col-sm-3" attrs="{'required': [('filter_on_size', '=', True)], 'readonly': [('state', '!=', 'draft')]}"/>\n                                to\n                                <field name="company_size_max" class="oe_inline col-sm-3" attrs="{'required': [('filter_on_size', '=', True)], 'readonly': [('state', '!=', 'draft')]}"/>\n                                employees\n                            </div>\n\n                        </group>\n                        <group name="lead_info">\n                            <field name="lead_type" groups="crm.group_use_lead" invisible="context.get('is_modal')" attrs="{'readonly': [('state', '!=', 'draft')]}"/>\n                            <field name="team_id" no_create="1" no_open="1" attrs="{'readonly': [('state', '!=', 'draft')]}" kanban_view_ref="812"/>\n                            <field name="user_id" no_create="1" no_open="1" attrs="{'readonly': [('state', '!=', 'draft')]}"/>\n                            <field name="tag_ids" string="Default Tags" widget="many2many_tags" attrs="{'readonly': [('state', '!=', 'draft')]}"/>\n                        </group>\n                    </group>\n\n                    <group name="contacts" attrs="{'invisible': [('search_type', '!=', 'people')]}">\n                        <div>\n                            <field name="contact_number" attrs="{'readonly': [('state', '!=', 'draft')], 'required': [('search_type', '=', 'people')]}" nolabel="1" class="col-md-1"/>\n                             <span class="col-md-6">Extra contacts per Company</span>\n                        </div>\n                    </group>\n                    <group attrs="{'invisible': [('search_type', '!=', 'people')]}">\n                        <group>\n                            <field name="contact_filter_type" widget="radio" attrs="{'readonly': [('state', '!=', 'draft')]}" options="{'horizontal': true}"/>\n                            <field name="preferred_role_id" options="{'no_create_edit': True, 'no_quick_create': True}" attrs="{'invisible': [('contact_filter_type','!=', 'role')], 'required': [('search_type', '=', 'people'), ('contact_filter_type', '=', 'role')], 'readonly': [('state', '!=', 'draft')]}"/>\n                            <field name="role_ids" widget="many2many_tags" options="{'color_field': 'color', 'no_create_edit': True, 'no_quick_create': True}" attrs="{'invisible': ['|', ('preferred_role_id','=', False), ('contact_filter_type','!=', 'role')], 'readonly': [('state', '!=', 'draft')]}"/>\n                            <field name="seniority_id" options="{'no_create_edit': True, 'no_quick_create': True}" attrs="{'invisible': [('contact_filter_type', '!=', 'seniority')], 'required': [('search_type', '=', 'people'), ('contact_filter_type', '=', 'seniority')], 'readonly': [('state', '!=', 'draft')]}"/>\n                        </group>\n                    </group>\n                    <footer>\n                        <button string="Generate Leads" name="action_submit" type="object" default_focus="1" class="btn-primary" invisible="not context.get('is_modal')"/>\n                        <button string="Cancel" class="btn-secondary" special="cancel" invisible="not context.get('is_modal')"/>\n                    </footer>\n                </sheet>\n            </form>\n        	crm_iap_lead/views/crm_iap_lead_views.xml	\N	\N	\N	\N	primary	t	1	2025-06-10 03:56:17.777579	1	2025-06-10 03:56:17.777579	f

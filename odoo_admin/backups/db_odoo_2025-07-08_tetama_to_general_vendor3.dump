280	http_error_debug	\N	http_routing.http_error_debug	16	qweb	<?xml version="1.0"?>\n<t t-name="http_routing.http_error_debug">\n        <div class="container accordion mb32 mt32" id="debug_infos">\n            <div class="card" t-if="error_message">\n                <h4 class="card-header">\n                    <a data-toggle="collapse" href="#error_main">Error</a>\n                </h4>\n                <div id="error_main" class="collapse show">\n                    <div class="card-body">\n                        <t t-call="http_routing.error_message"/>\n                    </div>\n                </div>\n            </div>\n            <div class="card" t-if="qweb_exception">\n                <h4 class="card-header">\n                    <a data-toggle="collapse" href="#error_qweb">QWeb</a>\n                </h4>\n                <div id="error_qweb" class="collapse show">\n                    <div class="card-body">\n                        <p t-if="exception.message">\n                            <strong>Error message:</strong>\n                            <pre t-esc="exception.message"/>\n                        </p>\n                        <p>\n                            The error occured while rendering the template <code t-esc="qweb_exception.name"/>\n                            <t t-if="qweb_exception.html">and evaluating the following expression: <code t-esc="qweb_exception.html"/></t>\n                        </p>\n                    </div>\n                </div>\n            </div>\n            <div class="card" t-if="traceback">\n                <h4 class="card-header">\n                    <a data-toggle="collapse" href="#error_traceback">Traceback</a>\n                </h4>\n                <div id="error_traceback" t-attf-class="collapse #{not error_message and not qweb_exception and 'show'}">\n                    <div class="card-body">\n                        <pre id="exception_traceback" t-esc="traceback"/>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </t>\n\n    	http_routing/views/http_routing_template.xml	\N	\N	\N	\N	primary	t	1	2025-06-10 03:55:21.561365	1	2025-06-10 03:55:21.561365	\N
595	account.payment.search	account.payment	\N	16	search	<?xml version="1.0"?>\n<search string="Payments">\n                    <field name="name" string="Payment" filter_domain="['|', '|', ('name', 'ilike', self), ('partner_id', 'ilike', self), ('ref', 'ilike', self)]"/>\n                    <field name="partner_id" string="Customer/Vendor"/>\n                    <field name="journal_id"/>\n                    <field name="is_internal_transfer"/>\n                    <separator/>\n                    <filter string="Customer Payments" name="inbound_filter" domain="[('partner_type', '=', 'customer'), ('is_internal_transfer', '=', False)]"/>\n                    <filter string="Vendor Payments" name="outbound_filter" domain="[('partner_type', '=', 'supplier'), ('is_internal_transfer', '=', False)]"/>\n                    <filter string="Transfers" name="transfers_filter" domain="[('is_internal_transfer', '=', True)]"/>\n                    <separator/>\n                    <filter string="Draft" name="state_draft" domain="[('state', '=', 'draft')]"/>\n                    <filter string="Posted" name="state_posted" domain="[('state', '=', 'posted')]"/>\n                    <separator/>\n                    <filter string="Sent" name="state_sent" domain="[('is_move_sent', '=', True)]"/>\n                    <filter string="Bank Matched" name="matched" domain="[('is_matched', '=', True)]"/>\n                    <filter string="Reconciled" name="reconciled" domain="[('is_reconciled', '=', True)]"/>\n                    <separator/>\n                    <filter string="Payment Date" name="date" date="date"/>\n                    <separator/>\n                    <field name="company_id" groups="base.group_multi_company"/>\n                    <filter string="Customer/Vendor" name="partner" domain="[]" context="{'group_by': 'partner_id'}"/>\n                    <filter string="Journal" name="journal" domain="[]" context="{'group_by': 'journal_id'}"/>\n                    <filter string="Payment Method" name="paymentmethod" domain="[]" context="{'group_by': 'payment_method_id'}"/>\n                    <filter string="Status" name="state" domain="[]" context="{'group_by': 'state'}"/>\n                    <filter string="Payment Date" name="groupby_date" domain="[]" context="{'group_by': 'date'}"/>\n                    <filter string="Currency" name="currency" domain="[]" context="{'group_by': 'currency_id'}" groups="base.group_multi_currency"/>\n                    <filter string="Company" name="company" domain="[]" context="{'group_by': 'company_id'}" groups="base.group_multi_company"/>\n                    <separator/>\n                    <filter invisible="1" string="Late Activities" name="activities_overdue" domain="[('activity_ids.date_deadline', '&lt;', context_today().strftime('%Y-%m-%d'))]" help="Show all records which has next action date is before today"/>\n                    <filter invisible="1" string="Today Activities" name="activities_today" domain="[('activity_ids.date_deadline', '=', context_today().strftime('%Y-%m-%d'))]"/>\n                    <filter invisible="1" string="Future Activities" name="activities_upcoming_all" domain="[('activity_ids.date_deadline', '&gt;', context_today().strftime('%Y-%m-%d'))]"/>\n                </search>\n            	account/views/account_payment_view.xml	\N	\N	\N	\N	primary	t	1	2025-06-10 03:55:46.489222	1	2025-06-10 03:55:46.489222	f

826	report_partnerledger	\N	accounting_pdf_reports.report_partnerledger	16	qweb	<?xml version="1.0"?>\n<t t-name="accounting_pdf_reports.report_partnerledger">\n        <t t-call="web.html_container">\n            <t t-call="web.internal_layout">\n                <t t-set="data_report_margin_top" t-value="12"/>\n                <t t-set="data_report_header_spacing" t-value="9"/>\n                <t t-set="data_report_dpi" t-value="110"/>\n                <div class="page">\n                    <h2>Partner Ledger</h2>\n                    <div class="row">\n                        <div class="col-3">\n                            <strong>Company:</strong>\n                            <p t-esc="res_company.name"/>\n                        </div>\n                        <div class="col-3">\n                            <t t-if="data['form']['date_from']">\n                                <strong>Date from :</strong>\n                                <span t-esc="data['form']['date_from']"/>\n                                <br/>\n                            </t>\n                            <t t-if="data['form']['date_to']">\n                                <strong>Date to :</strong>\n                                <span t-esc="data['form']['date_to']"/>\n                            </t>\n                        </div>\n                        <div class="col-3">\n                            <strong>Target Moves:</strong>\n                            <p t-if="data['form']['target_move'] == 'all'">All Entries</p>\n                            <p t-if="data['form']['target_move'] == 'posted'">All Posted Entries</p>\n                        </div>\n                    </div>\n\n                    <table class="table table-sm table-reports">\n                        <thead>\n                            <tr>\n                                <th>Date</th>\n                                <th>JRNL</th>\n                                <th>Account</th>\n                                <th>Ref</th>\n                                <th>Debit</th>\n                                <th>Credit</th>\n                                <th>Balance</th>\n                                <th t-if="data['form']['amount_currency']">Currency</th>\n                            </tr>\n                        </thead>\n                        <t t-foreach="docs" t-as="o">\n                            <tbody>\n                                <tr>\n                                    <td colspan="4">\n                                        <strong t-esc="o.ref"/>\n                                        -\n                                        <strong t-esc="o.name"/>\n                                    </td>\n                                    <td class="text-right">\n                                        <strong t-esc="sum_partner(data, o, 'debit')" t-options="{'widget': 'monetary', 'display_currency': res_company.currency_id}"/>\n                                    </td>\n                                    <td class="text-right">\n                                        <strong t-esc="sum_partner(data, o, 'credit')" t-options="{'widget': 'monetary', 'display_currency': res_company.currency_id}"/>\n                                    </td>\n                                    <td class="text-right">\n                                        <strong t-esc="sum_partner(data, o, 'debit - credit')" t-options="{'widget': 'monetary', 'display_currency': res_company.currency_id}"/>\n                                    </td>\n                                </tr>\n                                <tr t-foreach="lines(data, o)" t-as="line">\n                                    <td>\n                                        <span t-esc="line['date']"/>\n                                    </td>\n                                    <td>\n                                        <span t-esc="line['code']"/>\n                                    </td>\n                                    <td>\n                                        <span t-esc="line['a_code']"/>\n                                    </td>\n                                    <td>\n                                        <span t-esc="line['displayed_name']"/>\n                                    </td>\n                                    <td class="text-right">\n                                        <span t-esc="line['debit']" t-options="{'widget': 'monetary', 'display_currency': res_company.currency_id}"/>\n                                    </td>\n                                    <td class="text-right">\n                                        <span t-esc="line['credit']" t-options="{'widget': 'monetary', 'display_currency': res_company.currency_id}"/>\n                                    </td>\n                                    <td class="text-right">\n                                        <span t-esc="line['progress']" t-options="{'widget': 'monetary', 'display_currency': res_company.currency_id}"/>\n                                    </td>\n                                    <td class="text-right" t-if="data['form']['amount_currency']">\n                                        <t t-if="line['currency_id']">\n                                            <span t-esc="line['amount_currency']" t-options="{'widget': 'monetary', 'display_currency': line['currency_id']}"/>\n                                        </t>\n                                    </td>\n                                </tr>\n                            </tbody>\n                        </t>\n                    </table>\n                </div>\n            </t>\n        </t>\n    </t>\n	accounting_pdf_reports/reports/report_partner_ledger.xml	\N	\N	\N	\N	primary	t	1	2025-06-10 03:56:03.552105	1	2025-06-10 03:56:03.552105	f

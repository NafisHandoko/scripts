218	external_layout_boxed	\N	web.external_layout_boxed	16	qweb	<?xml version="1.0"?>\n<t t-name="web.external_layout_boxed">\n        <div t-attf-class="header o_company_#{company.id}_layout" t-att-style="report_header_style">\n            <div class="o_boxed_header">\n            <div class="row mb8">\n                <div class="col-6">\n                    <img t-if="company.logo" t-att-src="image_data_uri(company.logo)" alt="Logo"/>\n                </div>\n                <div class="col-6 text-right mb4">\n                    <h4 class="mt0" t-field="company.report_header"/>\n                    <div name="company_address" class="float-right mb4">\n                        <span class="company_address" t-field="company.partner_id" t-options="{&quot;widget&quot;: &quot;contact&quot;, &quot;fields&quot;: [&quot;address&quot;, &quot;name&quot;], &quot;no_marker&quot;: true}"/>\n                    </div>\n                </div>\n            </div>\n            </div>\n        </div>\n\n        <div t-attf-class="article o_report_layout_boxed o_company_#{company.id}_layout" t-att-data-oe-model="o and o._name" t-att-data-oe-id="o and o.id" t-att-data-oe-lang="o and o.env.context.get('lang')">\n            <div class="pt-5">\n                <!-- This div ensures that the address is not cropped by the header. -->\n                <t t-call="web.address_layout"/>\n            </div>\n            <t t-raw="0"/>\n        </div>\n\n        <div t-attf-class="footer o_boxed_footer o_company_#{company.id}_layout">\n            <div class="text-center">\n                <ul class="list-inline">\n                    <li t-if="company.phone" class="list-inline-item"><span class="o_force_ltr" t-field="company.phone"/></li>\n                    <li t-if="company.email" class="list-inline-item"><span t-field="company.email"/></li>\n                    <li t-if="company.website" class="list-inline-item"><span t-field="company.website"/></li>\n                    <li t-if="company.vat" class="list-inline-item"><t t-esc="company.country_id.vat_label or 'Tax ID'"/>: <span t-field="company.vat"/></li>\n                </ul>\n                <div t-field="company.report_footer"/>\n                <div t-if="report_type == 'pdf'">\n                    Page: <span class="page"/> / <span class="topage"/>\n                </div>\n            </div>\n        </div>\n    </t>\n\n    	web/views/report_templates.xml	\N	\N	\N	\N	primary	t	1	2025-06-10 03:52:06.216302	1	2025-06-10 03:52:06.216302	\N
219	external_layout_clean	\N	web.external_layout_clean	16	qweb	<?xml version="1.0"?>\n<t t-name="web.external_layout_clean">\n        <div t-attf-class="header o_company_#{company.id}_layout" t-att-style="report_header_style">\n            <div class="o_clean_header">\n            <div class="row">\n                <div class="col-6">\n                    <img t-if="company.logo" t-att-src="image_data_uri(company.logo)" alt="Logo"/>\n                </div>\n                <div class="col-5 offset-1" name="company_address">\n                    <ul class="list-unstyled">\n                        <strong><li t-if="company.name"><span t-field="company.name"/></li></strong>\n                        <li t-if="company.vat"><t t-esc="company.country_id.vat_label or 'Tax ID'"/>: <span t-field="company.vat"/></li>\n                        <li t-if="company.phone">Tel: <span class="o_force_ltr" t-field="company.phone"/></li>\n                        <li t-if="company.email"><span t-field="company.email"/></li>\n                        <li t-if="company.website"><span t-field="company.website"/></li>\n                    </ul>\n                </div>\n            </div>\n            </div>\n        </div>\n\n        <div t-attf-class="article o_report_layout_clean o_company_#{company.id}_layout" t-att-data-oe-model="o and o._name" t-att-data-oe-id="o and o.id" t-att-data-oe-lang="o and o.env.context.get('lang')">\n            <t t-call="web.address_layout"/>\n            <t t-raw="0"/>\n        </div>\n\n        <div t-attf-class="footer o_clean_footer o_company_#{company.id}_layout">\n            <div class="row mt8">\n                <div class="col-3">\n                    <span t-field="company.report_footer"/>\n                </div>\n                <div class="col-4 text-right">\n                    <span class="company_address" t-field="company.partner_id" t-options="{&quot;widget&quot;: &quot;contact&quot;, &quot;fields&quot;: [&quot;address&quot;], &quot;no_marker&quot;: true}"/>\n                </div>\n                <div class="col-4">\n                    <h4 class="mt0 mb0 text-uppercase" t-field="company.report_header"/>\n                </div>\n                <div class="col-1">\n                    <ul t-if="report_type == 'pdf'" class="list-inline pagenumber float-right text-center">\n                        <li class="list-inline-item"><strong><span class="page"/></strong></li>\n                    </ul>\n                </div>\n            </div>\n        </div>\n    </t>\n\n    	web/views/report_templates.xml	\N	\N	\N	\N	primary	t	1	2025-06-10 03:52:06.216302	1	2025-06-10 03:52:06.216302	\N
420	Sign up login	\N	auth_signup.signup	16	qweb	<?xml version="1.0"?>\n<t name="Sign up login" t-name="auth_signup.signup">\n            <t t-call="web.login_layout">\n                <form class="oe_signup_form" role="form" method="post" t-if="not message">\n                  <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>\n\n                    <t t-call="auth_signup.fields">\n                        <t t-set="only_passwords" t-value="bool(token and not invalid_token)"/>\n                    </t>\n\n                    <p class="alert alert-danger" t-if="error" role="alert">\n                        <t t-esc="error"/>\n                    </p>\n                    <input type="hidden" name="redirect" t-att-value="redirect"/>\n                    <input type="hidden" name="token" t-att-value="token"/>\n                    <div class="text-center oe_login_buttons pt-3">\n                        <button type="submit" class="btn btn-primary btn-block"> Sign up</button>\n                        <a t-attf-href="/web/login?{{ keep_query() }}" class="btn btn-link btn-sm" role="button">Already have an account?</a>\n                        <div class="o_login_auth"/>\n                    </div>\n                </form>\n            </t>\n        </t>\n\n        	auth_signup/views/auth_signup_login_templates.xml	\N	\N	\N	\N	primary	t	1	2025-06-10 03:55:31.790018	1	2025-06-10 03:55:31.790018	\N
220	external_layout_standard	\N	web.external_layout_standard	16	qweb	<?xml version="1.0"?>\n<t t-name="web.external_layout_standard">\n        <div t-attf-class="header o_company_#{company.id}_layout" t-att-style="report_header_style">\n            <div class="row">\n                <div class="col-3 mb4">\n                    <img t-if="company.logo" t-att-src="image_data_uri(company.logo)" style="max-height: 45px;" alt="Logo"/>\n                </div>\n                <div class="col-9 text-right" style="margin-top:22px;" t-field="company.report_header" name="moto"/>\n            </div>\n            <div t-if="company.logo or company.report_header" class="row zero_min_height">\n                <div class="col-12">\n                    <div style="border-bottom: 1px solid black;"/>\n                </div>\n            </div>\n            <div class="row">\n                <div class="col-6" name="company_address">\n                    <div t-field="company.partner_id" t-options="{&quot;widget&quot;: &quot;contact&quot;, &quot;fields&quot;: [&quot;address&quot;, &quot;name&quot;], &quot;no_marker&quot;: true}"/>\n                </div>\n            </div>\n        </div>\n\n        <div t-attf-class="article o_report_layout_standard o_company_#{company.id}_layout" t-att-data-oe-model="o and o._name" t-att-data-oe-id="o and o.id" t-att-data-oe-lang="o and o.env.context.get('lang')">\n            <div class="pt-5">\n                <!-- This div ensures that the address is not cropped by the header. -->\n                <t t-call="web.address_layout"/>\n            </div>\n            <t t-raw="0"/>\n        </div>\n\n        <div t-attf-class="footer o_standard_footer o_company_#{company.id}_layout">\n            <div class="text-center" style="border-top: 1px solid black;">\n                <ul class="list-inline mb4">\n                    <!-- using the list-inline-item class from bootstrap causes weird behaviours in pdf report\n                         adding d-inline class fixes the problem-->\n                    <li t-if="company.phone" class="list-inline-item d-inline"><span class="o_force_ltr" t-field="company.phone"/></li>\n                    <li t-if="company.email" class="list-inline-item d-inline"><span t-field="company.email"/></li>\n                    <li t-if="company.website" class="list-inline-item d-inline"><span t-field="company.website"/></li>\n                    <li t-if="company.vat" class="list-inline-item d-inline"><t t-esc="company.country_id.vat_label or 'Tax ID'"/>: <span t-field="company.vat"/></li>\n                </ul>\n\n                <div name="financial_infos">\n                    <span t-field="company.report_footer"/>\n                </div>\n\n                <div t-if="report_type == 'pdf'" class="text-muted">\n                    Page: <span class="page"/> / <span class="topage"/>\n                </div>\n            </div>\n        </div>\n    </t>\n\n    	web/views/report_templates.xml	\N	\N	\N	\N	primary	t	1	2025-06-10 03:52:06.216302	1	2025-06-10 03:52:06.216302	\N

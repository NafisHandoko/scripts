229	user form: add totp status	res.users	\N	16	form	<?xml version="1.0"?>\n<xpath expr="//page[@name='references']/group[1]" position="before">\n                <field name="totp_enabled" invisible="1"/>\n                <group attrs="{'invisible': [('totp_enabled', '!=', False)]}">\n                    <div>\n                        <span class="alert alert-info" role="status">\n                            <i class="fa fa-warning"/>\n                            Two-factor authentication not enabled\n                        </span>\n                    </div>\n                </group>\n                <group attrs="{'invisible': [('totp_enabled', '=', False)]}">\n                    <div>\n                        <span class="text-success">\n                            <i class="fa fa-check-circle"/>\n                            Two-factor authentication enabled\n                        </span>\n                    </div>\n                </group>\n            </xpath>\n        	auth_totp/views/user_preferences.xml	\N	\N	154	\N	extension	t	1	2025-06-10 03:52:09.161377	1	2025-06-10 03:52:09.161377	\N
230	auth_totp wizard	auth_totp.wizard	\N	16	form	<?xml version="1.0"?>\n<form>\n                <sheet>\n                    <div class="row container">\n                        <div class="mb-3">\n                            <h3 class="font-weight-bold">Scan this barcode with your app</h3>\n                            <div>\n                                Scan the image below with the authenticator app on your phone.<br/>\n                                If you cannot scan the barcode, here are some alternative options:\n                                <ul>\n                                    <li><field class="text-wrap" name="url" widget="url" options="{'website_path': True}" text="Click on this link to open your authenticator app"/></li>\n\n                                    <li>Or enter the secret code manually:\n                                        <a data-toggle="collapse" href="#collapseTotpSecret" role="button" aria-expanded="false" aria-controls="collapseTotpSecret">show the code</a>\n                                    </li>\n                                </ul>\n                                <!-- code outside list to have more horiz space on mobile -->\n                                <div class="collapse col-12 col-md-6" id="collapseTotpSecret">\n                                  <div class="card card-body">\n                                    <h3>Your two-factor secret:</h3>\n                                    <code class="text-center"><field name="secret"/></code>\n                                  </div>\n                                </div>\n                            </div>\n\n                            <field class="offset-1" name="qrcode" readonly="True" widget="image"/>\n\n                            <h3 class="font-weight-bold">Enter the 6-digit code from your app</h3>\n                            <div class="text-justify col-10 col-lg-6 px-0">\n                                After scanning the barcode, the app will display a 6-digit code that you\n                                should enter below. Don't worry if the code changes in the app,\n                                it stays valid a bit longer.\n                            </div>\n                            <div class="mt-2">\n                                <label for="code" class="col-4 col-md-12 px-0">Verification Code</label>\n                                <field required="True" name="code" class="col-10 col-md-6 px-0"/>\n                            </div>\n\n                        </div>\n                    </div>\n                </sheet>\n                <footer>\n                    <button type="object" name="enable" class="btn btn-primary" string="Enable two-factor authentication"/>\n                    <button string="Cancel" special="cancel"/>\n                </footer>\n            </form>\n        	auth_totp/views/user_preferences.xml	\N	\N	\N	\N	primary	t	1	2025-06-10 03:52:09.161377	1	2025-06-10 03:52:09.161377	\N
426	Calendar Invitation Page for anonymous users	\N	calendar.invitation_page_anonymous	16	qweb	<?xml version="1.0"?>\n<t name="Calendar Invitation Page for anonymous users" t-name="calendar.invitation_page_anonymous">\n        <t t-call="web.layout">\n            <t t-set="head">\n                <t t-call-assets="web.assets_common" t-js="false"/>\n                <t t-call-assets="web.assets_frontend" t-js="false"/>\n            </t>\n\n            <div class="container">\n                <div class="o_logo">\n                    <img class="img img-fluid d-block mx-auto" src="/web/binary/company_logo" alt="Logo"/>\n                </div>\n\n                <div class="card">\n                    <div class="card-header">\n                        <h2>Calendar Invitation <small><t t-esc="event.name"/></small></h2>\n                    </div>\n                    <div class="card-body">\n                        <div class="clearfix mb16" t-if="attendee.state != 'needsAction'">\n                            <span class="float-right badge badge-info">\n                                <t t-if="attendee.state == 'accepted'">Yes I'm going.</t>\n                                <t t-if="attendee.state == 'declined'">No I'm not going.</t>\n                                <t t-if="attendee.state == 'tentative'">Tentative</t>\n                                <t t-if="attendee.state == 'needsAction'">No feedback yet</t>\n                            </span>\n                        </div>\n\n                        <div class="table-responsive">\n                            <table class="o_event_table table table-striped">\n                                <tr>\n                                    <th>Invitation for</th>\n                                    <td><t t-esc="attendee.common_name"/> (<t t-esc="attendee.email"/>)</td>\n                                </tr>\n                                <tr>\n                                    <th>Date</th>\n                                    <td><t t-esc="event.display_time"/></td>\n                                </tr>\n                                <tr>\n                                    <th>Location</th>\n                                    <td><t t-esc="event.location or '-'"/></td>\n                                </tr>\n                                <tr>\n                                    <th>Attendees</th>\n                                    <td>\n                                        <ul>\n                                            <li t-foreach="event.attendee_ids" t-as="attendee" t-attf-class="o_#{attendee.state}">\n                                                <t t-esc="attendee.common_name"/>\n                                            </li>\n                                        </ul>\n                                    </td>\n                                </tr>\n                                <tr>\n                                    <th>Description</th>\n                                    <td><t t-esc="event.description or '-'"/></td>\n                                </tr>\n                            </table>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </t>\n    </t>\n	calendar/views/calendar_templates.xml	\N	\N	\N	\N	primary	t	1	2025-06-10 03:55:32.439631	1	2025-06-10 03:55:32.439631	\N

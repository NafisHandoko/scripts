alse)]}"/>\n                        <button string="Save" name="action_close_dialog" type="object" class="btn-primary" attrs="{'invisible': [('id', '=', False)]}"/>\n                        <button attrs="{'invisible': [('force_next', '=', True)]}" string="Mark as Done" name="action_done" type="object" class="btn-secondary" context="{'mail_activity_quick_update': True}"/>\n                        <button attrs="{'invisible': [('force_next', '=', True)]}" string="Done &amp; Schedule Next" name="action_done_schedule_next" type="object" class="btn-secondary" context="{'mail_activity_quick_update': True}"/>\n                        <button attrs="{'invisible': [('force_next', '=', False)]}" string="Done &amp; Launch Next" name="action_done_schedule_next" type="object" class="btn-secondary" context="{'mail_activity_quick_update': True}"/>\n                        <button string="Discard" class="btn-secondary" special="cancel"/>\n                    </footer>\n                </sheet>\n            </form>\n        	mail/views/mail_activity_views.xml	\N	\N	\N	\N	primary	t	1	2025-06-10 03:55:24.448855	1	2025-06-10 03:55:24.448855	\N
121	res.partner.kanban	res.partner	\N	16	kanban	<?xml version="1.0"?>\n<kanban class="o_res_partner_kanban" sample="1">\n                    <field name="id"/>\n                    <field name="color"/>\n                    <field name="display_name"/>\n                    <field name="title"/>\n                    <field name="email"/>\n                    <field name="parent_id"/>\n                    <field name="is_company"/>\n                    <field name="function"/>\n                    <field name="phone"/>\n                    <field name="street"/>\n                    <field name="street2"/>\n                    <field name="zip"/>\n                    <field name="city"/>\n                    <field name="country_id"/>\n                    <field name="mobile"/>\n                    <field name="state_id"/>\n                    <field name="category_id"/>\n                    <field name="image_128"/>\n                    <field name="type"/>\n                    <templates>\n                        <t t-name="kanban-box">\n                            <div class="oe_kanban_global_click o_kanban_record_has_image_fill o_res_partner_kanban">\n                                <t t-if="!record.is_company.raw_value">\n                                    <t t-if="record.type.raw_value === 'delivery'" t-set="placeholder" t-value="'/base/static/img/truck.png'"/>\n                                    <t t-elif="record.type.raw_value === 'invoice'" t-set="placeholder" t-value="'/base/static/img/money.png'"/>\n                                    <t t-else="" t-set="placeholder" t-value="'/base/static/img/avatar_grey.png'"/>\n                                    <div class="o_kanban_image_fill_left d-none d-md-block" t-attf-style="background-image:url('#{kanban_image('res.partner', 'image_128', record.id.raw_value,  placeholder)}')">\n                                        <img class="o_kanban_image_inner_pic" t-if="record.parent_id.raw_value" t-att-alt="record.parent_id.value" t-att-src="kanban_image('res.partner', 'image_128', record.parent_id.raw_value)"/>\n                                    </div>\n                                    <div class="o_kanban_image d-md-none" t-attf-style="background-image:url('#{kanban_image('res.partner', 'image_128', record.id.raw_value,  placeholder)}')">\n                                        <img class="o_kanban_image_inner_pic" t-if="record.parent_id.raw_value" t-att-alt="record.parent_id.value" t-att-src="kanban_image('res.partner', 'image_128', record.parent_id.raw_value)"/>\n                                    </div>\n                                </t>\n                                <t t-else="">\n                                    <t t-set="placeholder" t-value="'/base/static/img/company_image.png'"/>\n                                    <div class="o_kanban_image_fill_left o_kanban_image_full" t-attf-style="background-image: url(#{kanban_image('res.partner', 'image_128', record.id.raw_value, placeholder)})" role="img"/>\n                                </t>\n                                <div class="oe_kanban_details d-flex flex-column">\n                                    <strong class="o_kanban_record_title oe_partner_heading"><field name="display_name"/></strong>\n                                    <div class="o_kanban_tags_section oe_kanban_partner_categories"/>\n                                    <ul>\n                                        <li t-if="record.parent_id.raw_value and !record.function.raw_value"><field name="parent_id"/></li>\n                                        <li t-if="!record.parent_id.raw_value and record.function.raw_value"><field name="function"/></li>\n                                        <li t-if="record.parent_id.raw_value and record.function.raw_value"><field name="function"/> at <field name="parent_id"/></li>\n                                        <li t-if="record.city.raw_value or record.country_id.raw_value">\n                                            <t t-if="record.city.raw_value"><field name="city"/><t t-if="record.country_id.raw_value">, </t></t>\n                                            <t t-if="record.country_id.raw_value"><field name="country_id"/></t>\n                                        </li>\n                                        <li t-if="record.email.raw_value" class="o_text_overflow"><field name="email"/></li>\n                                    </ul>\n                                    <div class="o_row">\n                                        <span class="oe_kanban_partner_links"/>\n                                    </div>\n                                </div>\n                            </div>\n                        </t>\n                    </templates>\n                </kanban>\n            	base/views/res_partner_views.xml	\N	\N	\N	\N	primary	t	1	2025-06-10 03:51:51.249694	1	2025-06-10 03:51:51.249694	\N

718	account.invoice.report.search	account.invoice.report	\N	16	search	<?xml version="1.0"?>\n<search string="Invoices Analysis">\n                <filter string="My Invoices" name="my_invoice" domain="[('invoice_user_id', '=', uid)]"/>\n                <separator/>\n                <field name="invoice_date"/>\n                <separator/>\n                <filter string="To Invoice" name="toinvoice" domain="[('state','=','draft')]" help="Draft Invoices"/>\n                <filter string="Invoiced" name="current" domain="[('state','not in', ('draft','cancel'))]"/>\n                <separator/>\n                <filter string="Customers" name="customer" domain="['|', ('move_type','=','out_invoice'),('move_type','=','out_refund')]"/>\n                <filter string="Vendors" name="supplier" domain="['|', ('move_type','=','in_invoice'),('move_type','=','in_refund')]"/>\n                <separator/>\n                <filter string="Invoices" name="invoice" domain="['|', ('move_type','=','out_invoice'),('move_type','=','in_invoice')]"/>\n                <filter string="Credit Notes" name="creditnote" domain="['|', ('move_type','=','out_refund'),('move_type','=','in_refund')]"/>\n                <separator/>\n                <filter name="filter_invoice_date" date="invoice_date"/>\n                <filter name="invoice_date_due" date="invoice_date_due"/>\n                <field name="partner_id" operator="child_of"/>\n                <field name="invoice_user_id"/>\n                <field name="product_id"/>\n                <field name="product_categ_id" filter_domain="[('product_categ_id', 'child_of', self)]"/>\n                <group expand="1" string="Group By">\n                    <filter string="Salesperson" name="user" context="{'group_by':'invoice_user_id'}"/>\n                    <filter string="Partner" name="partner_id" context="{'group_by':'partner_id','residual_visible':True}"/>\n                    <filter string="Product Category" name="category_product" context="{'group_by':'product_categ_id','residual_invisible':True}"/>\n                    <filter string="Status" name="status" context="{'group_by':'state'}"/>\n                    <filter string="Company" name="company" context="{'group_by':'company_id'}" groups="base.group_multi_company"/>\n                    <separator orientation="vertical"/>\n                    <filter string="Date" name="invoice_date" context="{'group_by':'invoice_date'}"/>\n                    <filter string="Due Date" name="duemonth" context="{'group_by':'invoice_date_due:month'}"/>\n                </group>\n            </search>\n        	account/report/account_invoice_report_view.xml	\N	\N	\N	\N	primary	t	1	2025-06-10 03:55:46.489222	1	2025-06-10 03:55:46.489222	f
486	product.pricelist.form	product.pricelist	\N	16	form	<?xml version="1.0"?>\n<form string="Products Price List">\n                    <sheet>\n                        <widget name="web_ribbon" title="Archived" bg_color="bg-danger" attrs="{'invisible': [('active', '=', True)]}"/>\n                        <div class="oe_title">\n                            <h1><field name="name" placeholder="e.g. USD Retailers"/></h1>\n                        </div>\n                        <group>\n                          <group name="pricelist_settings">\n                              <field name="currency_id" groups="base.group_multi_currency"/>\n                              <field name="active" invisible="1"/>\n                              <field name="company_id" groups="base.group_multi_company" options="{'no_create': True}"/>\n                          </group>\n                        </group>\n                        <notebook>\n                            <page name="pricelist_rules" string="Price Rules">\n                              <field name="item_ids" nolabel="1" context="{'default_base':'list_price'}">\n                                  <tree string="Pricelist Items" editable="bottom">\n                                      <field name="product_tmpl_id" string="Products" required="1"/>\n                                      <field name="product_id" string="Variants" groups="product.group_product_variant" domain="[('product_tmpl_id', '=', product_tmpl_id)]" options="{'no_create':1}"/>\n                                      <field name="min_quantity"/>\n                                      <field name="fixed_price" string="Price"/>\n                                      <field name="currency_id" invisible="1"/>\n                                      <field name="pricelist_id" invisible="1"/>\n                                      <!-- Pricelist ID is here only for related fields to be correctly computed -->\n                                      <field name="date_start"/>\n                                      <field name="date_end"/>\n                                      <field name="base" invisible="1"/>\n                                      <field name="applied_on" invisible="1"/>\n                                      <field name="company_id" invisible="1"/>\n                                  </tree>\n                              </field>\n                            </page>\n                            <page name="pricelist_config" string="Configuration">\n                                <group>\n                                    <group name="pricelist_availability" string="Availability">\n                                        <field name="country_group_ids" widget="many2many_tags"/>\n                                    </group>\n                                    <group name="pricelist_discounts" groups="product.group_discount_per_so_line" string="Discounts">\n                                        <field name="discount_policy" widget="radio"/>\n                                    </group>\n                                </group>\n                            </page>\n                        </notebook>\n                    </sheet>\n                </form>\n            	product/views/product_pricelist_views.xml	\N	\N	\N	\N	primary	t	1	2025-06-10 03:55:36.149676	1	2025-06-10 03:55:36.149676	\N

364	res.config.settings.view.form.inherit.mail	res.config.settings	\N	16	form	<?xml version="1.0"?>\n<div id="emails" position="replace">\n                    <h2>Discuss</h2>\n                    <div class="row mt16 o_settings_container" id="emails">\n                        <div class="col-12 col-lg-6 o_setting_box" id="activities_setting">\n                            <div class="o_setting_left_pane"/>\n                            <div class="o_setting_right_pane">\n                                <span class="o_form_label">Activities</span>\n                                <div class="text-muted">\n                                    Configure your activity types\n                                </div>\n                                <div class="content-group">\n                                    <div class="mt8">\n                                        <button name="116" string="Activity Types" type="action" class="oe_link" icon="fa-arrow-right"/>\n                                    </div>\n                                </div>\n                            </div>\n                        </div>\n                        <div class="col-12 col-lg-6 o_setting_box" id="email_servers_setting" title="Using your own email server is required to send/receive emails in Community and Enterprise versions. Online users already benefit from a ready-to-use email server (@mycompany.odoo.com).">\n                            <div class="o_setting_left_pane">\n                                <field name="external_email_server_default"/>\n                            </div>\n                            <div class="o_setting_right_pane">\n                                <label for="external_email_server_default"/>\n                                <a href="https://www.odoo.com/documentation/user/14.0/discuss/advanced/email_servers.html" title="Documentation" class="o_doc_link" target="_blank"/>\n                                <div class="text-muted" id="external_email_server_default">\n                                    Configure your own email servers\n                                </div>\n                                <div class="content-group" attrs="{'invisible': [('external_email_server_default', '=', False)]}">\n                                    <div class="row mt16" id="mail_alias_domain">\n                                        <label for="alias_domain" class="col-lg-3 o_light_label"/>\n                                        <field name="alias_domain" placeholder="mycompany.odoo.com"/>\n                                    </div>\n                                </div>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n            	mail/views/res_config_settings_views.xml	\N	\N	271	\N	extension	t	1	2025-06-10 03:55:24.448855	1	2025-06-10 03:55:24.448855	\N
365	message_notification_email	\N	mail.message_notification_email	16	qweb	<?xml version="1.0"?>\n<t t-name="mail.message_notification_email">\n<div>\n<div t-if="has_button_access" itemscope="itemscope" itemtype="http://schema.org/EmailMessage">\n    <div itemprop="potentialAction" itemscope="itemscope" itemtype="http://schema.org/ViewAction">\n        <link itemprop="target" t-att-href="button_access['url']"/>\n        <link itemprop="url" t-att-href="button_access['url']"/>\n        <meta itemprop="name" t-att-content="button_access['title']"/>\n    </div>\n</div>\n<div t-if="has_button_access or len(actions) &gt; 0 or not is_discussion" summary="o_mail_notification" style="padding: 0px; width:600px;">\n    <table cellspacing="0" cellpadding="0" border="0" style="width: 600px; margin-top: 5px;">\n    <tbody><tr>\n    <td valign="center">\n        <a t-if="has_button_access" t-att-href="button_access['url']" style="padding: 8px 12px; font-size: 12px; color: #FFFFFF; text-decoration: none !important; font-weight: 400; background-color: #875A7B; border: 0px solid #875A7B; border-radius:3px">\n            <t t-esc="button_access['title']"/>\n        </a>\n        <t t-if="actions">\n            <t t-foreach="actions" t-as="action">\n                |\n                <a t-att-href="action['url']" style="color: #875A7B; text-decoration:none !important;">\n                    <t t-esc="action['title']"/>\n                </a>\n            </t>\n        </t>\n    </td>\n    <td valign="center" align="right">\n        <img t-att-src="'/logo.png?company=%s' % (company.id or 0)" style="padding: 0px; margin: 0px; height: auto; max-width: 200px; max-height: 36px;" t-att-alt="'%s' % company.name"/>\n    </td>\n    </tr><tr>\n    <td colspan="2" style="text-align:center;">\n        <hr width="100%" style="background-color:rgb(204,204,204);border:medium none;clear:both;display:block;font-size:0px;min-height:1px;line-height:0; margin:4px 0 12px 0;"/>\n        <p t-if="subtype.internal" style="background-color: #f2dede; padding: 5px; margin-bottom: 16px;">\n            <strong>Internal communication</strong>: Replying will post an internal note. Followers won't receive any email notification.\n        </p>\n    </td>\n    </tr></tbody>\n    </table>\n</div>\n<div t-raw="message.body"/>\n<ul t-if="tracking_values">\n    <t t-foreach="tracking_values" t-as="tracking">\n        <li><t t-esc="tracking[0]"/>: <t t-esc="tracking[1]"/> -&gt; <t t-esc="tracking[2]"/></li>\n    </t>\n</ul>\n<div t-if="signature" t-raw="signature" style="font-size: 13px;"/>\n<p style="color: #555555; margin-top:32px;">\n    Sent\n    <span t-if="company.name">\n    by\n    <a t-if="website_url" t-att-href="website_url" style="text-decoration:none; color: #875A7B;">\n        <span t-esc="company.name"/>\n    </a>\n    <span t-if="not website_url" t-esc="company.name"/>\n    </span>\n    using\n    <a target="_blank" href="https://www.odoo.com?utm_source=db&amp;utm_medium=email" style="text-decoration:none; color: #875A7B;">Odoo</a>.\n</p>\n</div>\n        </t>\n\n        	mail/data/mail_data.xml	\N	\N	\N	\N	primary	t	1	2025-06-10 03:55:24.448855	1	2025-06-10 03:55:24.448855	\N

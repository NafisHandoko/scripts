v>\n        </form>\n      	ehealth/views/subscription.xml	f	<?xml version="1.0"?>\n<form string="Subscription Product Form" duplicate="0">\n          <sheet>\n            <group>\n              <field name="organization" string="Organization" options="{'no_create': True, 'no_create_edit':True}">\n                <attribute name="required">True</attribute>\n              </field>\n              <field name="subscription_product_id" string="Product" options="{'no_create': True, 'no_create_edit':True}">\n                <attribute name="required">True</attribute>\n              </field>\n              <field name="additional_product_line_ids" string="Additional Products">\n                  <tree editable="bottom">\n                      <field name="product_id"/>\n                      <field name="quantity"/>\n                      <field name="product_uom_id" string="UoM"/>\n                      <field name="active"/>\n                  </tree>\n              </field>\n              <field name="is_team_plan_subscription" invisible="1"/>\n              <field name="transaction_limit" attrs="{'invisible': [('is_team_plan_subscription', '=', False)]}"/>\n              <field name="is_active"/>\n              <field name="next_invoicing"/>\n            </group>\n\n            <!-- Display the linked coupon -->\n            <group>\n                <field name="coupon_id"/>\n            </group>\n\n            <group>\n              <field name="notes"/>\n            </group>\n\n            <notebook>\n              <group string="Subscription Invoice Reference">\n                  <field name="invoice_reference">\n                    <attribute name="required">True</attribute>\n                  </field>\n              </group>\n            </notebook>\n          </sheet>\n\n          <div class="oe_chatter">\n            <field name="message_follower_ids" groups="base.group_user"/>\n            <field name="activity_ids"/>\n            <field name="message_ids"/>\n 
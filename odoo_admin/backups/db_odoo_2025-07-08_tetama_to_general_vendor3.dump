712	report_invoice_document	\N	account.report_invoice_document	16	qweb	<?xml version="1.0"?>\n<t t-name="account.report_invoice_document">\n            <t t-call="web.external_layout">\n                <t t-set="o" t-value="o.with_context(lang=lang)"/>\n                <t t-set="address">\n                    <address t-field="o.partner_id" t-options="{&quot;widget&quot;: &quot;contact&quot;, &quot;fields&quot;: [&quot;address&quot;, &quot;name&quot;], &quot;no_marker&quot;: True}"/>\n                    <div t-if="o.partner_id.vat" class="mt16">\n                        <t t-if="o.company_id.country_id.vat_label" t-esc="o.company_id.country_id.vat_label" id="inv_tax_id_label"/>\n                        <t t-else="">Tax ID</t>: <span t-field="o.partner_id.vat"/></div>\n                </t>\n                <div class="page">\n                    <h2>\n                        <span t-if="o.move_type == 'out_invoice' and o.state == 'posted'">Invoice</span>\n                        <span t-if="o.move_type == 'out_invoice' and o.state == 'draft'">Draft Invoice</span>\n                        <span t-if="o.move_type == 'out_invoice' and o.state == 'cancel'">Cancelled Invoice</span>\n                        <span t-if="o.move_type == 'out_refund'">Credit Note</span>\n                        <span t-if="o.move_type == 'in_refund'">Vendor Credit Note</span>\n                        <span t-if="o.move_type == 'in_invoice'">Vendor Bill</span>\n                        <span t-if="o.name != '/'" t-field="o.name"/>\n                    </h2>\n\n                    <div id="informations" class="row mt32 mb32">\n                        <div class="col-auto col-3 mw-100 mb-2" t-if="o.invoice_date" name="invoice_date">\n                            <strong>Invoice Date:</strong>\n                            <p class="m-0" t-field="o.invoice_date"/>\n                        </div>\n                        <div class="col-auto col-3 mw-100 mb-2" t-if="o.invoice_date_due and o.move_type == 'out_invoice' and o.state == 'posted'" name="due_date">\n                            <strong>Due Date:</strong>\n                            <p class="m-0" t-field="o.invoice_date_due"/>\n                        </div>\n                        <div class="col-auto col-3 mw-100 mb-2" t-if="o.invoice_origin" name="origin">\n                            <strong>Source:</strong>\n                            <p class="m-0" t-field="o.invoice_origin"/>\n                        </div>\n                        <div class="col-auto col-3 mw-100 mb-2" t-if="o.partner_id.ref" name="customer_code">\n                            <strong>Customer Code:</strong>\n                            <p class="m-0" t-field="o.partner_id.ref"/>\n                        </div>\n                        <div class="col-auto col-3 mw-100 mb-2" t-if="o.ref" name="reference">\n                            <strong>Reference:</strong>\n                            <p class="m-0" t-field="o.ref"/>\n                        </div>\n                    </div>\n\n                    <t t-set="display_discount" t-value="any(l.discount for l in o.invoice_line_ids)"/>\n\n                    <table class="table table-sm o_main_table" name="invoice_line_table">\n                        <thead>\n                            <tr>\n                                <th name="th_description" class="text-left"><span>Description</span></th>\n                                <th name="th_quantity" class="text-right"><span>Quantity</span></th>\n                                <th name="th_priceunit" t-attf-class="text-right {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}"><span>Unit Price</span></th>\n                                <th name="th_price_unit" t-if="display_discount" t-attf-class="text-right {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}">\n                                    <span>Disc.%</span>\n                                </th>\n                                <th name="th_taxes" t-attf-class="text-left {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}"><span>Taxes</span></th>\n                                <th name="th_subtotal" class="text-right">\n                                    <span groups="account.group_show_line_subtotals_tax_excluded">Amount</span>\n                                    <span groups="account.group_show_line_subtotals_tax_included">Total Price</span>\n                                </th>\n                            </tr>\n                        </thead>\n                        <tbody class="invoice_tbody">\n                            <t t-set="current_subtotal" t-value="0"/>\n                            <t t-set="lines" t-value="o.invoice_line_ids.sorted(key=lambda l: (-l.sequence, l.date, l.move_name, -l.id), reverse=True)"/>\n\n                            <t t-foreach="lines" t-as="line">\n                                <t t-set="current_subtotal" t-value="current_subtotal + line.price_subtotal" groups="account.group_show_line_subtotals_tax_excluded"/>\n                                <t t-set="current_subtotal" t-value="current_subtotal + line.price_total" groups="account.group_show_line_subtotals_tax_included"/>\n\n                                <tr t-att-class="'bg-200 font-weight-bold o_line_section' if line.display_type == 'line_section' else 'font-italic o_line_note' if line.display_type == 'line_note' else ''">\n                                    <t t-if="not line.display_type" name="account_invoice_line_accountable">\n                                        <td name="account_invoice_line_name"><span t-field="line.name" t-options="{'widget': 'text'}"/></td>\n                                        <td class="text-right">\n                                            <span t-field="line.quantity"/>\n                                            <span t-field="line.product_uom_id" groups="uom.group_uom"/>\n                                        </td>\n                                        <td t-attf-class="text-right {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}">\n                                            <span class="text-nowrap" t-field="line.price_unit"/>\n                                        </td>\n                                        <td t-if="display_discount" t-attf-class="text-right {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}">\n                                            <span class="text-nowrap" t-field="line.discount"/>\n                                        </td>\n                                        <td t-attf-class="text-left {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}">\n                                            <span t-esc="', '.join(map(lambda x: (x.description or x.name), line.tax_ids))" id="line_tax_ids"/>\n                                        </td>\n                                        <td class="text-right o_price_total">\n                                            <span class="text-nowrap" t-field="line.price_subtotal" groups="account.group_show_line_subtotals_tax_excluded"/>\n                                            <span class="text-nowrap" t-field="line.price_total" groups="account.group_show_line_subtotals_tax_included"/>\n                                        </td>\n                                    </t>\n                                    <t t-if="line.display_type == 'line_section'">\n                                        <td colspan="99">\n                                            <span t-field="line.name" t-options="{'widget': 'text'}"/>\n                                        </td>\n                                        <t t-set="current_section" t-value="line"/>\n                                        <t t-set="current_subtotal" t-value="0"/>\n                                    </t>\n                                    <t t-if="line.display_type == 'line_note'">\n                                        <td colspan="99">\n                                            <span t-field="line.name" t-options="{'widget': 'text'}"/>\n                                        </td>\n                                    </t>\n                                </tr>\n\n                                <t t-if="current_section and (line_last or lines[line_index+1].display_type == 'line_section')">\n                                    <tr class="is-subtotal text-right">\n                                        <td colspan="99">\n                                            <strong class="mr16">Subtotal</strong>\n                                            <span t-esc="current_subtotal" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: o.currency_id}"/>\n                                        </td>\n                                    </tr>\n                                </t>\n                            </t>\n                        </tbody>\n                    </table>\n\n                    <div class="clearfix">\n                        <div id="total" class="row">\n                            <div t-attf-class="#{'col-6' if report_type != 'html' else 'col-sm-7 col-md-6'} ml-auto">\n                                <table class="table table-sm" style="page-break-inside: avoid;">\n                                    <tr class="border-black o_subtotal" style="">\n                                        <td><strong>Subtotal</strong></td>\n                                        <td class="text-right">\n                                            <span t-field="o.amount_untaxed"/>\n                                        </td>\n                                    </tr>\n                                    <t t-foreach="o.amount_by_group" t-as="amount_by_group">\n                                        <tr style="">\n                                            <t t-if="len(o.line_ids.filtered(lambda line: line.tax_line_id)) in [0, 1] and o.amount_untaxed == amount_by_group[2]">\n                                                <td><span class="text-nowrap" t-esc="amount_by_group[0]"/></td>\n                                                <td class="text-right o_price_total">\n                                                    <span class="text-nowrap" t-esc="amount_by_group[3]"/>\n                                                </td>\n                                            </t>\n                                            <t t-else="">\n                                                <td>\n                                                    <span t-esc="amount_by_group[0]"/>\n                                                    <span class="text-nowrap"> on\n                                                        <t t-esc="amount_by_group[4]"/>\n                                                    </span>\n                                                </td>\n                                                <td class="text-right o_price_total">\n                                                    <span class="text-nowrap" t-esc="amount_by_group[3]"/>\n                                                </td>\n                                            </t>\n                                        </tr>\n                                    </t>\n                                    <tr class="border-black o_total">\n                                        <td><strong>Total</strong></td>\n                                        <td class="text-right">\n                                            <span class="text-nowrap" t-field="o.amount_total"/>\n                                        </td>\n                                    </tr>\n                                    <t t-if="print_with_payments">\n                                        <t t-if="o.payment_state != 'invoicing_legacy'">\n                                            <t t-set="payments_vals" t-value="o.sudo()._get_reconciled_info_JSON_values()"/>\n                                            <t t-foreach="payments_vals" t-as="payment_vals">\n                                                <tr>\n                                                    <td>\n                                                        <i class="oe_form_field text-right oe_payment_label">Paid on <t t-esc="payment_vals['date']" t-options="{&quot;widget&quot;: &quot;date&quot;}"/></i>\n                                                    </td>\n                                                    <td class="text-right">\n                                                        <span t-esc="payment_vals['amount']" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: o.currency_id}"/>\n                                                    </td>\n                                                </tr>\n                                            </t>\n                                            <t t-if="len(payments_vals) &gt; 0">\n                                                <tr class="border-black">\n                                                    <td><strong>Amount Due</strong></td>\n                                                    <td class="text-right">\n                                                        <span t-field="o.amount_residual"/>\n                                                    </td>\n                                                </tr>\n                                            </t>\n                                        </t>\n                                    </t>\n                                </table>\n                            </div>\n                        </div>\n                    </div>\n                    <p t-if="o.move_type in ('out_invoice', 'in_refund') and o.payment_reference" name="payment_communication">\n                        Please use the following communication for your payment : <b><span t-field="o.payment_reference"/></b>\n                    </p>\n                    <p t-if="o.invoice_payment_term_id" name="payment_term">\n                        <span t-field="o.invoice_payment_term_id.note"/>\n                    </p>\n                    <p t-if="o.narration" name="comment">\n                        <span t-field="o.narration"/>\n                    </p>\n                    <p t-if="o.fiscal_position_id.note" name="note">\n                        <span t-field="o.fiscal_position_id.note"/>\n                    </p>\n                    <p t-if="o.invoice_incoterm_id" name="incoterm">\n                        <strong>Incoterm: </strong><span t-field="o.invoice_incoterm_id.code"/> - <span t-field="o.invoice_incoterm_id.name"/>\n                    </p>\n                    <div id="qrcode" t-if="o.display_qr_code">\n                        <p t-if="qr_code_urls.get(o.id)">\n                            <strong class="text-center">Scan me with your banking app.</strong><br/><br/>\n                            <img class="border border-dark rounded" t-att-src="qr_code_urls[o.id]"/>\n                        </p>\n                    </div>\n                </div>\n            </t>\n        </t>\n\n        	account/views/report_invoice.xml	\N	\N	\N	\N	primary	t	1	2025-06-10 03:55:46.489222	1	2025-06-10 03:55:46.489222	f
713	report_invoice	\N	account.report_invoice	16	qweb	<?xml version="1.0"?>\n<t t-name="account.report_invoice">\n            <t t-call="web.html_container">\n                <t t-foreach="docs" t-as="o">\n                    <t t-set="lang" t-value="o.invoice_user_id.sudo().lang if o.move_type in ('in_invoice', 'in_refund') else o.partner_id.lang"/>\n                    <t t-if="o._get_name_invoice_report() == 'account.report_invoice_document'" t-call="account.report_invoice_document" t-lang="lang"/>\n                </t>\n            </t>\n        </t>\n\n        	account/views/report_invoice.xml	\N	\N	\N	\N	primary	t	1	2025-06-10 03:55:46.489222	1	2025-06-10 03:55:46.489222	f

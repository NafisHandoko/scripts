it_children_ids" context="{'default_model':model,'default_type':type,'default_inherit_id':active_id,'default_mode':'extension'}">\n                                <tree default_order="priority,id">\n                                    <field name="id"/>\n                                    <field name="priority"/>\n                                    <field name="name"/>\n                                    <field name="xml_id"/>\n                                </tree>\n                            </field>\n                        </page>\n                    </notebook>\n                  </sheet>\n                </form>\n            	base/views/ir_ui_view_views.xml	\N	\N	\N	\N	primary	t	1	2025-06-10 03:51:51.249694	1	2025-06-10 03:51:51.249694	\N

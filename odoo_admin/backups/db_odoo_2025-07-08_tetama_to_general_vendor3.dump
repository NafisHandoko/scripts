255	snippet_options_background_options	\N	web_editor.snippet_options_background_options	16	qweb	<?xml version="1.0"?>\n<t t-name="web_editor.snippet_options_background_options">\n    <div t-att-data-js="with_colors and with_color_combinations and 'ColoredLevelBackground' or 'BackgroundToggler'" t-att-data-selector="selector" t-att-data-exclude="exclude" t-att-data-target="target">\n        <we-row t-if="with_colors or with_images" string="Background" class="o_we_full_row">\n            <t t-if="with_colors" t-call="web_editor.snippet_options_background_color_widget"/>\n            <t t-if="with_images">\n                <we-button title="Image" class="ml-auto" data-name="bg_image_toggle_opt" t-att-data-dependencies="images_dependencies" data-toggle-bg-image="true" data-no-preview="true">\n                    <i class="fa fa-fw fa-camera"/>\n                </we-button>\n                <we-button title="Filter" data-name="bg_filter_toggle_opt" data-dependencies="bg_image_toggle_opt" data-toggle-bg-filter="true" data-no-preview="true">\n                    <i class="fa fa-fw fa-paint-brush"/>\n                </we-button>\n                <we-button title="Shape" data-toggle-bg-shape="true" t-att-data-dependencies="images_dependencies" data-no-preview="true" data-img="/web_editor/static/src/img/snippets_options/bg_shape.svg"/>\n            </t>\n        </we-row>\n    </div>\n    <t t-if="with_images">\n        <div data-js="BackgroundImage" t-att-data-selector="selector" t-att-data-exclude="exclude" t-att-data-target="target">\n            <we-row string="⌙ Image">\n                <we-imagepicker title="Edit image" data-background="" data-name="bg_image_opt" data-dependencies="bg_image_opt"/>\n            </we-row>\n            <we-colorpicker string="  ⌙ Dynamic color" data-dynamic-color="true" data-name="dynamic_color_opt"/>\n        </div>\n\n        <div data-js="BackgroundPosition" t-att-data-selector="selector" t-att-data-exclude="exclude" t-att-data-target="
t" src="/web/static/tests/control_panel/comparison_menu_tests.js"/>\n        <script type="text/javascript" src="/web/static/tests/control_panel/favorite_menu_tests.js"/>\n        <script type="text/javascript" src="/web/static/tests/control_panel/custom_filter_item_tests.js"/>\n        <script type="text/javascript" src="/web/static/tests/control_panel/filter_menu_tests.js"/>\n        <script type="text/javascript" src="/web/static/tests/control_panel/custom_group_by_item_tests.js"/>\n        <script type="text/javascript" src="/web/static/tests/control_panel/groupby_menu_tests.js"/>\n        <script type="text/javascript" src="/web/static/tests/control_panel/search_bar_tests.js"/>\n        <script type="text/javascript" src="/web/static/tests/control_panel/search_utils_tests.js"/>\n\n        <script type="text/javascript" src="/web/static/tests/widgets/company_switcher_tests.js"/>\n        <script type="text/javascript" src="/web/static/tests/widgets/data_export_tests.js"/>\n        <script type="text/javascript" src="/web/static/tests/widgets/domain_selector_tests.js"/>\n        <script type="text/javascript" src="/web/static/tests/widgets/model_field_selector_tests.js"/>\n        <script type="text/javascript" src="/web/static/tests/widgets/rainbow_man_tests.js"/>\n\n        <script type="text/javascript" src="/web/static/tests/tools/debug_manager_tests.js"/>\n\n        <script type="text/javascript" src="/web/static/tests/helpers/test_utils_tests.js"/>\n\n        <script type="text/javascript" src="/web/static/tests/owl_compatibility_tests.js"/>\n        <script type="text/javascript" src="/web/static/tests/component_extension_tests.js"/>\n    </t>\n\n    	web/views/webclient_templates.xml	\N	\N	\N	\N	primary	t	1	2025-06-10 03:52:06.216302	1	2025-06-10 03:52:06.216302	\N
406	analytic.analytic.account.form	account.analytic.account	\N	16	form	<?xml version="1.0"?>\n<form string="Analytic Account">\n                    <sheet string="Analytic Account">\n                        <div class="oe_button_box" name="button_box">\n                            <button class="oe_stat_button" type="action" name="128" icon="fa-usd" string="Cost/Revenue" widget="statinfo"/>\n                        </div>\n                        <widget name="web_ribbon" title="Archived" bg_color="bg-danger" attrs="{'invisible': [('active', '=', True)]}"/>\n                        <div class="oe_title">\n                            <label for="name" class="oe_edit_only"/>\n                            <h1>\n                                <field name="name" class="oe_inline" placeholder="e.g. Project XYZ"/>\n                            </h1>\n                        </div>\n                        <div name="project"/>\n                        <group name="main">\n                            <group>\n                                <field name="active" invisible="1"/>\n                                <field name="code"/>\n                                <field name="partner_id"/>\n                            </group>\n                            <group>\n                                <field name="group_id"/>\n                                <field name="company_id" options="{'no_create': True}" groups="base.group_multi_company"/>\n                                <field name="currency_id" options="{'no_create': True}" groups="base.group_multi_currency"/>\n                            </group>\n                        </group>\n                    </sheet>\n                    <div class="oe_chatter">\n                        <field name="message_follower_ids"/>\n                        <field name="message_ids"/>\n                    </div>\n                </form>\n            	analytic/views/analytic_account_views.xml	\N	\N	\N	\N	primary	t	1	2025-06-10 03:55:31.03
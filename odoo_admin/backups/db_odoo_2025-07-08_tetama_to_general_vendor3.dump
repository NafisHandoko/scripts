    id integer NOT NULL,
    message_main_attachment_id integer,
    access_token character varying,
    organization integer,
    prefix_name character varying,
    given_name character varying,
    family_name character varying NOT NULL,
    suffix_name character varying,
    display_name character varying,
    has_access_all_location boolean,
    role character varying,
    email character varying NOT NULL,
    phone character varying,
    is_active character varying NOT NULL,
    gender character varying NOT NULL,
    kode_dokter_bpjs character varying,
    bpjs_icare_username character varying,
    bpjs_icare_password character varying,
    sip character varying,
    sipa character varying,
    nik character varying,

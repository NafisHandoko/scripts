1062	new_external_layout	\N	ehealth.new_external_layout	16	qweb	<?xml version="1.0"?>\n<t t-name="ehealth.new_external_layout">\n      <t t-if="not o" t-set="o" t-value="doc"/>\n\n      <t t-if="not company">\n          <!-- Multicompany -->\n          <t t-if="company_id">\n              <t t-set="company" t-value="company_id"/>\n          </t>\n          <t t-elif="o and 'company_id' in o and o.company_id.sudo()">\n              <t t-set="company" t-value="o.company_id.sudo()"/>\n          </t>\n          <t t-else="else">\n              <t t-set="company" t-value="res_company"/>\n          </t>\n      </t>\n      \n      <t t-call="ehealth.external_layout_standard"><t t-raw="0"/></t>\n    </t>\n\n    	ehealth/views/report_invoice.xml	f	<?xml version="1.0"?>\n<t t-name="ehealth.new_external_layout">\n      <t t-if="not o" t-set="o" t-value="doc"/>\n\n      <t t-if="not company">\n          <!-- Multicompany -->\n          <t t-if="company_id">\n              <t t-set="company" t-value="company_id"/>\n          </t>\n          <t t-elif="o and 'company_id' in o and o.company_id.sudo()">\n              <t t-set="company" t-value="o.company_id.sudo()"/>\n          </t>\n          <t t-else="else">\n              <t t-set="company" t-value="res_company"/>\n          </t>\n      </t>\n      \n      <t t-call="ehealth.external_layout_standard"><t t-raw="0"/></t>\n    </t>\n\n    	\N	\N	primary	t	1	2025-06-10 03:58:32.888888	1	2025-06-10 04:22:06.139859	f
1063	report_new_invoice_document	\N	ehealth.report_new_invoice_document	16	qweb	<?xml version="1.0"?>\n<t t-name="ehealth.report_new_invoice_document">\n      <t t-call="ehealth.new_external_layout">\n        <t t-set="o" t-value="o.with_context(lang=lang)"/>\n        <div style="margin: -50px 30px;">\n          <div class="row" style="font-size: 16px; font-weight: 800; color: rgba(25, 142, 179, 1);">\n            <div class="col-12">Billing to:</div>\n          </div>\n\n          <div class="row">\n            <div class="col-6">\n              <div style="font-size: 28px; font-weight: 800;">\n                <t t-esc="o.partner_id.name"/>\n              </div>\n              <div style="font-size: 16px; font-weight: 500;">\n                <div><t t-esc="o.partner_id.street"/></div>\n                <div><t t-esc="o.partner_id.village.name"/> - <t t-esc="o.partner_id.district.name"/> - <t t-esc="o.partner_id.regency.name"/></div>\n                <div><t t-esc="o.partner_id.zip"/></div>\n                <div><t t-esc="o.partner_id.country_id.name"/></div>\n              </div>\n            </div>\n            <div class="col-2"/>\n            <div class="col-4">\n              <div class="row" style="font-size: 16px; font-weight: 800;">\n                Invoice Number:\n              </div>\n              <div class="row" style="font-size: 16px; font-weight: 500;">\n                <span t-if="o.name != '/'" t-field="o.name"/>\n              </div>\n              <div class="row" style="font-size: 16px; font-weight: 800;">\n                Invoice Date:\n              </div>\n              <div class="row" style="font-size: 16px; font-weight: 500;">\n                <span t-esc="o.invoice_date and o.invoice_date.strftime('%d/%m/%Y') or ''"/>\n              </div>\n              <div class="row" style="font-size: 16px; font-weight: 800;">\n                Due Date:\n              </div>\n              <div class="row" style="font-size: 16px; font-weight: 500;">\n                <span t-esc="o.invoice_date_due and o.invoice_date_due.strftime('%d/%m/%Y') or ''"/>\n              </div>\n              <t t-if="o.subscription_id">\n                <div class="row" style="font-size: 16px; font-weight: 800;">\n                  Subscription Period:\n                </div>\n                <div class="row" style="font-size: 16px; font-weight: 500;">\n                  <span> \n                    from \n                    <t t-if="len(o.invoice_line_ids) &gt; 1">\n                      <span t-esc="o.invoice_line_ids[0].start_date and o.invoice_line_ids[0].start_date.strftime('%d/%m/%Y') or ''"/>\n                    </t>\n                    <t t-if="len(o.invoice_line_ids) == 1">\n                      <span t-esc="o.invoice_line_ids.start_date and o.invoice_line_ids.start_date.strftime('%d/%m/%Y') or ''"/>\n                    </t>\n                    to \n                    <t t-if="len(o.invoice_line_ids) &gt; 1">\n                      <span t-esc="o.invoice_line_ids[0].end_date and o.invoice_line_ids[0].end_date.strftime('%d/%m/%Y') or ''"/>\n                    </t>\n                    <t t-if="len(o.invoice_line_ids) == 1">\n                      <span t-esc="o.invoice_line_ids.end_date and o.invoice_line_ids.end_date.strftime('%d/%m/%Y') or ''"/>\n                    </t>\n                  </span>\n                </div>\n              </t>\n            </div>\n          </div>\n\n          \n          <t t-set="display_discount" t-value="any(l.discount for l in o.invoice_line_ids)"/>\n\n          <table class="table table-sm o_main_table" name="invoice_line_table" style="margin-top: 40px; border-top: 2px solid #6C757D; border-bottom: 2px solid #6C757D; color: #4C4C4C;">\n              <thead style="border-bottom: 2px solid #6C757D; background-color: #EFFAFD;">\n                  <tr>\n                      <th name="th_description" class="text-left" style="padding: 12px 8px;"><span>Description</span></th>\n                      <th name="th_quantity" class="text-right" style="padding: 12px 8px; border-left: 1px solid #E2E2E0; border-right: 1px solid #E2E2E0;"><span>Quantity</span></th>\n                      <th name="th_priceunit" t-attf-class="text-right {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}" style="padding: 12px 8px; border-left: 1px solid #E2E2E0; border-right: 1px solid #E2E2E0;"><span>Unit Price</span></th>\n                      <th name="th_price_unit" t-if="display_discount" t-attf-class="text-right {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}" style="padding: 12px 8px; border-left: 1px solid #E2E2E0; border-right: 1px solid #E2E2E0;">\n                          <span>Disc.%</span>\n                      </th>\n                      <th name="th_taxes" t-attf-class="text-left {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}" style="padding: 12px 8px; border-left: 1px solid #E2E2E0; border-right: 1px solid #E2E2E0;"><span>Taxes</span></th>\n                      <th name="th_subtotal" class="text-right" style="padding: 12px 8px;">\n                          <span groups="account.group_show_line_subtotals_tax_excluded">Amount</span>\n                          <span groups="account.group_show_line_subtotals_tax_included">Total Price</span>\n                      </th>\n                  </tr>\n              </thead>\n              <tbody class="invoice_tbody">\n                  <t t-set="current_subtotal" t-value="0"/>\n                  <t t-set="lines" t-value="o.invoice_line_ids.sorted(key=lambda l: (-l.sequence, l.date, l.move_name, -l.id), reverse=True)"/>\n\n                  <t t-foreach="lines" t-as="line">\n                      <t t-set="current_subtotal" t-value="current_subtotal + line.price_subtotal" groups="account.group_show_line_subtotals_tax_excluded"/>\n                      <t t-set="current_subtotal" t-value="current_subtotal + line.price_total" groups="account.group_show_line_subtotals_tax_included"/>\n\n                      <tr t-att-class="'bg-200 font-weight-bold o_line_section' if line.display_type == 'line_section' else 'font-italic o_line_note' if line.display_type == 'line_note' else ''">\n                          <t t-if="not line.display_type" name="account_invoice_line_accountable">\n                              <td name="account_invoice_line_name" style="padding: 6px 8px;"><span t-field="line.name" t-options="{'widget': 'text'}"/></td>\n                              <td class="text-right" style="padding: 6px 8px; border-left: 1px solid #E2E2E0; border-right: 1px solid #E2E2E0;">\n                                  <span t-field="line.quantity"/>\n                                  <span t-field="line.product_uom_id" groups="uom.group_uom"/>\n                              </td>\n                              <td t-attf-class="text-right {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}" style="padding: 6px 8px; border-left: 1px solid #E2E2E0; border-right: 1px solid #E2E2E0;">\n                                  <span class="text-nowrap" t-field="line.price_unit"/>\n                              </td>\n                              <td t-if="display_discount" t-attf-class="text-right {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}" style="padding: 6px 8px; border-left: 1px solid #E2E2E0; border-right: 1px solid #E2E2E0;">\n                                  <span class="text-nowrap" t-field="line.discount"/>\n                              </td>\n                              <td t-attf-class="text-left {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}" style="padding: 6px 8px; border-left: 1px solid #E2E2E0; border-right: 1px solid #E2E2E0;">\n                                  <span t-esc="', '.join(map(lambda x: (x.description or x.name), line.tax_ids))" id="line_tax_ids"/>\n                              </td>\n                              <td class="text-right o_price_total" style="padding: 6px 8px;">\n                                  <!-- <span class="text-nowrap" t-field="line.price_subtotal" groups="account.group_show_line_subtotals_tax_excluded"/>\n                                  <span class="text-nowrap" t-field="line.price_total" groups="account.group_show_line_subtotals_tax_included"/> -->\n                                  <span class="text-nowrap" t-field="line.price_before_discount"/>\n                                  <div class="text-nowrap text-danger" t-if="line.discount_value &gt; 0">\n                                    <span t-field="line.discount_value"/>\n                                  </div>\n                              </td>\n                          </t>\n                          <t t-if="line.display_type == 'line_section'">\n                              <td colspan="99" style="padding: 6px 8px;">\n                                  <span t-field="line.name" t-options="{'widget': 'text'}"/>\n                              </td>\n                              <t t-set="current_section" t-value="line"/>\n                              <t t-set="current_subtotal" t-value="0"/>\n                          </t>\n                          <t t-if="line.display_type == 'line_note'">\n                              <td colspan="99" style="padding: 6px 8px;">\n                                  <span t-field="line.name" t-options="{'widget': 'text'}"/>\n                              </td>\n                          </t>\n                      </tr>\n\n                      <t t-if="current_section and (line_last or lines[line_index+1].display_type == 'line_section')">\n                          <tr class="is-subtotal text-right">\n                              <td colspan="99" style="padding: 6px 8px;">\n                                  <strong class="mr16">Subtotal</strong>\n                                  <span t-esc="current_subtotal" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: o.currency_id}"/>\n                              </td>\n                          </tr>\n                      </t>\n                  </t>\n              </tbody>\n          </table>\n\n          <div class="clearfix">\n              <div id="total" class="row">\n                  <div t-attf-class="#{'col-6' if report_type != 'html' else 'col-sm-7 col-md-6'} ml-auto">\n                      <table class="table table-sm" style="page-break-inside: avoid; border-top: 2px solid #6C757D; border-bottom: 2px solid #6C757D; color: #4C4C4C;">\n                          <tr class="border-black o_subtotal" style="">\n                              <td style="padding: 6px 8px; border-right: 1px solid #E2E2E0;"><strong>Subtotal</strong></td>\n                              <td class="text-right" style="padding: 6px 8px;">\n                                  <span t-field="o.amount_without_discount"/>\n                              </td>\n                          </tr>\n                          <tr class="border-black o_discount" style="">\n                              <td style="padding: 6px 8px; border-right: 1px solid #E2E2E0;"><strong>Discount</strong></td>\n                              <td class="text-right" style="padding: 6px 8px;">\n                                  <span t-field="o.total_discount"/>\n                              </td>\n                          </tr>\n                          <t t-foreach="o.amount_by_group" t-as="amount_by_group">\n                              <tr style="">\n                                  <t t-if="len(o.line_ids.filtered(lambda line: line.tax_line_id)) in [0, 1] and float_compare(o.amount_untaxed, amount_by_group[2], precision_rounding=o.currency_id.rounding) == 0 ">\n                                      <td style="padding: 6px 8px; border-right: 1px solid #E2E2E0;"><span class="text-nowrap" t-esc="amount_by_group[0]"/></td>\n                                      <td class="text-right o_price_total" style="padding: 6px 8px;">\n                                          <span class="text-nowrap" t-esc="amount_by_group[3]"/>\n                                      </td>\n                                  </t>\n                                  <t t-else="">\n                                      <td style="padding: 6px 8px; border-right: 1px solid #E2E2E0;">\n                                          <span t-esc="amount_by_group[0]"/>\n                                          <span class="text-nowrap"> on\n                                              <t t-esc="amount_by_group[4]"/>\n                                          </span>\n                                      </td>\n                                      <td class="text-right o_price_total" style="padding: 6px 8px;">\n                                          <span class="text-nowrap" t-esc="amount_by_group[3]"/>\n                                      </td>\n                                  </t>\n                              </tr>\n                          </t>\n                          <tr class="border-black">\n                              <td style="padding: 6px 8px; border-right: 1px solid #E2E2E0;"><strong>Total</strong></td>\n                              <td class="text-right" style="padding: 6px 8px;">\n                                  <span class="text-nowrap" t-field="o.amount_total"/>\n                              </td>\n                          </tr>\n                          <t t-if="print_with_payments">\n                              <t t-if="o.payment_state != 'invoicing_legacy'">\n                                  <t t-set="payments_vals" t-value="o.sudo()._get_reconciled_info_JSON_values()"/>\n                                  <t t-foreach="payments_vals" t-as="payment_vals">\n                                      <tr>\n                                          <td style="padding: 6px 8px; border-right: 1px solid #E2E2E0;">\n                                              <i class="oe_form_field text-right oe_payment_label">Paid on <t t-esc="payment_vals['date']" t-options="{&quot;widget&quot;: &quot;date&quot;}"/></i>\n                                          </td>\n                                          <td class="text-right" style="padding: 6px 8px;">\n                                              <span t-esc="payment_vals['amount']" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: o.currency_id}"/>\n                                          </td>\n                                      </tr>\n                                  </t>\n                                  <t t-if="len(payments_vals) &gt; 0">\n                                      <tr class="border-black font-weight-bold">\n                                          <td style="padding: 6px 8px; border-right: 1px solid #E2E2E0;">Amount Due</td>\n                                          <td class="text-right" style="padding: 6px 8px;">\n                                              <span t-field="o.amount_residual"/>\n                                          </td>\n                                      </tr>\n                                  </t>\n                              </t>\n                          </t>\n                      </table>\n                  </div>\n              </div>\n          </div>\n\n          <div class="row" style="margin-top:40px;">\n            <div class="col-8">\n              <t t-if="o.narration">\n                <div style="font-size: 16px; font-weight: 800; color: #2AAFD3; margin-bottom: 6px;">Terms &amp; Conditions:</div>\n                <div style="font-size: 16px; font-weight: 500;">\n                  <span t-field="o.narration"/>\n                </div>\n              </t>\n              <t t-if="o.notes">\n                <div style="font-size: 16px; font-weight: 800; color: #2AAFD3; margin-bottom: 6px;">Notes:</div>\n                <div style="font-size: 16px; font-weight: 500;">\n                  <span t-field="o.notes"/>\n                </div>\n              </t>\n              <div style="font-size: 16px; font-weight: 800; color: #2AAFD3; margin-top: 20px; margin-bottom: 6px;">Payment Info:</div>\n              <div style="font-size: 16px; font-weight: 500;">\n                <div class="row">\n                  <div class="col-5" style="font-size: 16px; font-weight: 800;">Bank Account Number</div>\n                  <div class="col-7" style="font-size: 16px; font-weight: 500;">: BCA 0869927777</div> \n                </div>\n                <div class="row">\n                  <div class="col-5" style="font-size: 16px; font-weight: 800;">Account Name</div>\n                  <div class="col-7" style="font-size: 16px; font-weight: 500;">: PT Aksara Digital Indonesia</div> \n                </div>\n              </div>\n            </div>\n            \n            <t t-if="print_with_payments">\n              <div class="col-4" style="">\n                <div class="text-center" style="font-size: 16px; font-weight: 800;">President Director</div>\n                <div style="height: 100px;"><img src="/ehealth/static/src/image/stamp.png" style="width: 150px; height: 150px; margin: -20px 0 -20px -80px;"/></div>\n                <div class="text-center" style="border-top: 1px solid #A8E1F1; font-size: 16px; font-weight: 500; padding-top: 4px;">Ibrohim Kholilul Islam </div> \n              </div>\n            </t>\n          </div>\n        </div>\n      </t>\n    </t>\n\n    	ehealth/views/report_invoice.xml	f	<?xml version="1.0"?>\n<t t-name="ehealth.report_new_invoice_document">\n      <t t-call="ehealth.new_external_layout">\n        <t t-set="o" t-value="o.with_context(lang=lang)"/>\n        <div style="margin: -50px 30px;">\n          <div class="row" style="font-size: 16px; font-weight: 800; color: rgba(25, 142, 179, 1);">\n            <div class="col-12">Billing to:</div>\n          </div>\n\n          <div class="row">\n            <div class="col-6">\n              <div style="font-size: 28px; font-weight: 800;">\n                <t t-esc="o.partner_id.name"/>\n              </div>\n              <div style="font-size: 16px; font-weight: 500;">\n                <div><t t-esc="o.partner_id.street"/></div>\n                <div><t t-esc="o.partner_id.village.name"/> - <t t-esc="o.partner_id.district.name"/> - <t t-esc="o.partner_id.regency.name"/></div>\n                <div><t t-esc="o.partner_id.zip"/></div>\n                <div><t t-esc="o.partner_id.country_id.name"/></div>\n              </div>\n            </div>\n            <div class="col-2"/>\n            <div class="col-4">\n              <div class="row" style="font-size: 16px; font-weight: 800;">\n                Invoice Number:\n              </div>\n              <div class="row" style="font-size: 16px; font-weight: 500;">\n                <span t-if="o.name != '/'" t-field="o.name"/>\n              </div>\n              <div class="row" style="font-size: 16px; font-weight: 800;">\n                Invoice Date:\n              </div>\n              <div class="row" style="font-size: 16px; font-weight: 500;">\n                <span t-esc="o.invoice_date and o.invoice_date.strftime('%d/%m/%Y') or ''"/>\n              </div>\n              <div class="row" style="font-size: 16px; font-weight: 800;">\n                Due Date:\n              </div>\n              <div class="row" style="font-size: 16px; font-weight: 500;">\n                <span t-esc="o.invoice_date_due and o.invoice_date_due.strftime('%d/%m/%Y') or ''"/>\n              </div>\n              <t t-if="o.subscription_id">\n                <div class="row" style="font-size: 16px; font-weight: 800;">\n                  Subscription Period:\n                </div>\n                <div class="row" style="font-size: 16px; font-weight: 500;">\n                  <span> \n                    from \n                    <t t-if="len(o.invoice_line_ids) &gt; 1">\n                      <span t-esc="o.invoice_line_ids[0].start_date and o.invoice_line_ids[0].start_date.strftime('%d/%m/%Y') or ''"/>\n                    </t>\n                    <t t-if="len(o.invoice_line_ids) == 1">\n                      <span t-esc="o.invoice_line_ids.start_date and o.invoice_line_ids.start_date.strftime('%d/%m/%Y') or ''"/>\n                    </t>\n                    to \n                    <t t-if="len(o.invoice_line_ids) &gt; 1">\n                      <span t-esc="o.invoice_line_ids[0].end_date and o.invoice_line_ids[0].end_date.strftime('%d/%m/%Y') or ''"/>\n                    </t>\n                    <t t-if="len(o.invoice_line_ids) == 1">\n                      <span t-esc="o.invoice_line_ids.end_date and o.invoice_line_ids.end_date.strftime('%d/%m/%Y') or ''"/>\n                    </t>\n                  </span>\n                </div>\n              </t>\n            </div>\n          </div>\n\n          \n          <t t-set="display_discount" t-value="any(l.discount for l in o.invoice_line_ids)"/>\n\n          <table class="table table-sm o_main_table" name="invoice_line_table" style="margin-top: 40px; border-top: 2px solid #6C757D; border-bottom: 2px solid #6C757D; color: #4C4C4C;">\n              <thead style="border-bottom: 2px solid #6C757D; background-color: #EFFAFD;">\n                  <tr>\n                      <th name="th_description" class="text-left" style="padding: 12px 8px;"><span>Description</span></th>\n                      <th name="th_quantity" class="text-right" style="padding: 12px 8px; border-left: 1px solid #E2E2E0; border-right: 1px solid #E2E2E0;"><span>Quantity</span></th>\n                      <th name="th_priceunit" t-attf-class="text-right {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}" style="padding: 12px 8px; border-left: 1px solid #E2E2E0; border-right: 1px solid #E2E2E0;"><span>Unit Price</span></th>\n                      <th name="th_price_unit" t-if="display_discount" t-attf-class="text-right {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}" style="padding: 12px 8px; border-left: 1px solid #E2E2E0; border-right: 1px solid #E2E2E0;">\n                          <span>Disc.%</span>\n                      </th>\n                      <th name="th_taxes" t-attf-class="text-left {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}" style="padding: 12px 8px; border-left: 1px solid #E2E2E0; border-right: 1px solid #E2E2E0;"><span>Taxes</span></th>\n                      <th name="th_subtotal" class="text-right" style="padding: 12px 8px;">\n                          <span groups="account.group_show_line_subtotals_tax_excluded">Amount</span>\n                          <span groups="account.group_show_line_subtotals_tax_included">Total Price</span>\n                      </th>\n                  </tr>\n              </thead>\n              <tbody class="invoice_tbody">\n                  <t t-set="current_subtotal" t-value="0"/>\n                  <t t-set="lines" t-value="o.invoice_line_ids.sorted(key=lambda l: (-l.sequence, l.date, l.move_name, -l.id), reverse=True)"/>\n\n                  <t t-foreach="lines" t-as="line">\n                      <t t-set="current_subtotal" t-value="current_subtotal + line.price_subtotal" groups="account.group_show_line_subtotals_tax_excluded"/>\n                      <t t-set="current_subtotal" t-value="current_subtotal + line.price_total" groups="account.group_show_line_subtotals_tax_included"/>\n\n                      <tr t-att-class="'bg-200 font-weight-bold o_line_section' if line.display_type == 'line_section' else 'font-italic o_line_note' if line.display_type == 'line_note' else ''">\n                          <t t-if="not line.display_type" name="account_invoice_line_accountable">\n                              <td name="account_invoice_line_name" style="padding: 6px 8px;"><span t-field="line.name" t-options="{'widget': 'text'}"/></td>\n                              <td class="text-right" style="padding: 6px 8px; border-left: 1px solid #E2E2E0; border-right: 1px solid #E2E2E0;">\n                                  <span t-field="line.quantity"/>\n                                  <span t-field="line.product_uom_id" groups="uom.group_uom"/>\n                              </td>\n                              <td t-attf-class="text-right {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}" style="padding: 6px 8px; border-left: 1px solid #E2E2E0; border-right: 1px solid #E2E2E0;">\n                                  <span class="text-nowrap" t-field="line.price_unit"/>\n                              </td>\n                              <td t-if="display_discount" t-attf-class="text-right {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}" style="padding: 6px 8px; border-left: 1px solid #E2E2E0; border-right: 1px solid #E2E2E0;">\n                                  <span class="text-nowrap" t-field="line.discount"/>\n                              </td>\n                              <td t-attf-class="text-left {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}" style="padding: 6px 8px; border-left: 1px solid #E2E2E0; border-right: 1px solid #E2E2E0;">\n                                  <span t-esc="', '.join(map(lambda x: (x.description or x.name), line.tax_ids))" id="line_tax_ids"/>\n                              </td>\n                              <td class="text-right o_price_total" style="padding: 6px 8px;">\n                                  <!-- <span class="text-nowrap" t-field="line.price_subtotal" groups="account.group_show_line_subtotals_tax_excluded"/>\n                                  <span class="text-nowrap" t-field="line.price_total" groups="account.group_show_line_subtotals_tax_included"/> -->\n                                  <span class="text-nowrap" t-field="line.price_before_discount"/>\n                                  <div class="text-nowrap text-danger" t-if="line.discount_value &gt; 0">\n                                    <span t-field="line.discount_value"/>\n                                  </div>\n                              </td>\n                          </t>\n                          <t t-if="line.display_type == 'line_section'">\n                              <td colspan="99" style="padding: 6px 8px;">\n                                  <span t-field="line.name" t-options="{'widget': 'text'}"/>\n                              </td>\n                              <t t-set="current_section" t-value="line"/>\n                              <t t-set="current_subtotal" t-value="0"/>\n                          </t>\n                          <t t-if="line.display_type == 'line_note'">\n                              <td colspan="99" style="padding: 6px 8px;">\n                                  <span t-field="line.name" t-options="{'widget': 'text'}"/>\n                              </td>\n                          </t>\n                      </tr>\n\n                      <t t-if="current_section and (line_last or lines[line_index+1].display_type == 'line_section')">\n                          <tr class="is-subtotal text-right">\n                              <td colspan="99" style="padding: 6px 8px;">\n                                  <strong class="mr16">Subtotal</strong>\n                                  <span t-esc="current_subtotal" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: o.currency_id}"/>\n                              </td>\n                          </tr>\n                      </t>\n                  </t>\n              </tbody>\n          </table>\n\n          <div class="clearfix">\n              <div id="total" class="row">\n                  <div t-attf-class="#{'col-6' if report_type != 'html' else 'col-sm-7 col-md-6'} ml-auto">\n                      <table class="table table-sm" style="page-break-inside: avoid; border-top: 2px solid #6C757D; border-bottom: 2px solid #6C757D; color: #4C4C4C;">\n                          <tr class="border-black o_subtotal" style="">\n                              <td style="padding: 6px 8px; border-right: 1px solid #E2E2E0;"><strong>Subtotal</strong></td>\n                              <td class="text-right" style="padding: 6px 8px;">\n                                  <span t-field="o.amount_without_discount"/>\n                              </td>\n                          </tr>\n                          <tr class="border-black o_discount" style="">\n                              <td style="padding: 6px 8px; border-right: 1px solid #E2E2E0;"><strong>Discount</strong></td>\n                              <td class="text-right" style="padding: 6px 8px;">\n                                  <span t-field="o.total_discount"/>\n                              </td>\n                          </tr>\n                          <t t-foreach="o.amount_by_group" t-as="amount_by_group">\n                              <tr style="">\n                                  <t t-if="len(o.line_ids.filtered(lambda line: line.tax_line_id)) in [0, 1] and float_compare(o.amount_untaxed, amount_by_group[2], precision_rounding=o.currency_id.rounding) == 0 ">\n                                      <td style="padding: 6px 8px; border-right: 1px solid #E2E2E0;"><span class="text-nowrap" t-esc="amount_by_group[0]"/></td>\n                                      <td class="text-right o_price_total" style="padding: 6px 8px;">\n                                          <span class="text-nowrap" t-esc="amount_by_group[3]"/>\n                                      </td>\n                                  </t>\n                                  <t t-else="">\n                                      <td style="padding: 6px 8px; border-right: 1px solid #E2E2E0;">\n                                          <span t-esc="amount_by_group[0]"/>\n                                          <span class="text-nowrap"> on\n                                              <t t-esc="amount_by_group[4]"/>\n                                          </span>\n                                      </td>\n                                      <td class="text-right o_price_total" style="padding: 6px 8px;">\n                                          <span class="text-nowrap" t-esc="amount_by_group[3]"/>\n                                      </td>\n                                  </t>\n                              </tr>\n                          </t>\n                          <tr class="border-black">\n                              <td style="padding: 6px 8px; border-right: 1px solid #E2E2E0;"><strong>Total</strong></td>\n                              <td class="text-right" style="padding: 6px 8px;">\n                                  <span class="text-nowrap" t-field="o.amount_total"/>\n                              </td>\n                          </tr>\n                          <t t-if="print_with_payments">\n                              <t t-if="o.payment_state != 'invoicing_legacy'">\n                                  <t t-set="payments_vals" t-value="o.sudo()._get_reconciled_info_JSON_values()"/>\n                                  <t t-foreach="payments_vals" t-as="payment_vals">\n                                      <tr>\n                                          <td style="padding: 6px 8px; border-right: 1px solid #E2E2E0;">\n                                              <i class="oe_form_field text-right oe_payment_label">Paid on <t t-esc="payment_vals['date']" t-options="{&quot;widget&quot;: &quot;date&quot;}"/></i>\n                                          </td>\n                                          <td class="text-right" style="padding: 6px 8px;">\n                                              <span t-esc="payment_vals['amount']" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: o.currency_id}"/>\n                                          </td>\n                                      </tr>\n                                  </t>\n                                  <t t-if="len(payments_vals) &gt; 0">\n                                      <tr class="border-black font-weight-bold">\n                                          <td style="padding: 6px 8px; border-right: 1px solid #E2E2E0;">Amount Due</td>\n                                          <td class="text-right" style="padding: 6px 8px;">\n                                              <span t-field="o.amount_residual"/>\n                                          </td>\n                                      </tr>\n                                  </t>\n                              </t>\n                          </t>\n                      </table>\n                  </div>\n              </div>\n          </div>\n\n          <div class="row" style="margin-top:40px;">\n            <div class="col-8">\n              <t t-if="o.narration">\n                <div style="font-size: 16px; font-weight: 800; color: #2AAFD3; margin-bottom: 6px;">Terms &amp; Conditions:</div>\n                <div style="font-size: 16px; font-weight: 500;">\n                  <span t-field="o.narration"/>\n                </div>\n              </t>\n              <t t-if="o.notes">\n                <div style="font-size: 16px; font-weight: 800; color: #2AAFD3; margin-bottom: 6px;">Notes:</div>\n                <div style="font-size: 16px; font-weight: 500;">\n                  <span t-field="o.notes"/>\n                </div>\n              </t>\n              <div style="font-size: 16px; font-weight: 800; color: #2AAFD3; margin-top: 20px; margin-bottom: 6px;">Payment Info:</div>\n              <div style="font-size: 16px; font-weight: 500;">\n                <div class="row">\n                  <div class="col-5" style="font-size: 16px; font-weight: 800;">Bank Account Number</div>\n                  <div class="col-7" style="font-size: 16px; font-weight: 500;">: BCA 0869927777</div> \n                </div>\n                <div class="row">\n                  <div class="col-5" style="font-size: 16px; font-weight: 800;">Account Name</div>\n                  <div class="col-7" style="font-size: 16px; font-weight: 500;">: PT Aksara Digital Indonesia</div> \n                </div>\n              </div>\n            </div>\n            \n            <t t-if="print_with_payments">\n              <div class="col-4" style="">\n                <div class="text-center" style="font-size: 16px; font-weight: 800;">President Director</div>\n                <div style="height: 100px;"><img src="/ehealth/static/src/image/stamp.png" style="width: 150px; height: 150px; margin: -20px 0 -20px -80px;"/></div>\n                <div class="text-center" style="border-top: 1px solid #A8E1F1; font-size: 16px; font-weight: 500; padding-top: 4px;">Ibrohim Kholilul Islam </div> \n              </div>\n            </t>\n          </div>\n        </div>\n      </t>\n    </t>\n\n    	\N	\N	primary	t	1	2025-06-10 03:58:32.888888	1	2025-06-10 04:22:06.139859	f
1064	report_new_invoice	\N	ehealth.report_new_invoice	16	qweb	<?xml version="1.0"?>\n<t t-name="ehealth.report_new_invoice">\n        <t t-call="web.html_container">\n            <t t-foreach="docs" t-as="o">\n                <t t-set="lang" t-value="o.partner_id.lang"/>\n                <t t-call="ehealth.report_new_invoice_document" t-lang="lang"/>\n            </t>\n        </t>\n    </t>\n\n    	ehealth/views/report_invoice.xml	f	<?xml version="1.0"?>\n<t t-name="ehealth.report_new_invoice">\n        <t t-call="web.html_container">\n            <t t-foreach="docs" t-as="o">\n                <t t-set="lang" t-value="o.partner_id.lang"/>\n                <t t-call="ehealth.report_new_invoice_document" t-lang="lang"/>\n            </t>\n        </t>\n    </t>\n\n    	\N	\N	primary	t	1	2025-06-10 03:58:32.888888	1	2025-06-10 04:22:06.139859	f
799	utm.campaign.view.form	utm.campaign	\N	16	form	<?xml version="1.0"?>\n<xpath expr="//div[hasclass('oe_button_box')]" position="inside">\n                <button name="action_redirect_to_leads_opportunities" type="object" class="oe_stat_button order-3" icon="fa-star" groups="sales_team.group_sale_salesman">\n                    <div class="o_field_widget o_stat_info">\n                        <field name="use_leads" invisible="1"/>\n                        <span class="o_stat_value"><field nolabel="1" name="crm_lead_count"/></span>\n                        <span class="o_stat_text" attrs="{'invisible': [('use_leads', '=', False)]}">Leads</span>\n                        <span class="o_stat_text" attrs="{'invisible': [('use_leads', '=', True)]}">Opportunities</span>\n                    </div>\n                </button>\n            </xpath>\n        	crm/views/utm_campaign_views.xml	\N	\N	302	\N	extension	t	1	2025-06-10 03:55:58.036012	1	2025-06-10 03:55:58.036012	f

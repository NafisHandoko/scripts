623	account.move.select	account.move	\N	16	search	<?xml version="1.0"?>\n<search string="Search Move">\n                    <field name="name" string="Journal Entry" filter_domain="['|', '|', ('name', 'ilike', self), ('ref', 'ilike', self), ('partner_id', 'ilike', self)]"/>\n                    <field name="date"/>\n                    <field name="partner_id"/>\n                    <field name="journal_id"/>\n                    <filter string="Unposted" name="unposted" domain="[('state', '=', 'draft')]" help="Unposted Journal Entries"/>\n                    <filter string="Posted" name="posted" domain="[('state', '=', 'posted')]" help="Posted Journal Entries"/>\n                    <separator/>\n                    <filter string="Reversed" name="reversed" domain="[('payment_state', '=', 'reversed')]"/>\n                    <separator/>\n                    <filter string="To Check" name="to_check" domain="[('to_check', '=', True)]"/>\n                    <separator/>\n                    <filter string="Sales" name="sales" domain="[('journal_id.type', '=', 'sale')]" context="{'default_journal_type': 'sale'}"/>\n                    <filter string="Purchases" name="purchases" domain="[('journal_id.type', '=', 'purchase')]" context="{'default_journal_type': 'purchase'}"/>\n                    <filter string="Bank" name="bankoperations" domain="[('journal_id.type', '=', 'bank')]" context="{'default_journal_type': 'bank'}"/>\n                    <filter string="Cash" name="cashoperations" domain="[('journal_id.type', '=', 'cash')]" context="{'default_journal_type': 'cash'}"/>\n                    <filter string="Miscellaneous" name="misc_filter" domain="[('journal_id.type', '=', 'general')]" context="{'default_journal_type': 'general'}"/>\n                    <separator/>\n                    <filter string="Date" name="date" date="date"/>\n                    <separator/>\n                    <group expand="0" string="Group By">\n                        <filter string="Partner" name="partner" domain="[]" context="{'group_by': 'partner_id'}"/>\n                        <filter string="Journal" name="journal" domain="[]" context="{'group_by': 'journal_id'}"/>\n                        <filter string="Status" name="status" domain="[]" context="{'group_by': 'state'}"/>\n                        <filter string="Date" name="by_date" domain="[]" context="{'group_by': 'date'}" help="Journal Entries by Date"/>\n                        <filter string="Company" name="by_company" domain="[]" context="{'group_by': 'company_id'}" groups="base.group_multi_company"/>\n                    </group>\n                </search>\n            	account/views/account_move_views.xml	\N	\N	\N	\N	primary	t	1	2025-06-10 03:55:46.489222	1	2025-06-10 03:55:46.489222	f
908	account_invoice_partner_facturx_export	\N	account_edi_facturx.account_invoice_partner_facturx_export	16	qweb	<?xml version="1.0"?>\n<t t-name="account_edi_facturx.account_invoice_partner_facturx_export">\n            <t xmlns:ram="urn:un:unece:uncefact:data:standard:ReusableAggregateBusinessInformationEntity:100" xmlns:rsm="urn:un:unece:uncefact:data:standard:CrossIndustryInvoice:100" xmlns:udt="urn:un:unece:uncefact:data:standard:UnqualifiedDataType:100">\n                <!-- Contact. -->\n                <ram:Name t-if="partner.name" t-esc="partner.name"/>\n                <ram:DefinedTradeContact>\n                    <ram:PersonName t-esc="partner.name"/>\n                    <ram:TelephoneUniversalCommunication t-if="partner.phone or partner.mobile">\n                        <ram:CompleteNumber t-esc="partner.phone or partner.mobile"/>\n                    </ram:TelephoneUniversalCommunication>\n                    <ram:EmailURIUniversalCommunication t-if="partner.email">\n                        <ram:URIID schemeID="SMTP" t-esc="partner.email"/>\n                    </ram:EmailURIUniversalCommunication>\n                </ram:DefinedTradeContact>\n\n                <!-- Address. -->\n                <ram:PostalTradeAddress>\n                    <ram:PostcodeCode t-if="partner.zip" t-esc="partner.zip"/>\n                    <ram:LineOne t-if="partner.street" t-esc="partner.street"/>\n                    <ram:LineTwo t-if="partner.street2" t-esc="partner.street2"/>\n                    <ram:CityName t-if="partner.city" t-esc="partner.city"/>\n                    <ram:CountryID t-if="partner.country_id" t-esc="partner.country_id.code"/>\n                </ram:PostalTradeAddress>\n            </t>\n        </t>\n\n        	account_edi_facturx/data/facturx_templates.xml	\N	\N	\N	\N	primary	t	1	2025-06-10 03:56:16.3093	1	2025-06-10 03:56:16.3093	f

524	Language Selector	\N	portal.language_selector	16	qweb	<?xml version="1.0"?>\n<t name="Language Selector" t-name="portal.language_selector">\n        <t t-set="active_lang" t-value="list(filter(lambda lg : lg[0] == lang, languages))[0]"/>\n        <t t-set="language_selector_visible" t-value="len(languages) &gt; 1"/>\n        <div t-attf-class="js_language_selector #{_div_classes}" t-if="language_selector_visible">\n            <button class="btn btn-sm btn-outline-secondary border-0 dropdown-toggle" type="button" data-toggle="dropdown" aria-haspopup="true" aria-expanded="true">\n                <span t-if="not no_text" class="align-middle" t-esc="active_lang[2].split('/').pop()"/>\n            </button>\n            <div class="dropdown-menu" role="menu">\n                <t t-foreach="languages" t-as="lg">\n                    <a t-att-href="url_for(request.httprequest.path + '?' + keep_query(), lang_code=lg[0])" class="dropdown-item js_change_lang" t-att-data-url_code="lg[1]">\n                        <span t-if="not no_text" t-esc="lg[2].split('/').pop()"/>\n                    </a>\n                </t>\n            </div>\n        </div>\n    </t>\n\n    	portal/views/portal_templates.xml	\N	\N	\N	\N	primary	t	1	2025-06-10 03:55:40.841132	1	2025-06-10 03:55:40.841132	f
525	Portal User Dropdown	\N	portal.user_dropdown	16	qweb	<?xml version="1.0"?>\n<t name="Portal User Dropdown" t-name="portal.user_dropdown">\n        <t t-set="is_connected" t-value="not user_id._is_public()"/>\n        <li t-if="is_connected" t-attf-class="#{_item_class} o_no_autohide_item">\n            <a href="#" role="button" data-toggle="dropdown" t-attf-class="dropdown-toggle #{_link_class}">\n                <t t-if="_avatar">\n                    <t t-if="user_id.image_256" t-set="avatar_source" t-value="image_data_uri(user_id.image_256)"/>\n                    <t t-else="" t-set="avatar_source" t-value="'/web/static/src/img/placeholder.png'"/>\n                    <img t-att-src="avatar_source" t-attf-class="rounded-circle #{_avatar_class}" width="24" height="24" alt="" loading="eager"/>\n                </t>\n                <i t-if="_icon" t-attf-class="fa fa-1x fa-fw fa-user-circle-o #{_icon_class}"/>\n                <span t-if="_user_name" t-attf-class="#{_user_name_class}" t-esc="user_id.name[:23] + '...' if user_id.name and len(user_id.name) &gt; 25 else user_id.name"/>\n            </a>\n            <div t-attf-class="dropdown-menu js_usermenu #{_dropdown_menu_class}" role="menu">\n                <div id="o_logout_divider" class="dropdown-divider"/>\n                <a t-attf-href="/web/session/logout?redirect=/" role="menuitem" id="o_logout" class="dropdown-item">Logout</a>\n            </div>\n        </li>\n    </t>\n\n    	portal/views/portal_templates.xml	\N	\N	\N	\N	primary	t	1	2025-06-10 03:55:40.841132	1	2025-06-10 03:55:40.841132	f
730	My Invoices and Payments	\N	account.portal_my_invoices	16	qweb	<?xml version="1.0"?>\n<t name="My Invoices and Payments" t-name="account.portal_my_invoices">\n      <t t-call="portal.portal_layout">\n        <t t-set="breadcrumbs_searchbar" t-value="True"/>\n\n        <t t-call="portal.portal_searchbar">\n            <t t-set="title">Invoices</t>\n        </t>\n        <t t-if="not invoices">\n            <p>There are currently no invoices and payments for your account.</p>\n        </t>\n        <t t-if="invoices" t-call="portal.portal_table">\n            <thead>\n                <tr class="active">\n                    <th>Invoice #</th>\n                    <th>Invoice Date</th>\n                    <th class="d-none d-md-table-cell">Due Date</th>\n                    <th/>\n                    <th class="text-right">Amount Due</th>\n                </tr>\n            </thead>\n            <tbody>\n                <t t-foreach="invoices" t-as="invoice">\n                    <tr>\n                        <td>\n                            <a t-att-href="invoice.get_portal_url()" t-att-title="invoice.name">\n                                <t t-esc="invoice.name" t-if="invoice.name != '/'"/>\n                                <em t-else="">Draft Invoice</em>\n                            </a>\n                        </td>\n                        <td><span t-field="invoice.invoice_date"/></td>\n                        <td class="d-none d-md-table-cell"><span t-field="invoice.invoice_date_due"/></td>\n                        <td class="tx_status">\n                            <t t-if="invoice.state == 'posted' and invoice.payment_state not in ('in_payment', 'paid', 'reversed')">\n                                <span class="badge badge-pill badge-info"><i class="fa fa-fw fa-clock-o" aria-label="Opened" title="Opened" role="img"/><span class="d-none d-md-inline"> Waiting for Payment</span></span>\n                            </t>\n                            <t t-if="invoice.state == 'posted' and invoice.payment_state in ('paid', 'in_payment')">\n                                <span class="badge badge-pill badge-success"><i class="fa fa-fw fa-check" aria-label="Paid" title="Paid" role="img"/><span class="d-none d-md-inline"> Paid</span></span>\n                            </t>\n                            <t t-if="invoice.state == 'posted' and invoice.payment_state == 'reversed'">\n                                <span class="badge badge-pill badge-success"><i class="fa fa-fw fa-check" aria-label="Reversed" title="Reversed" role="img"/><span class="d-none d-md-inline"> Reversed</span></span>\n                            </t>\n                            <t t-if="invoice.state == 'cancel'">\n                                <span class="badge badge-pill badge-warning"><i class="fa fa-fw fa-remove" aria-label="Cancelled" title="Cancelled" role="img"/><span class="d-none d-md-inline"> Cancelled</span></span>\n                            </t>\n                        </td>\n                        <td class="text-right"><span t-esc="-invoice.amount_residual if invoice.move_type == 'out_refund' else invoice.amount_residual" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: invoice.currency_id}"/></td>\n                    </tr>\n                </t>\n            </tbody>\n        </t>\n      </t>\n    </t>\n\n    	account/views/account_portal_templates.xml	\N	\N	\N	\N	primary	t	1	2025-06-10 03:55:46.489222	1	2025-06-10 03:55:46.489222	f
731	Invoice Portal Template	\N	account.portal_invoice_page	16	qweb	<?xml version="1.0"?>\n<data name="Invoice Portal Template" inherit_id="portal.portal_sidebar" primary="True">\n        <xpath expr="//div[hasclass('o_portal_sidebar')]" position="inside">\n            <t t-set="o_portal_fullwidth_alert" groups="sales_team.group_sale_salesman,account.group_account_invoice,account.group_account_readonly">\n                <t t-call="portal.portal_back_in_edit_mode">\n                    <t t-set="backend_url" t-value="'/web#model=%s&amp;id=%s&amp;action=%s&amp;view_type=form' % (invoice._name, invoice.id, invoice.env.ref('account.action_move_out_invoice_type').id)"/>\n                </t>\n            </t>\n\n            <div class="row mt16 o_portal_invoice_sidebar">\n                <!-- Sidebar -->\n                <t t-call="portal.portal_record_sidebar">\n                    <t t-set="classes" t-value="'col-lg-auto d-print-none'"/>\n                    <t t-set="title">\n                        <h2 class="mb-0">\n                            <b t-if="invoice.amount_residual &gt; 0" t-field="invoice.amount_residual"/>\n                            <b t-else="1" t-field="invoice.amount_total"/>\n                        </h2>\n                        <div class="small" t-if="invoice.payment_state not in ('paid', 'in_payment') and invoice.move_type == 'out_invoice'"><i class="fa fa-clock-o"/><span class="o_portal_sidebar_timeago ml4" t-att-datetime="invoice.invoice_date_due"/></div>\n                    </t>\n\n                    <t t-set="entries">\n                        <ul class="list-group list-group-flush flex-wrap flex-row flex-lg-column">\n                            <li class="list-group-item flex-grow-1">\n                                <div class="o_download_pdf btn-toolbar flex-sm-nowrap">\n                                    <div class="btn-group  flex-grow-1 mr-1 mb-1">\n                                        <a class="btn btn-secondary btn-block o_download_btn" t-att-href="invoice.get_portal_url(report_type='pdf', download=True)" title="Download"><i class="fa fa-download"/> Download</a>\n                                    </div>\n                                    <div class="btn-group flex-grow-1 mb-1">\n                                        <a class="btn btn-secondary btn-block o_print_btn o_portal_invoice_print" t-att-href="invoice.get_portal_url(report_type='pdf')" id="print_invoice_report" title="Print" target="_blank"><i class="fa fa-print"/> Print</a>\n                                    </div>\n                                </div>\n                            </li>\n                            <li t-if="invoice.invoice_user_id" class="list-group-item flex-grow-1">\n                                <div class="small mb-1"><strong class="text-muted">\n                                    <t t-if="invoice.move_type == 'out_invoice'">\n                                        Salesperson\n                                    </t>\n                                    <t t-if="invoice.move_type == 'in_invoice'">\n                                        Purchase Representative\n                                    </t>\n                                </strong></div>\n                                <div class="row">\n                                    <div class="col flex-grow-0 pr-2">\n                                        <img t-if="invoice.invoice_user_id.image_1024" class="rounded-circle mt-1 o_portal_contact_img" t-att-src="image_data_uri(invoice.invoice_user_id.image_1024)" alt="Contact"/>\n                                        <img t-else="" class="rounded-circle mt-1 o_portal_contact_img" src="/web/static/src/img/user_menu_avatar.png" alt="Contact"/>\n                                    </div>\n                                    <div class="col pl-0">\n                                        <span t-field="invoice.invoice_user_id" t-options="{&quot;widget&quot;: &quot;contact&quot;, &quot;fields&quot;: [&quot;name&quot;, &quot;phone&quot;], &quot;no_marker&quot;: True}"/>\n                                        <a href="#discussion" class="small"><i class="fa fa-fw fa-comments"/><b>Send message</b></a>\n                                    </div>\n                                </div>\n                            </li>\n                        </ul>\n                    </t>\n                </t>\n\n                <!-- Page Content -->\n                <div id="invoice_content" class="col-12 col-lg">\n                    <t t-if="error or warning" t-call="account.portal_invoice_error"/>\n                    <t t-if="success and (not error and not warning)" t-call="account.portal_invoice_success"/>\n\n                    <div class="o_portal_html_view shadow p-3">\n                        <div class="o_portal_html_loader text-center">\n                            <i class="fa fa-circle-o-notch fa-spin fa-2x fa-fw text-black-50"/>\n                        </div>\n                        <iframe id="invoice_html" class="mt8 mb8" width="100%" height="100%" frameborder="0" scrolling="no" t-att-src="invoice.get_portal_url(report_type='html')"/>\n                    </div>\n                    <!-- chatter -->\n                    <div id="invoice_communication" class="mt-4">\n                        <h2>History</h2>\n                        <t t-call="portal.message_thread">\n                            <t t-set="object" t-value="invoice"/>\n                        </t>\n                    </div>\n                </div>\n            </div>\n        </xpath>\n    <xpath expr="." position="attributes"><attribute name="t-name">account.portal_invoice_page</attribute></xpath></data>\n\n    	account/views/account_portal_templates.xml	\N	\N	545	\N	primary	t	1	2025-06-10 03:55:46.489222	1	2025-06-10 03:55:46.489222	f

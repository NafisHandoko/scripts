672	account.tax.kanban	account.tax	\N	16	kanban	<?xml version="1.0"?>\n<kanban class="o_kanban_mobile">\n                    <field name="name"/>\n                    <field name="type_tax_use"/>\n                    <field name="tax_scope"/>\n                    <templates>\n                        <t t-name="kanban-box">\n                            <div t-attf-class="oe_kanban_card oe_kanban_global_click">\n                                <div class="row mb4">\n                                    <div class="col-6">\n                                        <strong><span><t t-esc="record.name.value"/></span></strong>\n                                    </div>\n                                    <div class="col-6 text-right">\n                                        <span class="badge badge-pill"><t t-esc="record.type_tax_use.value"/></span>\n                                        <span class="badge badge-pill"><t t-esc="record.tax_scope.value"/></span>\n                                    </div>\n                                </div>\n                            </div>\n                        </t>\n                    </templates>\n                </kanban>\n            	account/views/account_tax_views.xml	\N	\N	\N	\N	primary	t	1	2025-06-10 03:55:46.489222	1	2025-06-10 03:55:46.489222	f

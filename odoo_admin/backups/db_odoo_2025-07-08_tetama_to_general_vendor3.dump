\n                <script type="text/javascript" src="/mail/static/src/models/thread_view/thread_viewer.js"/>\n                <script type="text/javascript" src="/mail/static/src/models/user/user.js"/>\n                <script type="text/javascript" src="/mail/static/src/services/chat_window_service/chat_window_service.js"/>\n                <script type="text/javascript" src="/mail/static/src/services/dialog_service/dialog_service.js"/>\n                <script type="text/javascript" src="/mail/static/src/utils/deferred/deferred.js"/>\n                <script type="text/javascript" src="/mail/static/src/utils/throttle/throttle.js"/>\n                <script type="text/javascript" src="/mail/static/src/utils/timer/timer.js"/>\n                <script type="text/javascript" src="/mail/static/src/utils/utils.js"/>\n                <script type="text/javascript" src="/mail/static/src/widgets/discuss/discuss.js"/>\n                <script type="text/javascript" src="/mail/static/src/widgets/discuss_invite_partner_dialog/discuss_invite_partner_dialog.js"/>\n                <script type="text/javascript" src="/mail/static/src/widgets/form_renderer/form_renderer.js"/>\n                <script type="text/javascript" src="/mail/static/src/widgets/messaging_menu/messaging_menu.js"/>\n                <script type="text/javascript" src="/mail/static/src/widgets/notification_alert/notification_alert.js"/>\n\n                <!-- notification_list_item.scss contains variables/mixins, it must be positioned before sub-components of NotificationList -->\n                <link rel="stylesheet" type="text/scss" href="/mail/static/src/components/notification_list/notification_list_item.scss"/>\n                <link rel="stylesheet" type="text/scss" href="/mail/static/src/bugfix/bugfix.scss"/>\n                <link rel="stylesheet" type="text/scss" href="/mail/static/src/components/activity/activity.scss"/>\n                <link rel="stylesheet" type="text/scss" href="/mail/static/s
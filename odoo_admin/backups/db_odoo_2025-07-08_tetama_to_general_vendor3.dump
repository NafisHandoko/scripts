                     <label class="col-sm-2 col-form-label label-field" for="given_name">First Name</label>\n                        <div class="col-sm-10">\n                            <input type="text" class="form-control" name="given_name" t-att-value="given_name" placeholder="Write practitioner's first name here"/>\n                        </div>\n                    </div>\n                    <div class="form-group row required">\n                        <label class="col-sm-2 col-form-label label-field" for="family_name">Last Name</label>\n                        <div class="col-sm-10">\n                            <input type="text" class="form-control" name="family_name" t-att-value="family_name" required="" placeholder="Write practitioner's last name here"/>\n                        </div>\n                    </div>\n                    <div class="form-group row">\n                        <label class="col-sm-2 col-form-label label-field" for="suffix_name">Suffix</label>\n                        <div class="col-sm-10">\n                            <input type="text" class="form-control" name="suffix_name" t-att-value="suffix_name" placeholder="Write practitioner's suffix name here"/>\n                        </div>\n                    </div>\n                    <div class="form-group row required">\n                        <label class="col-sm-2 col-form-label label-field" for="email">Email</label>\n                        <div class="col-sm-10">\n                            <input type="email" id="email-field" class="form-control" name="email" t-att-value="email" required="" placeholder="username@gmail.com"/>\n                            <div id="email-status"/>\n                        </div>\n                    </div>\n                    <div class="form-group row required">\n                        <label class="col-sm-2 col-form-label label-field" for="nik">NIK</label>\n                        <div class="col-sm-10">\n                            <input type="text" class="form-control" name="nik" t-att-value="nik" required="" placeholder="Write practitioner's NIK here" pattern="[0-9]{16}" title="NIK must be a 16-digit number"/>\n                        </div>\n                    </div>\n                    <div class="form-group row required">\n                        <label class="col-sm-2 col-form-label label-field" for="birth_date">Birth Date</label>\n                        <div class="col-sm-10">\n                            <input type="date" name="birth_date" class="form-control" style="max-width: 200px;"/>\n                        </div>\n                    </div>\n                    <div class="form-group row required">\n                        <label class="col-sm-2 col-form-label label-field" for="gender">Gender</label>\n                        <div class="col-sm-10">\n                            <select name="gender" class="form-control" style="max-width: 200px;">\n                                <option value="male">Male</option>\n                                <option value="female">Female</option>\n                            </select>\n                        </div>\n                    </div>\n                    <div class="form-group row required">\n                        <label class="col-sm-2 col-form-label label-field" for="role">Role</label>\n                        <div class="col-sm-5">\n                            <select id="custom-select-multirole" name="multirole[]" multiple="" style="width: 400px;">\n                                <option value="doctor">Doctor</option>\n                                <option value="dentist">Dentist</option>\n                                <option value="midwife">Midwife</option>\n                                <option value="psychologist">Psychologist</option>\n                                <option value="nurse">Nurse</option>\n                                <option value="dental_nurse">Dental Nurse</option>\n                      
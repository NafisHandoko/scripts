105	base.partner.merge.automatic.wizard.form	base.partner.merge.automatic.wizard	\N	16	form	<?xml version="1.0"?>\n<form string="Automatic Merge Wizard">\n                    <sheet>\n                        <group attrs="{'invisible': [('state', '!=', 'finished')]}" col="1">\n                            <h2>There are no more contacts to merge for this request</h2>\n                            <button name="48" string="Deduplicate the other Contacts" class="oe_highlight" type="action"/>\n                        </group>\n                        <p class="oe_grey" attrs="{'invisible': [('state', '!=', ('option'))]}">\n                            Select the list of fields used to search for\n                            duplicated records. If you select several fields,\n                            Odoo will propose you to merge only those having\n                            all these fields in common. (not one of the fields).\n                        </p>\n                        <group attrs="{'invisible': ['|', ('state', 'not in', ('selection', 'finished')), ('number_group', '=', 0)]}">\n                            <field name="state" invisible="1"/>\n                            <field name="number_group"/>\n                        </group>\n                        <group string="Search duplicates based on duplicated data in" attrs="{'invisible': [('state', 'not in', ('option',))]}">\n                            <field name="group_by_email"/>\n                            <field name="group_by_name"/>\n                            <field name="group_by_is_company"/>\n                            <field name="group_by_vat"/>\n                            <field name="group_by_parent_id"/>\n                        </group>\n                        <group string="Exclude contacts having" attrs="{'invisible': [('state', 'not in', ('option',))]}">\n                            <field name="exclude_contact"/>\n                            <field name="exclude_journal_item"/>\n                        </group>\n                        <separator string="Options" attrs="{'invisible': [('state', 'not in', ('option',))]}"/>\n                        <group attrs="{'invisible': [('state', 'not in', ('option','finished'))]}">\n                            <field name="maximum_group" attrs="{'readonly': [('state', 'in', ('finished'))]}"/>\n                        </group>\n                        <separator string="Merge the following contacts" attrs="{'invisible': [('state', 'in', ('option', 'finished'))]}"/>\n                        <group attrs="{'invisible': [('state', 'in', ('option', 'finished'))]}" col="1">\n                            <p class="oe_grey">\n                                Selected contacts will be merged together.\n                                All documents linked to one of these contacts\n                                will be redirected to the destination contact.\n                                You can remove contacts from this list to avoid merging them.\n                            </p>\n                            <group col="2">\n                                <field name="dst_partner_id" domain="[('id', 'in', partner_ids or False)]" attrs="{'required': [('state', '=', 'selection')]}"/>\n                            </group>\n                            <field name="partner_ids" nolabel="1">\n                                <tree string="Partners">\n                                    <field name="id"/>\n                                    <field name="display_name"/>\n                                    <field name="email"/>\n                                    <field name="is_company"/>\n                                    <field name="vat"/>\n                                    <field name="country_id"/>\n                                </tree>\n                            </field>\n                        </group>\n                    </sheet>\n                    <footer>\n                        <button name="action_merge" string="Merge Contacts" class="oe_highlight" type="object" attrs="{'invisible': [('state', 'in', ('option', 'finished' ))]}"/>\n                        <button name="action_skip" string="Skip these contacts" type="object" attrs="{'invisible': [('state', '!=', 'selection')]}"/>\n                        <button name="action_start_manual_process" string="Merge with Manual Check" type="object" class="oe_highlight" attrs="{'invisible': [('state', '!=', 'option')]}"/>\n                        <button name="action_start_automatic_process" string="Merge Automatically" type="object" class="oe_highlight" confirm="Are you sure to execute the automatic merge of your contacts ?" attrs="{'invisible': [('state', '!=', 'option')]}"/>\n                        <button name="action_update_all_process" string="Merge Automatically all process" type="object" confirm="Are you sure to execute the list of automatic merges of your contacts ?" attrs="{'invisible': [('state', '!=', 'option')]}"/>\n                        <button special="cancel" string="Cancel" type="object" class="btn btn-secondary oe_inline" attrs="{'invisible': [('state', '=', 'finished')]}"/>\n                        <button special="cancel" string="Close" type="object" class="btn btn-secondary oe_inline" attrs="{'invisible': [('state', '!=', 'finished')]}"/>\n                    </footer>\n                </form>\n            	base/wizard/base_partner_merge_views.xml	\N	\N	\N	\N	primary	t	1	2025-06-10 03:51:51.249694	1	2025-06-10 03:51:51.249694	\N
352	mail.channel.form	mail.channel	\N	10	form	<?xml version="1.0"?>\n<form string="Mail Channel Form">\n                    <header>\n                        <button name="send_guidelines" type="object" string="Send guidelines" confirm="You are going to send the guidelines to all the subscribers. Do you confirm the action?" attrs="{'invisible':['|',('moderation_guidelines','=',False), ('is_moderator', '=', False)]}"/>\n                    </header>\n                    <sheet>\n                        <div class="oe_button_box" name="button_box">\n                            <field name="is_moderator" invisible="1"/>\n                            <button class="btn oe_stat_button" name="mail.mail_moderation_action" type="action" attrs="{'invisible':[('is_moderator', '=', False)]}" icon="fa-bars" context="{'search_default_channel_id': active_id}">\n                            <field string="Moderation List" name="moderation_count" widget="statinfo"/>\n                            </button>\n                        </div>\n                        <div class="oe_button_box" name="button_box"/>\n                        <field name="image_128" widget="image" class="oe_avatar" options="{'size': [90, 90]}"/>\n                        <div class="oe_title">\n                            <div class="oe_edit_only">\n                                <label for="name"/>\n                            </div>\n                            <h1>\n                                #<field name="name" default_focus="1" placeholder="Name" readonly="0"/>\n                            </h1>\n                        </div>\n                        <group class="o_label_nowrap">\n                            <field name="active" invisible="1"/>\n                            <field name="email_send"/>\n                            <field name="moderation" attrs="{'invisible': [('email_send', '=', False)]}"/>\n                            <field name="description" placeholder="Topics discussed in this group..."/>\n                        </group>\n                        <group name="group_alias" attrs="{'invisible': [('alias_domain', '=', False)]}">\n                            <label for="alias_id" string=" " class="fa fa-envelope-o" style="min-width: 20px;" aria-label="Email" title="Email" role="img"/>\n                            <div name="alias_def">\n                                <field name="alias_id" class="oe_read_only oe_inline" string="Email Alias" required="0"/>\n                                <div class="oe_edit_only oe_inline" name="edit_alias" style="display: inline;">\n                                    <field name="alias_name" class="oe_inline"/>@<field name="alias_domain" class="oe_inline" readonly="1"/>\n                                </div>\n                            </div>\n                            <field name="alias_contact" class="oe_inline" invisible="1"/>\n                        </group>\n                        <notebook>\n                            <page string="Privacy" name="privacy">\n                                <group class="o_label_nowrap">\n                                    <field name="public" widget="radio" string="Who can follow the group's activities?"/>\n                                    <field name="group_public_id" attrs="{'invisible': [('public','!=','groups')], 'required': [('public','=','groups')]}"/>\n                                    <field name="group_ids" widget="many2many_tags" string="Auto Subscribe Groups"/>\n                                </group>\n                            </page>\n                            <page string="Members" name="members">\n                                <field name="channel_last_seen_partner_ids" mode="tree" context="{'active_test': False}">\n                                    <tree string="Members" editable="bottom">\n                                        <field name="partner_id" required="1"/>\n                                        <field name="partner_email" readonly="1"/>\n                                    </tree>\n                                </field>\n                            </page>\n                            <page string="Moderation" name="moderation" attrs="{'invisible': [('moderation', '=', False)]}">\n                                <group>\n                                    <field name="moderator_ids" widget="many2many_tags"/>\n                                    <field name="moderation_notify"/>\n                                    <field name="moderation_notify_msg" attrs="{'invisible': [('moderation_notify', '=', False)]}"/>\n                                    <field name="moderation_guidelines"/>\n                                    <field name="moderation_guidelines_msg" attrs="{'invisible':[('moderation_guidelines', '=', False)]}"/>\n                                </group>\n                            </page>\n                            <page string="Integrations" invisible="1" name="mail_channel_integrations"/>\n                        </notebook>\n                        <div class="oe_chatter" groups="base.group_no_one">\n                            <field name="message_follower_ids"/>\n                        </div>\n                    </sheet>\n                </form>\n            	mail/views/mail_channel_views.xml	\N	\N	\N	\N	primary	t	1	2025-06-10 03:55:24.448855	1	2025-06-10 03:55:24.448855	\N

1058	bpjs_account_update	\N	ehealth.bpjs_account_update	16	qweb	<?xml version="1.0"?>\n<t t-name="ehealth.bpjs_account_update">\n        <script type="text/javascript" src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.2.1/jquery.min.js"/>\n        <script type="text/javascript" src="/ehealth/static/src/js/bpjs_account_setting.js"/>\n        <link rel="stylesheet" href="/ehealth/static/src/css/portal_style.css"/>\n        <link rel="stylesheet" href="/ehealth/static/src/css/bpjs_accounts_style.css"/>\n        <t t-call="portal.portal_layout">\n            <t t-set="no_breadcrumbs" t-value="True"/>\n            <t t-call="ehealth.portal_sidebar_menu"/>\n            <t t-set="title" t-value=""/>\n            <t t-if="account_type == 'pcare'"><t t-set="title" t-value="'PCare'"/></t>\n            <t t-if="account_type == 'icare'"><t t-set="title" t-value="'i-Care'"/></t>\n            <t t-if="account_type == 'vclaim'"><t t-set="title" t-value="'VClaim'"/></t>\n            <nav aria-label="breadcrumb">\n                <ol class="breadcrumb">\n                    <li class="breadcrumb-item custom"><a href="./">Settings</a></li>\n                    <li class="breadcrumb-item custom active" aria-current="page"><t t-esc="title"/> Account Settings</li>\n                </ol>\n            </nav>\n            <div class="frame form">\n                <div class="account-form">\n                    <div class="header-form">\n                        <p class="title-menu">Username and Password</p>\n                        <p t-att-class="'status-valid' if status == 'valid' else 'hidden'">Valid Credentials</p>\n                    </div>\n                    <div t-att-class="'notify-invalid-credential' if status == 'invalid' else 'hidden'">\n                        <img src="/ehealth/static/src/image/icon_warning.svg"/>\n                        <div>\n                            <p class="notify-title">Invalid Credentials</p>\n                            <p class="notify-description">Your credentials may have changed. Please update your username and password to ensure the bridging process works correctly.</p>\n                        </div>\n                    </div>\n                    <div t-att-class="'notify-updating-credential' if status == 'updating' else 'hidden'">\n                        <img src="/ehealth/static/src/image/icon_information.svg"/>\n                        <div>\n                            <p class="notify-title">Credential Updates in Progress</p>\n                            <p class="notify-description">It may take a few minutes for the system to update your username and password. The updated credentials will be displayed in this section. Please check again shortly.</p>\n                        </div>\n                    </div>\n                    <label>Username</label>\n                    <div class="input-with-action">\n                        <input type="text" class="form-control" name="username" t-att-value="username" disabled="true"/>\n                        <div class="suffix">\n                            <img class="copy-input" src="/ehealth/static/src/image/icon_copy.svg"/>\n                        </div>\n                    </div>\n                    <label>Password</label>\n                    <div class="input-with-action">\n                        <input type="password" class="form-control" name="password" t-att-value="password" disabled="true"/>\n                        <div class="suffix">\n                            <img class="show-password" src="/ehealth/static/src/image/eye_password_hide.svg"/>\n                            <img class="hide-password" src="/ehealth/static/src/image/eye_password_show.svg"/>\n                            <img class="copy-input" src="/ehealth/static/src/image/icon_copy.svg"/>\n                        </div>\n                    </div>\n                </div>\n                <hr class="spliter"/>\n                <div class="account-form">\n                    <p class="title-menu my-1">Update Username or Password</p>\n                    <p class="description-menu">Update your <t t-esc="title"/> credentials here if needed. You can change either your username or password individually.</p>\n                    <div class="s_website_form form-horizontal container-fluid">\n                        <label>New Username</label>\n                        <input id="new_username" type="text" class="form-control" t-att-value="new_username"/>\n                        <label>New Password</label>\n                        <div class="input-with-action">\n                            <input id="new_password" type="password" class="form-control" t-att-value="new_password"/>\n                            <div class="suffix">\n                                <img class="show-password" src="/ehealth/static/src/image/eye_password_hide.svg"/>\n                                <img class="hide-password" src="/ehealth/static/src/image/eye_password_show.svg"/>\n                            </div>\n                        </div>\n                        <div class="form-group">\n                            <div class="mt-4 d-flex flex-row justify-content-end">\n                                <p id="response-submit" style="display: ; margin: auto 15px;"/>\n                                <button t-att-disabled="True if status == 'updating' else None" id="submit-button" class="btn btn-ehealth-primary">Save Updates</button>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n            <div id="blank-screen">\n                <div class="backdrop"/>\n                <div class="confirmation-card account-form">\n                    <p class="title-card">Confirm credential updates</p>\n                    <p class="description-card">Are you sure you want to change your <t t-esc="title"/> username and password?</p>\n                    <form id="submit_form" role="form" action="/my/customer/bpjs_account/save" method="POST" class="s_website_form form-horizontal container-fluid">\n                        <input id="account_type" name="account_type" t-att-value="account_type" style="display: none;"/>\n                        <input id="organization_id" name="organization_id" t-att-value="organization_id" style="display: none;"/>\n                        <label>Username</label>\n                        <div class="input-with-action">\n                            <input id="confirmation-username" type="text" name="new_username" class="form-control" readonly="true"/>\n                            <div class="suffix">\n                                <img class="copy-input" src="/ehealth/static/src/image/icon_copy.svg"/>\n                            </div>\n                        </div>\n                        <label>Password</label>\n                        <div class="input-with-action">\n                            <input id="confirmation-password" type="password" name="new_password" class="form-control" readonly="true"/>\n                            <div class="suffix">\n                                <img class="show-password" src="/ehealth/static/src/image/eye_password_hide.svg"/>\n                                <img class="hide-password" src="/ehealth/static/src/image/eye_password_show.svg"/>\n                            </div>\n                        </div>\n                        <div class="form-group">\n                            <div class="mt-4 d-flex flex-row justify-content-end">\n                                <p id="response-submit" style="display: ; margin: auto 15px;"/>\n                                <button type="submit" id="submit-confirm-button" class="btn btn-ehealth-primary"><div class="loader"/> Confirm Updates</button>\n                            </div>\n                        </div>\n                    </form>\n                </div>\n            </div>\n        </t>\n\n    </t>\n\n	ehealth
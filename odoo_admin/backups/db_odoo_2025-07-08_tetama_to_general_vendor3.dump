"/>\n                            <t t-set="mode" t-value="'payment'"/>\n                            <div class="row">\n                                <div class="col-xs-12">\n                                    <div class="form-group required">\n                                        <label for="couponCode">Cardholder Name</label>\n                                        <input type="text" class="form-control" name="cardName" id="cardName" t-att-value="cardName" placeholder="Write cardholder name" required="true"/>\n                                    </div>\n                                </div>\n                            </div>\n                            <div class="row">\n                                <div class="col-xs-12">\n                                    <div class="form-group required">\n                                        <label for="cardNumber">Card Number</label>\n                                        <div class="input-group">\n                                            <input id="cc-number" type="tel" class="form-control input_mask" name="cardNumber" autocomplete="cc-number" required="required" t-att-value="cardNumber" placeholder="0000 0000 0000 0000"/>\n                                            <input type="hidden" name="cc_brand" id="cc_brand" t-att-value="cc_brand" value=""/>\n                                        </div>\n                                    </div>\n                                </div>\n                            </div>\n                            <div class="row">\n                                <div class="col-xs-6 col-md-6">\n                                    <div class="form-group required">\n                                        <label for="cardExpiry"><span class="hidden-xs">Expiration Date </span></label>\n                                        <input type="tel" class="cc-exp input_mask form-control" name="cardExpiry" placeholder="MM/YY" autocomplete="cc-exp" required="required" id="cc-exp" t-at
1040	Payment Method	\N	ehealth.portal_payment_method_list	16	qweb	<?xml version="1.0"?>\n<t name="Payment Method" t-name="ehealth.portal_payment_method_list">\n        <xpath expr="." position="inside">\n            <link rel="stylesheet" href="/ehealth/static/src/css/card_payment.css"/>\n            <link rel="stylesheet" href="https://code.jquery.com/ui/1.11.1/themes/smoothness/jquery-ui.css"/>\n        </xpath>\n        <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.5.1/jquery.min.js"/>\n        <script type="text/javascript" src="/ehealth/static/src/js/payment_method.js"/>\n        <t t-call="portal.portal_layout">\n            <t t-set="no_breadcrumbs" t-value="True"/>\n            <t t-call="ehealth.portal_sidebar_menu"/>\n            <nav aria-label="breadcrumb">\n                <ol class="breadcrumb">\n                    <li class="breadcrumb-item active" aria-current="page">Payment Methods</li>\n                </ol>\n            </nav>\n            <div class="main-container">\n                <div class="add-payment">\n                    <button id="dialog_link" class="add__card">+  Add Payment Method</button>\n                    <div class="list-add-payment">\n                        <div class="cc-payment options-list">\n                            <a href="/my/customer/payment_method/form">Credit Card</a>\n                        </div>\n\n                        <div class="emoney-paymen options-list">\n                            <a href="#">E-Money</a>\n                        </div>\n                    </div>\n                </div>\n                <div class="cards">\n                    <div class="cc-subtitle">Credit Card</div>\n                    <t t-set="index" t-value="1"/>\n                    <t t-foreach="pms" t-as="card">\n                        <div class="card-1" t-attf-id="card-list-{{index}}">\n                            <input t-attf-id="primary-value-{{index}}" t-att-value="str(card.is_primary)" style="display
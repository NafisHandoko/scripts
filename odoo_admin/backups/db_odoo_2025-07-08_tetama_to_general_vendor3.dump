1066	Infrastructure Plan Form	ehealth.infrastructure_plan	\N	16	form	<?xml version="1.0"?>\n<form string="Infrastructure Plan Form" duplicate="0">\n          <header>\n            <button name="start_plan" type="object" string="Plan" icon="fa-sticky-note" class="btn-primary" attrs="{'invisible': [('state','!=', 'draft')]}"/>\n            <button name="start_describe" type="object" string="Describe" icon="fa-commenting" class="btn-primary" attrs="{'invisible': [('state','!=', 'planned')]}"/>\n            <button name="start_apply" type="object" string="Apply" icon="fa-play" class="btn-primary" attrs="{'invisible': [('state','!=', 'described')]}"/>\n            <button name="reset_to_draft" type="object" string="Reset to Draft" attrs="{'invisible': [('state', 'in', ['draft', 'enqueued_plan', 'enqueued_describe', 'enqueued_apply', 'applied', 'cancelled'])]}"/>\n            <button name="reset_to_described" type="object" string="Reset to Described" attrs="{'invisible': [('state', 'in', ['draft', 'enqueued_plan', 'planned', 'enqueued_describe', 'described', 'applied', 'cancelled'])]}" groups="base.group_no_one"/>\n            <button name="reset_to_draft" type="object" string="Reset to Draft" attrs="{'invisible': [('state', 'in', ['draft', 'planned', 'described', 'applied', 'cancelled'])]}" groups="base.group_no_one"/>\n            <button name="cancel" type="object" string="Cancel" attrs="{'invisible': [('state', 'in', ['applied', 'cancelled'])]}"/>\n            <field name="state" widget="statusbar"/>\n          </header>\n          <sheet>\n            <group>\n              <field name="organization" readonly="1" options="{'no_create_edit': True, 'no_create': True}"/>\n              <field name="request_id" readonly="1"/>\n              <field name="note" required="1" attrs="{'readonly': [('state','!=', 'draft')]}"/>\n            </group>\n            <notebook>\n              <page string="Plan">\n                <group>\n                  <field name="variable" attrs="{'readonly': [('state','!=', 'draft')]}"/>\n                  <field name="target" attrs="{'readonly': [('state','!=', 'draft')]}"/>\n                  <field name="plan" readonly="1" groups="base.group_no_one"/>\n                </group>\n              </page>\n              <page string="Describe" attrs="{'invisible': [('state','in', ['draft', 'enqueue_plan', 'planned', 'enqueued_describe'])]}">\n                <group>\n                  <field name="summary" readonly="1"/>\n                  <field name="description" readonly="1"/>\n                </group>\n              </page>\n            </notebook>\n          </sheet>\n          <div class="oe_chatter">\n            <field name="message_follower_ids" widget="mail_followers"/>\n            <field name="message_ids" widget="mail_thread"/>\n          </div>\n        </form>\n      	ehealth/views/infrastructure_plan.xml	f	<?xml version="1.0"?>\n<form string="Infrastructure Plan Form" duplicate="0">\n          <header>\n            <button name="start_plan" type="object" string="Plan" icon="fa-sticky-note" class="btn-primary" attrs="{'invisible': [('state','!=', 'draft')]}"/>\n            <button name="start_describe" type="object" string="Describe" icon="fa-commenting" class="btn-primary" attrs="{'invisible': [('state','!=', 'planned')]}"/>\n            <button name="start_apply" type="object" string="Apply" icon="fa-play" class="btn-primary" attrs="{'invisible': [('state','!=', 'described')]}"/>\n            <button name="reset_to_draft" type="object" string="Reset to Draft" attrs="{'invisible': [('state', 'in', ['draft', 'enqueued_plan', 'enqueued_describe', 'enqueued_apply', 'applied', 'cancelled'])]}"/>\n            <button name="reset_to_described" type="object" string="Reset to Described" attrs="{'invisible': [('state', 'in', ['draft', 'enqueued_plan', 'planned', 'enqueued_describe', 'described', 'applied', 'cancelled'])]}" groups="base.group_no_one"/>\n            <button name="reset_to_draft" type=
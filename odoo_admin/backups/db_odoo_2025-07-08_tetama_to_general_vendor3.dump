901	assets_frontend	\N	payment.assets_frontend	16	qweb	<?xml version="1.0"?>\n<data inherit_id="web.assets_frontend">\n        <xpath expr="link[last()]" position="after">\n            <link rel="stylesheet" type="text/scss" href="/payment/static/src/scss/portal_payment.scss"/>\n            <link rel="stylesheet" type="text/scss" href="/payment/static/src/scss/payment_form.scss"/>\n        </xpath>\n        <xpath expr="script[last()]" position="after">\n            <script type="text/javascript" src="/payment/static/lib/jquery.payment/jquery.payment.js"/>\n            <script type="text/javascript" src="/payment/static/src/js/payment_portal.js"/>\n            <script type="text/javascript" src="/payment/static/src/js/payment_form.js"/>\n            <script type="text/javascript" src="/payment/static/src/js/payment_processing.js"/>\n        </xpath>\n    </data>\n	payment/views/assets.xml	\N	\N	188	\N	extension	t	1	2025-06-10 03:56:12.605336	1	2025-06-10 03:56:12.605336	f
907	account_invoice_line_facturx_export	\N	account_edi_facturx.account_invoice_line_facturx_export	16	qweb	<?xml version="1.0"?>\n<t t-name="account_edi_facturx.account_invoice_line_facturx_export">\n            <t t-set="line" t-value="line_values['line']"/>\n            <t xmlns:ram="urn:un:unece:uncefact:data:standard:ReusableAggregateBusinessInformationEntity:100" xmlns:rsm="urn:un:unece:uncefact:data:standard:CrossIndustryInvoice:100" xmlns:udt="urn:un:unece:uncefact:data:standard:UnqualifiedDataType:100">\n                <ram:IncludedSupplyChainTradeLineItem>\n                    <!-- Line number. -->\n                    <ram:AssociatedDocumentLineDocument>\n                        <ram:LineID t-esc="line_values['index']"/>\n                    </ram:AssociatedDocumentLineDocument>\n\n                    <!-- Product. -->\n                    <ram:SpecifiedTradeProduct>\n                        <ram:GlobalID schemeID="0160" t-if="line.product_id and line.product_id.barcode" t-esc="line.product_id.barcode"/>\n                        <ram:SellerAssignedID t-if="line.product_id and line.product_id.default_code" t-esc="line.product_id.default_code"/>\n                        <ram:Name t-esc="line.name"/>\n                    </ram:SpecifiedTradeProduct>\n\n                    <!-- Amounts. -->\n                    <ram:SpecifiedLineTradeAgreement>\n                        <ram:GrossPriceProductTradePrice>\n                            <ram:ChargeAmount t-att-currencyID="currency.name" t-esc="format_monetary(line.price_unit, currency)"/>\n\n                            <!-- Discount. -->\n                            <ram:AppliedTradeAllowanceCharge t-if="line.discount">\n                                <ram:ChargeIndicator>\n                                    <udt:Indicator t-esc="'false' if line.discount == 100 else 'true'"/>\n                                </ram:ChargeIndicator>\n                                <ram:CalculationPercent t-esc="line.discount"/>\n                            </ram:AppliedTradeAllowanceCharge>\n                        </ram:GrossPriceProductTradePrice>\n                    </ram:SpecifiedLineTradeAgreement>\n\n                    <!-- Quantity. -->\n                    <ram:SpecifiedLineTradeDelivery>\n                        <ram:BilledQuantity t-esc="line.quantity"/>\n                    </ram:SpecifiedLineTradeDelivery>\n\n                    <ram:SpecifiedLineTradeSettlement>\n                        <t t-foreach="line_values['tax_details']" t-as="tax_vals">\n                            <t t-set="tax" t-value="tax_vals['tax']"/>\n                            <ram:ApplicableTradeTax t-if="tax.amount_type == 'percent'">\n                                <ram:RateApplicablePercent t-esc="tax.amount"/>\n                            </ram:ApplicableTradeTax>\n                        </t>\n                        <!-- Subtotal. -->\n                        <ram:SpecifiedTradeSettlementLineMonetarySummation>\n                            <ram:LineTotalAmount t-att-currencyID="currency.name" t-esc="format_monetary(line.price_subtotal, currency)"/>\n                        </ram:SpecifiedTradeSettlementLineMonetarySummation>\n                    </ram:SpecifiedLineTradeSettlement>\n\n                </ram:IncludedSupplyChainTradeLineItem>\n            </t>\n        </t>\n\n        	account_edi_facturx/data/facturx_templates.xml	\N	\N	\N	\N	primary	t	1	2025-06-10 03:56:16.3093	1	2025-06-10 03:56:16.3093	f

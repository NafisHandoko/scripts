541	Pager	\N	portal.pager	16	qweb	<?xml version="1.0"?>\n<t name="Pager" t-name="portal.pager">\n        <ul t-if="pager['page_count'] &gt; 1" t-attf-class="#{ classname or '' } pagination m-0 #{_classes}" t-att-style="style or None">\n            <li t-attf-class="page-item #{'disabled' if pager['page']['num'] == 1 else ''}">\n                <a t-att-href=" pager['page_previous']['url'] if pager['page']['num'] != 1 else None" t-attf-class="page-link #{extraLinkClass}">Prev</a>\n            </li>\n            <t t-foreach="pager['pages']" t-as="page">\n                <li t-attf-class="page-item #{'active' if page['num'] == pager['page']['num'] else ''}"> <a t-att-href="page['url']" t-attf-class="page-link #{extraLinkClass}" t-raw="page['num']"/></li>\n            </t>\n            <li t-attf-class="page-item #{'disabled' if pager['page']['num'] == pager['page_count'] else ''}">\n                <a t-att-href="pager['page_next']['url'] if pager['page']['num'] != pager['page_count'] else None" t-attf-class="page-link #{extraLinkClass}">Next</a>\n            </li>\n        </ul>\n    </t>\n\n    	portal/views/portal_templates.xml	\N	\N	\N	\N	primary	t	1	2025-06-10 03:55:40.841132	1	2025-06-10 03:55:40.841132	f

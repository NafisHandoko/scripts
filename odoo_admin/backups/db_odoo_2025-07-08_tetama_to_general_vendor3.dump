, 'on_change': 'update_invoiced_target'}"/>\n                    </t>\n                    <t t-if="!record.invoiced_target.raw_value" class="col-12 o_kanban_primary_bottom text-center">\n                        <a href="#" class="sales_team_target_definition o_inline_link">Click to define an invoicing target</a>\n                    </t>\n                </t>\n            </xpath>\n\n            <xpath expr="//div[hasclass('o_kanban_manage_view')]" position="inside">\n                <div t-if="record.use_quotations.raw_value">\n                    <a name="356" type="action" class="o_quotation_view_button">Quotations</a>\n                </div>\n                <div>\n                    <a name="354" type="action">Sales Orders</a>\n                </div>\n                <div groups="account.group_account_invoice">\n                    <a name="357" type="action">Invoices</a>\n                </div>\n            </xpath>\n\n            <xpath expr="//div[hasclass('o_kanban_manage_new')]" position="inside">\n                <div t-if="record.use_quotations.raw_value">\n                    <a name="361" type="action">\n                        Quotation\n                    </a>\n                </div>\n            </xpath>\n\n            <xpath expr="//div[hasclass('o_kanban_manage_reports')]" position="inside">\n                <div name="sales_report">\n                    <a name="359" type="action">\n                        Sales\n                    </a>\n                </div>\n                <div groups="account.group_account_invoice" name="invoices_report">\n                    <a name="360" type="action">\n                        Invoices\n                    </a>\n                </div>\n            </xpath>\n\n        </data>\n        	sale/views/sales_team_views.xml	\N	\N	508	\N	extension	t	1	2025-06-10 03:58:25.67937	1	2025-06-10 03:58:25.67937	f

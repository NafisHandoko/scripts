1053	portal_my_billing	\N	ehealth.portal_my_billing	16	qweb	<?xml version="1.0"?>\n<t t-name="ehealth.portal_my_billing">\n        <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.5.1/jquery.min.js"/>\n        <script type="text/javascript" src="/ehealth/static/src/js/invoice_list.js"/>\n        <link rel="stylesheet" href="/ehealth/static/src/css/portal_style.css"/>\n        <link rel="stylesheet" href="/ehealth/static/src/css/billing.css"/>\n        <t t-call="portal.portal_layout">\n            <t t-set="no_breadcrumbs" t-value="True"/>\n            <t t-call="ehealth.portal_sidebar_menu"/>\n            <nav aria-label="breadcrumb">\n                <ol class="breadcrumb">\n                    <li class="breadcrumb-item active" aria-current="page">Billing</li>\n                </ol>\n            </nav>\n            <div class="frame" style="margin-bottom: 50px;">\n                <h5 style="font-weight: 600; color: var(--neutral-900);">Unpaid Bill</h5>\n                <div class="d-flex justify-content-between align-items-center" style="margin-top: 20px">\n                    <h2 style="font-size: 32px; margin: auto 0; font-weight: 600; color: var(--neutral-900);"><t t-esc="total_unpaid"/></h2>\n                    <a class="btn btn-ehealth-primary" style="width: 120px" href="#"> Pay Now </a>\n                </div>\n                <p class="smallest-due-date"><t t-esc="smallest_due_date"/></p>\n            </div>\n            <div class="frame" style="padding: 0">\n                <t t-call="portal.portal_table">\n                    <thead>\n                        <tr class="table-header">\n                            <th>Subscription</th>\n                            <th>Invoice Date</th>\n                            <th>Due Date</th>\n                            <th>Amount</th>\n                            <th>\n                                <span>Payment</span><br/>\n                                <span>Method</span>\n                            </th>\n                            <th>\n                                <span>Payment</span><br/>\n                                <span>Status</span>\n                            </th>\n                            <th>\n                                <span>Invoice</span><br/>\n                                <span>Number</span>\n                            </th>\n                            <th>Action</th>\n                        </tr>\n                    </thead>\n                    <tbody>\n                        <t t-foreach="subscriptions" t-as="subscription">\n                            <t t-foreach="subscription.invoice_reference" t-as="invoice">\n                                <tr class="table-body" t-if="invoice.state == 'posted'">\n                                    <td><span t-field="subscription.subscription_product_id.name"/></td>\n                                    <td><span t-esc="subscription.format_date(invoice.invoice_date)"/></td>\n                                    <td><span t-esc="subscription.format_date(invoice.invoice_date_due)"/></td>\n                                    <td><span style="font-weight: 600" t-field="invoice.amount_total_signed"/></td>\n                                    <td><span style="font-weight: 600" t-esc="subscription.get_payment_method(invoice.name)"/></td>\n                                    <td><span class="status-field" t-field="invoice.payment_state"/></td>\n                                    <td>\n                                        <a t-attf-href="/my/customer/billing/{{invoice.id}}">\n                                            <t t-esc="invoice.name" t-if="invoice.id != ''"/>\n                                            <em t-else="">Draft Invoice</em>\n                                        </a>\n                                    </td>\n                                    <td>\n                                        <a t-attf-href="/my/invoices/{{invoice.id}}?report_type=pdf&amp;download=true">\n                                            <t t-if="invoice.id != ''"><i class="fa fa-download"/></t>\n                                        </a>\n                                    </td>\n                                </tr>\n                            </t>\n                        </t>\n                    </tbody>\n                </t>\n            </div>\n        </t>\n    </t>\n    \n    	ehealth/views/portal_invoices.xml	f	<?xml version="1.0"?>\n<t t-name="ehealth.portal_my_billing">\n        <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.5.1/jquery.min.js"/>\n        <script type="text/javascript" src="/ehealth/static/src/js/invoice_list.js"/>\n        <link rel="stylesheet" href="/ehealth/static/src/css/portal_style.css"/>\n        <link rel="stylesheet" href="/ehealth/static/src/css/billing.css"/>\n        <t t-call="portal.portal_layout">\n            <t t-set="no_breadcrumbs" t-value="True"/>\n            <t t-call="ehealth.portal_sidebar_menu"/>\n            <nav aria-label="breadcrumb">\n                <ol class="breadcrumb">\n                    <li class="breadcrumb-item active" aria-current="page">Billing</li>\n                </ol>\n            </nav>\n            <div class="frame" style="margin-bottom: 50px;">\n                <h5 style="font-weight: 600; color: var(--neutral-900);">Unpaid Bill</h5>\n                <div class="d-flex justify-content-between align-items-center" style="margin-top: 20px">\n                    <h2 style="font-size: 32px; margin: auto 0; font-weight: 600; color: var(--neutral-900);"><t t-esc="total_unpaid"/></h2>\n                    <a class="btn btn-ehealth-primary" style="width: 120px" href="#"> Pay Now </a>\n                </div>\n                <p class="smallest-due-date"><t t-esc="smallest_due_date"/></p>\n            </div>\n            <div class="frame" style="padding: 0">\n                <t t-call="portal.portal_table">\n                    <thead>\n                       
ting-credential' if status == 'updating' else 'hidden'">\n                        <img src="/ehealth/static/src/image/icon_information.svg"/>\n                        <div>\n                            <p class="notify-title">Pembaruan kredensial sedang diproses</p>\n                            <p class="notify-description">Proses pembaruan Kode Akses API sedang berlangsung. Harap periksa kembali dalam beberapa menit.</p>\n                        </div>\n                    </div>\n                    <label>Organization ID</label>\n                    <div class="input-with-action">\n                        <input type="text" class="form-control" name="satusehat_organization_id" t-att-value="satusehat_organization_id" disabled="true"/>\n                        <div class="suffix">\n                            <img class="copy-input" src="/ehealth/static/src/image/icon_copy.svg"/>\n                        </div>\n                    </div>\n                    <label>Client ID</label>\n                    <div class="input-with-action">\n                        <input type="text" class="form-control" name="satusehat_client_id" t-att-value="satusehat_client_id" disabled="true"/>\n                        <div class="suffix">\n                            <img class="copy-input" src="/ehealth/static/src/image/icon_copy.svg"/>\n                        </div>\n                    </div>\n                    <label>Client Secret</label>\n                    <div class="input-with-action">\n                        <input type="text" class="form-control" name="satusehat_client_secret" t-att-value="satusehat_client_secret" disabled="true"/>\n                        <div class="suffix">\n                            <img class="copy-input" src="/ehealth/static/src/image/icon_copy.svg"/>\n                        </div>\n                    </div>\n                </div>\n                <hr class="spliter"/>\n                <div class="account-form">\n                    <p cla
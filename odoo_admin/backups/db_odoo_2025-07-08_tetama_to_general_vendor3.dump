ile-icon bx bx-mail-send"/>\n\t\t\t\t\t\t\t\t<div t-field="user_id.authorized_organization_id.email"/>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class="frame mt-12">\n\t\t\t\t\t\t<h5 class="card-title">Account Security</h5>\n\t\t\t\t\t\t<a class="underline" href="https://accounts.ehealth.co.id/realms/ehealth/account/#/security/signingin" target="_blank"> <i class="fa fa-pencil"/> Edit Security Settings </a>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t\t\n\t\t</t>\n    </t>\n\n\t	\N	\N	primary	t	1	2025-06-10 03:58:32.888888	1	2025-06-10 04:22:06.139859	f

1043	My Invoices and Payments	\N	ehealth.portal_my_practitioner	16	qweb	<?xml version="1.0"?>\n<t name="My Invoices and Payments" t-name="ehealth.portal_my_practitioner">\n        <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.5.1/jquery.min.js"/>\n        <script type="text/javascript" src="/ehealth/static/src/js/practitioner_list.js"/>\n        <link rel="stylesheet" href="/ehealth/static/src/css/portal_style.css"/>\n        <t t-call="portal.portal_layout">\n            <t t-set="no_breadcrumbs" t-value="True"/>\n            <t t-call="ehealth.portal_sidebar_menu"/>\n            <nav aria-label="breadcrumb">\n                <ol class="breadcrumb">\n                    <li class="breadcrumb-item active" aria-current="page">Practitioner List</li>\n                </ol>\n            </nav>\n            <div>\n                <div class="btn-group flex-grow-1">\n                    <a class="btn btn-ehealth-primary" href="/my/customer/practitioner/form" style="margin-bottom: 15px;"> +  Add New Practitioner </a>\n                </div>\n                <div class="frame" style="padding: 0">\n                    <t t-call="portal.portal_table">\n                        <thead>\n                            <tr class="table-header" style="height: 80px;">\n                                <th>Practitioner ID</th>\n                                <th>Name</th>\n                                <th>Email</th>\n                                <th>Role</th>\n                                <th>Status</th>\n                            </tr>\n                        </thead>\n                        <tbody>\n                            <t t-foreach="practitioners" t-as="practitioner">\n                                <tr class="table-body">\n                                    <td>\n                                        <a t-attf-href="/my/customer/practitioner/form/edit/{{practitioner.practitioner_id}}" t-att-title="practitioner.practitioner_id">\n                                            <t t-esc="practitioner.practitioner_id" t-if="practitioner.practitioner_id != ''"/>\n                                            <em t-else="">Draft Practitioner</em>\n                                        </a>\n                                    </td>\n                                    <td>\n                                        <span t-esc="practitioner.prefix_name and (practitioner.prefix_name + ' ')"/>\n                                        <span t-esc="practitioner.given_name"/>\n                                        <span t-esc="practitioner.family_name and (' ' + practitioner.family_name)"/>\n                                        <span t-esc="practitioner.suffix_name and (' ' + practitioner.suffix_name)"/>\n                                    </td>\n                                    <td><span t-field="practitioner.email"/></td>\n                                    <td>\n                                        <t t-foreach="practitioner.practitioner_role_ids" t-as="role">\n                                            <span t-esc="role.name"/>,\n                                        </t>\n                                    </td>\n                                    <td>\n                                        <span class="status-field" t-field="practitioner.is_active"/>\n                                    </td>\n                                </tr>\n                            </t>\n                        </tbody>\n                    </t>\n                </div>\n            </div>\n        </t>\n    </t>\n\n    	ehealth/views/portal_practitioner.xml	f	<?xml version="1.0"?>\n<t name="My Invoices and Payments" t-name="ehealth.portal_my_practitioner">\n        <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.5.1/jquery.min.js"/>\n        <script type="text/javascript" src="/ehealth/static/src/js/practitioner_list.js"/>\n        <link rel="stylesheet" href="/ehealth/static/src/css/portal_style.css"/>\n        <t t-call="portal.portal_layout">\n            <t t-set="no_breadcrumbs" t-value="True"/>\n            <t t-call="ehealth.portal_sidebar_menu"/>\n            <nav aria-label="breadcrumb">\n                <ol class="breadcrumb">\n                    <li class="breadcrumb-item active" aria-current="page">Practitioner List</li>\n                </ol>\n            </nav>\n            <div>\n                <div class="btn-group flex-grow-1">\n                    <a class="btn btn-ehealth-primary" href="/my/customer/practitioner/form" style="margin-bottom: 15px;"> +  Add New Practitioner </a>\n                </div>\n                <div class="frame" style="padding: 0">\n                    <t t-call="portal.portal_table">\n                        <thead>\n                            <tr class="table-header" style="height: 80px;">\n                                <th>Practitioner ID</th>\n                                <th>Name</th>\n                                <th>Email</th>\n                                <th>Role</th>\n                                <th>Status</th>\n                            </tr>\n                        </thead>\n                        <tbody>\n                            <t t-foreach="practitioners" t-as="practitioner">\n                                <tr class="table-body">\n                                    <td>\n                                        <a t-attf-href="/my/customer/practitioner/form/edit/{{practitioner.practitioner_id}}" t-att-title="practitioner.practitioner_id">\n                                            <t t-esc="practitioner.practitioner_id" t-if="practitioner.practitioner_id != ''"/>\n                                            <em t-else="">Draft Practitioner</em>\n                                        </a>\n                                    </td>\n                                    <td>\n                                        <span t-esc="practitioner.prefix_name and (practitioner.prefix_name + ' ')"/>\n                                        <span t-esc="practitioner.given_name"/>\n                                        <span t-esc="practitioner.family_name and (' ' + practitioner.family_name)"/>\n                                        <span t-esc="practitioner.suffix_name and (' ' + practitioner.suffix_name)"/>\n                                    </td>\n                                    <td><span t-field="practitioner.email"/></td>\n                                    <td>\n                                        <t t-foreach="practitioner.practitioner_role_ids" t-as="role">\n                                            <span t-esc="role.name"/>,\n                                        </t>\n                                    </td>\n                                    <td>\n                                        <span class="status-field" t-field="practitioner.is_active"/>\n                                    </td>\n                                </tr>\n                            </t>\n                        </tbody>\n                    </t>\n                </div>\n            </div>\n        </t>\n    </t>\n\n    	\N	\N	primary	t	1	2025-06-10 03:58:32.888888	1	2025-06-10 04:22:06.139859	f

1048	portal_subscription_list	\N	ehealth.portal_subscription_list	16	qweb	<?xml version="1.0"?>\n<t t-name="ehealth.portal_subscription_list">\n        <link rel="stylesheet" href="/ehealth/static/src/css/subscription_list.css"/>\n        <link rel="stylesheet" href="/ehealth/static/src/css/confirmation_dialog.css"/>\n        <t t-call="portal.portal_layout">\n            <t t-set="no_breadcrumbs" t-value="True"/>\n            <t t-call="ehealth.portal_sidebar_menu"/>\n            <div class="has_confirmation_dialog" style="margin-left: 50px;">\n                <h3 class="page-title">Subscription</h3>\n                <div class="pricingTable">  \n                    <ul class="pricingTable-firstTable">\n                        <t t-foreach="subscription_product" t-as="product">\n                            <li t-if="product.create_invoice" class="pricingTable-firstTable_table">\n                                <h1 class="pricingTable-firstTable_table__header"><t t-esc="product.name"/></h1>\n                                <p class="pricingTable-firstTable_table__pricing"><span>Rp</span><span><t t-esc="product.list_price"/></span><span><t t-esc="product.subscription_template_id.period_rule_type"/></span></p>\n                                <p class="pricingTable-firstTable_table__options">\n                                    <t t-esc="product.description"/>\n                                </p>\n                                <t t-if="product.id in subscribed">\n                                    <div class="subscribed">Subscribed</div>\n                                </t>\n                                <t t-else="">\n                                    <a class="pricingTable-firstTable_table__getstart" id="modal" t-attf-href="/my/customer/subscription/create/{{product.id}}">Subscribe Now</a>\n<!--                                    <input type="hidden"  t-att-value="product.id"/>-->\n                                </t>\n                            </li>\n                        </t>\n                    </ul>\n                </div>\n                <div id="boxes">\n                    <div id="dialog" class="window">\n                        <div class="cd-popup-container">\n                            <p>By clicking "yes", you are agree to our <a href="#">Terms of the Subscription Agreement</a>\n                                <br/>Are you sure you want to subscribe this product?</p>\n                            <ul class="cd-buttons">\n                                <li><a id="yes_button">Yes</a></li>\n                                <li><a id="no_button">No</a></li>\n                            </ul>\n                            <a href="#0" class="cd-popup-close img-replace" id="close_modal"/>\n                        </div>\n                    </div>\n                    <!-- Do not remove div#mask, because you'll need it to fill the whole screen -->\n                    <div id="mask"/>\n                </div>\n            </div>\n        </t>\n    </t>\n\n    	ehealth/views/portal_subscription.xml	f	<?xml version="1.0"?>\n<t t-name="ehealth.portal_subscription_list">\n        <link rel="stylesheet" href="/ehealth/static/src/css/subscription_list.css"/>\n        <link rel="stylesheet" href="/ehealth/static/src/css/confirmation_dialog.css"/>\n        <t t-call="portal.portal_layout">\n            <t t-set="no_breadcrumbs" t-value="True"/>\n            <t t-call="ehealth.portal_sidebar_menu"/>\n            <div class="has_confirmation_dialog" style="margin-left: 50px;">\n                <h3 class="page-title">Subscription</h3>\n                <div class="pricingTable">  \n                    <ul class="pricingTable-firstTable">\n                        <t t-foreach="subscription_product" t-as="product">\n                            <li t-if="product.create_invoice" class="pricingTable-firstTable_table">\n                                <h1 class="pricingTable-firstTable_table__header"><t t-esc="product.name"/></h1>\n                                <p class="pricingTable-firstTable_table__pricing"><span>Rp</span><span><t t-esc="product.list_price"/></span><span><t t-esc="product.subscription_template_id.period_rule_type"/></span></p>\n                                <p class="pricingTable-firstTable_table__options">\n                                    <t t-esc="product.description"/>\n                                </p>\n                                <t t-if="product.id in subscribed">\n                                    <div class="subscribed">Subscribed</div>\n                                </t>\n                                <t t-else="">\n                                    <a class="pricingTable-firstTable_table__getstart" id="modal" t-attf-href="/my/customer/subscription/create/{{product.id}}">Subscribe Now</a>\n<!--                                    <input type="hidden"  t-att-value="product.id"/>-->\n                                </t>\n                            </li>\n                        </t>\n                    </ul>\n                </div>\n                <div id="boxes">\n                    <div id="dialog" class="window">\n                        <div class="cd-popup-container">\n                            <p>By clicking "yes", you are agree to our <a href="#">Terms of the Subscription Agreement</a>\n                                <br/>Are you sure you want to subscribe this product?</p>\n                            <ul class="cd-buttons">\n                                <li><a id="yes_button">Yes</a></li>\n                                <li><a id="no_button">No</a></li>\n                            </ul>\n                            <a href="#0" class="cd-popup-close img-replace" id="close_modal"/>\n                        </div>\n                    </div>\n                    <!-- Do not remove div#mask, because you'll need it to fill the whole screen -->\n                    <div id="mask"/>\n                </div>\n            </d
674	account.tax.search.filters	account.tax	\N	16	search	<?xml version="1.0"?>\n<search string="Search Taxes">\n                    <field name="name" filter_domain="['|', ('name','ilike',self), ('description','ilike',self)]" string="Tax"/>\n                    <field name="company_id" groups="base.group_multi_company"/>\n                </search>\n            	account/views/account_tax_views.xml	\N	\N	\N	\N	primary	t	1	2025-06-10 03:55:46.489222	1	2025-06-10 03:55:46.489222	f
675	account.tax.form	account.tax	\N	16	form	<?xml version="1.0"?>\n<form string="Account Tax">\n                    <sheet>\n                    <group>\n                        <group>\n                            <field name="name"/>\n                            <field name="amount_type"/>\n                            <field name="active" widget="boolean_toggle"/>\n                        </group>\n                        <group>\n                            <field name="type_tax_use"/>\n                            <field name="tax_scope"/>\n                            <label for="amount" attrs="{'invisible':[('amount_type','not in', ('fixed', 'percent', 'division'))]}"/>\n                            <div attrs="{'invisible':[('amount_type','not in', ('fixed', 'percent', 'division'))]}">\n                                <field name="amount" class="oe_inline"/>\n                                <span class="o_form_label oe_inline" attrs="{'invisible':[('amount_type','=','fixed')]}">%</span>\n                            </div>\n                        </group>\n                    </group>\n                    <notebook>\n                        <page string="Definition" name="definition">\n                            <div attrs="{'invisible': [('amount_type', '=', 'group')]}">\n                                <field name="tax_fiscal_country_id" invisible="1"/>\n                                <field name="country_code" invisible="1"/>\n                                <group string="Distribution for Invoices">\n                                    <field name="invoice_repartition_line_ids" nolabel="1" context="{'default_company_id': company_id}"/>\n                                </group>\n                                <group string="Distribution for Credit Notes">\n                                    <field name="refund_repartition_line_ids" nolabel="1" context="{'default_company_id': company_id}"/>\n                                </group>\n                            </div>\n                            <field name="children_tax_ids" attrs="{'invisible':['|', ('amount_type','!=','group'), ('type_tax_use','=','none')]}" domain="[('type_tax_use','in',('none',type_tax_use)), ('amount_type','!=','group')]">\n                                <tree string="Children Taxes">\n                                    <field name="sequence" widget="handle"/>\n                                    <field name="name"/>\n                                    <field name="amount_type"/>\n                                    <field name="amount"/>\n                                </tree>\n                            </field>\n                        </page>\n                        <page string="Advanced Options" name="advanced_options">\n                            <group>\n                                <group>\n                                    <field name="description" attrs="{'invisible':[('amount_type','=', 'group')]}"/>\n                                    <field name="tax_group_id"/>\n                                    <field name="analytic" attrs="{'invisible':[('amount_type','=', 'group')]}" groups="analytic.group_analytic_accounting"/>\n                                    <field name="company_id" options="{'no_create': True}" groups="base.group_multi_company"/>\n                                </group>\n                                <group name="advanced_booleans">\n                                    <field name="price_include" attrs="{'invisible':[('amount_type','=', 'group')]}"/>\n                                    <field name="include_base_amount" attrs="{'invisible':[('amount_type','=', 'group')]}"/>\n                                    <field name="hide_tax_exigibility" invisible="1"/>\n                                    <field name="tax_exigibility" widget="radio" attrs="{'invisible':['|', ('amount_type','=', 'group'), ('hide_tax_exigibility', '=', False)]}" groups="account.group_account_readonly"/>\n                                    <field name="cash_basis_transition_account_id" options="{'no_create': True}" attrs="{'invisible': [('tax_exigibility', '=', 'on_invoice')], 'required': [('tax_exigibility', '=', 'on_payment')]}" groups="account.group_account_readonly"/>\n                                </group>\n                            </group>\n                        </page>\n                    </notebook>\n                </sheet>\n                </form>\n              	account/views/account_tax_views.xml	\N	\N	\N	\N	primary	t	1	2025-06-10 03:55:46.489222	1	2025-06-10 03:55:46.489222	f
990	res.config.settings.view.form.inherit.sale	res.config.settings	\N	10	form	<?xml version="1.0"?>\n<xpath expr="//div[hasclass('settings')]" position="inside">\n                <div class="app_settings_block o_not_app" data-string="Sales" string="Sales" data-key="sale_management" groups="sales_team.group_sale_manager">\n                    <h2>Product Catalog</h2>\n                    <div class="row mt16 o_settings_container" name="catalog_setting_container">\n                        <div class="col-12 col-lg-6 o_setting_box" id="variant_options">\n                            <div class="o_setting_left_pane">\n                                <field name="group_product_variant"/>\n                            </div>\n                            <div class="o_setting_right_pane">\n                                <label for="group_product_variant"/>\n                                <a href="https://www.odoo.com/documentation/user/14.0/sales/products_prices/products/variants.html" title="Documentation" class="o_doc_link" target="_blank"/>\n                                <div class="text-muted">\n                                    Sell variants of a product using attributes (size, color, etc.)\n                                </div>\n                                <div class="content-group" attrs="{'invisible': [('group_product_variant','=',False)]}">\n                                    <div class="mt8">\n                                        <button name="144" icon="fa-arrow-right" type="action" string="Attributes" class="btn-link"/>\n                                    </div>\n                                </div>\n                            </div>\n                        </div>\n                        <div class="col-12 col-lg-6 o_setting_box" id="product_configurator">\n                            <div class="o_setting_left_pane">\n                                <field name="module_sale_product_configurator"/>\n                            </div>\n                            <div class="o_setting_right_pane">\n                                <label for="module_sale_product_configurator"/>\n                                <div class="text-muted">\n                                    Select product attributes and optional products from the sales order\n                                </div>\n                            </div>\n                        </div>\n                        <div class="col-12 col-lg-6 o_setting_box" id="product_matrix">\n                            <div class="o_setting_left_pane">\n                                <field name="module_sale_product_matrix"/>\n                            </div>\n                            <div class="o_setting_right_pane">\n                                <label for="module_sale_product_matrix" string="Variant Grid Entry"/>\n                                <div class="text-muted">\n                                    Add several variants to an order from a grid\n                                </div>\n                            </div>\n                        </div>\n                        <div class="col-12 col-lg-6 o_setting_box" id="uom_settings">\n                            <div class="o_setting_left_pane">\n                                <field name="group_uom"/>\n                            </div>\n                            <div class="o_setting_right_pane">\n                                <label for="group_uom"/>\n                                <div class="text-muted">\n                                    Sell and purchase products in different units of measure\n                                </div>\n                                <div class="content-group" attrs="{'invisible': [('group_uom','=',False)]}">\n                                    <div class="mt8">\n                                        <button name="84" icon="fa-arrow-right" type="action" string="Units of Measure" class="btn-link"/>\n                                    </div>\n                                </div>\n                            </div>\n                        </div>\n                        <div class="col-12 col-lg-6 o_setting_box" id="email_template" title="Sending an email is useful if you need to share specific information or content about a product (instructions, rules, links, media, etc.). Create and set the email template from the product detail form (in Sales tab).">\n                            <div class="o_setting_left_pane">\n                                <field name="module_product_email_template"/>\n                            </div>\n                            <div class="o_setting_right_pane">\n                                <label for="module_product_email_template" string="Deliver Content by Email"/>\n                                <div class="text-muted">\n                                    Send a product-specific email once the invoice is validated\n                                </div>\n                            </div>\n                        </div>\n                        <div class="col-12 col-lg-6 o_setting_box" id="stock_packaging" title="Ability to select a package type in sales orders and to force a quantity that is a multiple of the number of units per package.">\n                            <div class="o_setting_left_pane">\n                                <field name="group_stock_packaging"/>\n                            </div>\n                            <div class="o_setting_right_pane">\n                                <label for="group_stock_packaging"/>\n                                <div class="text-muted">\n                                    Sell products by multiple of unit # per package\n                                </div>\n                            </div>\n                        </div>\n                    </div>\n                    <h2>Pricing</h2>\n                    <div class="row mt16 o_settings_container" id="pricing_setting_container">\n                      <div class="col-12 col-lg-6 o_setting_box" id="discount_sale_order_lines" title="Apply manual discounts on sales order lines or display discounts computed from pricelists (option to activate in the pricelist configuration).">\n                           <div class="o_setting_left_pane">\n                               <field name="group_discount_per_so_line"/>\n                           </div>\n                           <div class="o_setting_right_pane">\n                               <label for="group_discount_per_so_line"/>\n                               <div class="text-muted">\n                                   Grant discounts on sales order lines\n                               </div>\n                           </div>\n                       </div>\n                        <div class="col-12 col-lg-6 o_setting_box" id="coupon_settings" title="Boost your sales with two kinds of discount programs: promotions and coupon codes. Specific conditions can be set (products, customers, minimum purchase amount, period). Rewards can be discounts (% or amount) or free products.">\n                            <div class="o_setting_left_pane">\n                                <field name="module_sale_coupon"/>\n                            </div>\n                            <div class="o_setting_right_pane">\n                                <label for="module_sale_coupon"/>\n                                <div class="text-muted" id="sale_coupon">\n                                    Manage promotion &amp; coupon programs\n                                </div>\n                            </div>\n                        </div>\n                        <div class="col-12 col-lg-6 o_setting_box" id="pricelist_configuration">\n                            <div class="o_setting_left_pane">\n                                <field name="group_product_pricelist"/>\n                            </div>\n                            <div class="o_setting_right_pane">\n                                <label for="group_product_pricelist"/>\n                                <a href="https://www.odoo.com/documentation/user/14.0/sales/products_prices/prices/pricing.html" title="Documentation" class="o_doc_link" target="_blank"/>\n                                <div class="text-muted">\n                                    Set multiple prices per product, automated discounts, etc.\n                                </div>\n                                <div class="content-group" attrs="{'invisible': [('group_product_pricelist' ,'=', False)]}">\n                                    <div class="mt16">\n                                        <field name="group_sale_pricelist" invisible="1"/>\n                                        <field name="product_pricelist_setting" widget="radio" class="o_light_label"/>\n                                    </div>\n                                    <div class="mt8">\n                                        <button name="156" icon="fa-arrow-right" type="action" string="Pricelists" groups="product.group_product_pricelist" class="btn-link"/>\n                                    </div>\n                                </div>\n                            </div>\n                        </div>\n                        <div class="col-12 col-lg-6 o_setting_box" id="auth_signup_documents" title=" To send invitations in B2B mode, open a contact or select several ones in list view and click on 'Portal Access Management' option in the dropdown menu *Action*.">\n                            <div class="o_setting_left_pane">\n                            </div>\n                            <div class="o_setting_right_pane">\n                                <label for="auth_signup_uninvited"/>\n                                <div class="text-muted">\n                                    Let your customers log in to see their documents\n                                </div>\n                                <div class="mt8">\n                                    <field name="auth_signup_uninvited" class="o_light_label" widget="radio" required="True"/>\n                                </div>\n                            </div>\n                        </div>\n                        <div class="col-12 col-lg-6 o_setting_box" id="show_margins" title="The margin is computed as the sum of product sales prices minus the cost set in their detail form.">\n                            <div class="o_setting_left_pane">\n                                <field name="module_sale_margin"/>\n                            </div>\n                            <div class="o_setting_right_pane">\n                                <label for="module_sale_margin"/>\n                                <div class="text-muted">\n                                    Show margins on orders\n                                </div>\n                            </div>\n                        </div>\n                    </div>\n                    <h2>Quotations &amp; Orders</h2>\n                    <div class="row mt16 o_settings_container" name="quotation_order_setting_container">\n                        <div class="col-12 col-lg-6 o_setting_box" id="sale_config_online_confirmation_sign">\n                            <div class="o_setting_left_pane">\n                                <field name="portal_confirmation_sign"/>\n                            </div>\n                            <div class="o_setting_right_pane">\n                                <label for="portal_confirmation_sign"/>\n                                <a href="https://www.odoo.com/documentation/user/14.0/sales/send_quotations/get_signature_to_validate.html" title="Documentation" class="mr-2 o_doc_link" target="_blank"/>\n                                <span class="fa fa-lg fa-building-o" title="Values set here are company-specific." groups="base.group_multi_company"/>\n                                <div class="text-muted">\n                                    Request an online signature to confirm orders\n                                </div>\n                            </div>\n                        </div>\n                        <div class="col-12 col-lg-6 o_setting_box" id="sale_config_online_confirmation_pay">\n                            <div class="o_setting_left_pane">\n                                <field name="portal_confirmation_pay"/>\n                            </div>\n                            <div class="o_setting_right_pane">\n                                <label for="portal_confirmation_pay"/>\n                                <a href="https://www.odoo.com/documentation/user/14.0/sales/send_quotations/get_paid_to_validate.html" title="Documentation" class="mr-2 o_doc_link" target="_blank"/>\n                                <span class="fa fa-lg fa-building-o" title="Values set here are company-specific." groups="base.group_multi_company"/>\n                                <div class="text-muted">\n                                    Request an online payment to confirm orders\n                                </div>\n                                <div class="mt8" attrs="{'invisible': [('portal_confirmation_pay', '=', False)]}">\n                                    <button name="330" icon="fa-arrow-right" type="action" string="Payment Acquirers" class="btn-link"/>\n                                </div>\n                            </div>\n                        </div>\n                        <div class="col-12 col-lg-6 o_setting_box" id="confirmation_email_setting" attrs="{'invisible': [('portal_confirmation_pay', '=', False) , ('portal_confirmation_sign', '=', False)]}" groups="base.group_no_one">\n                            <div class="o_setting_right_pane">\n                                <span class="o_form_label">Confirmation Email</span>\n                                <div class="text-muted">\n                                    Automatic email sent after the customer has signed or paid online\n                                </div>\n                                <div class="row mt16">\n                                    <label for="confirmation_template_id" string="Email Template" class="col-lg-4 o_light_label"/>\n                                    <field name="confirmation_template_id" class="oe_inline"/>\n                                </div>\n                            </div>\n                        </div>\n                        <div class="col-12 col-lg-6 o_setting_box" id="invoice_delivery_addresses">\n                            <div class="o_setting_left_pane">\n                                <field name="group_sale_delivery_address"/>\n                            </div>\n                            <div class="o_setting_right_pane">\n                                <label for="group_sale_delivery_address"/>\n                                <a href="https://www.odoo.com/documentation/user/14.0/sales/send_quotations/different_addresses.html" title="Documentation" class="o_doc_link" target="_blank"/>\n                                <div class="text-muted">\n                                    Select specific invoice and delivery addresses\n                                </div>\n                            </div>\n                        </div>\n                        <div class="col-12 col-lg-6 o_setting_box" id="quotation_validity_days">\n                            <div class="o_setting_left_pane">\n                                <field name="use_quotation_validity_days"/>\n                            </div>\n                            <div class="o_setting_right_pane">\n                                <label for="use_quotation_validity_days"/>\n                                <span class="fa fa-lg fa-building-o" title="Values set here are company-specific." aria-label="Values set here are company-specific." groups="base.group_multi_company" role="img"/>\n                                <div class="text-muted">\n                                    Set a default validity on your quotations\n                                </div>\n                                <div class="content-group" attrs="{'invisible': [('use_quotation_validity_days','=',False)]}">\n                                    <div class="mt16">\n                                        <span class="col-lg-3">Default Limit: <field name="quotation_validity_days" attrs="{'required': [('use_quotation_validity_days', '=', True)]}"/> days</span>\n                                    </div>\n                                </div>\n                            </div>\n                        </div>\n                        <div class="col-12 col-lg-6 o_setting_box" id="order_warnings">\n                            <div class="o_setting_left_pane">\n                                <field name="group_warning_sale"/>\n                            </div>\n                            <div class="o_setting_right_pane">\n                                <label for="group_warning_sale" string="Sale Warnings"/>\n                                <div class="text-muted">\n                                    Get warnings in orders for products or customers\n                                </div>\n                            </div>\n                        </div>\n                        <div class="col-12 col-lg-6 o_setting_box" id="no_edit_order">\n                            <div class="o_setting_left_pane">\n                                <field name="group_auto_done_setting"/>\n                            </div>\n                            <div class="o_setting_right_pane">\n                                <label for="group_auto_done_setting"/>\n                                <div class="text-muted">\n                                    No longer edit orders once confirmed\n                                </div>\n                            </div>\n                        </div>\n                        <div class="col-12 col-lg-6 o_setting_box" id="proforma_configuration">\n                            <div class="o_setting_left_pane">\n                                <field name="group_proforma_sales"/>\n                            </div>\n                            <div class="o_setting_right_pane">\n                                <label for="group_proforma_sales"/>\n                                <div class="text-muted">\n                                    Allows you to send Pro-Forma Invoice to your customers\n                                </div>\n                            </div>\n                        </div>\n                    </div>\n                    <h2 class="mt32">Shipping</h2>\n                    <div class="row mt16 o_settings_container" name="shipping_setting_container">\n                        <div class="col-12 col-lg-6 o_setting_box" id="delivery">\n                            <div class="o_setting_left_pane">\n                                <field name="module_delivery"/>\n                            </div>\n                            <div class="o_setting_right_pane">\n                                <label for="module_delivery"/>\n                                <div class="text-muted" id="delivery_carrier">\n                                    Compute shipping costs on orders\n                                </div>\n                            </div>\n                        </div>\n                        <div class="col-12 col-lg-6 o_setting_box" id="ups">\n                            <div class="o_setting_left_pane">\n                                <field name="module_delivery_ups" widget="upgrade_boolean"/>\n                            </div>\n                            <div class="o_setting_right_pane">\n                                <label for="module_delivery_ups"/>\n                                <div class="text-muted">\n                                    Compute shipping costs and ship with UPS\n                                </div>\n                                <div class="content-group">\n                                    <div id="sale_delivery_ups"/>\n                                </div>\n                            </div>\n                        </div>\n                        <div class="col-12 col-lg-6 o_setting_box" id="shipping_costs_dhl">\n                            <div class="o_setting_left_pane">\n                                <field name="module_delivery_dhl" widget="upgrade_boolean"/>\n                            </div>\n                            <div class="o_setting_right_pane">\n                                <label for="module_delivery_dhl"/>\n                                <div class="text-muted">\n                                    Compute shipping costs and ship with DHL\n                                </div>\n                                <div class="content-group">\n                                    <div id="sale_delivery_dhl"/>\n                                </div>\n                            </div>\n                        </div>\n                        <div class="col-12 col-lg-6 o_setting_box" id="shipping_costs_fedex">\n                            <div class="o_setting_left_pane">\n                                <field name="module_delivery_fedex" widget="upgrade_boolean"/>\n                            </div>\n                            <div class="o_setting_right_pane">\n                                <label for="module_delivery_fedex"/>\n                                <div class="text-muted">\n                                    Compute shipping costs and ship with FedEx\n                                </div>\n                                <div class="content-group">\n                                    <div id="sale_delivery_fedex"/>\n                                </div>\n                            </div>\n                        </div>\n                        <div class="col-12 col-lg-6 o_setting_box" id="shipping_costs_usps">\n                            <div class="o_setting_left_pane">\n                                <field name="module_delivery_usps" widget="upgrade_boolean"/>\n                            </div>\n                            <div class="o_setting_right_pane">\n                                <label for="module_delivery_usps"/>\n                                <div class="text-muted">\n                                    Compute shipping costs and ship with USPS\n                                </div>\n                                <div class="content-group">\n                                    <div id="sale_delivery_usps"/>\n                                </div>\n                            </div>\n                        </div>\n                        <div class="col-12 col-lg-6 o_setting_box" id="shipping_costs_bpost">\n                            <div class="o_setting_left_pane">\n                                <field name="module_delivery_bpost" widget="upgrade_boolean"/>\n                            </div>\n                            <div class="o_setting_right_pane">\n                                <label for="module_delivery_bpost"/>\n                                <div class="text-muted">\n                                    Compute shipping costs and ship with bpost\n                                </div>\n                                <div class="content-group">\n                                    <div id="sale_delivery_bpost"/>\n                                </div>\n                            </div>\n                        </div>\n                        <div class="col-12 col-lg-6 o_setting_box" id="shipping_costs_easypost">\n                            <div class="o_setting_left_pane">\n                                <field name="module_delivery_easypost" widget="upgrade_boolean"/>\n                            </div>\n                            <div class="o_setting_right_pane">\n                                <label for="module_delivery_easypost"/>\n                                <div class="text-muted">\n                                    Compute shipping costs and ship with Easypost\n                                </div>\n                                <div class="content-group">\n                                    <div id="sale_delivery_easypost"/>\n                                </div>\n                            </div>\n                        </div>\n                    </div>\n                    <h2>Invoicing</h2>\n                    <div class="row mt16 o_settings_container" name="invoicing_setting_container">\n                        <div id="sales_settings_invoicing_policy" class="col-12 col-lg-6 o_setting_box" title="This default value is applied to any new product created. This can be changed in the product detail form.">\n                            <div class="o_setting_right_pane">\n                                <label for="default_invoice_policy"/>\n                                <a href="https://www.odoo.com/documentation/user/14.0/sales/invoicing/invoicing_policy.html" title="Documentation" class="o_doc_link" target="_blank"/>\n                                <div class="text-muted">\n                                    Quantities to invoice from sales orders\n                                </div>\n                                <div class="content-group">\n                                    <div class="mt16">\n                                        <field name="default_invoice_policy" class="o_light_label" widget="radio"/>\n                                    </div>\n                                </div>\n                            </div>\n                        </div>\n                        <div class="col-xs-12 col-md-6 o_setting_box" id="automatic_invoicing" attrs="{'invisible': ['|', ('default_invoice_policy', '!=', 'order'), ('portal_confirmation_pay', '=', False)]}">\n                            <div class="o_setting_left_pane">\n                 
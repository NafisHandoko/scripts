1047	portal_practitioner_page_detail	\N	ehealth.portal_practitioner_page_detail	16	qweb	<?xml version="1.0"?>\n<t t-name="ehealth.portal_practitioner_page_detail">\n        <link rel="stylesheet" href="/ehealth/static/src/css/style.css"/>\n        <t t-call="portal.portal_layout">\n            <t t-set="no_breadcrumbs" t-value="True"/>\n            <t t-call="ehealth.portal_sidebar_menu"/>\n            <div style="margin-left: 50px;">\n                <h3 class="page-title">Practitioner Detail</h3>\n                <div class="content-right">\n                    <div class="btn-group flex-grow-1 button-view">\n                        <a class="btn-secondary btn-round-padding" t-attf-href="/my/customer/practitioner/form/edit/{{practitioner.practitioner_id}}"><i class="fa fa-edit"/> Edit </a>\n                    </div>\n                </div>\n                <div class="page page-detail">\n                    <div class="row">\n                        <div class="col-md-12">\n                            <p class="text-center mt-3"><strong>Practitioner <t t-esc="practitioner.given_name"/></strong></p>\n                            <div class="mt-3">\n                                <div class="row">\n                                    <div class="col-3">Practitioner ID</div>\n                                    <div class="col-7">: <t t-esc="practitioner.practitioner_id"/></div>\n                                </div>\n                                <div class="row">\n                                    <div class="col-3">Prefix</div>\n                                    <div class="col-7">: <t t-esc="practitioner.prefix_name"/></div>\n                                </div>\n                                <div class="row">\n                                    <div class="col-3">Given Name</div>\n                                    <div class="col-7">: <t t-esc="practitioner.given_name"/></div>\n                                </div>\n                                <div class="row">\n                                    <div class="col-3">Family Name</div>\n                                    <div class="col-7">: <t t-esc="practitioner.family_name"/></div>\n                                </div>\n                                <div class="row">\n                                    <div class="col-3">Suffix</div>\n                                    <div class="col-7">: <t t-esc="practitioner.suffix_name"/></div>\n                                </div>\n                                <div class="row">\n                                    <div class="col-3">Email</div>\n                                    <div class="col-7">: <t t-esc="practitioner.email"/></div>\n                                </div>\n                                <div class="row">\n                                    <div class="col-3">Role</div>\n                                    <div class="col-7 role">: <t t-esc="practitioner.role"/></div>\n                                </div>\n                                <t t-if="practitioner.role == 'doctor'">\n                                    <div class="row">\n                                        <div class="col-3">SIP</div>\n                                        <div class="col-7">: <t t-esc="practitioner.sip"/></div>\n                                    </div>\n                                </t>\n                                <t t-if="practitioner.role == 'apothecary'">\n                                    <div class="row">\n                                        <div class="col-3">SIPA</div>\n                                        <div class="col-7">: <t t-esc="practitioner.sipa"/></div>\n                                    </div>\n                                </t>\n                                <t t-if="practitioner.role == 'doctor'">\n                                    <div class="row">\n                                        <div class="col-3">Kode Dokter BPJS</div>\n                                        <div class="col-7">: <t t-esc="practitioner.kode_dokter_bpjs"/></div>\n                                    </div>\n                                </t>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </t>\n    </t>\n	ehealth/views/portal_practitioner.xml	f	<?xml version="1.0"?>\n<t t-name="ehealth.portal_practitioner_page_detail">\n        <link rel="stylesheet" href="/ehealth/static/src/css/style.css"/>\n        <t t-call="portal.portal_layout">\n            <t t-set="no_breadcrumbs" t-value="True"/>\n            <t t-call="ehealth.portal_sidebar_menu"/>\n            <div style="margin-left: 50px;">\n                <h3 class="page-title">Practitioner Detail</h3>\n                <div class="content-right">\n                    <div class="btn-group flex-grow-1 button-view">\n                        <a class="btn-secondary btn-round-padding" t-attf-href="/my/customer/practitioner/form/edit/{{practitioner.practitioner_id}}"><i class="fa fa-edit"/> Edit </a>\n                    </div>\n                </div>\n                <div class="page page-detail">\n                    <div class="row">\n                        <div class="col-md-12">\n                            <p class="text-center mt-3"><strong>Practitioner <t t-esc="practitioner.given_name"/></strong></p>\n                            <div class="mt-3">\n                                <div class="row">\n                                    <div class="col-3">Practitioner ID</div>\n                                    <div class="col-7">: <t t-esc="practitioner.practitioner_id"/></div>\n                                </div>\n                                <div class="row">\n                                    <div class="col-3">Prefix</div>\n                                    <div class="col-7">: <t t-esc="practitioner.prefix_name"/></div>\n                                </div>\n                                <div class="row">\n                                    <div class="col-3">Given Name</div>\n                                    <div class="col-7">: <t t-esc="practitioner.given_name"/></div>\n                                </div>\n                                <div class="row">\n                                    <div class="col-3">Family Name</div>\n                                    <div class="col-7">: <t t-esc="practitioner.family_name"/></div>\n                                </div>\n                                <div class="row">\n                                    <div class="col-3">Suffix</div>\n                                    <div class="col-7">: <t t-esc="practitioner.suffix_name"/></div>\n                                </div>\n                                <div class="row">\n                                    <div class="col-3">Email</div>\n                                    <div class="col-7">: <t t-esc="practitioner.email"/></div>\n                                </div>\n                                <div class="row">\n                                    <div class="col-3">Role</div>\n                                    <div class="col-7 role">: <t t-esc="practitioner.role"/></div>\n                                </div>\n                                <t t-if="practitioner.role == 'doctor'">\n                                    <div class="row">\n                                        <div class="col-3">SIP</div>\n                                        <div class="col-7">: <t t-esc="practitioner.sip"/></div>\n                                    </div>\n                                </t>\n                                <t t-if="practitioner.role == 'apothecary'">\n                                    <div class="row">\n                                        <div class="col-3">SIPA</div>\n                                        <div class="col-7">: <t t-esc="practitioner.sipa"/></div>\n        
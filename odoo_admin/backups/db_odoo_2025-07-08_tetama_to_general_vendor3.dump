1030	Portal customer	\N	ehealth.portal_my_customer	30	qweb	<?xml version="1.0"?>\n<t name="Portal customer" priority="30" t-name="ehealth.portal_my_customer">\n\t\t<link rel="stylesheet" href="/ehealth/static/src/css/portal_menu.css"/>\n      \t<t t-call="portal.portal_layout">\n            <t t-set="no_breadcrumbs" t-value="True"/>\n\t\t\t<t t-call="ehealth.portal_sidebar_menu"/>\n\t\t\t<nav aria-label="breadcrumb">\n                <ol class="breadcrumb">\n                    <li class="breadcrumb-item active" aria-current="page"> Menu </li>\n                </ol>\n            </nav>\n\t\t\t<div class="ehealth-menu d-flex">\n\t\t\t\t<div class="left-menu d-flex flex-column fullfill-parent-width">\n\t\t\t\t\t<div class="d-flex fullfill-parent-width mt-24 gap-21">\n\t\t\t\t\t\t<div class="frame w-60-percent">\n\t\t\t\t\t\t\t<span class="card-title">Unpaid Bill</span>\n\t\t\t\t\t\t\t<div class="total-unpaid-container d-flex justify-content-between align-items-center">\n\t\t\t\t\t\t\t\t<h2 class="total-unpaid"><t t-esc="total_unpaid"/></h2>\n\t\t\t\t\t\t\t\t<a class="pay-now-btn btn btn-ehealth-primary" href="#"> Pay Now </a>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t<a class="underline" href="/my/customer/billing"> See Invoices </a>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t<div class="frame w-40-percent">\n\t\t\t\t\t\t\t<span class="card-title">Jumlah Transaksi Bulan Ini</span>\n\t\t\t\t\t\t\t<t t-if="transaction_usage['is_team_plan']">\n\t\t\t\t\t\t\t\t<div class="quota-usage">\n\t\t\t\t\t\t\t\t\t<div class="counter">\n\t\t\t\t\t\t\t\t\t\t<span t-att-class="'usage ' + transaction_usage['status']"><t t-esc="transaction_usage['usage']"/></span><span class="limit">/<t t-esc="transaction_usage['limit']"/></span><span> digunakan</span>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t<div class="quota-progress-bar">\n\t\t\t\t\t\t\t\t\t\t<div t-att-class="'progress-fill ' + transaction_usage['status']" t-attf-style="width: #{transaction_usage['progress_bar']}%"/>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<div t-att-class="'footer-frame ' + transaction_usage['status']">\n\t\t\t\t\t\t\t\t\t<p>\n\t\t\t\t\t\t\t\t\t\t<span>\n\t\t\t\t\t\t\t\t\t\t\t<t t-if="transaction_usage['status'] == 'over'"><t t-esc="transaction_usage['extend_quota']"/></t>\n\t\t\t\t\t\t\t\t\t\t\t<t t-else=""><t t-esc="transaction_usage['remaining']"/></t>\n\t\t\t\t\t\t\t\t\t\t</span>\n\t\t\t\t\t\t\t\t\t\t<t t-if="transaction_usage['status'] == 'over'">transaksi tambahan digunakan</t>\n\t\t\t\t\t\t\t\t\t\t<t t-else="">kuota transaksi tersisa</t>\n\t\t\t\t\t\t\t\t\t</p>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t</t>\n\t\t\t\t\t\t\t<t t-else="">\n\t\t\t\t\t\t\t\t<div class="individual-plan">\n\t\t\t\t\t\t\t\t\t<p class="usage"><t t-esc="transaction_usage['usage']"/></p>\n\t\t\t\t\t\t\t\t\t<p class="footer"><span><t t-esc="transaction_usage['last_month_usage']"/> transaksi</span> tercatat bulan lalu</p>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t</t>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class="frame mt-24">\n\t\t\t\t\t\t<div class="d-flex justify-content-between align-items-center">\n\t\t\t\t\t\t\t<span class="card-title">Payment Methods</span>\n\t\t\t\t\t\t\t<a class="underline" href="/my/customer/payment_method"> See Others </a>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t<div class="d-flex align-items-center mt-24" t-if="primary_payment">\n\t\t\t\t\t\t\t<div t-attf-class="payment-icon {{primary_payment.card_brand}}"/>\n\t\t\t\t\t\t\t<span class="payment-brand"><t t-esc="primary_payment.card_brand"/> • <t t-esc="primary_payment.card_number.replace('XXXX', '')"/> </span>\n\t\t\t\t\t\t\t<span class="status-field grey-status">Primary</span>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t<div class="mt-3" t-if="not primary_payment">\n\t\t\t\t\t\t\tNo payment methods have been added yet.\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class="d-flex fullfill-parent-width mt-24">\n\t\t\t\t\t\t<div class="frame fullfill-parent-width">\n\t\t\t\t\t\t\t<div class="d-flex justify-content-between align-items-center">\n\t\t\t\t\t\t\t\t<span class="card-title">My Subscription</span>\n\t\t\t\t\t\t\t\t<a class="underline" href="/my/customer/subscription"> See Details </a>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t<table class="full-width">\n\t\t\t\t\t\t\t\t\t<t t-foreach="subscriptions" t-as="subscription">\n\t\t\t\t\t\t\t\t\t\t<tbody class="no-border">\n\t\t\t\t\t\t\t\t\t\t\t<tr class="table-body">\n\t\t\t\t\t\t\t\t\t\t\t\t<td><span t-field="subscription.subscription_product_id.name"/></td>\n\t\t\t\t\t\t\t\t\t\t\t</tr>\n\t\t\t\t\t\t\t\t\t\t</tbody>\n\t\t\t\t\t\t\t\t\t</t>\n\t\t\t\t\t\t\t</table>\n\t\t\t\t\t\t\t<div class="mt-3" t-if="not subscriptions">\n\t\t\t\t\t\t\t\tNo subscriptions have been added yet.\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t<div style="width: 48px"/>\n\t\t\t\t\t\t<div class="frame fullfill-parent-width" style="margin-bottom: 50px;">\n\t\t\t\t\t\t\t<div class="d-flex justify-content-between align-items-center">\n\t\t\t\t\t\t\t\t<span class="card-title">Practitioners</span>\n\t\t\t\t\t\t\t\t<a class="underline" href="/my/customer/practitioner"> See Details </a>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t<table class="full-width">\n\t\t\t\t\t\t\t\t\t<t t-foreach="role_count" t-as="v">\n\t\t\t\t\t\t\t\t\t\t<tbody class="no-border">\n\t\t\t\t\t\t\t\t\t\t\t<tr class="table-body">\n\t\t\t\t\t\t\t\t\t\t\t\t<td><span class="mr-12" t-esc="v"/><span t-esc="v_value" class="status-field grey-status"/></td>\n\t\t\t\t\t\t\t\t\t\t\t</tr>\n\t\t\t\t\t\t\t\t\t\t</tbody>\n\t\t\t\t\t\t\t\t\t</t>\n\t\t\t\t\t\t\t</table>\n\t\t\t\t\t\t\t<div class="mt-3" t-if="not role_count">\n\t\t\t\t\t\t\t\tNo practitioners have been added yet.\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t<div style="min-width: 57px;"/>\n\t\t\t\t<div class="right-menu d-flex flex-column">\n\t\t\t\t\t<div class="frame">\n\t\t\t\t\t\t<div class="d-flex justify-content-between align-items-center">\n\t\t\t\t\t\t\t<h5 class="card-title">Details</h5>\n\t\t\t\t\t\t\t<a class="underline" href="/my/customer/account/form/edit"> <i class="fa fa-pencil"/> Edit Profile </a>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t<div class="profile-container">\n\t\t\t\t\t\t\t<div class="d-flex align-items-center mt-12">\n\t\t\t\t\t\t\t\t<i class="profile-icon bx bx-user-circle"/>\n\t\t\t\t\t\t\t\t<div style="font-weight: bold" t-field="user_id.authorized_organization_id.name"/>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t<div class="d-flex align-items-start mt-12">\n\t\t\t\t\t\t\t\t<i class="profile-icon bx bx-map" style="margin-top: 4px;"/>\n\t\t\t\t\t\t\t\t<div class="d-flex flex-column">\n\t\t\t\t\t\t\t\t\t<div t-field="user_id.authorized_organization_id.street"/>\n\t\t\t\t\t\t\t\t\t<div t-if="user_id.authorized_organization_id.street2 != 'false'" t-field="user_id.authorized_organization_id.street2"/>\n\t\t\t\t\t\t\t\t\t<div t-if="user_id.authorized_organization_id.city != 'false'" t-field="user_id.authorized_organization_id.city"/>\n\t\t\t\t\t\t\t\t\t<div t-if="user_id.authorized_organization_id.state_id != 'false'" t-field="user_id.authorized_organization_id.state_id"/>\n\t\t\t\t\t\t\t\t\t<div t-if="user_id.authorized_organization_id.country_id != 'false'" t-field="user_id.authorized_organization_id.country_id"/>\n\t\t\t\t\t\t\t\t\t<div t-if="user_id.authorized_organization_id.zip != 'false'" t-field="user_id.authorized_organization_id.zip"/>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t<div class="d-flex align-items-center mt-12">\n\t\t\t\t\t\t\t\t<i class="profile-icon bx bx-phone"/>\n\t\t\t\t\t\t\t\t<div t-field="user_id.authorized_organization_id.phone"/>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t<div class="d-flex align-items-center mt-12">\n\t\t\t\t\t\t\t\t<i class="profile-icon bx bx-mail-send"/>\n\t\t\t\t\t\t\t\t<div t-field="user_id.authorized_organization_id.email"/>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class="frame mt-12">\n\t\t\t\t\t\t<h5 class="card-title">Account Security</h5>\n\t\t\t\t\t\t<a class="underline" href="https://accounts.ehealth.co.id/realms/ehealth/account/#/security/signingin" target="_blank"> <i class="fa fa-pencil"/> Edit Security Settings </a>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t\t\n\t\t</t>\n    </t>\n\n\t	ehealth/views/portal_menu.xml	f	<?xml version="1.0"?>\n<t name="Portal customer" priority="30" t-name="ehealth.portal_my_customer">\n\t\t<link rel="stylesheet" href="/ehealth/static/src/css/portal_menu.css"/>\n      \t<t t-call="portal.portal_layout">\n            <t t-set="no_breadcrumbs" t-value="True"/>\n\t\t\t<t t-call="ehealth.portal_sidebar_menu"/>\n\t\t\t<nav aria-label="breadcrumb">\n                <ol class="breadcrumb">\n                    <li class="breadcrumb-item active" aria-current="page"> Menu </li>\n                </ol>\n            </nav>\n\t\t\t<div class="ehealth-menu d-flex">\n\t\t\t\t<div class="left-menu d-flex flex-column fullfill-parent-width">\n\t\t\t\t\t<div class="d-flex fullfill-parent-width mt-24 gap-21">\n\t\t\t\t\t\t<div class="frame w-60-percent">\n\t\t\t\t\t\t\t<span class="card-title">Unpaid Bill</span>\n\t\t\t\t\t\t\t<div class="total-unpaid-container d-flex justify-content-between align-items-center">\n\t\t\t\t\t\t\t\t<h2 class="total-unpaid"><t t-esc="total_unpaid"/></h2>\n\t\t\t\t\t\t\t\t<a class="pay-now-btn btn btn-ehealth-primary" href="#"> Pay Now </a>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t<a class="underline" href="/my/customer/billing"> See Invoices </a>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t<div class="frame w-40-percent">\n\t\t\t\t\t\t\t<span class="card-title">Jumlah Transaksi Bulan Ini</span>\n\t\t\t\t\t\t\t<t t-if="transaction_usage['is_team_plan']">\n\t\t\t\t\t\t\t\t<div class="quota-usage">\n\t\t\t\t\t\t\t\t\t<div class="counter">\n\t\t\t\t\t\t\t\t\t\t<span t-att-class="'usage ' + transaction_usage['status']"><t t-esc="transaction_usage['usage']"/></span><span class="limit">/<t t-esc="transaction_usage['limit']"/></span><span> digunakan</span>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t<div class="quota-progress-bar">\n\t\t\t\t\t\t\t\t\t\t<div t-att-class="'progress-fill ' + transaction_usage['status']" t-attf-style="width: #{transaction_usage['progress_bar']}%"/>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<div t-att-class="'footer-frame ' + transaction_usage['status']">\n\t\t\t\t\t\t\t\t\t<p>\n\t\t\t\t\t\t\t\t\t\t<span>\n\t\t\t\t\t\t\t\t\t\t\t<t t-if="transaction_usage['status'] == 'over'"><t t-esc="transaction_usage['extend_quota']"/></t>\n\t\t\t\t\t\t\t\t\t\t\t<t t-else=""><t t-esc="transaction_usage['remaining']"/></t>\n\t\t\t\t\t\t\t\t\t\t</span>\n\t\t\t\t\t\t\t\t\t\t<t t-if="transaction_usage['status'] == 'over'">transaksi tambahan digunakan</t>\n\t\t\t\t\t\t\t\t\t\t<t t-else="">kuota transaksi tersisa</t>\n\t\t\t\t\t\t\t\t\t</p>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t</t>\n\t\t\t\t\t\t\t<t t-else="">\n\t\t\t\t\t\t\t\t<div class="individual-plan">\n\t\t\t\t\t\t\t\t\t<p class="usage"><t t-esc="transaction_usage['usage']"/></p>\n\t\t\t\t\t\t\t\t\t<p class="footer"><span><t t-esc="transaction_usage['last_month_usage']"/> transaksi</span> tercatat bulan lalu</p>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t</t>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class="frame mt-24">\n\t\t\t\t\t\t<div class="d-flex justify-content-between align-items-center">\n\t\t\t\t\t\t\t<span class="card-title">Payment Methods</span>\n\t\t\t\t\t\t\t<a class="underline" href="/my/customer/payment_method"> See Others </a>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t<div class="d-flex align-items-center mt-24" t-if="primary_payment">\n\t\t\t\t\t\t\t<div t-attf-class="payment-icon {{primary_payment.card_brand}}"/>\n\t\t\t\t\t\t\t<span class="payment-brand"><t t-esc="primary_payment.card_brand"/> • <t t-esc="primary_payment.card_number.replace('XXXX', '')"/> </span>\n\t\t\t\t\t\t\t<span class="status-field grey-status">Primary</span>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t<div class="mt-3" t-if="not primary_payment">\n\t\t\t\t\t\t\tNo payment methods have been added yet.\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class="d-flex fullfill-parent-width mt-24">\n\t\t\t\t\t\t<div class="frame fullfill-parent-width">\n\t\t\t\t\t\t\t<div class="d-flex justify-content-between align-items-center">\n\t\t\t\t\t\t\t\t<span class="card-title">My Subscription</span>\n\t\t\t\t\t\t\t\t<a class="underline" href="/my/customer/subscription"> See Details </a>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t<table class="full-width">\n\t\t\t\t\t\t\t\t\t<t t-foreach="subscriptions" t-as="subscription">\n\t\t\t\t\t\t\t\t\t\t<tbody class="no-border">\n\t\t\t\t\t\t\t\t\t\t\t<tr class="table-body">\n\t\t\t\t\t\t\t\t\t\t\t\t<td><span t-field="subscription.subscription_product_id.name"/></td>\n\t\t\t\t\t\t\t\t\t\t\t</tr>\n\t\t\t\t\t\t\t\t\t\t</tbody>\n\t\t\t\t\t\t\t\t\t</t>\n\t\t\t\t\t\t\t</table>\n\t\t\t\t\t\t\t<div class="mt-3" t-if="not subscriptions">\n\t\t\t\t\t\t\t\tNo subscriptions have been added yet.\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t<div style="width: 48px"/>\n\t\t\t\t\t\t<div class="frame fullfill-parent-width" style="margin-bottom: 50px;">\n\t\t\t\t\t\t\t<div class="d-flex justify-content-between align-items-center">\n\t\t\t\t\t\t\t\t<span class="card-title">Practitioners</span>\n\t\t\t\t\t\t\t\t<a class="underline" href="/my/customer/practitioner"> See Details </a>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t<table class="full-width">\n\t\t\t\t\t\t\t\t\t<t t-foreach="role_count" t-as="v">\n\t\t\t\t\t\t\t\t\t\t<tbody class="no-border">\n\t\t\t\t\t\t\t\t\t\t\t<tr class="table-body">\n\t\t\t\t\t\t\t\t\t\t\t\t<td><span class="mr-12" t-esc="v"/><span t-esc="v_value" class="status-field grey-status"/></td>\n\t\t\t\t\t\t\t\t\t\t\t</tr>\n\t\t\t\t\t\t\t\t\t\t</tbody>\n\t\t\t\t\t\t\t\t\t</t>\n\t\t\t\t\t\t\t</table>\n\t\t\t\t\t\t\t<div class="mt-3" t-if="not role_count">\n\t\t\t\t\t\t\t\tNo practitioners have been added yet.\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\
522	Main Frontend Layout	\N	portal.frontend_layout	16	qweb	<?xml version="1.0"?>\n<data name="Main Frontend Layout" inherit_id="web.frontend_layout">\n        <xpath expr="//div[@id='wrapwrap']" position="attributes">\n            <attribute name="t-attf-class" add="#{request.env['res.lang']._lang_get(request.env.lang).direction == 'rtl' and 'o_rtl' or ''}" separator=" "/>\n            <attribute name="t-attf-class" add="#{'o_portal' if is_portal else ''}" separator=" "/>\n        </xpath>\n        <xpath expr="//div[@id='wrapwrap']/header/img" position="replace">\n            <nav class="navbar navbar-expand navbar-light bg-light">\n                <div class="container">\n                    <a href="/" class="navbar-brand logo">\n                        <img t-att-src="'/logo.png?company=%s' % res_company.id" t-att-alt="'Logo of %s' % res_company.name" t-att-title="res_company.name"/>\n                    </a>\n                    <ul id="top_menu" class="nav navbar-nav ml-auto">\n                        <t t-call="portal.placeholder_user_sign_in">\n                            <t t-set="_item_class" t-value="'nav-item'"/>\n                            <t t-set="_link_class" t-value="'nav-link'"/>\n                        </t>\n                        <t t-call="portal.user_dropdown">\n                            <t t-set="_user_name" t-value="true"/>\n                            <t t-set="_item_class" t-value="'nav-item dropdown'"/>\n                            <t t-set="_link_class" t-value="'nav-link'"/>\n                            <t t-set="_dropdown_menu_class" t-value="'dropdown-menu-right'"/>\n                        </t>\n                    </ul>\n                </div>\n            </nav>\n        </xpath>\n        <xpath expr="//div[@id='wrapwrap']/main/t[@t-raw='0']" position="before">\n            <div t-if="o_portal_fullwidth_alert" class="alert alert-info alert-dismissible rounded-0 fade show d-print-none css_editable_mode_hidden">\n                <div class="container">\n                    <t t-raw="o_portal_fullwidth_alert"/>\n                </div>\n            </div>\n        </xpath>\n    </data>\n\n    	portal/views/portal_templates.xml	\N	\N	193	\N	extension	t	1	2025-06-10 03:55:40.841132	1	2025-06-10 03:55:40.841132	f
728	Portal layout : invoice menu entries	\N	account.portal_my_home_menu_invoice	30	qweb	<?xml version="1.0"?>\n<data name="Portal layout : invoice menu entries" inherit_id="portal.portal_breadcrumbs" priority="30">\n        <xpath expr="//ol[hasclass('o_portal_submenu')]" position="inside">\n            <li t-if="page_name == 'invoice'" t-attf-class="breadcrumb-item #{'active ' if not invoice else ''}">\n                <a t-if="invoice" t-attf-href="/my/invoices?{{ keep_query() }}">Invoices &amp; Bills</a>\n                <t t-else="">Invoices &amp; Bills</t>\n            </li>\n            <li t-if="invoice" class="breadcrumb-item active">\n                <t t-esc="invoice.name" t-if="invoice.name != '/'"/>\n                <t t-else=""><em>Draft Invoice</em></t>\n            </li>\n        </xpath>\n    </data>\n\n    	account/views/account_portal_templates.xml	\N	\N	526	\N	extension	t	1	2025-06-10 03:55:46.489222	1	2025-06-10 03:55:46.489222	f

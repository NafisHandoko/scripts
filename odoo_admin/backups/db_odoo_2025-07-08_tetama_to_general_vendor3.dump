646	account.journal.form	account.journal	\N	1	form	<?xml version="1.0"?>\n<form string="Account Journal">\n                    <sheet>\n                        <widget name="web_ribbon" title="Archived" bg_color="bg-danger" attrs="{'invisible': [('active', '=', True)]}"/>\n                        <div class="oe_title">\n                            <label for="name" class="oe_edit_only"/>\n                            <h1><field name="name" class="oe_inline"/></h1>\n                        </div>\n                        <group>\n                            <group>\n                                <field name="active" invisible="1"/>\n                                <field name="type"/>\n                            </group>\n                            <group>\n                                <field name="company_id" options="{'no_create': True}" groups="base.group_multi_company"/>\n                                <field name="country_code" invisible="1"/>\n                            </group>\n                        </group>\n                        <notebook>\n                            <page name="bank_account" string="Journal Entries">\n                                <group>\n                                    <group string="Accounting information">\n                                        <field name="default_account_type" invisible="1"/>\n                                        <!-- Bank -->\n                                        <field name="default_account_id" string="Bank Account" attrs="{'required': [('id', '!=', False), ('type', '=', 'bank')], 'invisible': [('type', '!=', 'bank')]}" groups="account.group_account_readonly"/>\n                                        <!-- Cash -->\n                                        <field name="default_account_id" string="Cash Account" attrs="{'required': [('id', '!=', False), ('type', '=', 'cash')], 'invisible': [('type', '!=', 'cash')]}" groups="account.group_account_readonly"/>\n\n                                        <field name="suspense_account_id" attrs="{'required': [('type', 'in', ('bank', 'cash'))], 'invisible': [('type', 'not in', ('bank', 'cash'))]}" groups="account.group_account_readonly"/>\n                                        <field name="profit_account_id" attrs="{'invisible': [('type', '!=', 'cash')]}"/>\n                                        <field name="loss_account_id" attrs="{'invisible': [('type', '!=', 'cash')]}"/>\n                                        <!-- Sales -->\n                                        <field name="default_account_id" string="Default Income Account" attrs="{'required': [('type', '=', 'sale')], 'invisible': [('type', '!=', 'sale')]}" groups="account.group_account_readonly"/>\n                                        <!-- Purchase -->\n                                        <field name="default_account_id" string="Default Expense Account" attrs="{'required': [('type', '=', 'purchase')], 'invisible': [('type', '!=', 'purchase')]}" groups="account.group_account_readonly"/>\n                                        <field name="refund_sequence" attrs="{'invisible': [('type', 'not in', ['sale', 'purchase'])]}"/>\n                                        <field name="code"/>\n                                        <field name="currency_id" options="{'no_create': True}" groups="base.group_multi_currency"/>\n                                    </group>\n                                    <group string="Bank Account Number" attrs="{'invisible': [('type', '!=', 'bank')]}">\n                                        <field name="company_partner_id" invisible="1"/>\n                                        <field name="bank_account_id" string="Account Number" context="{'default_partner_id': company_partner_id, 'form_view_ref': 'account.view_company_partner_bank_form'}"/>\n                                        <field name="bank_id" attrs="{'invisible': [('bank_account_id', '=', False)]}"/>\n                                        <field name="bank_statements_source" widget="radio" attrs="{'required': [('type', '=', 'bank')]}" groups="account.group_account_readonly"/>\n                                    </group>\n                                </group>\n                            </page>\n                            <page name="journal_entries" string="Payments Configuration" attrs="{'invisible': [('type', 'in', ['sale', 'purchase', 'general'])]}">\n                                <group>\n                                    <group string="Incoming Payments">\n                                        <field name="payment_debit_account_id" attrs="{'required': [('id', '!=', False), ('type', 'in', ('bank', 'cash'))], 'invisible': [('type', 'not in', ('bank', 'cash'))]}" groups="account.group_account_readonly"/>\n                                        <field name="inbound_payment_method_ids" string="Methods" widget="many2many_checkboxes" attrs="{'invisible': [('type', 'not in', ['bank', 'cash'])]}"/>\n                                    </group>\n                                    <group string="Outgoing Payments">\n                                        <field name="id" invisible="1"/>\n                                        <field name="payment_credit_account_id" attrs="{'required': [('id', '!=', False), ('type', 'in', ('bank', 'cash'))], 'invisible': [('type', 'not in', ('bank', 'cash'))]}" groups="account.group_account_readonly"/>\n                                        <field name="outbound_payment_method_ids" string="Methods" widget="many2many_checkboxes" attrs="{'invisible': [('type', 'not in', ['bank', 'cash'])]}"/>\n                                    </group>\n                                    <group name="outgoing_payment"/>\n                                </group>\n                            </page>\n                            <page name="advanced_settings" string="Advanced Settings">\n                                <group>\n                                    <group string="Control-Access" groups="account.group_account_manager">\n                                        <div class="text-muted" colspan="2">Keep empty for no control</div>\n                                        <field name="type_control_ids" widget="many2many_tags"/>\n                                        <field name="account_control_ids" widget="many2many_tags"/>\n                                        <field name="restrict_mode_hash_table" groups="account.group_account_readonly" attrs="{'invisible': [('type', 'in', ['bank', 'cash'])]}"/>\n                                    </group>\n                                    <!-- email alias -->\n                                    <group class="oe_read_only" name="group_alias_ro" string="Create Invoices upon Emails" attrs="{'invisible': ['|', ('type', 'not in',  ('sale' ,'purchase')), ('alias_domain', '=', False)]}">\n                                       <field name="alias_id"/>\n                                    </group>\n                                    <group name="group_alias_no_domain" string="Create Invoices upon Emails" attrs="{'invisible': ['|', ('type', 'not in',  ('sale' ,'purchase')), ('alias_domain', '!=', False)]}">\n                                        <div class="content-group">\n                                            <a type="action" name="190" class="btn btn-link" role="button"><i class="fa fa-fw o_button_icon fa-arrow-right"/> Configure Email Servers</a>\n                                        </div>\n                                    </group>\n                                    <group class="oe_edit_only" name="group_alias_edit" string="Create Invoices upon Emails" attrs="{'invisible': ['|', ('type', 'not in',  ('sale' ,'purchase')), ('alias_domain', '=', False)]}">\n                                        <label string="Email Alias" for="alias_name"/>\n                                        <div class="oe_inline" name="edit_alias" style="display: inline;">\n                                            <field name="alias_name" class="oe_inline"/>@<field name="alias_domain" class="oe_inline" readonly="1"/>\n                                        </div>\n                                    </group>\n                                    <!-- email alias end -->\n                                    <group string="Payment Communications" attrs="{'invisible': [('type', '!=', 'sale')]}">\n                                        <field name="invoice_reference_type"/>\n                                        <field name="invoice_reference_model" attrs="{'invisible': [('invoice_reference_type', '=', 'none')]}"/>\n                                    </group>\n                                    <group string="Follow Customer Payments" attrs="{'invisible': [('type', '!=', 'sale')]}">\n                                        <field name="sale_activity_type_id"/>\n                                        <field name="sale_activity_user_id" attrs="{'invisible': [('sale_activity_type_id', '=', False)]}"/>\n                                        <field name="sale_activity_note" placeholder="e.g. Give a phone call, check with others , ..." attrs="{'invisible': [('sale_activity_type_id', '=', False)]}"/>\n                                    </group>\n                                </group>\n                            </page>\n                        </notebook>\n                    </sheet>\n                <div class="oe_chatter">\n                    <field name="message_follower_ids"/>\n                    <field name="activity_ids"/>\n                    <field name="message_ids"/>\n                </div>\n                </form>\n            	account/views/account_journal_views.xml	\N	\N	\N	\N	primary	t	1	2025-06-10 03:55:46.489222	1	2025-06-10 03:55:46.489222	f

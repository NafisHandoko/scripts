565	report_assets_snailmail	\N	snailmail.report_assets_snailmail	16	qweb	<?xml version="1.0"?>\n<t t-name="snailmail.report_assets_snailmail">\n        <t t-call="web._assets_helpers"/>\n        <link rel="stylesheet" type="text/scss" href="/snailmail/static/src/scss/snailmail_external_layout_asset.scss"/>\n        <script type="text/javascript" src="/snailmail/static/src/js/snailmail_external_layout.js"/>\n    </t>\n    	snailmail/views/report_assets.xml	\N	\N	\N	\N	primary	t	1	2025-06-10 03:55:43.55241	1	2025-06-10 03:55:43.55241	f
566	report_layout	\N	snailmail.report_layout	16	qweb	<?xml version="1.0"?>\n<data inherit_id="web.report_layout">\n        <xpath expr="//head" position="inside">\n            <t t-if="env and env.context.get('snailmail_layout')" t-call-assets="snailmail.report_assets_snailmail"/>\n        </xpath>\n    </data>\n    	snailmail/views/report_assets.xml	\N	\N	210	\N	extension	t	1	2025-06-10 03:55:43.55241	1	2025-06-10 03:55:43.55241	f
596	account.payment.form	account.payment	\N	16	form	<?xml version="1.0"?>\n<form string="Register Payment">\n                    <header>\n                        <button name="action_post" string="Confirm" type="object" class="oe_highlight" attrs="{'invisible': [('state', '!=', 'draft')]}"/>\n                        <button name="action_draft" string="Reset To Draft" type="object" class="btn btn-secondary" attrs="{'invisible': [('state', 'not in', ('posted', 'cancel'))]}" groups="account.group_account_invoice"/>\n                        <button name="action_cancel" string="Cancel" type="object" attrs="{'invisible': [('state', '!=', 'draft')]}"/>\n                        <button name="mark_as_sent" string="Mark as Sent" type="object" attrs="{'invisible': ['|', '|', ('state', '!=', 'posted'), ('is_move_sent', '=', True), ('payment_method_code', '!=', 'manual')]}"/>\n                        <button name="unmark_as_sent" string="Unmark as Sent" type="object" attrs="{'invisible': ['|', '|', ('state', '!=', 'posted'), ('is_move_sent', '=', False), ('payment_method_code', '!=', 'manual')]}"/>\n                        <field name="state" widget="statusbar" statusbar_visible="draft,posted"/>\n                    </header>\n\n                    <sheet>\n                        <!-- Invisible fields -->\n                        <field name="id" invisible="1"/>\n                        <field name="is_move_sent" invisible="1"/>\n                        <field name="is_reconciled" invisible="1"/>\n                        <field name="payment_method_code" invisible="1"/>\n                        <field name="show_partner_bank_account" invisible="1"/>\n                        <field name="require_partner_bank_account" invisible="1"/>\n                        <field name="hide_payment_method" invisible="1"/>\n                        <field name="available_payment_method_ids" invisible="1"/>\n                        <field name="suitable_journal_ids" invisible="1"/>\n                        <field name="country_code" invisible="1"/>\n\n                        <div class="oe_button_box" name="button_box">\n                            <!-- Invoice stat button -->\n                            <button name="button_open_invoices" type="object" class="oe_stat_button" icon="fa-bars" attrs="{'invisible': [('reconciled_invoices_count','=', 0)]}">\n                                <field name="reconciled_invoices_count"/>\n                                <span attrs="{'invisible': [('reconciled_invoices_count','&gt;', 1)]}">Invoice</span>\n                                <span attrs="{'invisible': [('reconciled_invoices_count','&lt;=', 1)]}">Invoices</span>\n                            </button>\n\n                            <!-- Bill stat button -->\n                            <button name="button_open_bills" type="object" class="oe_stat_button" icon="fa-bars" attrs="{'invisible': [('reconciled_bills_count','=', 0)]}">\n                                <field name="reconciled_bills_count"/>\n                                <span attrs="{'invisible': [('reconciled_bills_count','&gt;', 1)]}">Bill</span>\n                                <span attrs="{'invisible': [('reconciled_bills_count','&lt;=', 1)]}">Bills</span>\n                            </button>\n\n                            <!-- Statement stat button -->\n                            <button name="button_open_statements" type="object" class="oe_stat_button" icon="fa-bars" attrs="{'invisible': [('reconciled_statements_count','=', 0)]}">\n                                <field name="reconciled_statements_count"/>\n                                <span attrs="{'invisible': [('reconciled_statements_count','&gt;', 1)]}">Statement</span>\n                                <span attrs="{'invisible': [('reconciled_statements_count','&lt;=', 1)]}">Statements</span>\n                            </button>\n                        </div>\n\n                        <widget name="web_ribbon" text="Invoicing App Legacy" bg_color="bg-info" attrs="{'invisible': [('state', '!=', 'invoicing_legacy')]}" tooltip="This payment has been generated through the Invoicing app, before installing Accounting. It has been disabled by the 'Invoicing Switch Threshold Date' setting so that it does not impact your accounting."/>\n\n                        <div class="oe_title" attrs="{'invisible': [('state', '=', 'draft')]}">\n                            <h1><field name="name" attrs="{'readonly': [('state', '!=', 'draft')]}"/></h1>\n                        </div>\n\n                        <group>\n                            <group name="group1">\n                                <field name="payment_type" widget="radio" attrs="{'readonly': [('state', '!=', 'draft')]}"/>\n                                <field name="partner_type" widget="selection" attrs="{'readonly': [('state', '!=', 'draft')], 'invisible': [('is_internal_transfer', '=', True)]}"/>\n                                <field name="partner_id" context="{'default_is_company': True}" attrs="{'readonly': ['|', ('state', '!=', 'draft'), ('is_internal_transfer', '=', True)]}"/>\n                                <field name="destination_account_id" options="{'no_create': True}" required="1" attrs="{'readonly': ['|', ('state', '!=', 'draft'), ('is_internal_transfer', '=', True)]}"/>\n                                <field name="is_internal_transfer" attrs="{'readonly': [('state', '!=', 'draft')]}"/>\n                                <field name="company_id" groups="base.group_multi_company"/>\n                            </group>\n                            <group name="group2">\n                                <field name="journal_id" widget="selection" domain="[('type', 'in', ('bank', 'cash'))]" attrs="{'readonly': [('state', '!=', 'draft')]}"/>\n                                <field name="payment_method_id" widget="radio" required="1" attrs="{'readonly': [('state', '!=', 'draft')], 'invisible': [('hide_payment_method', '=', True)]}"/>\n                                <field name="partner_bank_id" context="{'default_partner_id': partner_id}" attrs="{'invisible': [('show_partner_bank_account', '=', False)], 'required': [('require_partner_bank_account', '=', True)], 'readonly': [('state', '!=', 'draft')]}"/>\n\n                                <!-- /!\\ Required due to the _inherits but must not be required when saving a new\n                                record. Using 'required': [('id', '!=', False)] is not working due to the groups set on\n                                the field.\n                                -->\n                                <field name="move_id" required="0" attrs="{'invisible': [('id', '=', False)]}" groups="account.group_account_readonly"/>\n                            </group>\n                            <group name="group3">\n                                <label for="amount"/>\n                                <div name="amount_div" class="o_row">\n                                    <field name="amount" attrs="{'readonly': [('state', '!=', 'draft')]}"/>\n                                    <field name="currency_id" options="{'no_create': True, 'no_open': True}" required="1" attrs="{'readonly': [('state', '!=', 'draft')]}" groups="base.group_multi_currency"/>\n                                </div>\n                                <field name="date" attrs="{'readonly': [('state', '!=', 'draft')]}"/>\n                                <field name="ref" string="Memo"/>\n                            </group>\n\n                            <group>\n                                <field name="qr_code" invisible="1"/>\n                                <div attrs="{'invisible': [('qr_code', '=', False)]}" colspan="2" class="text-center">\n                                    <field name="qr_code" widget="html"/>\n                                </div>\n                            </group>\n                        </group>\n                    </sheet>\n                
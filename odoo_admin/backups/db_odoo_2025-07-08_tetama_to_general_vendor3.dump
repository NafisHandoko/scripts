373	mail_bounce_catchall	\N	mail.mail_bounce_catchall	16	qweb	<?xml version="1.0"?>\n<t t-name="mail.mail_bounce_catchall">\n<div>\n    <p>Hello <t t-esc="message['email_from']"/>,</p>\n    <p>The email sent to <t t-esc="message['to']"/> cannot be processed. This address\n    is used to collect replies and should not be used to directly contact <t t-esc="res_company.name"/>.</p>\n    <p>Please contact us instead using <a t-att-href="'mailto:%s' % res_company.email"><t t-esc="res_company.email"/></a></p>\n    <p>Regards,</p>\n    <p>The <t t-esc="res_company.name"/> team.</p>\n</div>\n<blockquote><t t-esc="message['body']"/></blockquote>\n        </t>\n\n        	mail/data/mail_data.xml	\N	\N	\N	\N	primary	t	1	2025-06-10 03:55:24.448855	1	2025-06-10 03:55:24.448855	\N
131	res.partner.bank.form	res.partner.bank	\N	15	form	<?xml version="1.0"?>\n<form string="Bank account">\n                <sheet>\n                    <widget name="web_ribbon" title="Archived" bg_color="bg-danger" attrs="{'invisible': [('active', '=', True)]}"/>\n                    <group>\n                        <group>\n                            <field name="sequence" invisible="1"/>\n                            <field name="acc_number"/>\n                            <field name="acc_type"/>\n                            <field name="company_id" groups="base.group_multi_company" options="{'no_create': True}"/>\n                            <field name="partner_id"/>\n                        </group>\n                        <group>\n                            <field name="bank_id"/>\n                            <field name="currency_id" groups="base.group_multi_currency" options="{'no_create': True}"/>\n                            <field name="acc_holder_name"/>\n                            <field name="active" invisible="1"/>\n                        </group>\n                    </group>\n                </sheet>\n                </form>\n            	base/views/res_bank_views.xml	\N	\N	\N	\N	primary	t	1	2025-06-10 03:51:51.249694	1	2025-06-10 03:51:51.249694	\N

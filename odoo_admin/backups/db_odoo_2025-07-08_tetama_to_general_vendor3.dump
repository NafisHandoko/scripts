1051	portal_summary_subscription	\N	ehealth.portal_summary_subscription	16	qweb	<?xml version="1.0"?>\n<t t-name="ehealth.portal_summary_subscription">\n        <link rel="stylesheet" href="/ehealth/static/src/css/style.css"/>\n        <link rel="stylesheet" href="/ehealth/static/src/css/confirmation_dialog.css"/>\n        <t t-call="portal.portal_layout">\n            <t t-set="no_breadcrumbs" t-value="True"/>\n            <t t-call="ehealth.portal_sidebar_menu"/>\n            <div class="has_confirmation_dialog" style="margin-left: 50px;">\n                <h3 class="page-title" style="width: 80%;">Summary Subscription</h3>\n                <div style="display: flex;">\n                    <div class="basket">\n                        <div class="basket-labels">\n                            <ul class="head-label">\n                                <li class="li item-heading">Product</li>\n                                <li class="li description">Description</li>\n                                <li class="li price">Price</li>\n                                <li class="li unsubscribe">Action</li>\n                            </ul>\n                        </div>\n                        <div class="basket-product">\n                            <t t-foreach="summaries" t-as="subscription">\n                                <ul>\n                                    <li class="li item-heading">\n                                        <div class="product-details" t-esc="subscription.subscription_product_id.name"/>\n                                    </li>\n                                    <li class="li description" t-esc="subscription.subscription_product_id.description"/>\n                                    <li class="li price">Rp. <t t-esc="subscription.subscription_product_id.list_price"/></li>\n                                    <li class="li remove"><a class="remove" id="modal" t-attf-href="/my/customer/subscription/unsubscribe/{{subscription.id}}">Unsubscribe</a></li>\n                                </ul>\n                            </t>\n                        </div>\n                    </div>\n                </div>\n                <div id="boxes">\n                    <div id="dialog" class="window">\n                        <div class="cd-popup-container">\n                            <p>Are you sure you want to cancel this subscription?</p>\n                            <ul class="cd-buttons">\n                                <li><a id="yes_button">Yes</a></li>\n                                <li><a id="no_button">No</a></li>\n                            </ul>\n                            <a href="#0" class="cd-popup-close img-replace" id="close_modal"/>\n                        </div>\n                    </div>\n                    <!-- Do not remove div#mask, because you'll need it to fill the whole screen -->\n                    <div id="mask"/>\n                </div>\n            </div>\n        </t>\n    </t>\n\n    	ehealth/views/portal_summary_subscription.xml	f	<?xml version="1.0"?>\n<t t-name="ehealth.portal_summary_subscription">\n        <link rel="stylesheet" href="/ehealth/static/src/css/style.css"/>\n        <link rel="stylesheet" href="/ehealth/static/src/css/confirmation_dialog.css"/>\n        <t t-call="portal.portal_layout">\n            <t t-set="no_breadcrumbs" t-value="True"/>\n            <t t-call="ehealth.portal_sidebar_menu"/>\n            <div class="has_confirmation_dialog" style="margin-left: 50px;">\n                <h3 class="page-title" style="width: 80%;">Summary Subscription</h3>\n                <div style="display: flex;">\n                    <div class="basket">\n                        <div class="basket-labels">\n                            <ul class="head-label">\n                                <li class="li item-heading">Product</li>\n                                <li class="li description">Description</li>\n                                <li class="li price">Price</li>\n                                <li class="li unsubscribe">Action</li>\n                            </ul>\n                        </div>\n                        <div class="basket-product">\n                            <t t-foreach="summaries" t-as="subscription">\n                                <ul>\n                                    <li class="li item-heading">\n                                        <div class="product-details" t-esc="subscription.subscription_product_id.name"/>\n                                    </li>\n                                    <li class="li description" t-esc="subscription.subscription_product_id.description"/>\n                                    <li class="li price">Rp. <t t-esc="subscription.subscription_product_id.list_price"/></li>\n                                    <li class="li remove"><a class="remove" id="modal" t-attf-href="/my/customer/subscription/unsubscribe/{{subscription.id}}">Unsubscribe</a></li>\n                                </ul>\n                            </t>\n                        </div>\n                    </div>\n                </div>\n                <div id="boxes">\n                    <div id="dialog" class="window">\n                        <div class="cd-popup-container">\n                            <p>Are you sure you want to cancel this subscription?</p>\n                            <ul class="cd-buttons">\n                                <li><a id="yes_button">Yes</a></li>\n                                <li><a id="no_button">No</a></li>\n                            </ul>\n                            <a href="#0" class="cd-popup-close img-replace" id="close_modal"/>\n                        </div>\n                    </div>\n                    <!-- Do not remove div#mask, because you'll need it to fill the whole screen -->\n                    <div id="mask"/>\n                </div>\n            </div>\n        </t>\n    </t>\n\n    	\N	\N	primary	t	1	2025-06-10 03:58:32.888888	1	2025-06-10 04:22:06.139859	f
585	digest.digest.view.form	digest.digest	\N	16	form	<?xml version="1.0"?>\n<form string="KPI Digest">\n                <field name="is_subscribed" invisible="1"/>\n                <header>\n                    <button type="object" name="action_subscribe" string="Subscribe" class="oe_highlight" attrs="{'invisible': ['|',('is_subscribed', '=', True), ('state','=','deactivated')]}"/>\n                    <button type="object" name="action_unsubcribe" string="Unsubscribe me" class="oe_highlight" attrs="{'invisible': ['|',('is_subscribed', '=', False), ('state','=','deactivated')]}"/>\n                    <button type="object" name="action_deactivate" string="Deactivate for everyone" class="oe_highlight" attrs="{'invisible': [('state','=','deactivated')]}" groups="base.group_system"/>\n                    <button type="object" name="action_activate" string="Activate" class="oe_highlight" attrs="{'invisible': [('state','=','activated')]}" groups="base.group_system"/>\n                    <button type="object" name="action_send" string="Send Now" class="oe_highlight" attrs="{'invisible': [('state','=','deactivated')]}" groups="base.group_system"/>\n                    <field name="state" widget="statusbar"/>\n                </header>\n                <sheet>\n                    <div class="oe_title">\n                        <label for="name" class="oe_edit_only"/>\n                        <h1>\n                            <field name="name"/>\n                        </h1>\n                    </div>\n                    <group>\n                        <group>\n                            <field name="periodicity" widget="radio" options="{'horizontal': true}"/>\n                            <field name="next_run_date" groups="base.group_system"/>\n                            <field name="company_id" options="{'no_create': True}" invisible="1"/>\n                        </group>\n                    </group>\n                    <notebook>\n                        <page name="kpis" string="KPIs">\n                            <group name="kpis">\n                                <group name="kpi_general" string="General" groups="base.group_system">\n                                    <field name="kpi_res_users_connected"/>\n                                    <field name="kpi_mail_message_total"/>\n                                </group>\n                                <group name="kpi_sales"/>\n                            </group>\n                        </page>\n                        <page name="recipients" string="Recipients" groups="base.group_system">\n                            <group>\n                                <field name="user_ids" options="{'no_create': True}">\n                                    <tree string="Recipients">\n                                        <field name="name"/>\n                                        <field name="email"/>\n                                    </tree>\n                                </field>\n                            </group>\n                        </page>\n                        <page name="how_to" string="How to customize your digest?" groups="base.group_no_one">\n                            <div class="alert alert-info" role="alert">\n                                In order to build your customized digest, follow these steps:\n                                <ol>\n                                    <li>\n                                        You may want to add new computed fields with Odoo Studio:\n                                        <ul>\n                                            <li>\n                                                you must create 2 fields on the\n                                                <code>digest</code>\n                                                object:\n                                            </li>\n                                            <li>\n                                                first create a boolean field called\n                                                <code>kpi_myfield</code>\n                                                and display it in the KPI's tab;\n                                            </li>\n                                            <li>\n                                                then create a computed field called\n                                                <code>kpi_myfield_value</code>\n                                                that will compute your customized KPI.\n                                            </li>\n                                        </ul>\n                                    </li>\n                                    <li>Select your KPIs in the KPI's tab.</li>\n                                    <li>\n                                        Create or edit the mail template: you may get computed KPI's value using these fields:\n                                        <code>\n                                            <field name="available_fields" class="oe_inline"/>\n                                        </code>\n                                    </li>\n                                </ol>\n                            </div>\n                        </page>\n                    </notebook>\n                </sheet>\n            </form>\n        	digest/views/digest_views.xml	\N	\N	\N	\N	primary	t	1	2025-06-10 03:55:45.182597	1	2025-06-10 03:55:45.182597	f

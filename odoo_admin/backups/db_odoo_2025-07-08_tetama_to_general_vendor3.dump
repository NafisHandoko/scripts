uper_admin_ids" widget="many2many"/>\n              </group>\n            </page>\n            <page name="infrastructure" string="Infrastructure" attrs="{'invisible': [('is_company','=',False)]}">\n              <group>\n                <field name="variable" readonly="1"/>\n              </group>\n              <group>\n                <field name="infrastructure_plan">\n                  <tree create="false" delete="false">\n                    <field name="request_id"/>\n                    <field name="create_uid" string="Author" widget="many2one_avatar_user"/>\n                    <field name="create_date" string="Created On"/>\n                    <field name="note" string="Note"/>\n                    <field name="state" widget="badge" decoration-info="state in ['draft','enqueued_plan','planned','enqueued_describe','described','enqueued_apply']" decoration-success="state == 'applied'" decoration-muted="state == 'cancelled'"/>\n                  </tree>\n                </field>\n              </group>\n            </page>\n            <page name="credentials" string="Credentials" attrs="{'invisible': [('is_company','=',False)]}">\n              <group string="BPJS">\n                <group string="Pcare">\n                  <field name="pcare_username"/>\n                  <field name="pcare_password"/>\n                  <field name="new_pcare_username"/>\n                  <field name="new_pcare_password"/>\n                  <field name="status_pcare"/>\n                </group>\n                <group string="Icare">\n                  <field name="icare_username"/>\n                  <field name="icare_password"/>\n                  <field name="new_icare_username"/>\n                  <field name="new_icare_password"/>\n                  <field name="status_icare"/>\n                </group>\n                <group string="Vclaim">\n                  <field name="vclaim_username"/>\n                  <field name="vclaim_password"/>\n                  <
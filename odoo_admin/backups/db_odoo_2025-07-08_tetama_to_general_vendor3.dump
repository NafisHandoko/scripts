494	report_simple_barcode	\N	product.report_simple_barcode	16	qweb	<?xml version="1.0"?>\n<t t-name="product.report_simple_barcode">\n            <div style="width: 32%; display: inline-table; height: 10rem;">\n                <table class="table table-bordered mb-0" style="border: 2px solid black;">\n                    <tr>\n                        <th class="table-active text-left" style="height: 4rem;">\n                            <strong t-field="product.display_name"/>\n                        </th>\n                    </tr>\n                    <tr>\n                        <td class="text-center align-middle" style="height: 6rem;">\n                            <t t-if="product.barcode">\n                                <img alt="Barcode" t-if="len(product.barcode) == 13" t-att-src="'/report/barcode/?type=%s&amp;value=%s&amp;width=%s&amp;height=%s' % ('EAN13', quote_plus(product.barcode or ''), 600, 150)" style="width:100%;height:4rem;"/>\n                                <img alt="Barcode" t-elif="len(product.barcode) == 8" t-att-src="'/report/barcode/?type=%s&amp;value=%s&amp;width=%s&amp;height=%s' % ('EAN8', quote_plus(product.barcode or ''), 600, 150)" style="width:100%;height:4rem;"/>\n                                <img alt="Barcode" t-else="" t-att-src="'/report/barcode/?type=%s&amp;value=%s&amp;width=%s&amp;height=%s' % ('Code128', quote_plus(product.barcode or ''), 600, 150)" style="width:100%;height:4rem"/>\n                                <span t-field="product.barcode"/>\n                            </t>\n                            <t t-else=""><span class="text-muted">No barcode available</span></t>\n                        </td>\n                    </tr>\n                </table>\n            </div>\n        </t>\n\n        	product/report/product_product_templates.xml	\N	\N	\N	\N	primary	t	1	2025-06-10 03:55:36.149676	1	2025-06-10 03:55:36.149676	\N
146	res.currency.kanban	res.currency	\N	16	kanban	<?xml version="1.0"?>\n<kanban class="o_kanban_mobile">\n                    <field name="name"/>\n                    <field name="symbol"/>\n                    <templates>\n                        <t t-name="kanban-box">\n                            <div t-attf-class="oe_kanban_global_click">\n                                <div class="row mb4">\n                                    <div class="col-6">\n                                        <strong><span><t t-esc="record.name.value"/></span></strong>\n                                    </div>\n                                    <div class="col-6 text-right">\n                                        <span class="badge badge-pill"><t t-esc="record.symbol.value"/></span>\n                                    </div>\n                                </div>\n                                <div class="row">\n                                    <div class="col-12">\n                                        <strong><span>Current Rate: </span></strong>\n                                        <field name="rate" digits="[12,6]"/>\n                                    </div>\n                                </div>\n                            </div>\n                        </t>\n                    </templates>\n                </kanban>\n            	base/views/res_currency_views.xml	\N	\N	\N	\N	primary	t	1	2025-06-10 03:51:51.249694	1	2025-06-10 03:51:51.249694	\N
149	Change Password Users	change.password.user	\N	16	tree	<?xml version="1.0"?>\n<!-- the user list is editable, but one cannot add or delete rows -->\n                <tree string="Users" editable="bottom" create="false" delete="false">\n                    <field name="user_id" invisible="1"/>\n                    <field name="user_login"/>\n                    <field name="new_passwd" required="True" password="True"/>\n                </tree>\n            	base/views/res_users_views.xml	\N	\N	\N	\N	primary	t	1	2025-06-10 03:51:51.249694	1	2025-06-10 03:51:51.249694	\N
983	Sales Order Portal Content	\N	sale.sale_order_portal_content	16	qweb	<?xml version="1.0"?>\n<t name="Sales Order Portal Content" t-name="sale.sale_order_portal_content">\n        <!-- Intro -->\n        <div id="introduction" t-attf-class="pb-2 pt-3 #{'card-header bg-white' if report_type == 'html' else ''}">\n          <h2 class="my-0">\n                <t t-esc="sale_order.type_name"/>\n                <em t-esc="sale_order.name"/>\n            </h2>\n        </div>\n\n        <div t-attf-class="#{'card-body' if report_type == 'html' else ''}">\n            <!-- Informations -->\n            <div id="informations">\n                <div t-if="sale_order.transaction_ids and not invoices and sale_order.state in ('sent', 'sale') and portal_confirmation == 'pay' and not success and not error" t-att-data-order-id="sale_order.id">\n                    <t t-if="sale_order.transaction_ids">\n                        <t t-call="payment.payment_confirmation_status">\n                            <t t-set="payment_tx_id" t-value="sale_order.get_portal_last_transaction()"/>\n                            <t t-set="reference" t-value="sale_order.reference"/>\n                        </t>\n                    </t>\n                </div>\n                <div class="row" id="so_date">\n                    <div class="mb-3 col-6">\n                      <t t-if="sale_order.state == 'draft'">\n                        <strong>Quotation Date:</strong> \n                      </t>\n                      <t t-if="sale_order.state in ['sale', 'done', 'cancel']">\n                        <strong>Order Date:</strong> \n                      </t>\n                      <span t-field="sale_order.date_order" t-options="{&quot;widget&quot;: &quot;date&quot;}"/>\n                    </div>\n                    <div class="mb-3 col-6" t-if="sale_order.validity_date">\n                        <strong>Expiration Date:</strong> <span t-field="sale_order.validity_date" t-options="{&quot;widget&quot;: &quot;date&quot;}"/>\n                    </div>\n                </div>\n                <div class="row">\n                    <div class="col-lg-6">\n                        <strong t-if="sale_order.partner_shipping_id == sale_order.partner_invoice_id" class="d-block mb-1">Invoicing and Shipping Address:</strong>\n                        <strong t-if="sale_order.partner_shipping_id != sale_order.partner_invoice_id" class="d-block mb-1">Invoicing Address:</strong>\n                        <address t-field="sale_order.partner_invoice_id" t-options="{&quot;widget&quot;: &quot;contact&quot;, &quot;fields&quot;: [&quot;address&quot;, &quot;name&quot;], &quot;no_marker&quot;: True}"/>\n                    </div>\n                     <t t-if="sale_order.partner_shipping_id != sale_order.partner_invoice_id">\n                        <div id="shipping_address" class="col-lg-6">\n                            <strong class="d-block mb-1">Shipping Address:</strong>\n                            <address t-field="sale_order.partner_shipping_id" t-options="{&quot;widget&quot;: &quot;contact&quot;, &quot;fields&quot;: [&quot;address&quot;, &quot;name&quot;], &quot;no_marker&quot;: True}"/>\n                        </div>\n                    </t>\n                </div>\n\n                <t t-set="invoices" t-value="[i for i in sale_order.invoice_ids if i.state not in ['draft', 'cancel']]"/>\n                <div t-if="invoices" class="row">\n                    <div class="col">\n                        <strong class="d-block mb-1">Invoices</strong>\n                        <ul class="list-group mb-4">\n                            <t t-foreach="invoices" t-as="i">\n                                <t t-set="report_url" t-value="i.get_portal_url(report_type='pdf', download=True)"/>\n                                <div class="d-flex flex-wrap align-items-center justify-content-between">\n                                    <div>\n                                        <a t-att-href="report_url">\n                                            <span t-esc="i.name"/>\n                                        </a>\n                                        <div class="small d-lg-inline-block">Date: <span class="text-muted" t-field="i.invoice_date"/></div>\n                                    </div>\n                                    <span t-if="i.payment_state in ('paid', 'in_payment')" class="small badge badge-success orders_label_text_align"><i class="fa fa-fw fa-check"/> <b>Paid</b></span>\n                                    <span t-else="" class="small badge badge-info orders_label_text_align"><i class="fa fa-fw fa-clock-o"/> <b>Waiting Payment</b></span>\n                                </div>\n                            </t>\n                        </ul>\n                    </div>\n                </div>\n            </div>\n\n            <section id="details" style="page-break-inside: auto;" class="mt32">\n                <h3 id="details">Pricing</h3>\n\n                <t t-set="display_discount" t-value="True in [line.discount &gt; 0 for line in sale_order.order_line]"/>\n\n                <table t-att-data-order-id="sale_order.id" t-att-data-token="sale_order.access_token" class="table table-sm" id="sales_order_table">\n                    <thead class="bg-100">\n                        <tr>\n                            <th class="text-left">Products</th>\n                            <th class="text-right">Quantity</th>\n                            <th t-attf-class="text-right {{ 'd-none d-sm-table-cell' if report_type == 'html' else '' }}">Unit Price</th>\n                            <th t-if="display_discount" t-attf-class="text-right {{ 'd-none d-sm-table-cell' if report_type == 'html' else '' }}">\n                                <span>Disc.%</span>\n                            </th>\n                            <th t-attf-class="text-right {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}">\n                                <span>Taxes</span>\n                            </th>\n                            <th class="text-right">\n                                <span groups="account.group_show_line_subtotals_tax_excluded">Amount</span>\n                                <span groups="account.group_show_line_subtotals_tax_included">Total Price</span>\n                            </th>\n                        </tr>\n                    </thead>\n                    <tbody class="sale_tbody">\n\n                        <t t-set="current_subtotal" t-value="0"/>\n\n                        <t t-foreach="sale_order.order_line" t-as="line">\n\n                            <t t-set="current_subtotal" t-value="current_subtotal + line.price_subtotal" groups="account.group_show_line_subtotals_tax_excluded"/>\n                            <t t-set="current_subtotal" t-value="current_subtotal + line.price_total" groups="account.group_show_line_subtotals_tax_included"/>\n\n                            <tr t-att-class="'bg-200 font-weight-bold o_line_section' if line.display_type == 'line_section' else 'font-italic o_line_note' if line.display_type == 'line_note' else ''">\n                                <t t-if="not line.display_type">\n                                    <td id="product_name"><span t-field="line.name"/></td>\n                                    <td class="text-right">\n                                        <div id="quote_qty">\n                                            <span t-field="line.product_uom_qty"/>\n                                            <span t-field="line.product_uom"/>\n                                        </div>\n                                    </td>\n                                    <td t-attf-class="text-right {{ 'd-none d-sm-table-cell' if report_type == 'html' else '' }}">\n                                        <div t-if="line.discount &gt;= 0" t-field="line.price_unit" t-att-style="line.discount and 'text-decoration: line-through' or None" t-att-class="(line.discount and 'text-danger' or '') + ' text-right'"/>\n                                        <div t-if="line.discount">\n                                            <t t-esc="(1-line.discount / 100.0) * line.price_unit" t-options="{&quot;widget&quot;: &quot;float&quot;, &quot;decimal_precision&quot;: &quot;Product Price&quot;}"/>\n                                        </div>\n                                    </td>\n                                    <td t-if="display_discount" t-attf-class="text-right {{ 'd-none d-sm-table-cell' if report_type == 'html' else '' }}">\n                                        <strong t-if="line.discount &gt; 0" class="text-info">\n                                            <t t-esc="((line.discount % 1) and '%s' or '%d') % line.discount"/>%\n                                        </strong>\n                                    </td>\n                                    <td t-attf-class="text-right {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}">\n                                        <span t-esc="', '.join(map(lambda x: (x.description or x.name), line.tax_id))"/>\n                                    </td>\n                                    <td class="text-right">\n                                        <span class="oe_order_line_price_subtotal" t-field="line.price_subtotal" groups="account.group_show_line_subtotals_tax_excluded"/>\n                                        <span class="oe_order_line_price_total" t-field="line.price_total" groups="account.group_show_line_subtotals_tax_included"/>\n                                    </td>\n                                </t>\n                                <t t-if="line.display_type == 'line_section'">\n                                    <td colspan="99">\n                                        <span t-field="line.name"/>\n                                    </td>\n                                    <t t-set="current_section" t-value="line"/>\n                                    <t t-set="current_subtotal" t-value="0"/>\n                                </t>\n                                <t t-if="line.display_type == 'line_note'">\n                                    <td colspan="99">\n                                        <span t-field="line.name"/>\n                                    </td>\n                                </t>\n                            </tr>\n\n                            <t t-if="current_section and (line_last or sale_order.order_line[line_index+1].display_type == 'line_section')">\n                                <tr class="is-subtotal text-right">\n                                    <td colspan="99">\n                                        <strong class="mr16">Subtotal</strong>\n                                        <span t-esc="current_subtotal" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: sale_order.pricelist_id.currency_id}"/>\n                                    </td>\n                                </tr>\n                            </t>\n                        </t>\n                    </tbody>\n                </table>\n\n                <div id="total" class="row" name="total" style="page-break-inside: avoid;">\n                    <div t-attf-class="#{'col-4' if report_type != 'html' else 'col-sm-7 col-md-5'} ml-auto">\n                        <t t-call="sale.sale_order_portal_content_totals_table"/>\n                    </div>\n                </div>\n            </section>\n\n            <section t-if="sale_order.signature" id="signature" name="Signature">\n                <div class="row mt-4" name="signature">\n                    <div t-attf-class="#{'col-3' if report_type != 'html' else 'col-sm-7 col-md-4'} ml-auto text-center">\n                        <h5>Signature</h5>\n                        <img t-att-src="image_data_uri(sale_order.signature)" style="max-height: 6rem; max-width: 100%;"/>\n                        <p t-field="sale_order.signed_by"/>\n                    </div>\n                </div>\n            </section>\n\n            <section id="terms" class="mt-5" t-if="sale_order.note">\n                <h3 class="">Terms &amp; Conditions</h3>\n                <hr class="mt-0 mb-1"/>\n                <em t-field="sale_order.note"/>\n            </section>\n\n            <section class="mt-5" t-if="sale_order.payment_term_id">\n                <h3 class="">Payment terms</h3>\n                <hr class="mt-0 mb-1"/>\n                <span t-field="sale_order.payment_term_id"/>\n            </section>\n        </div>\n    </t>\n\n    	sale/views/sale_portal_templates.xml	\N	\N	\N	\N	primary	t	1	2025-06-10 03:58:25.67937	1	2025-06-10 03:58:25.67937	f
375	mail_channel_notify_moderation	\N	mail.mail_channel_notify_moderation	16	qweb	<?xml version="1.0"?>\n<t t-name="mail.mail_channel_notify_moderation">\n<div>\n    <p>Hello <t t-esc="record.name"/></p>\n    <p>You have messages to moderate, please go for the proceedings.</p><br/><br/>\n    <div style="text-align: center;">\n        <a href="/web#action=mail.action_discuss&amp;active_id=mail.box_moderation" style="background-color: #1abc9c; padding: 20px; text-decoration: none; color: #fff; border-radius: 5px; font-size: 16px;" class="o_default_snippet_text">Moderate Messages</a>\n        <br/><br/><br/>\n    </div>\n    <p>Thank you!</p>\n</div>\n        </t>\n\n       	mail/data/mail_data.xml	\N	\N	\N	\N	primary	t	1	2025-06-10 03:55:24.448855	1	2025-06-10 03:55:24.448855	\N
376	mail_channel_send_guidelines	\N	mail.mail_channel_send_guidelines	16	qweb	<?xml version="1.0"?>\n<t t-name="mail.mail_channel_send_guidelines">\n<div>\n<p>Hello <t t-esc="partner.name"/>,</p>\n<p>Please find below the guidelines of the <t t-esc="channel.name"/> channel.</p>\n<p>\n<t t-esc="channel.moderation_guidelines_msg"/>\n</p>\n<p/>\n</div>\n        </t>\n    	mail/data/mail_data.xml	\N	\N	\N	\N	primary	t	1	2025-06-10 03:55:24.448855	1	2025-06-10 03:55:24.448855	\N
495	report_productbarcode	\N	product.report_productbarcode	16	qweb	<?xml version="1.0"?>\n<t t-name="product.report_productbarcode">\n            <t t-call="web.basic_layout">\n                <div class="page">\n                    <t t-foreach="docs" t-as="product">\n                        <t t-call="product.report_simple_barcode">\n                            <t t-set="product" t-value="product"/>\n                        </t>\n                    </t>\n                </div>\n            </t>\n        </t>\n    	product/report/product_product_templates.xml	\N	\N	\N	\N	primary	t	1	2025-06-10 03:55:36.149676	1	2025-06-10 03:55:36.149676	\N
976	sale_tests	\N	sale.qunit_suite	16	qweb	<?xml version="1.0"?>\n<data name="sale_tests" inherit_id="web.qunit_suite_tests">\n        <xpath expr="." position="inside">\n            <script type="text/javascript" src="/sale/static/tests/product_configurator_tests.js"/>\n            <script type="text/javascript" src="/sale/static/tests/sales_team_dashboard_tests.js"/>\n        </xpath>\n    </data>\n	sale/views/assets.xml	\N	\N	200	\N	extension	t	1	2025-06-10 03:58:25.67937	1	2025-06-10 03:58:25.67937	f
655	account.bnk_stmt_cashbox.form	account.bank.statement.cashbox	\N	1000	form	<?xml version="1.0"?>\n<xpath expr="//sheet" position="after">\n                    <footer>\n                        <button string="Confirm" class="btn-primary" special="save"/>\n                        <button string="Cancel" class="btn-secondary" special="cancel"/>\n                    </footer>\n                </xpath>\n            	account/views/account_bank_statement_views.xml	\N	\N	654	\N	primary	t	1	2025-06-10 03:55:46.489222	1	2025-06-10 03:55:46.489222	f
977	variants	\N	sale.variants	16	qweb	<?xml version="1.0"?>\n<t t-name="sale.variants">\n        <t t-set="attribute_exclusions" t-value="product._get_attribute_exclusions(parent_combination, parent_name)"/>\n        <ul t-attf-class="list-unstyled js_add_cart_variants #{ul_class}" t-att-data-attribute_exclusions="json.dumps(attribute_exclusions)">\n            <t t-foreach="product.valid_product_template_attribute_line_ids" t-as="ptal">\n                <!-- Attributes selection is hidden if there is only one value available and it's not a custom value -->\n                <li t-att-data-attribute_id="ptal.attribute_id.id" t-att-data-attribute_name="ptal.attribute_id.name" t-attf-class="variant_attribute #{'d-none' if len(ptal.product_template_value_ids._only_active()) == 1 and not ptal.product_template_value_ids._only_active()[0].is_custom else ''}">\n\n                    <!-- Used to customize layout if the only available attribute value is custom -->\n                    <t t-set="single_and_custom" t-value="len(ptal.product_template_value_ids._only_active()) == 1 and ptal.product_template_value_ids._only_active()[0].is_custom"/>\n                    <strong t-field="ptal.attribute_id.name" class="attribute_name"/>\n\n                    <t t-if="ptal.attribute_id.display_type == 'select'">\n                        <select t-att-data-attribute_id="ptal.attribute_id.id" t-attf-class="form-control js_variant_change #{ptal.attribute_id.create_variant} #{'d-none' if single_and_custom else ''}" t-att-name="'ptal-%s' % ptal.id">\n                            <t t-foreach="ptal.product_template_value_ids._only_active()" t-as="ptav">\n                                <option t-att-value="ptav.id" t-att-data-value_id="ptav.id" t-att-data-value_name="ptav.name" t-att-data-attribute_name="ptav.attribute_id.name" t-att-data-is_custom="ptav.is_custom" t-att-selected="ptav in combination" t-att-data-is_single_and_custom="single_and_custom">\n                                    <span t-field="ptav.name"/>\n                                    <span t-if="ptav.price_extra" class="badge badge-pill badge-secondary">\n                                        <!--\n                                            price_extra is displayed as catalog price instead of\n                                            price after pricelist because it is impossible to\n                                            compute. Indeed, the pricelist rule might depend on the\n                                            selected variant, so the price_extra will be different\n                                            depending on the selected combination. The price of an\n                                            attribute is therefore variable and it's not very\n                                            accurate to display it.\n                                            -->\n                                        <t t-esc="ptav.price_extra &gt; 0 and '+' or '-'"/>\n                                        <span t-esc="abs(ptav.price_extra)" class="variant_price_extra" style="white-space: nowrap;" t-options="{                                                 &quot;widget&quot;: &quot;monetary&quot;,                                                 &quot;from_currency&quot;: product.currency_id,                                                 &quot;display_currency&quot;: (pricelist or product).currency_id                                             }"/>\n                                    </span>\n                                </option>\n                            </t>\n                        </select>\n                    </t>\n\n                    <t t-if="ptal.attribute_id.display_type == 'radio'">\n                        <ul t-att-data-attribute_id="ptal.attribute_id.id" t-attf-class="list-unstyled #{'d-none' if single_and_custom else ''}">\n                            <t t-foreach="ptal.product_template_value_ids._only_active()" t-as="ptav">\n                                <li class="form-group js_attribute_value" style="margin: 0;">\n                                    <label class="col-form-label">\n                                        <div>\n                                            <input type="radio" t-attf-class="js_variant_change radio_input #{ptal.attribute_id.create_variant}" t-att-checked="ptav in combination" t-att-name="'ptal-%s' % ptal.id" t-att-value="ptav.id" t-att-data-value_id="ptav.id" t-att-data-value_name="ptav.name" t-att-data-attribute_name="ptav.attribute_id.name" t-att-data-is_custom="ptav.is_custom" t-att-data-is_single_and_custom="single_and_custom"/>\n                                            <div class="radio_input_value">\n                                                <span t-field="ptav.name"/>\n                                                <span class="badge badge-pill badge-secondary" t-if="ptav.price_extra">\n                                                    <!-- see note above about price_extra -->\n                                                    <t t-esc="ptav.price_extra &gt; 0 and '+' or '-'"/>\n                                                    <span t-esc="abs(ptav.price_extra)" class="variant_price_extra" style="white-space: nowrap;" t-options="{                                                             &quot;widget&quot;: &quot;monetary&quot;,                                                             &quot;from_currency&quot;: product.currency_id,                                                             &quot;display_currency&quot;: (pricelist or product).currency_id                                                         }"/>\n                                                </span>\n                                            </div>\n                                        </div>\n                                    </label>\n                                </li>\n                            </t>\n                        </ul>\n                    </t>\n\n                    <t t-if="ptal.attribute_id.display_type == 'color'">\n                        <ul t-att-data-attribute_id="ptal.attribute_id.id" t-attf-class="list-inline  #{'d-none' if single_and_custom else ''}">\n                            <li t-foreach="ptal.product_template_value_ids._only_active()" t-as="ptav" class="list-inline-item">\n                                <label t-attf-style="background-color:#{ptav.html_color or ptav.product_attribute_value_id.name if not ptav.is_custom else ''}" t-attf-class="css_attribute_color #{'active' if ptav in combination else ''} #{'custom_value' if ptav.is_custom else ''}">\n                                    <input type="radio" t-attf-class="js_variant_change  #{ptal.attribute_id.create_variant}" t-att-checked="ptav in combination" t-att-name="'ptal-%s' % ptal.id" t-att-value="ptav.id" t-att-title="ptav.name" t-att-data-value_id="ptav.id" t-att-data-value_name="ptav.name" t-att-data-attribute_name="ptav.attribute_id.name" t-att-data-is_custom="ptav.is_custom" t-att-data-is_single_and_custom="single_and_custom"/>\n                                </label>\n                            </li>\n                        </ul>\n                    </t>\n                </li>\n            </t>\n        </ul>\n    </t>\n	sale/views/variant_templates.xml	\N	\N	\N	\N	primary	t	1	2025-06-10 03:58:25.67937	1	2025-06-10 03:58:25.67937	f

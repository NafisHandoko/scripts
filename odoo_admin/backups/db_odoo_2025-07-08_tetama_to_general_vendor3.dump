1057	Audit Trail	\N	ehealth.portal_activity_log	16	qweb	<?xml version="1.0"?>\n<t name="Audit Trail" t-name="ehealth.portal_activity_log">\n        <link rel="stylesheet" href="/ehealth/static/src/css/portal_style.css"/>\n        \n        <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.5.1/jquery.min.js"/>\n        <script type="text/javascript" src="/ehealth/static/src/js/portal_activity_log.js"/>\n        <t t-call="portal.portal_layout">\n            <t t-set="no_breadcrumbs" t-value="True"/>\n            <t t-call="ehealth.portal_sidebar_menu"/>\n            <link rel="stylesheet" href="/ehealth/static/src/css/portal_activity_log.css"/>\n            <nav aria-label="breadcrumb">\n                <ol class="breadcrumb">\n                    <li class="breadcrumb-item active" aria-current="page">Activity Log</li>\n                </ol>\n            </nav>\n            <div>\n                <div class="d-flex justify-content-between">\n                    <div class="d-flex" style="gap: 8px;">\n                        <div class="dropdown">\n                            <button class="btn btn-filter dropdown-toggle" type="button" id="date-filter" data-bs-toggle="dropdown" aria-expanded="false">\n                                Date\n                                <i class="bx bx-chevron-down filter-arrow"/>\n                                <span class="badge rounded-pill badge-filter-color">1</span>\n                            </button>\n                            <div class="dropdown-menu p-3" aria-labelledby="date-filter">\n                                <t t-foreach="date_filter_option" t-as="date">\n                                    <div class="form-check">\n                                        <input class="form-check-input" type="radio" name="date-filter-selection" t-attf-id="{{date['value']}}" t-attf-value="{{date['value']}}"/>\n                                        <label class="form-check-label" t-attf-for="{{date['value']}}"><t t-esc="date['label']"/></label>\n                                    </div>                                    \n                                </t>\n                                <div class="d-flex justify-content-end mt-2">\n                                    <button id="apply-filter-date" class="apply-filter-button">Terapkan</button>\n                                </div>\n                            </div>\n                        </div>\n                        <div class="dropdown">\n                            <button class="btn btn-filter dropdown-toggle" type="button" id="location-filter" data-bs-toggle="dropdown" aria-expanded="false">\n                                Location\n                                <i class="bx bx-chevron-down filter-arrow"/>\n                                <span id="count-filter-location" class="badge rounded-pill badge-filter-color"/>\n                            </button>\n                            <div class="dropdown-menu p-3" aria-labelledby="date-filter">\n                                <t t-foreach="location_filter_option" t-as="location">\n                                    <div class="form-check">\n                                        <input class="form-check-input" type="checkbox" name="location-filter-selection" t-attf-id="{{location['value']}}" t-attf-value="{{location['label']}}"/>\n                                        <label class="form-check-label" t-attf-for="{{location['value']}}"><t t-esc="location['label']"/></label>\n                                    </div>                                    \n                                </t>\n                                <div class="d-flex justify-content-end mt-2">\n                                    <button id="apply-filter-location" class="apply-filter-button">Terapkan</button>\n                                </div>\n                            </div>\n                        </div>\n                    </div>\n                    <div>\n                        <div class="dropdown">\n                            <button type="button" id="download-btn" class="btn" data-bs-toggle="dropdown" aria-expanded="false">\n                                <i class="bx bx-download"/><span>Export</span>\n                            </button>\n                            <div class="dropdown-menu" aria-labelledby="export-selection">\n                                <div id="export_all_activity_log" class="export-selection">Semua Data</div>\n                                <div id="export_filtered_activity_log" class="export-selection">Data yang di-filter</div>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n                <div class="log-container">\n                    <div class="table-wrapper">\n                        <table id="table">\n                            <thead>\n                                <tr>\n                                    <th/>\n                                    <th class="timestamp sort down"><div class="table-head-title"><span>Timestamp</span> <div class="annotation"><i class="bx bx-chevron-up"/><i class="bx bx-chevron-down"/></div></div></th>\n                                    <th>Location ID</th>\n                                    <th class="location sort down"><div class="table-head-title"><span>Location</span> <div class="annotation"><i class="bx bx-chevron-up"/><i class="bx bx-chevron-down"/></div></div></th>\n                                    <th class="patient sort down"><div class="table-head-title"><span>Patient</span> <div class="annotation"><i class="bx bx-chevron-up"/><i class="bx bx-chevron-down"/></div></div></th>\n                                    <th class="author sort down"><div class="table-head-title"><span>Author</span> <div class="annotation"><i class="bx bx-chevron-up"/><i class="bx bx-chevron-down"/></div></div></th>\n                                    <th>Activity</th>\n                                </tr>\n                            </thead>\n                            <tbody id="data-table">\n                            </tbody>\n                        </table>\n                    </div>\n                </div>\n            </div>\n            <div class="footer">\n                <div class="counter">\n                    <span id="current-resource" class="bold"/>\n                    <span>dari</span>\n                    <span id="total-resource" class="bold"/>\n                </div>\n                <nav id="pagination" class="pagination">\n                    <div id="prev"><i class="bx bx-chevron-left"/></div>\n                    <div id="next"><i class="bx bx-chevron-right"/></div>\n                </nav>\n            </div>\n        </t>\n        <div id="notif_export_data">\n            <div class="card-notify">\n                <img class="icon success" src="/ehealth/static/src/image/notif-success.svg" alt="icon-success"/>\n                <h1 class="title success">File is Being Processed!</h1>\n                <p class="description success">We will send your file to <span class="email_notify"/>. Please check your spam folder if it is not found in your inbox.</p>\n\n                <img class="icon failed" src="/ehealth/static/src/image/notif-failed.svg" alt="icon-failed"/>\n                <h1 class="title failed">Failed to Process File</h1>\n                <p class="description failed">Please check your internet connection. You can try again or contact us for further information.</p>\n            </div>\n        </div>\n    </t>\n\n	ehealth/views/portal_activity_log.xml	f	<?xml version="1.0"?>\n<t name="Audit Trail" t-name="ehealth.portal_activity_log">\n        <link rel="stylesheet" href="/ehealth/static/src/css/portal_style.css"/>\n        \n        <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.5.1/jquery.min.js"/>\n        <script type="text/javascript" src="/ehealth/static/src/js/portal_activity_log.js"/>\
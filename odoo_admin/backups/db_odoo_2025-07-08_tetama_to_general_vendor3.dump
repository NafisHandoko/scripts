CREATE TABLE public.res_partner (
    id integer NOT NULL,
    name character varying,
    company_id integer,
    create_date timestamp without time zone,
    display_name character varying,
    date date,
    title integer,
    parent_id integer,
    ref character varying,
    lang character varying,
    tz character varying,
    user_id integer,
    vat character varying,
    website character varying,
    comment text,
    credit_limit double precision,
    active boolean,
    employee boolean,
    function character varying,
    type character varying,
    street character varying,
    street2 character varying,
    zip character varying,
    city character varying,
    state_id integer,
    country_id integer,
    partner_latitude numeric,
    partner_longitude numeric,
    email character varying,
    phone character varying,
    mobile character varying,
    is_company boolean,
    industry_id integer,
    color integer,
    partner_share boolean,
    commercial_partner_id integer,
    commercial_company_name character varying,
    company_name character varying,
    create_uid integer,
    write_uid integer,
    write_date timestamp without time zone,
    message_main_attachment_id integer,
    email_normalized character varying,
    message_bounce integer,
    signup_token character varying,
    signup_type character varying,
    signup_expiration timestamp without time zone,
    calendar_last_notif_ack timestamp without time zone,
    team_id integer,
    partner_gid integer,
    additional_info character varying,
    phone_sanitized character varying,
    debit_limit numeric,
    last_time_entries_checked timestamp without time zone,
    invoice_warn character varying,
    invoice_warn_msg text,
    supplier_rank integer,
    customer_rank integer,
    sale_warn character varying,
    sale_warn_msg text,
    endpoint character varying,
    odoo_endpoint character varying,
    bpjs_endpoint character varying,
    sio_no character varying,
    namespace character varying,
    user_realm character varying,
    kubernetes_namespace character varying,
    terraform_workspace character varying,
    default_password character varying NOT NULL,
    status character varying,
    satusehat_status character varying,
    legal_entity_name character varying,
    legal_entity_decree_number character varying,
    legal_entity_type character varying,
    responsible_person_name character varying,
    responsible_person_position character varying,
    responsible_person_phone character varying,
    responsible_person_email character varying,
    rt character varying,
    rw character varying,
    province integer,
    regency integer,
    district integer,
    village integer,
    active_from date,
    inactive_after date,
    variable text,
    api_use_cdn boolean,
    admin_use_cdn boolean,
    use_dedicated_fhir boolean,
    fhir_multitenant_cluster_url character varying,
    fhir_multitenant_internal_url character varying,
    use_reservation boolean,
    use_questionnaire boolean,
    use_datarecap boolean,
    use_dentist_config boolean,
    use_midwife_config boolean,
    use_inpatient_config boolean,
    use_lab_config boolean,
    use_hemodialysis_config boolean,
    infrastructure_state character varying,
    organization_id character varying,
    apothecary_in_charge integer,
    pharmacy_register character varying,
    pcare_username character varying,
    pcare_password character varying,
    new_pcare_username character varying,
    new_pcare_password character varying,
    status_pcare character varying,
    icare_username character varying,
    icare_password character varying,
    new_icare_username character varying,
    new_icare_password character varying,
    status_icare character varying,
    vclaim_username character varying,
    vclaim_password character varying,
    new_vclaim_username character varying,
    new_vclaim_password character varying,
    status_vclaim character varying,
    auto_deploy_bpjs_request_id character varying,
    satusehat_organization_id character varying,
    satusehat_client_id character varying,
    satusehat_client_secret character varying,
    new_satusehat_organization_id character varying,
    new_satusehat_client_id character varying,
    new_satusehat_client_secret character varying,
    status_satusehat character varying,
    auto_deploy_satusehat_request_id character varying,
    CONSTRAINT res_partner_check_name CHECK (((((type)::text = 'contact'::text) AND (name IS NOT NULL)) OR ((type)::text <> 'contact'::text)))
);



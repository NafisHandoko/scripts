423	mail.activity.form.inherit.calendar	mail.activity	\N	16	form	<?xml version="1.0"?>\n<data><xpath expr="//field[@name='date_deadline']" position="attributes">\n                  <attribute name="attrs">{'invisible': [('activity_category', '=', 'meeting')]}</attribute>\n            </xpath>\n            <xpath expr="//field[@name='user_id']" position="attributes">\n                  <attribute name="attrs">{'invisible': [('activity_category', '=', 'meeting')]}</attribute>\n            </xpath>\n            <xpath expr="//button[@name='action_close_dialog']" position="attributes">\n                  <attribute name="attrs">{'invisible': ['|', ('activity_category', '=', 'meeting'), ('id', '!=', False)]}</attribute>\n            </xpath>\n            <xpath expr="//button[@name='action_done']" position="attributes">\n                  <attribute name="attrs">{'invisible': ['|', ('activity_category', '=', 'meeting'), ('force_next', '=', True)]}</attribute>\n            </xpath>\n            <xpath expr="//button[@special='cancel']" position="attributes">\n                  <attribute name="attrs">{'invisible': [('activity_category', '=', 'meeting')]}</attribute>\n            </xpath>\n            <xpath expr="//field[@name='note']" position="attributes">\n                  <attribute name="attrs">{'invisible': [('activity_category', '=', 'meeting')]}</attribute>\n            </xpath>\n            <xpath expr="//button[@name='action_close_dialog']" position="before">\n                <button string="Open Calendar" attrs="{'invisible': [('activity_category', '!=', 'meeting')]}" name="action_create_calendar_event" type="object" class="btn-primary"/>\n            </xpath>\n        </data>	calendar/views/mail_activity_views.xml	\N	\N	360	\N	extension	t	1	2025-06-10 03:55:32.439631	1	2025-06-10 03:55:32.439631	\N
892	payment.acquirer.onboarding.wizard.form	payment.acquirer.onboarding.wizard	\N	16	form	<?xml version="1.0"?>\n<form string="Choose a payment method" class="o_onboarding_payment_acquirer_wizard">\n                <div class="container">\n                    <div class="row align-items-start">\n                        <div class="col col-4" name="left-column">\n                            <group>\n                                <field name="payment_method" widget="radio" nolabel="1"/>\n                            </group>\n                        </div>\n                        <div class="col" name="right-column">\n                            <div attrs="{'invisible': [('payment_method', '!=', 'paypal')]}">\n                                <group>\n                                    <field name="paypal_user_type" widget="radio" nolabel="1"/>\n                                    <field name="paypal_email_account" attrs="{'required': [('payment_method', '=', 'paypal')]}" string="Email"/>\n                                    <field name="paypal_seller_account" attrs="{'invisible': [('paypal_user_type', '=', 'new_user')], 'required': [('paypal_user_type', '!=', 'new_user'), ('payment_method', '=', 'paypal')]}"/>\n                                    <field name="paypal_pdt_token" password="True" attrs="{'invisible': [('paypal_user_type', '=', 'new_user')], 'required': [('paypal_user_type', '!=', 'new_user'), ('payment_method', '=', 'paypal')]}"/>\n                                </group>\n                                <p attrs="{'invisible': [('paypal_user_type', '!=', 'new_user')]}">\n                                    <span>Start selling directly without an account; an email will be sent by Paypal to create your new account and collect your payments.</span>\n                                </p>\n                                <p attrs="{'invisible': [('paypal_user_type', '=', 'new_user')]}">\n                                    <a href="https://www.odoo.com/documentation/user/14.0/ecommerce/shopper_experience/paypal.html" target="_blank">\n                                        <span class="fa fa-arrow-right"> How to configure your PayPal account</span>\n                                    </a>\n                                </p>\n                            </div>\n                            <div attrs="{'invisible': [('payment_method', '!=', 'stripe')]}">\n                                <group>\n                                    <field name="stripe_secret_key" password="True" attrs="{'required': [('payment_method', '=', 'stripe')]}"/>\n                                    <field name="stripe_publishable_key" password="True" attrs="{'required': [('payment_method', '=', 'stripe')]}"/>\n                                </group>\n                                <p>\n                                    <a href="https://dashboard.stripe.com/account/apikeys" target="_blank">\n                                        <span class="fa fa-arrow-right"> Get my Stripe keys</span>\n                                    </a>\n                                </p>\n                            </div>\n\n                            <div attrs="{'invisible': [('payment_method', '!=', 'other')]}">\n                                <button type="object" name="action_onboarding_other_payment_acquirer">\n                                    Check here\n                                </button>\n                                to choose another payment method.\n                            </div>\n                            <div attrs="{'invisible': [('payment_method', '!=', 'manual')]}">\n                                <group>\n                                    <field name="manual_name" attrs="{'required': [('payment_method', '=', 'manual')]}"/>\n                                    <field name="journal_name" attrs="{'required': [('payment_method', '=', 'manual')]}"/>\n                                    <field name="acc_number" attrs="{'required': [('payment_method', '=', 'manual')]}"/>\n                                    <field name="manual_post_msg" attrs="{'required': [('payment_method', '=', 'manual')]}"/>\n                                </group>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n                <footer>\n                    <button name="add_payment_methods" string="Apply" class="oe_highlight" type="object"/>\n                    <button special="cancel" string="Cancel"/>\n                </footer>\n            </form>\n        	payment/views/payment_acquirer_onboarding_templates.xml	\N	\N	\N	\N	primary	t	1	2025-06-10 03:56:12.605336	1	2025-06-10 03:56:12.605336	f

address" placeholder="username@email.com" t-att-value="organization.email" required="true"/>\n                        </div>\n                        <div class="form-group col-xl-6 required">\n                            <label class="col-form-label" for="phone_number">Phone</label>\n                                <input type="text" class="form-control" name="phone_number" placeholder="Phone number" t-att-value="organization.phone" required="true"/>\n                        </div>\n                    </div>\n\n                    <div class="address-detail-section flex-wrap my-md">\n                        <div class="form-group col-xl-6 required">\n                            <label class="col-form-label" for="country_name">Country</label>\n                                <input type="text" class="form-control" name="country_name" placeholder="Country" t-att-value="organization.country_id.name" required="true"/>\n                        </div>\n                        <div class="form-group col-xl-6 required">\n                            <label class="col-form-label" for="province_name">Province</label>\n                                <input id="province_name" type="text" class="form-control" name="province_name" placeholder="Province" t-att-value="organization.province.name" required="true"/>\n                                <input style="display: none;" id="province_code" type="text" class="form-control" name="province_code" t-att-value="organization.province.code"/>\n                        </div>\n                        <div class="form-group col-xl-6 required">\n                            <label class="col-form-label" for="city_name">City</label>\n                                <select name="city_name" class="form-control" id="city_select" required="true"/>\n                                <input style="display: none;" id="city_code" type="text" class="form-control" name="city_code" t-att-value="organization.regency.code"/>\n                        </d
222	internal_layout	\N	web.internal_layout	16	qweb	<?xml version="1.0"?>\n<t t-name="web.internal_layout">\n        <t t-if="not o" t-set="o" t-value="doc"/>\n\n        <t t-if="not company">\n            <!-- Multicompany -->\n            <t t-if="company_id">\n                <t t-set="company" t-value="company_id"/>\n            </t>\n            <t t-elif="o and 'company_id' in o and o.company_id.sudo()">\n                <t t-set="company" t-value="o.company_id.sudo()"/>\n            </t>\n            <t t-else="else">\n                <t t-set="company" t-value="res_company"/>\n            </t>\n        </t>\n\n        <div class="header">\n            <div class="row">\n                <div class="col-3">\n                    <span t-esc="context_timestamp(datetime.datetime.now()).strftime('%Y-%m-%d %H:%M')"/>\n                </div>\n                <div class="col-2 offset-2 text-center">\n                    <span t-esc="company.name"/>\n                </div>\n                <div class="col-2 offset-3 text-right">\n                    <ul class="list-inline">\n                        <li class="list-inline-item"><span class="page"/></li>\n                        <li class="list-inline-item">/</li>\n                        <li class="list-inline-item"><span class="topage"/></li>\n                    </ul>\n                </div>\n            </div>\n        </div>\n        <div class="article" t-att-data-oe-model="o and o._name" t-att-data-oe-id="o and o.id" t-att-data-oe-lang="o and o.env.context.get('lang')">\n          <t t-raw="0"/>\n        </div>\n    </t>\n\n    	web/views/report_templates.xml	\N	\N	\N	\N	primary	t	1	2025-06-10 03:52:06.216302	1	2025-06-10 03:52:06.216302	\N
421	Reset password	\N	auth_signup.reset_password	16	qweb	<?xml version="1.0"?>\n<t name="Reset password" t-name="auth_signup.reset_password">\n            <t t-call="web.login_layout">\n                <div t-if="message" class="oe_login_form clearfix">\n                    <p class="alert alert-success" t-if="message" role="status">\n                        <t t-esc="message"/>\n                    </p>\n                    <a href="/web/login" class="btn btn-link btn-sm float-right" role="button">Back to Login</a>\n                </div>\n\n                <form class="oe_reset_password_form" role="form" method="post" t-if="not message">\n                  <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>\n\n                    <t t-if="token and not invalid_token">\n                        <t t-call="auth_signup.fields">\n                            <t t-set="only_passwords" t-value="1"/>\n                        </t>\n                    </t>\n\n                    <t t-if="not token">\n                        <div class="form-group field-login">\n                            <label for="login" class="col-form-label">Your Email</label>\n                            <input type="text" name="login" t-att-value="login" id="login" class="form-control" autofocus="autofocus" required="required" autocapitalize="off"/>\n                        </div>\n                    </t>\n\n                    <p class="alert alert-danger" t-if="error" role="alert">\n                        <t t-esc="error"/>\n                    </p>\n                    <input type="hidden" name="redirect" t-att-value="redirect"/>\n                    <input type="hidden" name="token" t-att-value="token"/>\n                    <div class="clearfix oe_login_buttons">\n                        <button type="submit" class="btn btn-primary btn-block">Confirm</button>\n                        <div class="d-flex justify-content-between align-items-center small mt-2">\n                            <a t-if="not token" t-attf-href="/web/login?{{ keep_query() }}">Back to Login</a>\n                            <a t-if="invalid_token" href="/web/login">Back to Login</a>\n                        </div>\n                        <div class="o_login_auth"/>\n                    </div>\n\n                </form>\n\n            </t>\n        </t>\n	auth_signup/views/auth_signup_login_templates.xml	\N	\N	\N	\N	primary	t	1	2025-06-10 03:55:31.790018	1	2025-06-10 03:55:31.790018	\N
